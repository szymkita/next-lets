</script>
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MPKLK2BG" height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>

<div class="zg" role="dialog" aria-labelledby="zg-t" aria-describedby="zg-o" data-zgody hidden>
  <p class="zg-t" id="zg-t">Pliki cookies</p>
  <p class="zg-o" id="zg-o">Bez zgody działają tylko pliki niezbędne do działania strony. Za zgodą włączamy statystyki i narzędzia marketingowe. Szczegóły w <a href="/polityka-prywatnosci#sek-6">polityce prywatności</a>.</p>

  <div class="zg-wybor" data-zgody-wybor hidden>
    <label class="zg-k">
      <input type="checkbox" checked disabled>
      <span><b>Niezbędne</b> zawsze włączone: zapamiętanie tego wyboru i działanie formularzy</span>
    </label>
    <label class="zg-k">
      <input type="checkbox" data-zgody-statystyki>
      <span><b>Statystyki</b> Google Analytics i Hotjar: które strony są czytane i gdzie ktoś się zatrzymuje</span>
    </label>
    <label class="zg-k">
      <input type="checkbox" data-zgody-marketing>
      <span><b>Marketing</b> Meta, LinkedIn, Leadfeeder i Albacross: mierzenie reklam i rozpoznawanie firm odwiedzających stronę</span>
    </label>
  </div>

  <div class="zg-przyciski">
    <button type="button" class="zg-b zg-b-tak" data-zgody-wszystko>Akceptuję wszystkie</button>
    <button type="button" class="zg-b" data-zgody-niezbedne>Tylko niezbędne</button>
    <button type="button" class="zg-b" data-zgody-zapisz hidden>Zapisz wybór</button>
  </div>
  <button type="button" class="zg-l" data-zgody-pokaz>Wybieram sam</button>
</div>

<style>
  .zg{position:fixed;left:24px;bottom:24px;z-index:9999;width:min(410px,calc(100vw - 32px));padding:20px 20px 16px;border:1px solid #e1e8de;border-radius:16px;background:#ffffff;color:#16211a;box-shadow:0 28px 60px -24px rgba(14,43,29,0.45);font-family:'Schibsted Grotesk',system-ui,sans-serif}
  .zg[hidden]{display:none}
  .zg-t{margin:0;font-size:15px;font-weight:750;letter-spacing:-0.01em}
  .zg-o{margin:8px 0 0;font-size:13.5px;line-height:1.55;color:#4c5850}
  .zg-o a{color:#0a7a52;font-weight:650;text-decoration:underline;text-underline-offset:3px}
  .zg-wybor{display:grid;gap:10px;margin-top:14px;padding-top:14px;border-top:1px solid #e7ece4}
  .zg-wybor[hidden]{display:none}
  .zg-k{display:grid;grid-template-columns:18px minmax(0,1fr);gap:10px;align-items:start;font-size:13px;line-height:1.45;color:#4c5850;cursor:pointer}
  .zg-k input{width:16px;height:16px;margin:1px 0 0;accent-color:#0a7a52}
  .zg-k b{display:block;font-size:13.5px;font-weight:700;color:#16211a}
  .zg-przyciski{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:16px}
  .zg-b{appearance:none;padding:11px 12px;border:1px solid #cfdacc;border-radius:10px;background:#ffffff;font-family:inherit;font-size:14px;font-weight:650;color:#16211a;cursor:pointer;transition:border-color .15s,background .15s,color .15s}
  .zg-b:hover{border-color:#0a7a52;color:#0a7a52}
  .zg-b-tak{border-color:#16211a;background:#16211a;color:#ffffff}
  .zg-b-tak:hover{border-color:#0a7a52;background:#0a7a52;color:#ffffff}
  .zg-b[hidden]{display:none}
  .zg-l{appearance:none;display:block;margin:12px auto 0;padding:2px 4px;border:0;background:none;font-family:inherit;font-size:13px;font-weight:600;color:#637066;text-decoration:underline;text-underline-offset:3px;cursor:pointer}
  .zg-l:hover{color:#0a7a52}
  .zg-l[hidden]{display:none}
  .zg :focus-visible{outline:2px solid #00CD77;outline-offset:2px}
  @media (max-width:560px){ .zg{left:16px;right:16px;bottom:16px;width:auto} }
</style>

<script is:inline>
(function(){
  var baner = document.querySelector('[data-zgody]');
  if (!baner || !window.laZgody) return;
  var wybor = baner.querySelector('[data-zgody-wybor]');
  var stat = baner.querySelector('[data-zgody-statystyki]');
  var mark = baner.querySelector('[data-zgody-marketing]');
  var pokaz = baner.querySelector('[data-zgody-pokaz]');
  var zapisz = baner.querySelector('[data-zgody-zapisz]');
  var niezbedne = baner.querySelector('[data-zgody-niezbedne]');

  function rozwin(){
    var s = window.laZgody.stan() || {};
    stat.checked = s.analytics_storage === 'granted';
    mark.checked = s.ad_storage === 'granted';
    wybor.hidden = false; pokaz.hidden = true;
    zapisz.hidden = false; niezbedne.hidden = true;
  }
  function zamknij(statystyki, marketing){
    window.laZgody.zapisz(statystyki, marketing);
    baner.hidden = true;
  }

  baner.querySelector('[data-zgody-wszystko]').addEventListener('click', function(){ zamknij(true, true); });
  niezbedne.addEventListener('click', function(){ zamknij(false, false); });
  zapisz.addEventListener('click', function(){ zamknij(stat.checked, mark.checked); });
  pokaz.addEventListener('click', rozwin);

  // „Ustawienia cookies” w stopce otwiera baner z rozwiniętym wyborem.
  document.addEventListener('click', function(e){
    var t = e.target.closest && e.target.closest('[data-zgody-otworz]');
    if (!t) return;
    e.preventDefault();
    rozwin();
    baner.hidden = false;
    baner.querySelector('[data-zgody-statystyki]').focus();
  });

  if (!window.laZgody.stan()) baner.hidden = false;
})();
</script>
