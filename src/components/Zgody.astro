//   Google Tag Manager  GTM-MPKLK2BG
//   Google Analytics 4  G-V31X5NVG6H (stary serwis ładował go obok GTM,
//                       więc zostaje tak samo, żeby dane szły ciągiem)
//   Hotjar              2886465            → kategoria „statystyki”
//   Meta Pixel          419937373267135    → „marketing”
//   LinkedIn Insight    4245625            → „marketing”
//   Leadfeeder          ywVkO4XYkgpaZ6Bj   → „marketing”
//   Albacross           89987235           → „marketing”
//
// CO JEST INACZEJ NIŻ NA STARYM SERWISIE
// Stary miał w kodzie wywołanie banera, ale samego banera nie było na
// stronie: nikt nie mógł się zgodzić, więc Google Analytics działał w trybie
// bez zgody, a Hotjar, Pixel i LinkedIn ładowały się bez pytania. Tutaj
// GA4 i GTM startują w Consent Mode z odmową domyślną, a narzędzia spoza
// Google ładują się dopiero po zgodzie na swoją kategorię.
//
// ZAPIS ZGODY
// localStorage `consentMode` — ten sam klucz i ten sam format co na starym
// serwisie (stan Consent Mode), bo to ta sama domena. Data zapisu leży
// obok, w `consentModeData`. Cofnięcie zgody przeładowuje stronę, żeby
// zdjąć już załadowane skrypty.
//
// POLECENIA: `?ref=` w adresie trafia do localStorage `referrer` (jak na
// starym serwisie), a formularze dokładają go do zgłoszenia.
//
// ZDARZENIA DLA GTM: `zgody_zapisane` po wyborze w banerze i
// `formularz_wyslany` po udanym zgłoszeniu (wysyłają go formularze).
---
<script is:inline>
(function(){
  var KLUCZ = 'consentMode';
  window.dataLayer = window.dataLayer || [];
  window.gtag = window.gtag || function(){ window.dataLayer.push(arguments); };

  var ODMOWA = {
    ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',
    analytics_storage: 'denied', personalization_storage: 'denied',
    functionality_storage: 'denied', security_storage: 'granted'
  };
  var zapis = null;
  try { zapis = JSON.parse(localStorage.getItem(KLUCZ)); } catch (e) {}
  if (!zapis || typeof zapis !== 'object') zapis = null;

  gtag('consent', 'default', zapis ? Object.assign({}, ODMOWA, zapis) : Object.assign({ wait_for_update: 500 }, ODMOWA));

  function wstaw(src){
    var s = document.createElement('script');
    s.async = true; s.src = src;
    document.head.appendChild(s);
  }

  // Google: GA4 bezpośrednio i kontener GTM — oba szanują Consent Mode.
  wstaw('https://www.googletagmanager.com/gtag/js?id=G-V31X5NVG6H');
  gtag('js', new Date());
  gtag('config', 'G-V31X5NVG6H');
  window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
  wstaw('https://www.googletagmanager.com/gtm.js?id=GTM-MPKLK2BG');

  try {
    var ref = new URLSearchParams(location.search).get('ref');
    if (ref) localStorage.setItem('referrer', ref);
  } catch (e) {}

  var zaladowane = {};
  var NARZEDZIA = {
    statystyki: function(){
      window.hj = window.hj || function(){ (window.hj.q = window.hj.q || []).push(arguments); };
      window._hjSettings = { hjid: 2886465, hjsv: 6 };
      wstaw('https://static.hotjar.com/c/hotjar-2886465.js?sv=6');
    },
    marketing: function(){
      if (!window.fbq) {
        var n = window.fbq = function(){ n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments); };
        if (!window._fbq) window._fbq = n;
        n.push = n; n.loaded = true; n.version = '2.0'; n.queue = [];
        wstaw('https://connect.facebook.net/en_US/fbevents.js');
      }
      window.fbq('init', '419937373267135');
      window.fbq('track', 'PageView');

      window._linkedin_partner_id = '4245625';
      window._linkedin_data_partner_ids = window._linkedin_data_partner_ids || [];
      window._linkedin_data_partner_ids.push('4245625');
      if (!window.lintrk) {
        window.lintrk = function(a, b){ window.lintrk.q.push([a, b]); };
        window.lintrk.q = [];
      }
      wstaw('https://snap.licdn.com/li.lms-analytics/insight.min.js');

      window.ldfdr = window.ldfdr || function(){ (window.ldfdr._q = window.ldfdr._q || []).push([].slice.call(arguments)); };
      wstaw('https://sc.lfeeder.com/lftracker_v1_ywVkO4XYkgpaZ6Bj.js');

      window._nQc = '89987235';
      wstaw('https://serve.albacross.com/track.js');
    }
  };

  function uruchom(stan){
    if (stan.analytics_storage === 'granted' && !zaladowane.statystyki) { zaladowane.statystyki = true; NARZEDZIA.statystyki(); }
    if (stan.ad_storage === 'granted' && !zaladowane.marketing) { zaladowane.marketing = true; NARZEDZIA.marketing(); }
  }

  window.laZgody = {
    stan: function(){ return zapis; },
    zapisz: function(statystyki, marketing){
      var m = marketing ? 'granted' : 'denied';
      var stan = {
        ad_storage: m, ad_user_data: m, ad_personalization: m, personalization_storage: m,
        analytics_storage: statystyki ? 'granted' : 'denied',
        functionality_storage: 'granted', security_storage: 'granted'
      };
      var cofniete = (zaladowane.statystyki && !statystyki) || (zaladowane.marketing && !marketing);
      try {
        localStorage.setItem(KLUCZ, JSON.stringify(stan));
        localStorage.setItem('consentModeData', new Date().toISOString());
      } catch (e) {}
      zapis = stan;
      gtag('consent', 'update', stan);
      window.dataLayer.push({ event: 'zgody_zapisane', zgoda_statystyki: !!statystyki, zgoda_marketing: !!marketing });
      if (cofniete) { location.reload(); return; }
      uruchom(stan);
    }
  };

  if (zapis) uruchom(zapis);
