---
// WEJŚCIE W KADR: każdy element z [data-anim] dostaje .on, kiedy wejdzie
// w kadr (raz). Element z [data-anim][data-gra] dostaje dodatkowo .gra od
// razu po załadowaniu — jego CSS chowa stan startowy tylko wtedy, gdy
// animacja naprawdę się odbędzie. Przy prefers-reduced-motion i bez
// IntersectionObservera wszystko dostaje .on od razu (stan końcowy).
//
// KIEDY „W KADRZE”: 30% elementu na ekranie albo element zajmuje już 20%
// wysokości ekranu — co nastąpi pierwsze. Sam próg 30% elementu zawodził
// na telefonie: wyniki, schody i kafle „Dlaczego” mają tam po 1000–2000 px,
// więc ruszały, kiedy ich góra była już przy górze ekranu, a wcześniej
// przez cały ekran widać było puste miejsce (27.10.2026, Let’s Shift).
---
<script>
  var redukcja = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // ---- Wejście w kadr: [data-anim] dostaje .on (krzywa, okna, schody, kafle) ----
  (function(){
    var els = document.querySelectorAll('.v3 [data-anim]');
    if(!els.length) return;
    if(redukcja || !('IntersectionObserver' in window)){
      els.forEach(function(el){ el.classList.add('on'); });
      return;
    }
    els.forEach(function(el){ if(el.hasAttribute('data-gra')) el.classList.add('gra'); });
    function wlacz(wpisy: IntersectionObserverEntry[]){
      wpisy.forEach(function(w){
        if(!w.isIntersecting) return;
        w.target.classList.add('on');
        czesc.unobserve(w.target);
        ekran.unobserve(w.target);
      });
    }
    var czesc = new IntersectionObserver(wlacz, { threshold: 0.3 });
    var ekran = new IntersectionObserver(wlacz, { rootMargin: '0px 0px -20% 0px' });
    els.forEach(function(el){ czesc.observe(el); ekran.observe(el); });
  })();

</script>
