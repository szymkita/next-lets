---
// CAŁOŚĆ ZA WAS: krótki blok przed formularzem na podstronach części
// wdrożenia (/strategia-ai, /wdrozenie-ai, /szkolenia-ai). Mówi, że tę część
// i resztę możemy zrobić w całości, i prowadzi na /wdrozenie-ai-pod-klucz
// (18.11.2026, Szymon: podpiąć landing w strukturę strony). Stoi na papierze
// jak „Dla kogo” nad nim i formularz pod nim; wyróżnia go tylko zielona kreska.
interface Props {
  tytul?: string;
  tekst: string;
  link?: string;
}
const {
  tytul = 'Wolicie całość za Was?',
  tekst,
  link = 'Zobaczcie wdrożenie AI pod klucz',
} = Astro.props;
---
<section class="v3-sek v3-papier cz-zw" aria-labelledby="calosc-tytul">
<div class="cz-zw-in">
<h2 class="cz-zw-t" id="calosc-tytul">{tytul}</h2>
<div>
<p class="v3-sub">{tekst}</p>
<a href="/wdrozenie-ai-pod-klucz" class="v3-btn ciemny">{link} <span aria-hidden="true">→</span></a>
</div>
</div>
</section>

<style is:global>
  .v3 > .cz-zw,.cz-zw{padding-top:0 !important;padding-bottom:clamp(48px,6vw,88px) !important}
  .cz-zw-in{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:18px clamp(32px,5vw,96px);align-items:start;padding:clamp(26px,3vw,38px) 0 0 clamp(18px,2vw,28px);border-top:1px solid var(--linia);box-shadow:inset 3px 0 0 #00CD77}
  .cz-zw-t{margin:0;font-size:clamp(26px,2.8vw,40px);line-height:1.05;letter-spacing:-0.04em;font-weight:700;color:var(--t1);text-wrap:balance}
  .cz-zw .v3-sub{max-width:600px}
  .cz-zw .v3-btn{margin-top:22px}
  @media (max-width:900px){ .cz-zw-in{grid-template-columns:minmax(0,1fr)} }
</style>
