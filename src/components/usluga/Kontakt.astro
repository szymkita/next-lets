---
// KONTAKT: ciemna plansza domyka stronę tak, jak otwiera ją hero; leży na
// papierze, jak „Dla kogo" nad nią i FAQ pod nią. Po lewej nagłówek,
// jedno zdanie i kanały, w środku formularz na ciemnym tle (pola jaśniejsze
// od tła, z jasną obwódką), po prawej portret osoby, która odpisuje.
// Formularz jest prawdziwy: POST na /api/kontakt, ta sama walidacja,
// pułapka na boty i obsługa awarii co w GcCta. Proste: trzy pola.
import { HI } from './ikony';
interface Props {
  tytul: string;
  lead: string;
  zrodlo: string;          // nazwa usługi do zgłoszenia, np. „Systemy procesowe"
  pytanie: string;         // etykieta pola opisowego
  podpowiedz: string;      // placeholder pola opisowego
  osoba?: { foto: string; w: number; h: number; imie: string; rola: string };
  po?: string;             // zdanie pod przyciskiem
  h1?: boolean;            // nagłówek strony (/kontakt), gdzie moduł stoi na górze
}
const {
  tytul, lead, zrodlo, pytanie, podpowiedz,
  // Pierwszą rozmowę zawsze prowadzi Piotr (16.10.2026), więc to on odpisuje.
  osoba = { foto: '/piotr-wojciuk.jpg', w: 1002, h: 1100, imie: 'Piotr Wojciuk', rola: 'New Business Lead' },
  po = 'Rozmowa jest bezpłatna i bez zobowiązań, online albo telefonicznie.',
  h1 = false,
} = Astro.props;
const Naglowek = h1 ? 'h1' : 'h2';
---
<section id="kontakt" class="v4-kt kt-ciemny">
<div class="kt-in v3-ziarno">
<div class="kt-lewa">
<Naglowek class="v3-h2 jasny">{tytul}</Naglowek>
<p class="v3-sub jasny">{lead}</p>
<p class="kt-kanaly"><a href="mailto:hello@letsautomate.pl"><svg class="hi" viewBox="0 0 16 16" aria-hidden="true" set:html={HI['envelope']}></svg>hello@letsautomate.pl</a><a href="tel:+48571399932"><svg class="hi" viewBox="0 0 16 16" aria-hidden="true" set:html={HI['phone']}></svg>+48 571 399 932</a></p>
</div>

<div class="kt-karta" data-anim>
<form class="kt-f" data-kt-form data-zrodlo={`${zrodlo} · ${Astro.url.pathname}`} novalidate>
<div class="kt-2">
<div class="kt-pole">
<label class="kt-lab" for="kt-email">E-mail <span class="req">*</span></label>
<div class="kt-ramka"><svg class="hi" viewBox="0 0 16 16" aria-hidden="true" set:html={HI['envelope']}></svg><input class="kt-inp" id="kt-email" name="email" type="email" inputmode="email" autocomplete="email" placeholder="jan@firma.pl" aria-describedby="kt-err-email"></div>
<div class="kt-err" id="kt-err-email"></div>
</div>
<div class="kt-pole">
<label class="kt-lab" for="kt-tel">Telefon <span class="req">*</span></label>
<div class="kt-ramka kt-tel">
<span class="kt-kier"><select name="kierunkowy" aria-label="Numer kierunkowy"><option value="+48">+48</option><option value="+49">+49</option><option value="+44">+44</option><option value="+380">+380</option><option value="+420">+420</option><option value="+1">+1</option></select><svg class="hi" viewBox="0 0 16 16" aria-hidden="true" set:html={HI['chevron-down']}></svg></span>
<i aria-hidden="true"></i>
<input class="kt-inp" id="kt-tel" name="telefon" type="tel" inputmode="tel" autocomplete="tel-national" placeholder="571 000 000" aria-describedby="kt-err-tel">
</div>
<div class="kt-err" id="kt-err-tel"></div>
</div>
</div>
<div class="kt-blok kt-pole">
<label class="kt-lab" for="kt-msg">{pytanie} <span class="req">*</span></label>
<div class="kt-ramka kt-ta"><textarea class="kt-inp" id="kt-msg" name="wiadomosc" rows="3" placeholder={podpowiedz} aria-describedby="kt-err-msg"></textarea></div>
<div class="kt-err" id="kt-err-msg"></div>
</div>
<label class="kt-zgoda" data-kt-zgoda-row>
<input type="checkbox" name="zgoda" data-kt-zgoda>
<span class="kt-cb"><svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="#ffffff" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg></span>
<span>Wyrażam zgodę na kontakt i przetwarzanie moich danych w celu obsługi zapytania. <a href="/polityka-prywatnosci">Polityka prywatności</a>.</span>
</label>
<div class="kt-hp" aria-hidden="true"><label for="kt-kk">Nie wypełniaj tego pola</label><input id="kt-kk" name="kontrola" type="text" tabindex="-1" autocomplete="off" data-1p-ignore data-lpignore="true" data-form-type="other"></div>
<button type="submit" class="kt-btn" data-kt-submit>
<span class="kt-btn-t" data-kt-label>Wyślij zapytanie</span>
<span class="kt-btn-k" aria-hidden="true">
<svg class="s1" viewBox="0 0 16 16" set:html={HI['arrow-right']}></svg>
<svg class="s2" viewBox="0 0 16 16" set:html={HI['arrow-right']}></svg>
<svg class="kr" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-dasharray="30 100"/></svg>
<svg class="pt" viewBox="0 0 16 16" set:html={HI['check']}></svg>
</span>
</button>
<p class="kt-po">{po}</p>
<div class="kt-awaria" data-kt-awaria hidden>
<strong data-kt-awaria-t>Zgłoszenie nie doszło.</strong>
<span data-kt-awaria-d>Wpisane dane zostały w formularzu — spróbujcie jeszcze raz za chwilę.</span>
Możecie też napisać na <a href="mailto:hello@letsautomate.pl" data-kt-mailto>hello@letsautomate.pl</a> albo zadzwonić: <a href="tel:+48571399932">+48 571 399 932</a>.
</div>
</form>

<div class="kt-ok" data-kt-ok role="status" tabindex="-1" hidden>
<span class="kt-ok-ik"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="#0a7a52" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5" pathLength="1"/></svg></span>
<h3>Mamy Wasze zapytanie</h3>
<p>Odpowiemy w jeden dzień roboczy na adres <b data-kt-echo>podany w formularzu</b>. Jeśli to literówka, napiszcie na <a href="mailto:hello@letsautomate.pl" style="font-weight:700;color:#0a7a52">hello@letsautomate.pl</a>.</p>
</div>
</div>
<figure class="kt-os">
<img src={osoba.foto} alt={osoba.imie} width={osoba.w} height={osoba.h} loading="lazy" decoding="async">
<figcaption><b>{osoba.imie}</b><span>{osoba.rola}</span></figcaption>
</figure>
</div>
</section>

<script>
  var redukcja = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // ---- Formularz kontaktowy ----
  // Ta sama umowa z /api/kontakt co w GcCta: e-mail i telefon wymagane,
  // pole-pułapka na boty, 503 = formularz wyłączony (ponawianie nic nie da),
  // 502/inne = kanał odpadł (dane zostają w formularzu).
  // DO ZDARZEŃ (dataLayer) NIE WCHODZI TREŚĆ FORMULARZA ANI DANE KONTAKTOWE.
  (function(){
    var form = document.querySelector('[data-kt-form]');
    if(!form) return;
    var ENDPOINT = '/api/kontakt', MAIL = 'hello@letsautomate.pl';
    var karta = form.parentNode, okBox = karta.querySelector('[data-kt-ok]');
    var btn = form.querySelector('[data-kt-submit]'), etykieta = form.querySelector('[data-kt-label]');
    var zgoda = form.querySelector('[data-kt-zgoda]'), wierszZgody = form.querySelector('[data-kt-zgoda-row]');
    var awaria = form.querySelector('[data-kt-awaria]');
    var zrodlo = form.dataset.zrodlo || '';
    var wysylam = false, zaczety = false;
    function pomiar(nazwa, powod){
      var dane = { event: nazwa, usluga: zrodlo, strona: location.pathname };
      if(powod) dane.powod = powod;
      try {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push(dane);
        document.dispatchEvent(new CustomEvent('la:pomiar', { detail: dane }));
      } catch(e){}
    }
    document.addEventListener('click', function(e){
      var a = e.target && e.target.closest ? e.target.closest('a[href*="#kontakt"]') : null;
      if(a) pomiar('cta_klik');
    });
    var REGULY = [
      { pole: 'email', msg: 'Adres e-mail wygląda na niepełny.', ok: function(v){ return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v); } },
      { pole: 'telefon', msg: 'Numer telefonu ma za mało cyfr.', ok: function(v){ return v.replace(/\D/g, '').length >= 9; } },
      // Opis sprawy obowiązkowy od 16.10.2026 (Szymon) — we wszystkich formularzach.
      { pole: 'wiadomosc', msg: 'To pole jest wymagane.', ok: function(v){ return v.length > 0; } }
    ];
    function pole(el){ return el && el.closest ? el.closest('.kt-pole') : null; }
    function blad(el, msg){ var f = pole(el); if(!f) return; f.classList.add('err'); el.setAttribute('aria-invalid', 'true'); f.querySelector('.kt-err').textContent = msg; }
    function dobrze(el){ var f = pole(el); if(!f) return; f.classList.remove('err'); el.removeAttribute('aria-invalid'); }
    function sprawdz(){
      var pierwszy = null;
      REGULY.forEach(function(r){
        var el = form.elements[r.pole], v = (el.value || '').trim();
        if(v && r.ok(v)) dobrze(el);
        else { blad(el, v ? r.msg : 'To pole jest wymagane.'); if(!pierwszy) pierwszy = el; }
      });
      wierszZgody.classList.toggle('err', !zgoda.checked);
      if(!zgoda.checked && !pierwszy) pierwszy = zgoda;
      return pierwszy;
    }
    form.addEventListener('input', function(e){
      if(pole(e.target)) dobrze(e.target);
      if(!zaczety){ zaczety = true; pomiar('formularz_start'); }
    });
    zgoda.addEventListener('change', function(){ wierszZgody.classList.toggle('err', !zgoda.checked); });
    function telefon(){ return (form.elements.kierunkowy.value + ' ' + (form.elements.telefon.value || '').trim()).trim(); }
    function opis(){ return (form.elements.wiadomosc.value || '').trim(); }
    function pokazOk(){
      var echo = okBox.querySelector('[data-kt-echo]'), mail = (form.elements.email.value || '').trim();
      if(echo && mail) echo.textContent = mail;
      pomiar('formularz_sukces');
      form.hidden = true;
      okBox.hidden = false;
      okBox.scrollIntoView({ block: 'nearest' });
      okBox.focus();
    }
    var AWARIE = {
      'brak-konfiguracji': ['Formularz jest chwilowo wyłączony.', 'Zgłoszenie nie zostało wysłane, a ponowna próba nic nie zmieni.'],
      'domyslna': ['Zgłoszenie nie doszło.', 'Wpisane dane zostały w formularzu — spróbujcie jeszcze raz za chwilę.']
    };
    function pokazAwarie(kod){
      pomiar('formularz_blad', kod || 'domyslna');
      var tr = AWARIE[kod] || AWARIE.domyslna;
      awaria.querySelector('[data-kt-awaria-t]').textContent = tr[0];
      awaria.querySelector('[data-kt-awaria-d]').textContent = tr[1];
      awaria.querySelector('[data-kt-mailto]').href = 'mailto:' + MAIL
        + '?subject=' + encodeURIComponent('Zapytanie ze strony — ' + zrodlo)
        + '&body=' + encodeURIComponent('E-mail: ' + (form.elements.email.value || '').trim() + '\nTelefon: ' + telefon() + '\n\n' + opis());
      awaria.hidden = false;
      awaria.scrollIntoView({ block: 'nearest' });
    }
    form.addEventListener('submit', function(e){
      e.preventDefault();
      if(wysylam) return;
      var zly = sprawdz();
      if(zly){ zly.focus(); return; }
      wysylam = true;
      btn.disabled = true;
      btn.classList.add('wysyla');
      var napis = etykieta.textContent;
      etykieta.textContent = 'Wysyłam…';
      awaria.hidden = true;
      function polecenie(){ try { return localStorage.getItem('referrer') || ''; } catch(e) { return ''; } }
      fetch(ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({
          email: (form.elements.email.value || '').trim(),
          telefon: telefon(),
          wiadomosc: opis(),
          firma_www: form.elements.kontrola.value || '',
          zrodlo: zrodlo,
          referrer: polecenie()
        })
      })
        .then(function(r){
          if(r.ok){
            // Zdarzenie dla GTM — konwersję podpina się w kontenerze (Zgody.astro).
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({ event: 'formularz_wyslany', zrodlo: zrodlo });
            // Ptaszek na przycisku, a potwierdzenie chwilę później.
            btn.classList.remove('wysyla');
            btn.classList.add('wyslane');
            etykieta.textContent = 'Wysłane';
            return redukcja ? pokazOk() : setTimeout(pokazOk, 850);
          }
          return r.json().catch(function(){ return {}; }).then(function(j){ throw new Error(j.blad || 'domyslna'); });
        })
        .catch(function(err){
          wysylam = false;
          btn.disabled = false;
          btn.classList.remove('wysyla');
          etykieta.textContent = napis;
          pokazAwarie(err && err.message);
        });
    });
  })();
</script>
