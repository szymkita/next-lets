---
// Pasek logotypów pod hero, na bieli. Logotypy leżą w public/uploads/klienci
// (pobrane z CDN-u starej strony 16.10.2026, żeby nie zniknęły razem
// z Webflow).
// [plik, nazwa, szerokość viewBoxu przy wysokości 88]
const LOGA = [
  ['sports-med.svg', 'Sports-Med', 308],
  ['nars.svg', 'NARS', 235],
  ['sevium.svg', 'Sevium', 206],
  ['odo-24.svg', 'ODO 24', 158],
  ['x3d.svg', 'X3D', 143],
];
---
<div class="v4-pod-hero">
<div class="v4-loga">
<p><strong>140+ firm</strong> zmienia z nami sposób działania</p>
<ul>
{LOGA.map(([plik, nazwa, w]) => (<li><img src={`/uploads/klienci/${plik}`} alt={nazwa} width={w} height="88" loading="lazy"></li>))}
</ul>
</div>
</div>
