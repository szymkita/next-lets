---
// KRÓTKIE WEZWANIE: pasek z dwiema twarzami, jednym zdaniem o tym, co
// dzieje się na pierwszej rozmowie, i przyciskiem. Nie druga plansza —
// żeby nie powtarzać zielonego pasa. Na papierowym tle sekcji pasek jest
// biały (reguła w Styl.astro).
interface Props {
  tytul: string;
  pod?: string;
  href?: string;
  cta?: string;
}
const { tytul, pod = '30 minut, online albo telefonicznie.', href = '#kontakt', cta = 'Umów rozmowę' } = Astro.props;
---
<div class="cta2 rv">
<div class="cta2-os" aria-hidden="true"><img src="/szymon-kita.jpg" alt="" width="870" height="1210" loading="lazy" decoding="async"><img src="/marcel-bilski.jpg" alt="" width="1200" height="2526" loading="lazy" decoding="async"></div>
<p><b>{tytul}</b> {pod}</p>
<a href={href} class="v3-btn">{cta} <span aria-hidden="true">→</span></a>
</div>
