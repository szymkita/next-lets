---
// Krótka scena pracy w appto do sekcji „Co jeszcze może przejąć AI”: kolumna
// czatu z kitu (te same klasy i style co w scenie oferty), bez reszty okna.
// Elementy wchodzą po kolei (klasy .f1…, nadaje skrypt strony); przed startem
// widać pusty czat z kompozytorem (studio/ZASADY.md, „Praca w UI od stanu »przed«”).
// Rozmiar logiczny 760 × 720, skalowany do szerokości pudełka (data-ak-skaluj).
interface Krok { ik: string; t: string; sub: string; pills: string[] }
interface Props {
  pol?: string;                 // polecenie osoby (bez polecenia: agent pracuje sam, np. na mailu)
  glowa: string;                // nagłówek kroków („Appto sprawdza”, „Agent obsługi klienta”)
  kroki: Krok[];
  odp?: string;                 // odpowiedź Wise
  dok?: { t: string; sub: string };
}
const { pol, glowa, kroki, odp, dok } = Astro.props;
const IKO: Record<string, string> = {
  hub: '<img src="/pod-klucz/kit/brand-hubspot.svg" alt="">',
  gm: '<img src="/pod-klucz/brand-gmail.svg" alt="">',
  mic: '<svg class="w-ico" viewBox="0 0 24 24"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><path d="M12 19v3"/></svg>',
  ks: '<svg class="w-ico" viewBox="0 0 24 24"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg>',
  db: '<svg class="w-ico" viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/></svg>',
  fk: '<svg class="w-ico" viewBox="0 0 24 24"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 17.5v-11"/></svg>',
};
const PTAK = '<div class="w-check"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></div>';
const PLIK = '<svg class="w-ico" viewBox="0 0 24 24"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"/><path d="M14 2v5a1 1 0 0 0 1 1h5"/></svg>';
let n = pol ? 1 : 0;
const fazy = { pol: pol ? 1 : 0, glowa: ++n, kroki: kroki.map(() => ++n), wynik: ++n };
---
<div class="ak cz" style="--kw:760px;--kh:720px;--kk:760;--ko:0;aspect-ratio:760 / 720" data-ak-skaluj data-cz data-fazy={fazy.wynik} aria-hidden="true">
<div class="ak-in"><div class="w-app cz-app"><div class="cz-col">
{pol && <div class={`w-msg-user cz-f f${fazy.pol}`}>{pol}</div>}
<div class="w-steps">
<div class={`w-steps-head cz-f f${fazy.glowa}`}><img class="w-wise" src="/pod-klucz/kit/wise-avatar.svg" alt=""><span>{glowa}</span></div>
{kroki.map((k, i) => (
  <div class={`w-step cz-f f${fazy.kroki[i]}`}><div class="w-step-tile" set:html={IKO[k.ik]}></div><div class="w-step-main"><div class="w-step-title">{k.t}</div><div class="w-step-sub">{k.sub}</div><div class="w-step-data">{k.pills.map((p) => <span class="w-pill">{p}</span>)}</div></div><Fragment set:html={PTAK} /></div>
))}
</div>
{odp && <div class={`w-msg-wise cz-f f${fazy.wynik}`}>{odp}</div>}
{dok && <div class={`w-doccard cz-f f${fazy.wynik}`}><div class="w-doccard-tile"><Fragment set:html={PLIK} /><img class="w-wise" src="/pod-klucz/kit/wise-avatar.svg" alt=""></div><div><div class="w-doccard-title">{dok.t}</div><div class="w-doccard-sub">{dok.sub}</div></div></div>}
<div class="w-composer"><div class="w-composer-text"><span class="w-composer-ph">Pokieruj agentem…</span></div><div class="w-composer-row"><span class="w-agent"><img class="w-wise" src="/pod-klucz/kit/wise-avatar.svg" alt="">Wise</span><span style="flex:1"></span><span class="w-send"><svg class="w-ico" viewBox="0 0 24 24"><path d="m5 12 7-7 7 7"/><path d="M12 19V5"/></svg></span></div></div>
</div></div></div>
</div>

<style is:global>
  .cz .cz-app{position:absolute;left:0;top:0;width:760px !important;height:720px !important;border-radius:0 !important;box-shadow:none !important;background:#FAF9F7}
  .cz-col{position:absolute;inset:0;padding:40px 44px}
  .cz .w-msg-wise{max-width:none}
  .cz-f{opacity:0;transform:translateY(12px);transition:opacity .45s ease,transform .5s cubic-bezier(.2,.7,.2,1)}
  .cz .w-check{transform:scale(0);transition:transform .35s cubic-bezier(.34,1.5,.64,1) .45s}
  .cz.gotowe .cz-f,.cz.gotowe .w-check{opacity:1;transform:none}
  .cz.f1 .cz-f.f1,.cz.f2 .cz-f.f2,.cz.f3 .cz-f.f3,.cz.f4 .cz-f.f4,.cz.f5 .cz-f.f5,.cz.f6 .cz-f.f6,.cz.f7 .cz-f.f7{opacity:1;transform:none}
  .cz.f1 .cz-f.f1 .w-check,.cz.f2 .cz-f.f2 .w-check,.cz.f3 .cz-f.f3 .w-check,.cz.f4 .cz-f.f4 .w-check,.cz.f5 .cz-f.f5 .w-check,.cz.f6 .cz-f.f6 .w-check,.cz.f7 .cz-f.f7 .w-check{transform:scale(1)}
  @media (prefers-reduced-motion:reduce){ .cz-f,.cz .w-check{transition:none} }
</style>
