---
// Jeden przykład do sekcji „Co jeszcze może przejąć AI”: pełne okno appto
// (szyna, pasek, wątek, opcjonalnie panel pliku) z klas kitu, w proporcjach
// pokazu „AI na każdą potrzebę” z appto.ai. Zachowanie też stamtąd: wątek
// stoi już zrobiony (polecenie, kroki, odpowiedź), a po chwili przychodzi
// krótka poprawka: polecenie pisane w kompozytorze, kroki, odpowiedź i zmiana
// w pliku podświetlona na żółto. Nowa część powstaje na oczach (studio/ZASADY.md).
// Klasy faz (.f1…) i pisanie daje skrypt strony. Rozmiar logiczny 1920 × 740.
import { KIT_MARKUP } from './kit-markup';

interface Krok { ik: string; t: string; sub: string; pills: string[] }
interface Beat { u?: string; glowa?: string; kroki?: Krok[]; r?: string; dok?: { t: string; sub: string } }
interface Plik { tytul: string; strona: string }    // HTML strony dokumentu; .nowe = zmiana z poprawki
interface Props { tytul: string; przed: Beat; poprawka: Beat; plik?: Plik }
const { tytul, przed, poprawka, plik } = Astro.props;

const RAIL = (KIT_MARKUP.match(/<aside class="w-rail">[\s\S]*?<\/aside>/) || [''])[0];
const TOP = (KIT_MARKUP.match(/<header class="w-top">[\s\S]*?<\/header>/) || [''])[0]
  .replace(/(<span class="w-top-title"[^>]*>)[^<]*(<\/span>)/, `$1${tytul}$2`).replace(/ data-w="[^"]*"/g, '');
const IKO: Record<string, string> = {
  hub: '<img src="/pod-klucz/kit/brand-hubspot.svg" alt="">',
  gm: '<img src="/pod-klucz/brand-gmail.svg" alt="">',
  mic: '<svg class="w-ico" viewBox="0 0 24 24"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><path d="M12 19v3"/></svg>',
  ks: '<svg class="w-ico" viewBox="0 0 24 24"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg>',
  db: '<svg class="w-ico" viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/></svg>',
  fk: '<svg class="w-ico" viewBox="0 0 24 24"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 17.5v-11"/></svg>',
  dok: '<svg class="w-ico" viewBox="0 0 24 24"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"/><path d="M14 2v5a1 1 0 0 0 1 1h5"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>',
};
const PTAK = '<div class="w-check"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></div>';
const PLIK = IKO.dok;
const WYSLIJ = '<span class="w-send"><svg class="w-ico" viewBox="0 0 24 24"><path d="m5 12 7-7 7 7"/><path d="M12 19V5"/></svg></span>';
const krok = (k: Krok, f = '') => `<div class="w-step${f}"><div class="w-step-tile">${IKO[k.ik]}</div><div class="w-step-main"><div class="w-step-title">${k.t}</div><div class="w-step-sub">${k.sub}</div>${k.pills.length ? `<div class="w-step-data">${k.pills.map((p) => `<span class="w-pill">${p}</span>`).join('')}</div>` : ''}</div>${PTAK}</div>`;
const beat = (b: Beat, live: boolean) => {
  const F = (n: number) => (live ? ` op-f op-f${n}` : '');
  let h = '';
  if (b.u) h += `<div class="w-msg-user${F(1)}">${b.u}</div>`;
  if (b.kroki) h += `<div class="w-steps"><div class="w-steps-head${F(2)}"><img class="w-wise" src="/pod-klucz/kit/wise-avatar.svg" alt=""><span>${b.glowa ?? 'Appto wykonało kroki'}</span></div>${b.kroki.map((k, i) => krok(k, F(3 + i))).join('')}</div>`;
  const nr = 3 + (b.kroki?.length ?? 0);
  if (b.r) h += `<div class="w-msg-wise op-r${F(nr)}">${b.r}</div>`;
  if (b.dok) h += `<div class="w-doccard${F(nr)}"><div class="w-doccard-tile">${PLIK}<img class="w-wise" src="/pod-klucz/kit/wise-avatar.svg" alt=""></div><div><div class="w-doccard-title">${b.dok.t}</div><div class="w-doccard-sub">${b.dok.sub}</div></div></div>`;
  return h;
};
const ostatnia = 3 + (poprawka.kroki?.length ?? 0);
---
<div class={`ak op${plik ? ' op--plik' : ''}`} style="--kw:1920px;--kh:740px" data-ak-skaluj data-op data-fazy={ostatnia} data-pol={poprawka.u} aria-hidden="true">
<div class="ak-in"><div class="w-app op-app">
<Fragment set:html={RAIL} />
<Fragment set:html={TOP} />
<section class="w-chat op-chat"><div class="op-watek" data-op-watek>
<Fragment set:html={beat(przed, false)} />
<div class="op-live"><Fragment set:html={beat(poprawka, true)} /></div>
</div>
<div class="w-composer"><div class="w-composer-text" data-op-pole><span class="w-composer-ph">Pokieruj agentem…</span></div><div class="w-composer-row"><span class="w-agent"><img class="w-wise" src="/pod-klucz/kit/wise-avatar.svg" alt="">Wise</span><span style="flex:1"></span><Fragment set:html={WYSLIJ} /></div></div>
</section>
{plik && (
  <section class="w-pane op-pane">
    <div class="w-pane-head"><div class="w-pane-tile" set:html={PLIK}></div><span class="w-pane-title">{plik.tytul}</span><span class="w-badge">Dokument</span></div>
    <div class="w-canvas"><article class="op-page" set:html={plik.strona}></article></div>
  </section>
)}
</div></div>
</div>

<style is:global>
  /* kadr: cały ekran aplikacji; na telefonie sama kolumna wątku (szerokość 760) */
  .op{--kk:1920;--ko:0;aspect-ratio:1920 / 740}
  /* telefon: węższa kolumna wątku (560) i wyższy kadr, żeby tekst był czytelny */
  @media (max-width:760px){
    .op{--kk:600;--ko:590;--kh:1000px;aspect-ratio:600 / 1000}
    .op.op--plik{--ko:56}
    .op .op-app{height:1000px !important}
    .op .op-chat{width:560px}
    .op .w-rail{display:none}
    .op .w-top{padding-left:calc(var(--ko) * 1px + 24px)}
    .op .w-top-right{display:none}
  }
  .op .op-app{width:1920px !important;height:740px !important;border-radius:0 !important;box-shadow:none !important}
  .op .w-rail{top:140px}
  /* bez panelu pliku wątek stoi na środku okna, z panelem po lewej (jak w appto) */
  .op:not(.op--plik) .op-chat{left:610px}
  .op-watek{position:absolute;left:34px;right:34px;top:34px;bottom:190px;display:flex;flex-direction:column;justify-content:flex-end;overflow:hidden;-webkit-mask-image:linear-gradient(to bottom,transparent 0,#000 80px);mask-image:linear-gradient(to bottom,transparent 0,#000 80px)}
  .op-watek > *,.op-live > *{flex-shrink:0}
  .op-live{display:flex;flex-direction:column}
  .op .w-msg-user{margin-top:22px}
  .op .w-msg-wise{max-width:none}
  .op .w-msg-wise blockquote{margin:12px 0;padding:12px 16px;border-left:3px solid rgba(20,20,20,.15);background:#fff;border-radius:0 10px 10px 0;color:var(--t2)}
  .op .w-msg-wise p{margin:0 0 8px}
  .op-f{display:none}
  .op.f1 .op-f1,.op.f2 .op-f2,.op.f3 .op-f3,.op.f4 .op-f4,.op.f5 .op-f5,.op.f6 .op-f6{display:flex;animation:op-in .45s cubic-bezier(.2,.7,.2,1) both}
  .op.f1 .w-msg-user.op-f1{display:block}
  .op.f3 .w-msg-wise.op-f3,.op.f4 .w-msg-wise.op-f4,.op.f5 .w-msg-wise.op-f5,.op.f6 .w-msg-wise.op-f6{display:block}
  .op .op-f .w-check{transform:scale(0);animation:op-pt .35s cubic-bezier(.34,1.5,.64,1) .4s both}
  @keyframes op-in{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
  @keyframes op-pt{to{transform:scale(1)}}
  .op .w-send{transition:transform .2s ease,background .2s}
  .op.wyslij .w-send{transform:scale(.86);background:#00CD77}
  .op .ak-kursor{display:inline-block;width:2px;height:24px;margin-left:1px;background:#141414;vertical-align:-4px}
  /* dokument w panelu: strona jak w podglądzie pliku appto */
  .op-pane .w-canvas{display:flex;justify-content:center;padding-top:36px}
  .op-page{width:820px;padding:44px 52px;background:#fff;border-radius:14px;box-shadow:0 0 0 1px rgba(15,23,42,.06),0 30px 70px -30px rgba(15,23,42,.3);font-family:"InterApp",system-ui,sans-serif;font-size:18px;line-height:1.5;color:#1B2430}
  .op-page .lh{display:flex;justify-content:space-between;padding-bottom:14px;border-bottom:2px solid #10243E;font-family:"MontserratApp",sans-serif;font-weight:800;letter-spacing:.12em;color:#10243E}
  .op-page .lh small{font-family:"InterApp",sans-serif;font-weight:500;letter-spacing:0;color:#6A7686}
  .op-page h4{margin:26px 0 6px;font-family:"MontserratApp",sans-serif;font-size:30px;font-weight:800;letter-spacing:-.02em;color:#10243E}
  .op-page .pd{margin:0 0 18px;color:#6A7686;font-size:16px}
  .op-page table{width:100%;border-collapse:collapse;font-size:17px}
  .op-page th{padding:10px 12px;text-align:left;background:#10243E;color:#fff;font-size:13px;letter-spacing:.08em;text-transform:uppercase}
  .op-page td{padding:11px 12px;border-bottom:1px solid #E6EAF0}
  .op-page td.n,.op-page th.n{text-align:right;white-space:nowrap}
  .op-page .nowe{display:none}
  .op.zmiana .op-page .nowe{display:table-cell;background:#FFF1B8;animation:op-in .45s ease both}
  .op.zmiana .op-page th.nowe{background:#C99A1E}
  @media (prefers-reduced-motion:reduce){ .op-f,.op .op-f .w-check{animation:none !important} }
</style>
