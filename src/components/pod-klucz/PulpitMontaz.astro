---
// HERO: kadr z reklamy Stories „Wdrożenie AI pod klucz” (pk3 v7), w pętli.
// Monitor na biurku, pulpit macOS z Podglądem „Instrukcja montażu AI”. Kroki
// samodzielnego montażu wyskakują w prawdziwych oknach (Finder, TextEdit,
// Chrome, Numbers, Kalendarz), wylewają się poza monitor, licznik „23 z 64
// kroków”, potem wszystko wpada w ekran, instrukcja się zamyka, pulpit
// zostaje czysty i pojawia się „Zrobimy to za Was” z sygnetem Let's.
// Appto nie stoi w hero (v2, 18.11): jedyna scena pracy w appto jest niżej
// i zaczyna się od pustego okna (studio/ZASADY.md, „Praca w UI od stanu
// »przed«”). Okna i liczby to rekwizyty metafory
// instrukcji montażu z reklamy (WYTYCZNE-reklamy §8), nie twierdzenia.
//
// Scena ma stały rozmiar logiczny 1080 × 920 (kadr zdjęcia z reklamy od 540 px
// w dół) i skaluje się skryptem strony (data-pm). Bez skryptu i przy
// ograniczonym ruchu stoi kadr z oknami (klasa .stat).
// Źródło okien i pozycji: ~/filmy/appto-stories/build_pk3.py.
import { W } from './okna';

const SX = 46, SY = 113, SW = 985, SH = 505;       // ekran monitora na zdjęciu
const DS = SW / 1280;                               // pulpit 1280 × 656 → ekran
const SCX = SX + SW / 2, SCY = SY + SH / 2;
const d2s = (x: number, y: number) => [SX + x * DS, SY + y * DS];

// [id, x, y, w, h, obrót, czas ms, numer, nazwa, gdzie]  gdzie: d = pulpit (px pulpitu), s = scena (skala SP)
const SP = 1.18;
const OKNA: [string, number, number, number, number, number, number, string, string, 'd' | 's'][] = [
  ['w1', 40, 60, 600, 300, -0.6, 600, '1', 'Znajdź kontekst firmy', 'd'],
  ['w2', 650, 80, 590, 300, 0.8, 1250, '2', 'Rozdziel instrukcje', 'd'],
  ['w3', 90, 290, 560, 290, 0.9, 1850, '3', 'Napisz skille', 'd'],
  ['w4', 670, 280, 580, 300, -0.8, 2400, '4', 'Podłącz Gmaila i CRM', 'd'],
  ['w5', 512, 560, 455, 270, 2.2, 2900, '5', 'Przetestuj 20 przypadków', 's'],
  ['w6', 20, 588, 430, 265, -2.0, 3350, '6', 'Naucz zespół', 's'],
  ['w7', 16, 58, 430, 245, -2.6, 3750, '7', 'Ustaw uprawnienia', 's'],
  ['w8', 520, 44, 450, 235, 2.6, 4100, '8', 'Popraw instrukcje', 's'],
  ['w9', 300, 292, 430, 260, -3.4, 4450, '9', 'Złóż agenta ofert', 's'],
];
const pulpit = [] as string[], scena = [] as string[], znaczki = [] as string[];
for (const [id, x, y, w, h, r, t, n, nazwa, gdzie] of OKNA) {
  let fx, fy;
  if (gdzie === 'd') {
    const dx = 640 - (x + w / 2), dy = 328 - (y + h / 2);
    pulpit.push(`<div class="pm-w" data-t="${t}" style="left:${x}px;top:${y}px;width:${w}px;height:${h}px;--r:${r}deg;--dx:${dx.toFixed(0)}px;--dy:${dy.toFixed(0)}px">${W[id]}</div>`);
    [fx, fy] = d2s(x, y);
  } else {
    fx = x; fy = y;
    const dx = SCX - (x + w * SP / 2), dy = SCY - (y + h * SP / 2);
    scena.push(`<div class="pm-w pm-sp" data-t="${t}" style="left:${x}px;top:${y}px;width:${w}px;height:${h}px;--k:${SP};--r:${r}deg;--dx:${dx.toFixed(0)}px;--dy:${dy.toFixed(0)}px">${W[id]}</div>`);
  }
  const bx = Math.max(10, fx - 8), by = Math.max(6, fy - 34);
  znaczki.push(`<div class="pm-b" data-t="${t}" style="left:${bx.toFixed(0)}px;top:${by.toFixed(0)}px;--dx:${(SCX - bx - 120).toFixed(0)}px;--dy:${(SCY - by - 30).toFixed(0)}px"><span class="pm-bn">${n}</span><span class="pm-bt">${nazwa}</span></div>`);
}
const DUZY_T = 5000, LA_T = 7400;
---
<div class="pm stat" data-pm role="img" aria-label="Monitor na biurku. Na pulpicie otwiera się instrukcja montażu AI: 64 kroki. Kolejne kroki wyskakują w oknach: znajdź kontekst firmy, rozdziel instrukcje, napisz skille, podłącz Gmaila i CRM, przetestuj 20 przypadków, naucz zespół, ustaw uprawnienia, popraw instrukcje, złóż agenta ofert. Licznik pokazuje 23 z 64 kroków. Potem wszystkie okna znikają w ekranie, pulpit robi się czysty i pojawia się napis: Zrobimy to za Was.">
<div class="pm-sc" aria-hidden="true">
<img class="pm-bg" src="/pod-klucz/biurko.jpg" alt="" width="1080" height="920" fetchpriority="high" decoding="async">
<div class="pm-ekran" style={`left:${SX}px;top:${SY}px;width:${SW}px;height:${SH}px`}>
<div class="pm-desk" style={`transform:scale(${DS})`}>
<img class="pm-tapeta" src="/pod-klucz/tapeta.webp" alt="" width="1920" height="1080" decoding="async">
<div class="pm-mbar"><svg viewBox="0 0 14 17" class="pm-apl"><path d="M11.6 9c0-2 1.6-2.9 1.7-3-1-1.4-2.4-1.6-2.9-1.6-1.2-.1-2.4.7-3 .7s-1.6-.7-2.6-.7C3.4 4.4 2 5.3 1.3 6.6c-1.5 2.6-.4 6.4 1 8.5.7 1 1.5 2.1 2.6 2.1 1 0 1.4-.7 2.6-.7s1.6.7 2.6.7c1.1 0 1.8-1 2.5-2 .8-1.1 1.1-2.2 1.1-2.3 0 0-2.1-.8-2.1-3.9zM9.6 3c.6-.7.9-1.6.8-2.5-.8 0-1.8.5-2.3 1.2-.5.6-1 1.5-.9 2.4.9.1 1.8-.4 2.4-1.1z" fill="#111"/></svg><b>Finder</b><span>Plik</span><span>Edycja</span><span>Widok</span><span>Idź</span><span>Okno</span><span>Pomoc</span><em>wt. 18 lis  9:41</em></div>
<div class="pm-w pm-p0 on" style="left:400px;top:48px;width:481px;height:538px;--r:0deg;--dx:0px;--dy:0px" set:html={W.p0}></div>
<Fragment set:html={pulpit.join('')} />
<div class="pm-dock"><i class="ap"><img src="/pod-klucz/kit/appto-sygnet.svg" alt=""></i></div>
</div>
</div>
<Fragment set:html={scena.join('')} />
<Fragment set:html={znaczki.join('')} />
<div class="pm-duzy" data-t={DUZY_T}><span class="pm-bn">23</span><span class="pm-bt">z 64 kroków</span></div>
<div class="pm-la" data-t-la={LA_T}><span class="pm-bn"><svg viewBox="0 0 40.5 41" aria-hidden="true"><path d="M31.1674 0.5V17.4327C29.7901 11.2307 26.1381 0.5 26.1381 0.5H17.1107C18.599 6.44658 20.7794 12.7694 21.6328 16.7405H21.6193C20.7291 14.2443 18.7435 10.4076 14.2919 4.60213C13.1564 3.12389 12.0275 1.72963 11.0029 0.5H0C6.53453 7.53847 13.5092 17.1168 13.5092 20.5C13.5092 23.8832 6.53453 33.4614 0 40.5H11.0029C12.0309 39.2705 13.1597 37.8762 14.2919 36.3979C18.636 30.7301 20.635 26.9405 21.5522 24.4409C20.6484 28.4254 18.4176 34.6543 16.8822 40.5H25.9298C25.9298 40.5 29.6389 30.4245 31.1035 24.3636L30.8349 40.5H39.6641L39.9966 20.5538V0.5H31.1674Z" fill="#07140D"/></svg></span><span class="pm-bt">Zrobimy to za Was</span></div>
</div>
</div>

<style is:global>
  /* Scena 1080 × 920 skalowana do szerokości pudełka (--ps liczy skrypt). */
  .pm{position:relative;width:100%;aspect-ratio:1080 / 920;--ps:0.6}
  .pm-sc{position:absolute;left:0;top:0;width:1080px;height:920px;transform:scale(var(--ps));transform-origin:0 0;font-family:"InterApp",system-ui,sans-serif;color:#1d1d1f}
  .pm-bg{position:absolute;inset:0;width:1080px;height:920px;display:block}
  .pm-ekran{position:absolute;overflow:hidden;border-radius:3px;background:#000}
  .pm-desk{position:absolute;left:0;top:0;width:1280px;height:656px;transform-origin:0 0;overflow:hidden}
  .pm-tapeta{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .pm-mbar{position:absolute;left:0;top:0;right:0;height:24px;background:rgba(246,243,240,.62);display:flex;align-items:center;gap:17px;padding:0 14px;font-size:13px;z-index:50}
  .pm-mbar b{font-weight:700}.pm-mbar em{margin-left:auto;font-style:normal;font-weight:500}
  .pm-apl{width:12px;height:15px}
  .pm-dock{position:absolute;left:50%;bottom:6px;transform:translateX(-50%);height:54px;padding:6px 8px;border-radius:16px;background:rgba(246,243,240,.5);display:flex;gap:7px;z-index:40;border:1px solid rgba(255,255,255,.55)}
  .pm-dock i{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;background:#0a0a0b;box-shadow:0 1px 3px rgba(0,0,0,.2)}
  .pm-dock i img{width:24px;filter:invert(1)}

  /* okna */
  .pm-w{position:absolute;opacity:0;transform:translateY(12px) scale(.94) rotate(var(--r));transition:opacity .32s ease,transform .45s cubic-bezier(.2,.9,.25,1.15)}
  .pm-sp{transform-origin:0 0;transform:translateY(12px) scale(calc(var(--k) * .94)) rotate(var(--r))}
  .pm-w.on,.pm.stat .pm-w{opacity:1;transform:rotate(var(--r))}
  .pm-sp.on,.pm.stat .pm-sp{transform:scale(var(--k)) rotate(var(--r))}
  .pm-mw{position:absolute;inset:0;background:#fff;border-radius:11px;overflow:hidden;box-shadow:0 0 0 .5px rgba(0,0,0,.22),0 18px 44px -10px rgba(0,0,0,.45)}
  .pm-tbar{height:30px;background:#ececec;border-bottom:1px solid #d6d6d6;display:flex;align-items:center;padding:0 12px;position:relative}
  .pm-tl{display:flex;gap:8px;position:relative;z-index:2}.pm-tl i{width:12px;height:12px;border-radius:50%;display:block}
  .pm-tt{position:absolute;left:0;right:0;text-align:center;font-size:13px;font-weight:600;color:#4b4b4f}
  .pm-fd{display:flex;height:calc(100% - 30px)}
  .pm-sb{width:150px;background:#ededef;padding:10px 8px;font-size:13px;color:#3a3a3e;flex:none}
  .pm-sbh{font-size:11px;font-weight:600;color:#8a8a90;margin:6px 6px 4px}
  .pm-sbi{padding:4px 8px;border-radius:6px}.pm-sbi.on{background:#dadade}
  .pm-fl{flex:1;font-size:13px}
  .pm-lh,.pm-lr{display:grid;grid-template-columns:1fr 120px 60px;align-items:center;padding:0 14px}
  .pm-lh{height:26px;color:#6b6b73;font-size:12px;border-bottom:1px solid #e4e4e6}
  .pm-lr{height:30px}.pm-lr.z{background:#f5f5f7}
  .pm-lr span:first-child{display:flex;align-items:center;gap:8px;font-weight:500;white-space:nowrap}
  .pm-lr span:nth-child(n+2){color:#6b6b73}
  .pm-ic{width:18px;height:16px;flex:none}
  .pm-txt{padding:16px 22px;font-size:15px;line-height:1.75;color:#1d1d1f}
  .pm-txt s{color:#c4251a}
  .pm-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px 6px;padding:16px 12px}
  .pm-gi{display:flex;flex-direction:column;align-items:center;gap:6px;font-size:12px;font-weight:500}
  .pm-bigdoc{width:44px;height:55px}
  .pm-cbar{height:36px;background:#dfe3e8;display:flex;align-items:flex-end;padding:0 12px;gap:10px}
  .pm-cbar .pm-tl{align-self:center}
  .pm-ctab{background:#fff;border-radius:9px 9px 0 0;padding:8px 18px;font-size:12.5px;font-weight:500;margin-left:14px;min-width:200px}
  .pm-ctab2{align-self:center;color:#666;font-size:16px}
  .pm-curl{height:34px;background:#fff;display:flex;align-items:center;gap:12px;padding:0 12px;border-bottom:1px solid #e3e3e3}
  .pm-nav{color:#888;font-size:16px;letter-spacing:4px}
  .pm-addr{flex:1;background:#eef1f4;border-radius:14px;padding:5px 14px;font-size:12.5px;color:#444}
  .pm-cpg{padding:14px 20px}
  .pm-ir{display:flex;align-items:center;gap:12px;height:52px;border-bottom:1px solid #eee;font-size:15px}
  .pm-ir img{width:26px;height:22px;object-fit:contain}
  .pm-ir span{margin-left:auto;font-size:12.5px;font-weight:600;border-radius:99px;padding:4px 10px}
  .pm-ir .er{background:#fde8e6;color:#c4251a}.pm-ir .mu{background:#f0f0f2;color:#5d5d65}
  .pm-sh{border-collapse:collapse;width:100%;font-size:14px}
  .pm-sh th{background:#f4f4f6;color:#5d5d65;font-weight:600;text-align:left;padding:6px 10px;border:1px solid #e4e4e6}
  .pm-sh td{padding:6px 10px;border:1px solid #e9e9eb}
  .pm-sh .rn{color:#7a7a80;width:28px;background:#f8f8fa}
  .pm-sh .bad{color:#c4251a;font-weight:600}.pm-sh .ok{color:#047857;font-weight:600}
  .pm-sum{padding:8px 10px;font-weight:700;color:#c4251a;font-size:15px}
  .pm-wk{height:calc(100% - 30px);display:flex;flex-direction:column}
  .pm-dh{display:grid;grid-template-columns:repeat(3,1fr);font-size:13px;font-weight:600;color:#55555c;border-bottom:1px solid #e4e4e6}
  .pm-dh span{padding:8px 10px}
  .pm-dc{flex:1;display:grid;grid-template-columns:repeat(3,1fr)}
  .pm-col{position:relative;border-right:1px solid #eee}
  .pm-evt{position:absolute;left:6px;right:6px;background:#e3f1ee;border-left:4px solid #0f766e;border-radius:6px;padding:6px 8px;font-size:12px;color:#0b5c55;line-height:1.35}
  .pm-evt b{display:block;font-size:13px;color:#08443f}
  .pm-pm{border-collapse:collapse;width:100%;font-size:14px}
  .pm-pm th{color:#5d5d65;font-weight:600;padding:6px 0}
  .pm-pm td{text-align:center;padding:7px 0;border-top:1px solid #eee}.pm-pm td:first-child{text-align:left;font-weight:500}
  .pm-dot{display:inline-block;width:14px;height:14px;border-radius:50%;border:2px solid #b9b9c0}.pm-dot.on{background:#0a0a0b;border-color:#0a0a0b}
  .pm-pm .q{font-family:"Schibsted Grotesk",sans-serif;font-weight:700;color:#c4251a;font-size:18px}
  .pm-pvtool{height:30px;background:#f3f3f3;border-bottom:1px solid #ddd;display:flex;align-items:center;justify-content:center;font-size:12px;color:#5d5d65;margin-top:-1px}
  .pm-pvbg{position:absolute;top:60px;left:0;right:0;bottom:0;background:#8e8e93;display:flex;align-items:center;justify-content:center}
  .pm-page{background:#fff;height:92%;aspect-ratio:1/1.3;padding:8% 9%;display:flex;flex-direction:column;justify-content:center;box-shadow:0 4px 14px rgba(0,0,0,.25)}
  .pm-box{width:46%;margin-bottom:8%}
  .pm-page h3{margin:0;font-family:"Schibsted Grotesk",sans-serif;font-weight:700;font-size:30px;line-height:.98;letter-spacing:-.045em}
  .pm-page p{margin:8px 0 0;font-size:13px;color:#5d5d65}
  .pm-lost{display:flex;flex-direction:column;align-items:flex-start;gap:8px}
  .pm-fig{width:90px}
  .pm-miss{font-family:"Schibsted Grotesk",sans-serif;font-weight:700;font-size:24px;letter-spacing:-.03em;line-height:1}
  .pm-sub{font-size:12px;color:#5d5d65;margin-top:6px}

  /* znaczki kroków jak w reklamie: zielony kwadrat z numerem + ciemny pasek */
  .pm-b,.pm-duzy,.pm-la{position:absolute;display:flex;align-items:center;opacity:0;transform:translateY(10px);transition:opacity .3s ease,transform .4s cubic-bezier(.2,.9,.25,1.15);font-family:"Schibsted Grotesk",sans-serif;z-index:5}
  .pm-b.on,.pm.stat .pm-b,.pm-duzy.on,.pm.stat .pm-duzy,.pm-la.on{opacity:1;transform:none}
  .pm-bn{min-width:64px;height:64px;padding:0 14px;border-radius:4px;background:#00CD77;color:#07140D;font-weight:800;font-size:40px;display:flex;align-items:center;justify-content:center;position:relative;z-index:2}
  .pm-bt{background:#07140D;color:#fff;font-weight:800;font-size:32px;letter-spacing:-.03em;height:64px;display:flex;align-items:center;padding:0 24px;border-radius:0 4px 4px 0;white-space:nowrap}
  .pm-duzy{left:110px;top:350px;z-index:6}
  .pm-duzy .pm-bn{min-width:150px;height:150px;font-size:96px}
  .pm-duzy .pm-bt{height:150px;font-size:68px;padding:0 44px}
  .pm-la{left:250px;top:317px;z-index:6}
  .pm-la .pm-bn{width:96px;height:96px}
  .pm-la .pm-bn svg{width:46px;height:46px}
  .pm-la .pm-bt{height:96px;font-size:50px;padding:0 34px}

  /* zwinięcie: okna i znaczki wpadają w ekran */
  .pm.zwin .pm-w.on,.pm.zwin .pm-b.on,.pm.zwin .pm-duzy.on{opacity:0;transform:translate(var(--dx,0px),var(--dy,0px)) scale(.12) rotate(0deg);transition:opacity .5s ease .1s,transform .6s cubic-bezier(.65,0,.35,1)}
  .pm.zwin .pm-duzy.on{transform:translate(280px,-20px) scale(.12)}
  .pm.zwin .pm-sp.on{transform:translate(var(--dx),var(--dy)) scale(.12)}
  /* po zwinięciu instrukcja też się zamyka: zostaje czysty pulpit */
  .pm.app .pm-p0{opacity:0;transform:scale(.9);transition:opacity .4s ease,transform .45s cubic-bezier(.65,0,.35,1)}
  .pm.reset .pm-sc{opacity:0;transition:opacity .6s ease}
  .pm-sc{transition:opacity .6s ease}
  @media (prefers-reduced-motion:reduce){ .pm-w,.pm-b,.pm-duzy,.pm-la,.pm-sc{transition:none !important} }
</style>
