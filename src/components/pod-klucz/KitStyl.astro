---
// Style kitu Appto (WYGENEROWANE z ~/filmy/appto-stories/src/app/world.html).
// Kroje mają własne nazwy (GeistApp, InterApp, MontserratApp), żeby nie mieszać
// się z krojami strony. Pliki krojów leżą w public/appto/kit/fonts.
---
<style is:global>
@font-face{font-family:"GeistApp";src:url("/appto/kit/fonts/geist-latin-wght-normal.woff2") format("woff2");font-weight:100 900;font-display:swap;unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:"GeistApp";src:url("/appto/kit/fonts/geist-latin-ext-wght-normal.woff2") format("woff2");font-weight:100 900;font-display:swap;unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}
@font-face{font-family:"InterApp";src:url("/appto/kit/fonts/inter-latin-wght-normal.woff2") format("woff2");font-weight:100 900;font-display:swap;unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:"InterApp";src:url("/appto/kit/fonts/inter-latin-ext-wght-normal.woff2") format("woff2");font-weight:100 900;font-display:swap;unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}
@font-face{font-family:"MontserratApp";src:url("/appto/kit/fonts/montserrat-latin-wght-normal.woff2") format("woff2");font-weight:100 900;font-display:swap;unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:"MontserratApp";src:url("/appto/kit/fonts/montserrat-latin-ext-wght-normal.woff2") format("woff2");font-weight:100 900;font-display:swap;unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}
.w-app,.w-app *{box-sizing:border-box}
.w-app{
  --ink:#141414; --canvas:#F7F7F3; --page-bg:#FAF9F7; --white:#fff;
  --t1:rgba(20,20,20,1); --t2:rgba(20,20,20,.62); --t3:rgba(20,20,20,.48); --t4:rgba(20,20,20,.32);
  --line:rgba(20,20,20,.08); --line2:rgba(20,20,20,.12); --soft:rgba(20,20,20,.05); --softer:rgba(20,20,20,.03);
  --ok:#059669;
  --b-primary:#10243E; --b-accent:#0f766e; --b-soft:#EEF2F7; --b-ink:#1B2430; --b-mute:#6A7686;
  --b-head:"MontserratApp"; --b-body:"InterApp";
  position:absolute; left:0; top:0; width:1920px; height:1080px; overflow:hidden;
  background:var(--page-bg); color:var(--t1); font-family:"GeistApp",sans-serif; font-size:19px; line-height:1.35;
  border-radius:22px; box-shadow:0 0 0 1px rgba(20,20,20,.07),0 40px 120px -40px rgba(20,20,20,.35);
}
.w-ico{width:24px;height:24px;stroke:currentColor;fill:none;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round;flex:none}
.w-rail{position:absolute;left:16px;top:288px;width:70px;display:flex;flex-direction:column;align-items:center;color:var(--t2);z-index:6}
.w-rail-nav{width:70px;display:flex;flex-direction:column;align-items:center;gap:5px;padding:9px 0;border-radius:23px;background:rgba(255,255,255,.96);border:1px solid rgba(20,20,20,.1);box-shadow:0 16px 40px -24px rgba(0,0,0,.45)}
.w-rail-logo{width:41px;height:41px;margin:4.5px 0;border-radius:14px;background:var(--ink);display:grid;place-items:center;box-shadow:0 1px 2px rgba(0,0,0,.08)}
.w-rail-logo img{width:24px;filter:invert(1)}
.w-rail-div{width:27px;height:1px;background:var(--soft);margin:5px 0}
.w-rail-btn{width:50px;height:50px;border-radius:18px;display:grid;place-items:center}
.w-rail-btn .w-ico{width:21px;height:21px;stroke-width:1.8}
.w-rail-btn.is-on{background:var(--ink);color:#FAF9F7;box-shadow:0 1px 2px rgba(0,0,0,.08)}
.w-rail-btn.is-on .w-ico{stroke-width:2.2}
.w-rail-exp{margin-top:9px;width:23px;height:23px;display:grid;place-items:center;color:rgba(20,20,20,.25)}
.w-rail-exp .w-ico{width:18px;height:18px;stroke-width:2}
.w-top{position:absolute;left:0;top:0;right:0;height:64px;display:flex;align-items:center;gap:20px;padding:0 30px 0 36px;background:var(--page-bg);font-size:18px}
.w-top-logo{height:26px}
.w-top-sep{color:rgba(20,20,20,.38);font-size:15px}
.w-top-title{font-weight:600;color:var(--t2);white-space:nowrap}
.w-top-right{margin-left:auto;display:flex;align-items:center;gap:6px;color:var(--t2);font-size:15px}
.w-top-div{width:1px;height:32px;background:var(--soft);margin:0 8px}
.w-kbd{display:flex;align-items:center;gap:10px;height:44px;padding:0 14px;border-radius:14px;font-weight:500;color:var(--t3)}
.w-kbd .w-ico{width:21px;height:21px;color:var(--t2)}
.w-avatar{width:38px;height:38px;margin-left:8px;border-radius:50%;background:#E9E6DF;color:#141414;display:grid;place-items:center;font-weight:600;font-size:15px}
.w-chat{position:absolute;left:76px;top:64px;width:700px;bottom:0;padding:34px 34px 0 34px}
.w-msg-user{margin-left:auto;width:fit-content;max-width:520px;background:rgba(20,20,20,.92);color:#FAF9F7;border-radius:22px;padding:16px 20px;font-size:19px;line-height:1.4}
.w-mention{display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.14);border-radius:8px;padding:1px 8px 1px 6px;font-weight:600;white-space:nowrap}
.w-mention .w-ico{width:17px;height:17px}
.w-steps{margin-top:26px;display:flex;flex-direction:column;gap:10px}
.w-steps-head{display:flex;align-items:center;gap:10px;color:var(--t2);font-size:17px;font-weight:500;margin-bottom:4px}
.w-wise{width:26px;height:26px;flex:none}
.w-step{display:flex;align-items:center;gap:14px;background:#fff;border:1px solid var(--line);border-radius:16px;padding:12px 16px;box-shadow:0 1px 2px rgba(0,0,0,.04)}
.w-step-tile{width:42px;height:42px;border-radius:11px;background:var(--soft);border:1px solid var(--line);display:grid;place-items:center;flex:none;color:var(--t2)}
.w-step-tile img{width:24px;height:24px}
.w-step-main{min-width:0;flex:1}
.w-step-title{font-weight:600;font-size:18px}
.w-step-sub{color:var(--t3);font-size:15.5px;margin-top:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.w-step-data{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.w-pill{background:var(--soft);border-radius:8px;padding:3px 9px;font-size:15px;font-weight:600;color:var(--t1);white-space:nowrap}
.w-check{width:26px;height:26px;border-radius:50%;background:var(--ok);display:grid;place-items:center;flex:none}
.w-check svg{width:15px;height:15px;stroke:#fff;stroke-width:3;fill:none;stroke-linecap:round;stroke-linejoin:round}
.w-msg-wise{margin-top:22px;font-size:19px;line-height:1.5;color:var(--t1);max-width:600px}
.w-doccard{margin-top:16px;display:flex;align-items:center;gap:14px;background:#fff;border:1.5px solid var(--line2);border-radius:22px;padding:12px 16px;width:470px;box-shadow:0 1px 2px rgba(20,20,20,.04)}
.w-doccard.is-selected{border-color:var(--ink)}
.w-doccard-tile{position:relative;width:46px;height:46px;border-radius:13px;background:rgba(14,165,233,.1);color:#0369a1;display:grid;place-items:center;flex:none}
.w-doccard-tile .w-wise{position:absolute;right:-6px;bottom:-6px;width:22px;height:22px}
.w-doccard-title{font-weight:600;font-size:18px}
.w-doccard-sub{color:var(--t3);font-size:15.5px}
.w-doccard-open{margin-left:auto;color:var(--t3);font-size:15.5px;font-weight:500;display:flex;align-items:center;gap:4px}
.w-composer{position:absolute;left:34px;right:34px;bottom:30px;background:#fff;border:1px solid var(--line);border-radius:28px;box-shadow:0 4px 24px rgba(0,0,0,.06);padding:18px 18px 14px 22px}
.w-composer-text{min-height:54px;font-size:19px;color:var(--t1)}
.w-composer-ph{color:var(--t4)}
.w-composer-row{display:flex;align-items:center;gap:8px;margin-top:6px;color:var(--t3)}
.w-agent{display:flex;align-items:center;gap:8px;border:1px solid var(--line);border-radius:999px;padding:6px 12px 6px 8px;font-size:16.5px;font-weight:500;color:var(--t2);background:#fff}
.w-agent .w-ico{width:17px;height:17px;color:var(--t3)}
.w-round{width:40px;height:40px;border-radius:50%;display:grid;place-items:center}
.w-composer .w-round{border:1px solid var(--line);background:#fff;color:var(--t3)}
.w-composer .w-round .w-ico{width:20px;height:20px}
.w-send{margin-left:6px;width:44px;height:44px;border-radius:50%;background:var(--ink);color:#FAF9F7;display:grid;place-items:center}
.w-pane{position:absolute;left:776px;top:64px;right:0;bottom:0;background:#fff;border-left:1px solid var(--line);overflow:hidden}
.w-pane-head{height:66px;display:flex;align-items:center;gap:12px;padding:0 20px;border-bottom:1px solid var(--line)}
.w-pane-tile{width:40px;height:40px;border-radius:12px;background:rgba(14,165,233,.1);color:#0369a1;display:grid;place-items:center;flex:none}
.w-pane-tile .w-ico{width:21px;height:21px}
.w-pane-title{font-weight:600;font-size:18.5px;white-space:nowrap}
.w-badge{background:rgba(20,20,20,.06);color:var(--t2);border-radius:8px;padding:3px 9px;font-size:14.5px;font-weight:600}
.w-pane-actions{margin-left:auto;display:flex;align-items:center;gap:8px;color:var(--t3)}
.w-pane-icons{display:flex;align-items:center;gap:4px}
.w-pane-icons .w-round{width:31px;border-radius:10px}
.w-pane-icons .w-ico{width:21px;height:21px}
.w-btn{height:40px;border-radius:13px;padding:0 15px;display:flex;align-items:center;gap:8px;font-size:16.5px;font-weight:600;color:var(--t2)}
.w-btn.is-primary{background:var(--ink);color:#FAF9F7}
.w-btn.is-outline{border:1px solid var(--line2);background:#fff}
.w-toolbar{position:absolute;left:162px;top:84px;width:820px;height:52px;background:#fff;border:1px solid var(--line);border-radius:17px;box-shadow:0 1px 2px rgba(20,20,20,.04),0 8px 24px -12px rgba(20,20,20,.18);display:flex;align-items:center;gap:0;padding:0 8px;color:var(--t3);z-index:3}
.w-toolbar .w-ico{width:19px;height:19px}
.w-tb-b{width:30px;height:36px;border-radius:9px;display:grid;place-items:center;flex:none}
.w-tb-b.is-menu{width:auto;display:flex;align-items:center;gap:2px;padding:0 3px}
.w-tb-b.is-menu .w-ico+.w-ico{width:14px;height:14px}
.w-tb-sep{width:1px;height:21px;background:var(--line2);margin:0 3px;flex:none}
.w-tb-style{font-size:16px;color:var(--t2);display:flex;align-items:center;justify-content:space-between;gap:6px;font-weight:500;width:126px;height:36px;padding:0 7px;white-space:nowrap;flex:none}
.w-tb-style .w-ico{width:16px;height:16px;color:var(--t3)}
.w-tb-right{margin-left:auto;display:flex;align-items:center;gap:10px;font-size:15px;white-space:nowrap}
[data-w="w-saved"]{display:inline-flex;align-items:center;gap:6px}
.w-tb-ok{display:inline-flex;align-items:center;gap:6px}
[data-w="w-saved"] .w-ico{width:17px;height:17px;color:var(--ok);stroke-width:2.4}
.w-seg{display:flex;background:var(--softer);border-radius:10px;padding:3px;font-weight:500}
.w-seg span{padding:4px 9px;border-radius:8px}
.w-seg .is-on{background:#fff;color:var(--t1);box-shadow:0 1px 2px rgba(0,0,0,.08)}
.w-canvas{position:absolute;left:0;right:0;top:66px;bottom:0;background:var(--page-bg);overflow:hidden}
.w-scroll{position:absolute;left:162px;top:92px;width:820px}
.w-page{width:820px;background:#fff;border-radius:14px;overflow:hidden;color:var(--b-ink);font-family:var(--b-body),sans-serif;font-size:19px;line-height:1.5;box-shadow:0 0 0 1px rgba(15,23,42,.06),0 2px 4px rgba(15,23,42,.04),0 30px 70px -30px rgba(15,23,42,.3)}
.w-cover{position:relative;height:384px;background:var(--b-primary);color:#fff;padding:36px 44px;overflow:hidden}
.w-cover-art{position:absolute;inset:0;pointer-events:none}
.w-art-disc{position:absolute;right:-70px;top:-90px;width:330px;height:330px;border-radius:50%;background:var(--b-accent)}
.w-art-ring{position:absolute;right:150px;top:150px;width:210px;height:210px;border-radius:50%;border:26px solid rgba(255,255,255,.14)}
.w-art-quarter{position:absolute;right:-40px;bottom:-140px;width:280px;height:280px;border-radius:50%;background:rgba(255,255,255,.08)}
.w-art-dots{position:absolute;right:300px;top:40px;width:120px;height:84px;background-image:radial-gradient(rgba(255,255,255,.35) 2.2px,transparent 2.6px);background-size:20px 20px}
.w-art-bar{position:absolute;left:44px;bottom:0;width:120px;height:8px;background:var(--b-accent)}
.w-cover-top{position:relative;display:flex;align-items:center;gap:12px;font-size:17px;font-weight:600}
.w-logo{width:34px;height:34px;border-radius:9px;background:#fff;color:var(--b-primary);display:grid;place-items:center;font-family:var(--b-head);font-weight:800;font-size:21px}
.w-cover-no{margin-left:14px;font-weight:500;opacity:.6;font-size:15.5px}
.w-kicker{position:relative;margin-top:54px;font-size:15px;letter-spacing:.14em;text-transform:uppercase;font-weight:700;color:var(--b-accent)}
.w-title{position:relative;margin-top:6px;font-family:var(--b-head),sans-serif;font-weight:800;font-size:62px;line-height:1.02;letter-spacing:-.025em}
.w-for{position:relative;margin-top:20px;font-size:23px;font-weight:500;display:flex;align-items:center;gap:10px}
.w-for>span:first-child{opacity:.7}
.w-meta{display:grid;grid-template-columns:1.25fr 1fr 1fr;background:var(--b-soft)}
.w-meta>div{padding:16px 0 16px 44px}
.w-meta>div+div{padding-left:24px;border-left:1px solid rgba(16,36,62,.08)}
.w-lab{font-size:13px;letter-spacing:.1em;text-transform:uppercase;font-weight:700;color:var(--b-mute)}
.w-val{font-size:19px;font-weight:600;margin-top:2px;min-height:30px}
.w-body{padding:30px 44px 44px}
.w-tiles{display:grid;grid-template-columns:1.25fr 1fr 1fr;gap:14px}
.w-tile{border:1px solid rgba(16,36,62,.1);border-radius:14px;padding:16px 18px 18px;position:relative;overflow:hidden;background:#fff}
.w-tile::before{content:"";position:absolute;left:0;top:0;bottom:0;width:5px;background:var(--b-accent)}
.w-tile.is-hero{background:var(--b-primary);color:#fff;border-color:transparent}
.w-tile.is-hero .w-lab{color:rgba(255,255,255,.6)}
.w-big{font-family:var(--b-head),sans-serif;font-weight:800;font-size:36px;line-height:1.15;letter-spacing:-.02em;margin-top:6px;white-space:nowrap;min-height:42px}
.w-big small{font-size:18px;font-weight:600;opacity:.7;letter-spacing:0}
.w-h2{display:flex;align-items:baseline;gap:14px;margin-top:34px;font-family:var(--b-head),sans-serif;font-weight:800;font-size:30px;letter-spacing:-.02em;color:var(--b-primary)}
.w-h2 i{font-style:normal;font-size:17px;font-weight:800;color:#fff;background:var(--b-accent);border-radius:8px;padding:2px 9px;transform:translateY(-4px)}
.w-p{margin-top:10px;color:var(--b-ink)}
.w-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:18px}
.w-card{background:var(--b-soft);border-radius:14px;padding:16px;font-size:16.5px;line-height:1.35;font-weight:600;color:var(--b-primary)}
.w-card-ico{width:40px;height:40px;border-radius:11px;background:var(--b-primary);color:#fff;display:grid;place-items:center;margin-bottom:12px}
.w-card-ico .w-ico{width:22px;height:22px}
.w-card span{display:block;font-weight:400;color:var(--b-mute);font-size:15px;margin-top:3px}
.w-table{margin-top:16px;border-radius:14px;overflow:hidden;border:1px solid rgba(16,36,62,.1);font-size:18px}
.w-tr{display:grid;grid-template-columns:1fr 150px 170px;align-items:center;height:50px;padding:0 20px;border-top:1px solid rgba(16,36,62,.08)}
.w-tr>div:nth-child(n+2){text-align:right}
.w-tr.is-head{background:var(--b-primary);color:#fff;font-weight:700;border-top:0;font-size:15px;letter-spacing:.08em;text-transform:uppercase}
.w-tr.is-alt{background:rgba(16,36,62,.025)}
.w-tr.is-discount{color:var(--b-accent);font-weight:600}
.w-tr.is-total{height:60px;font-weight:800;font-family:var(--b-head),sans-serif;font-size:22px;color:var(--b-primary);background:var(--b-soft)}
.w-gantt{margin-top:18px;display:grid;gap:10px}
.w-g-row{display:grid;grid-template-columns:190px 1fr;align-items:center;font-size:16.5px;font-weight:600;color:var(--b-primary)}
.w-g-track{position:relative;height:26px;border-radius:8px;background:var(--b-soft)}
.w-g-bar{position:absolute;top:0;bottom:0;border-radius:8px;background:var(--b-primary)}
.w-g-bar.is-acc{background:var(--b-accent)}
.w-field{position:relative;display:inline-grid;align-items:baseline;border-radius:7px;padding:0 9px;white-space:nowrap}
.w-field>*{grid-area:1/1}
.w-field .w-f-label{color:#0f766e;font-weight:600;opacity:0}
.w-field .w-f-value{}
.w-field .w-f-tint{position:absolute;inset:0;border-radius:7px;background:rgba(15,118,110,.12);border-bottom:2px dashed #0f766e;opacity:0}
.w-cover .w-field .w-f-label,.w-tile.is-hero .w-field .w-f-label{color:#7FE3D4}
.w-cover .w-field .w-f-tint,.w-tile.is-hero .w-field .w-f-tint{background:rgba(127,227,212,.16);border-bottom-color:#7FE3D4}
.w-app.is-template .w-f-label,.w-app.is-template .w-f-tint{opacity:1}
.w-app.is-template .w-f-value{opacity:0}
</style>
