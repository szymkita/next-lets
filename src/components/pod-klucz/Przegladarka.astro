---
// OKNO PRZEGLĄDARKI z appto, jak w pokazach produktu na appto.ai (sekcja
// „AI na każdą potrzebę”, ApptoAI/landing-page: src/components/home/AnyNeed.astro
// i style .rw / .kp4-tab w src/styles/home-next-prod.css, 16.11.2026). Wymiary,
// kolory paska i kart przepisane z tamtego CSS; treść okna daje slot.
// Karty mogą być przyciskami (data-karta), wtedy przełączają przykłady.
import { FAV as FAV_N } from './narzedzia';
interface Karta { t: string; adres?: string; ikona?: 'appto' | 'wise' | 'gmail' | 'slack' | 'sheets' | 'hubspot' }
interface Props { karty: Karta[]; adres?: string; klikalne?: boolean; klasa?: string }
const { karty, adres = 'chat.appto.ai', klikalne = false, klasa = '' } = Astro.props;
const FAV: Record<string, string> = { appto: '/pod-klucz/kit/appto-sygnet.svg', wise: '/pod-klucz/kit/wise-avatar.svg' };
// ikona karty: plik (appto, wise) albo znak narzędzia z kitu web apps (Gmail, Slack, Arkusze, HubSpot)
const ikona = (k?: string, dom = 'appto') => { const n = k ?? dom; return FAV[n] ? `<img class="rw-fav rw-fav--${n}" src="${FAV[n]}" alt="" width="16" height="16" />` : `<span class="rw-fav rw-fav--n">${FAV_N[n] ?? ''}</span>`; };
---
<div class={`rw ${klasa}`}>
<div class="rw-tabs" role={klikalne ? 'tablist' : undefined} aria-label={klikalne ? 'Przykłady' : undefined}>
<span class="rw-dots" aria-hidden="true"><i></i><i></i><i></i></span>
{karty.map((k, i) => klikalne ? (
  <button type="button" role="tab" class={`rw-tab rw-tab--b${i === 0 ? ' is-on' : ''}`} data-karta={i} data-adres={k.adres} aria-selected={i === 0 ? 'true' : 'false'}>
    <Fragment set:html={ikona(k.ikona, 'wise')} /><span>{k.t}</span><i aria-hidden="true">×</i><b class="rw-pr" aria-hidden="true"><i></i></b>
  </button>
) : (
  <span class={`rw-tab${i === 0 ? ' is-on' : ''}`} aria-hidden="true"><Fragment set:html={ikona(k.ikona)} /><span>{k.t}</span><i>×</i></span>
))}
<span class="rw-plus" aria-hidden="true">+</span>
</div>
<div class="rw-bar" aria-hidden="true"><span><svg viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg></span><span><svg viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg></span><span><svg viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg></span><span class="rw-url"><svg viewBox="0 0 24 24"><rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg><span data-rw-adres>{karty[0]?.adres ?? adres}</span></span></div>
<div class="rw-vp"><slot /></div>
</div>

<style is:global>
  /* z appto.ai (.rw, .rw-tabs, .rw-tab, .rw-bar, .kp4-tab), bez zmian w wymiarach */
  .rw{position:relative;display:flex;flex-direction:column;overflow:hidden;border-radius:14px;background:#F7F7F3;box-shadow:0 0 0 .5px rgba(0,0,0,.3),0 50px 100px -40px rgba(10,10,20,.55),0 14px 30px -14px rgba(10,10,20,.3);font-family:"GeistApp",system-ui,sans-serif;color:#1F1F1F;text-align:left}
  .rw-tabs{position:relative;display:flex;align-items:flex-end;flex:none;height:46px;padding:0 12px 0 14px;background:#E3E2DD}
  .rw-dots{display:flex;gap:7px;align-self:center;margin-right:14px}
  .rw-dots i{width:11px;height:11px;border-radius:50%;box-shadow:inset 0 0 0 .5px rgba(0,0,0,.14)}
  .rw-dots i:nth-child(1){background:#FF5F57}.rw-dots i:nth-child(2){background:#FEBC2E}.rw-dots i:nth-child(3){background:#28C840}
  .rw-tab{position:relative;display:flex;align-items:center;gap:8px;flex:0 1 240px;min-width:0;height:38px;margin-top:8px;padding:0 10px 0 12px;border:0;border-radius:11px 11px 0 0;background:transparent;font:500 12.5px/1 "GeistApp",system-ui,sans-serif;color:#55534E;white-space:nowrap;text-align:left}
  .rw-tab--b{cursor:pointer}
  .rw-tab--b:hover{background:rgba(255,255,255,.45)}
  .rw-tab.is-on{background:#F7F7F3;color:#141414}
  .rw-tab:not(.is-on) + .rw-tab:not(.is-on)::before{content:'';position:absolute;left:0;top:11px;bottom:11px;width:1px;background:rgba(0,0,0,.14)}
  .rw-tab.is-on::before,.rw-tab.is-on::after{content:'';position:absolute;bottom:0;width:9px;height:9px}
  .rw-tab.is-on::before{left:-9px;background:radial-gradient(circle at 0 0,transparent 8.5px,#F7F7F3 9px)}
  .rw-tab.is-on::after{right:-9px;background:radial-gradient(circle at 100% 0,transparent 8.5px,#F7F7F3 9px)}
  .rw-fav{flex:none;width:16px;height:16px;border-radius:4px;object-fit:contain}
  .rw-fav--appto{padding:1px}
  .rw-fav--n{display:grid;place-items:center}
  .rw-fav--n svg,.rw-fav--n img{display:block;width:16px;height:16px}
  .rw-fav--n img.gm{height:12px;width:auto}
  .rw-tab > span{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis}
  .rw-tab > i{flex:none;font-style:normal;font-size:14px;color:#8A8984}
  /* postęp aktywnej karty: gruby zielony pasek na dole karty, z widocznym torem */
  .rw-pr{position:absolute;bottom:3px;left:10px;right:10px;height:4px;border-radius:2px;overflow:hidden;opacity:0;background:rgba(0,205,119,.18)}
  .rw-pr i{display:block;height:100%;background:#00CD77;transform-origin:0 50%;transform:scaleX(0)}
  .rw-tab.is-on .rw-pr{opacity:1}
  .rw-tab.is-on.gra .rw-pr i{transform:scaleX(1);transition:transform var(--czas,10s) linear}
  .rw-tab--b:focus-visible{outline:2px solid #0a7a52;outline-offset:-2px}
  .rw-plus{align-self:center;margin-left:12px;font-size:16px;color:#6B6A66}
  .rw-bar{display:flex;align-items:center;gap:2px;flex:none;height:34px;padding:0 8px;background:#F7F7F3;border-bottom:1px solid rgba(20,20,20,.08)}
  .rw-bar > span:not(.rw-url){display:grid;place-items:center;width:24px;height:24px;color:#5D5C58}
  .rw-bar > span:nth-child(2){color:#B5B3AE}
  .rw-bar svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  .rw-url{display:flex;align-items:center;gap:7px;flex:1;min-width:0;height:24px;margin:0 8px 0 6px;padding:0 10px;border-radius:12px;background:#EAE9E4;font-size:12px;color:#2E2E2E;white-space:nowrap;overflow:hidden}
  .rw-url svg{width:12px;height:12px;color:#6B6A66}
  .rw-vp{position:relative;flex:1;min-height:0;overflow:hidden;background:#FAF9F7}
  @media (max-width:760px){
    .rw-tabs{overflow-x:auto;scrollbar-width:none}
    .rw-tabs::-webkit-scrollbar{display:none}
    .rw-tab{flex:0 0 auto;max-width:200px}
  }
</style>
