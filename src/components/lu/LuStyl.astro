---
// WYGLĄD „JAK LET’S UP” (25.10.2026): wspólne style stron w języku
// wizualnym /lets-up-v6, przeniesione 1:1 z tamtego pliku, żeby wersje
// podstron usługowych w src/robocze/ miały jeden wygląd. Klasy i ich
// przeznaczenie: docs/podstrony-w-stylu-lets-up.md. Strona dokłada pod
// spodem tylko własne rysunki (osobny <style> z własnym przedrostkiem).
// Uwaga: lets-up-v6 nadal ma własną kopię; przy publikacji programu można
// go przepiąć na ten komponent.
---
<style is:global>
  /* =====================================================================
     WSPÓLNE TEJ STRONY · duży stopień nagłówków i plansze
     ===================================================================== */
  .u2-h2{margin:0;font-size:clamp(40px,6.2vw,100px);line-height:0.94;letter-spacing:-0.055em;font-weight:700;color:var(--t1);text-wrap:balance}
  .u2-h2 span{color:var(--ziel-c)}
  .u2-h2.jasny{color:#ffffff}
  .u2-h2.jasny span{color:var(--ziel)}
  .u2-pl{padding:0 var(--ram)}
  .u2-pl-in{position:relative;border-radius:clamp(20px,2.2vw,32px);color:#ffffff;
    background:radial-gradient(900px 600px at 85% 110%,rgba(0,205,119,0.2),rgba(0,205,119,0) 70%),radial-gradient(700px 420px at 6% -10%,rgba(0,205,119,0.08),rgba(0,205,119,0) 70%),var(--ink)}
  .u2-pl-in.v3-ziarno::after{border-radius:inherit}
  .u2-pl-in > *{position:relative;z-index:1}

  /* =====================================================================
     2 · TELEFON WŁAŚCICIELA (.u2t-)
     ===================================================================== */
  #sytuacje{overflow-x:clip}
  .u2t-g{display:grid;grid-template-columns:minmax(0,6.6fr) minmax(0,5.4fr);gap:clamp(40px,6vw,110px);align-items:center}
  .u2t-sub{margin:22px 0 0;max-width:520px;font-size:clamp(16px,1.3vw,18px);line-height:1.6;color:var(--t2)}
  .u2t-lista{margin:clamp(36px,4vw,56px) 0 0;padding:0;list-style:none}
  .u2t-lista li{position:relative;padding:clamp(18px,2vw,26px) 0 clamp(18px,2vw,26px) 34px;border-top:1px solid var(--linia)}
  .u2t-lista li:last-child{border-bottom:1px solid var(--linia)}
  .u2t-lista li::before{content:"";position:absolute;left:0;top:calc(clamp(18px,2vw,26px) + 0.55em);width:12px;height:12px;border-radius:50%;background:#ffffff;box-shadow:inset 0 0 0 2px rgba(15,26,20,0.2);transition:background .3s,box-shadow .3s}
  .u2t-lista li.on::before{background:var(--burs);box-shadow:0 0 0 5px rgba(240,163,58,0.2)}
  .u2t-lista b{display:block;font-size:clamp(21px,2.1vw,32px);font-weight:700;letter-spacing:-0.035em;line-height:1.1;text-wrap:balance}
  .u2t-lista span{display:block;margin-top:8px;max-width:560px;font-size:15px;line-height:1.55;color:var(--t2)}
  .u2t-tel{position:relative;justify-self:center;width:clamp(290px,25vw,370px);aspect-ratio:9 / 19;padding:12px;border-radius:54px;background:#0c100e;
    box-shadow:inset 0 0 0 2px #2a312d,0 0 0 1px rgba(15,26,20,0.1),0 80px 120px -60px rgba(7,20,13,0.7),0 30px 60px -30px rgba(7,20,13,0.4)}
  .u2t-tel::before{content:"";position:absolute;inset:-60px -80px;z-index:-1;border-radius:50%;background:radial-gradient(closest-side,rgba(0,205,119,0.22),rgba(0,205,119,0))}
  .u2t-ekr{position:relative;height:100%;overflow:hidden;border-radius:43px;color:#ffffff;font-family:ui-sans-serif,-apple-system,system-ui,'Segoe UI',Roboto,sans-serif;
    background:radial-gradient(120% 60% at 20% 0%,#1d5a3f 0%,rgba(29,90,63,0) 60%),radial-gradient(90% 70% at 100% 100%,#0a7a52 0%,rgba(10,122,82,0) 60%),linear-gradient(180deg,#0d2118,#07140d)}
  .u2t-wysp{position:absolute;left:50%;top:11px;width:34%;height:30px;margin-left:-17%;border-radius:20px;background:#000000}
  .u2t-pas{display:flex;justify-content:space-between;padding:17px 28px 0;font-size:14px;font-weight:600}
  .u2t-pas span:last-child{letter-spacing:0.08em;font-size:11px;padding-top:2px}
  .u2t-zeg{margin-top:28px;text-align:center}
  .u2t-zeg small{display:block;font-size:15px;font-weight:500;color:rgba(255,255,255,0.8)}
  .u2t-zeg b{display:block;margin-top:2px;font-size:72px;font-weight:600;letter-spacing:-0.03em;line-height:1}
  .u2t-pw{position:absolute;left:10px;right:10px;top:178px;bottom:0;display:flex;flex-direction:column;gap:8px;
    -webkit-mask-image:linear-gradient(to bottom,#000 72%,transparent 98%);mask-image:linear-gradient(to bottom,#000 72%,transparent 98%)}
  .u2t-n{display:grid;grid-template-columns:36px minmax(0,1fr);gap:10px;align-items:start;padding:11px 12px;border-radius:20px;background:rgba(245,246,245,0.82);color:#0a0a0b;
    -webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px)}
  .u2t-ik{position:relative;width:36px;height:36px}
  .u2t-ik img{width:36px;height:36px;border-radius:50%;object-fit:cover}
  .u2t-ik .app{position:absolute;right:-3px;bottom:-3px;display:grid;place-items:center;width:17px;height:17px;border-radius:5px;background:#34c759;box-shadow:0 0 0 2px rgba(245,246,245,0.95)}
  .u2t-ik .app svg{width:10px;height:10px;fill:#ffffff}
  .u2t-ik.poczta{display:grid;place-items:center;border-radius:9px;background:#ffffff}
  .u2t-ik.poczta img{width:22px;height:22px;border-radius:0}
  .u2t-n p{margin:0;font-size:13px;line-height:1.32}
  .u2t-n .g{display:flex;justify-content:space-between;gap:8px}
  .u2t-n .g b{font-weight:650}
  .u2t-n .g small{flex-shrink:0;font-size:12px;color:#6b6f6c}
  .u2t-n .tr{margin-top:1px;color:#1f2321}
  .u2t-pw.gra .u2t-n{display:none}
  .u2t-pw.gra .u2t-n.on{display:grid;animation:u2t-wej .5s cubic-bezier(.2,.9,.3,1.2) both}
  @keyframes u2t-wej{from{opacity:0;transform:translateY(-14px) scale(.96)}}
  @media (max-width:900px){
    .u2t-g{grid-template-columns:1fr}
    .u2t-tel{width:min(320px,86vw)}
  }

  /* =====================================================================
     3 · DEFINICJA, słowa zapalane przy przewijaniu (.u2d-)
     ===================================================================== */
  .u2d{background:var(--papier)}
  .u2d .v3-h2m{margin-bottom:clamp(28px,3vw,44px)}
  .u2d-p{margin:0;max-width:1300px;font-size:clamp(28px,3.9vw,62px);line-height:1.08;letter-spacing:-0.04em;font-weight:650;color:var(--t1);text-wrap:pretty}
  .u2d-p .ak{color:var(--ziel-c)}
  .u2d-p.gra .w{color:rgba(15,26,20,0.14);transition:color .35s ease}
  .u2d-p.gra .w.on{color:var(--t1)}
  .u2d-p.gra .w.ak.on{color:var(--ziel-c)}

  /* =====================================================================
     7 · APPTO na ciemnej scenie (.u2a-)
     ===================================================================== */
  .u2a{padding-top:clamp(56px,7vw,96px)}
  .u2a-in{padding:clamp(64px,8vw,130px) var(--pin) clamp(48px,6vw,96px);text-align:center}
  .u2a-in .u2-h2{max-width:1100px;margin:0 auto}
  .u2a-sub{max-width:720px;margin:24px auto 0;font-size:clamp(16px,1.3vw,19px);line-height:1.62;color:rgba(255,255,255,0.7)}
  .u2a-sc{position:relative;margin-top:clamp(48px,6vw,88px);perspective:1800px;text-align:left}
  .u2a-sc::before{content:"";position:absolute;left:8%;right:8%;bottom:-6%;height:60%;border-radius:50%;background:radial-gradient(closest-side,rgba(0,205,119,0.4),rgba(0,205,119,0));filter:blur(30px)}
  .u2a-sc .lp-okno{box-shadow:0 0 0 1px rgba(255,255,255,0.12),0 80px 140px -50px rgba(0,0,0,0.9)}
  .u2a-cap{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(20px,3vw,48px);margin-top:clamp(40px,4.4vw,64px);text-align:left}
  .u2a-cap div{padding-top:18px;border-top:1px solid rgba(255,255,255,0.14)}
  .u2a-cap em{font-style:normal;font-size:13px;font-weight:700;color:var(--ziel)}
  .u2a-cap b{display:block;margin-top:8px;font-size:19px;font-weight:700;letter-spacing:-0.02em}
  .u2a-cap p{margin:8px 0 0;font-size:15px;line-height:1.55;color:rgba(255,255,255,0.65)}
  .u2a-pod{display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px 32px;margin-top:36px;padding-top:18px;border-top:1px solid rgba(255,255,255,0.1);font-size:14px;color:rgba(255,255,255,0.55);text-align:left}
  .u2a-pod b{color:#ffffff}
  .u2a-pod a{font-weight:650;color:var(--ziel);border-bottom:1px solid rgba(0,205,119,0.4)}
  @media (max-width:900px){
    .u2a-cap{grid-template-columns:1fr}
  }

  /* =====================================================================
     10 · DLA KOGO (.u2dk-)
     ===================================================================== */
  .u2dk-gl{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:24px clamp(32px,5vw,96px);align-items:end}
  .u2dk-g{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:16px;margin-top:clamp(40px,4.4vw,64px)}
  .u2dk-t{padding:clamp(24px,3vw,44px);border-radius:26px;background:var(--papier)}
  .u2dk-t.nie{background:#ffffff;box-shadow:inset 0 0 0 1px var(--linia)}
  .u2dk-t h3{margin:0;font-size:clamp(20px,1.8vw,26px);font-weight:700;letter-spacing:-0.03em}
  .u2dk-t ul{margin:20px 0 0;padding:0;list-style:none}
  .u2dk-t li{display:grid;grid-template-columns:28px minmax(0,1fr);gap:14px;padding:16px 0;border-top:1px solid var(--linia)}
  .u2dk-t li i{display:grid;place-items:center;width:28px;height:28px;border-radius:50%;background:var(--ziel)}
  .u2dk-t li i svg{width:14px;height:14px;fill:var(--ink)}
  .u2dk-t.nie li i{background:transparent;box-shadow:inset 0 0 0 1.5px rgba(15,26,20,0.25)}
  .u2dk-t.nie li i svg{fill:var(--t3)}
  .u2dk-t li b{display:block;font-size:17px;font-weight:700;letter-spacing:-0.02em;line-height:1.25}
  .u2dk-t li span{display:block;margin-top:4px;font-size:14.5px;line-height:1.55;color:var(--t2)}
  .u2dk-t li span a{font-weight:650;color:var(--ziel-c);text-decoration:underline;text-underline-offset:2px}
  @media (max-width:900px){ .u2dk-gl,.u2dk-g{grid-template-columns:1fr} }

  /* =====================================================================
     v3 · 1 · HERO: jasna plansza, telefon właściciela (.u3h-)
     ===================================================================== */
  .u3h{padding:0 var(--ram)}
  .u3h-in{position:relative;overflow:hidden;display:grid;grid-template-columns:minmax(0,6.6fr) minmax(0,5.4fr);gap:clamp(24px,4vw,72px);
    padding:clamp(44px,5.4vw,88px) var(--pin) 0;border-radius:clamp(20px,2.2vw,32px);
    background:radial-gradient(760px 640px at 84% 42%,rgba(0,205,119,0.17),rgba(0,205,119,0) 66%),var(--papier)}
  .u3h-tekst{align-self:center;padding-bottom:clamp(44px,5.4vw,88px)}
  .u3h-marka{display:flex;align-items:center;flex-wrap:wrap;gap:6px 14px;margin:0 0 clamp(26px,3vw,40px);font-size:15px;line-height:1.3;color:var(--t2)}
  .u3h-marka b{font-size:18px;font-weight:800;letter-spacing:-0.025em;color:var(--t1)}
  .u3h-marka span{padding-left:14px;border-left:1.5px solid rgba(15,26,20,0.2)}
  .u3h-h1{margin:0;font-size:clamp(46px,6.3vw,104px);line-height:0.92;letter-spacing:-0.055em;font-weight:700;color:var(--t1);text-wrap:balance}
  .u3h-h1 span{color:var(--ziel-c)}
  .u3h-lead{margin:clamp(22px,2.6vw,32px) 0 0;max-width:560px;font-size:clamp(16px,1.25vw,19px);line-height:1.6;color:var(--t2);text-wrap:pretty}
  .u3h-akcje{margin-top:clamp(26px,3vw,36px)}
  .u3h-lnk{display:inline-flex;align-items:center;gap:8px;padding:8px 2px;font-size:16px;font-weight:650;color:var(--t1);border-bottom:1px solid rgba(15,26,20,0.25);transition:border-color .2s}
  .u3h-lnk:hover{border-color:var(--ziel-c)}
  .u3h-fakty{display:flex;flex-wrap:wrap;align-items:flex-end;gap:14px 40px;margin:clamp(36px,4vw,56px) 0 0;padding-top:20px;border-top:1px solid var(--linia)}
  .u3h-fakty dt{font-size:clamp(34px,3.1vw,48px);font-weight:750;letter-spacing:-0.05em;line-height:1;color:var(--ziel-c)}
  .u3h-fakty dd{margin:6px 0 0;font-size:13.5px;line-height:1.35;color:var(--t2)}
  .u3h-fakty p{margin:0 0 2px;font-size:12.5px;color:var(--t3)}
  .u3h-scena{position:relative;display:flex;flex-direction:column;align-items:center}
  .u3h-prz{position:relative;z-index:2;display:inline-flex;gap:4px;margin-bottom:22px;padding:5px;border-radius:999px;background:#ffffff;box-shadow:0 0 0 1px rgba(15,26,20,0.06),0 14px 30px -18px rgba(15,26,20,0.45)}
  .u3h-prz button{appearance:none;border:0;background:none;padding:9px 18px;border-radius:999px;font:inherit;font-size:14px;font-weight:650;color:var(--t2);cursor:pointer;transition:background .25s,color .25s}
  .u3h-prz button[aria-pressed="true"]{background:var(--ink);color:#ffffff}
  .u3h-prz button:focus-visible{outline:2px solid var(--ziel-c);outline-offset:2px}
  .u3h-tel{position:relative;margin:0 0 -170px;width:clamp(310px,28vw,420px);aspect-ratio:9 / 19;padding:12px;border-radius:56px;background:#0c100e;
    box-shadow:inset 0 0 0 2px #2a312d,0 90px 120px -60px rgba(7,20,13,0.55),0 30px 60px -34px rgba(7,20,13,0.4)}
  .u3h-tel .u2t-ekr{border-radius:45px}
  .u3h-chaos,.u3h-spokoj{position:absolute;left:10px;right:10px;top:178px;bottom:0;display:flex;flex-direction:column;gap:8px;transition:opacity .5s ease,transform .6s cubic-bezier(.3,.7,.2,1)}
  .u3h-chaos{-webkit-mask-image:linear-gradient(to bottom,#000 70%,transparent 96%);mask-image:linear-gradient(to bottom,#000 70%,transparent 96%)}
  .u3h-tel[data-tryb="po"] .u3h-chaos{opacity:0;transform:translateY(-30px) scale(.94);pointer-events:none}
  .u3h-tel[data-tryb="dzis"] .u3h-spokoj{opacity:0;transform:translateY(30px);pointer-events:none}
  .u3h-chaos.gra .u2t-n{display:none}
  .u3h-chaos.gra .u2t-n.on{display:grid;animation:u2t-wej .45s cubic-bezier(.2,.9,.3,1.2) both}
  .u3h-tel[data-tryb="po"] .u3h-spokoj > *{animation:u2t-wej .5s cubic-bezier(.2,.9,.3,1.2) both}
  .u3h-tel[data-tryb="po"] .u3h-spokoj > :nth-child(2){animation-delay:.35s}
  .u3h-tel[data-tryb="po"] .u3h-spokoj > :nth-child(3){animation-delay:.6s}
  .u2t-ik.ai{display:grid;place-items:center;border-radius:9px;background:var(--ziel-c)}
  .u2t-ik.ai svg{width:18px;height:18px;fill:#ffffff}
  .u3h-gr{position:relative;z-index:0;margin-bottom:12px}
  .u3h-gr .u2t-n{position:relative;z-index:1}
  .u3h-gr::before,.u3h-gr::after{content:"";position:absolute;left:9px;right:9px;bottom:-7px;height:7px;border-radius:0 0 14px 14px;background:rgba(245,246,245,0.55);z-index:0}
  .u3h-gr::after{left:18px;right:18px;bottom:-13px;height:6px;background:rgba(245,246,245,0.3)}
  .u3h-gr .u2t-n{background:rgba(245,246,245,0.94)}
  .u3h-gr ul{margin:6px 0 0;padding:0;list-style:none}
  .u3h-gr li{position:relative;padding:2px 0 2px 15px;font-size:12px;line-height:1.35;color:#3a3f3c}
  .u3h-gr li::before{content:"";position:absolute;left:2px;top:0.62em;width:6px;height:6px;border-radius:50%;background:#1e8e3e}
  .u3h-gr .tr b{font-weight:650}
  .u3h-dec .g b{color:#9c5f14}
  .u3h-btn{display:flex;gap:6px;margin-top:8px}
  .u3h-btn span{flex:1;padding:6px 8px;border-radius:10px;background:rgba(0,0,0,0.07);font-size:12.5px;font-weight:650;text-align:center;transition:transform .15s,background .2s}
  .u3h-btn .tak{background:#0a0a0b;color:#ffffff}
  .u3h-btn .tak.kl{transform:scale(.94);background:#1e8e3e}
  .u3h-ok{display:none;margin:6px 0 0 !important;font-size:12.5px;font-weight:650;color:#1e7a3a !important}
  .u3h-dec.zrob .u3h-btn{display:none}
  .u3h-dec.zrob .u3h-ok{display:block;animation:u2t-wej .4s ease both}
  @media (max-width:1000px){
    .u3h-in{grid-template-columns:1fr}
    .u3h-tekst{padding-bottom:0}
    .u3h-scena{margin-top:12px}
    .u3h-tel{width:min(320px,82vw);margin-bottom:-260px}
  }

  /* =====================================================================
     v3 · 2 · BRZMI ZNAJOMO? cztery sytuacje z wiadomością (.u3s-)
     ===================================================================== */
  .u3s-g{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:48px clamp(20px,2.4vw,40px);margin-top:clamp(48px,5vw,72px)}
  .u3s-k{display:flex;flex-direction:column}
  .u3s-dym{display:grid;grid-template-columns:34px minmax(0,1fr);gap:10px;align-items:end;min-height:96px}
  .u3s-dym img{width:34px;height:34px;border-radius:50%;object-fit:cover}
  .u3s-dym p{margin:0;padding:11px 14px 12px;border-radius:18px 18px 18px 6px;background:#eef1ec;font-size:14.5px;line-height:1.4;color:var(--t1)}
  .u3s-dym p b{display:block;margin-bottom:2px;font-size:12px;font-weight:650;color:var(--t3)}
  .u3s-k h3{margin:24px 0 0;padding-top:20px;border-top:1.5px solid var(--t1);font-size:clamp(20px,1.7vw,26px);font-weight:700;letter-spacing:-0.03em;line-height:1.12;text-wrap:balance}
  .u3s-k > p{margin:10px 0 0;font-size:15px;line-height:1.55;color:var(--t2);text-wrap:pretty}
  .u3s-g.gra .u3s-dym{opacity:0;transform:translateY(12px) scale(.97);transform-origin:0 100%}
  .u3s-g.gra.on .u3s-dym{opacity:1;transform:none;transition:opacity .45s ease,transform .5s cubic-bezier(.2,.9,.3,1.2)}
  .u3s-g.gra.on .u3s-k:nth-child(2) .u3s-dym{transition-delay:.25s}
  .u3s-g.gra.on .u3s-k:nth-child(3) .u3s-dym{transition-delay:.5s}
  .u3s-g.gra.on .u3s-k:nth-child(4) .u3s-dym{transition-delay:.75s}
  @media (max-width:1100px){ .u3s-g{grid-template-columns:repeat(2,minmax(0,1fr))} }
  @media (max-width:600px){ .u3s-g{grid-template-columns:1fr;gap:36px} .u3s-dym{min-height:0} }

  /* =====================================================================
     v3 · 11 · ILE TO KOSZTUJE? (.u3k-), wykres „nożyce” na jasnym tle
     ===================================================================== */
  .u3k-g{display:grid;grid-template-columns:minmax(0,4.6fr) minmax(0,7.4fr);gap:clamp(36px,5vw,96px);align-items:start}
  .u3k-txt > p{margin:24px 0 0;max-width:520px;font-size:clamp(16px,1.3vw,18px);line-height:1.62;color:var(--t2);text-wrap:pretty}
  .u3k-cen{margin:28px 0 0}
  .u3k-cen div{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:4px 20px;align-items:baseline;padding:14px 0;border-top:1px solid var(--linia)}
  .u3k-cen div:last-child{border-bottom:1px solid var(--linia)}
  .u3k-cen dt{font-size:16px;font-weight:700;letter-spacing:-0.015em}
  .u3k-cen dd{margin:0;font-size:14.5px;font-weight:650;color:var(--ziel-c);text-align:right}
  .u3k-wyk{display:grid;grid-template-columns:minmax(0,1fr) clamp(140px,13vw,200px);gap:0 clamp(16px,2vw,28px);margin:0}
