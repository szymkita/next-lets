  .u3a-dol p b{display:block;margin-bottom:4px;font-size:20px;font-weight:700;letter-spacing:-0.02em;color:#ffffff}
  .u3a-dol p[hidden]{display:none}
  .u3a-str{display:flex;flex-shrink:0;gap:8px}
  .u3a-str button{display:grid;place-items:center;width:46px;height:46px;border:0;border-radius:50%;background:rgba(255,255,255,0.1);color:#ffffff;cursor:pointer;transition:background .15s,opacity .15s}
  .u3a-str button:hover:not(:disabled){background:var(--ziel);color:var(--ink)}
  .u3a-str button:disabled{opacity:0.3;cursor:default}
  .u3a-str svg{width:16px;height:16px;fill:currentColor}
  .u3a-str button:focus-visible{outline:2px solid var(--ziel);outline-offset:2px}
  /* =====================================================================
     v4 · 8 · WYNIKI: cztery równe karty, wiersze wyrównane (.u4w-)
     ===================================================================== */
  .u4w-g{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));grid-auto-rows:auto;gap:16px;margin-top:clamp(48px,5vw,80px)}
  .u4w-k{display:grid;grid-row:span 6;grid-template-rows:subgrid;row-gap:0;padding:clamp(20px,2vw,28px);border-radius:24px;background:var(--papier)}
  .u4w-k .dz{font-size:13px;font-weight:700;color:var(--ziel-c)}
  .u4w-k h3{margin:6px 0 0;font-size:18px;font-weight:700;letter-spacing:-0.02em;line-height:1.25}
  .u4w-k .l{margin:clamp(22px,2.4vw,34px) 0 0;font-size:clamp(56px,5.6vw,92px);font-weight:750;letter-spacing:-0.065em;line-height:0.85;color:var(--t1);white-space:nowrap}
  .u4w-k .l small{font-size:0.48em;letter-spacing:-0.03em;color:var(--ziel-c)}
  .u4w-k .ld{margin:10px 0 0;font-size:14px;line-height:1.4;color:var(--t2)}
  .u4w-k dl{margin:20px 0 0;padding-top:16px;border-top:1px solid var(--linia)}
  .u4w-k dl div{display:grid;grid-template-columns:2.8em minmax(0,1fr);gap:10px;font-size:14px;line-height:1.5}
  .u4w-k dl div + div{margin-top:8px}
  .u4w-k dt{font-size:12.5px;font-weight:700;color:var(--t3);padding-top:1px}
  .u4w-k dd{margin:0;color:var(--t2)}
  .u4w-k dl div.po dt{color:var(--ziel-c)}
  .u4w-k dl div.po dd{color:var(--t1)}
  .u4w-k a{display:inline-flex;align-items:center;gap:8px;align-self:end;margin-top:20px;font-size:13.5px;font-weight:650;color:var(--ziel-c)}
  .u4w-k a span{transition:transform .18s}
  .u4w-k a:hover span{transform:translateX(4px)}
  .u4w-g.gra .l{opacity:0;transform:translateY(20px)}
  .u4w-g.gra.on .l{opacity:1;transform:none;transition:opacity .6s ease,transform .8s cubic-bezier(.2,.8,.2,1)}
  .u4w-g.gra.on .u4w-k:nth-child(2) .l{transition-delay:.12s}
  .u4w-g.gra.on .u4w-k:nth-child(3) .l{transition-delay:.24s}
  .u4w-g.gra.on .u4w-k:nth-child(4) .l{transition-delay:.36s}
  @media (max-width:1100px){ .u4w-g{grid-template-columns:repeat(2,minmax(0,1fr))} }
  @media (max-width:560px){ .u4w-g{grid-template-columns:1fr} }

  /* =====================================================================
     v4 · 9 · SCHODY: stopnie stykają się w jedną bryłę, każdy ma zielony
     wierzch i ciemny bok, opisy w jednym wierszu pod spodem (.u4s-)
     ===================================================================== */
  .u4s{margin:clamp(56px,6vw,96px) 0 0}
  .u4s-g{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));grid-template-rows:clamp(260px,26vw,400px) auto auto auto;column-gap:0}
  .u4s-e{display:contents}
  .u4s-st{position:relative;grid-row:1;align-self:end;height:calc(var(--h) * 1%);margin-right:-1px;padding:clamp(18px,1.8vw,26px) clamp(14px,1.6vw,22px) clamp(14px,1.6vw,20px);color:#ffffff;
    display:flex;flex-direction:column;justify-content:space-between;
    background:linear-gradient(180deg,color-mix(in srgb,#0f3324 calc(var(--i) * 18%),#0b1f16),#07140d);box-shadow:inset 1px 0 0 rgba(255,255,255,0.05)}
  .u4s-st::before{content:"";position:absolute;left:0;right:0;top:-14px;height:14px;background:linear-gradient(180deg,#6af5b6,#00CD77);clip-path:polygon(14px 0,100% 0,100% 100%,0 100%)}
  .u4s-e:first-child .u4s-st{border-radius:0 0 0 14px}
  .u4s-e:nth-child(5) .u4s-st{border-radius:0 0 14px 0}
  .u4s-st em{font-style:normal;font-size:clamp(34px,3.4vw,56px);font-weight:750;letter-spacing:-0.065em;line-height:0.85;color:var(--ziel)}
  .u4s-st b{font-size:clamp(15px,1.3vw,19px);font-weight:700;letter-spacing:-0.02em;line-height:1.15;text-wrap:balance}
  .u4s-op{grid-row:2;padding:20px clamp(14px,1.6vw,24px) 0 0}
  .u4s-op p{margin:0;font-size:14.5px;line-height:1.55;color:var(--t2);text-wrap:pretty}
  .u4s-op span{display:flex;align-items:flex-start;gap:8px;margin-top:14px;padding-top:12px;border-top:1px solid var(--linia);font-size:13.5px;font-weight:650;line-height:1.35;color:var(--t1)}
  .u4s-op span svg{flex-shrink:0;width:15px;height:15px;margin-top:1px;fill:var(--ziel-c)}
  .u4s-wyj{grid-column:2;grid-row:3;position:relative;margin:22px clamp(14px,1.6vw,24px) 0 0;padding:14px 16px 14px 44px;border-radius:14px;background:#ffffff;box-shadow:0 0 0 1px rgba(15,26,20,0.06);font-size:13.5px;line-height:1.5;color:var(--t2)}
  .u4s-wyj b{display:block;color:var(--t1)}
  .u4s-wyj::before{content:"";position:absolute;left:16px;top:16px;width:16px;height:16px;border-radius:50%;background:var(--papier);box-shadow:inset 0 0 0 1.5px var(--t3)}
  .u4s-wyj::after{content:"";position:absolute;left:21px;top:20px;width:6px;height:6px;border-right:1.5px solid var(--t3);border-bottom:1.5px solid var(--t3);transform:rotate(-45deg)}
  .u4s-pt{grid-column:4 / 6;grid-row:3;margin-top:22px}
  .u4s-luk{position:relative;display:block;height:30px;margin:0 25%;border:1.5px solid var(--ziel-c);border-top:0;border-radius:0 0 18px 18px}
  .u4s-luk::before{content:"";position:absolute;left:-6.5px;top:-3px;border-left:5.5px solid transparent;border-right:5.5px solid transparent;border-bottom:9px solid var(--ziel-c)}
  .u4s-pt span{display:block;margin-top:8px;text-align:center;font-size:13.5px;line-height:1.45;color:var(--t2)}
  .u4s-pt span b{color:var(--t1)}
  .u4s-pr{grid-column:2 / 6;grid-row:4;display:flex;align-items:center;gap:14px;margin-top:22px;padding:14px 18px;border-radius:999px;background:var(--ink);color:#ffffff}
  .u4s-pr img{flex-shrink:0;width:36px;height:36px;border-radius:50%;object-fit:cover;box-shadow:0 0 0 2px rgba(0,205,119,0.5)}
  .u4s-pr span{font-size:14.5px;line-height:1.4;color:rgba(255,255,255,0.78)}
  .u4s-pr span b{color:#ffffff}
  .u4s.gra .u4s-st{clip-path:inset(100% 0 0 0)}
  .u4s.gra .u4s-st::before{opacity:0}
  .u4s.gra.on .u4s-st{clip-path:inset(-20px 0 0 0);transition:clip-path .7s cubic-bezier(.5,0,.2,1) calc(var(--i) * 0.15s)}
  .u4s.gra.on .u4s-st::before{opacity:1;transition:opacity .3s ease calc(var(--i) * 0.15s + .5s)}
  @media (max-width:1000px){
    .u4s-g{display:flex;flex-direction:column}
    .u4s-e{display:block;margin-bottom:24px}
    .u4s-e:nth-of-type(-n+2){order:1}
    .u4s-wyj{order:2;margin:0 0 24px}
    .u4s-e:nth-of-type(n+3){order:3}
    .u4s-pt{order:4;margin:0 0 24px}
    .u4s-pr{order:5;border-radius:18px;align-items:flex-start}
    .u4s-st{height:auto;width:calc(46% + var(--h) * 0.54%);flex-direction:row;align-items:center;justify-content:flex-start;gap:14px;margin:14px 0 0;border-radius:0 12px 12px 0 !important}
    .u4s-st em{font-size:30px}
    .u4s-op{padding:14px 0 0}
    .u4s-luk{display:none}
    .u4s-pt span{text-align:left;margin:0}
    .u4s.gra .u4s-st{clip-path:inset(-20px 100% 0 0)}
    .u4s.gra.on .u4s-st{clip-path:inset(-20px 0 0 0)}
  }

  /* =====================================================================
     v4 · 11 · ILE TO KOSZTUJE: jasnozielony panel, rachunek wystający
     ponad krawędź, wykres na panelu (.u4k-; wykres: klasy .u3k- z v3)
     ===================================================================== */
  .u4k-pan{position:relative;display:grid;grid-template-columns:minmax(0,4.4fr) minmax(0,7.6fr);gap:clamp(28px,4vw,72px);align-items:start;margin-top:clamp(96px,10vw,140px);padding:0 clamp(24px,3.6vw,56px) clamp(32px,4vw,56px);border-radius:32px;
    background:radial-gradient(700px 420px at 90% 0%,rgba(0,205,119,0.16),rgba(0,205,119,0) 70%),linear-gradient(180deg,#e7f2e9,#f1f7ef)}
  .u4k-par{position:relative;margin-top:calc(clamp(56px,6vw,80px) * -1);padding:26px 26px 30px;background:#ffffff;border-radius:16px 16px 0 0;box-shadow:0 40px 80px -40px rgba(15,26,20,0.45),0 0 0 1px rgba(15,26,20,0.05)}
  .u4k-par::after{content:"";position:absolute;left:0;right:0;bottom:-10px;height:10px;background:radial-gradient(circle at 8px 0,#ffffff 7.5px,transparent 8px) 0 0/16px 10px repeat-x;filter:drop-shadow(0 1px 0 rgba(15,26,20,0.05))}
  .u4k-par header{display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding-bottom:14px;border-bottom:1.5px dashed rgba(15,26,20,0.2)}
  .u4k-par header b{font-size:17px;font-weight:800;letter-spacing:-0.02em}
  .u4k-par header span{font-size:12.5px;color:var(--t3)}
  .u4k-par dl{margin:8px 0 0}
  .u4k-par dl div{display:flex;align-items:baseline;gap:10px;padding:11px 0}
  .u4k-par dt{font-size:15px;font-weight:650}
  .u4k-par dl div i{flex:1;min-width:16px;border-bottom:1.5px dotted rgba(15,26,20,0.25);transform:translateY(-4px)}
  .u4k-par dd{margin:0;font-size:14px;font-weight:650;color:var(--ziel-c);text-align:right}
  .u4k-par-k{margin-top:10px;padding-top:14px;border-top:1.5px dashed rgba(15,26,20,0.2)}
  .u4k-par-k b{display:block;font-size:13px;font-weight:700;color:var(--t3)}
  .u4k-par-k ul{margin:8px 0 0;padding:0;list-style:none}
  .u4k-par-k li{display:flex;align-items:center;gap:10px;padding:5px 0;font-size:14.5px}
  .u4k-par-k li::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--ziel)}
  .u4k-par footer{margin-top:16px;padding:12px 14px;border-radius:12px;background:var(--papier);font-size:13.5px;line-height:1.45;color:var(--t1)}
  .u4k-par footer b{color:var(--ziel-c)}
  .u4k-pan .u3k-wyk{margin-top:clamp(32px,4vw,56px)}
  .u4k-pan .u3k-pole{background:repeating-linear-gradient(to bottom,rgba(15,26,20,0.08) 0 1px,transparent 1px 25%)}
  .u4k-pan .u3k-kr{box-shadow:0 0 0 4px #eaf4ec}
  @media (max-width:1000px){
    .u4k-pan{grid-template-columns:1fr;padding-top:0}
  }

  /* kontakt na papierze sekcji „Dla kogo”, bez osobnego pasa tła */
  #dla-kogo{background:var(--papier)}
  #dla-kogo .u2dk-t{background:#ffffff}
  #dla-kogo .u2dk-t.nie{background:transparent;box-shadow:inset 0 0 0 1px var(--linia)}

  /* =====================================================================
     v5 · drobne wspólne
     ===================================================================== */
  .nw{white-space:nowrap;font-style:normal}
  .u4p-kartka li.wyb em.tx{font-size:14px;letter-spacing:-0.01em;white-space:nowrap}
  .u2d-p .w{white-space:nowrap}
  .u3h-pod{margin-top:2px !important;font-size:12px !important;color:#4b504d !important}

  /* =====================================================================
     v5 · tła: od „Czym jest” papier ciągnie się pod planszą opowieści
     i kartami programu, chowa się pod planszą „System…”, pod nią biel.
     ===================================================================== */
  #zlecenie{background:var(--papier)}
  #system{background:linear-gradient(to bottom,var(--papier) 0,var(--papier) 50%,#ffffff 50%,#ffffff 100%)}

  /* =====================================================================
     v5 · BRZMI ZNAJOMO? osiem sytuacji w przesuwanym rzędzie (.u5s-)
     ===================================================================== */
  #sytuacje{padding-left:0;padding-right:0}
  #sytuacje > :not(.u5s-tor){margin-left:var(--pad);margin-right:var(--pad)}
  .u5s-tor.u3s-g{display:flex;gap:clamp(24px,2.6vw,44px);margin-top:clamp(48px,5vw,72px);padding:4px var(--pad) 10px;overflow-x:auto;overscroll-behavior-x:contain;
    scroll-snap-type:x mandatory;scroll-padding-inline:var(--pad);scrollbar-width:none}
  .u5s-tor::-webkit-scrollbar{display:none}
  .u5s-tor:focus-visible{outline:2px solid var(--ziel);outline-offset:-2px}
  .u5s-tor .u3s-k{flex:0 0 clamp(270px,22.5vw,330px);scroll-snap-align:start}
  .u5s-lk{font-size:13.5px;font-weight:600;color:var(--t3);font-variant-numeric:tabular-nums}
  @media (max-width:600px){ .u5s-tor .u3s-k{flex-basis:82%} .u3s-dym{min-height:96px} }

  /* =====================================================================
     v5 · GDZIE ZNIKA CZAS: ta sama forma, spokojniej — bez karty wokół
     rysunku, płaskie paski, siatka godzin pod taśmą, legenda bez kolorów
     ===================================================================== */
  .u4z-kar{padding:0;border-radius:0;background:none;box-shadow:none}
  .u4z-tor::before{content:"";position:absolute;left:0;right:0;top:-10px;bottom:24px;pointer-events:none;
    background:repeating-linear-gradient(to right,rgba(255,255,255,0.09) 0 1px,transparent 1px 14.2857%)}
  .u4z-tas{position:relative}
  .u4z-gr .cz{background:#00CD77;box-shadow:none}
  .u4z-gr .ai{background:repeating-linear-gradient(135deg,#f0a33a 0 2px,rgba(240,163,58,0.25) 2px 6px);box-shadow:none}
  .u4z-gr > i:first-child{border-radius:4px 0 0 4px}
  .u4z-gr > i:last-child{border-radius:0 4px 4px 0}
  .u4z-gr > i:only-child{border-radius:4px}
  .u4z-wiz[data-krok="1"] .u4z-gr .ai{filter:none}
  .u4z-wiz[data-krok="1"] .u4z-gr .cz{opacity:0.22}
  .u4z-leg{grid-template-columns:repeat(2,minmax(0,1fr));gap:0 36px}
  .u4z-leg li,.u4z-leg li.am{color:rgba(255,255,255,0.78)}
  .u4z-leg li i,.u4z-leg li.am i{width:10px;height:10px;border-radius:2px;background:linear-gradient(90deg,#00CD77 50%,#f0a33a 50%)}
  .u4z-wl{border-radius:12px}
  .u4z-g1 p b{font-size:16px}

  /* =====================================================================
     v5 · SCHODY: klamra pod stopniami 2–5 zamiast pigułek (.u5s-kl)
     ===================================================================== */
  .u5s-kl{grid-column:2 / 6;grid-row:3;position:relative;margin-top:26px;height:14px;border:1.5px solid var(--t2);border-top:0;border-radius:0 0 8px 8px}
  .u5s-kl span{position:absolute;left:50%;top:100%;transform:translate(-50%,-50%);padding:0 14px;background:var(--papier);font-size:14px;font-weight:650;color:var(--t1);white-space:nowrap}
  .u4s-op small{display:block;margin-top:8px;font-size:13.5px;line-height:1.45;color:var(--ziel-c);font-weight:600}
  .u4s{padding-bottom:20px}
  @media (max-width:1000px){
    .u5s-kl{order:6;height:auto;margin:6px 0 0;padding:12px 0 0 14px;border:0;border-left:2px solid var(--ziel-c);border-radius:0}
    .u5s-kl span{position:static;transform:none;padding:0;background:none;white-space:normal}
  }

  /* =====================================================================
     v6 · HERO: twarz osoby, która prowadzi pierwszą rozmowę
     ===================================================================== */
  .u6-tw{display:flex;align-items:center;gap:12px;margin:22px 0 0;font-size:14px;line-height:1.4;color:var(--t2)}
  .u6-tw img{flex:none;width:40px;height:40px;border-radius:50%;object-fit:cover;object-position:50% 18%;box-shadow:0 0 0 2px #ffffff,0 0 0 3.5px rgba(0,205,119,0.55)}
  .u6-tw b{font-weight:650;color:var(--t1)}

  /* =====================================================================
     v6 · GDZIE ZNIKA CZAS: rysunek niżej, stany 0–4 opowiadają usługę.
     Paski: cz = praca zespołu, sy = przejmują połączone narzędzia,
     ai = przygotowuje AI. W kroku 0 wszystko zielone; w krokach 1 i 2
     część się podświetla, po 0,8 s znika.
     ===================================================================== */
  .u6z .u4z-wiz{top:clamp(116px,calc(50vh - 255px),220px)}
  .u6z .u4z-k{min-height:68vh}
  .u6z .u4z-gr{flex-grow:var(--d)}
  .u6z .u4z-gr i{transition:flex-grow .9s cubic-bezier(.6,0,.2,1),opacity .35s}
  .u6z .u4z-gr .sy,.u6z .u4z-gr .ai{background:#00CD77}
  .u6z .u4z-wiz[data-krok="1"] .u4z-gr .sy{background:repeating-linear-gradient(135deg,#f4f7f5 0 2px,rgba(244,247,245,0.28) 2px 6px);flex-grow:0;transition:flex-grow .9s cubic-bezier(.6,0,.2,1) .8s}
  .u6z .u4z-wiz[data-krok="1"] .u4z-gr{flex-grow:var(--d1);transition:flex-grow .9s cubic-bezier(.6,0,.2,1) .8s}
  .u6z .u4z-wiz[data-krok="1"] .u4z-tas{width:calc(var(--tot1) / 420 * 100%);transition:width .9s cubic-bezier(.6,0,.2,1) .8s}
  .u6z .u4z-wiz[data-krok="2"] .u4z-gr .ai{background:repeating-linear-gradient(135deg,#f0a33a 0 2px,rgba(240,163,58,0.25) 2px 6px);flex-grow:0;transition:flex-grow .9s cubic-bezier(.6,0,.2,1) .8s}
  .u6z .u4z-wiz[data-krok="2"] .u4z-gr{flex-grow:var(--p);transition:flex-grow .9s cubic-bezier(.6,0,.2,1) .8s}
  .u6z .u4z-wiz[data-krok="2"] .u4z-tas{width:calc(var(--tot2) / 420 * 100%);transition:width .9s cubic-bezier(.6,0,.2,1) .8s}
  .u6z .u4z-wiz[data-krok="2"] .u4z-gr .sy,
  .u6z .u4z-wiz[data-krok="3"] .u4z-gr .sy,.u6z .u4z-wiz[data-krok="3"] .u4z-gr .ai,
  .u6z .u4z-wiz[data-krok="4"] .u4z-gr .sy,.u6z .u4z-wiz[data-krok="4"] .u4z-gr .ai{flex-grow:0}
  .u6z .u4z-wiz[data-krok="3"] .u4z-gr,.u6z .u4z-wiz[data-krok="4"] .u4z-gr{flex-grow:var(--p)}
  .u6z .u4z-wiz[data-krok="3"] .u4z-tas,.u6z .u4z-wiz[data-krok="4"] .u4z-tas{width:calc(var(--tot2) / 420 * 100%)}
  .u6z .u4z-wiz[data-krok="1"] .u4z-gr .cz,.u6z .u4z-wiz[data-krok="1"] .u4z-gr .ai,
  .u6z .u4z-wiz[data-krok="2"] .u4z-gr .cz{opacity:0.45}
  .u6z .u4z-wiz[data-krok="2"] .u4z-czas{color:var(--ziel)}
  /* klucz kolorów pod skalą */
  .u6z-kl{display:flex;flex-wrap:wrap;gap:6px 22px;margin:2px 0 0;padding:0;list-style:none;font-size:12.5px;color:rgba(255,255,255,0.6);transition:opacity .35s}
  .u6z-kl li{display:flex;align-items:center;gap:8px;transition:opacity .35s,color .35s}
  .u6z-kl i{width:18px;height:9px;border-radius:2px;background:#00CD77}
  .u6z-kl .sy i{background:repeating-linear-gradient(135deg,#f4f7f5 0 2px,rgba(244,247,245,0.28) 2px 6px)}
  .u6z-kl .ai i{background:repeating-linear-gradient(135deg,#f0a33a 0 2px,rgba(240,163,58,0.25) 2px 6px)}
  .u6z-kl .sy,.u6z-kl .ai{opacity:0.4}
  .u6z .u4z-wiz[data-krok="1"] .u6z-kl .sy,.u6z .u4z-wiz[data-krok="2"] .u6z-kl .ai{opacity:1;color:#ffffff}
  .u6z .u4z-wiz[data-krok="4"] .u6z-kl{opacity:0.1}
