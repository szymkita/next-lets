---
// WARIANT G — E z krótszą listą linków (15.10.2026)
//
// Góra jak w E: logo, zdanie o studiu, odznaka OpenAI z kontaktem, neon.
//
// Linki nie kopiują już menu. Megamenu jest w kodzie każdej strony, więc
// usługi, podstrony guided codingu i produkty i tak mają wejście z każdego
// adresu. Stopka trzyma:
// - usługi w dwóch kolumnach, każda z własnym nagłówkiem (wspólny nagłówek
//   „Usługi" nad dwiema kolumnami zostawiał drugą bez tytułu), bez trzech
//   podstron guided codingu — zostaje jego strona główna, w „Wdrażamy AI",
//   bo to praca zespołu z AI; osiem linków zamiast jedenastu,
// - obszary w komplecie, jako zwykłą kolumnę: poza stopką nie linkuje do
//   nich nic, podobnie jak do „Systemów dla klientów",
// - firmę razem z jednym linkiem do produktów zamiast Appto i Wingmana.
// Z 23 linków zostaje 19, a znikają podpisy dróg, kreski i osobny wiersz
// obszarów.
import { DROGI, FIRMA, OBSZARY, KONTAKT, SPOLKA, logo, SYGNET, IKONA_LINKEDIN } from './dane';
import { POKAZ } from '../../data/menu.js';
const KOL_USLUG = [
  { h: DROGI[0].pas, poz: [...DROGI[0].poz, DROGI[2].poz[0]] }, // + Guided coding
  { h: DROGI[1].pas, poz: DROGI[1].poz },
];
// Od 16.10.2026 stopka chowa to samo co menu (src/data/menu.js): w „Firmie”
// zostają Dlaczego my i Baza wiedzy.
const SCHOWANE = { '/produkty': !POKAZ.produkty, '/inspiracje': !POKAZ.inspiracje, '/wisestack': !POKAZ.knowhow };
const FIRMA_G = [{ t: 'Produkty', h: '/produkty' }, ...FIRMA].filter((p) => !SCHOWANE[p.h]);
---
<footer class="sG">
<div class="sG-in">

<div class="sG-gora">
<a href="/" class="sG-logo" aria-label="Let's automate — strona główna" set:html={logo('#ffffff', 'sG')}></a>
<p class="sG-zdanie">Studio transformacji AI. <span>Projektujemy i budujemy systemy, na których firmy działają po&nbsp;nowemu</span></p>
<div class="sG-partner">
<img src="/uploads/openai-select-partner.png" alt="OpenAI Select Partner" width="1125" height="531" class="sG-openai" loading="lazy" decoding="async">
<p class="sG-kontakt">
<a href={`mailto:${KONTAKT.email}`} class="sG-mail">{KONTAKT.email}</a>
<a href={KONTAKT.telHref}>{KONTAKT.tel}</a>
<a href={KONTAKT.linkedin} class="sG-li"><svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d={IKONA_LINKEDIN}/></svg>LinkedIn</a>
</p>
</div>
<div class="sG-neon" aria-hidden="true">
<svg viewBox="-3 -2.5 46 46" class="sG-znak">
<path d={SYGNET} class="sG-rurka-cien"/>
<path d={SYGNET} class="sG-rurka"/>
</svg>
</div>
</div>

<nav class="sG-linki" aria-label="Mapa serwisu">
{KOL_USLUG.map((k) => (
<div>
<p class="sG-h">{k.h}</p>
<ul>{k.poz.map((p) => <li><a href={p.h}>{p.t}</a></li>)}</ul>
</div>
))}
<div>
<p class="sG-h">Automatyzacja w działach</p>
<ul>{OBSZARY.map((o) => <li><a href={o.h}>{o.t}</a></li>)}</ul>
</div>
<div>
<p class="sG-h">Firma</p>
<ul>{FIRMA_G.map((p) => <li><a href={p.h}>{p.t}</a></li>)}</ul>
</div>
</nav>

<div class="sG-prawne">
<span>© 2026 {SPOLKA.nazwa} · {SPOLKA.ulica}, {SPOLKA.miasto} · NIP {SPOLKA.nip} · KRS {SPOLKA.krs}</span>
<span class="sG-prawne-l"><a href="/polityka-prywatnosci">Polityka prywatności</a><button type="button" data-zgody-otworz>Ustawienia cookies</button></span>
</div>

</div>
</footer>

<script>
  // Neon zapala się raz, kiedy wchodzi w kadr. Przy ograniczonych
  // animacjach świeci od razu, bez mignięcia.
  const neon = document.querySelector('.sG-neon');
  if (neon) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
      neon.classList.add('sG-on');
    } else {
      const io = new IntersectionObserver((w) => {
        if (w[0].isIntersecting) { neon.classList.add('sG-on', 'sG-zapal'); io.disconnect(); }
      }, { threshold: 0.4 });
      io.observe(neon);
    }
  }
</script>

<style>
  .sG,.sG *{box-sizing:border-box}
  :global(.sG :where(a)){color:inherit;text-decoration:none}
  :global(.sG :where(ul)){list-style:none;margin:0;padding:0}
  :global(.sG :where(p)){margin:0}

  .sG{position:relative;overflow:hidden;color:#ffffff;
    background:radial-gradient(620px 440px at 86% 22%, rgba(0,205,119,0.13), transparent 70%), #0c2419;
    padding:clamp(56px,6.5vw,88px) max(clamp(20px,5vw,56px),calc((100% - 1440px) / 2)) 30px}

  .sG-gora{display:grid;grid-template-columns:minmax(0,1fr) clamp(200px,21vw,300px);grid-template-areas:"logo neon" "zdanie neon" "partner neon";column-gap:clamp(32px,5vw,96px);align-items:start}
  .sG-logo{grid-area:logo;justify-self:start;display:inline-block}
  .sG-logo :global(svg){display:block;height:26px;width:auto}
  .sG-zdanie{grid-area:zdanie;margin-top:clamp(26px,3vw,36px);max-width:780px;font-size:clamp(23px,2.35vw,32px);line-height:1.2;font-weight:650;letter-spacing:-0.018em;text-wrap:balance}
  .sG-zdanie span{color:rgba(255,255,255,0.5)}

  .sG-partner{grid-area:partner;display:flex;align-items:center;flex-wrap:wrap;gap:16px 28px;margin-top:clamp(28px,3vw,40px)}
  .sG-openai{display:block;height:clamp(52px,4.6vw,64px);width:auto;border-radius:11px;box-shadow:0 18px 40px -22px rgba(0,0,0,0.7)}
  .sG-kontakt{display:flex;align-items:center;flex-wrap:wrap;gap:8px 22px;padding-left:28px;border-left:1px solid rgba(255,255,255,0.14);font-size:15px;font-weight:550;color:rgba(255,255,255,0.82)}
  .sG-kontakt a{transition:color .15s,text-decoration-color .15s}
  .sG-kontakt a:hover{color:#ffffff}
  .sG-mail{text-decoration:underline !important;text-decoration-color:rgba(0,205,119,0.55) !important;text-decoration-thickness:1.5px !important;text-underline-offset:5px}
  .sG-mail:hover{text-decoration-color:#00CD77 !important}
  .sG-li{display:inline-flex;align-items:center;gap:7px}

  /* Neon: szeroka, rozmyta zieleń pod spodem i cienka, prawie biała rurka. */
  .sG-neon{grid-area:neon;align-self:center;justify-self:end;width:100%;opacity:.18;transition:opacity .4s}
  .sG-neon.sG-on{opacity:1}
  .sG-zapal{animation:sG-mig 1.1s steps(1,end) 1}
  @keyframes sG-mig{0%{opacity:.18}12%{opacity:1}18%{opacity:.3}30%{opacity:1}36%{opacity:.5}44%,100%{opacity:1}}
  .sG-znak{display:block;width:100%;height:auto;overflow:visible}
  .sG-rurka-cien{fill:none;stroke:#00CD77;stroke-width:1.5;stroke-linejoin:round;filter:blur(3px);opacity:.75}
  .sG-rurka{fill:none;stroke:#d9ffec;stroke-width:.55;stroke-linejoin:round;filter:drop-shadow(0 0 1.2px #00CD77) drop-shadow(0 0 4px rgba(0,205,119,0.85))}

  /* Cztery równe kolumny, każda z własnym nagłówkiem. */
  .sG-linki{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:36px clamp(24px,3vw,48px);margin-top:clamp(56px,6vw,88px);padding-top:clamp(36px,4vw,48px);border-top:1px solid rgba(255,255,255,0.12)}
  .sG-h{font-size:14.5px;font-weight:700;margin-bottom:16px}
  .sG-linki ul{display:flex;flex-direction:column;gap:10px;font-size:15px;line-height:1.35;color:#c9dacf}
  .sG-linki a,.sG-prawne a,.sG-prawne button{transition:color .15s,text-decoration-color .15s;text-decoration:underline !important;text-decoration-color:transparent !important;text-decoration-thickness:1.5px !important;text-underline-offset:4px}
  .sG-linki a:hover,.sG-prawne a:hover,.sG-prawne button:hover{color:#ffffff;text-decoration-color:#00CD77 !important}
  /* Przycisk otwiera baner zgód (Zgody.astro) — wygląda jak link obok. */
  .sG-prawne-l{display:inline-flex;flex-wrap:wrap;gap:6px 22px}
  .sG-prawne button{appearance:none;padding:0;border:0;background:none;font:inherit;color:inherit;cursor:pointer}

  .sG-prawne{display:flex;align-items:center;justify-content:space-between;gap:12px 28px;flex-wrap:wrap;margin-top:clamp(48px,5vw,64px);padding-top:22px;border-top:1px solid rgba(255,255,255,0.12);font-size:12.5px;line-height:1.6;color:rgba(255,255,255,0.45)}

  @media (max-width:900px){
    .sG-linki{grid-template-columns:repeat(2,minmax(0,1fr))}
    .sG-kontakt{padding-left:0;border-left:0}
  }
  /* Na wąskim ekranie neon schodzi do rzędu z logo jako mały szyld. */
  @media (max-width:760px){
    .sG-gora{grid-template-columns:minmax(0,1fr) auto;grid-template-areas:"logo neon" "zdanie zdanie" "partner partner"}
    .sG-logo{align-self:center}
    .sG-neon{width:64px;align-self:center}
  }
  @media (max-width:520px){
    .sG-linki{grid-template-columns:1fr;gap:34px}
    .sG-linki ul{gap:2px}
    .sG-linki a{display:inline-block;padding-block:5px}
    .sG-kontakt{flex-direction:column;align-items:flex-start;gap:10px}
  }
  @media (prefers-reduced-motion:reduce){
    .sG-zapal{animation:none}
  }
</style>
