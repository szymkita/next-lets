---
// WARIANT E — combo A + C (15.10.2026, po uwagach Szymona)
// Stopka to tylko ciemna część: pas Wise Group z logami zostaje nad nią bez
// zmian, więc marek grupy tu już nie powtarzamy.
//
// Z C zostaje neon: kontur sygnetu jak szyld z biura. On jest też jedynym
// źródłem światła — poświata tła stoi tam, gdzie neon. Z A zostaje zdanie
// o firmie i mapa usług w trzech drogach. Mail przestaje być nagłówkiem
// (nie jest tu najważniejszy) i schodzi do jednego wiersza obok odznaki
// OpenAI Select Partner, która stoi wysoko, zaraz pod zdaniem.
import { DROGI, PRODUKTY, FIRMA, OBSZARY, KONTAKT, SPOLKA, logo, SYGNET, IKONA_LINKEDIN } from './dane';
---
<footer class="sE">
<div class="sE-in">

<div class="sE-gora">
<a href="/" class="sE-logo" aria-label="Let's automate — strona główna" set:html={logo('#ffffff', 'sE')}></a>
<p class="sE-zdanie">Studio transformacji AI z&nbsp;Warszawy. <span>Projektujemy i budujemy systemy, na których firmy działają po&nbsp;nowemu</span></p>
<div class="sE-partner">
<img src="/uploads/openai-select-partner.png" alt="OpenAI Select Partner" width="1125" height="531" class="sE-openai" loading="lazy" decoding="async">
<p class="sE-kontakt">
<a href={`mailto:${KONTAKT.email}`} class="sE-mail">{KONTAKT.email}</a>
<a href={KONTAKT.telHref}>{KONTAKT.tel}</a>
<a href={KONTAKT.linkedin} class="sE-li"><svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d={IKONA_LINKEDIN}/></svg>LinkedIn</a>
</p>
</div>
<div class="sE-neon" aria-hidden="true">
<svg viewBox="-3 -2.5 46 46" class="sE-znak">
<path d={SYGNET} class="sE-rurka-cien"/>
<path d={SYGNET} class="sE-rurka"/>
</svg>
</div>
</div>

<nav class="sE-mapa" aria-label="Mapa serwisu">
{DROGI.map((d) => (
<div class="sE-kol">
<p class="sE-pas">{d.pas}</p>
<p class="sE-sub">{d.sub}</p>
<span class="sE-kreska" aria-hidden="true"></span>
<ul class="sE-lista">{d.poz.map((p) => <li><a href={p.h}>{p.t}</a></li>)}</ul>
</div>
))}
<div class="sE-kol">
<p class="sE-pas">Produkty</p>
<ul class="sE-lista sE-lista-bez">{PRODUKTY.map((p) => <li><a href={p.h}>{p.t}</a></li>)}</ul>
<p class="sE-pas sE-pas2">Firma</p>
<ul class="sE-lista sE-lista-bez">{FIRMA.map((p) => <li><a href={p.h}>{p.t}</a></li>)}</ul>
</div>
</nav>

<div class="sE-obszary">
<p class="sE-obl">Automatyzacja w działach</p>
<ul>{OBSZARY.map((o) => <li><a href={o.h}>{o.t}</a></li>)}</ul>
</div>

<div class="sE-prawne">
<span>© 2026 {SPOLKA.nazwa} · {SPOLKA.ulica}, {SPOLKA.miasto} · NIP {SPOLKA.nip} · KRS {SPOLKA.krs}</span>
<a href="/polityka-prywatnosci">Polityka prywatności</a>
</div>

</div>
</footer>

<script>
  // Neon zapala się raz, kiedy wchodzi w kadr. Przy ograniczonych
  // animacjach świeci od razu, bez mignięcia.
  const neon = document.querySelector('.sE-neon');
  if (neon) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
      neon.classList.add('sE-on');
    } else {
      const io = new IntersectionObserver((w) => {
        if (w[0].isIntersecting) { neon.classList.add('sE-on', 'sE-zapal'); io.disconnect(); }
      }, { threshold: 0.4 });
      io.observe(neon);
    }
  }
</script>

<style>
  .sE,.sE *{box-sizing:border-box}
  :global(.sE :where(a)){color:inherit;text-decoration:none}
  :global(.sE :where(ul)){list-style:none;margin:0;padding:0}
  :global(.sE :where(p)){margin:0}

  .sE{position:relative;overflow:hidden;color:#ffffff;
    background:radial-gradient(620px 440px at 86% 22%, rgba(0,205,119,0.13), transparent 70%), #0c2419;
    padding:clamp(56px,6.5vw,88px) max(clamp(20px,5vw,56px),calc((100% - 1440px) / 2)) 30px}

  /* Lewa kolumna: logo, zdanie, odznaka z kontaktem. Neon zajmuje prawą
     przez wszystkie trzy wiersze. */
  .sE-gora{display:grid;grid-template-columns:minmax(0,1fr) clamp(200px,21vw,300px);grid-template-areas:"logo neon" "zdanie neon" "partner neon";column-gap:clamp(32px,5vw,96px);align-items:start}
  .sE-logo{grid-area:logo;justify-self:start;display:inline-block}
  .sE-logo :global(svg){display:block;height:26px;width:auto}
  .sE-zdanie{grid-area:zdanie;margin-top:clamp(26px,3vw,36px);max-width:780px;font-size:clamp(23px,2.35vw,32px);line-height:1.2;font-weight:650;letter-spacing:-0.018em;text-wrap:balance}
  .sE-zdanie span{color:rgba(255,255,255,0.5)}

  .sE-partner{grid-area:partner;display:flex;align-items:center;flex-wrap:wrap;gap:16px 28px;margin-top:clamp(28px,3vw,40px)}
  .sE-openai{display:block;height:clamp(52px,4.6vw,64px);width:auto;border-radius:11px;box-shadow:0 18px 40px -22px rgba(0,0,0,0.7)}
  .sE-kontakt{display:flex;align-items:center;flex-wrap:wrap;gap:8px 22px;padding-left:28px;border-left:1px solid rgba(255,255,255,0.14);font-size:15px;font-weight:550;color:rgba(255,255,255,0.82)}
  .sE-kontakt a{transition:color .15s,text-decoration-color .15s}
  .sE-kontakt a:hover{color:#ffffff}
  .sE-mail{text-decoration:underline !important;text-decoration-color:rgba(0,205,119,0.55) !important;text-decoration-thickness:1.5px !important;text-underline-offset:5px}
  .sE-mail:hover{text-decoration-color:#00CD77 !important}
  .sE-li{display:inline-flex;align-items:center;gap:7px}

  /* Neon: szeroka, rozmyta zieleń pod spodem i cienka, prawie biała rurka. */
  .sE-neon{grid-area:neon;align-self:center;justify-self:end;width:100%;opacity:.18;transition:opacity .4s}
  .sE-neon.sE-on{opacity:1}
  .sE-zapal{animation:sE-mig 1.1s steps(1,end) 1}
  @keyframes sE-mig{0%{opacity:.18}12%{opacity:1}18%{opacity:.3}30%{opacity:1}36%{opacity:.5}44%,100%{opacity:1}}
  .sE-znak{display:block;width:100%;height:auto;overflow:visible}
  .sE-rurka-cien{fill:none;stroke:#00CD77;stroke-width:1.5;stroke-linejoin:round;filter:blur(3px);opacity:.75}
  .sE-rurka{fill:none;stroke:#d9ffec;stroke-width:.55;stroke-linejoin:round;filter:drop-shadow(0 0 1.2px #00CD77) drop-shadow(0 0 4px rgba(0,205,119,0.85))}

  .sE-mapa{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(28px,3vw,48px);margin-top:clamp(52px,6vw,80px);padding-top:clamp(36px,4vw,48px);border-top:1px solid rgba(255,255,255,0.12)}
  .sE-pas{font-size:15.5px;font-weight:700;letter-spacing:-0.005em}
  .sE-pas2{margin-top:30px}
  .sE-sub{margin-top:4px;font-size:13px;line-height:1.45;color:rgba(255,255,255,0.5)}
  .sE-kreska{display:block;width:26px;height:2px;margin:14px 0 16px;border-radius:2px;background:#00CD77}
  .sE-lista-bez{margin-top:14px}
  .sE-lista{display:flex;flex-direction:column;gap:9px;font-size:15px;line-height:1.35;color:#c9dacf}
  .sE-lista a,.sE-obszary a,.sE-prawne a{transition:color .15s,text-decoration-color .15s;text-decoration:underline !important;text-decoration-color:transparent !important;text-decoration-thickness:1.5px !important;text-underline-offset:4px}
  .sE-lista a:hover,.sE-obszary a:hover,.sE-prawne a:hover{color:#ffffff;text-decoration-color:#00CD77 !important}

  .sE-obszary{display:flex;align-items:baseline;gap:10px 22px;flex-wrap:wrap;margin-top:clamp(40px,4.5vw,56px);padding-top:22px;border-top:1px solid rgba(255,255,255,0.12)}
  .sE-obl{font-size:13.5px;font-weight:700}
  .sE-obszary ul{display:flex;flex-wrap:wrap;gap:6px 0;font-size:14px;color:#c9dacf}
  .sE-obszary li + li::before{content:"";display:inline-block;width:3px;height:3px;margin:0 12px;border-radius:50%;background:rgba(255,255,255,0.3);vertical-align:middle}

  .sE-prawne{display:flex;align-items:center;justify-content:space-between;gap:12px 28px;flex-wrap:wrap;margin-top:22px;padding-top:22px;border-top:1px solid rgba(255,255,255,0.12);font-size:12.5px;line-height:1.6;color:rgba(255,255,255,0.45)}

  @media (max-width:1100px){
    .sE-mapa{grid-template-columns:repeat(2,minmax(0,1fr))}
  }
  /* Na wąskim ekranie neon schodzi do rzędu z logo jako mały szyld —
     obok zdania zabrałby mu połowę szerokości. */
  @media (max-width:760px){
    .sE-gora{grid-template-columns:minmax(0,1fr) auto;grid-template-areas:"logo neon" "zdanie zdanie" "partner partner"}
    .sE-logo{align-self:center}
    .sE-neon{width:64px;align-self:center}
    .sE-kontakt{padding-left:0;border-left:0}
  }
  @media (max-width:520px){
    .sE-mapa{grid-template-columns:1fr;gap:34px}
    .sE-obszary{flex-direction:column;gap:12px}
    .sE-obszary ul{flex-direction:column;gap:2px}
    .sE-obszary li + li::before{display:none}
    .sE-lista a,.sE-obszary a{display:inline-block;padding-block:5px}
    .sE-lista{gap:2px}
    .sE-kontakt{flex-direction:column;align-items:flex-start;gap:10px}
  }
  @media (prefers-reduced-motion:reduce){
    .sE-zapal{animation:none}
  }
</style>
