  .sa .mk i::before{content:"";position:absolute;left:calc(-4 * var(--s));right:calc(-4 * var(--s));top:50%;height:calc(2.4 * var(--s));margin-top:calc(-1.2 * var(--s));background:#ffffff;border-radius:calc(2 * var(--s))}
  .sa .mk.sm{width:calc(16 * var(--s));height:calc(16 * var(--s));border-radius:calc(5 * var(--s))}
  .sa .mk.sm i{width:calc(8 * var(--s));height:calc(8 * var(--s));box-shadow:inset 0 0 0 calc(1.6 * var(--s)) #ffffff}
  .sa .mk.sm i::before{left:calc(-2.5 * var(--s));right:calc(-2.5 * var(--s));height:calc(1.6 * var(--s));margin-top:calc(-0.8 * var(--s))}
  /* okno przeglądarki */
  .sa-tabs{display:flex;align-items:flex-end;gap:calc(6 * var(--s));height:calc(34 * var(--s));padding-left:calc(10 * var(--s));background:#E3E6EA;font-size:calc(12 * var(--s));color:#1f2328}
  .sa-tabs .tab{display:flex;align-items:center;gap:calc(8 * var(--s));width:calc(250 * var(--s));height:calc(28 * var(--s));padding:0 calc(10 * var(--s));border-radius:calc(8 * var(--s)) calc(8 * var(--s)) 0 0;background:#F6F7F9}
