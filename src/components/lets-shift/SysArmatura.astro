  .sa-hd .st{display:inline-flex;align-items:center;gap:calc(6 * var(--s));padding:calc(2 * var(--s)) calc(9 * var(--s));border-radius:999px;background:var(--brt);font-size:calc(12 * var(--s));font-weight:550;color:var(--br)}
  .sa-hd .st i{width:calc(6 * var(--s));height:calc(6 * var(--s));border-radius:50%;background:var(--br)}
