  .sa-tabs .ok-w{display:flex;align-self:stretch;margin-left:auto}
  .sa-tabs .ok-w i{display:grid;place-items:center;width:calc(42 * var(--s));font-style:normal;color:#374151}
  .sa-adr{display:flex;align-items:center;gap:calc(12 * var(--s));height:calc(34 * var(--s));padding:0 calc(12 * var(--s));border-bottom:1px solid var(--li);background:#F6F7F9;font-size:calc(12.5 * var(--s));color:#4b5563}
