  .sa-sb{display:flex;flex-direction:column;gap:calc(4 * var(--s));padding:calc(14 * var(--s)) calc(10 * var(--s)) calc(12 * var(--s));border-right:1px solid var(--li);background:var(--sb);overflow:hidden}
