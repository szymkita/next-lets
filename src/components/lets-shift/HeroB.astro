<script>
  // Suwak porównania „dziś / po zmianie”. Na pulpicie: przeciąganie
  // (mysz, dotyk), klawiatura (strzałki, Home, End) i jeden przejazd, gdy
  // obraz wejdzie w kadr: w stronę „dziś”, potem „po zmianie” (wtedy rusza
  // historia zamówienia), na koniec powrót. Na telefonie przełącznik dwóch
  // pełnych widoków; raz przełącza się sam. Bez JS i przy ograniczonym
  // ruchu: stan końcowy, bez przejazdu.
  (function(){
    var fig = document.querySelector('[data-shb]') as HTMLElement | null;
    if(!fig) return;
    var ram = fig.querySelector('.shb-ram') as HTMLElement;
    var uch = fig.querySelector('[data-shb-uch]') as HTMLElement;
    var po = fig.querySelector('[data-shb-po]') as HTMLElement;
    var przyc = Array.prototype.slice.call(fig.querySelectorAll('[data-shb-t]')) as HTMLElement[];
    var redukcja = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var maIO = 'IntersectionObserver' in window;
    var mq = window.matchMedia('(max-width:760px)');
    var p = mq.matches ? 0 : 36, ruszyl = false, ciagnie = false, grane = false;
    function ustaw(v: number){
      p = Math.max(0, Math.min(100, v));
      ram.style.setProperty('--p', p.toFixed(2) + '%');
      uch.setAttribute('aria-valuenow', String(Math.round(p)));
      uch.setAttribute('aria-valuetext', p < 35 ? 'więcej po zmianie' : p > 65 ? 'więcej dziś' : 'pół na pół');
    }
    function graj(){ if(grane) return; grane = true; requestAnimationFrame(function(){ po.classList.add('on'); }); }
    function tryb(t: string, anim: boolean){
      ram.classList.toggle('anim', anim && !redukcja);
      ustaw(t === 'po' ? 0 : 100);
      przyc.forEach(function(b){ b.setAttribute('aria-pressed', b.dataset.shbT === t ? 'true' : 'false'); });
      if(t === 'po') graj();
    }
    przyc.forEach(function(b){ b.addEventListener('click', function(){ ruszyl = true; tryb(b.dataset.shbT || 'po', true); }); });
    function zX(x: number){ var r = ram.getBoundingClientRect(); ustaw(((x - r.left) / r.width) * 100); }
    ram.addEventListener('pointerdown', function(e){
      if(mq.matches) return;
      ruszyl = true; ciagnie = true; ram.classList.remove('anim');
      ram.setPointerCapture(e.pointerId); zX(e.clientX); graj();
    });
    ram.addEventListener('pointermove', function(e){ if(ciagnie) zX(e.clientX); });
    ram.addEventListener('pointerup', function(){ ciagnie = false; });
    ram.addEventListener('pointercancel', function(){ ciagnie = false; });
    uch.addEventListener('keydown', function(e){
      var k = e.key, d = k === 'ArrowLeft' ? -5 : k === 'ArrowRight' ? 5 : 0;
      if(k === 'Home'){ ustaw(0); } else if(k === 'End'){ ustaw(100); } else if(d){ ustaw(p + d); } else return;
      e.preventDefault(); ruszyl = true; ram.classList.remove('anim'); graj();
    });
    if(redukcja || !maIO) return;
    po.classList.add('gra');
    if(mq.matches) tryb('dzis', false); else ustaw(36);
    function przejazd(){
      var punkty = [[0, 36], [1100, 95], [2600, 95], [4200, 4], [7600, 4], [8700, 36]], t0 = 0;
      function krok(t: number){
        if(ruszyl) return;
        if(!t0) t0 = t;
        var dt = t - t0;
        if(dt > 2500) graj();
        for(var i = 1; i < punkty.length; i++){
          if(dt <= punkty[i][0]){
            var a = punkty[i - 1], b = punkty[i], q = (dt - a[0]) / (b[0] - a[0]);
            q = q < 0.5 ? 2 * q * q : 1 - Math.pow(-2 * q + 2, 2) / 2;
            ustaw(a[1] + (b[1] - a[1]) * q);
            requestAnimationFrame(krok); return;
          }
        }
        ustaw(36);
      }
      requestAnimationFrame(krok);
    }
    var io = new IntersectionObserver(function(w){
      if(!w[0].isIntersecting) return;
      io.disconnect();
      if(mq.matches) setTimeout(function(){ if(!ruszyl) tryb('po', true); }, 2600);
      else setTimeout(przejazd, 500);
    }, { threshold: 0.35 });
    io.observe(ram);
  })();
</script>
