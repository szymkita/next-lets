---
// HERO A (25.10.2026) — „Mapa systemów w ruchu”, pierwsze hero /lets-shift.
// Od wyboru wariantu B (25.10.2026) stoi tylko na /lets-shift-hero jako
// „Wariant A (poprzedni)”. Szymon: „fajnie, ale nie rozumiem tego”.
// Ciemna plansza; mapa 24 elementów producenta armatury na jasnym arkuszu
// wystaje poza dolną krawędź: dziś (splątane linie, ludzie w miejscach
// ręcznego przenoszenia danych) → pieczątki decyzji → po trzech etapach
// (warstwy, nowe nazwy, szuflada „wyłączone”, nowe podpisy ludzi). Pętla
// tylko w kadrze; bez JS i przy ograniczonym ruchu stan końcowy. Poniżej
// 1150 px uproszczona mapa (10 elementów, dwie osoby).
const f1 = (n: number) => n.toFixed(1);

// ---- DECYZJE: jedne nazwy i jedne kolory dla całej strony -------------------
type Dec = 'zo' | 'la' | 'wy' | 'wl';
const DEC: Record<Dec, string> = { zo: 'zostaje', la: 'łączymy', wy: 'wymieniamy', wl: 'wyłączamy' };
const DEC_KOL: Dec[] = ['zo', 'la', 'wy', 'wl'];

// ---- PRZYKŁAD: producent i dystrybutor armatury, 320 osób (POGLĄDOWY) -------
// 24 elementy mapy. g = [kolumna, rząd] na mapie „dziś” (siatka 7 × 4),
// t = miejsce po etapach: [warstwa, kolumna] albo ['rail', k] (przejście
// danych, które staje się połączeniem na szynie). w = fala zmiany
// (0 = zostaje bez zmian). m = wersja uproszczona (poniżej 1150 px).
type Kafel = {
  id: string; d: Dec; n: string; s?: string; n1?: string; s1?: string;
  g: [number, number]; t: [string, number]; w: number;
  m?: { g: [number, number]; t: [string, number]; dx?: number };
};
const KAFLE: Kafel[] = [
  { id: 'crm', d: 'wl', n: 'CRM z 2019 r.', s: 'dane z jednego kwartału', s1: 'wyłączony w etapie 3', g: [0, 0], t: ['szu', 2], w: 3, m: { g: [0, 0], t: ['szu', 0] } },
  { id: 'ofe', d: 'wy', n: '37 arkuszy ofert', s: 'wersję aktualną zna Ewa', n1: 'System ofert i zamówień', g: [1, 0], t: ['pr', 0], w: 1, m: { g: [1, 0], t: ['pr', 0] } },
  { id: 'cen', d: 'wy', n: 'Cenniki w plikach', s: 'osobny dla każdego kanału', n1: 'Jeden cennik', g: [3, 0], t: ['da', 1], w: 1, m: { g: [1, 3], t: ['da', 2] } },
  { id: 'int', d: 'wl', n: 'Intranet', s: 'od 2012 r.', s1: 'wyłączony w etapie 3', g: [4, 0], t: ['szu', 3], w: 3, m: { g: [2, 0], t: ['szu', 1] } },
  { id: 'dys', d: 'zo', n: 'Dysk firmowy', s: 'od 2016 r.', g: [5, 0], t: ['da', 5], w: 0 },
  { id: 'pfi', d: 'zo', n: 'Poczta firmowa', s: 'od 2008 r.', g: [6, 0], t: ['da', 6], w: 0 },
  { id: 'pza', d: 'la', n: 'Poczta zamówień', s: 'zamowienia@', s1: 'AI czyta zamówienia', g: [0, 1], t: ['ai', 0], w: 1, m: { g: [0, 1], t: ['ai', 0] } },
  { id: 'erp', d: 'zo', n: 'ERP', s: 'od 2009 r.', s1: 'księga firmy, połączona', g: [2, 1], t: ['da', 0], w: 1, m: { g: [2, 1], t: ['da', 0] } },
  { id: 'rap', d: 'wy', n: 'Raport zarządu', s: 'z czterech arkuszy', n1: 'Raport z jednej bazy', g: [4, 1], t: ['pr', 7], w: 3, m: { g: [2, 3], t: ['pr', 2] } },
  { id: 'z2', d: 'wl', n: 'Skrzynka zamowienia2@', s: 'od awarii w 2021 r.', s1: 'wyłączona w etapie 1', g: [5, 1], t: ['szu', 0], w: 1 },
  { id: 'tel', d: 'zo', n: 'Telefonia', s: 'centrala w biurze', g: [6, 1], t: ['da', 7], w: 0 },
  { id: 'rek', d: 'wy', n: 'Reklamacje w mailach', s: 'bez numerów spraw', n1: 'Obieg reklamacji z AI', g: [0, 2], t: ['ai', 6], w: 3, m: { g: [0, 2], t: ['ai', 1] } },
  { id: 'ban', d: 'la', n: 'Bankowość', s: 'wyciągi wgrywane ręcznie', s1: 'wyciągi same w ERP', g: [1, 2], t: ['da', 2], w: 3 },
  { id: 'eks', d: 'la', n: 'Eksport z ERP', s: 'plik CSV co noc', n1: 'ERP z resztą', s1: 'na bieżąco', g: [2, 2], t: ['rail', 0], w: 1 },
  { id: 'ksi', d: 'zo', n: 'Księgowość', s: 'biuro rachunkowe', g: [3, 2], t: ['da', 3], w: 0, m: { g: [1, 2], t: ['da', 1], dx: -14 } },
  { id: 'kad', d: 'zo', n: 'Kadry i płace', s: 'od 2014 r.', g: [4, 2], t: ['da', 4], w: 0 },
  { id: 'skl', d: 'zo', n: 'Sklep B2B', s: 'od 2018 r.', s1: 'stany na bieżąco', g: [5, 2], t: ['pr', 1], w: 2 },
  { id: 'kur', d: 'la', n: 'Panele kurierów', s: 'trzy osobne', s1: 'etykiety z zamówień', g: [6, 2], t: ['pr', 3], w: 2 },
  { id: 'jak', d: 'la', n: 'System jakości', s: 'od 2015 r.', s1: 'połączony z reklamacjami', g: [0, 3], t: ['pr', 6], w: 3 },
  { id: 'kar', d: 'wy', n: 'Karty produkcji', s: 'na papierze', n1: 'Aplikacja na hali', g: [1, 3], t: ['pr', 4], w: 2 },
  { id: 'tab', d: 'wy', n: 'Tablica korkowa', s: 'harmonogram hali', n1: 'Plan hali', g: [3, 3], t: ['pr', 5], w: 2 },
  { id: 'acc', d: 'wy', n: 'Access w magazynie', s: 'autor odszedł w 2016 r.', n1: 'Moduł magazynu', g: [4, 3], t: ['pr', 2], w: 2, m: { g: [0, 3], t: ['pr', 1] } },
  { id: 'sta', d: 'la', n: 'Stany do sklepu', s: 'plik raz dziennie', n1: 'Magazyn ↔ sklep', s1: 'na bieżąco', g: [5, 3], t: ['rail', 1], w: 2 },
  { id: 'dru', d: 'wl', n: 'Drugi program magazynowy', s: 'dubluje stany', s1: 'wyłączony w etapie 2', g: [6, 3], t: ['szu', 1], w: 2 },
];
const ILE: Record<Dec, number> = { zo: 0, la: 0, wy: 0, wl: 0 };
KAFLE.forEach((k) => { ILE[k.d]++; });
const KF = Object.fromEntries(KAFLE.map((k) => [k.id, k])) as Record<string, Kafel>;

// Ludzie: na mapie „dziś” stoją na linii między dwoma kaflami (z), po
// falach w warstwie „ludzie decydują” (k = miejsce) z nowym podpisem.
const OSOBY = [
  { id: 'kasia', n: 'Kasia', f: '/makieta/awatar-kasia.webp', a: 'przepisuje zamówienia z maila do ERP', b: 'wyjątki w zamówieniach', z: ['pza', 'erp'], k: 0, w: 1, m: { z: ['pza', 'erp'], k: 0 } },
  { id: 'ewa', n: 'Ewa', f: '/makieta/awatar-ewa.webp', a: 'jedyna zna arkusz cen', b: 'właścicielka jednego cennika', z: ['ofe', 'cen'], k: 1, w: 1 },
  { id: 'tomasz', n: 'Tomasz', f: '/makieta/awatar-tomasz.webp', a: 'nosi karty produkcji z hali do biura', b: 'planuje pracę hali', z: ['kar', 'tab'], k: 2, w: 2 },
  { id: 'michal', n: 'Michał', f: '/makieta/awatar-michal.webp', a: 'co piątek eksportuje raport', b: 'analizuje odchylenia w raporcie', z: ['erp', 'rap'], k: 3, w: 3, m: { z: ['erp', 'rap'], k: 1 } },
];

// ---- GEOMETRIA MAPY ----------------------------------------------------------
// Płótno 1280 × 540 jednostek (wersja pełna) i 360 × 448 (uproszczona);
// jednostka --u to 1/1280 (1/360) szerokości płótna (cqw), więc rysunek
// skaluje się razem z tekstem.
const MW = 1280, MH = 540, KW = 134, KH = 52;
const NW = 360, NH = 504, NKW = 108, NKH = 46;
let ziarno = 20261025;
const los = () => { ziarno = (ziarno * 16807) % 2147483647; return (ziarno - 1) / 2147483646; };
const gx = (c: number) => 91.43 + c * 182.86;
const gy = (r: number) => 70 + r * 130;
const tx = (c: number) => 142 + c * 143.5;
const TY: Record<string, number> = { ai: 122, pr: 214, da: 352, szu: 458 };
const RAIL_Y = 309;
const railX = (k: number) => tx(k + 1) - 4.75;
const PASY = [
  { t: 'ludzie decydują', y: 0, h: 100 },
  { t: 'AI w pracy', y: 110, h: 86 },
  { t: 'systemy procesów', y: 204, h: 82 },
  { t: 'dane w jednym miejscu', y: 342, h: 82 },
  { t: `wyłączone · ${ILE.wl}`, y: 436, h: 98, szu: true },
];
const ngx = (c: number) => 62 + c * 118;
const ngy = (r: number) => 60 + r * 125;
const ntx = (c: number) => 10 + c * 117;
const NTY: Record<string, number> = { ai: 134, pr: 238, da: 342, szu: 446 };
const NPASY = [
  { t: 'ludzie decydują', y: 0, h: 96 },
  { t: 'AI w pracy', y: 104, h: 96 },
  { t: 'systemy procesów', y: 208, h: 96 },
  { t: 'dane w jednym miejscu', y: 312, h: 96 },
  { t: 'wyłączone', y: 416, h: 86, szu: true },
];

type Poz = { x0: number; y0: number; x1: number; y1: number; r0: number; cx: number; cy: number };
const POZ: Record<string, Poz> = {};
const NPOZ: Record<string, Poz> = {};
KAFLE.forEach((k) => {
  const jx = (los() - 0.5) * 30, jy = (los() - 0.5) * 22, r = (los() - 0.5) * 2.6;
  const x0 = gx(k.g[0]) - KW / 2 + jx, y0 = gy(k.g[1]) - KH / 2 + jy;
  const [war, c] = k.t;
  const x1 = war === 'rail' ? railX(c) - 64 : tx(c);
  const y1 = war === 'rail' ? RAIL_Y - 19 : TY[war];
  POZ[k.id] = { x0, y0, x1, y1, r0: r, cx: x0 + KW / 2, cy: y0 + KH / 2 };
  if (k.m) {
    const mjx = (los() - 0.5) * 12 + (k.m.dx || 0), mjy = (los() - 0.5) * 14;
    const nx0 = ngx(k.m.g[0]) - NKW / 2 + mjx, ny0 = ngy(k.m.g[1]) - NKH / 2 + mjy;
    NPOZ[k.id] = { x0: nx0, y0: ny0, x1: ntx(k.m.t[1]), y1: NTY[k.m.t[0]], r0: r * 0.8, cx: nx0 + NKW / 2, cy: ny0 + NKH / 2 };
  }
});
// kolejność pieczątek: jak się czyta mapę, wiersz po wierszu
const KOL_PC = [...KAFLE].sort((a, b) => a.g[1] - b.g[1] || a.g[0] - b.g[0]).map((k) => k.id);

const OS_W = 250, NOS_W = 116;
const OPOZ = OSOBY.map((o) => {
  const a = POZ[o.z[0]], b = POZ[o.z[1]];
  const mx = (a.cx + b.cx) / 2, my = (a.cy + b.cy) / 2;
  const pc = 142 + 287 * o.k + 138.75;
  let np: Poz | null = null;
  if (o.m) {
    const na = NPOZ[o.m.z[0]], nb = NPOZ[o.m.z[1]];
    const nmx = (na.cx + nb.cx) / 2, nmy = (na.cy + nb.cy) / 2;
    const npc = o.m.k === 0 ? 90 : 270;
    np = { x0: Math.min(NW - NOS_W - 2, Math.max(2, nmx - NOS_W / 2)), y0: nmy - 17, x1: npc - NOS_W / 2, y1: 24, r0: 0, cx: nmx, cy: nmy };
  }
  return { ...o, p: { x0: mx - OS_W / 2, y0: my - 22, x1: pc - OS_W / 2, y1: 10, r0: 0, cx: mx, cy: my }, np };
});

// Linie: „dziś” splątane krzywe między środkami kafli (przepływy, które
// ktoś kiedyś podłączył), przerywane przez ludzi (dane przenosi człowiek);
// po etapach szyny między warstwami.
const krzywa = (a: Poz, b: Poz, z: number) => {
  const dx = b.cx - a.cx, dy = b.cy - a.cy, d = Math.hypot(dx, dy) || 1;
  const px = -dy / d, py = dx / d, amp = Math.min(95, d * 0.28) * z;
  return `M${f1(a.cx)} ${f1(a.cy)} C${f1(a.cx + dx * 0.33 + px * amp)} ${f1(a.cy + dy * 0.33 + py * amp)} ${f1(a.cx + dx * 0.67 - px * amp)} ${f1(a.cy + dy * 0.67 - py * amp)} ${f1(b.cx)} ${f1(b.cy)}`;
};
const SPLOT: [string, string, number][] = [
  ['erp', 'ksi', 1], ['erp', 'eks', -1], ['eks', 'ofe', 1], ['sta', 'skl', -1], ['sta', 'acc', 1], ['acc', 'dru', -1],
  ['crm', 'ofe', 1], ['pza', 'z2', -1], ['ban', 'ksi', 1], ['kad', 'ksi', -1], ['rek', 'jak', 1], ['int', 'dys', -1],
  ['dys', 'cen', 1], ['kur', 'skl', 1], ['kur', 'erp', -1], ['rap', 'crm', 1], ['skl', 'cen', -1], ['pfi', 'rek', 1],
  ['tab', 'acc', -1], ['jak', 'kar', 1],
];
const D_SPLOT = SPLOT.map(([a, b, z]) => krzywa(POZ[a], POZ[b], z));
const D_RECZ = OSOBY.map((o) => `M${f1(POZ[o.z[0]].cx)} ${f1(POZ[o.z[0]].cy)} L${f1(POZ[o.z[1]].cx)} ${f1(POZ[o.z[1]].cy)}`);
const NSPLOT: [string, string, number][] = [
  ['erp', 'ksi', 1], ['crm', 'ofe', -1], ['ofe', 'cen', 1], ['int', 'ksi', -1], ['pza', 'rap', 1], ['rek', 'acc', -1], ['acc', 'erp', 1], ['cen', 'rek', -1],
];
const ND_SPLOT = NSPLOT.map(([a, b, z]) => krzywa(NPOZ[a], NPOZ[b], z));
const ND_RECZ = OSOBY.filter((o) => o.m).map((o) => `M${f1(NPOZ[o.m!.z[0]].cx)} ${f1(NPOZ[o.m!.z[0]].cy)} L${f1(NPOZ[o.m!.z[1]].cx)} ${f1(NPOZ[o.m!.z[1]].cy)}`);
const sx = (c: number) => tx(c) + KW / 2;
const D_SZYNY = [
  `M${sx(0)} 160 V250`, `M${sx(6)} 160 V250`,
  `M${sx(0)} ${RAIL_Y} H${sx(7)}`,
  ...[0, 1, 2, 3, 4, 5, 6, 7].map((c) => `M${sx(c)} 250 V${RAIL_Y}`),
  ...[0, 1, 2, 3, 4, 5, 6, 7].map((c) => `M${sx(c)} ${RAIL_Y} V390`),
];
const nsx = (c: number) => ntx(c) + NKW / 2;
const ND_SZYNY = [
  `M${nsx(0)} 204 H${nsx(2)}`, `M${nsx(0)} 308 H${nsx(2)}`,
  ...[0, 1].map((c) => `M${nsx(c)} 170 V204`),
  ...[0, 1, 2].map((c) => `M${nsx(c)} 204 V260`),
  ...[0, 1, 2].map((c) => `M${nsx(c)} 280 V308`),
  ...[0, 1, 2].map((c) => `M${nsx(c)} 308 V360`),
];

const styl = (k: Kafel) => {
  const p = POZ[k.id], n = NPOZ[k.id];
  let s = `--x0:${f1(p.x0)};--y0:${f1(p.y0)};--x1:${f1(p.x1)};--y1:${f1(p.y1)};--r0:${p.r0.toFixed(2)}deg;--g:${Math.max(0, k.w - 1)};--i:${KOL_PC.indexOf(k.id)}`;
  if (n) s += `;--nx0:${f1(n.x0)};--ny0:${f1(n.y0)};--nx1:${f1(n.x1)};--ny1:${f1(n.y1)};--nr0:${n.r0.toFixed(2)}deg`;
  return s;
};
const stylOs = (o: typeof OPOZ[number]) => {
  let s = `--x0:${f1(o.p.x0)};--y0:${f1(o.p.y0)};--x1:${f1(o.p.x1)};--y1:${f1(o.p.y1)};--g:${o.w - 1}`;
  if (o.np) s += `;--nx0:${f1(o.np.x0)};--ny0:${f1(o.np.y0)};--nx1:${f1(o.np.x1)};--ny1:${f1(o.np.y1)}`;
  return s;
};
const lista = (d: Dec) => KAFLE.filter((k) => k.d === d).map((k) => (k.n1 ? `${k.n} → ${k.n1}` : k.n)).join(', ');
const MAPA_ARIA = `Mapa systemów producenta armatury, 320 osób, w trzech stanach. Dziś: ${KAFLE.length} elementów połączonych splątanymi liniami, a w czterech miejscach dane przenoszą ludzie: Kasia przepisuje zamówienia z maila do ERP, Michał co piątek eksportuje raport, Ewa jako jedyna zna arkusz cen, Tomasz nosi karty produkcji z hali do biura. Przy każdym elemencie decyzja. Zostaje ${ILE.zo}: ${lista('zo')}. Łączymy ${ILE.la}: ${lista('la')}. Wymieniamy ${ILE.wy}: ${lista('wy')}. Wyłączamy ${ILE.wl}: ${lista('wl')}. Po trzech etapach elementy układają się w warstwy: dane w jednym miejscu, systemy procesów, AI w pracy i ludzie, którzy decydują. Kasia zajmuje się wyjątkami w zamówieniach, Ewa jest właścicielką jednego cennika, Tomasz planuje pracę hali, Michał analizuje odchylenia w raporcie.`;

