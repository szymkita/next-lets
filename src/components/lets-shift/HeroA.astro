<script>
  // ---- HERO: mapa systemów w pętli, tylko gdy jest w kadrze ----
  // 0 „dziś” → 1 pieczątki decyzji → 2 kafle jadą do warstw docelowych,
  // a nowe nazwy, szuflada i nowe podpisy ludzi przychodzą etapami
  // (opóźnienia w CSS) → wygaszenie i powrót do „dziś”.
  // Bez JS i przy ograniczonym ruchu zostaje stan 2 z HTML.
  (function(){
    var m = document.querySelector('[data-shm]') as HTMLElement | null;
    if(!m) return;
    if(window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)){ m.dataset.s = '2'; return; }
    var timery: number[] = [], widac = false;
    function czysc(){ timery.forEach(function(t){ clearTimeout(t); }); timery = []; }
    function od(ms: number, fn: () => void){ timery.push(window.setTimeout(fn, ms)); }
    function stan(s: string){ m!.dataset.s = s; }
    function cykl(){
      czysc();
      stan('0');
      od(2200, function(){ stan('1'); });
      od(2200 + 3400, function(){ stan('2'); });
      od(2200 + 3400 + 9200, zeruj);
    }
    function zeruj(){
      czysc();
      m!.classList.add('zgas');
      od(480, function(){
        m!.classList.add('bez');
        stan('0');
        void m!.offsetWidth;
        m!.classList.remove('bez');
        m!.classList.remove('zgas');
        od(500, cykl);
      });
    }
    new IntersectionObserver(function(w){
      var jest = w[0].isIntersecting;
      if(jest && !widac){ widac = true; if(m!.dataset.s === '0') cykl(); else zeruj(); }
      else if(!jest && widac){ widac = false; czysc(); }
    }, { threshold: 0.2 }).observe(m);
  })();
</script>
