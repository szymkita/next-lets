<p class="u6-tw"><img src="/piotr-wojciuk.jpg" alt="" width="1002" height="1100" decoding="async"><span>Pierwszą rozmowę prowadzi <b>Piotr Wojciuk</b>. Bezpłatnie i bez zobowiązań.</span></p>
</div>
</div>

<figure class="sh-m" data-shm data-s="2" role="img" aria-label={MAPA_ARIA}>
<div class="sh-m-ok" aria-hidden="true">
<div class="sh-m-gora">
<b>Mapa systemów</b><span>producent armatury, 320 osób</span>
<ul class="sh-m-leg">{DEC_KOL.map((d) => <li class={`sh-d${d}`}><i></i>{DEC[d]} <b>{ILE[d]}</b></li>)}</ul>
</div>
<div class="sh-m-cv">
{PASY.map((p) => <div class={`sh-m-pas pel${p.szu ? ' szu' : ''}`} style={`--y:${p.y};--h:${p.h}`}><span>{p.t}</span></div>)}
{NPASY.map((p) => <div class={`sh-m-pas nar${p.szu ? ' szu' : ''}`} style={`--y:${p.y};--h:${p.h}`}><span>{p.t}</span></div>)}
<svg class="sh-m-l pel" viewBox={`0 0 ${MW} ${MH}`} preserveAspectRatio="none">
<g class="spl">{D_SPLOT.map((d) => <path d={d} />)}</g>
<g class="rec">{D_RECZ.map((d) => <path d={d} />)}</g>
<g class="szy">{D_SZYNY.map((d) => <path d={d} />)}</g>
</svg>
<svg class="sh-m-l nar" viewBox={`0 0 ${NW} ${NH}`} preserveAspectRatio="none">
<g class="spl">{ND_SPLOT.map((d) => <path d={d} />)}</g>
<g class="rec">{ND_RECZ.map((d) => <path d={d} />)}</g>
<g class="szy">{ND_SZYNY.map((d) => <path d={d} />)}</g>
</svg>
{KAFLE.map((k) => (
  <div class={`sh-kf sh-d${k.d}${k.t[0] === 'rail' ? ' rail' : ''}`} style={styl(k)} data-n={k.m ? '' : undefined}>
    <span class="kt"><span class="fa"><b>{k.n}</b>{k.s && <small>{k.s}</small>}</span><span class="fb">{k.d === 'wy' && <s>{k.n}</s>}<b>{k.n1 || k.n}</b>{(k.s1 || (k.d !== 'wy' && k.s)) && <small>{k.s1 || k.s}</small>}</span></span>
    <em class="sh-pc">{DEC[k.d]}</em>
  </div>
))}
{OPOZ.map((o) => (
  <div class="sh-os" style={stylOs(o)} data-n={o.np ? '' : undefined}>
    <img src={o.f} alt="" width="96" height="96">
