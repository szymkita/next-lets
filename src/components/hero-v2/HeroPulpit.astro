---
// WARIANT A — „Pulpit firmy" (16.10.2026)
// Rama jak na podstronach usługowych (wariant „okno"): ciemna plansza,
// nagłówek u góry, okno wisi na jej dolnej krawędzi.
//
// W oknie jest pierwotny pomysł z obecnej strony głównej — pulpit, na którym
// praca dzieje się sama, a człowiek zatwierdza wyjątki — przerobiony według
// zasad makiet z podstron: bez kafli z liczbami, bez liczników przy menu,
// bez pigułek statusu z tłem i bez awatarów z inicjałami. Zamiast tego:
//   · pięć procesów firmy w jednym rejestrze; przy każdym ostatnia sprawa,
//     którą system zamknął, i osoba, która wchodzi tylko przy wyjątku,
//   · jedna decyzja z regułą marży (rabat poza widełkami idzie do zarządu),
//   · oś „Aktywność", w której system jest jednym z autorów.
// Przebieg: wpada faktura, Marta zatwierdza rabat swoim kursorem, oferta
// wychodzi, potem co kilka sekund dochodzi kolejna sprawa w którymś z
// procesów. Pauza, kiedy okno nie jest w kadrze; przy ograniczonym ruchu
// zostaje stan z markupu (decyzja czeka).
//
// DO POTWIERDZENIA: firma Termo-Bud, osoby i kwoty są zmyślone; zdjęcia
// zastępcze z public/makieta (jak w Ofertowni na /systemy-procesowe).
import { IK } from './ikony';

const OS = {
  mk: { n: 'Marta Król', f: '/makieta/awatar-marta.webp', r: 'zarząd' },
  es: { n: 'Ewa Sowa', f: '/makieta/awatar-ewa.webp', r: 'księgowość' },
  ak: { n: 'Anna Kowal', f: '/makieta/awatar-anna.webp', r: 'handel' },
  mr: { n: 'Michał Rutkowski', f: '/makieta/awatar-michal.webp', r: 'obsługa klienta' },
  tw: { n: 'Tomasz Wilk', f: '/makieta/awatar-tomasz.webp', r: 'magazyn' },
  kz: { n: 'Katarzyna Zając', f: '/makieta/awatar-kasia.webp', r: 'kadry' },
  bn: { n: 'Bartek Nowicki', f: '/makieta/awatar-bartek.webp', r: 'zaopatrzenie' },
};

// Rejestr procesów: stan z markupu (przed przebiegiem).
const PROCESY = [
  { p: 'Obieg faktur', dz: 'Finanse', ik: 'credit-card', os: 'es', s: 'FV 10/412 · Elektro-Hurt', st: 'ok', t: 'zaksięgowana na 402-01', h: '10:42' },
  { p: 'Ofertowanie', dz: 'Handel', ik: 'briefcase', os: 'ak', s: 'OF-2611 · Nordkam', st: 'cz', t: 'rabat czeka na zgodę zarządu', h: '10:38' },
  { p: 'Reklamacje', dz: 'Obsługa klienta', ik: 'chat-bubble-left-ellipsis', os: 'mr', s: 'RMA-2190 · Kamex', st: 'ok', t: 'odpowiedź z protokołem wysłana', h: '10:31' },
  { p: 'Zamówienia z maila', dz: 'Magazyn', ik: 'archive-box', os: 'tw', s: 'ZM-0913 · Hydro-Serwis', st: 'ok', t: '40 zaworów kulowych w ERP', h: '10:29' },
  { p: 'Zamówienia u dostawców', dz: 'Zaopatrzenie', ik: 'truck', os: 'bn', s: 'ZK-0331 · Kan-Therm', st: 'ok', t: 'stany poniżej minimum, zamówienie wysłane', h: '10:18' },
  { p: 'Rekrutacja', dz: 'Kadry', ik: 'user-group', os: 'kz', s: 'Magazynier · 3 nowe CV', st: 'ok', t: 'jedna osoba zaproszona na rozmowę', h: '10:12' },
];

const AKT = [
  { k: 'sys', t: 'zaksięgował FV 10/412', h: '10:42' },
  { k: 'ak', t: 'poprosiła o rabat 12% dla Nordkam', h: '10:38' },
  { k: 'sys', t: 'odpowiedział Kamexowi na RMA-2190', h: '10:31' },
  { k: 'sys', t: 'wpisał ZM-0913 do ERP', h: '10:29' },
  { k: 'tw', t: 'potwierdził stany zaworów', h: '10:24' },
  { k: 'sys', t: 'ocenił 3 nowe CV', h: '10:12' },
  { k: 'sys', t: 'zaksięgował FV 10/411', h: '10:06' },
];

// Reguła marży przy rabacie: widełki 20–28%, po rabacie 17,4% — poza nimi,
// więc decyzja trafia do zarządu.
const MAR = { od: 20, do: 28, ta: 17.4, max: 40 };

const sys = `<b class="hp-sys"><svg viewBox="0 0 16 16">${IK['fire']}</svg></b>`;
const ARIA = 'Pulpit systemu firmy: sześć procesów prowadzi system, ludzie zatwierdzają wyjątki. Kierowniczka zatwierdza rabat poza widełkami marży, oferta wychodzi do klienta.';
---
<figure class="hp hero-wid" data-hp role="img" aria-label={ARIA}>
<div class="hp-okno" aria-hidden="true">
<div class="hp-tyt">
<span class="hp-sw"><i></i><i></i><i></i></span>
<span class="hp-tyt-t">Termo-Bud — Pulpit</span>
</div>
<div class="hp-uk">
<nav class="hp-rail">
<b><svg viewBox="0 0 16 16" set:html={IK['fire']}></svg></b>
<span class="on"><svg class="hi" viewBox="0 0 16 16" set:html={IK['home']}></svg></span>
<span><svg class="hi" viewBox="0 0 16 16" set:html={IK['inbox']}></svg></span>
<span><svg class="hi" viewBox="0 0 16 16" set:html={IK['view-columns']}></svg></span>
<span><svg class="hi" viewBox="0 0 16 16" set:html={IK['document-text']}></svg></span>
<span><svg class="hi" viewBox="0 0 16 16" set:html={IK['users']}></svg></span>
<span class="dol"><svg class="hi" viewBox="0 0 16 16" set:html={IK['cog-6-tooth']}></svg></span>
</nav>

<section class="hp-gl">
<div class="hp-pasek">
<b>Pulpit</b><span class="hp-data">czwartek, 16 października</span>
<span class="hp-szukaj"><svg class="hi" viewBox="0 0 16 16" set:html={IK['magnifying-glass']}></svg>Szukaj spraw i klientów<kbd>⌘K</kbd></span>
<span class="hp-obecni">{['mk', 'ak', 'es'].map((k) => (<img src={OS[k].f} alt="" width="24" height="24" loading="lazy">))}</span>
</div>
<div class="hp-tresc">
<div class="hp-pow">
<div><h3>Dzień dobry, Marto</h3><p data-pow>Od 7:00 system prowadzi sześć procesów. Na Twoją decyzję czekają dwie sprawy.</p></div>
<span class="hp-seg"><span class="on">Dziś</span><span>Tydzień</span><span>Miesiąc</span></span>
</div>
<div class="hp-tab">
<div class="hp-w n"><span>Proces</span><span>Ostatnia sprawa</span><span>Przy wyjątkach</span><span>Godz.</span></div>
{PROCESY.map((x, i) => (
  <div class="hp-w" data-wiersz={i}>
    <span class="hp-pr"><i><svg class="hi" viewBox="0 0 16 16" set:html={IK[x.ik]}></svg></i><span><b>{x.p}</b><em>{x.dz}</em></span></span>
    <span class="hp-sp" data-sp><span class="hp-s"><b>{x.s}</b><span class={x.st}>{x.st === 'ok' ? <svg class="hi" viewBox="0 0 16 16" set:html={IK['check-circle']}></svg> : <i class="czk-j"></i>}{x.t}</span></span></span>
    <span class="hp-os"><img src={OS[x.os].f} alt="" width="20" height="20" loading="lazy">{OS[x.os].n}</span>
    <span class="hp-cz" data-cz>{x.h}</span>
  </div>
))}
</div>
</div>
</section>

<aside class="hp-bok">
<h4>Do decyzji</h4>
<div class="hp-decyzje" data-decyzje>
<div class="hp-dec-w"><div class="hp-dec-in">
<article class="hp-dec">
<div class="hp-dec-gl"><img src={OS.ak.f} alt="" width="18" height="18" loading="lazy"><span><b>Anna Kowal</b> prosi o rabat</span><time>10:38</time></div>
<h5>Rabat 12% dla Nordkam</h5>
<p>OF-2611 · 14 pozycji · 48 200 zł netto</p>
<div class="hp-reg">
<div class="hp-reg-gl"><span>Marża po rabacie</span><b>17,4%</b></div>
<div class="hp-reg-tor"><i class="pas" style={`left:${MAR.od / MAR.max * 100}%;width:${(MAR.do - MAR.od) / MAR.max * 100}%`}></i><i class="zn" style={`left:${MAR.ta / MAR.max * 100}%`}></i></div>
<div class="hp-reg-sk"><span>0%</span><span>widełki {MAR.od}–{MAR.do}%</span><span>{MAR.max}%</span></div>
</div>
<div class="hp-akc"><span class="hp-b1">Zatwierdź</span><span class="hp-b2">Odrzuć</span></div>
<p class="hp-dec-ok"><svg class="hi" viewBox="0 0 16 16" set:html={IK['check-circle']}></svg>Zatwierdzone, oferta wysłana</p>
</article>
</div></div>
</div>
<article class="hp-dec mini">
<div class="hp-dec-gl"><img src={OS.mr.f} alt="" width="18" height="18" loading="lazy"><span><b>Michał Rutkowski</b> prosi o zwrot</span><time>10:21</time></div>
<h5>Zwrot 240 zł dla Dachpolu</h5>
<p>RMA-2192 · zdjęcia nie pokazują uszkodzenia</p>
</article>
<h4 class="hp-akt-h">Aktywność</h4>
<ol class="hp-akt" data-akt role="list">
{AKT.map((x) => (
  <li>{x.k === 'sys' ? <Fragment set:html={sys} /> : <img src={OS[x.k].f} alt="" width="18" height="18" loading="lazy">}<span><strong>{x.k === 'sys' ? 'System' : OS[x.k].n.split(' ')[0]}</strong> {x.t}</span><time>{x.h}</time></li>
))}
</ol>
</aside>
</div>
</div>
<span class="hp-kur" data-kur aria-hidden="true"><svg viewBox="0 0 17 21"><path d="M1.5 1.5v15.2l4-3.9 2.9 6.6 2.9-1.3-2.8-6.4h5.6z" /></svg><b><img src={OS.mk.f} alt="" width="16" height="16" loading="lazy">Marta · zarząd</b></span>
<template data-sys set:html={sys}></template>
<template data-ok set:html={`<svg class="hi" viewBox="0 0 16 16">${IK['check-circle']}</svg>`}></template>
</figure>

<script is:inline>
(function(){
  var fig = document.querySelector('[data-hp]');
  if (!fig || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var q = function(s){ return fig.querySelector(s); };
  var rows = fig.querySelectorAll('[data-wiersz]');
  var akt = q('[data-akt]');
  var kur = q('[data-kur]');
  var lista = q('[data-decyzje]');
  var SYS = q('template[data-sys]').innerHTML;
  var OK = q('template[data-ok]').innerHTML;
  var FOTO = { mk: '/makieta/awatar-marta.webp', ak: '/makieta/awatar-anna.webp' };
  var IMIE = { mk: 'Marta', ak: 'Anna' };

  // Zegar sceny: minuty rosną razem ze sprawami.
  var min = 10 * 60 + 46;
  function godz(){ return Math.floor(min / 60) + ':' + String(min % 60).padStart(2, '0'); }
  function po2(f){ requestAnimationFrame(function(){ requestAnimationFrame(f); }); }

  // Wiersz rejestru: nowa sprawa wjeżdża od dołu, stara wyjeżdża w górę.
  function sprawa(i, s, typ, t){
    var w = rows[i], sp = w.querySelector('[data-sp]'), stara = sp.firstElementChild;
    var n = document.createElement('span');
    n.className = 'hp-s wch';
    n.innerHTML = '<b>' + s + '</b><span class="' + typ + '">' + (typ === 'ok' ? OK : '<i class="czk-j"></i>') + t + '</span>';
    sp.appendChild(n);
    stara.classList.add('wyj');
    po2(function(){ n.classList.remove('wch'); });
    setTimeout(function(){ stara.remove(); }, 560);
    w.querySelector('[data-cz]').textContent = godz();
    w.classList.remove('blysk'); void w.offsetWidth; w.classList.add('blysk');
  }
  function wpis(kto, t){
    var li = document.createElement('li');
    li.className = 'nowy';
    li.innerHTML = (kto === 'sys' ? SYS : '<img src="' + FOTO[kto] + '" alt="" width="18" height="18">') +
      '<span><strong>' + (kto === 'sys' ? 'System' : IMIE[kto]) + '</strong> ' + t + '</span><time>' + godz() + '</time>';
    akt.insertBefore(li, akt.firstChild);
    po2(function(){ li.classList.remove('nowy'); });
    while (akt.children.length > 10) akt.lastElementChild.remove();
  }
  // Na decyzję czeka rabat (jeśli jest) i zwrot dla Dachpolu, który stoi cały czas.
  var rabatow = 1;
  function powitanie(){
    q('[data-pow]').textContent = 'Od 7:00 system prowadzi sześć procesów. Na Twoją decyzję ' + (rabatow > 0 ? 'czekają dwie sprawy.' : 'czeka jedna sprawa.');
  }
  function kursorNa(el, dx, dy){
    var f = fig.getBoundingClientRect(), r = el.getBoundingClientRect();
    kur.style.left = (r.left - f.left + r.width * dx) + 'px';
    kur.style.top = (r.top - f.top + r.height * dy) + 'px';
  }

  // Prośba o rabat poza widełkami 20–28%: karta wjeżdża na górę listy
  // decyzji, a wiersz ofertowania przechodzi w „czeka".
  function decyzja(d){
    min += 1;
    var w = document.createElement('div');
    w.className = 'hp-dec-w zw';
    w.dataset.of = d.of; w.dataset.kl = d.kl; w.dataset.r = d.r;
    w.innerHTML = '<div class="hp-dec-in"><article class="hp-dec">' +
      '<div class="hp-dec-gl"><img src="' + FOTO.ak + '" alt="" width="18" height="18"><span><b>Anna Kowal</b> prosi o rabat</span><time>' + godz() + '</time></div>' +
      '<h5>Rabat ' + d.r + '% dla ' + d.kl + '</h5><p>' + d.of + ' · ' + d.poz + ' · ' + d.kw + ' zł netto</p>' +
      '<div class="hp-reg"><div class="hp-reg-gl"><span>Marża po rabacie</span><b>' + String(d.m).replace('.', ',') + '%</b></div>' +
      '<div class="hp-reg-tor"><i class="pas" style="left:50%;width:20%"></i><i class="zn" style="left:' + (d.m / 40 * 100) + '%"></i></div>' +
      '<div class="hp-reg-sk"><span>0%</span><span>widełki 20–28%</span><span>40%</span></div></div>' +
      '<div class="hp-akc"><span class="hp-b1">Zatwierdź</span><span class="hp-b2">Odrzuć</span></div>' +
      '<p class="hp-dec-ok">' + OK + 'Zatwierdzone, oferta wysłana</p></article></div>';
    lista.insertBefore(w, lista.firstChild);
    rabatow += 1;
    po2(function(){ w.classList.remove('zw'); });
    sprawa(1, d.of + ' · ' + d.kl, 'cz', 'rabat czeka na zgodę zarządu');
    wpis('ak', 'poprosiła o rabat ' + d.r + '% dla ' + d.kl);
    powitanie();
  }
  // Marta zatwierdza najstarszą prośbę z rabatem: kursor, klik, oferta wychodzi.
  function zatwierdz(){
    var w = lista.querySelector('.hp-dec-w:not(.zw)');
    if (!w) return;
    rabatow -= 1;
    var btn = w.querySelector('.hp-b1'), dec = w.querySelector('.hp-dec');
    var of = w.dataset.of || 'OF-2611', kl = w.dataset.kl || 'Nordkam', r = w.dataset.r || '12';
    kur.classList.add('on'); kursorNa(btn, 0.42, 0.55);
    setTimeout(function(){ btn.classList.add('wcis'); }, 1350);
    setTimeout(function(){
      btn.classList.remove('wcis'); dec.classList.add('ok');
      min += 1; sprawa(1, of + ' · ' + kl, 'ok', 'wysłana z rabatem ' + r + '%');
      wpis('mk', 'zatwierdziła rabat ' + r + '% dla ' + kl);
      setTimeout(function(){ wpis('sys', 'wysłał ' + of + ' do ' + kl); }, 380);
    }, 1610);
    setTimeout(function(){ w.classList.add('zw'); powitanie(); kursorNa(q('.hp-akt-h'), 0.3, 2.6); }, 3100);
    setTimeout(function(){ kur.classList.remove('on'); }, 4000);
    setTimeout(function(){ w.remove(); }, 4200);
  }

  // Sprawy, które dochodzą same — po kolei, w kółko, z rosnącymi numerami.
  var nr = { fv: 414, zm: 914, rma: 2193, of: 2612, zk: 332, cv: 2 };
  var KLIENCI = ['Termex', 'Instal-Pol', 'Elektro-Hurt', 'Aquatech', 'Wod-Kan', 'Bud-Instal', 'Grzejtech', 'Hydro-Serwis'];
  var RABATY = [
    { r: 9, kl: 'Grzejtechu', poz: '9 pozycji', kw: '21 650', m: 18.9 },
    { r: 15, kl: 'Bud-Instalu', poz: '22 pozycje', kw: '96 400', m: 16.1 },
    { r: 10, kl: 'Aquatechu', poz: '6 pozycji', kw: '14 980', m: 19.2 }
  ];
  var k = 0, rb = 0;
  function klient(){ return KLIENCI[k++ % KLIENCI.length]; }
  function faktura(){ var n = nr.fv++, kl = klient(); sprawa(0, 'FV 10/' + n + ' · ' + kl, 'ok', 'zaksięgowana na 402-0' + (1 + n % 3)); wpis('sys', 'zaksięgował FV 10/' + n); }
  var DOPLYW = [
    faktura,
    function(){ var n = nr.zm++, kl = klient(); var co = ['120 m rury PEX', '18 grzejników', '6 pomp obiegowych', '60 złączek zaciskowych'][n % 4]; sprawa(3, 'ZM-0' + n + ' · ' + kl, 'ok', co + ' w ERP'); wpis('sys', 'wpisał ZM-0' + n + ' do ERP'); },
    function(){ var d = RABATY[rb++ % RABATY.length]; decyzja({ of: 'OF-' + (nr.of++), kl: d.kl, r: d.r, poz: d.poz, kw: d.kw, m: d.m }); },
    function(){ var n = nr.rma++, kl = klient(); sprawa(2, 'RMA-' + n + ' · ' + kl, 'ok', 'odpowiedź z protokołem wysłana'); wpis('sys', 'odpowiedział na RMA-' + n); },
    zatwierdz,
    function(){ var n = nr.zk++; sprawa(4, 'ZK-0' + n + ' · ' + ['Kan-Therm', 'Purmo', 'Grundfos'][n % 3], 'ok', 'stany poniżej minimum, zamówienie wysłane'); wpis('sys', 'zamówił towar u dostawcy, ZK-0' + n); },
    faktura,
    function(){ nr.cv += 1; sprawa(5, 'Magazynier · ' + nr.cv + ' nowe CV', 'ok', 'ocenione, bez zaproszeń'); wpis('sys', 'ocenił ' + nr.cv + ' nowe CV'); }
  ];

  // Najpierw: wpada faktura, potem Marta zatwierdza czekający rabat dla
  // Nordkam. Dalej dopływ co ~4 s. Pauza poza kadrem.
  var KROKI = [
    [900, function(){ min += 1; sprawa(0, 'FV 10/413 · Termex', 'ok', 'zaksięgowana na 402-03'); wpis('sys', 'zaksięgował FV 10/413'); }],
    [1500, zatwierdz],
    [5200, function(){ min += 2; DOPLYW[1](); }]
  ];
  var i = 0, d = 2, widac = false, czeka = false;
  function krok(){
    if (!widac) { czeka = true; return; }
    if (i < KROKI.length) { KROKI[i++][1](); }
    else { min += 1 + (d % 3); var f = DOPLYW[d % DOPLYW.length]; d++; f(); }
    var po = i < KROKI.length ? KROKI[i][0] : (DOPLYW[(d - 1) % DOPLYW.length] === zatwierdz ? 5200 : 4000);
    setTimeout(krok, po);
  }
  var start = false;
  new IntersectionObserver(function(w){
    widac = w[0].isIntersecting;
    if (widac && !start) { start = true; setTimeout(krok, KROKI[0][0]); }
    else if (widac && czeka) { czeka = false; setTimeout(krok, 1200); }
  }, { threshold: 0.25 }).observe(fig);
})();
</script>

<style is:global>
  .hp{--t1:#18181b;--t2:#52525b;--t3:#71717a;--t4:#a1a1aa;--lin:rgba(9,9,11,0.08);--lin2:rgba(9,9,11,0.05);
    position:relative;margin:0;container-type:inline-size;font-size:12.5px;line-height:1.4;color:var(--t1);letter-spacing:-0.004em;-webkit-font-smoothing:antialiased}
  .hp .hi{display:block;flex-shrink:0;width:16px;height:16px;fill:currentColor}
  .hp-okno{position:relative;overflow:hidden;border-radius:12px;background:#ffffff;
    box-shadow:0 0 0 1px rgba(255,255,255,0.14),0 0 0 1.5px rgba(0,0,0,0.3),0 50px 100px -40px rgba(0,0,0,0.9),0 18px 36px -20px rgba(0,0,0,0.55)}
  .hp-tyt{position:relative;display:flex;align-items:center;height:36px;padding:0 12px;background:#f7f7f6;border-bottom:1px solid var(--lin)}
  .hp-sw{display:flex;gap:7px}
  .hp-sw i{display:block;width:11px;height:11px;border-radius:50%;background:#ff5f57;box-shadow:inset 0 0 0 0.5px rgba(0,0,0,0.18)}
  .hp-sw i:nth-child(2){background:#febc2e}
  .hp-sw i:nth-child(3){background:#28c840}
  .hp-tyt-t{position:absolute;left:50%;transform:translateX(-50%);font-size:12px;font-weight:550;color:var(--t2);white-space:nowrap}

  .hp-uk{display:grid;grid-template-columns:52px minmax(0,1fr) 332px;height:536px}
  .hp-rail{display:flex;flex-direction:column;align-items:center;gap:4px;padding:12px 0;background:#fafaf9;border-right:1px solid var(--lin)}
  .hp-rail > b{display:grid;place-items:center;width:26px;height:26px;margin-bottom:10px;border-radius:7px;background:#0f1a14;box-shadow:inset 0 1px 0 rgba(255,255,255,0.12)}
  .hp-rail > b svg{width:13px;height:13px;fill:#00cd77}
  .hp-rail > span{display:grid;place-items:center;width:32px;height:32px;border-radius:8px;color:var(--t4)}
  .hp-rail > span.on{background:#ffffff;color:var(--t1);box-shadow:0 0 0 1px var(--lin),0 1px 2px rgba(0,0,0,0.05)}
  .hp-rail > span.dol{margin-top:auto}

  .hp-gl{display:flex;flex-direction:column;min-width:0;min-height:0}
