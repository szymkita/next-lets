---
// SZKIELET PODSTRON OBSZAROWYCH — jeden dla całej szóstki.
//
// PO CO ISTNIEJE
// Sześć adresów przeniesionych ze starego serwisu (`/automatyzacja-w-*`).
// W Search Console dają razem 390 kliknięć i 70 tys. wyświetleń rocznie na
// pozycjach 11–17 — to jedyne miejsce w serwisie, gdzie intencja niemarkowa
// spotyka się z komercyjną („szukam firmy od automatyzacji w sprzedaży").
// Nie wchodzą do menu głównego; wejście prowadzi z wyszukiwarki i ze stopki.
//
// CZYM SIĘ RÓŻNIĄ OD PODSTRON USŁUGOWYCH
// Podstrony usługowe dzielą ofertę według RODZAJU REZULTATU (strategia,
// system, szkolenie). Te dzielą ją według DZIAŁU KLIENTA — czyli według osi,
// którą ludzie wpisują w wyszukiwarkę. Dlatego każda z nich kończy się
// przekierowaniem do właściwej usługi: obszar jest pytaniem, usługa
// odpowiedzią. Sekcja „Która usługa" to nie cross-sell, tylko puenta strony.
//
// DECYZJA O FORMACIE (10.09.2026, Szymon)
// Jeden szablon, sześć zestawów danych — świadomie, zamiast sześciu stron
// pisanych osobno po playbooku. Powód: to strony warte razem 390 kliknięć
// rocznie, poza menu, i sześć osobnych animacji nikt by nie utrzymał.
// Konsekwencja, którą trzeba było odrobić w zamian: szablon nie może być
// siatką równych kart. Stąd cztery różne kształty na jednej stronie —
// rachunek w hero, wiersze na liniach w zastosowaniach, dwie kolumny sprawy
// w ciemnym pasie, wiersze-odnośniki w routingu. Powtarza się rytm, nie forma.
//
// LICZBY
// Rachunek w hero jest PRZYKŁADOWY i strona mówi to wprost pod tabelką.
// Wynika z tablicy `rachunek.wiersze` — godziny liczy szablon, nie autor,
// więc po zmianie liczby razy albo minut suma i paski przeliczają się same.
import LaBase from '../layouts/LaBase.astro';
import GcCta from '../components/GcCta.astro';
import GcFaq from '../components/GcFaq.astro';

const { d } = Astro.props;

const kanon = new URL(d.slug, Astro.site).href;

// ---- Rachunek: godziny liczone z danych, nie wpisywane ręcznie ----------
const wiersze = d.rachunek.wiersze.map((w) => ({ ...w, godz: (w.ile * w.min) / 60 }));
const sumaGodz = wiersze.reduce((s, w) => s + w.godz, 0);
const maxGodz = Math.max(...wiersze.map((w) => w.godz));
const fmt = (g) => (g >= 10 ? Math.round(g) : Math.round(g * 10) / 10).toLocaleString('pl-PL');

const dane = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${kanon}#usluga`,
      name: d.h1,
      alternateName: d.alt,
      serviceType: d.typ,
      url: kanon,
      description: d.description,
      provider: { '@id': new URL('/#organizacja', Astro.site).href },
      areaServed: { '@type': 'Country', name: 'Polska' },
      audience: { '@type': 'BusinessAudience', name: d.audytorium },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${kanon}#okruszki`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Strona główna', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: d.h1, item: kanon },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${kanon}#faq`,
      mainEntity: d.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
      })),
    },
  ],
};
---
<LaBase title={d.title} description={d.description} ctaHref="#kontakt" ctaLabel="Umów diagnozę" nav="uslugi">
<script type="application/ld+json" is:inline set:html={JSON.stringify(dane)} slot="head"></script>
<style is:global slot="head">
  /* ================= rachunek działu (hero) =================
     Artefakt, nie wykres: tabelka, jaką zrobiłby ktoś, kto raz usiadł
     i policzył. Pasek przy każdym wierszu pokazuje udział w sumie, więc
     z rysunku da się odczytać proporcję, której nie ma w tekście obok. */
  .ra{background:#ffffff;border:1px solid #e4ebe2;border-radius:18px;overflow:hidden;box-shadow:0 26px 60px -40px rgba(18,38,28,0.3)}
  .ra-gora{display:flex;align-items:baseline;justify-content:space-between;gap:14px;padding:15px 20px;border-bottom:1px solid #e7ece4;background:#fbfcfa}
  .ra-gora b{font-size:13px;font-weight:750;letter-spacing:-0.005em;color:#16211a}
  .ra-gora span{font-family:ui-monospace,Menlo,monospace;font-size:11px;color:#a9b3aa}
  .ra-glowa{display:grid;grid-template-columns:minmax(0,1fr) 58px 52px 64px;gap:12px;padding:11px 20px 8px;font-size:10.5px;letter-spacing:0.07em;text-transform:uppercase;color:#a0aba1}
  .ra-glowa i{font-style:normal;text-align:right}
  .ra-w{display:grid;grid-template-columns:minmax(0,1fr) 58px 52px 64px;gap:12px;align-items:baseline;padding:10px 20px;border-top:1px solid #f0f3ee}
  .ra-t{font-size:13.5px;line-height:1.35;color:#16211a;text-wrap:pretty}
  .ra-n{font-family:ui-monospace,Menlo,monospace;font-size:12.5px;text-align:right;color:#8b968d}
  .ra-g{font-family:ui-monospace,Menlo,monospace;font-size:13px;font-weight:650;text-align:right;color:#16211a}
  /* Pasek udziału siedzi pod wierszem i jest jedynym miejscem, w którym
     widać, że jedna czynność zjada więcej niż trzy pozostałe razem. */
  .ra-pas{grid-column:1 / -1;height:4px;margin-top:7px;border-radius:3px;background:#eef3ec;overflow:hidden}
  .ra-pas i{display:block;height:100%;border-radius:3px;background:var(--la-accent,#00CD77)}
  .ra-suma{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px;align-items:baseline;padding:15px 20px;border-top:1px solid #dde7db;background:#f6f9f5}
  .ra-suma b{font-size:13.5px;font-weight:750;color:#16211a}
  .ra-suma em{font-style:normal;font-size:clamp(22px,2.6vw,28px);font-weight:800;letter-spacing:-0.03em;color:#0a7a52}
  .ra-nota{margin:12px 2px 0;font-size:12.5px;line-height:1.55;color:#8b968d;text-wrap:pretty}
  @media (max-width:520px){
    .ra-glowa,.ra-w{grid-template-columns:minmax(0,1fr) 46px 44px 56px;gap:8px;padding-inline:14px}
    .ra-t{font-size:12.5px}
  }

  /* ================= czym jest (kolumna przy definicji) ================= */
  .cz-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,0.85fr);gap:clamp(30px,5vw,72px);align-items:start;margin-top:clamp(26px,3.4vw,40px)}
  .cz-def{margin:0;font-size:clamp(17px,2.1vw,19.5px);line-height:1.6;color:#33413a;text-wrap:pretty}
  .cz-def + p{margin:18px 0 0;font-size:16px;line-height:1.65;color:#4c5850;text-wrap:pretty}
  .cz-h{margin:0 0 4px;font-size:15.5px;font-weight:750;letter-spacing:-0.01em;color:#16211a}
  .cz-row{padding:12px 0;border-top:1px solid #e4ebe2}
  .cz-row:last-of-type{border-bottom:1px solid #e4ebe2}
  .cz-t{display:block;font-size:14.5px;font-weight:700;letter-spacing:-0.01em;line-height:1.3;color:#16211a;text-wrap:balance}
  .cz-d{display:block;margin-top:3px;font-size:12.5px;line-height:1.45;color:#8b968d}
  @media (max-width:900px){ .cz-grid{grid-template-columns:1fr;gap:34px} }

  /* ================= zastosowania (wiersze na liniach) =================
     Trzy kolumny: nazwa, co się dzieje, co z tego zostaje. Kolumna trzecia
     jest tu po to, żeby lista nie była katalogiem życzeń — przy każdej
     pozycji stoi rzecz sprawdzalna po wdrożeniu. */
  .za-row{display:grid;grid-template-columns:minmax(190px,0.62fr) minmax(0,1.25fr) minmax(180px,0.62fr);gap:clamp(16px,3vw,48px);align-items:start;padding:clamp(20px,2.4vw,28px) 0;border-top:1px solid #dde7db}
  .za-row:last-of-type{border-bottom:1px solid #dde7db}
  .za-t{margin:0;font-size:clamp(16.5px,1.9vw,19px);font-weight:750;letter-spacing:-0.016em;line-height:1.3;color:#16211a;text-wrap:balance}
  .za-d{margin:0;font-size:15px;line-height:1.6;color:#4c5850;text-wrap:pretty}
  .za-e{display:flex;align-items:flex-start;gap:9px;font-size:13.5px;line-height:1.5;color:#16211a;text-wrap:pretty}
  .za-e svg{flex-shrink:0;margin-top:3px}
  @media (max-width:1000px){
    .za-row{grid-template-columns:minmax(0,1fr) minmax(170px,0.6fr)}
    .za-row > :first-child{grid-column:1 / -1}
  }
  @media (max-width:680px){
    .za-row{grid-template-columns:1fr;gap:12px}
    .za-row > :first-child{grid-column:auto}
  }

  /* ================= jedna sprawa (ciemny pas) =================
     Dwie kolumny tej samej sprawy: dziś i po wdrożeniu. Świadomie bez
     paska postępu i bez wykresu — czyta się jak protokół, bo to jedyna
     forma, w której widać, że część kroków nie skraca się, tylko znika. */
  .sp{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(20px,3vw,44px);margin-top:clamp(28px,3.6vw,42px)}
  .sp-kol{background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.16);border-radius:16px;padding:20px 20px 18px}
  .sp-kol.po{background:rgba(0,205,119,0.09);border-color:rgba(0,205,119,0.34)}
  .sp-lbl{display:flex;align-items:baseline;justify-content:space-between;gap:12px;padding-bottom:12px;border-bottom:1px solid rgba(255,255,255,0.14)}
  .sp-lbl b{font-size:12.5px;font-weight:750;letter-spacing:0.02em;color:rgba(255,255,255,0.6)}
  .sp-kol.po .sp-lbl b{color:var(--la-accent,#00CD77)}
  .sp-lbl span{font-family:ui-monospace,Menlo,monospace;font-size:11px;color:rgba(255,255,255,0.35)}
  .sp-k{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px;align-items:baseline;padding:11px 0;border-top:1px solid rgba(255,255,255,0.09)}
  .sp-k:first-of-type{border-top:0;padding-top:14px}
  .sp-k em{font-style:normal;font-size:14px;line-height:1.45;color:rgba(255,255,255,0.86);text-wrap:pretty}
  .sp-k i{font-style:normal;font-family:ui-monospace,Menlo,monospace;font-size:12px;white-space:nowrap;color:rgba(255,255,255,0.42)}
  /* Krok, który po wdrożeniu przestaje istnieć, zostaje na liście przekreślony:
     inaczej nie widać, że różnica bierze się ze znikania, nie z przyspieszania. */
  .sp-k.znika em{color:rgba(255,255,255,0.34);text-decoration:line-through;text-decoration-color:rgba(255,255,255,0.3)}
  .sp-k.znika i{color:rgba(255,255,255,0.26)}
  .sp-suma{display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-top:14px;padding-top:14px;border-top:1px solid rgba(255,255,255,0.2)}
  .sp-suma b{font-size:13px;font-weight:700;color:rgba(255,255,255,0.6)}
  .sp-suma em{font-style:normal;font-size:clamp(20px,2.4vw,26px);font-weight:800;letter-spacing:-0.03em;color:#ffffff}
  .sp-kol.po .sp-suma em{color:var(--la-accent,#00CD77)}
  .sp-nota{margin:clamp(20px,2.6vw,30px) 0 0;max-width:760px;font-size:14.5px;line-height:1.6;color:rgba(255,255,255,0.62);text-wrap:pretty}
  .sp-nota strong{font-weight:700;color:#ffffff}
  @media (max-width:820px){ .sp{grid-template-columns:1fr;gap:18px} }

  /* ================= która usługa (routing) ================= */
  .ru-row{display:grid;grid-template-columns:minmax(200px,0.66fr) minmax(0,1.3fr) auto;gap:clamp(14px,2.6vw,40px);align-items:center;padding:clamp(18px,2.2vw,26px) 0;border-top:1px solid #e2e9e0;transition:background .18s}
  .ru-row:last-of-type{border-bottom:1px solid #e2e9e0}
  .ru-row:hover{background:#f7faf6}
  .ru-t{margin:0;font-size:clamp(17px,2vw,20.5px);font-weight:750;letter-spacing:-0.018em;line-height:1.25;color:#16211a;text-wrap:balance;transition:color .15s}
  .ru-row:hover .ru-t{color:#0a7a52}
  .ru-kiedy{display:block;margin-top:4px;font-size:12.5px;color:#8b968d}
  .ru-d{margin:0;font-size:14.5px;line-height:1.6;color:#4c5850;text-wrap:pretty}
  .ru-strz{flex-shrink:0;font-size:15px;font-weight:700;color:#0a7a52;white-space:nowrap}
  .ru-row [aria-hidden="true"]{display:inline-block;transition:transform .18s}
  .ru-row:hover [aria-hidden="true"]{transform:translateX(4px)}
  @media (max-width:900px){
    .ru-row{grid-template-columns:minmax(0,1fr) auto;gap:10px 16px}
    .ru-row > :nth-child(2){grid-column:1 / -1}
  }
  @media (prefers-reduced-motion:reduce){ .ru-row,.ru-t,.ru-row [aria-hidden="true"]{transition:none} }

  /* ================= kiedy nie warto (jeden moment asymetrii) ================= */
  .nw{margin:clamp(40px,5vw,64px) 0 0 clamp(0px,5vw,88px);padding-left:clamp(18px,2vw,26px);border-left:2px solid #dde7db;max-width:780px}
  .nw h3{margin:0;font-size:clamp(17px,2vw,20px);font-weight:750;letter-spacing:-0.015em;color:#16211a}
  .nw p{margin:12px 0 0;font-size:14.5px;line-height:1.65;color:#8b968d;text-wrap:pretty}

  @media (max-width:900px){
    .hero-split{grid-template-columns:1fr !important;gap:clamp(30px,5vw,46px) !important}
  }
</style>

<!-- ============ 1 · HERO ============
     Rachunek działu stoi obok nagłówka, bo cała strona jest o jednej rzeczy:
     ile ten dział kosztuje, zanim cokolwiek zmienimy. Liczby są przykładowe
     i tabelka mówi to pod spodem — inaczej podważałaby wszystko, co strona
     mówi o liczeniu. -->
<div aria-hidden="true" style="position:absolute;left:0;right:0;top:0;height:1020px;background:radial-gradient(880px 620px at 88% 2%, rgba(0,205,119,0.13), transparent 64%);pointer-events:none"></div>
<section style="position:relative;overflow:hidden;background:transparent;padding:clamp(28px,4vw,52px) max(clamp(20px,5vw,56px),calc((100% - 1440px) / 2)) clamp(52px,6vw,80px)">
<div class="hero-split" style="display:grid;grid-template-columns:1fr 0.92fr;gap:clamp(32px,4.5vw,68px);align-items:center;margin-top:clamp(10px,1.5vw,20px)">
<div>
<div class="eyebrow" style="margin-bottom:16px">Obszary · {d.dzial}</div>
<h1 style="margin:0;font-size:clamp(29px,4.3vw,50px);line-height:1.06;letter-spacing:-0.032em;font-weight:800;color:#16211a;text-wrap:balance">{d.naglowek}</h1>
<p style="margin:24px 0 0;max-width:600px;font-size:clamp(16px,2.1vw,19px);line-height:1.6;color:#33413a;text-wrap:pretty">{d.lead}</p>
<div class="hero-actions" style="display:flex;align-items:center;flex-wrap:wrap;gap:16px 22px;margin-top:32px">
<a href="#kontakt" class="btn-dark" style="display:inline-flex;align-items:center;gap:10px;background:#16211a;color:#ffffff;padding:18px 32px;border-radius:12px;font-weight:650;font-size:16.5px;box-shadow:0 14px 30px -14px rgba(16,33,26,0.45)">Policzmy Wasz rachunek <span aria-hidden="true">→</span></a>
<a href="#zastosowania" class="btn-ghost" style="display:inline-flex;align-items:center;gap:8px;font-size:16.5px;font-weight:700;color:#16211a;background:rgba(255,255,255,0.6);padding:18px 26px;border-radius:12px;border:1px solid rgba(22,33,26,0.16)">Co dokładnie robimy <span aria-hidden="true">→</span></a>
</div>
</div>

<div>
<div class="ra" role="img" aria-label={`Przykładowy rachunek działu: ${wiersze.map((w) => `${w.t} — ${w.ile} razy w miesiącu po ${w.min} minut`).join('; ')}. Razem około ${fmt(sumaGodz)} godzin miesięcznie.`}>
<div class="ra-gora"><b>{d.rachunek.naglowek}</b><span>miesiąc</span></div>
<div class="ra-glowa"><span>Czynność</span><i>razy</i><i>min</i><i>godzin</i></div>
{wiersze.map((w) => (
  <div class="ra-w">
    <span class="ra-t">{w.t}</span>
    <span class="ra-n">{w.ile.toLocaleString('pl-PL')}</span>
    <span class="ra-n">{w.min}</span>
    <span class="ra-g">{fmt(w.godz)}</span>
    <span class="ra-pas"><i style={`width:${Math.round((w.godz / maxGodz) * 100)}%`}></i></span>
  </div>
))}
<div class="ra-suma"><b>{d.rachunek.podsumowanie}</b><em>{fmt(sumaGodz)} h</em></div>
</div>
<p class="ra-nota">{d.rachunek.nota}</p>
</div>
</div>
</section>

<!-- ============ 2 · CZYM TO JEST ============
     Pierwsze zdanie jest definicją z podmiotem równym nazwie obszaru —
     po ten fragment sięgają modele językowe i wyróżnione odpowiedzi
     w wyszukiwarce. Nie rozbijać go na dwa zdania. -->
<section id="czym-jest" class="sec-pad" style="padding-top:clamp(44px,5.5vw,68px)">
<h2 class="h-sec" style="margin:0;max-width:860px;text-wrap:balance">{d.definicja.h2}</h2>
<div class="cz-grid">
<div>
<p class="cz-def" set:html={d.definicja.akapit}></p>
<p set:html={d.definicja.drugi}></p>
</div>
<div>
<h3 class="cz-h">{d.definicja.listaTytul}</h3>
{d.definicja.lista.map((p) => (
  <div class="cz-row"><span class="cz-t">{p.t}</span><span class="cz-d">{p.d}</span></div>
))}
</div>
</div>
</section>

<!-- ============ 3 · ZASTOSOWANIA ============
     To jest korpus tekstowy strony i główny powód, dla którego adres
     rankuje. Trzecia kolumna („co zostaje sprawdzalne") pilnuje, żeby
     lista nie osunęła się w katalog życzeń, jakim była na starym serwisie. -->
<section id="zastosowania" style="background:#f4f8f2;padding:clamp(60px,7.5vw,96px) max(clamp(20px,5vw,56px),calc((100% - 1440px) / 2));scroll-margin-top:16px">
<div class="sec-head">
<h2 class="h-sec" style="margin:0;max-width:660px;text-wrap:pretty">{d.zastosowania.h2}</h2>
<p class="sub" style="margin:0;max-width:420px">{d.zastosowania.lead}</p>
</div>
<div style="margin-top:clamp(28px,3.6vw,44px)">
{d.zastosowania.wiersze.map((z) => (
  <div class="za-row rv">
    <h3 class="za-t">{z.t}</h3>
    <p class="za-d">{z.d}</p>
    <span class="za-e"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#0a7a52" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg><span>{z.e}</span></span>
  </div>
))}
</div>
</section>

<!-- ============ 4 · JEDNA SPRAWA (ciemny pas) ============
     Ciemny pas pada raz i bierze najcięższy argument strony: jedną sprawę
     przechodzącą przez dział dziś i po wdrożeniu. Kroki, które znikają,
     zostają przekreślone — bez tego nie widać, skąd bierze się różnica. -->
<section id="sprawa" style="position:relative;background:radial-gradient(880px 420px at 88% 4%, rgba(0,205,119,0.16), transparent 62%), #0e2b1d;padding:clamp(60px,7.5vw,98px) max(clamp(20px,5vw,56px),calc((100% - 1440px) / 2));scroll-margin-top:16px">
<div class="eyebrow" style="color:rgba(255,255,255,0.5);margin-bottom:14px">{d.sprawa.eyebrow}</div>
<h2 class="h-sec" style="margin:0;max-width:700px;color:#ffffff;text-wrap:pretty">{d.sprawa.h2}</h2>
<p style="margin:18px 0 0;max-width:640px;font-size:17px;line-height:1.6;color:rgba(255,255,255,0.72);text-wrap:pretty">{d.sprawa.lead}</p>
<div class="sp">
<div class="sp-kol">
<div class="sp-lbl"><b>Dziś</b><span>{d.sprawa.sprawa}</span></div>
{d.sprawa.przed.map((k) => (
  <div class="sp-k"><em>{k.t}</em><i>{k.czas}</i></div>
))}
<div class="sp-suma"><b>{d.sprawa.miara}</b><em>{d.sprawa.sumaPrzed}</em></div>
</div>
<div class="sp-kol po">
<div class="sp-lbl"><b>Po wdrożeniu</b><span>{d.sprawa.sprawa}</span></div>
{d.sprawa.po.map((k) => (
  <div class={k.znika ? 'sp-k znika' : 'sp-k'}><em>{k.t}</em><i>{k.czas}</i></div>
))}
<div class="sp-suma"><b>{d.sprawa.miara}</b><em>{d.sprawa.sumaPo}</em></div>
</div>
</div>
<p class="sp-nota" set:html={d.sprawa.nota}></p>
</section>

<!-- ============ 5 · KTÓRA USŁUGA ============
     Puenta strony. Obszar jest pytaniem klienta, usługa odpowiedzią —
     i to tu strona przekazuje ruch dalej, do właściwej podstrony. -->
<section id="ktora-usluga" class="sec-pad">
<div class="sec-head">
<h2 class="h-sec" style="margin:0;max-width:620px;text-wrap:pretty">{d.routing.h2}</h2>
<p class="sub" style="margin:0;max-width:420px">{d.routing.lead}</p>
</div>
<div style="margin-top:clamp(26px,3.2vw,40px)">
{d.routing.wiersze.map((r) => (
  <a href={r.h} class="ru-row">
    <div><h3 class="ru-t">{r.t}</h3><span class="ru-kiedy">{r.kiedy}</span></div>
    <p class="ru-d">{r.d}</p>
    <span class="ru-strz">Zobacz <span aria-hidden="true">→</span></span>
  </a>
))}
</div>

<div class="nw">
<h3>{d.granica.h3}</h3>
{d.granica.punkty.map((p) => <p>{p}</p>)}
</div>
</section>

<GcCta
  heading={d.cta.heading}
  lead={d.cta.lead}
  eyebrow="Z bezpłatnej diagnozy wychodzicie z"
  items={d.cta.items}
  submitLabel="Umów diagnozę"
  fieldLabel={d.cta.fieldLabel}
  placeholder={d.cta.placeholder}
  badges={[
    { i: 'klodka', t: 'Wasze dane zostają u Was' },
    { i: 'kartka', t: 'NDA przed startem' },
    { i: 'ptaszek', t: 'Bez prowizji od dostawców' },
  ]}
/>

<GcFaq heading={d.faqTytul} lead={d.faqLead} items={d.faq} />

</LaBase>
