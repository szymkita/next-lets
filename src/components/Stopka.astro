---
// STOPKA — jedna dla całego serwisu (pas WiseGroup + właściwa stopka).
//
// DLACZEGO KOMPONENT
// Do 07.09.2026 stopka istniała w trzech kopiach: w index.astro, w layoucie
// LaBase.astro i w darmowa-konsultacja.astro. Rozjechały się — inne kolumny,
// inne linki, odznaka OpenAI tylko na stronie głównej. Teraz jest jedno
// źródło: zmiana tutaj wchodzi na każdą stronę.
//
// LINKI SĄ BEZWZGLĘDNE
// Stopka renderuje się na dowolnym adresie, więc kotwice muszą prowadzić do
// strony głównej („/#oferta"), nie do bieżącej („#oferta"). To był główny
// błąd starej wersji z index.astro: na podstronach te linki nie działały.
//
// PAS GRUPY
// Odwzorowanie bloku znad stopki z sellwise.pl: sześć marek w równych
// komórkach z separatorami, logotypy szare, kolor pod kursorem. Logotypy
// leżą lokalnie w public/uploads/wisegroup — nie linkujemy do plików na
// cudzym serwerze. Nasza marka nie jest linkiem i zostaje w kolorze, tak jak
// w panelu marek w TopbarWiseGroup.astro.
const GRUPA = [
  { nazwa: 'AdWise',         url: 'https://adwise.pl',       logo: '/uploads/wisegroup/wg-adwise.svg' },
  { nazwa: 'HireWise',       url: 'https://hirewise.pl',     logo: '/uploads/wisegroup/wg-hirewise.svg' },
  { nazwa: 'SellWise',       url: 'https://www.sellwise.pl', logo: '/uploads/wisegroup/wg-sellwise.svg' },
  { nazwa: "Let's automate", url: null,                      logo: '/uploads/logo-2.svg' },
  { nazwa: 'Finerto',        url: 'https://finerto.pl',      logo: '/uploads/wisegroup/wg-finerto.svg' },
  { nazwa: 'IRSM',           url: 'https://irsm.pl',         logo: '/uploads/wisegroup/wg-irsm.svg' },
];

// CIEMNA STOPKA = wariant G z /stopka-v2 (decyzja Szymona, 16.10.2026:
// „podmień najnowszą wersję na wszystkich stronach"). Jej kod i dane żyją
// w src/components/stopka-v2/ (StopkaG.astro, dane.ts) — to teraz źródło
// żywej stopki, nie tylko wariant do porównania. Biały pas grupy nad nią
// zostaje tutaj bez zmian (stopką jest tylko ciemna część).
import StopkaG from './stopka-v2/StopkaG.astro';
---

<section id="grupa" class="wg-sekcja">
<div style="text-align:center">
<img src="/uploads/wisegroup_logo_v2.webp" alt="WiseGroup" width="442" height="52" loading="lazy" decoding="async" style="display:block;margin:0 auto;height:26px;width:auto">
<p style="margin:14px 0 0;font-size:15.5px;line-height:1.6;color:#637066">Łączymy siły dla mądrego wzrostu</p>
</div>
<div class="wg-pas">
{GRUPA.map((m) => (
  m.url
    ? <a class="wg-cell" href={m.url} target="_blank" rel="noopener"><img src={m.logo} alt={m.nazwa} loading="lazy" decoding="async" /></a>
    : <span class="wg-cell wg-tu" aria-current="true"><img src={m.logo} alt={m.nazwa} loading="lazy" decoding="async" /></span>
))}
</div>
</section>

<StopkaG />

<style>
  /* Strony trzymają własny reset `a{text-decoration:none}` w scope'owanym
     <style>, a ten do komponentu nie dociera — bez tej linijki linki wychodzą
     podkreślone (widoczne na stronie głównej po wydzieleniu komponentu). */
  a{color:inherit;text-decoration:none}
  /* Komponent stoi w stronach, które mają własne `*{box-sizing:border-box}`
     w scope'owanym <style>, a to do niego nie dociera — stąd własna linijka. */
  .wg-sekcja,.wg-sekcja *{box-sizing:border-box}

  .wg-sekcja{background:#ffffff;padding:clamp(56px,7vw,88px) max(clamp(20px,5vw,56px),calc((100% - 1440px) / 2))}

  /* Sześć marek w równych komórkach. Logotypy stoją szare i wygaszone do 55% —
     kolor wraca dopiero pod kursorem, żeby pas nie konkurował z treścią wyżej.
     Nasza marka jest wyjątkiem: zawsze w kolorze i bez linku, bo prowadziłby
     na stronę, na której użytkownik już jest. */
  .wg-pas{display:grid;grid-template-columns:repeat(6,1fr);margin-top:clamp(26px,3.2vw,38px);border:1px solid #eef1ec;border-radius:16px;overflow:hidden;background:#ffffff}
  .wg-cell{display:flex;align-items:center;justify-content:center;padding:26px 14px;border-left:1px solid #eef1ec;transition:background .2s}
  .wg-cell:first-child{border-left:0}
  .wg-cell img{width:auto;height:auto;max-height:20px;max-width:100%;display:block;filter:grayscale(1);opacity:.55;transition:filter .25s,opacity .25s}
  a.wg-cell:hover{background:#f9fbf8}
  a.wg-cell:hover img{filter:none;opacity:1}
  .wg-cell.wg-tu img{filter:none;opacity:1}

  @media (max-width:900px){
    .wg-pas{grid-template-columns:repeat(3,1fr)}
    .wg-cell{border-left:1px solid #eef1ec}
    .wg-cell:nth-child(3n+1){border-left:0}
    .wg-cell:nth-child(n+4){border-top:1px solid #eef1ec}
  }
  @media (max-width:560px){
    .wg-pas{grid-template-columns:repeat(2,1fr)}
    .wg-cell{padding:22px 12px;border-left:1px solid #eef1ec}
    .wg-cell:nth-child(odd){border-left:0}
    .wg-cell:nth-child(n+3){border-top:1px solid #eef1ec}
  }
</style>
