---
// NAWIGACJA — jedna dla całego serwisu (pasek Wise Group + pigułka z menu).
//
// DLACZEGO KOMPONENT
// Do 07.09.2026 nagłówek istniał w trzech kopiach: pełny na stronie głównej,
// okrojony w LaBase.astro (bez paska grupy i bez rotującego CTA) i trzeci
// w darmowa-konsultacja.astro. Podstrony pokazywały więc inną nawigację niż
// strona główna. Teraz wszędzie jest ta ze strony głównej — z megamenu,
// paskiem Wise Group i pełną listą usług.
//
// KOTWICE SĄ BEZWZGLĘDNE
// Nagłówek renderuje się pod każdym adresem, więc „#oferta" musiało zmienić
// się w „/#oferta". Inaczej na podstronie link szukałby sekcji, której tam
// nie ma, i nie robił nic.
//
// CTA
// Adres bierze się z propsa: strona główna zjeżdża do własnego formularza
// (/#diagnoza), a podstrona z własnym formularzem podaje swoją kotwicę,
// np. <Nawigacja ctaHref="#rozmowa" />. Napis rotuje tak samo wszędzie.
//
// JEDNA LISTA LINKÓW, DWA MENU
// Poniższe stałe zasilają i megamenu (od 901px), i panel mobilny (do 900px).
// Wcześniej menu istniało tylko w wersji na myszkę, a poniżej 900px znikało
// bez zamiennika — z telefonu nie dało się wejść na żadną podstronę. Panel
// bierze te same dane, więc dopisanie usługi wchodzi od razu w obie wersje.
import TopbarWiseGroup from './TopbarWiseGroup.astro';

const { ctaHref = '/#diagnoza' } = Astro.props;

// Triaż po sytuacji klienta: trzy pasy, w każdym trzy usługi.
// `krok` przełącza warstwę w sekcji #oferta na stronie głównej (index.astro).
const USLUGI = [
  {
    pas: 'Wdrażamy AI', href: '/#oferta', krok: 'wdrazamy',
    sub: 'Gdy AI jeszcze nie weszło w procesy',
    poz: [
      { t: 'Strategia transformacji AI', d: 'Plan wdrożenia z policzonym zwrotem', h: '/strategia-ai' },
      { t: 'Indywidualne rozwiązania AI', d: 'AI wpięte w Wasze systemy i dane', h: '/rozwiazania-ai' },
      { t: 'Szkolenia i adopcja AI', d: 'Zespół używa AI w codziennej pracy', h: '/szkolenia-ai' },
    ],
  },
  {
    pas: 'Budujemy aplikacje', href: '/#oferta', krok: 'budujemy',
    sub: 'Gdy żadne gotowe narzędzie nie pasuje',
    poz: [
      { t: 'Systemy dla kluczowych procesów', d: 'Aplikacja pod Wasz sposób pracy', h: '/systemy-procesowe' },
      { t: 'Systemy dla Waszych klientów', d: 'Portal klienta, platforma B2B, samoobsługa', h: '/systemy-dla-klientow' },
      { t: 'Automatyzacje i integracje', d: 'Przepływ danych między systemami', h: '/automatyzacje-integracje' },
    ],
  },
  {
    pas: 'Guided Coding', href: '/guided-coding', krok: null,
    sub: 'Gdy sami budujecie aplikacje z AI',
    poz: [
      { t: 'Dla zespołów nietechnicznych', d: 'Budujecie bez działu IT, my pilnujemy', h: '/guided-coding/bez-dzialu-it' },
      { t: 'Dla zespołów technicznych', d: 'Dział IT dowozi szybciej i bezpieczniej', h: '/guided-coding/dla-zespolow' },
      { t: 'Szkolenia i transfer know-how', d: 'Program szkoleniowy pod Waszą aplikację', h: '/guided-coding/transfer-know-how' },
    ],
  },
];

// PRODUKTY — gotowe aplikacje, które piszemy i utrzymujemy sami.
// Do 09.09.2026 w belce stała jedna pozycja „Appto ↗" prowadząca poza serwis.
// Produktów jest już dwa i mają własne podstrony, więc dostały zakładkę,
// a wyjście na appto.ai zeszło do treści strony.
const PRODUKTY = [
  { t: 'Appto', d: 'Agenci AI dla całej firmy', h: '/produkty/appto', znak: 'appto' },
  { t: 'Wingman', d: 'Nagrywanie rozmów, ofertowanie i ocena jakości', h: '/produkty#wingman', znak: 'wingman' },
];

// Ikony trzymamy jako ścieżki, nie jako gotowe <svg> — ten sam rysunek idzie
// do megamenu i do panelu mobilnego.
const KNOWHOW = [
  { t: 'WiseStack', d: 'Framework i stack transformacji', h: '/wisestack',
    sciezki: ['M12 3 3.2 7.7 12 12.4l8.8-4.7z', 'M3.2 13 12 17.7l8.8-4.7'] },
  { t: 'AI Adoption Framework', d: 'Od pierwszego kroku do firmy napędzanej AI', h: '/#dlaczego-my',
    sciezki: ['M3.2 20.3h5.2v-5.2h5.2v-5.2h5.2V4.7', 'M16.9 6.6 18.8 4.7l1.9 1.9'] },
  { t: 'Wise AI Score', d: 'Test dojrzałości AI w 3 minuty', h: '/#diagnoza',
    sciezki: ['M3.8 18.3a8.2 8.2 0 1 1 16.4 0', 'M12 18.3 16.1 12.6'], kropka: { cx: 12, cy: 18.3, r: 1.15 } },
  { t: 'Baza wiedzy', d: 'Artykuły i analizy', h: '/baza-wiedzy',
    sciezki: ['M12 7c-1.5-1.4-3.4-2.1-5.7-2.1H4v12.6h2.3c2.3 0 4.2.7 5.7 2.1', 'M12 7c1.5-1.4 3.4-2.1 5.7-2.1H20v12.6h-2.3c-2.3 0-4.2.7-5.7 2.1', 'M12 7v12.6'] },
];

const POZOSTALE = [
  { t: 'Inspiracje', h: '/inspiracje' },
  { t: 'Dlaczego my', h: '/dlaczego-my' },
];
---

<TopbarWiseGroup current="letsautomate" />

<header class="site-header">
<div class="nav-pill">
<a href="/" class="nav-logo" aria-label="Let's automate — strona główna">
<img src="/uploads/logo-2.svg" alt="Let's automate" width="165" height="26" style="height:26px;width:auto;display:block">
</a>
<div class="nav-menu" style="display:flex;align-items:center;gap:clamp(2px,0.6vw,8px);font-size:15px;font-weight:550;color:#2c3a30">
<div class="nav-item">
<a href="/#oferta" class="nav-lnk" style="display:inline-flex;align-items:center;gap:5px;color:#2c3a30">Usługi <svg class="nav-caret" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></a>
<div class="mega-wrap">
<div class="mega-panel" style="background:#ffffff;border:1px solid #e7ece4;border-radius:20px;box-shadow:0 40px 90px -44px rgba(18,38,28,0.45);padding:22px">
<div class="usl-grid">
{USLUGI.map((u) => (
<div class="usl-lane">
<div class="usl-top"><a href={u.href} data-krok-link={u.krok} class="usl-head">{u.pas}</a><span class="usl-sub">{u.sub}</span></div>
<span class="usl-rule" aria-hidden="true"></span>
<div class="usl-list">
{u.poz.map((p) => <a href={p.h} class="mega-item"><span class="mega-t">{p.t}</span><span class="mega-d">{p.d}</span></a>)}
</div>
</div>
))}
</div>
</div>
</div>
</div>
