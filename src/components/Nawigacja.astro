{POKAZ.produkty && PRODUKTY_LISTA && (
<div class="nav-item" style="position:relative">
<a href="/produkty" class="nav-lnk" style="display:inline-flex;align-items:center;gap:5px;color:#2c3a30">Produkty <svg class="nav-caret" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></a>
<div class="mega-wrap pd-wrap">
<div class="mega-panel pd-panel">
{PRODUKTY.map((p) => (
<a href={p.h} class="mega-item pd-item">
<span class="pd-ic">
{p.znak === 'appto'
  ? <svg viewBox="0 0 103.24 79.25" width="19" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><path d="M54.537,65.167L54.537,79.253L0,65.167L0,0L54.537,14.134L54.537,0L87.005,14.148L87.005,0L103.239,14.148L103.239,79.253L87.005,65.167L87.005,79.253L54.537,65.167Z"/></svg>
  : <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.5v11"/><path d="M8.2 7.2v4.6M15.8 7.2v4.6M4.8 9v1.4M19.2 9v1.4"/><path d="M5.5 16.4a8.6 8.6 0 0 0 13 0"/></svg>}
</span>
<span class="pd-txt"><span class="mega-t">{p.t}</span><span class="mega-d">{p.d}</span></span>
</a>
))}
<a href="/produkty" class="pd-stopka">Wszystkie produkty <span aria-hidden="true">→</span></a>
</div>
</div>
</div>
)}
{POKAZ.knowhow && (
<div class="nav-item" style="position:relative">
