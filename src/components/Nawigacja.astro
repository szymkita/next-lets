  /* ---- megamenu usług: triaż po sytuacji klienta ---- */
  .usl-grid{display:grid;grid-template-columns:1fr 1fr 1fr;grid-template-rows:auto auto auto;gap:0 6px}
  .usl-lane{display:grid;grid-template-rows:subgrid;grid-row:span 3;padding:15px 14px 11px;border-radius:14px;transition:background .2s}
  .usl-top{align-self:start}
  .usl-head{display:block;font-size:24px;font-weight:800;line-height:1.06;letter-spacing:-0.032em;text-wrap:balance;color:#16211a;transition:color .18s}
  .usl-head:hover{color:#0a7a52}
  .usl-sub{display:block;margin-top:9px;font-size:12.5px;line-height:1.45;color:#8b968d}
  .usl-rule{display:block;width:26px;height:2px;margin:16px 0 15px;border-radius:2px;background:var(--la-accent,#00CD77);transition:width .28s cubic-bezier(.4,0,.2,1)}
  .usl-lane:hover .usl-rule{width:78px}
  .usl-list .mega-item{padding:7px 9px;margin-left:-9px;border-radius:10px}
  .usl-list .mega-item:hover{background:#eef5ec}
  .usl-list .mega-t{font-size:14px;font-weight:650}
  .usl-list .mega-d{font-size:12px;color:#96a098}
  @media (prefers-reduced-motion:reduce){ .usl-rule{transition:none} }

  /* ---- hamburger + panel mobilny ----
     Do 900px megamenu i pasek linków znikają (najazd myszą na dotyku nie
     istnieje), a ich miejsce zajmuje przycisk otwierający panel. */
  .nav-right{display:flex;align-items:center;gap:10px}
  .nav-burger{display:none;align-items:center;justify-content:center;width:44px;height:44px;padding:0;border:1px solid #e0e7dd;border-radius:12px;background:#ffffff;color:#16211a;cursor:pointer}
  .nav-burger:focus-visible{outline:2px solid var(--la-accent,#00CD77);outline-offset:3px}
  .nb-kreski{display:flex;flex-direction:column;justify-content:center;gap:4px;width:18px}
  .nb-kreski span{display:block;height:2px;border-radius:2px;background:currentColor}

  .nav-panel{position:fixed;inset:0;z-index:90;display:none;flex-direction:column;background:#ffffff;
    overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;
    opacity:0;transform:translateY(-6px);transition:opacity .2s ease,transform .2s ease}
  .nav-panel.widoczny{display:flex}
  .nav-panel.otwarty{opacity:1;transform:none}
  .np-pasek{position:sticky;top:0;z-index:2;display:flex;align-items:center;justify-content:space-between;gap:16px;
    padding:14px 16px;background:#ffffff;border-bottom:1px solid #eef1ec}
  .np-zamknij{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;padding:0;
    border:1px solid #e0e7dd;border-radius:12px;background:#ffffff;color:#16211a;cursor:pointer}
  .np-zamknij:focus-visible{outline:2px solid var(--la-accent,#00CD77);outline-offset:3px}
  .np-tresc{padding:8px 16px 40px}
  .np-grupa{display:block;padding:20px 0;border-bottom:1px solid #eef1ec}
  .np-glowa{display:block;font-size:23px;font-weight:800;line-height:1.1;letter-spacing:-0.03em;color:#16211a}
  .np-sub{display:block;margin-top:5px;font-size:13px;line-height:1.45;color:#8b968d}
  .np-poz{display:block;margin-top:4px;padding:11px 12px 11px 0;border-radius:11px}
  .np-poz:first-of-type{margin-top:12px}
  .np-poz-ic{display:flex;align-items:center;gap:12px}
  .np-t{display:block;font-size:15.5px;font-weight:650;color:#16211a}
  .np-d{display:block;margin-top:2px;font-size:12.5px;line-height:1.4;color:#8b968d}
  .np-glowa-txt{color:#16211a}
  .np-reszta{display:flex;flex-direction:column;padding:12px 0 4px}
  .np-lnk{padding:13px 0;font-size:16px;font-weight:600;color:#2c3a30}
  .np-cta{display:flex;align-items:center;justify-content:center;margin-top:14px;padding:16px 20px;border-radius:12px;
    background:#16211a;color:#ffffff;font-size:15.5px;font-weight:700}
  .np-kontakt{display:flex;flex-wrap:wrap;gap:8px 20px;margin-top:20px;font-size:14px;color:#4c5850}
  .np-kontakt a{color:#0a7a52;font-weight:600;padding:6px 0}
  /* Tło nie przewija się pod otwartym panelem. `overflow:hidden` na body
     zerowało pozycję przewijania (po zamknięciu menu strona skakała na
     górę), więc blokujemy przez position:fixed i wracamy na to samo
     miejsce przy zamknięciu. */
  body.nav-otwarte{position:fixed;left:0;right:0;width:100%;overflow:hidden}

  @media (max-width:900px){
    .mega-wrap{display:none !important}
    .nav-menu{display:none !important}
    .nav-burger{display:inline-flex}
  }
  /* Na wąskim ekranie pigułka nie mieści logo, rotującego CTA i przycisku
     naraz (przy 390px wychodziła 8px poza kadr) — CTA gubi wtedy animację
     pisania i zostaje krótkim napisem. */
  @media (max-width:560px){
    .nav-pill{gap:10px;padding:12px 10px 12px 6px}
    #navCta{padding:11px 15px !important;font-size:14px !important}
    .nav-cta-sizer{display:none}
    .nav-cta-live{position:static}
    .nav-cta-caret{display:none}
    .nav-logo img{height:22px !important}
  }
  @media (prefers-reduced-motion:reduce){ .nav-panel{transition:none} }
</style>

<script is:inline>
  // Skrypty nawigacji siedzą przy niej, a nie w stronach — inaczej każda
  // strona musiałaby pamiętać o własnej kopii. Bezpiecznik `dataset.navInit`
  // chroni przed podwójnym podpięciem, gdyby strona miała jeszcze starą kopię.
  (function(){
    var h = document.querySelector('.site-header');
    if(!h || h.dataset.navInit) return;
    h.dataset.navInit = '1';

    // ---- pigułka: zwężenie i tło po scrollu ----
    function upd(){ h.classList.toggle('scrolled', window.scrollY > 65); }
    upd();
    window.addEventListener('scroll', upd, {passive:true});

    // ---- panel mobilny ----
    (function(){
      var burger = document.getElementById('navBurger');
      var panel = document.getElementById('navPanel');
      if(!burger || !panel) return;
      var zamkniecie = document.getElementById('navClose');
      var wrocDo = null;
      var pozycja = 0;

      function otworz(){
        wrocDo = document.activeElement;
        pozycja = window.scrollY || window.pageYOffset || 0;
        panel.classList.add('widoczny');
        panel.setAttribute('aria-hidden', 'false');
        burger.setAttribute('aria-expanded', 'true');
        document.body.style.top = (-pozycja) + 'px';
        document.body.classList.add('nav-otwarte');
        // setTimeout, nie requestAnimationFrame: w karcie w tle rAF bywa
        // wstrzymany i panel zostawał przezroczysty, ale klikalny.
        window.setTimeout(function(){ panel.classList.add('otwarty'); }, 20);
        if(zamkniecie) zamkniecie.focus();
      }
      function zamknij(oddajFokus){
        panel.classList.remove('otwarty');
        panel.setAttribute('aria-hidden', 'true');
        burger.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('nav-otwarte');
        document.body.style.top = '';
        window.scrollTo(0, pozycja);
        // Klasę `widoczny` zdejmujemy po animacji — inaczej panel znikałby
        // skokowo, zanim zdąży się wygasić.
        window.setTimeout(function(){
          if(!panel.classList.contains('otwarty')) panel.classList.remove('widoczny');
        }, 220);
        if(oddajFokus && wrocDo && wrocDo.focus) wrocDo.focus();
      }

      burger.addEventListener('click', otworz);
      if(zamkniecie) zamkniecie.addEventListener('click', function(){ zamknij(true); });
      // Kotwica na tej samej stronie nie przeładowuje dokumentu, więc panel
      // musi zejść sam — inaczej przykrywałby sekcję, do której zjechał.
      panel.addEventListener('click', function(e){
        if(e.target.closest('a')) zamknij(false);
      });
      document.addEventListener('keydown', function(e){
        if(!panel.classList.contains('otwarty')) return;
        if(e.key === 'Escape'){ zamknij(true); return; }
        // Tabulator krąży wewnątrz panelu — bez tego fokus schodził na stronę
        // pod spodem, której nie widać.
        if(e.key !== 'Tab') return;
        var ogniska = panel.querySelectorAll('a[href], button');
        if(!ogniska.length) return;
        var pierwszy = ogniska[0], ostatni = ogniska[ogniska.length - 1];
        if(e.shiftKey && document.activeElement === pierwszy){ e.preventDefault(); ostatni.focus(); }
        else if(!e.shiftKey && document.activeElement === ostatni){ e.preventDefault(); pierwszy.focus(); }
        else if(!panel.contains(document.activeElement)){ e.preventDefault(); pierwszy.focus(); }
      });
      // Obrót telefonu albo powiększenie okna ponad 900px chowa hamburgera —
      // otwarty panel zostałby wtedy zawieszony nad stroną bez wyjścia.
      window.addEventListener('resize', function(){
        if(window.innerWidth > 900 && panel.classList.contains('otwarty')) zamknij(false);
      });
    })();

    // ---- CTA: rotujący typing ----
    var el = h.querySelector('[data-cta-rotate]');
    if(!el) return;
    var phrases = ['Bezpłatna diagnoza', 'Wyceń projekt', 'Umów rozmowę'];
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion:reduce)').matches;
    var i = 0;
    // Na wąskim ekranie pigułka nie ma miejsca na najdłuższą frazę, a napis
    // przycinał się w połowie animacji. Zostaje jedno krótkie słowo.
    if(window.matchMedia && window.matchMedia('(max-width:560px)').matches){
      el.textContent = 'Diagnoza';
      return;
    }
    if(reduce){
      el.textContent = phrases[0];
      setInterval(function(){ i = (i + 1) % phrases.length; el.textContent = phrases[i]; }, 3200);
      return;
    }
    var ci = 0, deleting = false;
    function tick(){
      var full = phrases[i];
      if(!deleting){
        ci++;
        el.textContent = full.slice(0, ci);
        if(ci >= full.length){ deleting = true; return setTimeout(tick, 1800); }
        return setTimeout(tick, 60 + Math.random() * 45);
      }
      ci--;
      el.textContent = full.slice(0, ci);
      if(ci <= 0){ deleting = false; i = (i + 1) % phrases.length; return setTimeout(tick, 300); }
      return setTimeout(tick, 32);
    }
    el.textContent = '';
    setTimeout(tick, 800);
  })();
</script>
