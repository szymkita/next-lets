<div class="mega-panel kh-panel">
{KNOWHOW.map((k) => (
<a href={k.h} class="mega-item kh-item">
<span class="kh-ic"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{k.sciezki.map((d) => <path d={d}/>)}{k.kropka && <circle cx={k.kropka.cx} cy={k.kropka.cy} r={k.kropka.r} fill="currentColor" stroke="none"/>}</svg></span>
