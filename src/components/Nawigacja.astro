  .pd-item:hover .pd-ic{transform:translateY(-1px)}
  .pd-txt{min-width:0}
  .pd-stopka{display:flex;align-items:center;gap:8px;margin:8px 0 0;padding:12px;border-top:1px solid #eef1ec;font-size:13.5px;font-weight:700;color:#0a7a52}
