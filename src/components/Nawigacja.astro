---
// NAWIGACJA — jedna dla całego serwisu (pasek Wise Group + pigułka z menu).
//
// DLACZEGO KOMPONENT
// Do 07.09.2026 nagłówek istniał w trzech kopiach: pełny na stronie głównej,
// okrojony w LaBase.astro (bez paska grupy i bez rotującego CTA) i trzeci
// w darmowa-konsultacja.astro. Podstrony pokazywały więc inną nawigację niż
// strona główna. Teraz wszędzie jest ta ze strony głównej — z megamenu,
// paskiem Wise Group i pełną listą usług.
//
// KOTWICE SĄ BEZWZGLĘDNE
// Nagłówek renderuje się pod każdym adresem, więc „#oferta" musiało zmienić
// się w „/#oferta". Inaczej na podstronie link szukałby sekcji, której tam
// nie ma, i nie robił nic.
//
// CTA
// Na każdej stronie prowadzi na /darmowa-konsultacja (decyzja Szymona
// z 16.10.2026). Prop ctaHref podaje tylko sama strona konsultacji, która
// zjeżdża do własnego formularza (#formularz). Napis rotuje tak samo wszędzie
// (maszynopis: Bezpłatna diagnoza / Wyceń projekt / Umów rozmowę). Zdjęty
// w przeglądzie 22.09.2026, przywrócony 11.10.2026. Czytnik ekranu dostaje
// stałą nazwę z aria-label, a do 560px zostaje krótkie „Diagnoza”.
//
// JEDNA LISTA LINKÓW, DWA MENU
// Poniższe stałe zasilają i megamenu (od 901px), i panel mobilny (do 900px).
// Wcześniej menu istniało tylko w wersji na myszkę, a poniżej 900px znikało
// bez zamiennika — z telefonu nie dało się wejść na żadną podstronę. Panel
// bierze te same dane, więc dopisanie usługi wchodzi od razu w obie wersje.
import TopbarWiseGroup from './TopbarWiseGroup.astro';
import { POKAZ } from '../data/menu.js';

// topbar={false} chowa pasek Wise Group (docelowo zostaje tylko na
// stronie głównej; podstrony wyłączają go pojedynczo).
const { ctaHref = '/darmowa-konsultacja', topbar = true } = Astro.props;

// Triaż po sytuacji klienta: trzy pasy, w każdym trzy usługi.
// 25.10.2026 (Szymon: megamenu „mniej miejsca, sensowniejsze, lepsze opisy
// i grafiki”): opis każdej usługi w jednym wierszu mówi, czym ona jest.
// Nazwy pasów nie są linkami (21.10.2026, Szymon: huby usług na produkcji
// „nieklikalne”, dopracujemy je później). Wcześniej dwa prowadziły na
// /#oferta, a trzeci na hub /guided-coding. Huby czekają w src/robocze/
// (/wdrazamy-ai, /budujemy-za-was, /guided-coding-v2); przy publikacji pas
// dostaje z powrotem `href` (docs/huby-koncepcja.md §9).
const USLUGI = [
  {
    // Pas 1: nikt nie buduje oprogramowania — plan, gotowe narzędzie, ludzie.
    // Nazwa produktu stoi w opisie, nie w tytule — klient, który nie zna Appto,
    // ma od razu wiedzieć, co dostaje. AI wbudowane w proces stoi w pasie 2.
    pas: 'Wdrażamy AI',
    sub: 'Gdy firma zaczyna pracować z AI',
    poz: [
      { t: 'Strategia AI', d: 'Plan wdrożeń AI z rachunkiem dla zarządu', h: '/strategia-ai' },
      { t: 'Narzędzia AI dla całej firmy', d: 'Platforma AI, np. Appto, na danych firmy', h: '/wdrozenie-ai' },
      { t: 'Szkolenia z AI', d: 'Program, po którym zespół pracuje z AI', h: '/szkolenia-ai' },
    ],
  },
  {
    // Pas 2: budujemy my, pod proces klienta.
    pas: 'Budujemy za Was',
    sub: 'Gdy gotowe programy nie pasują',
    poz: [
      { t: 'Systemy dopasowane do firmy', d: 'System zbudowany pod Wasz kluczowy proces', h: '/systemy-procesowe' },
      { t: 'Automatyzacja procesów z AI', d: 'AI prowadzi sprawy, ludzie biorą wyjątki', h: '/rozwiazania-ai' },
      { t: 'Integracje systemów', d: 'CRM, ERP i magazyn wymieniają dane same', h: '/automatyzacje-integracje' },
    ],
  },
  {
    // Pas 3: buduje zespół klienta. Pozycje to formy zakupu, nie typy zespołów —
    // typ zespołu (z działem IT / bez) klient wybiera na stronie.
    pas: 'Budujecie sami z AI',
    sub: 'Gdy Wasz zespół tworzy własne aplikacje',
    poz: [
      { t: 'Audyt aplikacji', d: 'Przegląd aplikacji z listą poprawek po kolei', h: '/guided-coding/audyt-aplikacji' },
      { t: 'Bieżące wsparcie', d: 'Abonament: przeglądy zmian i pomoc na co dzień', h: '/guided-coding/biezace-wsparcie' },
      { t: 'Warsztaty dla zespołu', d: 'Cykl sesji z zespołem na Waszym kodzie', h: '/guided-coding/transfer-know-how' },
    ],
  },
];

// PROGRAMY — Let’s Up (mikro- i małe firmy, którym przybywa pracy) i Let’s
// Shift (małe, średnie i duże firmy z wypracowanym sposobem działania).
// Łączą kompetencje z trzech pasów, więc stoją pod nimi, w jednym niskim
// rzędzie dwóch kart (25.10.2026, Szymon: „musi zajmować mniej miejsca
// i być sensowniejsze, lepsze opisy, lepsze grafiki”). Karta: mała grafika
// na ciemnym kaflu, nazwa z grupą docelową, jedno zdanie-obietnica i jedno
// zdanie, czym program jest. Bez nagłówka nad kartami: to, że to programy,
// mówi podpis „program dla…” w każdej karcie (Szymon 26.10.2026: nagłówek
// „Programy · ścieżki zmian…” nie był najlepszy, „może w ogóle bez
// nagłówka”). Drugie zdanie mówi o efekcie tak wprost jak przy Let’s Up
// (Szymon: „Więcej zleceń tym samym zespołem — oczywiste, a tutaj nie”).
// Grafiki w ruchu (zob. UP_SLUPKI i SH_OKNA niżej):
//   · Let’s Up — zlecenia rosną, zespół ten sam;
//   · Let’s Shift — stare narzędzia wpadają do jednego systemu (hero
//     /lets-shift).
// Widoczność: POKAZ.letsUp i POKAZ.letsShift (od 26.10.2026 włączone,
// strony opublikowane pod /lets-up i /lets-shift).
const LETS_UP = {
  t: 'Let’s Up',
  pod: 'program dla mikro- i małych firm',
  tytul: 'Firma rośnie szybciej niż zespół',
  d: 'Więcej zleceń tym samym zespołem',
  dzis: '6 h 24',
  po: '2 h 34',
  poProc: 40,
  h: '/lets-up',
};
const LETS_SHIFT = {
  t: 'Let’s Shift',
  pod: 'program dla małych, średnich i dużych firm',
  tytul: 'Firma przechodzi do czasów AI',
  d: 'Nowe systemy i agenci AI w całej firmie',
  h: '/lets-shift',
};
// Kafel Let’s Up: zlecenia w kolejnych miesiącach (słupki rosną) nad tym
// samym zespołem (trzy twarze). Kafel Let’s Shift: cztery okienka starych
// narzędzi wlatują do jednego okna systemu, a ono się wypełnia i dostaje
// ptaszek. Animacje ruszają przy każdym otwarciu menu.
const UP_SLUPKI = [28, 36, 45, 55, 67, 82, 100];
const UP_ZESPOL = ['marta', 'jakub', 'kasia'];
const SH_OKNA = [
  { k: 'xl', x: 8, y: 9, r: -8 }, { k: 'ol', x: 27, y: 5, r: 6 },
  { k: 'er', x: 10, y: 37, r: 5 }, { k: 'pa', x: 31, y: 43, r: -7 },
];
const PROGRAMY_N = Number(!!POKAZ.letsUp) + Number(!!POKAZ.letsShift);

// PRODUKTY — gotowe aplikacje, które piszemy i utrzymujemy sami.
// Do 09.09.2026 w belce stała jedna pozycja „Appto ↗" prowadząca poza serwis.
// Produktów jest już dwa i mają własne podstrony, więc dostały zakładkę,
// a wyjście na appto.ai zeszło do treści strony.
// Opis Wingmana jak w stopce: ofertowania i oceny rozmów w produkcie nie ma
// (docs/wingman-koncepcja.md). Od 16.10.2026 prowadzi na /produkty/wingman.
const PRODUKTY = [
  { t: 'Appto', d: 'Agenci AI dla całej firmy', h: '/produkty#appto', znak: 'appto' },
  { t: 'Wingman', d: 'Podpowiedzi i notatki w trakcie rozmowy', h: '/produkty#wingman', znak: 'wingman' },
];

// Ikony trzymamy jako ścieżki, nie jako gotowe <svg> — ten sam rysunek idzie
// do megamenu i do panelu mobilnego.
const KNOWHOW = [
  { t: 'WiseStack', d: 'Framework i stack transformacji', h: '/wisestack',
    sciezki: ['M12 3 3.2 7.7 12 12.4l8.8-4.7z', 'M3.2 13 12 17.7l8.8-4.7'] },
  { t: 'AI Adoption Framework', d: 'Od pierwszego kroku do firmy napędzanej AI', h: '/#dlaczego-my',
    sciezki: ['M3.2 20.3h5.2v-5.2h5.2v-5.2h5.2V4.7', 'M16.9 6.6 18.8 4.7l1.9 1.9'] },
  { t: 'Wise AI Score', d: 'Test dojrzałości AI w 3 minuty', h: '/#diagnoza',
    sciezki: ['M3.8 18.3a8.2 8.2 0 1 1 16.4 0', 'M12 18.3 16.1 12.6'], kropka: { cx: 12, cy: 18.3, r: 1.15 } },
  { t: 'Baza wiedzy', d: 'Artykuły i analizy', h: '/blog',
    sciezki: ['M12 7c-1.5-1.4-3.4-2.1-5.7-2.1H4v12.6h2.3c2.3 0 4.2.7 5.7 2.1', 'M12 7c1.5-1.4 3.4-2.1 5.7-2.1H20v12.6h-2.3c-2.3 0-4.2.7-5.7 2.1', 'M12 7v12.6'] },
];

// Produkty, Know-how i Inspiracje schowane na start produkcji — przełącznik
// w src/data/menu.js (wspólny ze stopką). Dopóki Know-how jest schowane,
// Baza wiedzy stoi w menu jako osobny link.
//
// Produkty jako zwykły link do huba /produkty, bez rozwijanej listy (Szymon,
// 19.10.2026: przy kilku produktach panel wyglądał pusto obok mega menu Usług,
// a hub ma spis produktów w hero). Markup listy został niżej — powrót: true.
const PRODUKTY_LISTA = false;
const POZOSTALE = [
  { t: 'Produkty', h: '/produkty', pokaz: POKAZ.produkty && !PRODUKTY_LISTA },
  { t: 'Baza wiedzy', h: '/blog', pokaz: !POKAZ.knowhow },
  { t: 'Inspiracje', h: '/inspiracje', pokaz: POKAZ.inspiracje },
  { t: 'Dlaczego my?', h: '/dlaczego-my' },
  { t: 'Kontakt', h: '/kontakt' },
].filter((p) => p.pokaz !== false);
---

{topbar && <TopbarWiseGroup current="letsautomate" />}

<header class="site-header">
<div class="nav-pill">
<a href="/" class="nav-logo" aria-label="Let's automate — strona główna">
<img src="/uploads/logo-2.svg" alt="Let's automate" width="165" height="26" style="height:26px;width:auto;display:block">
</a>
<div class="nav-menu" style="display:flex;align-items:center;gap:clamp(2px,0.6vw,8px);font-size:15px;font-weight:550;color:#2c3a30">
<div class="nav-item">
<a href="/#oferta" class="nav-lnk" style="display:inline-flex;align-items:center;gap:5px;color:#2c3a30">Usługi <svg class="nav-caret" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></a>
<div class="mega-wrap">
<div class="mega-panel" style="background:#ffffff;border:1px solid #e7ece4;border-radius:20px;box-shadow:0 40px 90px -44px rgba(18,38,28,0.45);padding:22px">
<div class="usl-grid">
{USLUGI.map((u) => (
<div class="usl-lane">
<div class="usl-top"><span class="usl-head">{u.pas}</span><span class="usl-sub">{u.sub}</span></div>
<span class="usl-rule" aria-hidden="true"></span>
<div class="usl-list">
{u.poz.map((p) => <a href={p.h} class="mega-item"><span class="mega-t">{p.t}</span><span class="mega-d">{p.d}</span></a>)}
</div>
</div>
))}
</div>
{PROGRAMY_N > 0 && (
<div class="pg-rz">
<div class="pg-g" style={`--n:${PROGRAMY_N}`}>
{POKAZ.letsUp && (
<a href={LETS_UP.h} class="pg-k" style={`--lu-po:${LETS_UP.poProc}%`}>
<span class="pg-ob up" aria-hidden="true">
<span class="up-et">zlecenia</span><b class="up-pr">+52%</b>
<span class="up-sl">{UP_SLUPKI.map((h, i) => <i style={`--h:${h}%;--i:${i}`}></i>)}</span>
<span class="up-ze">{UP_ZESPOL.map((f) => <img src={`/osoby/awatar-${f}.webp`} alt="" width="32" height="32" loading="lazy" decoding="async">)}<small>ten sam zespół</small></span>
</span>
<span class="pg-tx"><span class="pg-n"><b>{LETS_UP.t}</b>{LETS_UP.pod}</span><span class="pg-t">{LETS_UP.tytul}</span><span class="pg-d">{LETS_UP.d}</span></span>
<span class="pg-go" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"/></svg><svg viewBox="0 0 16 16"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"/></svg></span>
</a>
)}
{POKAZ.letsShift && (
<a href={LETS_SHIFT.h} class="pg-k">
<span class="pg-ob sh" aria-hidden="true">
{SH_OKNA.map((o, i) => <span class={`sh-w ${o.k}`} style={`--x:${o.x}px;--y:${o.y}px;--r:${o.r}deg;--i:${i}`}><i></i></span>)}
<span class="sh-sys"><span class="sh-sys-h"></span><i></i><i></i><i></i><i></i><b class="sh-ok"></b></span>
</span>
<span class="pg-tx"><span class="pg-n"><b>{LETS_SHIFT.t}</b>{LETS_SHIFT.pod}</span><span class="pg-t">{LETS_SHIFT.tytul}</span><span class="pg-d">{LETS_SHIFT.d}</span></span>
<span class="pg-go" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"/></svg><svg viewBox="0 0 16 16"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"/></svg></span>
</a>
)}
</div>
</div>
)}
</div>
</div>
</div>
<!-- SCHOWANE 29.08.2026 — zakladka "Rozwiazania". Powod i plan powrotu: docs/nawigacja-decyzje.md
     Zdjac ten komentarz, gdy powstana podstrony procesowe. -->
