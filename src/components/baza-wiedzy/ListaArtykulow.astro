---
// Wiersze artykułów na liniach — ta sama lista na /blog i na stronach
// kategorii. Bez dat (decyzja z 16.10.2026), kolejność od najnowszych.
//
// Wiersze niosą `data-kat`, po którym /blog filtruje listę na miejscu.
import { KATEGORIE } from '../../content/config';
import { adresArtykulu, czasCzytania } from './wspolne.js';

const { artykuly } = Astro.props;
---
<div class="bw-lista">
{artykuly.map((a) => (
  <a class="bw-r" href={adresArtykulu(a.slug)} data-kat={a.data.kategoria}>
    <span><span class="bw-t">{a.data.tytul}</span><span class="bw-l">{a.data.lead}</span></span>
    <span class="bw-meta"><b>{KATEGORIE[a.data.kategoria].nazwa}</b>{czasCzytania(a.body)} min czytania</span>
  </a>
))}
<slot />
</div>

<style>
  .bw-lista{margin-top:clamp(18px,2.4vw,28px)}
  .bw-r{display:grid;grid-template-columns:minmax(0,1fr) 180px;gap:clamp(16px,2.6vw,40px);align-items:baseline;padding:clamp(22px,2.6vw,30px) clamp(10px,1.4vw,18px);margin:0 clamp(-10px,-1.4vw,-18px);border-top:1px solid #dfe7dd;border-radius:12px;transition:background .18s}
  .bw-r:last-of-type{border-bottom:1px solid #dfe7dd}
  .bw-r:hover{background:#ffffff}
  .bw-t{display:block;font-size:clamp(19px,2.3vw,25px);line-height:1.2;letter-spacing:-0.024em;font-weight:750;color:#16211a;text-wrap:balance;transition:color .18s}
  .bw-r:hover .bw-t{color:#0a7a52}
  .bw-l{display:block;margin-top:8px;max-width:62ch;font-size:14.5px;line-height:1.6;color:#6b766e;text-wrap:pretty}
  .bw-meta{text-align:right;font-size:13px;line-height:1.5;color:#637066;white-space:nowrap}
  .bw-meta b{display:block;font-weight:650;color:#4c5850}
  @media (max-width:820px){
    .bw-r{grid-template-columns:minmax(0,1fr);gap:0;padding:22px 12px}
    .bw-meta{text-align:left;margin-top:10px}
    .bw-meta b{display:inline;font-weight:650}
    .bw-meta b::after{content:" · ";color:#c3cbc2}
  }
</style>
