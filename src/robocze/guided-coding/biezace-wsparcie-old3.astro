// ---- FAQ -------------------------------------------------------------------
const faq = [
  { q: 'Za co płacimy w miesiącu, w którym nic się nie zepsuło?',
    a: 'Za rozmowę o tym, co budować dalej, i za to, że macie kogo zapytać, kiedy ktoś utknie. Większość pracy w spokojnym miesiącu to doradztwo przy decyzjach, które później trudno odkręcić. Jeśli spokojnych miesięcy jest kilka pod rząd, sami proponujemy mniejszy zakres.' },
  { q: 'Doradzacie też w sprawach biznesowych?',
