<script>
  var maIO = 'IntersectionObserver' in window;

  // ---- SZEŚĆ MOMENTÓW: krok w środku ekranu ustawia scenę ----
  (function(){
    var wiz = document.querySelector('[data-w5o]') as HTMLElement | null;
    if(!wiz || !maIO) return;
    var kroki = Array.prototype.slice.call(document.querySelectorAll('[data-w5o-k]')) as HTMLElement[];
    var biez = -1;
    function ustaw(k: number){
      if(k === biez) return;
      biez = k;
      wiz!.dataset.krok = String(k);
      kroki.forEach(function(x, j){ x.classList.toggle('on', j === k); });
    }
    var io = new IntersectionObserver(function(w){
      w.forEach(function(e){
        if(!e.isIntersecting) return;
        ustaw(Number((e.target as HTMLElement).dataset.w5oK));
      });
    }, { rootMargin: '-45% 0px -45% 0px' });
    kroki.forEach(function(k){ io.observe(k); });
  })();

  // ---- SZEŚĆ MOMENTÓW na telefonie: scena pod tekstem kroku ----
  // Wzór .sh-z-mob z /lets-shift. Do 900 px przyklejony rysunek znika,
  // a pod każdym krokiem staje kopia jego sceny. Kopie powstają raz.
  (function(){
    var sek = document.getElementById('momenty');
    var wiz = sek ? sek.querySelector('[data-w5o]') as HTMLElement | null : null;
    if(!sek || !wiz) return;
    var mq = window.matchMedia('(max-width:900px)');
    var mc = sek.querySelector('.u4z-k .u6-mc') as HTMLElement | null;
    var mcDom = mc ? mc.parentElement : null;
    var zrobione = false;
    function ustaw(){
      sek!.classList.toggle('w5o-mob', mq.matches);
      if(!mq.matches){ if(mc && mcDom && mc.parentElement !== mcDom) mcDom.appendChild(mc); return; }
      var kroki = Array.prototype.slice.call(sek!.querySelectorAll('[data-w5o-k]')) as HTMLElement[];
      if(!zrobione){
        zrobione = true;
        kroki.forEach(function(k, i){
          var sc = wiz!.querySelector('.w5o-s.s' + i);
          if(!sc) return;
          var c = sc.cloneNode(true) as HTMLElement;
          c.setAttribute('aria-hidden', 'true');
          k.after(c);
        });
      }
      var ost = kroki[kroki.length - 1].nextElementSibling;
      if(mc && ost) ost.after(mc);
    }
    ustaw();
    mq.addEventListener('change', ustaw);
  })();
</script>
</LaBase>
