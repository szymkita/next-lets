<LaBase topbar={false} title={title} description={description} ctaLabel="Umów rozmowę" nav="uslugi">
<script type="application/ld+json" is:inline set:html={JSON.stringify(dane)} slot="head"></script>
<LuStyl />
<LuOdstepy />
<style is:global>
  /* Rysunki tej strony. Wspólny wygląd: LuStyl (Let’s Up v6) i Styl.
     Przedrostki: w5h- hero, w6p- plan na kwartał w hero, w5o- sześć
     momentów, w5w-/w6t-/w6a-/w6ml- okna w scenach, w6r- co robimy
     przez cały miesiąc, w5z-/w5pl- plik z zasadami, w5it- dział IT, w5-av sylwetka osoby po stronie klienta;
     z v4 zostały bwk- (koszty) i bws- (na start).
     Okna narzędzi klienta mają krój systemowy (makieta-aplikacji-bez-
     slopu): nie biorą zieleni ani kroju strony. */
  .v3{--app:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;--mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}

  /* osoba po stronie klienta: szara sylwetka zamiast twarzy */
  .w5-av{flex:none;display:grid;place-items:center;width:24px;height:24px;border-radius:50%;background:#dfe3e8;overflow:hidden}
  .w5-av svg{width:15px;height:15px;margin-top:5px;fill:#98a2ad}
  img.w5-av{display:block;object-fit:cover;background:#cfd2cf}

  /* =====================================================================
     TŁA I ODSTĘPY: papier od „Czym jest” do „Dla kogo”
     ===================================================================== */
  html body #dzial-it + .v3-zl{background:var(--papier)}
  #czym-jest{scroll-margin-top:24px}

  /* =====================================================================
     1 · HERO (.w5h-): ciemna plansza, tekst po lewej, plan panelu
     na kwartał po prawej, ucięty dolną krawędzią planszy
     ===================================================================== */
  .w5h{padding:0 var(--ram)}
  .w5h-in{position:relative;overflow:hidden;display:grid;grid-template-columns:minmax(0,5.7fr) minmax(0,6.3fr);gap:clamp(28px,4vw,72px);min-height:clamp(600px,46vw,700px);padding:0 var(--pin);border-radius:clamp(20px,2.2vw,32px);color:#ffffff;
    background:radial-gradient(900px 620px at 14% 118%,rgba(0,205,119,0.2),rgba(0,205,119,0) 70%),radial-gradient(700px 520px at 82% 0%,rgba(220,224,221,0.07),rgba(220,224,221,0) 70%),var(--ink)}
  .w5h-t{align-self:center;padding:clamp(36px,4vw,64px) 0}
  .w5h-h1{margin:0;font-size:clamp(40px,4.2vw,68px);line-height:0.96;letter-spacing:-0.055em;font-weight:700;text-wrap:balance}
  .w5h-h1 span{color:var(--ziel)}
  .w5h-lead{margin:clamp(20px,2vw,28px) 0 0;max-width:540px;font-size:clamp(16px,1.2vw,18px);line-height:1.58;color:rgba(255,255,255,0.74);text-wrap:pretty}
  .w5h-akcje{margin-top:clamp(26px,2.6vw,36px)}
  .w5h-lnk{display:inline-flex;align-items:center;padding-bottom:4px;border-bottom:2px solid rgba(255,255,255,0.28);font-size:16px;font-weight:650;color:#ffffff;text-decoration:none;transition:border-color .2s}
  .w5h-lnk:hover{border-color:var(--ziel)}
  .w5h-sc{position:relative;margin:0}
  .w5h-sc .w6p{position:absolute;top:clamp(44px,4.6vw,72px);left:0;right:0}

  /* plan na kwartał (.w6p-): dokument z rozmowy o kierunku */
  .w6p{position:relative;max-width:640px;margin-left:auto;border-radius:12px 12px 0 0;background:#ffffff;color:#1f2328;font-family:var(--app);font-size:13px;line-height:1.45;
    box-shadow:0 0 0 1px rgba(255,255,255,0.08),0 50px 100px -40px rgba(0,0,0,0.7)}
  .w6p-g{display:flex;align-items:center;gap:8px;margin:0;padding:10px 20px;border-bottom:1px solid #ececea;border-radius:12px 12px 0 0;background:#f7f7f5;font-size:12px;color:#6b6b75}
  .w6p-g svg{flex:none;width:14px;height:14px;fill:#8a8f96}
  .w6p-g b{font-weight:600;color:#1f2328}
  .w6p-g span:last-child{margin-left:auto;white-space:nowrap}
  .w6p-hd{padding:18px 22px 6px}
  .w6p-hd h4{margin:0;font-size:19px;font-weight:650;letter-spacing:-0.015em;line-height:1.25;color:#1f2328}
  .w6p-hd p{margin:4px 0 0;font-size:12.5px;color:#6b6b75}
  .w6p-l{margin:0;padding:4px 22px 26px;list-style:none;counter-reset:w6p}
  .w6p-i{display:grid;grid-template-columns:22px minmax(0,1fr);gap:0 12px;padding:13px 0 12px;border-top:1px solid #ececea;counter-increment:w6p}
  .w6p-i:first-child{border-top:1.5px solid #1f2328}
  .w6p-i::before{content:counter(w6p);display:grid;place-items:center;width:22px;height:22px;border-radius:50%;box-shadow:inset 0 0 0 1.5px #c9ced3;font-size:11px;font-weight:650;color:#59636e}
  .w6p-i > div{min-width:0}
  .w6p-t{display:flex;justify-content:space-between;align-items:baseline;gap:4px 14px;flex-wrap:wrap;margin:0}
  .w6p-t b{font-size:14px;font-weight:650;letter-spacing:-0.005em}
  .w6p-t span{font-size:11.5px;color:#6b6b75}
  .w6p-i.nie .w6p-t b{color:#6b6b75;text-decoration:line-through;text-decoration-color:rgba(107,107,117,0.6)}
  .w6p-i.nie .w6p-t span{font-weight:600;color:#9a4b1c}
  .w6p-r{display:flex;gap:8px;margin:7px 0 0;font-size:12.5px;line-height:1.45;color:#3b4148;text-wrap:pretty}
  .w6p-r img{flex:none;width:20px;height:20px;margin-top:-1px;border-radius:50%;object-fit:cover}
  .w6p-r em{font-style:normal;font-weight:650;color:#0a7a52}
  .w6p-r em.tech{color:#2f5fb3}
  .w6p-dz{display:flex;align-items:center;gap:6px;margin:7px 0 0 28px;font-size:12px;color:#1f2328}
  .w6p-dz svg{flex:none;width:14px;height:14px;fill:#0a7a52}
  .w6p-dz b{font-weight:650}

  /* wpisy wchodzą po kolei przy otwarciu strony */
  .w5h .w5-e1,.w5h .w5-e2,.w5h .w5-e3,.w5h .w5-e4,.w5h .w5-e5{animation:w5-wej .6s cubic-bezier(.2,.8,.2,1) both}
  .w5h .w5-e2{animation-delay:.5s}
  .w5h .w5-e3{animation-delay:1.1s}
  .w5h .w5-e4{animation-delay:2s}
  .w5h .w5-e5{animation-delay:2.6s}
  @keyframes w5-wej{from{opacity:0;transform:translateY(10px)}}

  @media (max-width:1100px){
    .w5h-in{grid-template-columns:minmax(0,1fr) minmax(0,1.08fr);gap:28px}
    .w6p-hd h4{font-size:17px}
  }
  @media (max-width:900px){
    .w5h-in{grid-template-columns:minmax(0,1fr);gap:0;height:auto;padding:0 18px}
    .w5h-t{padding:40px 0 30px}
    .w5h-h1{font-size:clamp(38px,10.4vw,56px)}
    .w5h-sc{height:430px;overflow:hidden}
    .w5h-sc .w6p{top:0;left:-2px;right:-2px}
    .w6p{max-width:none;margin:0 -2px;font-size:12px}
    .w6p-g{padding:9px 14px;font-size:11px}
    .w6p-g span:last-child{display:none}
    .w6p-hd{padding:14px 14px 4px}
    .w6p-hd h4{font-size:15.5px}
    .w6p-l{padding:2px 14px 18px}
    .w6p-t b{font-size:13px}
    .w6p-r{font-size:12px}
    .w6p-dz{margin-left:0;font-size:11.5px}
  }
  @media (prefers-reduced-motion:reduce){
    .w5h .w5-e1,.w5h .w5-e2,.w5h .w5-e3,.w5h .w5-e4,.w5h .w5-e5{animation:none}
  }

  /* =====================================================================
     3 · SZEŚĆ MOMENTÓW (.w5o-): układ „Jednej sprawy” z /lets-shift —
     przyklejony rysunek z paskiem kroków i parą okien, kroki obok
     ===================================================================== */
  #momenty{background:var(--papier);scroll-margin-top:16px}
  .w5o .u4z-gl .u2-h2{font-size:clamp(40px,5vw,82px)}
  .w5o .u4z-g{margin-top:clamp(32px,4vw,56px);grid-template-columns:minmax(0,7.6fr) minmax(0,4.4fr)}
  .w5o .u4z-kar{padding:0;background:none;box-shadow:none}
  .w5o .u4z-wiz{top:clamp(100px,calc(50vh - 290px),170px)}
  .w5o-et{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:6px;margin:0 0 20px;padding:0;list-style:none}
  .w5o-et li{position:relative;padding-top:12px;font-size:12.5px;font-weight:600;line-height:1.25;color:rgba(255,255,255,0.45);transition:color .3s ease}
  .w5o-et li::before{content:"";position:absolute;left:0;right:0;top:0;height:3px;border-radius:2px;background:rgba(255,255,255,0.14);transition:background .3s ease}
  .w5o-et li b{display:block;font-size:11px;font-weight:700;opacity:0.8}
  .w5o-st{display:grid}
  .w5o-s{grid-area:1 / 1;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16px;align-items:start;opacity:0;visibility:hidden;transform:translateY(8px);transition:opacity .4s ease,transform .45s ease,visibility 0s linear .4s}
  .w5o-wiz[data-krok="0"] .s0,.w5o-wiz[data-krok="1"] .s1,.w5o-wiz[data-krok="2"] .s2,.w5o-wiz[data-krok="3"] .s3,.w5o-wiz[data-krok="4"] .s4,.w5o-wiz[data-krok="5"] .s5{opacity:1;visibility:visible;transform:none;transition:opacity .4s ease,transform .45s ease,visibility 0s}
  .w5o-wiz[data-krok="0"] .w5o-et li:nth-child(-n+1),.w5o-wiz[data-krok="1"] .w5o-et li:nth-child(-n+2),.w5o-wiz[data-krok="2"] .w5o-et li:nth-child(-n+3),.w5o-wiz[data-krok="3"] .w5o-et li:nth-child(-n+4),.w5o-wiz[data-krok="4"] .w5o-et li:nth-child(-n+5),.w5o-wiz[data-krok="5"] .w5o-et li{color:rgba(255,255,255,0.75)}
  .w5o-wiz[data-krok="0"] .w5o-et li:nth-child(-n+1)::before,.w5o-wiz[data-krok="1"] .w5o-et li:nth-child(-n+2)::before,.w5o-wiz[data-krok="2"] .w5o-et li:nth-child(-n+3)::before,.w5o-wiz[data-krok="3"] .w5o-et li:nth-child(-n+4)::before,.w5o-wiz[data-krok="4"] .w5o-et li:nth-child(-n+5)::before,.w5o-wiz[data-krok="5"] .w5o-et li::before{background:rgba(255,255,255,0.45)}
  .w5o-wiz[data-krok="0"] .w5o-et li:nth-child(1),.w5o-wiz[data-krok="1"] .w5o-et li:nth-child(2),.w5o-wiz[data-krok="2"] .w5o-et li:nth-child(3),.w5o-wiz[data-krok="3"] .w5o-et li:nth-child(4),.w5o-wiz[data-krok="4"] .w5o-et li:nth-child(5),.w5o-wiz[data-krok="5"] .w5o-et li:nth-child(6){color:#ffffff}
  .w5o-wiz[data-krok="0"] .w5o-et li:nth-child(1)::before,.w5o-wiz[data-krok="1"] .w5o-et li:nth-child(2)::before,.w5o-wiz[data-krok="2"] .w5o-et li:nth-child(3)::before,.w5o-wiz[data-krok="3"] .w5o-et li:nth-child(4)::before,.w5o-wiz[data-krok="4"] .w5o-et li:nth-child(5)::before,.w5o-wiz[data-krok="5"] .w5o-et li:nth-child(6)::before{background:var(--ziel)}
  .w5o-p{min-width:0}
  .w5o-p > em{display:block;margin-bottom:10px;font-style:normal;font-size:14px;font-weight:700;color:rgba(255,255,255,0.6)}
  .w5o-p.z > em{color:var(--ziel)}
  .w5o-cap{margin:12px 0 0;font-size:14.5px;line-height:1.45;color:rgba(255,255,255,0.72);text-wrap:pretty}
  .w5o-cap b{color:#ffffff;font-weight:650}
  .w5o-cap i{font-style:normal;font-weight:650;color:#ffc879}
  .w5o-cap.po{color:#ffffff}
  .w5o .u4z-k h3{text-wrap:balance}
  @media (prefers-reduced-motion:reduce){ .w5o-s{transition:none} }

  /* okna w scenach (.w5w-) */
  .w5w{border-radius:10px;overflow:hidden;background:#ffffff;color:#1f2328;font-family:var(--app);font-size:12.5px;line-height:1.45;box-shadow:0 30px 60px -30px rgba(0,0,0,0.65)}
  .w5w-g{display:flex;align-items:center;gap:7px;margin:0;padding:8px 12px;border-bottom:1px solid #e3e3ee;background:#f5f5f7;font-size:12px}
  .w5w.tm .w5w-g{background:#ebebf5}
  .w5w-g img{width:15px;height:15px}
  .w5w-g svg{width:14px;height:14px;fill:#59636e}
  .w5w-g b{font-weight:600}
  .w5w-g span{margin-left:auto;font-size:11px;color:#6b6b75;white-space:nowrap}
  .w5w-m{display:grid;grid-template-columns:24px minmax(0,1fr);gap:8px;padding:8px 12px 2px}
  .w5w-m:last-child{padding-bottom:12px}
  .w5w-m p{margin:0;min-width:0}
  .w5w-m b{font-size:12px;font-weight:600}
  .w5w-m small{margin-left:6px;font-size:11px;color:#6b6b75}
  .w5w-m time{margin-left:6px;font-size:11px;color:#8a8a94}
  .w5w-m > p > span{display:block;margin-top:1px;font-size:12.5px;line-height:1.42;text-wrap:pretty}
  .w5w-m .za{display:inline-flex;align-items:center;gap:6px;margin-top:6px;padding:5px 9px;border:1px solid #dcdce6;border-radius:6px;font-size:11.5px;font-weight:600}
  .w5w-m .za svg{width:13px;height:13px;fill:#6b6b75}
  .w5w-m.dol{border-top:1px solid #ececf2;padding-top:10px}
  .w5w-po{display:flex;align-items:center;gap:8px;margin:6px 12px 0 44px;font-size:11px;font-weight:600;color:#0a7a52}
  .w5w-po::before{content:"";width:16px;height:1.5px;background:currentColor}
  .w5w-sys{margin:4px 12px 12px;padding:6px 10px;border-radius:6px;background:#f5f5f7;font-size:11.5px;color:#6b6b75}
  .w5w-t{margin:0;padding:10px 12px;border-bottom:1px solid #e6e9ec}
  .w5w-t b{display:block;font-size:13.5px;font-weight:600}
  .w5w-t span{display:block;margin-top:1px;font-size:11.5px;color:#59636e}
  .w5w-uw{margin:10px 12px 0;border:1px solid #e9d8a6;border-radius:8px;background:#fffbea;box-shadow:inset 3px 0 0 #d4a72c}
  .w5w-uh{display:flex;align-items:center;gap:7px;margin:0;padding:7px 10px 0 12px;font-size:12px}
  .w5w-uh img{width:20px;height:20px;border-radius:50%;object-fit:cover}
  .w5w-uh b{font-weight:600}
  .w5w-uh time{margin-left:auto;font-size:11px;color:#8a8a94}
  .w5w-uw > p:last-child{margin:0;padding:5px 12px 10px 12px;font-size:12.5px;line-height:1.45;text-wrap:pretty}
  .w5w-ok{display:flex;align-items:center;gap:8px;margin:10px 12px 0;font-size:12px;color:#59636e}
  .w5w-ok svg{flex:none;width:16px;height:16px;fill:#1a7f37}
  .w5w-ok b{font-weight:600;color:#1f2328}
  .w5w-zs{display:flex;align-items:center;gap:8px;margin:8px 12px 12px;padding:7px 10px;border-radius:6px;background:#f2f7f4;font-size:12px;font-weight:600;color:#0a5c3e}
  .w5w-zs svg{flex:none;width:14px;height:14px;fill:#0a7a52}
  .w5w.ses ol{margin:0;padding:6px 12px 0;list-style:none}
  .w5w.ses li{display:flex;gap:9px;padding:7px 0;border-top:1px solid #eef0f2;font-size:12.5px;font-weight:600}
  .w5w.ses li:first-child{border-top:0}
  .w5w.ses li svg{flex:none;width:16px;height:16px;margin-top:1px;padding:2px;border-radius:50%;background:#1a7f37;fill:#ffffff}
  .w5w.ses li small{display:block;font-size:11.5px;font-weight:400;color:#59636e}
  .w5w.ses .w5w-ok{margin:6px 12px 12px;padding-top:10px;border-top:1px solid #eef0f2}
  .w5w.lst{padding:14px 16px 16px;border-radius:4px;background:#fdfdfb}
  .w5w.lst header{display:flex;align-items:center;gap:10px;padding-bottom:10px;border-bottom:1px solid #e6e6e0}
  .w5w.lst header .lg{flex:none;display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:#07140d}
  .w5w.lst header .lg svg{width:13px;height:13px;fill:#00CD77}
  .w5w.lst header p{margin:0;font-size:11.5px;line-height:1.35;color:#59636e}
  .w5w.lst header b{display:block;font-size:13.5px;font-weight:600;color:#1f2328}
  .w5w.lst h5{margin:10px 0 2px;font-size:11.5px;font-weight:700;color:#59636e}
  .w5w.lst h5.z{color:#0a7a52}
  .w5w.lst p{margin:0;font-size:12.5px;line-height:1.48;text-wrap:pretty}

  /* tabela rabatów w dwóch panelach (.w6t) i ekran panelu z oddziałami (.w6a) */
  .w6t table,.w6a table{width:100%;border-collapse:collapse;font-size:12px}
  .w6t th,.w6a th{padding:7px 12px 6px;border-bottom:1px solid #e6e9ec;font-size:11px;font-weight:600;color:#6b6b75;text-align:left}
  .w6t td,.w6a td{padding:7px 12px;border-bottom:1px solid #f0f1f3;font-variant-numeric:tabular-nums}
  .w6t th:not(:first-child),.w6t td:not(:first-child),.w6a th:last-child,.w6a td:last-child{text-align:right}
  .w6t td.zl{background:#fdecea;color:#b42318;font-weight:600}
  .w6t-s{margin:0;padding:9px 12px 11px;font-size:11.5px;color:#9a4b1c;font-weight:600}
  .w6a-h{display:flex;justify-content:space-between;align-items:center;gap:10px;margin:0;padding:10px 12px;border-bottom:1px solid #e6e9ec}
  .w6a-h b{font-size:13.5px;font-weight:650}
  .w6a-z{display:flex;gap:2px;padding:2px;border-radius:7px;background:#f0f1f3;font-size:11px}
  .w6a-z span{padding:3px 8px;border-radius:5px;color:#59636e}
  .w6a-z span.on{background:#ffffff;color:#1f2328;font-weight:600;box-shadow:0 1px 2px rgba(0,0,0,0.08)}
  .w6a td:nth-child(3){color:#3b4148}
  .w6a-s{display:flex;align-items:center;gap:7px;margin:0;padding:9px 12px 11px;font-size:11.5px;color:#0a5c3e}
  .w6a-s i{flex:none;width:7px;height:7px;border-radius:50%;background:#1a7f37}
  /* mail (.w6ml) */
  .w6ml dl{margin:0;padding:8px 14px 4px;border-bottom:1px solid #eef0f2}
  .w6ml dl div{display:flex;gap:8px;padding:2px 0;font-size:12px}
  .w6ml dt{width:2.4em;color:#8a8a94}
  .w6ml dd{margin:0;font-weight:600}
  .w6ml > p:last-child{margin:0;padding:10px 14px 14px;font-size:12.5px;line-height:1.5;text-wrap:pretty}

  /* opowieść na telefonie (wzór .sh-z-mob z /lets-shift): scena pod
     tekstem kroku, przyklejony rysunek znika */
  @media (max-width:900px){
    .w5o .u4z-g{grid-template-columns:minmax(0,1fr)}
    .w5o .u4z-kroki,.w5o .u4z-k,.w5o .u4z-k > div{min-width:0}
    .w5o-s{grid-template-columns:minmax(0,1fr);gap:16px}
    .w5o-mob .u4z-wiz{display:none}
    .w5o-mob .u4z-k,.w5o-mob .u4z-k:first-child{display:block;min-height:0;padding:30px 0 6px;align-items:initial}
    .w5o-mob .u4z-k:not(:first-child){margin-top:26px;border-top:1px solid rgba(255,255,255,0.1)}
    .w5o-mob .u4z-k > div{opacity:1}
    .w5o-mob .u4z-kroki{padding-bottom:0}
    .w5o-mob .u4z-kroki > .w5o-s{display:grid;margin-top:16px;opacity:1;visibility:visible;transform:none}
    .w5o-mob .u4z-kroki > .u6-mc{margin-top:26px}
    .w5o-p > em{margin-bottom:6px;font-size:12.5px}
    .w5o-cap{margin-top:8px;font-size:13.5px}
  }

  /* =====================================================================
     4 · CO ROBIMY PRZEZ CAŁY MIESIĄC (.w5z-, wiersze .w6r-, plik .w5pl-)
     ===================================================================== */
  html body #co-robimy{padding-bottom:clamp(56px,6vw,88px)}
  .w5z-g{display:grid;grid-template-columns:minmax(0,5.4fr) minmax(0,6.6fr);gap:clamp(36px,5vw,88px);align-items:start}
  .w5z-t .u2-h2{font-size:clamp(40px,4.6vw,76px)}
  .w5z-t .v3-sub{margin-top:24px}
  .w6r{margin:clamp(28px,3vw,44px) 0 0}
  .w6r > div{padding:16px 0 18px;border-top:1px solid var(--linia)}
  .w6r > div:first-child{border-top:1.5px solid var(--t1)}
  .w6r dt{display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:2px 16px}
  .w6r dt b{font-size:clamp(18px,1.4vw,21px);font-weight:700;letter-spacing:-0.025em;color:var(--t1)}
  .w6r dt span{font-size:13.5px;font-weight:600;color:var(--ziel-c)}
  .w6r dd{margin:6px 0 0;font-size:15.5px;line-height:1.58;color:var(--t2);text-wrap:pretty}
  .w5z-f{margin:0;position:sticky;top:110px}
  .w6r-f{margin-top:14px;font-size:14px;line-height:1.5;color:var(--t2)}
  .w5pl{border-radius:12px;background:#ffffff;overflow:hidden;font-family:var(--app);color:#1f2328;box-shadow:0 0 0 1px rgba(15,26,20,0.07),0 60px 100px -50px rgba(15,26,20,0.5)}
  .w5pl-g{display:flex;align-items:center;gap:5px;margin:0;padding:10px 16px;border-bottom:1px solid #e6e9ec;background:#f6f8fa;font-size:12.5px;color:#59636e}
  .w5pl-g b{font-weight:600;color:#1f2328}
  .w5pl-g em{margin-left:auto;font-style:normal;font-size:11.5px}
  .w5pl-b{padding:6px 0}
  .w5pl-r{display:grid;grid-template-columns:minmax(0,15.5em) 30px minmax(0,1fr);align-items:baseline;min-height:26px}
  .w5pl-r .bl{align-self:stretch;padding:5px 14px 5px 16px;border-right:1px solid #e6e9ec;font-size:11.5px;line-height:1.35;color:#59636e}
  .w5pl-r .bl b{display:inline-block;margin-right:7px;font-weight:600;color:#1f2328;font-variant-numeric:tabular-nums}
  .w5pl-r em{padding-right:10px;font-style:normal;font-family:var(--mono);font-size:11px;color:#8c959f;text-align:right}
  .w5pl-r .tx{padding:4px 16px 4px 0;font-family:var(--mono);font-size:12px;line-height:1.5;text-wrap:pretty}
  .w5pl-r.hd .tx{font-weight:700;color:#0550ae}
  .w5pl-r.pp .tx{color:#59636e}
  .w5pl-r.zz + .w5pl-r.hd .tx,.w5pl-r.zz + .w5pl-r.hd .bl{padding-top:12px}
  .w5pl-r.n{background:#effaf3}
  .w5pl-r.n .bl{box-shadow:inset 3px 0 0 var(--ziel);color:#0a5c3e}
  .w5pl-r.zw .tx{color:#8c959f;font-family:var(--app);font-size:11.5px}
  .w5pl-s{display:flex;justify-content:space-between;flex-wrap:wrap;gap:4px 16px;margin:0;padding:10px 16px;border-top:1px solid #e6e9ec;background:#f6f8fa;font-size:11.5px;color:#59636e}
  .w5pl-s span:first-child{font-weight:600;color:#1f2328}
  .w5pl{transition:opacity .6s ease,transform .7s cubic-bezier(.2,.8,.2,1)}
  .w5z-f[data-anim]:not(.on) .w5pl{opacity:0;transform:translateY(16px)}
  .w5z .op9{margin-top:clamp(72px,8vw,120px)}
  @media (max-width:1100px){
    .w5z-g{grid-template-columns:minmax(0,1fr)}
    .w5z-f{position:static}
  }
  @media (max-width:700px){
    .w5pl-r{grid-template-columns:minmax(0,1fr)}
    .w5pl-r em{display:none}
    .w5pl-r .bl{order:2;padding:0 14px 6px;border-right:0;font-size:11px}
    .w5pl-r .tx{padding:6px 14px 2px;font-size:11.5px}
    .w5pl-r.hd .bl,.w5pl-r.pp .bl,.w5pl-r.zw .bl{display:none}
    .w5pl-r.n .bl{box-shadow:none}
    .w5pl-r.n{box-shadow:inset 3px 0 0 var(--ziel)}
  }
  @media (prefers-reduced-motion:reduce){ .w5pl{transition:none} .w5z-f[data-anim]:not(.on) .w5pl{opacity:1;transform:none} }

  /* =====================================================================
     6 · DZIAŁ IT (.w5it-): nagłówek i cztery wiersze
     ===================================================================== */
  .w5it{scroll-margin-top:24px}
  .w5it-g{display:grid;grid-template-columns:minmax(0,5.6fr) minmax(0,6.4fr);gap:28px clamp(32px,5vw,96px);align-items:start}
  .w5it-g .u2-h2{font-size:clamp(40px,4.6vw,76px)}
  .w5it-g .v3-sub{margin-top:24px}
  .w5it-dl{margin:0}
  .w5it-dl > div{display:grid;grid-template-columns:11em minmax(0,1fr);gap:16px;padding:18px 0 20px;border-top:1px solid var(--linia)}
  .w5it-dl > div:first-child{border-top:1.5px solid var(--t1)}
  .w5it-dl dt{font-size:14px;font-weight:700;color:var(--ziel-c)}
  .w5it-dl dd{margin:0;font-size:16.5px;line-height:1.55;color:var(--t1);text-wrap:pretty}
  @media (max-width:1100px){ .w5it-g{grid-template-columns:minmax(0,1fr)} }
  @media (max-width:700px){
    .w5it-dl > div{grid-template-columns:minmax(0,1fr);gap:4px}
    .w5it-dl dd{font-size:15.5px}
  }

  /* =====================================================================
     KOSZTY · dwa dokumenty na zielonym panelu (.bwk-), wzór .sh-ko
     z /lets-shift: warunki abonamentu z jawną stawką (kartka) i oferta
     dla działu IT z zamazaną kwotą (tabela)
     ===================================================================== */
  .bwk{display:grid;grid-template-columns:minmax(0,5.4fr) minmax(0,6.6fr);gap:clamp(24px,4vw,64px);align-items:start;margin-top:clamp(44px,5vw,72px);padding:clamp(28px,4vw,56px);border-radius:32px;
    background:radial-gradient(700px 420px at 90% 0%,rgba(0,205,119,0.14),rgba(0,205,119,0) 70%),linear-gradient(180deg,#e7f2e9,#f1f7ef)}
  .bwk figure{margin:0}
  .bwk figcaption{margin-top:16px;font-size:14px;line-height:1.45;color:var(--t2)}
  .bwk figcaption b{display:block;font-size:17px;font-weight:700;letter-spacing:-0.015em;color:var(--t1)}
  .bwk-w-k{padding:26px 28px 22px;border-radius:6px;background:#ffffff;transform:rotate(-1deg);box-shadow:0 0 0 1px rgba(15,26,20,0.06),0 40px 70px -40px rgba(15,26,20,0.5)}
  .bwk-w-k header{display:flex;justify-content:space-between;align-items:center;gap:10px;padding-bottom:12px;border-bottom:1px solid var(--linia)}
  .bwk-w-k .lg{display:flex;align-items:center;gap:8px}
  .bwk-w-k .lg svg{width:20px;height:20px;fill:var(--ziel-c)}
  .bwk-w-k .lg b{font-size:15px;font-weight:750;letter-spacing:-0.02em}
  .bwk-w-k header > span:last-child{font-size:12px;color:var(--t3)}
  .bwk-w-k .nr{margin:18px 0 0;font-size:12.5px;font-weight:650;color:var(--ziel-c)}
  .bwk-w-k h3{margin:4px 0 0;font-size:24px;font-weight:700;letter-spacing:-0.035em;line-height:1.12;text-wrap:balance}
  .bwk-w-k .st{display:flex;align-items:baseline;gap:10px;margin:16px 0 0;padding:12px 14px;border-radius:10px;background:var(--papier)}
  .bwk-w-k .st b{font-size:clamp(28px,2.4vw,34px);font-weight:750;letter-spacing:-0.045em;line-height:1;color:var(--ziel-c);white-space:nowrap}
  .bwk-w-k .st span{font-size:14px;font-weight:600;color:var(--t2)}
  .bwk-w-k dl{margin:12px 0 0}
  .bwk-w-k dl > div{display:grid;grid-template-columns:6.6em minmax(0,1fr);gap:12px;padding:9px 0;border-top:1px solid var(--linia2)}
  .bwk-w-k dl > div:first-child{border-top:0}
  .bwk-w-k dt{font-size:13px;font-weight:700;color:var(--t3)}
  .bwk-w-k dd{margin:0;font-size:14.5px;line-height:1.45;text-wrap:pretty}
  .bwk-w-k footer{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin-top:8px;padding-top:14px;border-top:1px solid var(--linia);font-size:13px;line-height:1.4;color:var(--t2)}
  .bwk-w-k .pd{flex:none;display:flex;flex-direction:column;align-items:flex-start;gap:4px;font-size:11.5px;color:var(--t3)}
  .bwk-w-k .pd i{width:120px;height:26px;border-bottom:1px solid var(--t2)}
  .bwk-o-k{padding:22px 24px 18px;border-radius:14px;background:#ffffff;box-shadow:0 0 0 1px rgba(15,26,20,0.06),0 40px 70px -40px rgba(15,26,20,0.45)}
