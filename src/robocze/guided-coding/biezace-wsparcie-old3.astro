  { t: 'Analiza techniczna', c: ANALIZA.czas },
  { t: 'Abonament', c: 'z miesiąca na miesiąc' },
];

// ---- DLA KOGO --------------------------------------------------------------
const DLA_KOGO = [
  { t: 'Aplikacja stała się codzienną robotą działu i dalej rośnie',
    d: 'Dochodzą funkcje, ludzie i oddziały. Przy każdej większej decyzji przydaje się ktoś, kto przeszedł podobne przy ponad dwustu wdrożeniach.' },
