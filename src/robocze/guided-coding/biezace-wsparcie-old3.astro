const OFERTA_IT_ARIA = `Oferta dla działu IT z agentami po pierwszej rozmowie: ${OFERTA_IT.map((o) => `${o.t.toLowerCase()} ${o.r}`).join(', ')}. Stała miesięczna stawka podana w ofercie. Około 6 godzin w miesiącu na osobę, która bierze w tym udział.`;

