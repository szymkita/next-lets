<script is:inline>
  // Hero: przebieg to klatki CSS pod .gra, startują z .on (Anim). .gra
  // zakładamy tutaj, zaraz pod rysunkiem — ten sam warunek co w Anim, ale
  // przed pierwszym malowaniem; z modułu Anim przychodzi za późno i w kadrze
  // mignąłby stan końcowy. Poza kadrem .stoi wstrzymuje klatki.
  (function(fig){
    if(!fig || !('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    fig.classList.add('gra');
    new IntersectionObserver(function(w){
      fig.classList.toggle('stoi', !(w[0].isIntersecting && w[0].intersectionRatio >= 0.1));
    }, { threshold: [0, 0.1] }).observe(fig);
  })(document.querySelector('[data-au2]'));
</script>
</Hero>

