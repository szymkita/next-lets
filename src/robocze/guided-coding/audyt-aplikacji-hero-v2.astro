// polska odmiana: 1 / 2–4 / 5+
const odm = (n, jeden, kilka, wiele) => (n === 1 ? jeden : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? kilka : wiele);
const godzin = (h) => `${h} ${odm(h, 'godzina', 'godziny', 'godzin')}`;

// =====================================================================
// RAPORT PANELU ZAMÓWIEŃ · siedem pozycji (PRZYKŁADOWE)
// n = miejsce w raporcie, g = grupa, dz = dzień znalezienia (0 = pn),
