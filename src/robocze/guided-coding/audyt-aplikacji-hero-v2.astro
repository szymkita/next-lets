  /* =====================================================================
     DWA ZESPOŁY · ta sama karta, inna treść
     ===================================================================== */
  .tz-uk{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(12px,1.4vw,20px);margin-top:clamp(40px,4.4vw,64px)}
