    t: 'Eksport stanie przy większym ruchu', d: 'Dziś 3 000 zamówień. Przy 40 000 panel stanie dla wszystkich.',
    notka: 'eksport bierze wszystkie zamówienia naraz' },
  { n: 5, g: 1, dz: 3, h: 12, czas: 'półtora dnia', kto: 'rw', k: 'testy', mx: 'Test zamówienia', dy: -8,
    t: 'Ścieżka zamówienia nie ma żadnego testu', d: 'Błąd w zamówieniu zgłosi dopiero klient.',
    notka: 'zero testów na ścieżce zamówienia' },
  { n: 6, g: 2, dz: 4, h: 1, czas: 'godzina', kto: 'w', k: 'usługi', mx: 'Usługi po próbach',
    t: 'Płatne usługi zostały po próbach', d: 'Dwie usługi z nieudanych prób dalej są na rachunku.',
    notka: 'dwie usługi po próbach dalej płatne' },
  { n: 7, g: 2, dz: 0, h: 8, czas: 'dwa popołudnia', kto: 'r', k: 'autor', mx: 'Uruchamia tylko autor',
