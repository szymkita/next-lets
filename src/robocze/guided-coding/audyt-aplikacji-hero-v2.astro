  .tz-poz{margin-top:auto;padding-top:24px}
  .tz-poz > span{display:block;margin-bottom:8px;font-size:12.5px;font-weight:650;color:var(--t3)}
  .tz-pk{display:grid;grid-template-columns:20px minmax(0,1fr);gap:4px 11px;align-items:center;padding:13px 15px;border-radius:12px;background:#ffffff;box-shadow:0 0 0 1px rgba(15,26,20,0.06),0 16px 30px -22px rgba(15,26,20,0.4)}
  .tz-pk b{font-size:14px;font-weight:650;letter-spacing:-0.01em;color:#18181b}
