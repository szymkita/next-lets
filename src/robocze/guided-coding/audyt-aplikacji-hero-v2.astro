  .mx-p.lw em{top:auto;bottom:22px}
  .mx-p em .kr{display:none}
  .mx-os{grid-column:2;grid-row:4;position:relative;height:42px}
  .mx-os span{position:absolute;left:var(--x);top:12px;transform:translateX(-50%);font-size:12.5px;color:var(--t2);white-space:nowrap}
  .mx-os span .kr{display:none}
  .mx-os-t{grid-column:1;grid-row:4;align-self:start;padding:12px 18px 0;font-size:12.5px;font-weight:650;color:var(--t3)}
  .mx-pen{position:absolute;z-index:3;width:48px;height:48px;margin:-24px 0 0 -24px;border:2px solid var(--pen);border-radius:50%;opacity:0;pointer-events:none;
    left:var(--x0);top:var(--y0);box-shadow:0 0 0 4px rgba(196,61,42,0.1)}
  /* ruch: punkty szare bez numeru, długopis nadaje numery po kolei */
  .mx.gra .mx-p .nr{background:#ffffff;color:transparent;box-shadow:0 0 0 3px var(--papier),inset 0 0 0 2px #c8cec9;transform:scale(0.82)}
  .mx.gra .mx-g{opacity:0}
  .mx.gra.on .mx-p .nr{background:var(--gc);color:#ffffff;box-shadow:0 0 0 3px var(--papier);transform:none;transition-delay:calc(var(--t) * 1s)}
