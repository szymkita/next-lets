    notka: 'projekt od zera stawia tylko autor' },
];
const KTO = { w: 'Wy, z instrukcją', r: 'razem przy ekranie', rw: 'razem, potem Wy' };
const GRUPY = [
  { t: 'Najpierw, w tym tygodniu', s: 'Wyciek albo utrata danych klientów' },
  { t: 'W pierwszym miesiącu', s: 'Staje praca działu albo zamówienia' },
  { t: 'Może poczekać', s: 'Kosztuje albo spowalnia' },
].map((g, i) => ({ ...g, i, h: POZ.filter((x) => x.g === i).reduce((a, x) => a + x.h, 0), poz: POZ.filter((x) => x.g === i) }));
const SAMI = POZ.filter((x) => x.kto === 'w');                    // 1, 2, 4, 6
const RAZEM = POZ.filter((x) => x.kto !== 'w');                   // 3, 5, 7
const NAJPIERW_H = GRUPY[0].h;                                    // 7
const DNI = [
  { dz: 'pn', data: '5.10' },
  { dz: 'wt', data: '6.10' },
  { dz: 'śr', data: '7.10' },
  { dz: 'cz', data: '8.10' },
  { dz: 'pt', data: '9.10' },
];
const PROWADZACY = { foto: '/team/marcel-bilski.png', imie: 'Marcel Bilski' };

// =====================================================================
// HERO · notatnik z pięciu dni i pierwsza strona raportu (papiery na planszy)
// Notatnik: zapiski w kolejności znalezienia (pierwszego dnia najpierw
// uruchomienie projektu), przy każdym numer pozycji raportu dopisany
// czerwonym długopisem; ✓ = obejrzane, bez uwag — te same dwa obszary co
// „bez uwag" na stronie „Co przejrzeliśmy" w scenie (PRZEJRZANE).
// Ruch (sekundy od wejścia w kadr; animacje CSS tylko pod .gra, pauza
// poza kadrem przez .stoi): A zapiski dzień po dniu → B numery na
// marginesie, od góry notatnika → C pozycje wpisują się w raport
// w kolejności raportu, a zapisek, z którego pochodzi pozycja, jaśnieje
// w notatniku → D sumy grup, „4 z 7" i podpis. Bez notatnika (wąski ekran)
// raport zaczyna od razu: wszystkie czasy raportu minus --skok.
// =====================================================================
const NOTATNIK = [[7, 2], [4, 1, 'logowanie i role bez uwag'], [3], [5, 'biblioteki aktualne, bez znanych luk'], [6]]
  .map((dzien) => dzien.map((x) => (typeof x === 'number' ? { n: x, t: POZ.find((p) => p.n === x).notka } : { n: 0, t: x })));
const r2 = (x) => +x.toFixed(2);
const auPis = (s) => r2(Math.min(0.46, Math.max(0.24, s.length * 0.0085)));  // czas pisania zapisku
let auT = 0.3;
const AU_DNI = DNI.map((d, i) => {
  const tz = { t: r2(auT), d: 0.22 };                               // nagłówek dnia
  auT += 0.28;
  const w = NOTATNIK[i].map((x) => { const o = { ...x, t0: r2(auT), d: auPis(x.t) }; auT += o.d + 0.05; return o; });
  auT += 0.12;
  return { ...d, tz, w };
});
auT += 0.2;
const AU_WIERSZE = AU_DNI.flatMap((d) => d.w);
AU_WIERSZE.forEach((x) => { x.tm = r2(auT); auT += 0.17; });          // B: długopis na marginesie
auT += 0.3;
const AU_C0 = r2(auT);                                               // C: notatnik przygasa
auT += 0.3;
const AU_TG = [];
const AU_TP = {};
GRUPY.forEach((g) => { AU_TG[g.i] = r2(auT); auT += 0.2; g.poz.forEach((x) => { AU_TP[x.n] = r2(auT); auT += 0.42; }); });
auT += 0.2;
const AU_C1 = r2(auT);
const AU_SUMA = r2(auT + 0.1);                                       // D: + 0.12 s na grupę
const AU_SAMI = r2(auT + 0.5);
const AU_PODP = r2(auT + 0.6);                                       // podpis: 0.25 + 0.45 + kreska 0.3 s
// Przygaszenie zapisków w fazie C; zapisek jaśnieje, gdy jego pozycja się wpisuje.
const AU_FD = r2(AU_C1 + 0.5 - AU_C0);
const auPr = (t) => `${(((t - AU_C0) / AU_FD) * 100).toFixed(2)}%`;
const AU_KLATKI = AU_WIERSZE.map((x, k) => {
  const tf = x.n ? AU_TP[x.n] : null;
  const f = ['0%{opacity:1}', `${auPr(AU_C0 + 0.3)}{opacity:.3}`];
  if (tf != null) f.push(`${auPr(tf - 0.1)}{opacity:.3}`, `${auPr(tf + 0.02)}{opacity:1}`, `${auPr(tf + 0.4)}{opacity:1}`, `${auPr(tf + 0.56)}{opacity:.3}`);
  f.push(`${auPr(AU_C1)}{opacity:.3}`, '100%{opacity:1}');
  return `@keyframes au2-f${k}{${f.join('')}}.au2.gra .au2-n.f${k}{animation:au2-f${k} ${AU_FD}s linear ${AU_C0}s both}`;
}).join('\n');
const AU_ARIA = `Na ciemnej planszy notatnik z pięciodniowego audytu panelu zamówień, który zbudował dział operacji, i pierwsza strona raportu. W notatniku zapiski z kolejnych dni w kolejności znalezienia, przy każdym numer pozycji raportu dopisany czerwonym długopisem; logowanie i biblioteki są bez uwag. W raporcie te same rzeczy stoją w kolejności poprawek. ${GRUPY.map((g) => `${g.t}, razem ${godzin(g.h)}: ${g.poz.map((x) => `${x.n}. ${x.t.toLowerCase()}, ${x.czas}, ${KTO[x.kto]}`).join('; ')}`).join('. ')}. ${SAMI.length} z ${POZ.length} poprawek zespół zrobi sam, z instrukcją. Raport podpisał ${PROWADZACY.imie}, który prowadził audyt.`;

// =====================================================================
// DLACZEGO 1 · wydruk eksport.ts z uwagami
// Kod PRZYKŁADOWY. Zaznaczone miejsca: wiersz 7 (poz. 2), klamra 12–15
// (poz. 4), wiersz 17 (poz. 1) — numery liczą się z tablicy (wiersz()).
// Wiersze są szerokie na swoją treść, więc klamra stoi tuż za wierszem 12.
// t = sekunda, w której pojawia się znak.
// =====================================================================
const KOD = [
  { s: "import { baza } from '../baza';" },
  { s: "import { wyslij } from '../poczta';" },
  { s: "import { doCSV } from '../pliki';" },
  { s: '' },
  { s: 'const POCZTA = {' },
  { s: "  login: 'zamowienia'," },
  { a: '  haslo: ', m: "'Wiosna2026!'", b: ',', z: 2 },
  { s: '};' },
  { s: '' },
  { s: '// eksport zamówień dla księgowości' },
  { s: 'export async function eksport(od: Date) {' },
  { s: '  const lista = await baza.zamowienie.findMany({', kl: 4, z: 4 },
  { s: '    where: { utworzone: { gte: od } },' },
  { s: '    include: { klient: true },' },
  { s: '  });' },
  { s: '' },
  { a: "  console.log('eksport', ", m: 'lista', b: ');', z: 1 },
  { s: '' },
  { s: "  const plik = doCSV(lista, ['nr', 'nip', 'kwota']);" },
  { s: "  await wyslij(POCZTA, 'ksiegowosc@firma.pl', plik);" },
  { s: '  return lista.length;' },
  { s: '}' },
