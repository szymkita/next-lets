  .tz-k h3{margin:18px 0 0;max-width:520px;font-size:clamp(22px,2.1vw,30px);font-weight:700;letter-spacing:-0.032em;line-height:1.12;text-wrap:balance}
  .tz-dl{margin:26px 0 0}
  .tz-dl > div{display:grid;grid-template-columns:128px minmax(0,1fr);gap:16px;padding:13px 0;border-top:1px solid var(--linia)}
  .tz-dl dt{padding-top:2px;font-size:13px;font-weight:650;color:var(--t3)}
  .tz-dl dd{margin:0;font-size:15px;line-height:1.55;color:var(--t1);text-wrap:pretty}
