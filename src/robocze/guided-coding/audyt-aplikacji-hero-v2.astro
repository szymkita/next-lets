  .tz-pk li + li::before{content:"·";margin:0 7px 0 -7px;color:#a1a1aa}
  @media (max-width:980px){ .tz-uk{grid-template-columns:minmax(0,1fr)} }
  @media (max-width:520px){
    .tz-dl > div{grid-template-columns:minmax(0,1fr);gap:3px}
    .tz-pk ul{flex-direction:column;gap:2px}
    .tz-pk li + li::before{display:none}
  }

  /* =====================================================================
     PO RAPORCIE · trzy drogi
     ===================================================================== */
  .po-l{margin-top:clamp(40px,4.4vw,64px)}
  .po-w{display:grid;grid-template-columns:minmax(0,4fr) minmax(0,5.4fr) minmax(0,2.6fr);gap:14px clamp(24px,3.4vw,56px);align-items:start;padding:clamp(24px,2.8vw,36px) 0;border-top:1px solid var(--linia)}
