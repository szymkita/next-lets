    .mx-g span{display:none}
    .mx-pl{grid-column:1;margin:0 16px}
    .mx-os{grid-column:1;margin:0 16px}
    .mx-os-t{display:none}
    .mx-p em{max-width:84px;font-size:11.5px}
    .mx-p.lw em{transform:translateX(-82%)}
    .mx-p em .dl{display:none}
    .mx-p em .kr{display:inline}
    .mx-os span{font-size:11.5px}
