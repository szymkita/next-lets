<script>
  var redukcja = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- Rząd liczb: strzałki przewijają o jedną kartę (kopia z Dowody.astro).
  // Kiedy karty mieszczą się w oknie, strzałek nie ma.
  (function(){
    var sc = document.querySelector('[data-dw-sc]');
    if(!sc) return;
    var dol = document.querySelector('[data-dw-dol]');
    var wstecz = document.querySelector('[data-dw-wstecz]');
    var dalej = document.querySelector('[data-dw-dalej]');
    function krok(){ var k = sc.querySelector('.dw4-k'); return k ? k.getBoundingClientRect().width + parseFloat(getComputedStyle(sc).columnGap || 0) : 320; }
    function stan(){
      var max = sc.scrollWidth - sc.clientWidth - 2;
      if(dol) dol.style.display = max <= 0 ? 'none' : '';
      if(wstecz) wstecz.disabled = sc.scrollLeft <= 2;
      if(dalej) dalej.disabled = sc.scrollLeft >= max;
    }
    function jedz(kier){ sc.scrollBy({ left: kier * krok(), behavior: redukcja ? 'auto' : 'smooth' }); }
    if(wstecz) wstecz.addEventListener('click', function(){ jedz(-1); });
    if(dalej) dalej.addEventListener('click', function(){ jedz(1); });
    sc.addEventListener('scroll', stan, { passive: true });
    window.addEventListener('resize', stan);
    stan();
  })();

  // ---- Droga projektu: znacznik przechodzi etap po etapie ----
  // Stan z serwera to „po diagnozie" (k = 1) i on zostaje bez JS i przy
  // ograniczonym ruchu. Z ruchem: po wejściu w kadr k = 2, potem 3;
  // przycisk w rogu kafla puszcza drogę jeszcze raz.
  (function(){
    var f = document.querySelector('[data-droga]');
    if(!f || redukcja || !('IntersectionObserver' in window)) return;
    var karty = f.querySelectorAll('[data-etap]');
    var znow = f.querySelector('[data-droga-znow]');
    var timery = [];
    function ustaw(k){
      f.style.setProperty('--k', k);
      karty.forEach(function(c, i){
        c.classList.toggle('zr', i < k);
        c.classList.toggle('zn', i === k);
        c.classList.toggle('pz', i > k);
      });
    }
    function graj(){
      timery.forEach(clearTimeout); timery = [];
      ustaw(1);
      if(znow) znow.disabled = true;
      timery.push(setTimeout(function(){ ustaw(2); }, 2000));
      timery.push(setTimeout(function(){ ustaw(3); if(znow) znow.disabled = false; }, 4000));
    }
    if(znow) znow.addEventListener('click', graj);
    var io = new IntersectionObserver(function(w){
      if(!w[0].isIntersecting) return;
      io.disconnect();
      setTimeout(graj, 900);
    }, { threshold: 0.5 });
    io.observe(f);
  })();

  // ---- Konta w projekcie: „w trakcie" → „po zakończeniu" ----
  // Bez JS i przy ograniczonym ruchu zostaje stan końcowy (bez .wt).
  // Z ruchem: start „w trakcie", po wejściu w kadr przejście dalej, chyba
  // że czytelnik sam kliknął przełącznik.
  (function(){
    var f = document.querySelector('[data-konta]');
    if(!f) return;
    var guziki = f.querySelectorAll('[data-konta-st]');
    var klik = false;
    f.classList.add('js');
    function ustaw(st){
      f.classList.toggle('wt', st === 'wt');
      guziki.forEach(function(b){ b.setAttribute('aria-pressed', b.getAttribute('data-konta-st') === st ? 'true' : 'false'); });
    }
    guziki.forEach(function(b){
      b.addEventListener('click', function(){ klik = true; ustaw(b.getAttribute('data-konta-st')); });
    });
    if(redukcja || !('IntersectionObserver' in window)){ ustaw('po'); return; }
    ustaw('wt');
    var io = new IntersectionObserver(function(w){
      if(!w[0].isIntersecting) return;
      io.disconnect();
      setTimeout(function(){ if(!klik) ustaw('po'); }, 2400);
    }, { threshold: 0.45 });
    io.observe(f);
  })();
</script>
</LaBase>
