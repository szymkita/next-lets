const DOLEK = 2;                                     // trzeci tydzień (indeks w SUMY)
// stan osoby w tygodniu 0–12 (0 = punkt wyjścia z karty)
const stan = (x, k) => (k === 0 ? (x.w0 || 0) : x.w[k - 1]);
const TRASA = Array.from({ length: TYG + 1 }, (_, k) => LUDZIE.reduce((a, x) => a + stan(x, k), 0));  // 1, 14, 11, 7 … 12
