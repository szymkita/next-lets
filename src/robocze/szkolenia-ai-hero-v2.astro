<script is:inline>
  // Arkusz wypełnia się przy wejściu w kadr, raz: kolumna po kolumnie (od
  // tygodnia 0), kratki z góry na dół, suma pod kolumną liczy zielone razem
  // z nią. Po trzecim tygodniu obwódka, „dołek" i dopisek o Tomaszu; na końcu
  // zielona obwódka ostatniej kolumny, „12 z 14" i powody przy dwóch osobach.
  // .gra (stany startowe) dostaje figura tylko tutaj, więc bez JS, bez
  // IntersectionObservera i przy ograniczonym ruchu zostaje stan z markupu.
  (function(fig){
    if(!fig || !('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var RZ = 18, PRZERWA = 100, DOLEK = 3;
    var kol = [];
    Array.prototype.forEach.call(fig.querySelectorAll('[data-ak-c]'), function(c){ var k = +c.getAttribute('data-ak-c'); (kol[k] = kol[k] || []).push(c); });
    var sumy = fig.querySelectorAll('[data-ak-s]');
    var ob = fig.querySelectorAll('[data-ak-ob]');
    function czekaj(ms){ return new Promise(function(r){ setTimeout(r, ms); }); }
    function pis(n){ return Array.prototype.slice.call(fig.querySelectorAll('[data-ak-pis="' + n + '"]')); }
    // dopisek odsłania się od lewej w tempie pisania
    function napisz(els){
      var t = 0;
      els.forEach(function(el){ var s = Math.min(1.6, Math.max(0.3, el.textContent.length * 0.026)); t = Math.max(t, s); el.style.setProperty('--pt', s.toFixed(2) + 's'); el.classList.add('w'); });
      return t * 1000;
    }
    // obwódka rysowana kreską: na czas rysowania pętla w pikselach (stała
    // grubość i długość kreski), potem wraca wersja z markupu (ta sama pętla)
    function obwiedz(sp){
      var svg = sp.querySelector('svg'), p = svg.querySelector('path');
      var w = svg.clientWidth, h = svg.clientHeight, d0 = p.getAttribute('d');
      svg.setAttribute('viewBox', '0 0 ' + w + ' ' + h);
      p.setAttribute('d', d0.replace(/(-?[\d.]+),(-?[\d.]+)/g, function(_, x, y){ return (x * w / 100).toFixed(1) + ',' + (y * h / 1000).toFixed(1); }));
      p.removeAttribute('vector-effect');
      p.setAttribute('pathLength', '1');
      p.style.strokeDasharray = '1 1';
      p.style.strokeDashoffset = '1';
      sp.classList.add('w');
      p.getBoundingClientRect();
      p.style.transition = 'stroke-dashoffset .8s cubic-bezier(.45,0,.3,1)';
      p.style.strokeDashoffset = '0';
      setTimeout(function(){
        p.style.transition = ''; p.style.strokeDasharray = ''; p.style.strokeDashoffset = '';
        p.removeAttribute('pathLength'); p.setAttribute('vector-effect', 'non-scaling-stroke');
        p.setAttribute('d', d0); svg.setAttribute('viewBox', '0 0 100 1000');
      }, 950);
    }
    fig.classList.add('gra');
    Array.prototype.forEach.call(sumy, function(s){ s.setAttribute('data-v', s.textContent); s.textContent = ''; });
    async function graj(){
      await czekaj(450);
      for(var k = 0; k < kol.length; k++){
        // kolumna schowana (telefon: tygodnie 0–2) — od razu, bez czekania
        if(!kol[k][0].getClientRects().length){ kol[k].forEach(function(c){ c.classList.add('w'); }); sumy[k].textContent = sumy[k].getAttribute('data-v'); continue; }
        (function(k){
          var n = 0, s = sumy[k];
          kol[k].forEach(function(c, r){
            setTimeout(function(){
              c.classList.add('w');
              if(c.getAttribute('data-s') === 'z'){ n++; s.textContent = n; s.classList.add('w'); }
            }, r * RZ);
          });
        })(k);
        await czekaj(kol[k].length * RZ + PRZERWA);
        if(k === DOLEK){
          await czekaj(150);
          obwiedz(ob[0]); await czekaj(700);
          await czekaj(napisz(pis('dl')));
          await czekaj(napisz(pis('not')) + 600);
        }
      }
      await czekaj(250);
      obwiedz(ob[1]); await czekaj(800);
      await czekaj(napisz(pis('kon')) + 250);
      var pw = pis('pw');
      for(var i = 0; i < pw.length; i++){ await czekaj(napisz([pw[i]]) * 0.6); }
    }
    var io = new IntersectionObserver(function(w){ if(w[0].isIntersecting){ io.disconnect(); graj(); } }, { threshold: 0.2 });
    io.observe(fig);
  })(document.currentScript.previousElementSibling);
</script>
</Hero>

