// z karty): 1 = w tym tygodniu osoba wyceniła prawdziwe zapytanie nowym
// sposobem (tak albo nie z przeglądu z liderem). Kolejność według grup
// z §8: 5 pociągnęło samo, 7 ruszyło z gotową ścieżką, 2 zostały przy
// starym sposobie. bez = tydzień, od którego osoba nie wycenia wcale (pusta
// kratka na arkuszu w hero).
// lg = ostatnie logowanie w trzecim tygodniu (raport panelu), uw = uwaga
// lidera w przeglądzie z trzeciego tygodnia.
// ZDJĘCIA ZASTĘPCZE (zob. nagłówek): /team i /makieta.
const TYG = 12;
const W = (s) => s.split('').map(Number);
const T = (n) => `/team/${n}.png`;
const LUDZIE = [
