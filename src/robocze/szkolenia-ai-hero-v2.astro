const NOWY = GRUPY[0].idx.length + GRUPY[1].idx.length;   // 5 + 7 = 12, to samo co KONIEC

// ---- HERO · arkusz zespołu z przeglądów z liderem -------------------------
// Wydruk na jeden kwartał: wiersz = osoba (kolejność jak w LUDZIE), kolumna =
// tydzień 0–12 (0 = punkt wyjścia z karty). Lider co tydzień zamalowuje
// kratkę mazakiem: z = wyceniła prawdziwe zapytanie nowym sposobem (stan 1),
// a = wyceniała po staremu, w arkuszu (stan 0), p = nie wyceniała wcale (od
// tygodnia x.bez). Zielonych w kolumnie jest tyle, ile w TRASA.
const AK_TYG = Array.from({ length: TYG + 1 }, (_, k) => k);
const akStan = (x, k) => (stan(x, k) ? 'z' : x.bez != null && k >= x.bez ? 'p' : 'a');
// etapy programu nad kolumnami (druk); „dołek" nad trzecim tygodniem dopisuje
// lider długopisem
const AK_ETAPY = [{ k: 0, t: 'karta' }, { k: 1, t: 'warsztat' }, { k: 4, t: 'powrót' }, { k: TYG, t: 'pomiar' }];
const AK_DYZUR = [5, 11];
// kolumna siatki: 1 = osoby, 2…14 = tygodnie 0–12, 15 = uwagi
const akKol = (k) => k + 2;
// Kratka zamalowana ręką: każda trochę inna (obrót, krawędzie), ale
// powtarzalnie — ten sam układ przy każdym renderze.
const akLos = (a, b) => { const s = Math.sin(a * 12.9898 + b * 78.233) * 43758.5453; return s - Math.floor(s); };
const akMazak = (i, k) => {
