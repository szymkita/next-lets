const PROG = 92;
const KOLEJKA = [
  { t: 'Faktura kosztowa 4471/08', z: 'FV 4471/08', p: 97, ok: true, g: '09:12', w: 'zaksięgowana bez dotknięcia' },
  { t: 'Zapytanie ofertowe z poczty', z: 'ZO 2211', p: 93, ok: true, g: '09:31', w: 'wycena wyszła w cztery minuty' },
