                <span class="cb"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8l-6.5 6.5a2.5 2.5 0 003.5 3.5L21 11a4.5 4.5 0 00-6.4-6.4L7 12"/></svg></span>
