<section class="ap-roll" id="wdrozenie">
  <div class="wdr-bg" aria-hidden="true"><div class="wdr-scrim"></div></div>
  <div class="ap-wrap">
    <div class="dk-grid">
      <div>
        <h2 class="dk-h">Jak chcecie wdrożyć appto?</h2>
        <ul class="sw-list" id="wdrRail" role="tablist" aria-label="Ścieżka wdrożenia">
          {WDR.map((w, i) => (
            <li><button type="button" role="tab" class:list={['sw-item', i === 1 && 'is-active']} aria-selected={i === 1 ? 'true' : 'false'} data-i={i}><span class="sw-arrow"><svg viewBox="0 0 24 24" fill="none"><path d="M4 12h15M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span>{w.nm}</span></button></li>
          ))}
        </ul>
      </div>
      <div class="rl-col">
        <p class="rl-text" id="wdrText" aria-live="polite">{WDR[1].t}</p>
        <div class="wdr-sw-cta">
          <a href="#kontakt" class="wdr-btn">Porozmawiajmy o wdrożeniu <svg viewBox="0 0 24 24" fill="none"><path d="M4 12h15M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          <a href={TRIAL} target="_blank" rel="noopener" class="wdr-link">Załóż konto za darmo <svg viewBox="0 0 24 24" fill="none"><path d="M4 12h15M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════════ ŻÓŁTY PAS ═════════ -->
<section class="fp-cta">
  <div class="ap-wrap">
    <div class="fp-cta-in">
      <div>
        <h2>Pierwszy agent jeszcze dziś</h2>
        <p>Weźcie zadanie, które ktoś w zespole robi co tydzień tak samo. <b>Jedno zdanie wystarczy, żeby powstał agent</b>, a resztę zobaczycie po pierwszym wyniku.</p>
        <div class="ap-acts">
          <a class="ap-btn ap-btn--pri" href={TRIAL} target="_blank" rel="noopener">Załóż konto za darmo <svg class="ap-arr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ARR} /></a>
          <a class="ap-btn ap-btn--sec" href="#kontakt">Umów pokaz</a>
        </div>
        <p class="fp-cta-n">Konto bez karty, zakładane w 30 sekund.</p>
      </div>
      <div class="fh-cta-art" aria-hidden="true">
        {ZDANIA.flat().map((f) => <span>{f.nm}</span>)}
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════ FAQ ═════════ -->
<section class="fp-sec" id="faq">
  <div class="ap-wrap">
    <div class="fp-faq-in">
      <div>
        <h2>Pytania, które padają przy appto</h2>
        <p>Najczęstsze z rozmów wdrożeniowych. Pełna lista integracji i cennik stoją na <a href="https://appto.ai/pl/" target="_blank" rel="noopener">appto.ai</a>.</p>
      </div>
      <div>
        {FAQ.map((f) => (
          <details class="fp-q">
            <summary>{f.q}<span class="fp-q-t" aria-hidden="true"></span></summary>
            <p class="fp-q-a">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

</div>

<GcCta
  usluga="Appto"
  heading="Pokażemy appto na Waszej sprawie"
  lead="Weźcie jedno prawdziwe zapytanie ofertowe albo jedno zgłoszenie od klienta. Na nim widać w pół godziny, czy to się u Was spina."
  eyebrow="Z pokazu wychodzicie z"
  items={[
    { t: 'Listą pierwszych zadań dla agentów', d: 'trzy rzeczy, które da się oddać w pierwszym tygodniu' },
    { t: 'Listą dokumentów do zebrania', d: 'co musi trafić do kontekstu, żeby odpowiedzi były Wasze' },
    { t: 'Kosztem', d: 'zużycie i koszt wdrożenia, policzone osobno' },
  ]}
  fieldLabel="Co chcecie oddać agentom?"
  placeholder="Np. oferty na konstrukcje stalowe, 40 zapytań miesięcznie, wszystko ręcznie…"
  badges={[
    { i: 'klodka', t: 'Dane w Unii Europejskiej' },
    { i: 'kartka', t: 'DPA przed startem' },
    { i: 'ptaszek', t: 'Modele nie uczą się na Waszych danych' },
  ]}
/>

<script is:inline define:vars={{ MODELS: MODELS.map((m) => ({ nm: m.nm, d: m.d })), WDR }}>
  /* Wejścia sekcji liczone na scrollu, nie IntersectionObserverem — przy
     szybkim przewijaniu IO potrafi nie dowieźć wpisu (ta sama pętla co na
     podstronach funkcji appto). */
  (function () {
    var pending = Array.prototype.slice.call(document.querySelectorAll('.ap [data-reveal]'));
    if (!pending.length) return;
    var queued = false;
    function run() {
      queued = false;
      pending = pending.filter(function (el) {
        if (el.getBoundingClientRect().top > innerHeight * 0.85) return true;
        el.classList.add('is-in');
        return false;
      });
      if (!pending.length) removeEventListener('scroll', onScroll);
    }
    function onScroll() { if (!queued) { queued = true; requestAnimationFrame(run); } }
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    run();
  })();

  /* Ekran okna Kontekstu jest rysowany w stałym formacie i skalowany do
     szerokości okna, więc łamanie tekstu jest takie samo na każdym ekranie. */
  (function () {
    var win = document.getElementById('k3Win');
    var screen = document.getElementById('k3Screen');
    if (!win || !screen) return;
    function fit() { screen.style.setProperty('--s', win.clientWidth / screen.offsetWidth); }
    fit();
    if ('ResizeObserver' in window) new ResizeObserver(fit).observe(win);
    else addEventListener('resize', fit);
  })();

  /* „Czym jest appto" — zdania rozjaśniają się po kolei wraz ze scrollem. */
  (function () {
    var box = document.getElementById('apRev');
    if (!box) return;
    var s = Array.prototype.slice.call(box.querySelectorAll('.s'));
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var queued = false;
    function paint() {
      queued = false;
      var r = box.getBoundingClientRect();
      var p = (innerHeight * 0.88 - r.top) / (r.height + innerHeight * 0.3);
      p = Math.max(0, Math.min(1, p)) * s.length;
      s.forEach(function (el, i) { el.style.opacity = String(Math.max(0.14, Math.min(1, p - i))); });
    }
    function req() { if (!queued) { queued = true; requestAnimationFrame(paint); } }
    addEventListener('scroll', req, { passive: true });
    addEventListener('resize', req);
    paint();
  })();

  /* Praca w tle: jedna liczba p (0→1) prowadzi odhaczanie kroków,
     przewijanie dziennika, pasek i liczniki. */
  (function () {
    var root = document.getElementById('agFlow');
    var track = document.getElementById('agLog');
    var bar = document.getElementById('agBar');
    var src = document.getElementById('agSrc');
    var tls = document.getElementById('agTls');
    var state = document.getElementById('agState');
    if (!root || !track || !bar) return;
    var rows = Array.prototype.slice.call(track.children);
    var RUN_MS = 12000, SRC_MAX = 24, TLS_MAX = 6, VIS = 4, shown = -1;
    function paint(p) {
      bar.style.transform = 'scaleX(' + Math.min(p, 1) + ')';
      src.textContent = String(Math.round(p * SRC_MAX));
      tls.textContent = String(Math.max(1, Math.round(p * TLS_MAX)));
      var n = Math.min(rows.length - 1, Math.floor(p * rows.length));
      state.textContent = p >= 1 ? 'gotowe' : 'pracuje';
      state.classList.toggle('is-done', p >= 1);
      if (n === shown) return;
      shown = n;
      rows.forEach(function (r, i) { r.classList.toggle('is-done', i < n || p >= 1); r.classList.toggle('is-now', i === n); });
      var off = Math.max(0, n - (VIS - 1)) * rows[0].offsetHeight;
      track.style.transform = 'translateY(' + (-off) + 'px)';
    }
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { paint(1); return; }
    var raf = null, t0 = 0;
    function tick(now) {
      if (!t0) t0 = now;
      var q = ((now - t0) % RUN_MS) / RUN_MS;
      paint(Math.min(q / 0.9, 1));
      raf = requestAnimationFrame(tick);
    }
    paint(0);
    function play() { if (!raf) { t0 = 0; raf = requestAnimationFrame(tick); } }
    function stop() { cancelAnimationFrame(raf); raf = null; }
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (e) { e[0].isIntersecting ? play() : stop(); }, { threshold: .2 }).observe(root);
    } else play();
  })();

  /* Karta „Model": wybór przechodzi po dopuszczonych modelach. */
  (function () {
    var box = document.getElementById('agLimMs');
    var nm = document.getElementById('agLimNm');
    var d = document.getElementById('agLimD');
    if (!box || !nm || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var tiles = Array.prototype.slice.call(box.children), k = 0, timer = null;
    function set(n) {
      k = n;
      tiles.forEach(function (t, i) { t.classList.toggle('is-on', i === n); });
      nm.textContent = MODELS[n].nm; d.textContent = MODELS[n].d;
      nm.classList.remove('is-fresh'); void nm.offsetWidth; nm.classList.add('is-fresh');
    }
    function play() { if (!timer) timer = setInterval(function () { set((k + 1) % tiles.length); }, 2600); }
    function stop() { clearInterval(timer); timer = null; }
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (e) { e[0].isIntersecting ? play() : stop(); }, { threshold: .3 }).observe(box);
    }
  })();

  /* Wdrożenie: przełącznik ścieżek, tekst „nalewa się" słowami. */
  (function () {
    var rail = document.getElementById('wdrRail');
    var text = document.getElementById('wdrText');
    if (!rail || !text) return;
    var items = Array.prototype.slice.call(rail.querySelectorAll('.sw-item'));
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    function render(i) {
      items.forEach(function (t, k) {
        var on = k === i;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      var words = WDR[i].t.split(' ');
      text.classList.remove('in');
      text.innerHTML = words.map(function (w, k) {
        return '<span class="w" style="transition-delay:' + (k * 24) + 'ms">' + w + '</span>';
      }).join(' ');
      if (reduce) { text.classList.add('in'); return; }
      void text.offsetWidth;
      requestAnimationFrame(function () { text.classList.add('in'); });
    }
    items.forEach(function (b, i) { b.addEventListener('click', function () { render(i); }); });
  })();
</script>
</LaBase>
