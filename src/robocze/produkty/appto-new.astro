// z faz /pl/wdrozenie-indywidualne („Plan wdrożenia na miarę + wycena”,
// „Działające narzędzia AI”, „Cały zespół pracuje z AI”, „Zespół rozwija
// temat dalej, bez nas”) i z kohorty („+90 dni: wskaźniki zestawione
// z punktem startu”).
const ETAPY = [
  { n: 'Diagnoza', kroki: ['Audyt procesów', 'Wybór zastosowań'], wynik: 'Mapa procesów z liczbą godzin w tygodniu i plan wdrożenia' },
  { n: 'Budowa', kroki: ['Konfiguracja asystentów', 'Baza wiedzy firmy', 'Podłączenie narzędzi'], wynik: 'Asystenci na procesach, które zabierają najwięcej czasu, z wiedzą firmy i podłączonymi narzędziami' },
  { n: 'Pilotaż', kroki: ['Szkolenie zespołów', 'Pilotaż w dziale'], wynik: 'Jeden dział pracuje w Appto na własnych zadaniach' },
  { n: 'Cała firma', kroki: ['Wdrożenie w firmie', 'Pomiar i wyniki', 'Adopcja i rozwój'], wynik: 'Wyniki zestawione z punktem startu i ludzie, którzy sami budują kolejnych asystentów' },
];
// Numer pierwszego kroku etapu (0–9) — do kolumn siatki i opóźnień animacji.
let licz = 0;
const ETAPY_S = ETAPY.map((e) => { const od = licz; licz += e.kroki.length; return { ...e, od }; });

