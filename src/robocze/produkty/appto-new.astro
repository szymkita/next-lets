const dane = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      '@id': `${kanon}#aplikacja`,
      name: 'Appto',
      alternateName: ['appto', 'appto.ai'],
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      url: kanon,
      sameAs: ['https://appto.ai'],
      description: 'Platforma AI dla całej firmy, zbudowana w Let’s automate, wdrażana według metody w czterech etapach: diagnoza, budowa, pilotaż w jednym dziale i cała firma.',
      publisher: { '@id': new URL('/#organizacja', Astro.site).href },
    },
    {
      '@type': 'VideoObject',
      name: 'Poznaj appto',
