---
<LaBase topbar={false} title={title} description={description} ctaLabel="Umów rozmowę" nav={null}>
<script type="application/ld+json" is:inline set:html={JSON.stringify(dane)} slot="head"></script>

<style is:global slot="head">
  /* Style tej strony. Wspólny wygląd: src/components/usluga/Styl.astro. */

  /* ---- hero: film „Poznaj appto" (YouTube) ----
     Podgląd z miniaturą; odtwarzacz (youtube-nocookie) ładuje się dopiero po
     kliknięciu. Bez JS link prowadzi do filmu na YouTube. */
  .yt{position:relative;display:block;width:100%;aspect-ratio:16 / 9;border-radius:clamp(10px,1.2vw,18px);overflow:hidden;background:#0b0f0c;cursor:pointer;
    box-shadow:0 0 0 1px rgba(255,255,255,0.14),0 0 0 1.5px rgba(0,0,0,0.3),0 50px 100px -40px rgba(0,0,0,0.9),0 18px 36px -20px rgba(0,0,0,0.55)}
  .yt img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.2,.8,.2,1)}
  .yt::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(7,20,13,0) 55%,rgba(7,20,13,0.55) 100%);pointer-events:none}
  .yt-play{position:absolute;z-index:1;left:50%;top:50%;display:flex;align-items:center;gap:14px;transform:translate(-50%,-50%);padding:10px 26px 10px 10px;border-radius:999px;background:var(--ziel);color:var(--ink);font-size:16px;font-weight:700;letter-spacing:-0.01em;white-space:nowrap;box-shadow:0 20px 40px -16px rgba(0,0,0,0.6);transition:transform .25s ease,background .2s}
  .yt-play i{display:grid;place-items:center;width:46px;height:46px;border-radius:50%;background:var(--ink);color:var(--ziel)}
  .yt-play svg{width:18px;height:18px;margin-left:3px;fill:currentColor}
  .yt-meta{position:absolute;z-index:1;left:clamp(16px,2vw,28px);bottom:clamp(14px,1.8vw,24px);font-size:14px;font-weight:600;color:rgba(255,255,255,0.85)}
  .yt:hover img{transform:scale(1.02)}
  .yt:hover .yt-play{transform:translate(-50%,-50%) scale(1.04);background:#25dd8b}
  .yt:focus-visible{outline:2px solid var(--ziel);outline-offset:4px}
  .yt iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
  .yt.gra::after,.yt.gra .yt-play,.yt.gra .yt-meta{display:none}
  @media (max-width:560px){ .yt-play{padding:8px 18px 8px 8px;font-size:14px} .yt-play i{width:38px;height:38px} .yt-meta{display:none} }

  /* =====================================================================
     METODA · dziesięć kroków w czterech etapach
     Jedna linia przez wszystkie kroki; nad nią klamry etapów, pod krokami
     białe karty z tym, co zostaje w firmie. Linia zapala się od lewej
     liniowo (--krok na węzeł), węzły w jej takt, nagłówek etapu z pierwszym
     węzłem, karta po ostatnim. Poniżej 1180 px etapy stoją w siatce bez linii.
     ===================================================================== */
  .mt4{--eh:62px;--krok:.24s;position:relative;display:grid;grid-template-columns:repeat(10,minmax(0,1fr));margin:0 clamp(2px,0.8vw,14px)}
  .mt4::before,.mt4::after{content:"";position:absolute;left:5%;right:5%;top:calc(var(--eh) + 19px);height:2px;border-radius:1px}
  .mt4::before{background:rgba(15,26,20,0.12)}
  .mt4::after{background:var(--ziel);transform-origin:0 50%}
  .mt4-e{grid-column:var(--a) / var(--b);display:flex;flex-direction:column;min-width:0}
  .mt4-gl{position:relative;height:var(--eh);display:flex;flex-direction:column;align-items:center;padding:0 8px;text-align:center}
  .mt4-gl span{font-size:12.5px;font-weight:700;color:var(--ziel-c)}
  .mt4-gl b{margin-top:2px;font-size:17px;font-weight:700;letter-spacing:-0.018em;color:var(--t1)}
  .mt4-gl::after{content:"";position:absolute;left:calc(50% / var(--n));right:calc(50% / var(--n));bottom:8px;height:7px;border:1.5px solid rgba(15,26,20,0.32);border-bottom:0;border-radius:3px 3px 0 0}
  .mt4-k{display:grid;grid-template-columns:repeat(var(--n),minmax(0,1fr));margin:0;padding:0;list-style:none}
  .mt4-k li{position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;gap:14px;padding:0 6px;text-align:center}
  .mt4-k i{display:grid;place-items:center;width:40px;height:40px;border-radius:50%;background:#ffffff;box-shadow:0 0 0 2px var(--ziel),0 0 0 7px var(--papier);font-style:normal;font-size:13px;font-weight:700;color:var(--ziel-c)}
  .mt4-k b{font-size:14.5px;font-weight:650;letter-spacing:-0.01em;line-height:1.3;color:var(--t1);text-wrap:balance}
  .mt4-wy{flex:1;margin:clamp(26px,2.6vw,36px) 6px 0;padding:16px 18px 18px;border-radius:16px;background:#ffffff;box-shadow:0 1px 0 rgba(15,26,20,0.04),0 22px 40px -28px rgba(15,26,20,0.32)}
  .mt4-wy span{display:flex;align-items:center;gap:8px;font-size:12.5px;font-weight:650;color:var(--t3)}
  .mt4-wy span::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--ziel)}
  .mt4-wy p{margin:8px 0 0;font-size:14.5px;line-height:1.5;font-weight:600;letter-spacing:-0.006em;color:var(--t1);text-wrap:pretty}
  .mt4.gra::after{transform:scaleX(0)}
  .mt4.gra .mt4-k li,.mt4.gra .mt4-gl{opacity:0;translate:0 8px}
  .mt4.gra .mt4-wy{opacity:0;translate:0 14px}
  .mt4.gra.on::after{transform:none;transition:transform calc(var(--krok) * 9) linear .2s}
  .mt4.gra.on .mt4-k li{opacity:1;translate:0 0;transition:opacity .4s ease calc(0.2s + var(--j) * var(--krok)),translate .5s cubic-bezier(.2,.8,.2,1) calc(0.2s + var(--j) * var(--krok))}
  .mt4.gra.on .mt4-gl{opacity:1;translate:0 0;transition:opacity .4s ease calc(0.1s + var(--j0) * var(--krok)),translate .5s cubic-bezier(.2,.8,.2,1) calc(0.1s + var(--j0) * var(--krok))}
  .mt4.gra.on .mt4-wy{opacity:1;translate:0 0;transition:opacity .5s ease calc(0.45s + var(--j1) * var(--krok)),translate .6s cubic-bezier(.2,.8,.2,1) calc(0.45s + var(--j1) * var(--krok))}
  @media (max-width:1180px){
    .mt4{grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(28px,4vw,44px) clamp(16px,2.4vw,28px)}
    .mt4::before,.mt4::after{display:none}
    .mt4-e{grid-column:auto}
    .mt4-gl{height:auto;flex-direction:row;align-items:baseline;gap:10px;padding:0 0 14px;margin-bottom:6px;border-bottom:1.5px solid var(--t1);text-align:left}
    .mt4-gl::after{display:none}
    .mt4-k{grid-template-columns:minmax(0,1fr)}
    .mt4-k li{flex-direction:row;gap:14px;padding:8px 0;text-align:left}
    .mt4-k i{flex-shrink:0;width:34px;height:34px;font-size:12px;box-shadow:0 0 0 2px var(--ziel)}
    .mt4-wy{flex:0 0 auto;margin:14px 0 0}
  }
  @media (max-width:640px){ .mt4{grid-template-columns:minmax(0,1fr)} }

  /* =====================================================================
     TRZY DROGI · te same trzy wiersze w każdej karcie
     Środkowa (z opiekunem) szersza: usługę docelową wyróżnia szerokość.
     ===================================================================== */
  .dr{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.3fr) minmax(0,1fr);gap:clamp(14px,1.6vw,22px);margin-top:clamp(28px,3vw,40px)}
  .dr-k{display:flex;flex-direction:column;padding:clamp(22px,2.4vw,30px);border-radius:22px;background:var(--papier)}
  .dr-k h4{margin:0;font-size:clamp(20px,1.8vw,24px);font-weight:700;letter-spacing:-0.025em;line-height:1.15}
  .dr-k > p{margin:12px 0 0;font-size:15.5px;line-height:1.6;color:var(--t2);text-wrap:pretty}
  .dr-k dl{margin:20px 0 0;border-top:1px solid var(--linia)}
  .dr-k dl div{display:grid;grid-template-columns:76px minmax(0,1fr);gap:12px;padding:11px 0;border-bottom:1px solid var(--linia2)}
  .dr-k dt{font-size:13px;font-weight:650;line-height:1.5;color:var(--t3)}
  .dr-k dd{margin:0;font-size:14.5px;line-height:1.5;color:var(--t1);text-wrap:pretty}
  .dr-k a{align-self:flex-start;margin-top:auto;padding:24px 0 2px;font-size:15px;font-weight:650;color:var(--t1);border-bottom:1px solid rgba(15,26,20,0.25);transition:border-color .2s}
  .dr-k a:hover{border-color:var(--ziel-c)}
  @media (max-width:900px){ .dr{grid-template-columns:minmax(0,1fr)} }

  /* =====================================================================
     JEDNO WDROŻENIE · pięć przystanków na jednej linii (ciemna scena)
     Duża liczba w bieli, wartość sprzed wdrożenia przekreślona w bursztynie
     (bursztyn = stan „przed” na całej stronie). Linia zapala się od lewej,
     kropki przystanków w jej takt. Poniżej 900 px linia idzie w dół.
     ===================================================================== */
  .cs{--krok:.5s;position:relative;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:0 clamp(18px,2.4vw,40px);margin:clamp(52px,5.4vw,80px) 0 0;padding:0;list-style:none}
  .cs::before,.cs::after{content:"";position:absolute;left:8px;right:0;top:7px;height:2px;border-radius:1px}
  .cs::before{background:rgba(255,255,255,0.14)}
  .cs::after{background:var(--ziel);transform-origin:0 50%}
  .cs-p{position:relative;padding-top:38px}
  .cs-p::before{content:"";position:absolute;left:0;top:0;width:16px;height:16px;border-radius:50%;background:var(--ziel);box-shadow:0 0 0 5px var(--ink),0 0 18px rgba(0,205,119,0.55)}
  .cs-k{font-size:13.5px;font-weight:650;color:rgba(255,255,255,0.62)}
  .cs-l{display:flex;align-items:baseline;flex-wrap:wrap;gap:2px 10px;margin-top:18px}
  .cs-l s{width:100%;font-size:15px;font-weight:600;color:var(--burs-j);text-decoration-thickness:1.5px}
  .cs-l s.cs-pusty{visibility:hidden}
  .cs-l b{font-size:clamp(44px,4.6vw,68px);font-weight:700;letter-spacing:-0.05em;line-height:0.95;color:#ffffff}
  .cs-l small{font-size:15px;font-weight:600;letter-spacing:-0.01em;color:rgba(255,255,255,0.78)}
  .cs-d{margin:16px 0 0;font-size:15px;line-height:1.58;color:rgba(255,255,255,0.68);text-wrap:pretty}
  .cs.gra::after{transform:scaleX(0)}
  .cs.gra .cs-p{opacity:0;translate:0 10px}
  .cs.gra .cs-p::before{background:var(--ink);box-shadow:0 0 0 5px var(--ink),inset 0 0 0 2px rgba(255,255,255,0.3)}
  .cs.gra.on::after{transform:none;transition:transform calc(var(--krok) * 5) linear .2s}
  .cs.gra.on .cs-p{opacity:1;translate:0 0;transition:opacity .5s ease calc(0.1s + var(--j) * var(--krok)),translate .6s cubic-bezier(.2,.8,.2,1) calc(0.1s + var(--j) * var(--krok))}
  .cs.gra.on .cs-p::before{background:var(--ziel);box-shadow:0 0 0 5px var(--ink),0 0 18px rgba(0,205,119,0.55);transition:background .3s ease calc(0.2s + var(--j) * var(--krok)),box-shadow .3s ease calc(0.2s + var(--j) * var(--krok))}
  @media (max-width:900px){
    .cs{grid-template-columns:minmax(0,1fr);row-gap:36px}
    .cs::before,.cs::after{left:7px;right:auto;top:8px;bottom:8px;width:2px;height:auto}
    .cs::after{transform-origin:50% 0}
    .cs.gra::after{transform:scaleY(0)}
    .cs-p{padding:0 0 0 40px}
    .cs-l{margin-top:10px}
  }
</style>

