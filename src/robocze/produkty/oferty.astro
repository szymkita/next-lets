  .ex-pd .od-slonce .f{animation:none}
  .ex.gra .ex-w{transform:translateY(calc(var(--i) * -80px))}
  .ex.gra .ex-t{opacity:0;transform:translateX(-10px)}
  .ex.gra.on .ex-w{transform:none;transition:transform 1.3s cubic-bezier(.2,.8,.2,1) calc(.2s + var(--i) * .04s)}
  .ex.gra.on .ex-t{opacity:1;transform:none;transition:opacity .5s ease calc(.9s + var(--i) * .12s),transform .5s ease calc(.9s + var(--i) * .12s)}
  .pp-op{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(20px,3vw,48px);margin-top:clamp(12px,2vw,24px)}
  .pp-op div{padding-top:16px;border-top:3px solid var(--k)}
