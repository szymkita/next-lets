  .pp-op b{display:block;font-size:17px;font-weight:700;letter-spacing:-0.015em}
  .pp-op p{margin:6px 0 0;font-size:15px;line-height:1.6;color:var(--t2);text-wrap:pretty}
  @media (max-width:1180px){
    .ex-w{grid-template-columns:minmax(0,1fr) 440px minmax(0,0.3fr);height:96px}
    .ex-w:first-child{height:124px}
    .ex-3d{width:400px}
    .ex-pd{zoom:0.4}
    .ex-t{padding-right:72px}
    .ex-t::after{width:50px}
  }
  @media (max-width:860px){
    .ex{padding:0}
    .ex-w,.ex-w:first-child{grid-template-columns:minmax(0,1fr);height:auto;margin-top:28px}
    .ex-t{grid-column:1;justify-self:start;max-width:none;padding:0 0 12px;text-align:left}
    .ex-t::after{display:none}
    .ex-pl{grid-column:1;height:auto}
    .ex-3d{position:relative;left:0;top:0;width:100%;transform:none}
    .ex-3d::before{transform:translate(0,6px);z-index:-1}
    .ex-3d::after{display:none}
    .ex-pd{zoom:0.34}
    .ex.gra .ex-w,.ex.gra .ex-t{transform:none;opacity:1}
    .pp-op{grid-template-columns:minmax(0,1fr)}
  }

  @media (prefers-reduced-motion:reduce){ .od-pisze i{animation:none} }
</style>

