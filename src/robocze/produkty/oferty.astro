<script>
  var redukcja = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- HERO: klient czyta ofertę, pyta czat, akceptuje ----
  // Markup trzyma stan końcowy: czat otwarty z odpowiedzią, paski planu
  // i budżetu pełne.
  (function(){
    var fig = document.querySelector('[data-oh]');
    if(!fig || redukcja || !('IntersectionObserver' in window)) return;
    var str = fig.querySelector('[data-oh-str]');
    var czat = fig.querySelector('[data-oh-czat]');
    var q = fig.querySelector('[data-oh-m="q"]'), a = fig.querySelector('[data-oh-m="a"]');
    var pisze = fig.querySelector('[data-oh-pisze]');
    var sheet = fig.querySelector('[data-oh-sheet]');
    var pasek = fig.querySelector('[data-oh-pasek]');
    var pow = fig.querySelector('[data-oh-pow]');
    var bieg = 0, widoczny = false, gra = false;
    fig.classList.add('gra');
    function przycisk(n){ return fig.querySelector('[data-oh-b="' + n + '"]'); }
    function wcisnij(n){ var b = przycisk(n); b.classList.add('wcis'); setTimeout(function(){ b.classList.remove('wcis'); }, 380); }
    function przewin(k){
      var cel = k ? fig.querySelector('[data-oh-k="' + k + '"]') : null;
      str.style.transform = cel ? 'translateY(' + (-(cel.offsetTop - 18)) + 'px)' : 'none';
    }
    function czekaj(ms, nr){ return new Promise(function(r){ setTimeout(function(){ r(nr === bieg); }, ms); }); }
    function reset(){
      str.style.transition = 'none'; przewin(null); void str.offsetWidth; str.style.transition = '';
      czat.classList.add('zam'); q.classList.add('ukr'); a.classList.add('ukr'); pisze.classList.remove('on');
      sheet.classList.add('zam'); pasek.classList.remove('po'); pow.classList.add('zam');
      fig.classList.remove('plan', 'cena');
    }
    async function przebieg(){
      var nr = ++bieg; reset();
      if(!await czekaj(2400, nr)) return;
      przewin('syt');
      if(!await czekaj(2800, nr)) return;
      przewin('plan'); fig.classList.add('plan');
      if(!await czekaj(3200, nr)) return;
      przewin('cena'); fig.classList.add('cena');
      if(!await czekaj(2600, nr)) return;
      wcisnij('ai');
      if(!await czekaj(300, nr)) return;
      czat.classList.remove('zam');
      if(!await czekaj(700, nr)) return;
      q.classList.remove('ukr');
      if(!await czekaj(600, nr)) return;
      pisze.classList.add('on');
      if(!await czekaj(1300, nr)) return;
      pisze.classList.remove('on'); a.classList.remove('ukr');
      if(!await czekaj(3600, nr)) return;
      czat.classList.add('zam');
      if(!await czekaj(600, nr)) return;
      wcisnij('acc');
      if(!await czekaj(300, nr)) return;
      sheet.classList.remove('zam');
      if(!await czekaj(1700, nr)) return;
      wcisnij('tak');
      if(!await czekaj(350, nr)) return;
      sheet.classList.add('zam'); pasek.classList.add('po');
      if(!await czekaj(700, nr)) return;
      pow.classList.remove('zam');
      if(!await czekaj(4200, nr)) return;
      if(widoczny) przebieg(); else gra = false;
    }
    new IntersectionObserver(function(w){
      widoczny = w[0].isIntersecting;
      if(widoczny && !gra){ gra = true; przebieg(); }
    }, { threshold: 0.25 }).observe(fig);
  })();

  // ---- „Jeszcze raz" w kaflach z ruchem jednorazowym ----
  document.querySelectorAll('[data-znow]').forEach(function(b){
    b.addEventListener('click', function(){
      var f = b.closest('[data-anim]');
      f.classList.add('bez'); f.classList.remove('on');
      void f.offsetWidth;
      f.classList.remove('bez');
      requestAnimationFrame(function(){ f.classList.add('on'); });
    });
  });

  // ---- Zakładki widoków ----
  (function(){
    var zak = [].slice.call(document.querySelectorAll('[data-zak]'));
    if(!zak.length) return;
    var widoki = document.querySelectorAll('[data-widok]');
    var podpisy = document.querySelectorAll('[data-podpis]');
    function pokaz(i, fokus){
      zak.forEach(function(b, j){ b.setAttribute('aria-selected', i === j ? 'true' : 'false'); b.tabIndex = i === j ? 0 : -1; });
      widoki.forEach(function(w, j){ w.hidden = i !== j; });
      podpisy.forEach(function(p, j){ p.hidden = i !== j; });
      if(fokus) zak[i].focus();
    }
    zak.forEach(function(b, i){
      b.addEventListener('click', function(){ pokaz(i); });
      b.addEventListener('keydown', function(e){
        if(e.key === 'ArrowRight'){ e.preventDefault(); pokaz((i + 1) % zak.length, true); }
        if(e.key === 'ArrowLeft'){ e.preventDefault(); pokaz((i - 1 + zak.length) % zak.length, true); }
      });
    });
  })();
</script>
