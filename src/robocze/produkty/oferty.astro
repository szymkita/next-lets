<style is:global slot="head">
  /* Style tej strony. Wspólny wygląd: src/components/usluga/Styl.astro. */
  .of{--j1:#151b17;--j2:#4e5751;--j3:#838b86;--j4:#b4bab6;--jl:rgba(21,27,23,0.08);--jl2:rgba(21,27,23,0.05);--wz:#00CD77;--wzc:#0a7a52;
    position:relative;margin:0;font-size:12.5px;line-height:1.45;letter-spacing:-0.004em;color:var(--j1);-webkit-font-smoothing:antialiased}
  .of .hi{display:block;flex-shrink:0;width:16px;height:16px;fill:currentColor}
  .of img{display:block}
  .of-sw{display:flex;gap:7px}
  .of-sw i{display:block;width:11px;height:11px;border-radius:50%;background:#ff5f57;box-shadow:inset 0 0 0 0.5px rgba(0,0,0,0.18)}
  .of-sw i:nth-child(2){background:#febc2e}
  .of-sw i:nth-child(3){background:#28c840}

  /* =====================================================================
     HERO · oferta w przeglądarce, pasek decyzji, czat, powiadomienie
     ===================================================================== */
  .oh{container-type:inline-size;--ak:#f2672a;--ak2:#ffb23f;--akc:#c2410c}
  .ob{position:relative;overflow:hidden;border-radius:14px;background:#ffffff;
    box-shadow:0 0 0 1px rgba(255,255,255,0.14),0 0 0 1.5px rgba(0,0,0,0.3),0 50px 100px -40px rgba(0,0,0,0.9),0 18px 36px -20px rgba(0,0,0,0.55)}
  .ob-tyt{display:flex;align-items:center;gap:14px;height:42px;padding:0 14px;background:#f4f5f3;border-bottom:1px solid var(--jl)}
  .ob-url{display:flex;align-items:center;justify-content:center;gap:7px;flex:1;max-width:460px;height:26px;margin:0 auto;padding:0 12px;border-radius:8px;background:#ffffff;box-shadow:inset 0 0 0 1px var(--jl);font-size:12px;color:var(--j2);white-space:nowrap;overflow:hidden}
  .ob-url .hi{width:12px;height:12px;color:var(--j3)}
  .ob-tyt::after{content:"";width:47px}
  .ob-uk{position:relative;height:600px;overflow:hidden;background:#fffdfb}
  .ob-str{position:absolute;left:0;right:0;top:0;transition:transform 1.3s cubic-bezier(.65,0,.25,1)}
  /* pasek decyzji */
  .od-pasek{position:absolute;z-index:3;left:50%;bottom:16px;transform:translateX(-50%);display:flex;align-items:center;gap:8px;padding:7px;border-radius:999px;background:rgba(255,255,255,0.92);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);box-shadow:0 0 0 1px var(--jl),0 18px 40px -18px rgba(7,20,13,0.4);white-space:nowrap}
  .od-b{display:inline-flex;align-items:center;gap:7px;height:38px;padding:0 17px;border-radius:999px;font-size:13px;font-weight:650;color:var(--j1);box-shadow:inset 0 0 0 1px rgba(21,27,23,0.16);transition:transform .15s,box-shadow .2s,background .2s}
  .od-b.gl{background:linear-gradient(100deg,#e2531f,var(--ak) 55%,#f58a2e);color:#ffffff;box-shadow:0 8px 18px -10px rgba(194,65,12,0.8)}
  .od-b .hi{width:13px;height:13px}
  .od-b.wcis{transform:scale(.95);box-shadow:0 0 0 4px rgba(242,103,42,0.25)}
  .od-gotowe{display:none;align-items:center;gap:8px;height:38px;padding:0 16px;font-size:13px;font-weight:600;color:var(--akc)}
  .od-gotowe .hi{width:16px;height:16px}
  .od-pasek.po .od-b{display:none}
  .od-pasek.po .od-gotowe{display:inline-flex}
  /* czat zadokowany */
  .od-czat{position:absolute;z-index:4;top:14px;right:14px;bottom:76px;width:330px;display:flex;flex-direction:column;border-radius:16px;background:rgba(255,255,255,0.96);-webkit-backdrop-filter:blur(18px);backdrop-filter:blur(18px);box-shadow:0 0 0 1px var(--jl),0 30px 60px -28px rgba(7,20,13,0.45);transition:opacity .35s ease,transform .45s cubic-bezier(.2,.8,.2,1)}
  .od-czat.zam{opacity:0;transform:translateX(24px);pointer-events:none}
  .od-czat-gl{display:flex;align-items:center;gap:10px;padding:14px 16px;border-bottom:1px solid var(--jl)}
  .od-czat-gl > i{display:grid;place-items:center;width:28px;height:28px;border-radius:9px;background:linear-gradient(160deg,var(--ak2),var(--ak));color:#ffffff}
  .od-czat-gl > i .hi{width:13px;height:13px}
  .od-czat-gl b{display:block;font-size:13px;font-weight:650}
  .od-czat-gl span{display:block;font-size:11.5px;color:var(--j3)}
  .od-czat-tr{flex:1;min-height:0;display:flex;flex-direction:column;justify-content:flex-end;gap:10px;padding:14px 16px;overflow:hidden}
  .od-msg{max-width:88%;padding:10px 13px;border-radius:14px;font-size:13px;line-height:1.5;transition:opacity .35s ease,transform .4s cubic-bezier(.2,.8,.2,1)}
  .od-msg.kl{align-self:flex-end;background:#1b140f;color:#ffffff;border-bottom-right-radius:5px}
  .od-msg.ai{align-self:flex-start;background:#fbf4ee;color:var(--j1);border-bottom-left-radius:5px}
  .od-msg.ai b{font-weight:650}
  .od-msg.ukr{opacity:0;transform:translateY(8px)}
  .od-pisze{align-self:flex-start;display:none;gap:4px;padding:12px 14px;border-radius:14px;background:#fbf4ee}
  .od-pisze.on{display:flex}
  .od-pisze i{width:6px;height:6px;border-radius:50%;background:var(--j3);animation:of-krop 1s ease-in-out infinite}
  .od-pisze i:nth-child(2){animation-delay:.15s}
  .od-pisze i:nth-child(3){animation-delay:.3s}
  @keyframes of-krop{50%{opacity:.25;transform:translateY(-2px)}}
  .od-start{display:flex;flex-wrap:wrap;gap:6px;padding:0 16px 10px}
  .od-start span{padding:5px 10px;border-radius:999px;font-size:11.5px;color:var(--j2);box-shadow:inset 0 0 0 1px var(--jl)}
  .od-pole{display:flex;align-items:center;gap:8px;margin:0 12px 12px;padding:0 6px 0 13px;height:40px;border-radius:12px;box-shadow:inset 0 0 0 1px rgba(21,27,23,0.14);font-size:12.5px;color:var(--j4)}
  .od-pole i{display:grid;place-items:center;width:28px;height:28px;margin-left:auto;border-radius:8px;background:var(--j1);color:#ffffff}
  .od-pole i .hi{width:12px;height:12px}
  /* potwierdzenie akceptacji */
  .od-sheet{position:absolute;z-index:5;inset:0;display:grid;place-items:center;background:rgba(15,26,20,0.28);transition:opacity .3s ease}
  .od-sheet.zam{opacity:0;pointer-events:none}
  .od-sheet > div{width:min(380px,calc(100% - 32px));padding:22px;border-radius:18px;background:#ffffff;box-shadow:0 40px 80px -30px rgba(7,20,13,0.5)}
  .od-sheet h4{margin:0;font-size:17px;font-weight:700;letter-spacing:-0.02em}
  .od-sheet p{margin:6px 0 0;font-size:12.5px;line-height:1.5;color:var(--j2)}
  .od-uwagi{display:block;margin-top:14px;padding:10px 12px;height:54px;border-radius:10px;box-shadow:inset 0 0 0 1px rgba(21,27,23,0.14);font-size:12.5px;color:var(--j4)}
  .od-sheet-akc{display:flex;justify-content:flex-end;gap:8px;margin-top:14px}
  /* powiadomienie u sprzedawcy */
  .oh-pow{position:absolute;z-index:6;top:-22px;right:-12px;display:flex;align-items:flex-start;gap:11px;width:300px;padding:13px 15px;border-radius:16px;background:rgba(14,19,16,0.94);color:#f3f6f4;box-shadow:inset 0 0 0 1px rgba(255,255,255,0.08),0 30px 60px -24px rgba(0,0,0,0.7);transition:opacity .4s ease,transform .5s cubic-bezier(.2,.8,.2,1)}
  .oh-pow.zam{opacity:0;transform:translateY(-10px)}
  .oh-pow > i{display:grid;place-items:center;flex-shrink:0;width:30px;height:30px;border-radius:9px;background:rgba(242,103,42,0.18);color:var(--ak2)}
  .oh-pow > i .hi{width:15px;height:15px}
  .oh-pow b{display:block;font-size:13px;font-weight:650}
  .oh.gra .od-pas-b,.oh.gra .od-bud-p i{transform:scaleX(0)}
  .oh.gra.plan .od-pas-b{transform:none;transition:transform .9s cubic-bezier(.2,.8,.2,1) calc(.5s + var(--i) * .16s)}
  .oh.gra.cena .od-bud-p i{transform:none;transition:transform 1.1s cubic-bezier(.2,.8,.2,1) .6s}
  .oh-pow span{display:block;margin-top:2px;font-size:11.5px;color:rgba(243,246,244,0.6)}
  @container (max-width:900px){
    .od-czat{width:290px}
  }
  @container (max-width:640px){
    .ob-uk{height:540px}
    .ob-url{font-size:11px}
    .od-czat{left:10px;right:10px;width:auto;top:auto;height:330px}
    .od-start{display:none}
    .od-pasek{gap:5px;padding:5px}
    .od-b{height:34px;padding:0 12px;font-size:12px}
    .od-b[data-oh-b="talk"]{display:none}
    .oh-pow{right:8px;left:8px;width:auto;top:-14px}
  }

  /* =====================================================================
     DLACZEGO · mapa czytania jednej oferty
     Jak w panelu: prawdziwy dokument w pasmach sekcji, obok uwaga (średni
     czas) i zasięg (kropka = sesja). Dwie osie osobno: różne mianowniki.
     ===================================================================== */
  .mc-gl,.mc-w{display:grid;grid-template-columns:minmax(0,0.8fr) 300px minmax(0,1.15fr) minmax(0,0.75fr);gap:clamp(14px,2vw,32px);align-items:center;margin:0 clamp(2px,0.8vw,14px)}
  .mc-gl{padding-bottom:12px;border-bottom:1.5px solid var(--t1);font-size:12.5px;font-weight:650;color:var(--t2)}
  .mc-gl span small{font-weight:500;color:var(--t3)}
  .mc-w{align-items:stretch;border-bottom:1px solid var(--linia)}
  .mc-w > div{display:flex;align-items:center}
  .mc-n{flex-direction:column;align-items:flex-start !important;justify-content:center;gap:4px}
  .mc-n b{font-size:14.5px;font-weight:650;letter-spacing:-0.01em}
  .mc-n em{font-style:normal;font-size:12px;font-weight:650;line-height:1.35;color:var(--ziel-c)}
  .mc-p{position:relative;align-items:stretch !important;background:#fffdfb;box-shadow:1px 0 0 rgba(15,26,20,0.08),-1px 0 0 rgba(15,26,20,0.08)}
  .mc-gl + .mc-w .mc-p{border-radius:10px 10px 0 0;overflow:hidden}
  .mc-w:last-child .mc-p{border-radius:0 0 10px 10px;overflow:hidden}
  .mc-pd{width:1000px;zoom:0.3;container-type:inline-size;pointer-events:none}
  .mc-pd .od-kroki{padding-bottom:40px}
  .mc-pd .od-slonce .f{animation:none}
  .mc-u{gap:12px}
  .mc-u i{display:block;flex:none;width:var(--u);height:14px;border-radius:4px;background:var(--ziel);transform-origin:0 50%}
  .mc-u span{font-size:13px;font-weight:600;color:var(--t2);white-space:nowrap}
  .mc-z{gap:6px}
  .mc-z i{display:block;width:12px;height:12px;border-radius:50%;box-shadow:inset 0 0 0 1.5px rgba(15,26,20,0.22)}
  .mc-z i.on{background:var(--t1);box-shadow:none}
  .mc-z span{margin-left:8px;font-size:13px;color:var(--t2);white-space:nowrap}
  .mc.gra .mc-u i{transform:scaleX(0)}
  .mc.gra .mc-z i.on{background:transparent;box-shadow:inset 0 0 0 1.5px rgba(15,26,20,0.22)}
  .mc.gra .mc-n em{opacity:0}
  .mc.gra.on .mc-u i{transform:none;transition:transform .8s cubic-bezier(.2,.8,.2,1) calc(0.2s + var(--j) * 0.18s)}
  .mc.gra.on .mc-z i.on{background:var(--t1);box-shadow:none;transition:background .25s ease calc(1.2s + var(--j) * 0.12s + var(--k) * 0.06s),box-shadow .25s ease calc(1.2s + var(--j) * 0.12s + var(--k) * 0.06s)}
  .mc.gra.on .mc-n em{opacity:1;transition:opacity .4s ease 2.4s}
  .bez,.bez *{transition:none !important}
  @media (max-width:1100px){
    .mc-gl,.mc-w{grid-template-columns:minmax(0,0.8fr) 220px minmax(0,1fr) minmax(0,0.8fr)}
    .mc-pd{zoom:0.22}
  }
  @media (max-width:760px){
    .mc-gl{display:none}
    .mc-w{grid-template-columns:minmax(0,1fr) minmax(0,1fr);row-gap:8px;padding:12px 0}
    .mc-n{grid-column:1 / -1}
    .mc-p{display:none !important}
    .mc-u i{width:calc(var(--u) * 0.55)}
  }

  /* =====================================================================
     SCENA · koncepcja, panel ofert, pytania klientów
     ===================================================================== */
  .sc-wid{position:relative;margin-top:28px}
  .sc-wid > [data-widok][hidden]{display:none}
  .ow{overflow:hidden;border-radius:14px;background:#ffffff;box-shadow:0 0 0 1px rgba(255,255,255,0.14),0 0 0 1.5px rgba(0,0,0,0.3),0 50px 100px -40px rgba(0,0,0,0.9)}
  .ow-tyt{position:relative;display:flex;align-items:center;height:40px;padding:0 14px;background:#f4f5f3;border-bottom:1px solid var(--jl)}
  .ow-tyt .okno-t{position:absolute;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:7px;font-size:12.5px;font-weight:600;color:var(--j2);white-space:nowrap}
  .ow-tyt .okno-t .hi{width:13px;height:13px;color:var(--j3)}
  .ow-tr{min-height:440px;padding:24px 28px}
  /* koncepcja */
  .oc{max-width:860px;font-size:13.5px;line-height:1.6;color:var(--j1)}
  .oc-ja{display:flex;gap:10px;padding:12px 14px;border-radius:12px;background:#f4f5f3;font-family:var(--mono);font-size:12.5px;color:var(--j2)}
  .oc-ja::before{content:"›";color:var(--wzc);font-weight:700}
  .oc-ai{display:grid;grid-template-columns:28px minmax(0,1fr);gap:12px;margin-top:18px}
  .oc-ai > i{display:grid;place-items:center;width:28px;height:28px;border-radius:9px;background:var(--j1);color:var(--wz)}
  .oc-ai > i .hi{width:13px;height:13px}
  .oc h4{margin:0 0 4px;font-size:13.5px;font-weight:700}
  .oc h4 + p,.oc ul,.oc ol{margin:0}
  .oc-blok + .oc-blok{margin-top:14px}
  .oc ul{padding-left:18px}
  .oc li{padding:1px 0}
  .oc ol{padding-left:20px}
  .oc ol li em{font-style:normal;color:var(--wzc);font-weight:600}
  .oc-odp{display:flex;align-items:center;gap:10px;margin-top:18px}
  .oc-odp .oc-ja{flex:1}
  .oc-pub{display:flex;align-items:center;gap:8px;margin:12px 0 0 40px;font-size:13px;color:var(--j2)}
  .oc-pub b{font-family:var(--mono);font-size:12.5px;font-weight:500;color:var(--wzc)}
  .oc-pub .hi{width:15px;height:15px;color:var(--wzc)}
  /* panel ofert */
  .op-gl{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:18px}
  .op-gl h3{margin:0;font-size:22px;font-weight:700;letter-spacing:-0.025em}
  .op-seg{display:inline-flex;padding:3px;border-radius:999px;background:#f2f3f1}
  .op-seg span{padding:6px 14px;border-radius:999px;font-size:12.5px;font-weight:600;color:var(--j3)}
  .op-seg span.on{background:#ffffff;color:var(--j1);box-shadow:0 1px 2px rgba(0,0,0,0.08)}
  .op-w{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr) 150px 80px 90px;gap:16px;align-items:center;min-height:62px;border-bottom:1px solid var(--jl2)}
  .op-w.n{min-height:34px;font-size:11.5px;color:var(--j3);border-bottom-color:var(--jl)}
  .op-w b{display:block;font-size:14px;font-weight:650}
  .op-w small{display:block;font-size:12px;color:var(--j3)}
  .op-st{display:inline-flex;align-items:center;gap:7px;font-size:13px;font-weight:600;white-space:nowrap}
  .op-st i{width:8px;height:8px;border-radius:50%;background:var(--j4)}
  .op-st.won{color:var(--wzc)} .op-st.won i{background:var(--wz)}
  .op-st.talk{color:var(--j1)} .op-st.talk i{background:var(--j1)}
  .op-st.live i{background:var(--wz);box-shadow:0 0 0 3px rgba(0,205,119,0.2)}
  .op-st.cold{color:#9c5f14} .op-st.cold i{background:#f0a33a}
  .op-st.never{color:var(--j3)}
  .op-sp{display:flex;align-items:flex-end;gap:2px;height:30px}
  .op-sp i{display:block;flex:1;min-height:2px;border-radius:1px;background:rgba(0,205,119,0.55)}
  .op-sp.pus{border-bottom:1px dashed var(--j4);height:15px}
  .op-n{font-size:13px;color:var(--j2)}
  /* pytania klientów */
  .oq{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:26px}
  .oq-gl{display:flex;align-items:center;gap:10px;margin-bottom:6px}
  .oq-gl h3{margin:0;font-size:20px;font-weight:700;letter-spacing:-0.022em}
  .oq-meta{font-size:12.5px;color:var(--j3)}
  .oq-pod{margin-top:16px;padding:18px 20px;border-radius:14px;background:#f2faf5;box-shadow:inset 0 0 0 1px rgba(0,205,119,0.2)}
  .oq-pod h4{display:flex;align-items:center;gap:8px;margin:0;font-size:13px;font-weight:650;color:var(--wzc)}
  .oq-pod h4 .hi{width:14px;height:14px}
  .oq-pod p{margin:8px 0 0;font-size:14.5px;line-height:1.55;color:var(--j1)}
  .oq-pod small{display:block;margin-top:10px;font-size:12px;color:var(--j3)}
  .oq-btn{display:inline-flex;align-items:center;gap:8px;margin-top:14px;height:34px;padding:0 14px;border-radius:9px;background:var(--j1);color:#ffffff;font-size:12.5px;font-weight:600}
  .oq-lista h4{margin:0 0 8px;font-size:12px;font-weight:650;color:var(--j2)}
  .oq-lista div{display:flex;align-items:center;gap:10px;padding:11px 0;border-bottom:1px solid var(--jl2)}
  .oq-lista div i{display:grid;place-items:center;flex-shrink:0;width:26px;height:26px;border-radius:8px;background:#f2f3f1;color:var(--j3)}
  .oq-lista div i .hi{width:12px;height:12px}
  .oq-lista b{display:block;font-size:13.5px;font-weight:600}
  .oq-lista small{display:block;font-size:11.5px;color:var(--j3)}
  @media (max-width:1000px){
    .op-w{grid-template-columns:minmax(0,1.3fr) minmax(0,1fr) 110px}
    .op-w > :nth-child(4),.op-w > :nth-child(5){display:none}
    .oq{grid-template-columns:minmax(0,1fr)}
  }
  @media (max-width:640px){
    .ow-tr{padding:18px 16px;min-height:0}
    .op-w{grid-template-columns:minmax(0,1fr) auto}
    .op-w > :nth-child(3){display:none}
    .op-w.n{display:none}
    .oc-pub{margin-left:0;flex-wrap:wrap}
  }

  /* =====================================================================
     PRZEPIS OFERTY · skąd się bierze każda sekcja
     ===================================================================== */
  /* Warstwy: sekcje tej samej oferty w rzucie, rozsunięte. Krawędź warstwy
     w kolorze źródła (Claude, moduł, biblioteka), podpis po lewej. */
  .ex{--kc:#00CD77;--km:#0f1a14;--kb:#d8ccb8;position:relative;margin-top:clamp(40px,5vw,72px);padding:40px 0 110px}
  .ex-w{position:relative;display:grid;grid-template-columns:minmax(0,1fr) 560px minmax(0,0.5fr);align-items:center;height:116px;z-index:calc(20 - var(--i))}
  .ex-w:first-child{height:150px}
  .ex-w.c{--k:var(--kc)} .ex-w.m{--k:var(--km)} .ex-w.b{--k:var(--kb)}
  .ex-t{position:relative;grid-column:1;justify-self:end;max-width:300px;padding-right:96px;text-align:right}
  .ex-t::after{content:"";position:absolute;right:14px;top:14px;width:70px;height:1px;background:linear-gradient(90deg,transparent,rgba(15,26,20,0.35))}
  .ex-t b{display:block;font-size:17px;font-weight:700;letter-spacing:-0.018em;line-height:1.2}
  .ex-t b span{margin-right:8px;font-family:var(--mono);font-size:11.5px;font-weight:500;color:var(--t3)}
  .ex-t small{display:block;margin-top:3px;font-size:13.5px;line-height:1.45;color:var(--t2)}
  .ex-t em{display:inline-flex;align-items:center;gap:7px;margin-top:8px;font-style:normal;font-size:12.5px;font-weight:650;color:var(--t1)}
  .ex-t em i{width:9px;height:9px;border-radius:3px;background:var(--k);box-shadow:inset 0 0 0 1px rgba(15,26,20,0.12)}
  .ex-pl{grid-column:2;position:relative;align-self:center;height:0}
  .ex-3d{position:absolute;left:50%;top:50%;width:500px;transform:translate(-50%,-50%) perspective(2600px) rotateX(54deg) rotateZ(-34deg);transform-style:preserve-3d}
  .ex-3d::before{content:"";position:absolute;inset:0;border-radius:14px;background:var(--k);transform:translateZ(-9px)}
  .ex-3d::after{content:"";position:absolute;inset:10% 6%;border-radius:30px;background:rgba(15,26,20,0.3);filter:blur(26px);transform:translateZ(-70px)}
  .ex-in{position:relative;overflow:hidden;border-radius:14px;background:#fffdfb;box-shadow:inset 0 0 0 1px rgba(15,26,20,0.07)}
  .ex-pd{width:1000px;zoom:0.5;container-type:inline-size;pointer-events:none}
