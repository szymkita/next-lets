    u: { t: 'Osoba decyzyjna', d: 'Klient sam wskazuje wspólnika. Anna wraca do hali i nie pyta, kiedy wspólnik wejdzie do rozmowy.' } },
  { cz: '8:09', kto: 'a', t: ['Jasne. A strefa kompletacji pracuje u Was na trzy zmiany?'] },
