---
// EARSHOT AI — makieta aplikacji do slajdów na hubie /produkty.
// Strona robocza, tylko w `npm run dev` pod /produkty/earshot-makieta.
// Zrzuty: scripts/earshot-slajdy.mjs (okna #ek-<nazwa> → public/produkty/slajdy/es-*,
// karta #ek-karta → public/produkty/hero/earshot-karta.webp).
//
// HISTORIA (25.10.2026):
//   v1 „Odsłuch AI” — jasny panel z tabelą („strasznie standardowo”);
//   v2 — ciemne okno z zieloną poświatą, Geist i kursywa Instrument Serif
//        („font zwebcodowany… zupełnie inny design niż na stronie… bez
//        typowych standardów AI-owych”);
//   v3 — natywny program na Maca ze ścieżkami jak w programie do nagrań
//        („trochę przesadziłeś… to jednak jest aplikacja webowa… nie
//        odwzorowuj tak dokładnie dźwięku, to nie jest program dźwiękowy”).
//
// v4 (ta): aplikacja webowa w oknie przeglądarki. Nic ze strony Let’s
// automate (ani zieleni, ani kroju, ani pigułek) i nic z estetyki „AI”
// (gradienty, poświaty, modne kroje, kursywa w cytatach, kafle w kaflach).
// Krój systemowy jak w GitHubie czy Notion, monochrom z czarnym przyciskiem
// głównym, kolor tylko w ocenach. Rozmowa na osi to prosty pasek z etapami
// i kilkoma znacznikami, bez fali. Treść robi robotę: kryteria, transkrypcja,
// uwagi przy zdaniach jak komentarze w przeglądzie kodu.
//
// FAKTY od Szymona: centralka telefoniczna, wgrywanie nagrań, ocena według
// standardów firmy na podstawie całej transkrypcji, ocena przebiegu rozmowy.
// Z makiety (do potwierdzenia): etapy, znaczniki na osi, punkt standardu
// i przykład przy ocenie, uwagi przy zdaniach, źródło standardu w PDF,
// odtwarzanie od miejsca uwagi.
//
// Jedna sprawa przez wszystkie ekrany: pierwsza rozmowa Anny Kowal (Termaro,
// jak w makietach Wingmana i Ofert AI) z Jerzym Bielikiem z Hurtowni Bielik,
// wt 21.10, 10:42, 14 min 32 s, wynik 5 z 7. Wspólnik pada w 8:02 i nie
// wraca, termin kolejnej rozmowy nie pada w 12:44.
const AV = (n: string) => `/makieta/awatar-${n}.webp`;

// Znak Earshot: dwie wypowiedzi, jedna po drugiej.
const ZNAK = '<rect x="1" y="3.5" width="9" height="4" rx="2"/><rect x="6" y="8.5" width="9" height="4" rx="2" opacity=".5"/>';

// Ikony 16 × 16, kreska 1,4 px, jeden styl.
const S = 'fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"';
const IK: Record<string, string> = {
  play: '<path d="M5 3.2v9.6c0 .5.5.8.9.5l7.3-4.8a.6.6 0 0 0 0-1L5.9 2.7c-.4-.3-.9 0-.9.5Z" fill="currentColor"/>',
  ok: '<path d="M4.4 8.3 6.8 10.6 11.6 5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
  pol: '<path d="M5 8h6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>',
  nie: '<path d="M5.5 5.5l5 5M10.5 5.5l-5 5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>',
  szukaj: `<circle cx="7" cy="7" r="4.3" ${S}/><path d="m10.3 10.3 3.2 3.2" ${S}/>`,
  wgraj: `<path d="M8 10.2V2.8M5.3 5.3 8 2.8l2.7 2.5" ${S}/><path d="M2.8 9.6v2.5c0 .8.6 1.4 1.4 1.4h7.6c.8 0 1.4-.6 1.4-1.4V9.6" ${S}/>`,
  dol: `<path d="m4.5 6.2 3.5 3.6 3.5-3.6" ${S}/>`,
  prawo: `<path d="m6.2 4.5 3.6 3.5-3.6 3.5" ${S}/>`,
  telefon: `<path d="M5.4 2.6 6.6 5c.2.4.1.9-.2 1.2l-.8.7a7.6 7.6 0 0 0 3.5 3.5l.7-.8c.3-.3.8-.4 1.2-.2l2.4 1.2c.4.2.6.6.5 1l-.3 1.1c-.2.6-.7 1-1.3 1A10.7 10.7 0 0 1 1.6 3.8c0-.6.4-1.1 1-1.3l1.1-.3c.4-.1.8.1 1 .4Z" ${S}/>`,
  dokument: `<path d="M4.3 2h4.6l2.9 2.9v8.2c0 .5-.4.9-.9.9H4.3a.9.9 0 0 1-.9-.9V2.9c0-.5.4-.9.9-.9Z" ${S}/><path d="M8.7 2.1v3h3M5.8 8.5h4.4M5.8 11h3" ${S}/>`,
  osoba: '<circle cx="8" cy="5.7" r="2.5" fill="currentColor"/><path d="M3.2 13.3c.5-2.5 2.5-3.9 4.8-3.9s4.3 1.4 4.8 3.9c.1.4-.2.7-.6.7H3.8c-.4 0-.7-.3-.6-.7Z" fill="currentColor"/>',
  plik: `<path d="M4.3 2h4.6l2.9 2.9v8.2c0 .5-.4.9-.9.9H4.3a.9.9 0 0 1-.9-.9V2.9c0-.5.4-.9.9-.9Z" ${S}/><path d="M6.2 11.4V8.6m1.8 2.8V7.4m1.8 4V9.2" ${S}/>`,
  udostepnij: `<path d="M8 2.6v7.2M5.4 5 8 2.6 10.6 5" ${S}/><path d="M5.3 7.2h-.8c-.7 0-1.2.5-1.2 1.2v4.2c0 .7.5 1.2 1.2 1.2h7c.7 0 1.2-.5 1.2-1.2V8.4c0-.7-.5-1.2-1.2-1.2h-.8" ${S}/>`,
  menu: `<path d="M2.8 4.5h10.4M2.8 8h10.4M2.8 11.5h10.4" ${S}/>`,
  plus: `<path d="M8 3.2v9.6M3.2 8h9.6" ${S}/>`,
  filtr: `<path d="M2.8 4.2h10.4M4.8 8h6.4M6.8 11.8h2.4" ${S}/>`,
  x: `<path d="m4.5 4.5 7 7m0-7-7 7" ${S}/>`,
  komentarz: `<path d="M3 4.2c0-.7.6-1.2 1.2-1.2h7.6c.7 0 1.2.5 1.2 1.2v5.3c0 .7-.5 1.2-1.2 1.2H7l-2.8 2.3v-2.3c-.7 0-1.2-.5-1.2-1.2V4.2Z" ${S}/>`,
};
