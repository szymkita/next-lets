    u: { t: 'Odpowiedź na obiekcję cenową', d: 'Anna wraca do kwoty, którą klient podał w 3:18, zamiast schodzić z ceny.' } },
  { przerwa: '3 min 20 s' },
  { cz: '12:40', kto: 'k', t: ['Dobra, to proszę coś przesłać, popatrzymy.'] },
  { cz: '12:44', kto: 'a', t: ['', 'Wyślę ofertę jeszcze w tym tygodniu.', ''], z: 'nie',
