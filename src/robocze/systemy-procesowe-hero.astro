<script>
  var redukcja = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var GODZ = 8;
  function fmt(d){
    var dd = Math.floor(d + 1e-9), h = Math.floor((d - dd) * GODZ + 1e-9);
    if(dd === 0 && h === 0) return Math.round(d * GODZ * 60) + ' min';
    return [dd ? dd + (dd === 1 ? ' dzień' : ' dni') : '', h ? h + ' h' : ''].filter(Boolean).join(' ');
  }
  // Pętla rAF z pauzą poza kadrem; po powrocie rusza od miejsca, w którym stanęła.
  function petla(el, T, rysuj){
    var start = null, przesun = 0, raf = null;
    function klatka(ts){
      if(start === null) start = ts - przesun * 1000;
      var tau = ((ts - start) / 1000) % T;
      przesun = tau;
      rysuj(tau);
      raf = requestAnimationFrame(klatka);
    }
    rysuj(0);
    new IntersectionObserver(function(w){
      if(w[0].isIntersecting){ if(raf === null){ start = null; raf = requestAnimationFrame(klatka); } }
      else if(raf !== null){ cancelAnimationFrame(raf); raf = null; }
    }, { threshold: 0.05 }).observe(el);
  }
  function stanUstaw(stan, stanT, klasa, s){
    stan.className = 'wt-stan' + (klasa ? ' ' + klasa : '');
    stanT.textContent = s.charAt(0).toUpperCase() + s.slice(1);
  }

  // ---- Wątek (A, C, D) — logika z v4, na wiele instancji ----
  document.querySelectorAll('[data-wt]').forEach(function(wt){
    if(redukcja || !window.requestAnimationFrame) return;
    var msgs = Array.prototype.slice.call(wt.querySelectorAll('[data-m]'));
    var trwa = wt.querySelector('[data-trwa]'), praca = wt.querySelector('[data-praca]');
    var stan = wt.querySelector('[data-stan]'), stanT = wt.querySelector('[data-stan-t]');
    var poTrwa = wt.dataset.poTrwa, poPraca = wt.dataset.poPraca;
    var os = [], t = 0, d = 0, p = 0;
    function dodaj(o, dur){ o.t0 = t; o.t1 = t + dur; os.push(o); t += dur; }
    msgs.forEach(function(m, i){
      JSON.parse(m.dataset.sekw).forEach(function(x){
        var min = x.p ? x.d * GODZ * 60 : 0;
        dodaj({ typ: x.p ? 'praca' : 'czeka', d0: d, d1: d + x.d, p0: p, p1: p + min, s: x.s }, x.p ? 0.6 : 0.8 + x.d * 0.5);
        d += x.d; p += min;
      });
      dodaj({ typ: 'msg', i: i, d0: d, d1: d, p0: p, p1: p, s: 'nowa wiadomość w wątku' }, 0.9);
    });
    dodaj({ typ: 'stoi', d0: d, d1: d, p0: p, p1: p, s: 'oferta u klienta po ' + fmt(d) }, 1.8);
    dodaj({ typ: 'zwin', s: 'ta sama sprawa prowadzona przez system' }, 5.4);
    dodaj({ typ: 'gas', s: 'ta sama sprawa prowadzona przez system' }, 0.9);
    var T = t;
    wt.classList.add('gra');
    var stare = {};
    function ustaw(klucz, wartosc, fn){ if(stare[klucz] !== wartosc){ stare[klucz] = wartosc; fn(wartosc); } }
    petla(wt, T, function(tau){
      var seg = os[0];
      for(var i = 0; i < os.length; i++){ if(tau >= os[i].t0) seg = os[i]; else break; }
      var widac = 0;
      os.forEach(function(o){ if(o.typ === 'msg' && tau >= o.t0) widac = o.i + 1; });
      msgs.forEach(function(m, j){
        var k = j < widac ? widac - 1 - j : 0;
        ustaw('k' + j, k + '|' + (j < widac), function(){
          m.style.setProperty('--k', k);
          m.classList.toggle('ukr', j >= widac);
        });
      });
      var koniec = seg.typ === 'zwin' || seg.typ === 'gas';
      ustaw('zwin', koniec, function(v){ wt.classList.toggle('zwin', v); });
      ustaw('gas', seg.typ === 'gas', function(v){ wt.classList.toggle('gas', v); });
      if(koniec){
        ustaw('trwa', poTrwa, function(v){ trwa.textContent = v; });
        ustaw('praca', poPraca, function(v){ praca.textContent = v; });
      } else {
        var u = seg.t1 > seg.t0 ? Math.min(1, (tau - seg.t0) / (seg.t1 - seg.t0)) : 1;
        if(seg.typ === 'czeka') u = u * u * (3 - 2 * u);
        ustaw('trwa', fmt(seg.d0 + (seg.d1 - seg.d0) * u), function(v){ trwa.textContent = v; });
        ustaw('praca', Math.round(seg.p0 + (seg.p1 - seg.p0) * u) + ' min', function(v){ praca.textContent = v; });
      }
      var klasa = seg.typ === 'czeka' ? 'czeka' : (seg.typ === 'praca' || koniec) ? 'praca' : '';
      ustaw('stan', klasa + '|' + seg.s, function(){ stanUstaw(stan, stanT, klasa, seg.s); });
    });
  });

  // ---- Kalendarz (B) ----
  // Zegar x (dni robocze od pon 8:00) idzie po krokach z data-os: czekanie
  // wolno, praca szybko, po kroku z mailem krótka pauza. Kawałek czekania
  // odsłania się od góry (clip-path przez --p), kreska „teraz" stoi w dniu
  // i godzinie zegara. Potem tydzień blednie i wchodzą bloki systemu.
  // Bez JS i przy reduced-motion stoi pełny tydzień z mailami.
  document.querySelectorAll('[data-kal]').forEach(function(kal){
    if(redukcja || !window.requestAnimationFrame) return;
    var kroki = JSON.parse(kal.dataset.os);
    var sl = function(q){ return Array.prototype.slice.call(kal.querySelectorAll(q)); };
    var kw = sl('[data-kw]').map(function(el){ return { el: el, a: +el.dataset.a, b: +el.dataset.b }; });
    var znaczniki = sl('[data-km],[data-kp]').map(function(el){ return { el: el, x: +el.dataset.x }; });
    var dni = sl('[data-kd]').map(function(el){ return { el: el, teraz: el.querySelector('.kal-teraz') }; });
    var trwa = kal.querySelector('[data-trwa]'), praca = kal.querySelector('[data-praca]');
    var stan = kal.querySelector('[data-stan]'), stanT = kal.querySelector('[data-stan-t]');
    var x0 = kroki[0].a, x1 = kroki[kroki.length - 1].b;
    var os = [], t = 0;
    function dodaj(o, dur){ o.t0 = t; o.t1 = t + dur; os.push(o); t += dur; }
    kroki.forEach(function(k){
      dodaj({ typ: k.p ? 'praca' : 'czeka', xa: k.a, xb: k.b, s: k.s }, k.p ? 0.6 : 0.8 + (k.b - k.a) * 0.5);
      if(k.m) dodaj({ typ: 'msg', xa: k.b, xb: k.b, s: 'nowa wiadomość w wątku' }, 0.9);
    });
    dodaj({ typ: 'stoi', xa: x1, xb: x1, s: 'oferta u klienta po ' + fmt(x1 - x0) }, 1.8);
    dodaj({ typ: 'sys', xa: x1, xb: x1, s: 'ta sama sprawa prowadzona przez system' }, 5.6);
    dodaj({ typ: 'gas', xa: x1, xb: x1, s: 'ta sama sprawa prowadzona przez system' }, 0.9);
    var T = t;
    kal.classList.add('gra');
    var stare = {};
    function ustaw(klucz, wartosc, fn){ if(stare[klucz] !== wartosc){ stare[klucz] = wartosc; fn(wartosc); } }
    petla(kal, T, function(tau){
      var seg = os[0];
      for(var i = 0; i < os.length; i++){ if(tau >= os[i].t0) seg = os[i]; else break; }
      var u = seg.t1 > seg.t0 ? Math.min(1, (tau - seg.t0) / (seg.t1 - seg.t0)) : 1;
      if(seg.typ === 'czeka') u = u * u * (3 - 2 * u);
      var X = seg.xa + (seg.xb - seg.xa) * u;
      kw.forEach(function(k, j){
        var p = Math.max(0, Math.min(1, (X - k.a) / (k.b - k.a)));
        ustaw('kw' + j, p.toFixed(3), function(v){ k.el.style.setProperty('--p', v); });
      });
      znaczniki.forEach(function(z, j){
        ustaw('z' + j, X >= z.x - 1e-6, function(v){ z.el.classList.toggle('ukr', !v); });
      });
      var dz = Math.min(dni.length - 1, Math.floor(X + 1e-9));
      dni.forEach(function(d, j){
        ustaw('d' + j, j === dz, function(v){ d.el.classList.toggle('teraz', v); });
      });
      dni[dz].teraz.style.setProperty('--ty', (X - dz).toFixed(4));
      var koniec = seg.typ === 'sys' || seg.typ === 'gas';
      ustaw('sys', koniec, function(v){ kal.classList.toggle('sys', v); });
      ustaw('gas', seg.typ === 'gas', function(v){ kal.classList.toggle('gas', v); });
      if(koniec){
        ustaw('trwa', kal.dataset.poTrwa, function(v){ trwa.textContent = v; });
        ustaw('praca', kal.dataset.poPraca, function(v){ praca.textContent = v; });
      } else {
        var pr = 0;
        kroki.forEach(function(k){ if(k.p) pr += Math.max(0, Math.min(X, k.b) - k.a) * GODZ * 60; });
        ustaw('trwa', fmt(X - x0), function(v){ trwa.textContent = v; });
        ustaw('praca', Math.round(pr) + ' min', function(v){ praca.textContent = v; });
      }
      var klasa = seg.typ === 'czeka' ? 'czeka' : (seg.typ === 'praca' || koniec) ? 'praca' : '';
      ustaw('stan', klasa + '|' + seg.s, function(){ stanUstaw(stan, stanT, klasa, seg.s); });
    });
  });
</script>
