<script>
  var redukcja = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- Trzy tory: kropka do bursztynu, postój, zieleń do wyniku ----
  // Odgrywa się raz po wejściu w kadr; przycisk „jeszcze raz" puszcza od
  // nowa. Bez JS i przy ograniczonym ruchu figura nie ma .gra, więc od razu
  // widać stan końcowy.
  (function(){
    var fig = document.querySelector('[data-tory]');
    if(!fig || redukcja || !('IntersectionObserver' in window)) return;
    var znow = fig.querySelector('[data-tory-znow]');
    var timery = [];
    function czysc(){ timery.forEach(clearTimeout); timery = []; fig.classList.remove('k1', 'k2', 'k3', 'k4'); }
    function graj(){
      czysc();
      void fig.offsetWidth;
      if(znow) znow.disabled = true;
      timery.push(setTimeout(function(){ fig.classList.add('k1'); }, 150));
      timery.push(setTimeout(function(){ fig.classList.add('k2'); }, 1750));
      timery.push(setTimeout(function(){ fig.classList.add('k3'); }, 3700));
      timery.push(setTimeout(function(){ fig.classList.add('k4'); }, 5100));
      timery.push(setTimeout(function(){ if(znow) znow.disabled = false; }, 5900));
    }
    var io = new IntersectionObserver(function(w){
      if(w[0].isIntersecting){ graj(); io.disconnect(); }
    }, { threshold: 0.45 });
    io.observe(fig);
    if(znow) znow.addEventListener('click', graj);
  })();
</script>
</LaBase>
