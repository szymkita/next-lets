  .ha-o3 .ha-tt{color:rgba(255,255,255,0.55)}
  .ha-twarze{display:flex;margin-left:auto}
  .ha-twarze img{width:20px;height:20px;margin-left:-5px;border-radius:50%;object-fit:cover;box-shadow:0 0 0 2px #f7f7f6}
  .ha-c{padding:14px 16px}
  .ha-gl{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:12px}
  .ha-gl b{font-size:13.5px;font-weight:650}
  .ha-gl span{font-size:11px;color:#a1a1aa}
  /* stany: kropka i napis, bez pigułek */
  .ha-st{position:relative;flex-shrink:0;display:block;width:98px;height:16px}
  .ha-st em{position:absolute;right:0;top:0;display:flex;align-items:center;gap:6px;font-style:normal;font-size:11.5px;font-weight:650;white-space:nowrap;color:#71717a;transition:opacity .3s ease}
