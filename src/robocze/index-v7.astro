  .of-gr ul{margin:0;padding:0;list-style:none}
  .of-gr li + li{border-top:1px solid #e7ece4}
  .of-w{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,15.5em) 40px;gap:12px clamp(20px,2.4vw,36px);align-items:center;margin:0 -18px;padding:clamp(18px,1.9vw,24px) 18px;border-radius:18px;color:#16211a;transition:background .2s}
  .of-w q{font-size:clamp(19px,1.75vw,25px);line-height:1.24;font-weight:650;letter-spacing:-0.022em;text-wrap:pretty;quotes:"„" "”" "‚" "’";transition:transform .4s cubic-bezier(.2,.7,.2,1)}
  .of-w q::before{color:#0a7a52}
  .of-u b{display:block;font-size:15.5px;font-weight:750;letter-spacing:-0.01em;color:#16211a}
  .of-u em{display:block;margin-top:3px;font-style:normal;font-size:14px;line-height:1.45;color:#637066}
  .of-w > i{justify-self:end;display:grid;place-items:center;width:40px;height:40px;border-radius:50%;background:#16211a;color:#ffffff;transition:background .2s,color .2s,transform .25s}
  .of-w > i svg{width:15px;height:15px;fill:currentColor}
  .of-w:hover{background:#f4f8f2}
  .of-w:hover q{transform:translateX(8px)}
