  /* iOS Safari powiększa całą stronę, gdy kursor wchodzi w pole z krojem
     mniejszym niż 16px — po wyjściu z pola układ zostaje przesunięty.
     Na telefonie pola dostają więc równe 16px. */
  @media (max-width:900px){
    input,select,textarea{font-size:16px !important}
  }

  /* ---------- Czym jest — zielony pas (S3b) ----------
     Wygląd jak komponent Pas z podstron usługowych (src/components/usluga/
     Pas.astro): plansza w zieleni z równą białą ramą, tekst po lewej, twarz
     w duotonie po prawej (szarość mnożona przez zieleń, maska od lewej). */
  .la-zl{--ram:clamp(6px,0.9vw,14px);--pin:max(16px,calc(max(clamp(20px,5vw,56px),calc((100vw - 1440px) / 2)) - var(--ram)));padding:clamp(56px,7vw,96px) var(--ram) 0}
  .la-zl-in{position:relative;overflow:hidden;display:grid;grid-template-columns:minmax(0,7.2fr) minmax(0,4.8fr);min-height:clamp(420px,36vw,540px);border-radius:clamp(20px,2.2vw,32px);background:var(--la-accent,#00CD77)}
  .la-zl-t{position:relative;z-index:2;display:flex;flex-direction:column;justify-content:center;align-items:flex-start;padding:clamp(40px,5vw,80px) var(--pin)}
  .la-zl-pod{display:flex;align-items:center;gap:12px;margin:0;font-size:clamp(15px,1.25vw,17px);line-height:1.35;font-weight:700;letter-spacing:-0.005em;color:#07140d}
  .la-zl-pod::before{content:"";flex-shrink:0;width:22px;height:2px;background:#07140d}
  .la-zl-duzy{margin:clamp(18px,2vw,26px) 0 0;max-width:800px;font-size:clamp(30px,3.7vw,54px);line-height:1.03;letter-spacing:-0.045em;font-weight:750;color:#07140d;text-wrap:balance}
  .la-zl-opis{margin:clamp(16px,1.8vw,22px) 0 0;max-width:600px;font-size:clamp(16px,1.3vw,18px);line-height:1.6;color:rgba(7,20,13,0.8);text-wrap:pretty}
  .la-zl-btn{display:inline-flex;align-items:center;gap:14px;margin-top:clamp(26px,3vw,38px);padding:9px 9px 9px 24px;border-radius:999px;background:#07140d;color:#ffffff;font-weight:700;font-size:16px;letter-spacing:-0.01em;white-space:nowrap;transition:background .2s}
  .la-zl-btn span{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:50%;background:var(--la-accent,#00CD77);color:#07140d;font-size:15px;transition:transform .25s}
  .la-zl-btn:hover{background:#163126}
  .la-zl-btn:hover span{transform:translateX(3px)}
  .la-zl-foto{position:relative;min-height:300px}
  .la-zl-foto img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:58% 18%;filter:grayscale(1) contrast(1.12) brightness(1.04);mix-blend-mode:multiply;
    -webkit-mask-image:linear-gradient(to right,transparent 0%,rgba(0,0,0,0.6) 16%,#000 36%);mask-image:linear-gradient(to right,transparent 0%,rgba(0,0,0,0.6) 16%,#000 36%)}
  .la-zl-podpis{position:absolute;right:clamp(18px,2.2vw,30px);bottom:clamp(18px,2.2vw,28px);z-index:2;text-align:right}
  .la-zl-podpis b{display:block;font-size:15px;font-weight:800;color:#ffffff}
  .la-zl-podpis span{display:block;margin-top:2px;font-size:11.5px;color:rgba(255,255,255,0.78)}
  @media (prefers-reduced-motion:reduce){ .la-zl-btn,.la-zl-btn span{transition:none} }
  @media (max-width:820px){
    .la-zl-in{grid-template-columns:1fr}
    .la-zl-foto{order:-1;height:300px}
    .la-zl-foto img{-webkit-mask-image:linear-gradient(to bottom,#000 70%,transparent 100%);mask-image:linear-gradient(to bottom,#000 70%,transparent 100%)}
    .la-zl-t{padding-top:8px}
  }
  @media (max-width:400px){ .la-zl-btn{white-space:normal;line-height:1.25;padding-left:20px} }

  /* ---------- Oferta (S4, z /index-v2) ----------
     Wiersz: zdanie klienta | usługa z terminem | strzałka. Pod kursorem
     wiersz dostaje tło sekcji z jasną zielenią, zdanie przesuwa się o krok. */
  .of{margin-top:clamp(44px,5vw,64px)}
  .of-kol{display:grid;grid-template-columns:minmax(0,3.6fr) minmax(0,8.4fr);gap:clamp(24px,4vw,64px);padding-bottom:14px;border-bottom:1.5px solid #16211a;font-size:13px;font-weight:650;color:#808b83}
  .of-kol-p{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,15.5em) 40px;column-gap:clamp(20px,2.4vw,36px)}
  .of-gr{display:grid;grid-template-columns:minmax(0,3.6fr) minmax(0,8.4fr);gap:18px clamp(24px,4vw,64px);padding:clamp(28px,3.2vw,44px) 0;border-bottom:1px solid #e7ece4;scroll-margin-top:100px}
  .of-gl{align-self:start;position:sticky;top:110px}
