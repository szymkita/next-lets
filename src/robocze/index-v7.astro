  /* ---------- v6 · skala „firma napędzana AI" ---------- */
  .sk{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0 clamp(16px,2.4vw,32px);margin:clamp(56px,6vw,88px) 0 0;padding:0;list-style:none}
  .sk{grid-template-rows:repeat(4,auto)}
  .sk li{display:grid;grid-row:span 4;grid-template-rows:subgrid;row-gap:0}
  .sk-seg{position:relative;display:block;height:10px;border-radius:5px;background:#d5dfd3}
  .sk-e2 .sk-seg{background:#a9c9b3}
  .sk-e3 .sk-seg{background:#4fbf86}
  .sk-e4 .sk-seg{background:var(--la-accent,#00CD77);box-shadow:0 0 18px rgba(0,205,119,0.55)}
