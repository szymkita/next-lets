  /* ---------- v7 · hero: trzy aplikacje ----------
     Okna w zestawie 1180 × 400 (skalowanym jak dawna makieta). Rozmiary
     w px, typografia 11–13 px jak w makietach podstron. Stan w markupie to
     stan końcowy; pod .gra (dokładane przez skrypt) elementy startują
     schowane i wchodzą z klasami k1…kN. */
  .ha{position:absolute;inset:0}
  .ha-o{position:absolute;overflow:hidden;border-radius:12px;text-align:left;color:#18181b;letter-spacing:-0.004em;
    background:#ffffff;box-shadow:0 0 0 1px rgba(9,9,11,0.08),0 40px 80px -36px rgba(12,28,20,0.45),0 14px 30px -18px rgba(12,28,20,0.25)}
  .ha-o1{left:0;top:72px;width:360px;height:330px;z-index:1}
  .ha-o2{left:370px;top:0;width:440px;height:380px;z-index:3}
  .ha-o3{left:820px;top:72px;width:360px;height:330px;z-index:2;background:#0d1914;color:#e4ebe6;box-shadow:0 0 0 1px rgba(255,255,255,0.08),0 40px 80px -36px rgba(12,28,20,0.6),0 14px 30px -18px rgba(12,28,20,0.35)}
  .ha-tyt{position:relative;display:flex;align-items:center;height:34px;padding:0 12px;background:#f7f7f6;border-bottom:1px solid rgba(9,9,11,0.07)}
