  /* 1 · obieg faktur */
  .ha-nowa{margin:0 -8px 6px;padding:10px 8px;border-radius:10px;background:#f2faf5;box-shadow:inset 0 0 0 1px rgba(16,185,129,0.18);transition:opacity .45s ease,transform .5s cubic-bezier(.2,.8,.2,1),background .5s}
  .ha-fv{display:grid;grid-template-columns:22px minmax(0,1fr) auto;gap:10px;align-items:center}
