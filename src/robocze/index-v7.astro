  .ha-fv small{display:block;margin-top:1px;font-size:11px;color:#71717a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .ha-pdf{position:relative;display:block;width:22px;height:28px;border-radius:3px;background:#ffffff;box-shadow:inset 0 0 0 1px #e4e4e7;overflow:hidden}
