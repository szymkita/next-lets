  .mega-eyebrow{font-weight:700;font-size:11px;letter-spacing:0.07em;text-transform:uppercase;color:#808b83;padding:0 11px;margin-bottom:6px}
  .mega-item{display:block;padding:9px 11px;border-radius:11px;transition:background .15s}
