  .of-w:focus-visible{outline:2px solid var(--la-accent,#00CD77);outline-offset:2px}
  .of-pom{display:flex;align-items:center;gap:14px;margin-top:clamp(28px,3vw,40px);margin-left:calc((100% - clamp(24px,4vw,64px)) * 0.3 + clamp(24px,4vw,64px))}
  .of-pom > span{display:block;width:44px;height:44px;border-radius:50%;overflow:hidden;flex-shrink:0;background:#eef1ec}
  .of-pom img{width:100%;height:100%;object-fit:cover;display:block}
  .of-pom p{margin:0;font-size:15px;line-height:1.5;color:#4c5850}
  .of-pom a{font-weight:700;color:#0a7a52}
  @media (prefers-reduced-motion:reduce){ .of-w q,.of-w > i{transition:none} .of-w:hover q{transform:none} }
  @media (max-width:900px){
    .of-kol{display:none}
    .of-gr{grid-template-columns:minmax(0,1fr)}
    .of-gl{position:static}
    .of-w{grid-template-columns:minmax(0,1fr) 40px;margin:0 -12px;padding:18px 12px}
    .of-w q{grid-column:1 / -1}
    .of-w:hover q{transform:none}
    .of-pom{margin-left:0}
  }

  /* ---------- Teza i podpis (z /index-v2) ---------- */
  .t5-pod{display:flex;align-items:center;gap:12px;margin:0;font-size:clamp(15px,1.25vw,17px);line-height:1.35;font-weight:700;letter-spacing:-0.005em;color:#16211a}
  .t5-pod::before{content:"";flex-shrink:0;width:22px;height:2px;background:var(--la-accent,#00CD77)}
  .t5-teza{margin:clamp(22px,2.6vw,34px) 0 0;max-width:1240px;font-size:clamp(32px,4.6vw,68px);line-height:1.03;letter-spacing:-0.047em;font-weight:700;color:#16211a;text-wrap:balance}
  .t5-teza span{color:#8a958d}

  /* ---------- Karty efektów (S6, z /index-v2) ---------- */
  .w5{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:clamp(44px,5vw,64px)}
  .w5-k{display:flex;flex-direction:column;padding:24px 24px 22px;border-radius:22px;background:#f4f8f2}
  .w5-dz{font-size:12.5px;font-weight:700;color:#0a7a52}
  .w5-k h3{margin:8px 0 0;font-size:17px;font-weight:750;letter-spacing:-0.02em;line-height:1.25;color:#16211a}
  .w5-l{margin:clamp(22px,2.4vw,34px) 0 0;padding-bottom:20px;border-bottom:1px solid #dfe7dc}
  .w5-l b{display:block;font-size:clamp(46px,4.4vw,68px);line-height:0.95;font-weight:800;letter-spacing:-0.06em;color:#0a7a52;white-space:nowrap}
  .w5-l span{display:block;margin-top:8px;font-size:14px;color:#4c5850}
  .w5-k dl{display:grid;gap:12px;margin:18px 0 0}
