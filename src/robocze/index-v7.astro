<!-- ============ S10b/S11 · PAS GRUPY + STOPKA ============
     Jedno źródło dla całego serwisu: src/components/Stopka.astro -->
<Stopka />

</div>

<script>
  // ---- Hero: makieta pulpitu skalowana do szerokości kontenera ----
  (function(){
    var frame = document.querySelector('.mockup-frame');
    var scale = document.querySelector('.mockup-scale');
    if(!frame || !scale) return;
    // v7: środek zestawu (590 px) zawsze na środku kolumny. Wcześniej
    // margin:auto przy pudełku szerszym niż kolumna zerował się, a skala
    // od środka przesuwała makietę w prawo — na telefonie wypadała poza
    // ekran. Poniżej 700 px środkowe okno (Ofertownia) wypełnia szerokość,
    // a boczne wystają przy krawędziach.
    function fit(){
      var w = frame.clientWidth;
      var s = w < 700 ? w / 470 : Math.min(1, w / 1180);
      scale.style.transformOrigin = 'top left';
      scale.style.margin = '0';
      scale.style.transform = 'translateX(' + (w / 2 - 590 * s) + 'px) scale(' + s + ')';
      frame.style.height = (400 * s) + 'px';
    }
    fit();
    window.addEventListener('resize', fit);
    window.addEventListener('load', fit);
  })();


  // ---- Hero (v7): trzy aplikacje, w których praca dzieje się sama ----
  // Każde okno ma data-ha="k1:ms,k2:ms,…": skrypt dokłada klasy w czasie,
  // po data-ha-koniec zdejmuje je (elementy wracają do stanu startowego)
  // i po chwili zaczyna od nowa. Okna startują z przesunięciem
  // (data-ha-start), żeby nie mrugały naraz. Przy prefers-reduced-motion
  // okna zostają w stanie końcowym z markupu.
  (function(){
    if(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll('[data-ha]').forEach(function(o){
      var kroki = o.dataset.ha.split(',').map(function(x){ var p = x.split(':'); return [p[0], +p[1]]; });
      var koniec = +o.dataset.haKoniec || 8000, start = +o.dataset.haStart || 0;
      o.classList.add('gra');
      function cykl(){
        kroki.forEach(function(k){ setTimeout(function(){ o.classList.add(k[0]); }, k[1]); });
        setTimeout(function(){
          kroki.forEach(function(k){ o.classList.remove(k[0]); });
          setTimeout(cykl, 900);
        }, koniec);
      }
      setTimeout(cykl, start);
    });
  })();

  // ---- Opinie (v7): taśma dużych cytatów ----
  (function(){
    var t = document.querySelector('[data-op7]');
    if(!t) return;
    var k = Array.prototype.slice.call(t.children);
    var kr = Array.prototype.slice.call(document.querySelectorAll('[data-op7-kr]'));
    var red = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var CZAS = 6500, timer = null, widoczna = false, stop = false;
    function biezacy(){
      var l = t.scrollLeft, best = 0, d = Infinity;
      k.forEach(function(el, i){ var x = Math.abs(el.offsetLeft - t.offsetLeft - l - parseFloat(getComputedStyle(t).paddingLeft)); if(x < d){ d = x; best = i; } });
      return best;
    }
    function idz(i){
      i = (i + k.length) % k.length;
      var pad = parseFloat(getComputedStyle(t).paddingLeft);
      t.scrollTo({ left: k[i].offsetLeft - t.offsetLeft - pad, behavior: red ? 'auto' : 'smooth' });
    }
    function plan(){
      clearTimeout(timer);
      if(red || stop || !widoczna) return;
      timer = setTimeout(function(){ idz(biezacy() + 1); plan(); }, CZAS);
    }
    var w = document.querySelector('[data-op7-wstecz]'), d = document.querySelector('[data-op7-dalej]');
    if(w) w.addEventListener('click', function(){ idz(biezacy() - 1); plan(); });
    if(d) d.addEventListener('click', function(){ idz(biezacy() + 1); plan(); });
    kr.forEach(function(b){ b.addEventListener('click', function(){ idz(+b.dataset.op7Kr); plan(); }); });
    t.addEventListener('scroll', function(){ var i = biezacy(); kr.forEach(function(b, j){ b.classList.toggle('on', i === j); }); }, { passive: true });
    var sek = t.closest('section');
    sek.addEventListener('mouseenter', function(){ stop = true; clearTimeout(timer); });
    sek.addEventListener('mouseleave', function(){ stop = false; plan(); });
    sek.addEventListener('focusin', function(){ stop = true; clearTimeout(timer); });
    sek.addEventListener('focusout', function(){ stop = false; plan(); });
    if('IntersectionObserver' in window){
      new IntersectionObserver(function(e){ widoczna = e[0].isIntersecting; plan(); }, { threshold: 0.4 }).observe(sek);
    }
  })();

  // ---- Rotator (S1b) — pionowe przewijanie fraz co 3s ----
  (function(){
    var col = document.getElementById('rotator-col');
    if(!col) return;
    var count = col.children.length;
    var i = 0;
    setInterval(function(){
      i = (i + 1) % count;
      var h = col.children[0].offsetHeight || 60;
      col.style.transform = 'translateY(-' + (i * h) + 'px)';
    }, 3000);
  })();

  // ---- Droga pod hero (S1b, wariant A) — reveal wykresu i osi czasu ----
  (function(){
    var sec = document.querySelector('.la-droga');
    if(!sec) return;
    if(!('IntersectionObserver' in window)){ sec.classList.add('in'); return; }
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if(e.isIntersecting){ sec.classList.add('in'); io.disconnect(); } });
    }, { threshold: 0.25 });
    io.observe(sec);
  })();

  // ---- FAQ (S9b) — akordeon ----
  (function(){
    var items = document.querySelectorAll('.faq-item');
    if(!items.length) return;
    items.forEach(function(item){
      var btn = item.querySelector('.faq-q');
      if(!btn) return;
      btn.addEventListener('click', function(){
        var willOpen = !item.classList.contains('open');
        items.forEach(function(other){
          other.classList.remove('open');
          var b = other.querySelector('.faq-q');
          if(b) b.setAttribute('aria-expanded', 'false');
        });
        if(willOpen){
          item.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  })();

  // ---- Oferta (S4) — linki dróg z megamenu ----
  // Zakładek już nie ma: wszystkie trzy drogi stoją na stronie. Klik w nazwę
  // drogi w megamenu (data-krok-link) przewija do jej grupy, jeśli link
  // prowadzi na tę samą stronę.
  (function(){
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion:reduce)').matches;
    document.querySelectorAll('[data-krok-link]').forEach(function(el){
      var k = el.dataset.krokLink;
      var cel = k && document.getElementById('oferta-' + k);
      if(!cel) return;
      el.addEventListener('click', function(e){
        if(new URL(el.href, location.href).pathname !== location.pathname) return;
        e.preventDefault();
        cel.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      });
    });
  })();

  // ---- Rachunek (S2) — licznik od 0 do wartości docelowej gdy widoczny ----
  (function(){
    var el = document.getElementById('la8-rachunek');
    if(!el) return;
    var vals = el.querySelectorAll('.rcpt-val');
    var totalEl = document.getElementById('rcpt-total');
    var done = false;
    function animate(){
      if(done) return; done = true;
      var t0 = performance.now();
      function step(t){
        var p = Math.min(1, (t - t0) / 1500);
        var rp = 1 - Math.pow(1 - p, 3);
        vals.forEach(function(v){ v.textContent = Math.round(v.dataset.h * rp) + ' h'; });
        if(totalEl) totalEl.textContent = Math.round(totalEl.dataset.total * rp);
        if(p < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }
    if('IntersectionObserver' in window){
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(e){ if(e.isIntersecting){ animate(); io.disconnect(); } });
      }, { threshold: 0.2 });
      io.observe(el);
    } else { animate(); }
  })();

  // ---- Pulpit (hero) — sporadyczny wzrost licznika zadań ----
  (function(){
    var numEl = document.getElementById('tasksNum');
    var labelEl = document.getElementById('tasksLabel');
    if(!numEl) return;
    var n = 42;
    function word(x){
      var m10 = x % 10, m100 = x % 100;
      return (m10 >= 2 && m10 <= 4 && !(m100 >= 12 && m100 <= 14)) ? 'zadania' : 'zadań';
    }
    setInterval(function(){
      if(Math.random() < 0.45){
        n += 1;
        numEl.textContent = n;
        if(labelEl) labelEl.textContent = n + ' ' + word(n) + ' zrobione dziś';
      }
    }, 5200);
  })();


</script>

