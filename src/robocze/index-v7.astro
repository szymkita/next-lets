  .w5-k dt i.w5-przed{background:repeating-linear-gradient(135deg,rgba(214,134,30,0.6) 0 1.5px,rgba(214,134,30,0) 1.5px 4px),rgba(240,163,58,0.22);box-shadow:inset 0 1.5px 0 #e3962f}
