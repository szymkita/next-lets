  .ha-pdf::after{content:"";position:absolute;left:4px;right:4px;top:5px;height:9px;background:repeating-linear-gradient(#e4e4e7 0 1.5px,transparent 1.5px 3.5px)}
  .ha-pdf i{position:absolute;left:0;right:0;top:0;height:2px;background:#10b981;box-shadow:0 0 6px #10b981;opacity:0}
  .ha-pola{display:grid;gap:6px;margin:10px 0 0 32px}
  .ha-pola div{display:grid;grid-template-columns:86px minmax(0,1fr);gap:8px;transition:opacity .35s ease,transform .4s cubic-bezier(.2,.8,.2,1)}
  .ha-pola dt{font-size:11px;color:#71717a}
  .ha-pola dd{margin:0;font-size:12px;font-weight:600}
  .ha-o1.gra .ha-nowa{opacity:0;transform:translateY(-6px)}
  .ha-o1.gra.k1 .ha-nowa{opacity:1;transform:none}
  .ha-o1.gra .s1{opacity:1}
  .ha-o1.gra .s3{opacity:0}
  .ha-o1.gra.k2 .s1{opacity:0}
  .ha-o1.gra.k2 .s2{opacity:1}
  .ha-o1.gra.k6 .s2{opacity:0}
  .ha-o1.gra.k6 .s3{opacity:1}
  .ha-o1.gra.k2:not(.k6) .ha-pdf i{animation:ha-skan 1.1s ease-in-out infinite}
  @keyframes ha-skan{0%{top:0;opacity:0}15%{opacity:1}85%{opacity:1}100%{top:26px;opacity:0}}
  .ha-o1.gra .ha-pola div{opacity:0;transform:translateX(-5px)}
  /* .ha-pola w selektorze: Astro dopisuje atrybut zakresu do każdego członu,
     więc reguła chowająca (… div) waży więcej niż .ha-o1.gra.k3 .p1 */
  .ha-o1.gra.k3 .ha-pola .p1,.ha-o1.gra.k4 .ha-pola .p2,.ha-o1.gra.k5 .ha-pola .p3{opacity:1;transform:none}
  /* 2 · ofertownia */
  .ha-uk{display:grid;grid-template-columns:40px minmax(0,1fr);height:346px}
  .ha-rail{display:flex;flex-direction:column;align-items:center;gap:4px;padding:10px 0;background:#fafaf9;border-right:1px solid rgba(9,9,11,0.07)}
  .ha-rail b{display:grid;place-items:center;width:22px;height:22px;margin-bottom:8px;border-radius:6px;background:#0f1a14}
  .ha-rail b svg{width:11px;height:11px;fill:#00cd77}
  .ha-rail span{display:grid;place-items:center;width:26px;height:26px;border-radius:7px;color:#a1a1aa}
  .ha-rail span svg{width:13px;height:13px;fill:currentColor}
  .ha-rail span.on{background:#ffffff;color:#18181b;box-shadow:0 0 0 1px rgba(9,9,11,0.07)}
  .ha-of-gl{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;margin-bottom:12px}
  .ha-of-gl b{display:block;font-size:14px;font-weight:650;letter-spacing:-0.015em}
  .ha-of-gl small{display:block;margin-top:2px;font-size:11px;color:#71717a}
  .ha-of-w{display:grid;grid-template-columns:minmax(0,1fr) 44px 68px 92px;gap:8px;align-items:center;height:30px;border-bottom:1px solid rgba(9,9,11,0.05);font-size:12px;transition:opacity .35s ease,transform .4s cubic-bezier(.2,.8,.2,1)}
  .ha-of-w > span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .ha-of-w > span:nth-child(2),.ha-of-w > span:nth-child(3){text-align:right}
  .ha-of-w > span:nth-child(2){color:#71717a}
  .ha-of-w > span:nth-child(3){font-weight:600}
  .ha-of-w > span:nth-child(4){padding-left:6px;color:#047857}
  .ha-of-w > span.cz{color:#a15c07}
  .ha-of-w > span.nic{color:#d4d4d8}
  .ha-of-w.n{height:26px;font-size:10.5px;color:#a1a1aa}
  .ha-of-w.n > span{color:#a1a1aa !important;font-weight:400 !important}
  .ha-of-suma{display:flex;justify-content:space-between;align-items:baseline;margin-top:10px;padding:10px 12px;border-radius:9px;background:#f7f7f6;transition:opacity .4s ease}
  .ha-of-suma span{font-size:11.5px;color:#71717a}
  .ha-of-suma b{font-size:17px;font-weight:650;letter-spacing:-0.02em}
  .ha-of-ak{display:flex;align-items:center;gap:8px;margin-top:12px;font-size:11.5px;color:#52525b;transition:opacity .4s ease,transform .45s cubic-bezier(.2,.8,.2,1)}
  .ha-of-ak i{display:grid;place-items:center;flex-shrink:0;width:18px;height:18px;border-radius:5px;background:#0f1a14}
  .ha-of-ak i svg{width:9px;height:9px;fill:#00cd77}
  .ha-of-ak b{font-weight:600;color:#18181b}
  .ha-o2.gra .ha-of-w:not(.n){opacity:0;transform:translateX(-6px)}
  .ha-o2.gra.k2 .r1,.ha-o2.gra.k3 .r2,.ha-o2.gra.k4 .r3,.ha-o2.gra.k5 .r4{opacity:1;transform:none}
  .ha-o2.gra .ha-of-suma{opacity:0}
  .ha-o2.gra.k6 .ha-of-suma{opacity:1}
  .ha-o2.gra .ha-of-ak{opacity:0;transform:translateY(4px)}
  .ha-o2.gra.k7 .ha-of-ak{opacity:1;transform:none}
  .ha-o2.gra .s1{opacity:1}
  .ha-o2.gra .s3{opacity:0}
  .ha-o2.gra.k7 .s1{opacity:0}
  .ha-o2.gra.k7 .s3{opacity:1}
  /* 3 · połączenia (ciemne) */
  .ha-sch{position:relative;height:62px;margin:2px 0 12px}
  .ha-lin{position:absolute;top:30px;height:2px;border-radius:1px;background:rgba(255,255,255,0.12);overflow:hidden}
  .ha-lin::after{content:"";position:absolute;inset:0;background:#00cd77;transform:scaleX(1);transform-origin:0 50%;transition:transform .9s cubic-bezier(.45,0,.25,1)}
  .ha-lin.l1{left:17%;right:50%}
  .ha-lin.l2{left:50%;right:17%}
  .ha-wez{position:absolute;top:8px;width:84px;margin-left:-42px;padding:7px 0 8px;border-radius:9px;background:#13241b;box-shadow:inset 0 0 0 1px rgba(255,255,255,0.1);text-align:center;z-index:1}
  .ha-wez b{display:block;font-size:12.5px;font-weight:700;color:#ffffff}
  .ha-wez small{display:block;margin-top:1px;font-size:10.5px;color:rgba(255,255,255,0.45)}
  .ha-wez.w1{left:17%}
  .ha-wez.w2{left:50%}
  .ha-wez.w3{left:83%}
  .ha-kr{position:absolute;top:31px;left:17%;width:10px;height:10px;margin:-5px 0 0 -5px;border-radius:50%;background:#00cd77;box-shadow:0 0 0 4px rgba(0,205,119,0.18),0 0 12px #00cd77;z-index:0;transition:left .95s cubic-bezier(.45,0,.25,1)}
  .ha-log{margin:0;padding:0;list-style:none}
  .ha-log li{display:grid;grid-template-columns:38px minmax(0,1fr) 16px;gap:8px;align-items:center;height:34px;border-top:1px solid rgba(255,255,255,0.06);font-size:12px;transition:opacity .4s ease,transform .45s cubic-bezier(.2,.8,.2,1)}
  .ha-log time{font-size:11px;color:rgba(255,255,255,0.4);font-variant-numeric:tabular-nums}
  .ha-log span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:rgba(255,255,255,0.86)}
  .ha-log i{display:grid;place-items:center;width:16px;height:16px;border-radius:50%;background:rgba(0,205,119,0.16)}
  .ha-log i svg{width:10px;height:10px;fill:#5fe3a7}
  .ha-o3.gra .ha-lin::after{transform:scaleX(0)}
  .ha-o3.gra.k1 .l1::after,.ha-o3.gra.k2 .l2::after{transform:scaleX(1)}
  .ha-o3.gra.k1 .ha-kr{left:50%}
  .ha-o3.gra.k2 .ha-kr{left:83%}
  .ha-o3.gra.k3 .ha-kr{left:50%}
  .ha-o3.gra.k4 .ha-kr{left:17%}
  .ha-o3.gra .ha-log li{opacity:0;transform:translateY(-4px)}
  .ha-o3.gra.k1 .ha-log .g1,.ha-o3.gra.k2 .ha-log .g2,.ha-o3.gra.k3 .ha-log .g3,.ha-o3.gra.k4 .ha-log .g4{opacity:1;transform:none}
  @media (prefers-reduced-motion:reduce){ .ha-o *{transition:none !important;animation:none !important} }

  /* ---------- v7 · opinie: taśma dużych cytatów ---------- */
  .op7{--p:max(clamp(20px,5vw,56px),calc((100% - 1440px) / 2))}
  .op7-gl{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:0 var(--p)}
  .op7-str{display:flex;gap:8px}
  .op7-str button{display:grid;place-items:center;width:44px;height:44px;border:0;border-radius:50%;background:#16211a;color:#ffffff;cursor:pointer;transition:background .15s,color .15s,opacity .15s,transform .15s}
  .op7-str button svg{width:16px;height:16px;fill:currentColor}
  .op7-str button:hover{background:var(--la-accent,#00CD77);color:#0b1a11}
  .op7-str button:active{transform:scale(.94)}
  .op7-str button:focus-visible{outline:2px solid var(--la-accent,#00CD77);outline-offset:2px}
  .op7-tasma{display:flex;gap:clamp(40px,5vw,80px);margin-top:clamp(28px,3vw,40px);padding:0 var(--p);overflow-x:auto;overscroll-behavior-x:contain;scroll-snap-type:x mandatory;scroll-padding-inline:var(--p);scrollbar-width:none}
  .op7-tasma::-webkit-scrollbar{display:none}
  .op7-tasma:focus-visible{outline:2px solid var(--la-accent,#00CD77);outline-offset:-2px}
  .op7-k{flex:0 0 86%;margin:0;scroll-snap-align:start}
  .op7-k blockquote{margin:0;max-width:1180px;font-size:clamp(26px,3.4vw,48px);line-height:1.1;font-weight:800;letter-spacing:-0.028em;color:#16211a;text-wrap:balance}
  .op7-k blockquote span{color:var(--la-accent,#00CD77)}
  .op7-k figcaption{display:flex;align-items:center;gap:18px;margin-top:clamp(26px,3vw,40px)}
  .op7-k figcaption img{display:block;width:auto;mix-blend-mode:multiply}
  .op7-k figcaption img.z-marginesem{margin:-12px 0 -12px -10px}
  .op7-k figcaption > i{width:1px;height:34px;background:#d8e0d6}
  .op7-k figcaption b{display:block;font-size:15px;font-weight:750;color:#16211a}
  .op7-k figcaption span span{display:block;margin-top:2px;font-size:14px;color:#4c5850}
  .op7-kropki{display:flex;gap:8px;margin-top:clamp(28px,3vw,40px);padding:0 var(--p)}
  .op7-kropki button{width:8px;height:8px;padding:0;border:0;border-radius:4px;background:#c9d4c7;cursor:pointer;transition:width .3s,background .3s}
  .op7-kropki button.on{width:28px;background:#0a7a52}
  @media (max-width:700px){ .op7-k{flex-basis:92%} .op7-str{display:none} }
</style>
