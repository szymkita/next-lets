---
// AI SALES — /aisales. Strona z zaproszeniem dla uczestników kursu AI Sales,
// pod kod QR i link z ostatniego slajdu webinaru „Jak wdrożyć AI w firmie?”
// (19.11.2026). Oferta od Szymona: bezpłatna diagnoza i 5 000 zł rabatu na
// wdrożenie AI. noindex, bez nawigacji, formularz jak w module Kontakt
// (POST /api/kontakt, źródło „AI Sales”).
import LaBase from '../layouts/LaBase.astro';
import Styl from '../components/usluga/Styl.astro';
import Kontakt from '../components/usluga/Kontakt.astro';

const title = "Dla uczestników AI Sales | Let's automate";
const description = 'Bezpłatna diagnoza i 5 000 zł rabatu na wdrożenie AI dla uczestników kursu AI Sales.';
---
<LaBase topbar={false} title={title} description={description} ctaHref="#kontakt" ctaLabel="Zostaw kontakt" nav={null} noindex={true}>
<Styl />
<style>
  .as{max-width:1180px;margin:0 auto;padding:clamp(48px,8vw,112px) 24px clamp(40px,6vw,80px)}
  .as-k{font-size:15px;font-weight:600;letter-spacing:.02em;color:#0A7A52}
  .as h1{margin-top:14px;font-size:clamp(40px,6vw,76px);line-height:1.02;letter-spacing:-.04em;font-weight:700;max-width:900px}
  .as-l{margin-top:20px;max-width:680px;font-size:clamp(18px,2vw,22px);line-height:1.5;color:#5E6A62}
  .as-g{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:18px;margin-top:clamp(32px,5vw,56px)}
  .as-c{padding:30px 32px;border-radius:22px;background:#fff;box-shadow:inset 0 0 0 1.5px rgba(22,33,26,.12)}
  .as-c.on{box-shadow:inset 0 0 0 3px #00CD77}
  .as-c small{display:block;font-size:14px;font-weight:600;color:#5E6A62}
  .as-c b{display:block;margin-top:12px;font-size:clamp(30px,3.4vw,42px);line-height:1.05;letter-spacing:-.03em}
  .as-c.on b{color:#0A7A52}
  .as-c p{margin-top:12px;font-size:17px;line-height:1.5;color:#5E6A62}
  .as-e{margin-top:28px;font-size:16px;color:#5E6A62}
  .as-e a{color:inherit;font-weight:600}
</style>

<div class="v3">
<section class="as" aria-labelledby="as-h1">
  <div class="as-k">Dla uczestników kursu AI Sales</div>
  <h1 id="as-h1">Kolejne etapy wdrożenia AI zróbmy razem</h1>
  <p class="as-l">Czat z wiedzą firmy wdrożycie w 30 dni. Przewagę dają procesy, na których zarabiacie: wchodzimy w nie, ustalamy, co i jak, i budujemy system, który dzieje się sam.</p>
  <div class="as-g">
    <div class="as-c"><small>Na start</small><b>Bezpłatna diagnoza</b><p>Gdzie w Waszej firmie jest przewaga i od czego zacząć. Bez zobowiązań.</p></div>
    <div class="as-c on"><small>Dla uczestników AI Sales</small><b>5 000 zł rabatu</b><p>Na wdrożenie AI z Let's automate.</p></div>
  </div>
  <p class="as-e">Wolicie od razu napisać? <a href="mailto:hello@letsautomate.pl">hello@letsautomate.pl</a></p>
</section>

<Kontakt
  tytul="Zostawcie kontakt"
  lead="Napiszcie jedno zdanie o tym, co chcecie usprawnić. Odezwiemy się w jeden dzień roboczy i umówimy bezpłatną diagnozę."
  zrodlo="AI Sales"
  pytanie="Co chcecie usprawnić?"
  podpowiedz="Np. oferty po spotkaniach zajmują nam po półtorej godziny, a cennik zmienia się co kwartał…"
  po="Bezpłatnie i bez zobowiązań. Rabat 5 000 zł dla uczestników AI Sales."
/>
</div>
</LaBase>
