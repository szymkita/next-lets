// ---- WIDOKI SYSTEMU -----------------------------------------------------
// Interfejs zbudowany w HTML, nie zrzut ekranu: skaluje się, da się go
// poprawić w minutę i nie udaje cudzego wdrożenia. Wszystkie trzy widoki
// pokazują TEN SAM proces, który idzie przez całą stronę — ofertowanie
// u producenta konstrukcji stalowych. Numer sprawy z karty (ZP-2484) stoi
// też w pierwszym wierszu rejestru, więc dwa widoki się ze sobą trzymają.
//
// Każdy opis przy karcie dowodzi tezy, która pada gdzie indziej na stronie:
// dane z systemów (sekcja o silosach), licznik czekania (hero), właściciel
// kroku (definicja), reguła przy decyzji (sekcja o konfiguracji).
const KARTA_POZYCJE = [
  { i: 'BLA 2400×1200×8', n: '12 szt.', st: 'na stanie', ok: true },
  { i: 'CEO 160 S355', n: '48 mb', st: 'na stanie', ok: true },
  { i: 'RUR 88,9×4', n: '30 mb', st: 'brak · dostawa 22.09', ok: false },
];
const KARTA_OBIEG = [
  { t: 'Rejestracja zapytania', s: 'ok', kto: 'automatycznie · 14:02' },
  { t: 'Wycena techniczna', s: 'teraz', kto: 'Michał R. · od 4 godzin', nr: 3 },
  { t: 'Akceptacja marży', s: 'pomin', kto: 'pominięta regułą', nr: 4 },
  { t: 'Wysyłka do klienta', s: 'czeka', kto: '' },
];
const REJESTR = [
