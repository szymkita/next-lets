// ---- OŚ CZASU SPRAWY (hero) --------------------------------------------
// Przykład: od zapytania klienta do wysłanej oferty. Kroki pracy są liczone
// w minutach, postoje w dniach roboczych (osiem godzin). Wszystkie szerokości
// i wszystkie czasy animacji wynikają z tej jednej tablicy.
//
// UWAGA techniczna: paski pracy mają min-width 3 px, więc przy tej skali
// zabierają około trzech procent szerokości ponad swój udział. Bez tego
// byłyby niewidoczne — a to one są pointą rysunku.
const GODZ_DNIA = 8;
const KROKI = [
  { p: true, min: 12, t: 'Handlowiec zakłada sprawę', k: 'zakłada sprawę' },
  { p: false, dni: 2, t: 'Czeka na wycenę technologa', k: 'czeka na wycenę' },
  { p: true, min: 24, t: 'Technolog liczy koszt', k: 'liczy koszt' },
  { p: false, dni: 1.5, t: 'Czeka na dostępność z magazynu', k: 'czeka na magazyn' },
  { p: true, min: 18, t: 'Przepisanie do arkusza i złożenie oferty', k: 'przepisuje do arkusza' },
  { p: false, dni: 2.5, t: 'Czeka na akceptację marży', k: 'czeka na akceptację' },
  { p: true, min: 6, t: 'Wysyłka do klienta', k: 'wysyła' },
];
const kd = (x) => (x.p ? x.min / 60 / GODZ_DNIA : x.dni);   // długość kroku w dniach
const DZIS_DNI = KROKI.reduce((a, x) => a + kd(x), 0);       // 6,125 dnia
const PRACA_MIN = KROKI.filter((x) => x.p).reduce((a, x) => a + x.min, 0);   // 60
const PO_GODZ = 4;
const PO_DNI = PO_GODZ / GODZ_DNIA;
// Odmiana po liczbie: 2-4 biora forme mnoga, ulamki i reszta pojedyncza.
const dniOpis = (d) => (Number.isInteger(d) && d >= 2 && d <= 4 ? d + ' dni' : String(d).replace('.', ',') + ' dnia');
const PRACA_PO_MIN = 42;   // znika przepisywanie do arkusza
const UDZIAL_PO = PO_DNI / DZIS_DNI;

// Kalendarz cyklu. Głowica jedzie przez obie osie z tą samą prędkością —
// dlatego druga kończy się w ułamku czasu pierwszej i to jest cały dowód.
const JAZDA = 9;                       // ile trwa przejazd przez „dziś"
const PRZERWA = 0.8;
const JAZDA2 = JAZDA * UDZIAL_PO;      // ~0,73 s
const START2 = JAZDA + PRZERWA;
const CZ_C = 17;
const CZ_GASNIE = 15.1;
const cp = (s) => `${(Math.max(0, Math.min(1, s / CZ_C)) * 100).toFixed(2)}%`;

let biegDni = 0;
const kroki = KROKI.map((x, i) => {
  const od = biegDni / DZIS_DNI;
  biegDni += kd(x);
  return { ...x, i, od, do: biegDni / DZIS_DNI, udzial: kd(x) / DZIS_DNI };
});

const klatkiCzas = [
  // Wypełnienie każdego kroku rośnie dokładnie wtedy, kiedy mija go głowica.
  ...kroki.map((x) => `@keyframes cz-w${x.i}{0%,${cp(x.od * JAZDA)}{width:0%}${cp(x.do * JAZDA)}{width:100%}${cp(CZ_GASNIE)}{width:100%}100%{width:100%}}`),
  `@keyframes cz-glowica{0%{left:0%;opacity:0}${cp(0.12)}{left:0%;opacity:1}${cp(JAZDA)}{left:100%;opacity:1}${cp(JAZDA + 0.35)}{left:100%;opacity:0}100%{left:100%;opacity:0}}`,
  `@keyframes cz-w2{0%,${cp(START2)}{width:0%}${cp(START2 + JAZDA2)}{width:100%}${cp(CZ_GASNIE)}{width:100%}100%{width:100%}}`,
  `@keyframes cz-glowica2{0%,${cp(START2 - 0.12)}{left:0%;opacity:0}${cp(START2)}{left:0%;opacity:1}${cp(START2 + JAZDA2)}{left:100%;opacity:1}${cp(START2 + JAZDA2 + 0.35)}{left:100%;opacity:0}100%{left:100%;opacity:0}}`,
  `@keyframes cz-suma{0%,${cp(JAZDA + 0.1)}{opacity:0;transform:translateY(4px)}${cp(JAZDA + 0.6)}{opacity:1;transform:translateY(0)}${cp(CZ_GASNIE)}{opacity:1;transform:translateY(0)}100%{opacity:1;transform:translateY(0)}}`,
  `@keyframes cz-suma2{0%,${cp(START2 + JAZDA2)}{opacity:0;transform:translateY(4px)}${cp(START2 + JAZDA2 + 0.5)}{opacity:1;transform:translateY(0)}${cp(CZ_GASNIE)}{opacity:1;transform:translateY(0)}100%{opacity:1;transform:translateY(0)}}`,
  `@keyframes cz-reset{0%,${cp(CZ_GASNIE)}{opacity:1}${cp(CZ_GASNIE + 1.1)}{opacity:0}99.9%{opacity:0}100%{opacity:1}}`,
].join('\n');


