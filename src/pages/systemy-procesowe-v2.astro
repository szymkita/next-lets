  { t: 'Akceptacja marży', v: '3 godziny', u: 33 },
  { t: 'Potwierdzenie dostępności', v: '2 godziny', u: 22 },
  { t: 'Wysyłka do klienta', v: '25 minut', u: 5 },
  { t: 'Rejestracja zapytania', v: '12 minut', u: 3 },
];


// ---- KTÓRE PROCESY ------------------------------------------------------
// Kolumna obok definicji. Trzecia z rzędu figura „czego nie robimy" stała
// wcześniej w tym miejscu i była zmarnowaną przestrzenią: to samo mówi blok
// „kiedy to nie ma sensu" w sekcji o firmach oraz odpowiedź w FAQ.
// Zamiast tego lista nazwanych procesów z działami, przez które biegną —
// czytelnik ma tu rozpoznać swój, a przy okazji widzi tezę o przechodzeniu
// w poprzek działów, zanim dojdzie do rysunku silosów.
const PROCESY = [
  { t: 'Od zapytania do oferty', d: 'handel · technolog · magazyn' },
  { t: 'Od zamówienia do wysyłki', d: 'sprzedaż · produkcja · logistyka' },
  { t: 'Obieg zlecenia serwisowego', d: 'serwis · części · rozliczenia' },
  { t: 'Reklamacje i zwroty', d: 'obsługa · jakość · finanse' },
  { t: 'Od projektu do rozliczenia', d: 'sprzedaż · realizacja · finanse' },
];

// ---- DLA JAKICH FIRM ----------------------------------------------------
// Kwalifikacja postawiona na przewadze, nie na wielkości firmy. Liczba osób
// niczego tu nie rozstrzyga — rozstrzyga to, czy firma ma czym się różnić
// i czy ta różnica siedzi dziś w kilku głowach.
const DLA_KOGO = [
  {
    t: 'Zarabiacie na procesie, który przechodzi przez kilka działów',
    d: 'Zapytanie idzie przez handel, technologa i magazyn. Zlecenie przez serwis, części i rozliczenie. Nikt nie widzi całej ścieżki od początku do końca, a klient ocenia Was po jej długości.',
  },
  {
    t: 'Robicie w nim coś, czego konkurencja nie robi',
    d: 'Nietypowe wyceny, krótsze terminy albo przypadki, których inni nie biorą. Dziś ta wiedza siedzi w kilku głowach i firma rośnie tylko tak szybko, jak te głowy zdążą.',
  },
  {
    t: 'Wolumen jest na tyle duży, że dzień czekania widać w wyniku',
    d: 'Setki spraw miesięcznie. Przy takiej skali doba stracona na akceptację przestaje być drobiazgiem operacyjnym i zaczyna być liczbą, o którą pyta zarząd.',
  },
  {
    t: 'Sprzedaż rośnie szybciej niż zespół, który to obsługuje',
    d: 'Każde kolejne kilkanaście procent obrotu wymaga kolejnych etatów w tym samym tempie. To jest moment, w którym proces przestaje się skalować, i zwykle wtedy do nas piszecie.',
  },
];
const NIE_TERAZ = [
  'Proces mieści się w jednym dziale i w jednym narzędziu — wtedy gotowe rozwiązanie wychodzi taniej.',
  'Chodzi o księgowość, kadry albo płace. Tam liczy się zgodność z przepisami, a nie Wasz sposób pracy, więc gotowego rozwiązania nie przebijemy.',
  'Firma jest w środku wymiany ERP-a. Proces za kwartał wygląda inaczej, więc lepiej zmierzyć go po zmianie.',
  'Model biznesowy jeszcze się szuka i proces zmienia się co miesiąc. Utrwalanie go w systemie byłoby przedwczesne.',
];

const faq = [
  {
    q: 'Dlaczego nie kupić gotowego systemu?',
    a: 'Bo gotowe systemy są kupowane po dziale, a proces biegnie w poprzek działów. Granica biegnie po przewadze: przy księgowości, kadrach czy płacach liczy się zgodność z przepisami i gotowe rozwiązanie zawsze wygra, więc powiemy to na pierwszej rozmowie. Tam, gdzie proces jest Waszą przewagą, budowanie zwykle się opłaca — i czasem oznacza to, że przejmujemy rolę CRM-a albo tę część ERP-a, która ten proces prowadzi.',
  },
  {
    q: 'Ile kosztuje taki system?',
    a: 'Wyceniamy uruchomienie po uruchomieniu. Kwota za pierwsze jest stała i podajemy ją po warsztacie, na którym proces jest rozłożony na kroki. Cenę ruszają trzy rzeczy: liczba systemów, do których trzeba się wpiąć, liczba kroków z akceptacją oraz to, ile wyjątków ma trafić do systemu, a ile zostaje przy ludziach. Następne wyceniamy osobno, kiedy przychodzi ich czas.',
  },
  {
    q: 'Co, jeśli wymagania zmienią się w trakcie?',
    a: 'Dlatego droga do uruchomienia trwa kilka tygodni. Zmiana zgłoszona po drodze wchodzi do następnego, chyba że wywraca to, co właśnie budujemy — wtedy przerywamy i przeliczamy zakres razem z Wami. Przy projekcie rozpisanym na rok zmiana wymagań jest katastrofą; przy sześciotygodniowym etapie jest zwykłą decyzją.',
  },
  {
    q: 'Co, jeśli po pierwszym uruchomieniu stwierdzimy, że to nie to?',
    a: 'Kończycie. To, co powstało, pracuje na produkcji i zostaje Wasze razem z kodem i dokumentacją. Zakres pierwszego uruchomienia jest tak wyznaczony, żeby sam z siebie miał sens — zwykle skraca czas sprawy o połowę, nawet jeśli nigdy nie powstanie drugie. Nie ma tu etapu, po którym zostaje połowa systemu i faktura.',
  },
  {
    q: 'Czy nie uzależnimy się od Was?',
    a: 'Repozytorium, dokumentacja i dostęp do infrastruktury są Wasze od pierwszego dnia. Reguły, progi, kroki obiegu i formularze siedzą w konfiguracji, więc zmienia je Wasz człowiek bez naszego udziału. Umowa utrzymaniowa jest osobna od budowy i wypowiadalna z miesięcznym terminem. Piszemy na powszechnych technologiach, żeby przejęcie przez inny zespół było zwykłą rekrutacją.',
  },
  {
    q: 'Co z danymi z obecnych systemów?',
    a: 'Sprawy w toku przenosimy razem ze stanem, historia zwykle zostaje tam, gdzie jest, i podpinamy do niej podgląd. Migracja całej historii bywa droższa od reszty uruchomienia i rzadko się zwraca, więc za każdym razem liczymy ją osobno i pokazujemy rachunek przed decyzją.',
  },
  {
    q: 'Ile czasu zajmie to naszym ludziom?',
    a: 'Najwięcej na starcie: dwa dni warsztatu z osobami, które prowadzą proces dzisiaj, i dostęp do systemów. Potem godzina w tygodniu na pokaz tego, co powstało, i decyzje przy wyjątkach. Przed uruchomieniem dochodzi kilka dni testów na prawdziwych sprawach po Waszej stronie — to jedyny moment, w którym potrzebujemy więcej niż jednej osoby naraz.',
  },
  {
    q: 'Czy taki system ma w środku AI?',
    a: 'Tylko tam, gdzie zarabia na siebie. Większość tego, co skraca czas sprawy, to rejestr, obieg i integracje — bez modelu. Jeśli w procesie jest krok, który wymaga odczytania treści albo oceny, wchodzi <a href="/rozwiazania-ai" style="font-weight:700;color:#0a7a52">indywidualne rozwiązanie AI</a> jako element systemu, z własnym progiem pewności i ścieżką wyjątku.',
  },
  {
    q: 'Na czym budujecie?',
    a: 'Na powszechnych technologiach webowych i na bazie, którą utrzyma każdy zespół. Połączenia z Waszymi systemami idą przez ich API, a tam gdzie API nie ma — przez wymianę plików albo bezpośrednio przez bazę, po ustaleniu tego z Waszym IT. Przy każdym elemencie zapisujemy, na czym stoi i ile kosztuje jego utrzymanie przez rok.',
  },
  {
    q: 'Kto to utrzymuje po uruchomieniu?',
    a: 'Wasz zespół, my albo inna firma. Jeśli utrzymujemy my, umowa obejmuje czas reakcji, poprawki i aktualizacje zależności, a rozliczenie idzie miesięcznie. Zmiany w konfiguracji nie wchodzą do tej umowy, bo robi je Wasz człowiek — dlatego przy odbiorze pokazujemy dokładnie, co da się zmienić bez nas.',
  },
];
dane['@graph'].push({
  '@type': 'FAQPage',
  '@id': `${kanon}#faq`,
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
  })),
});
---
<LaBase noindex title={title} description={description} ctaHref="#kontakt" ctaLabel="Umów rozmowę" nav="uslugi">
<script type="application/ld+json" is:inline set:html={JSON.stringify(dane)} slot="head"></script>
<style is:global slot="head">
  /* ================= oś czasu sprawy (hero) =================
     Dwie osie w jednej skali. Głowica jedzie przez obie z tą samą prędkością,
     więc druga naprawdę kończy się w ułamku czasu pierwszej — czas jest tu
     jednocześnie daną i mechanizmem animacji. Szerokości kroków wynikają
     z tablicy w nagłówku pliku. */
  .cz{position:relative}
  .cz-wiersz{display:grid;grid-template-columns:clamp(74px,8vw,104px) minmax(0,1fr);gap:clamp(12px,1.6vw,20px);align-items:center}
  .cz-wiersz + .cz-wiersz{margin-top:clamp(26px,3.2vw,38px)}
  .cz-kto{font-size:13.5px;font-weight:700;color:#16211a;line-height:1.25}
  .cz-kto span{display:block;margin-top:2px;font-size:12px;font-weight:500;color:#9aa69b}
  .cz-os{position:relative;display:flex;height:clamp(34px,3.6vw,44px);border-radius:8px;overflow:hidden;background:#eef2ec}
  .cz-os.krotka{width:var(--u);border-radius:8px}
  /* Kroki pracy maja 7 px minimum, bo przy tej skali zajmowalyby ulamek
     piksela - a to one sa pointa rysunku. Kosztuje to okolo czterech
     procent szerokosci ponad ich prawdziwy udzial. */
  .cz-seg{position:relative;min-width:7px;overflow:hidden}
  .cz-seg + .cz-seg{box-shadow:inset 1px 0 0 #ffffff}
  .cz-seg i{position:absolute;left:0;top:0;bottom:0;width:0;background:#ccd5c9}
  .cz-seg.praca{background:#dceee3}
  .cz-seg.praca i{background:var(--la-accent,#00CD77)}
  .cz-seg b{position:absolute;left:11px;right:8px;top:50%;transform:translateY(-50%);font-size:12px;font-weight:600;color:#5b665e;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;z-index:2}
  .cz-seg .krotko{display:none}
  .cz-glowica{position:absolute;top:-7px;bottom:-7px;width:2px;background:#16211a;z-index:3;opacity:0}
  .cz-glowica::before{content:"";position:absolute;left:50%;top:-4px;width:8px;height:8px;border-radius:50%;background:#16211a;transform:translateX(-50%)}
  .cz-rzad{display:flex;align-items:center;gap:clamp(10px,1.4vw,16px)}
  .cz-skala{position:relative;display:block;height:22px;margin-top:7px}
  .cz-skala i{position:absolute;top:0;width:1px;height:5px;background:#d5ded3}
  .cz-skala i b{position:absolute;left:50%;top:7px;transform:translateX(-50%);font-family:ui-monospace,Menlo,monospace;font-size:10.5px;font-weight:400;color:#a9b3aa}
  .cz-skala em{position:absolute;left:0;top:7px;font-style:normal;font-size:10.5px;color:#b6bfb6}
  .cz-suma{margin:8px 0 0;font-size:14px;line-height:1.45;color:#4c5850;opacity:0}
  .cz-suma b{font-weight:750;color:#16211a}
  .cz-suma.obok{margin:0;flex-shrink:0}
  .cz-pod{margin:clamp(26px,3.2vw,36px) 0 0;font-size:14.5px;line-height:1.6;color:#4c5850;max-width:560px;text-wrap:pretty}
  .cz-pod strong{font-weight:700;color:#16211a}
  @media (max-width:820px){
    .cz-seg b{font-size:11px;left:8px}
    .cz-seg .dlugo{display:none}
    .cz-seg .krotko{display:inline}
  }
  @media (max-width:640px){
    .cz-wiersz{grid-template-columns:1fr;gap:9px}
    .cz-kto span{display:inline;margin-left:7px}
    .cz-skala em{display:none}
    .cz-os{height:30px}
    .cz-rzad{flex-wrap:wrap}
    .cz-suma.obok{margin-top:8px}
  }
  @media (prefers-reduced-motion:reduce){
    .cz-seg i,.cz-suma,.cz-os{animation:none !important}
    .cz-seg i{width:100%}
    .cz-suma{opacity:1}
    .cz-glowica{display:none}
  }

  /* ================= silosy =================
     Narzędzia stoją w pionie jak słupki, proces biegnie w poprzek nich.
     Przerwy między słupkami są bursztynowe i podpisane — tam czeka sprawa. */
  .sl{margin-top:clamp(30px,3.6vw,44px)}
  .sl-rzad{display:flex;align-items:stretch;gap:0}
  .sl-n{flex:1;min-width:0;position:relative;height:clamp(118px,12.5vw,156px);padding:16px 12px 48px;border:1px solid #dde7db;background:#fbfcfa;border-radius:12px;background:#ffffff;display:flex;flex-direction:column;align-items:center;gap:9px;opacity:0;transform:translateY(10px);transition:opacity .45s ease,transform .45s cubic-bezier(.34,1.3,.5,1);transition-delay:var(--d)}
  .sl.on .sl-n{opacity:1;transform:none}
  .sl-n b{font-size:14px;font-weight:700;color:#16211a;margin-bottom:3px}
  .sl-n em{display:block;width:var(--w);height:4px;border-radius:2px;background:#e4ebe0;font-style:normal}
  .sl-p{position:relative;flex:0 0 clamp(52px,7vw,96px)}
  .sl-p i{position:absolute;left:0;right:0;bottom:30px;height:3px;background:repeating-linear-gradient(90deg,#d99a3c 0 6px,transparent 6px 12px);opacity:0;transition:opacity .4s ease;transition-delay:var(--d)}
  .sl.on .sl-p i{opacity:1}
  .sl-p b{position:absolute;left:50%;bottom:9px;transform:translateX(-50%) translateY(-4px);font-size:11.5px;font-weight:650;color:#b07524;white-space:nowrap;opacity:0;transition:opacity .4s ease,transform .4s ease;transition-delay:var(--d)}
  .sl.on .sl-p b{opacity:1;transform:translateX(-50%)}
  /* Linia procesu przechodzi przez słupki na tej samej wysokości. */
  .sl-n::after{content:"";position:absolute;left:-1px;right:-1px;bottom:30px;height:3px;background:var(--la-accent,#00CD77);transform:scaleX(0);transform-origin:left;transition:transform .5s cubic-bezier(.4,0,.2,1);transition-delay:var(--d)}
  .sl.on .sl-n::after{transform:none}
  .sl-legenda{display:flex;flex-wrap:wrap;gap:8px 26px;margin-top:18px;font-size:13px;color:#637066}
  .sl-legenda span{display:inline-flex;align-items:center;gap:8px}
  .sl-legenda i{width:22px;height:3px;border-radius:2px;display:inline-block}
  @media (max-width:820px){
    .sl{overflow-x:auto;-webkit-overflow-scrolling:touch;padding-bottom:6px}
    .sl-rzad{min-width:660px}
    .sl-n{height:126px;padding-bottom:44px}
    .sl-legenda{min-width:0}
  }
  @media (prefers-reduced-motion:reduce){ .sl-n,.sl-n::after,.sl-p i,.sl-p b{transition:none} }


  /* ================= widoki systemu =================
     Poziomy pas z przewijaniem zamiast dwóch pięter ekranów — cztery widoki
     zajmują tyle wysokości, co jeden. Interfejs jest rysowany w HTML, nie
     wklejony jako obrazek: skaluje się, poprawia się go w minutę i nie udaje
     cudzego wdrożenia. Docelowo do podmiany na widoki z prawdziwego UI.
     Pas wychodzi poza prawą krawędź kolumny treści, żeby było widać, że
     jest dalej. Przewijanie działa bez JS; strzałki są dodatkiem. */
  .ui-pas{display:flex;gap:clamp(16px,2vw,26px);margin-top:clamp(26px,3.2vw,38px);overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding-left:0;
    margin-right:calc(-1 * max(clamp(20px,5vw,56px),calc((100vw - 1440px) / 2)));
    padding:4px max(clamp(20px,5vw,56px),calc((100vw - 1440px) / 2)) 6px 0;
    scrollbar-width:none;-ms-overflow-style:none}
  .ui-pas::-webkit-scrollbar{display:none}
  .ui-poz{flex:0 0 clamp(280px,74vw,600px);scroll-snap-align:start;display:flex;flex-direction:column;margin:0}
  .ui-okno{flex:1;display:flex;flex-direction:column;background:#ffffff;border:1px solid #dfe7dc;border-radius:14px;overflow:hidden;box-shadow:0 22px 46px -32px rgba(18,38,28,0.32)}
  .ui-pasek{display:flex;align-items:center;gap:10px;padding:11px 14px;border-bottom:1px solid #eaefe8;background:#fbfcfa}
  .ui-znak{width:14px;height:14px;border-radius:4px;background:var(--la-accent,#00CD77);flex-shrink:0}
  .ui-app{font-size:12.5px;font-weight:700;color:#16211a}
  .ui-sciezka{font-size:12px;color:#a9b3aa;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .ui-kto{margin-left:auto;font-size:12px;color:#637066;white-space:nowrap}
  .ui-tresc{padding:clamp(14px,1.6vw,18px)}
  .ui-tyt{display:flex;align-items:baseline;flex-wrap:wrap;gap:7px 11px}
  .ui-tyt h3{margin:0;font-size:16px;font-weight:750;letter-spacing:-0.015em;color:#16211a}
  .ui-stan{font-size:11px;font-weight:700;color:#0a7a52;background:#e2f5ea;border-radius:6px;padding:3px 8px}
  .ui-czeka{display:inline-flex;align-items:center;gap:6px;margin-left:auto;font-size:12px;font-weight:650;color:#b07524}
  .ui-czeka i{display:block;width:6px;height:6px;border-radius:50%;background:#d99a3c}
  .ui-kolumny{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:clamp(14px,1.8vw,22px);margin-top:13px}
  .ui-blok + .ui-blok{margin-top:13px}
  .ui-etykieta{display:block;font-size:10.5px;font-weight:650;letter-spacing:0.04em;color:#a9b3aa;margin-bottom:6px}
  .ui-pole{display:flex;align-items:baseline;gap:7px;font-size:12.5px;color:#16211a;padding:6px 0;border-bottom:1px solid #f1f4ef}
  .ui-pole b{font-weight:650}
  .ui-zrodlo{font-size:10px;font-weight:600;color:#0a7a52;background:#eef7f1;border-radius:4px;padding:2px 5px;white-space:nowrap}
  .ui-wiersz{display:grid;grid-template-columns:minmax(0,1fr) 54px minmax(0,96px);gap:8px;align-items:center;font-size:12px;color:#16211a;padding:6px 0;border-bottom:1px solid #f1f4ef}
  .ui-wiersz span:nth-child(2){color:#637066;text-align:right}
  .ui-wiersz em{font-style:normal;font-size:11px;color:#0a7a52}
  .ui-wiersz em.brak{color:#b07524}
  .ui-krok{display:grid;grid-template-columns:14px minmax(0,1fr);gap:9px;align-items:start;padding:7px 0}
  .ui-krok + .ui-krok{border-top:1px solid #f1f4ef}
  .ui-pkt{margin-top:2px;width:13px;height:13px;border-radius:50%;border:2px solid #dfe7dc;background:#ffffff}
  .ui-krok.ok .ui-pkt{border-color:var(--la-accent,#00CD77);background:var(--la-accent,#00CD77)}
  .ui-krok.teraz .ui-pkt{border-color:var(--la-accent,#00CD77);box-shadow:0 0 0 3px rgba(0,205,119,0.18)}
  .ui-krok b{display:block;font-size:12px;font-weight:650;color:#16211a}
  .ui-krok.czeka b{color:#a9b3aa}
  .ui-krok span{display:block;margin-top:2px;font-size:11px;color:#637066}
  .ui-akcje{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px;padding-top:12px;border-top:1px solid #eef2ec}
  .ui-btn{font-size:12px;font-weight:700;padding:8px 14px;border-radius:8px;background:#16211a;color:#ffffff}
  .ui-btn.cichy{background:#f1f4ef;color:#4c5850}
  .ui-rej{display:grid;grid-template-columns:66px minmax(0,1fr) minmax(0,1fr) 70px;gap:9px;align-items:center;font-size:12px;padding:8px 0;border-bottom:1px solid #f1f4ef}
  .ui-rej:last-of-type{border-bottom:0}
  .ui-rej.naglowek{font-size:10.5px;font-weight:650;letter-spacing:0.04em;color:#a9b3aa;padding-top:0}
  .ui-rej b{font-family:ui-monospace,Menlo,monospace;font-size:11px;font-weight:600;color:#4c5850}
  .ui-rej span:nth-child(2){font-weight:650;color:#16211a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .ui-rej span:nth-child(3){color:#4c5850;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .ui-rej i{font-style:normal;text-align:right;color:#637066}
  .ui-rej i.zle{color:#b07524;font-weight:700}
  .ui-reg{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:11px 0;border-bottom:1px solid #f1f4ef}
  .ui-reg:last-of-type{border-bottom:0}
  .ui-reg span{font-size:12px;color:#4c5850}
  .ui-reg b{flex-shrink:0;font-size:12px;font-weight:700;color:#16211a;background:#f4f8f2;border:1px solid #e2e9e0;border-radius:7px;padding:6px 10px}
  .ui-zapisz{display:flex;justify-content:flex-end;margin-top:13px}
  /* kokpit */
  .ui-kafle{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
  .ui-kafel{padding:11px 12px;border:1px solid #eef2ec;border-radius:10px;background:#fbfcfa}
  .ui-kafel span{display:block;font-size:10.5px;color:#a9b3aa;line-height:1.3}
  .ui-kafel b{display:block;margin-top:5px;font-size:19px;font-weight:800;letter-spacing:-0.02em;color:#16211a}
  .ui-kafel em{display:block;margin-top:2px;font-style:normal;font-size:10.5px;color:#0a7a52}
  .ui-kafel.uwaga b{color:#b07524}
  .ui-stoi{display:grid;grid-template-columns:minmax(0,1fr) 62px;gap:9px 12px;align-items:center;font-size:12px;color:#16211a;padding:8px 0;border-bottom:1px solid #f1f4ef}
  .ui-stoi:last-of-type{border-bottom:0}
  .ui-stoi i{grid-column:1 / -1;display:block;height:5px;margin-top:-4px;border-radius:3px;background:#e4ebe1}
  .ui-stoi i b{display:block;height:100%;width:var(--u);border-radius:3px;background:var(--la-accent,#00CD77)}
  .ui-stoi span:last-of-type{text-align:right;color:#637066}
  /* podpisy i sterowanie */
  .ui-poz figcaption{margin-top:13px;font-size:13.5px;line-height:1.5;color:#4c5850;text-wrap:pretty}
  .ui-poz figcaption b{display:block;font-size:14.5px;font-weight:700;color:#16211a;margin-bottom:2px}
  .ui-ster{display:flex;gap:8px;margin-left:auto}
  .ui-strz{appearance:none;width:38px;height:38px;border-radius:50%;border:1px solid #d5e0d3;background:#ffffff;color:#16211a;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:border-color .15s,background .15s,opacity .2s}
  .ui-strz:hover{border-color:var(--la-accent,#00CD77);background:#f4f8f2}
  .ui-strz[disabled]{opacity:.35;cursor:default}
  .ui-strz[hidden]{display:none}
  .ui-nota{margin:clamp(20px,2.4vw,28px) 0 0;font-size:13.5px;line-height:1.55;color:#637066;max-width:760px}
  @media (max-width:900px){
    .ui-kolumny{grid-template-columns:1fr}
    .ui-ster{display:none}
  }
  @media (max-width:560px){
    .ui-rej{grid-template-columns:60px minmax(0,1fr) 58px}
    .ui-rej span:nth-child(3){display:none}
    .ui-kafle{grid-template-columns:1fr 1fr}
    .ui-kafel:first-child{grid-column:1 / -1}
  }
  @media (prefers-reduced-motion:reduce){ .ui-pas{scroll-behavior:auto} }

  /* ================= powody ================= */
  .pw-row{display:grid;grid-template-columns:minmax(0,0.95fr) minmax(0,1.15fr);gap:clamp(18px,3vw,48px);align-items:baseline;padding:clamp(20px,2.4vw,28px) 0;border-top:1px solid #e2e9e0}
  .pw-row:last-of-type{border-bottom:1px solid #e2e9e0}
  .pw-t{margin:0;font-size:clamp(17px,2vw,20px);font-weight:750;letter-spacing:-0.015em;line-height:1.3;color:#16211a;text-wrap:balance}
  .pw-d{margin:0;font-size:15px;line-height:1.6;color:#4c5850;text-wrap:pretty}
  @media (max-width:760px){ .pw-row{grid-template-columns:1fr;gap:7px} }

  /* ================= które procesy (kolumna przy definicji) ================= */
  .pc-h{margin:0 0 4px;font-size:15.5px;font-weight:750;letter-spacing:-0.01em;color:#16211a}
  .pc-row{padding:12px 0;border-top:1px solid #e4ebe2}
  .pc-row:last-of-type{border-bottom:1px solid #e4ebe2}
  .pc-t{display:block;font-size:14.5px;font-weight:700;letter-spacing:-0.01em;line-height:1.3;color:#16211a;text-wrap:balance}
  .pc-d{display:block;margin-top:3px;font-size:12.5px;color:#637066}
  .pc-nota{margin:13px 0 0;font-size:13px;line-height:1.55;color:#637066;text-wrap:pretty}

  /* ================= dla jakich firm =================
     Duży numer w lewej kolumnie zamiast kolejnego wiersza dwukolumnowego —
     to jedyna lista warunków na stronie i ma się czytać jako lista.
     Blok „kiedy to nie ma sensu" jest wcięty i przygaszony: niczego nie
     sprzedaje i dlatego uwiarygodnia cztery punkty nad sobą. */
  .dl-row{display:grid;grid-template-columns:46px minmax(0,0.9fr) minmax(0,1.2fr);gap:clamp(16px,2.6vw,44px);align-items:start;padding:clamp(20px,2.4vw,28px) 0;border-top:1px solid #e2e9e0}
  .dl-row:last-of-type{border-bottom:1px solid #e2e9e0}
  .dl-n{font-size:clamp(22px,2.6vw,30px);font-weight:800;letter-spacing:-0.03em;line-height:1;color:#dbe4d8;padding-top:2px}
  .dl-t{margin:0;font-size:clamp(17px,2vw,20px);font-weight:750;letter-spacing:-0.015em;line-height:1.3;color:#16211a;text-wrap:balance}
  .dl-d{margin:0;font-size:15px;line-height:1.6;color:#4c5850;text-wrap:pretty}
  .dl-nie{margin:clamp(32px,3.8vw,48px) 0 0 clamp(0px,4vw,64px);padding-left:clamp(18px,2vw,26px);border-left:2px solid #dde7db;max-width:760px}
  .dl-nie h3{margin:0;font-size:15.5px;font-weight:750;letter-spacing:-0.01em;color:#4c5850}
  .dl-nie p{margin:10px 0 0;font-size:14.5px;line-height:1.6;color:#637066;text-wrap:pretty}
  @media (max-width:860px){
    .dl-row{grid-template-columns:34px minmax(0,1fr);gap:12px 14px}
    .dl-row > p:last-child{grid-column:2}
  }

  /* ================= uruchomienia (ciemny pas) =================
     Ten sam pasek czasu sprawy, co w hero, kurczący się po każdym
     uruchomieniu. Przy każdym wierszu stoi to, co znika z pracy ludzi. */
  .od-row{display:grid;grid-template-columns:minmax(130px,170px) minmax(0,1.35fr) minmax(200px,0.9fr);gap:clamp(20px,3.2vw,52px);align-items:start;padding:clamp(24px,3vw,34px) 0;border-top:1px solid rgba(255,255,255,0.14)}
  .od-row:last-of-type{border-bottom:1px solid rgba(255,255,255,0.14)}
  .od-e{display:block;font-size:15.5px;font-weight:750;color:#ffffff}
  .od-tyg{display:block;margin-top:3px;font-family:ui-monospace,Menlo,monospace;font-size:11.5px;color:rgba(255,255,255,0.62)}
  .od-t{margin:0;font-size:clamp(17px,2vw,21px);font-weight:750;letter-spacing:-0.015em;line-height:1.25;color:#ffffff;text-wrap:balance}
  .od-d{margin:9px 0 0;font-size:15px;line-height:1.6;color:rgba(255,255,255,0.72);text-wrap:pretty}
  .od-znika{display:inline-flex;align-items:center;gap:8px;margin-top:14px;font-size:13.5px;font-weight:650;color:var(--la-accent,#00CD77)}
  .od-os{position:relative;display:block;height:16px;border-radius:5px;background:rgba(255,255,255,0.1);overflow:hidden}
  .od-os i{position:absolute;left:0;top:0;bottom:0;width:0;border-radius:5px;background:var(--la-accent,#00CD77);transition:width .8s cubic-bezier(.4,0,.2,1);transition-delay:var(--d)}
  .odc.on .od-os i{width:var(--u)}
  .od-l{display:block;margin-top:10px;font-size:14px;color:rgba(255,255,255,0.72)}
  .od-l b{font-weight:750;color:#ffffff}
  .od-cap{display:block;margin-bottom:9px;font-size:12.5px;color:rgba(255,255,255,0.62)}
  @media (max-width:900px){ .od-row{grid-template-columns:1fr;gap:14px} }
  @media (prefers-reduced-motion:reduce){ .od-os i{transition:none} }

  /* ================= konfiguracja ================= */
  .kf{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 clamp(36px,6vw,80px);margin-top:clamp(26px,3.2vw,38px)}
  .kf-b{padding:clamp(16px,2vw,22px) 0;border-top:1px solid #e7ece4}
  .kf-t{display:flex;align-items:baseline;gap:10px;margin:0;font-size:16px;font-weight:700;letter-spacing:-0.012em;color:#16211a}
  .kf-t i{flex-shrink:0;display:block;width:6px;height:6px;border-radius:50%;background:var(--la-accent,#00CD77)}
  .kf-d{margin:7px 0 0 16px;font-size:14.5px;line-height:1.55;color:#4c5850;text-wrap:pretty}
  @media (max-width:760px){ .kf{grid-template-columns:1fr} }

  /* ================= pas wezwania ================= */
  .ps{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:18px 40px;padding:clamp(26px,3vw,36px) 0;border-top:1px solid #e7ece4;border-bottom:1px solid #e7ece4}
  .ps p{margin:0;max-width:640px;font-size:clamp(18px,2.2vw,24px);line-height:1.35;letter-spacing:-0.018em;font-weight:700;color:#16211a;text-wrap:pretty}

  /* ================= przykłady ================= */
  .px-row{display:grid;grid-template-columns:minmax(190px,0.62fr) minmax(0,1.2fr) minmax(200px,0.72fr);gap:clamp(20px,3.2vw,52px);align-items:start;padding:clamp(26px,3.2vw,40px) 0;border-top:1px solid #dde7db}
  .px-row:last-of-type{border-bottom:1px solid #dde7db}
  .px-f{display:block;margin:0;font-size:clamp(18px,2.1vw,22px);font-weight:750;letter-spacing:-0.018em;color:#16211a}
  .px-m{display:block;margin-top:4px;font-size:13.5px;color:#637066}
  .px-p{display:block;margin-top:14px;font-size:14px;font-weight:700;color:#0a7a52}
  .px-d{margin:0;font-size:15px;line-height:1.6;color:#16211a;text-wrap:pretty}
  .px-l{margin:14px 0 0;font-size:14px;line-height:1.55;color:#637066}
  .px-l b{display:block;font-size:12.5px;font-weight:600;color:#a9b3aa;margin-bottom:3px}
  .px-cap{display:block;font-size:12.5px;color:#a0aba1}
  .px-por{display:flex;align-items:baseline;gap:10px;margin-top:6px;font-size:clamp(24px,2.8vw,30px);font-weight:800;letter-spacing:-0.028em;line-height:1;color:#16211a}
  .px-por s{text-decoration:none;font-size:clamp(17px,2vw,20px);font-weight:700;color:#a9b3aa;position:relative}
  .px-por s::after{content:"";position:absolute;left:-2px;right:-2px;top:52%;height:1.5px;background:#c3ccc2}
  .px-por em{font-style:normal;font-size:16px;font-weight:600;color:#a9b3aa}
  .px-os{position:relative;display:block;height:9px;margin-top:14px;border-radius:5px;background:#e0e8de;overflow:hidden}
  .px-os i{position:absolute;left:0;top:0;bottom:0;border-radius:5px;background:var(--la-accent,#00CD77);width:0;transition:width .85s cubic-bezier(.4,0,.2,1)}
  .px-row.on .px-os i{width:var(--u)}
  .px-op{display:block;margin-top:9px;font-size:13px;line-height:1.5;color:#637066}
  @media (max-width:1000px){
    .px-row{grid-template-columns:minmax(0,1fr) minmax(190px,0.66fr)}
    .px-row > :first-child{grid-column:1 / -1}
  }
  @media (max-width:700px){
    .px-row{grid-template-columns:1fr;gap:16px}
    .px-row > :first-child{grid-column:auto}
  }
  @media (prefers-reduced-motion:reduce){ .px-os i{transition:none} }

  /* =====================================================================
     v2 · WARSTWA GRAFICZNA NA WZÓR STRONY GŁÓWNEJ
     Reguły niżej nadpisują część reguł v1 — stoją po nich celowo.
     ===================================================================== */
  @keyframes v2-unos{0%,100%{transform:translateY(-4px) rotate(var(--rot,0deg))}50%{transform:translateY(5px) rotate(var(--rot,0deg))}}
  .v2-plansza{background:linear-gradient(160deg,#eef5ee 0%,#e4efe6 55%,#eaf2ea 100%);border-radius:26px}
  .v2-okno{position:relative;background:#ffffff;border-radius:14px;border:1px solid rgba(20,33,26,0.08);box-shadow:0 34px 70px -34px rgba(15,30,22,0.42),0 2px 6px -2px rgba(15,30,22,0.06);overflow:hidden}
  /* pływająca karta — ten sam wzór, co powiadomienia nad pulpitem na stronie głównej */
  .v2-kp{display:flex;align-items:center;gap:11px;background:#ffffff;border:1px solid #eef1ec;border-radius:12px;padding:11px 16px;box-shadow:0 18px 44px -16px rgba(12,28,20,0.32);text-align:left}
  .v2-kp b{display:block;font-size:13.5px;font-weight:650;color:#16211a;white-space:nowrap}
  .v2-kp > span:last-child > span{display:block;margin-top:2px;font-size:11.5px;color:#637066;white-space:nowrap}
  .v2-ik{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:24px;height:24px;border-radius:50%;font-size:12px;font-weight:800}
  .v2-ik.czeka{background:#f9efd8;color:#8f6c1c}
  .v2-ik.gotowe{background:#e6f7ec;color:#0a7a52}

  /* ---- hero: oś czasu w oknie systemu, okno na planszy ---- */
  .hs-scena{position:relative;padding:clamp(50px,5.2vw,64px) clamp(18px,3vw,40px) clamp(46px,4.8vw,60px)}
  .hs-scena::before{content:"";position:absolute;left:10%;right:10%;top:16%;height:62%;background:radial-gradient(closest-side,rgba(0,205,119,0.24),rgba(0,205,119,0) 72%);filter:blur(30px);pointer-events:none}
  .hs-pasek{display:flex;align-items:center;gap:12px;padding:10px 14px;background:#fbfcfa;border-bottom:1px solid #eef1ec}
  .hs-kropki{display:flex;gap:6px;flex-shrink:0}
  .hs-kropki i{display:block;width:9px;height:9px;border-radius:50%;background:#e3e7e0}
  .hs-adres{margin:0 auto;min-width:0;background:#f1f4ee;border-radius:7px;padding:4px 14px;font-family:ui-monospace,Menlo,monospace;font-size:11px;color:#7d8a80;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .hs-av{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:24px;height:24px;border-radius:50%;background:#dcefe2;color:#0a7a52;font-size:10px;font-weight:800}
  .hs-tresc{padding:clamp(16px,2vw,22px) clamp(16px,2vw,22px) clamp(20px,2.4vw,26px)}
  .hs-tyt{display:flex;align-items:baseline;flex-wrap:wrap;gap:4px 10px;margin-bottom:clamp(16px,2vw,22px);padding-bottom:12px;border-bottom:1px solid #f1f4ef}
  .hs-tyt b{font-size:15px;font-weight:750;letter-spacing:-0.01em;color:#16211a}
  .hs-tyt span{font-size:12.5px;color:#808b83}
  /* W oknie etykieta osi stoi nad nią, nie obok — oś dostaje całą szerokość. */
  .hs .cz-wiersz{grid-template-columns:1fr;gap:8px}
  .hs .cz-wiersz + .cz-wiersz{margin-top:clamp(22px,2.6vw,30px)}
  .hs .cz-kto span{display:inline;margin-left:8px}
  .hs .cz-pod{margin-top:clamp(20px,2.4vw,26px)}
  .hs-karta{position:absolute;z-index:3;animation:v2-unos 7s ease-in-out infinite}
  .hs-k1{left:-22px;top:14px;--rot:-1.5deg}
  .hs-k2{right:-20px;bottom:12px;--rot:1.5deg;animation-delay:1.4s}
  @media (max-width:900px){ .hs-k1{left:-6px} .hs-k2{right:-6px} }
  @media (max-width:640px){
    .hs-scena{padding:14px 12px 16px;border-radius:20px}
    .hs-karta{position:relative;left:auto;right:auto;top:auto;bottom:auto;margin-top:10px;animation:none}
    .hs-karta .v2-kp b,.hs-karta .v2-kp > span:last-child > span{white-space:normal}
  }
  @media (prefers-reduced-motion:reduce){
    .hs-karta{animation:none}
    .hs-k2 > div,.hs-k2 .v2-kp{animation:none !important;opacity:1 !important;transform:none !important}
  }

  /* ---- pas logotypów: 1:1 z /guided-coding/bez-dzialu-it ---- */
  .tr{position:relative;z-index:2;display:flex;align-items:center;gap:36px;padding:30px max(clamp(20px,5vw,56px),calc((100% - 1440px) / 2));border-top:1px solid #eef1ec;border-bottom:1px solid #eef1ec;background:#ffffff}
  .tr-n{position:relative;z-index:2;background:#ffffff;padding-right:12px;flex-shrink:0;max-width:210px;font-size:14px;line-height:1.45;color:#4c5850}
  .tr-n strong{color:#16211a;font-weight:700}
  .tr-o{overflow:hidden;position:relative;z-index:1;margin-left:-76px;flex:1;filter:grayscale(1);opacity:0.55}
  .tr-t{display:flex;align-items:center;gap:56px;width:max-content;animation:tr-jazda 30s linear infinite}
  .tr-o:hover .tr-t{animation-play-state:paused}
  .tr-t img{width:114px;height:28px;object-fit:contain}
  @keyframes tr-jazda{from{transform:translateX(0)}to{transform:translateX(calc(-50% - 28px))}}
  @media (prefers-reduced-motion:reduce){ .tr-t{animation:none} }
  @media (max-width:820px){
    .tr{flex-wrap:wrap;justify-content:center;text-align:center;gap:18px}
    .tr-n{max-width:none;padding-right:0}
    .tr-o{margin-left:0;overflow:hidden;width:100%;flex:none}
  }

  /* ---- lista procesów przy definicji: karta ---- */
  .pc-karta{background:#ffffff;border:1px solid #e7ece4;border-radius:18px;padding:clamp(20px,2.4vw,26px) clamp(20px,2.4vw,28px) clamp(18px,2.2vw,24px);box-shadow:0 26px 54px -32px rgba(18,38,28,0.26)}
  .pc-karta .pc-h{margin-bottom:8px}
  .pc-karta .pc-row:first-of-type{border-top:0}
  .pc-karta .pc-row:last-of-type{border-bottom:0}
  .pc-karta .pc-d i{font-style:normal;font-weight:700;color:var(--la-accent,#00CD77);margin:0 6px}
