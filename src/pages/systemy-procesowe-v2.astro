<script>
  var redukcja = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- Odpalanie animacji, gdy element wchodzi w kadr ----
  (function(){
    var els = document.querySelectorAll('[data-anim]');
    if(!els.length) return;
    if(redukcja || !('IntersectionObserver' in window)){
      els.forEach(function(el){ el.classList.add('on'); });
      return;
    }
    var io = new IntersectionObserver(function(wpisy){
      wpisy.forEach(function(w){
        if(w.isIntersecting){ w.target.classList.add('on'); io.unobserve(w.target); }
      });
    }, { threshold: 0.22 });
    els.forEach(function(el){ io.observe(el); });
  })();

  // ---- Pas z widokami systemu ----
  // Przewijanie działa samo, bez JS. Strzałki tylko dokładają wygodę na
  // myszy i gasną na krańcach, żeby nie udawały, że jest dalej.
  (function(){
    var pas = document.querySelector('[data-ui-pas]');
    if(!pas) return;
    var wstecz = document.querySelector('[data-ui-prev]');
    var dalej = document.querySelector('[data-ui-next]');
    if(!wstecz || !dalej) return;

    function krok(){
      var karta = pas.querySelector('.ui-poz');
      if(!karta) return pas.clientWidth;
      var odstep = parseFloat(getComputedStyle(pas).columnGap || '0') || 0;
      return karta.getBoundingClientRect().width + odstep;
    }
    function stan(){
      var zapas = pas.scrollWidth - pas.clientWidth;
      wstecz.disabled = pas.scrollLeft < 4;
      dalej.disabled = pas.scrollLeft > zapas - 4;
      // Przy szerokim oknie cały pas mieści się w kadrze i strzałki są zbędne.
      var zbedne = zapas < 4;
      wstecz.hidden = zbedne;
      dalej.hidden = zbedne;
    }
    function jedz(kierunek){
      pas.scrollBy({ left: kierunek * krok(), behavior: redukcja ? 'auto' : 'smooth' });
    }
    wstecz.addEventListener('click', function(){ jedz(-1); });
    dalej.addEventListener('click', function(){ jedz(1); });
    pas.addEventListener('scroll', stan, { passive: true });
    window.addEventListener('resize', stan, { passive: true });
    stan();
  })();
</script>
