  { nr: 'ZP-2483', kl: 'Mostostal Wschód', kr: 'Akceptacja marży', cz: '1 dzień', zle: false },
  { nr: 'ZP-2481', kl: 'Budimex Industrial', kr: 'Wycena techniczna', cz: '3 dni', zle: true },
  { nr: 'ZP-2478', kl: 'Hala-Bud', kr: 'Wysyłka', cz: '2 godziny', zle: false },
  { nr: 'ZP-2476', kl: 'Zakład Konstrukcji', kr: 'Wysyłka', cz: '3 godziny', zle: false },
  { nr: 'ZP-2475', kl: 'Termo-Instal', kr: 'Wycena techniczna', cz: '1 dzień', zle: false },
  { nr: 'ZP-2473', kl: 'Panattoni Park', kr: 'Akceptacja marży', cz: '4 dni', zle: true },
  { nr: 'ZP-2470', kl: 'Stalprofil', kr: 'Zamknięte', cz: '—', zle: false },
  { nr: 'ZP-2469', kl: 'Metalbud', kr: 'Zamknięte', cz: '—', zle: false },
];
const REGULY = [
  { t: 'Akceptacja zarządu powyżej', v: '120 000 zł' },
  { t: 'Przypomnienie, gdy krok stoi dłużej niż', v: '2 dni' },
