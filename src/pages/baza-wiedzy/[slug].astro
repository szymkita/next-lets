---
// ARTYKUŁ — /baza-wiedzy/<slug>
//
// UKŁAD
//   nagłówek (kategoria, data, czas czytania, tytuł, lead, autor)
//   → kolumna tekstu 720 px ze spisem treści przyklejonym po lewej
//   → linki do usług, o których tekst mówi
//   → dwa sąsiednie teksty
//   → wąski pas kontaktowy (pełny moduł z formularzem zostaje na /baza-wiedzy;
//      pod artykułem byłby cięższy od samego tekstu)
//
// SPIS TREŚCI bierze się z nagłówków drugiego stopnia w markdownie — nie ma
// go czego utrzymywać ręcznie. Poniżej 1080 px chowa się w całości.
//
// STYLE TREŚCI są globalne (`is:global`), bo markdown renderuje się poza
// zasięgiem stylów scope'owanych przez Astro.
import { getCollection } from 'astro:content';
import { KATEGORIE } from '../../content/config';
import LaBase from '../../layouts/LaBase.astro';

export async function getStaticPaths() {
  // Szkice też dostają adres — po to, żeby dało się wysłać link do przeczytania
  // przed publikacją. Z listy i z sitemapy wypadają.
  const artykuly = await getCollection('artykuly');
  return artykuly.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}

const { a } = Astro.props;
const { Content, headings } = await a.render();
const kanon = new URL(`/baza-wiedzy/${a.slug}`, Astro.site).href;

const czas = Math.max(3, Math.round(a.body.trim().split(/\s+/).length / 180));
const dl = new Intl.DateTimeFormat('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' });
const spis = headings.filter((h) => h.depth === 2);

// Dalsze teksty: najpierw z tej samej kategorii, potem najnowsze pozostałe.
const inne = (await getCollection('artykuly', (x) => !x.data.szkic && x.slug !== a.slug))
  .sort((x, y) => y.data.data - x.data.data);
const dalej = [
  ...inne.filter((x) => x.data.kategoria === a.data.kategoria),
  ...inne.filter((x) => x.data.kategoria !== a.data.kategoria),
].slice(0, 2);

const kat = KATEGORIE[a.data.kategoria];

// Wpisy przeniesione z bloga są podpisane zespołem, nie osobą — pod nimi
// nie ma czyjego zdjęcia postawić, więc stoi sam podpis. Zdjęcie wchodzi
// tylko przy autorach z tej mapy.
const ZDJECIA = { 'Szymon Kita': { foto: '/szymon-kita.jpg', rola: 'założyciel' } };
const autor = ZDJECIA[a.data.autor];
const title = `${a.data.tytul} | Baza wiedzy Let's automate`;

const dane = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting', '@id': `${kanon}#artykul`, url: kanon, mainEntityOfPage: kanon,
      headline: a.data.tytul, description: a.data.lead,
      datePublished: a.data.data.toISOString().slice(0, 10),
      articleSection: kat.nazwa, inLanguage: 'pl-PL',
      author: { '@type': 'Person', name: a.data.autor },
      publisher: { '@id': new URL('/#organizacja', Astro.site).href },
    },
    {
      '@type': 'BreadcrumbList', '@id': `${kanon}#okruszki`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Strona główna', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: 'Baza wiedzy', item: new URL('/baza-wiedzy', Astro.site).href },
        { '@type': 'ListItem', position: 3, name: a.data.tytul, item: kanon },
      ],
    },
  ],
};
---
<LaBase title={title} description={a.data.lead} ctaHref="/darmowa-konsultacja" ctaLabel="Umów rozmowę" nav="dlaczego-my" noindex={a.data.szkic}>
<script type="application/ld+json" is:inline set:html={JSON.stringify(dane)} slot="head"></script>
<style is:global slot="head">
  .art-wrap{max-width:1064px;margin:0 auto;padding:0 clamp(20px,5vw,56px)}

  /* ================= NAGŁÓWEK ================= */
  .art-wroc{display:inline-flex;align-items:center;gap:7px;font-size:14px;font-weight:600;color:#8b968d;transition:color .15s}
  .art-wroc:hover{color:#0a7a52}
  .art-wroc i{font-style:normal;transition:transform .18s}
  .art-wroc:hover i{transform:translateX(-3px)}
  /* Bez separatorów między pozycjami — przy zawijaniu zostawały na końcu
     linii. Rozdziela je sam odstęp. */
  .art-meta{display:flex;flex-wrap:wrap;align-items:center;gap:4px 18px;margin-top:clamp(26px,3.2vw,38px);font-size:13.5px;color:#8b968d}
  .art-meta a{font-weight:750;color:#0a7a52}
  .art-h1{margin:16px 0 0;max-width:22ch;font-size:clamp(32px,5.2vw,58px);line-height:1.02;letter-spacing:-0.038em;font-weight:800;color:#16211a;text-wrap:balance}
  .art-lead{margin:clamp(18px,2.2vw,26px) 0 0;max-width:660px;font-size:clamp(17px,2.1vw,21px);line-height:1.55;color:#33413a;text-wrap:pretty}
  .art-autor{display:flex;align-items:center;gap:12px;margin-top:clamp(26px,3.2vw,36px);padding-top:clamp(24px,2.8vw,32px);border-top:1px solid #e7ece4}
  .art-autor img{width:40px;height:40px;border-radius:50%;object-fit:cover;object-position:50% 16%;display:block}
  .art-autor .art-znak{display:flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:50%;background:#0e2b1d;color:#ffffff;font-size:12.5px;font-weight:800;letter-spacing:0.02em;flex-shrink:0}
  .art-autor b{display:block;font-size:14.5px;font-weight:750;color:#16211a}
  .art-autor span{display:block;margin-top:1px;font-size:13px;color:#8b968d}

  /* Obraz otwierający mają tylko wpisy przeniesione z bloga. Kadr jest
     przycięty do 21:9, bo grafiki z Webflow mają cztery różne proporcje
     i bez tego nagłówki artykułów skakałyby względem siebie. */
  .art-obraz{display:block;width:100%;height:auto;aspect-ratio:21/9;object-fit:cover;border-radius:16px;margin-top:clamp(26px,3.2vw,36px);background:#f2f6f0}
  @media (max-width:700px){ .art-obraz{aspect-ratio:16/9;border-radius:12px} }

  /* ================= UKŁAD TREŚCI ================= */
  .art-body{display:grid;grid-template-columns:196px minmax(0,720px);gap:clamp(28px,5vw,64px);align-items:start;padding:clamp(38px,4.6vw,60px) 0 clamp(48px,6vw,80px)}
  .art-spis{position:sticky;top:104px}
  .art-spis-h{font-size:11.5px;font-weight:700;letter-spacing:0.06em;color:#a0aba1;padding-bottom:11px;border-bottom:1px solid #e7ece4}
  .art-spis a{display:block;padding:8px 0 8px 12px;margin-left:-1px;border-left:2px solid #e7ece4;font-size:13.5px;line-height:1.4;color:#8b968d;text-wrap:pretty;transition:color .15s,border-color .15s}
  .art-spis a:first-of-type{margin-top:11px}
  .art-spis a:hover{color:#16211a}
  .art-spis a.tu{color:#0a7a52;font-weight:650;border-left-color:var(--la-accent,#00CD77)}
  @media (max-width:1080px){ .art-body{grid-template-columns:minmax(0,720px);justify-content:center} .art-spis{display:none} }

  /* ================= PROZA ================= */
  .proza{font-size:17.5px;line-height:1.75;color:#33413a}
  .proza > p{margin:0 0 24px;text-wrap:pretty}
  .proza > p:last-child{margin-bottom:0}
  .proza h2{margin:clamp(40px,4.4vw,54px) 0 16px;font-size:clamp(23px,3vw,31px);line-height:1.14;letter-spacing:-0.026em;font-weight:800;color:#16211a;text-wrap:balance;scroll-margin-top:104px}
  .proza h2:first-child{margin-top:0}
  .proza h3{margin:34px 0 12px;font-size:19px;line-height:1.3;letter-spacing:-0.016em;font-weight:750;color:#16211a}
  .proza strong{font-weight:750;color:#16211a}
  .proza a{color:#0a7a52;font-weight:650;box-shadow:inset 0 -1px 0 rgba(10,122,82,0.32);transition:box-shadow .15s,color .15s}
  .proza a:hover{color:#16211a;box-shadow:inset 0 -1px 0 rgba(22,33,26,0.5)}

  /* Listy: znacznik rysowany, bez kropek przeglądarki. Punktor przy ul jest
     krechą w akcencie, bo kropka gubi się przy tym stopniu pisma. */
  .proza ul,.proza ol{margin:0 0 24px;padding:0;list-style:none}
  .proza li{position:relative;padding-left:26px;margin-bottom:11px;text-wrap:pretty}
  .proza ul > li::before{content:"";position:absolute;left:0;top:0.72em;width:11px;height:2px;border-radius:2px;background:var(--la-accent,#00CD77)}
  .proza ol{counter-reset:pkt}
  .proza ol > li{counter-increment:pkt;padding-left:34px}
  .proza ol > li::before{content:counter(pkt) ".";position:absolute;left:0;top:0;font-family:ui-monospace,Menlo,monospace;font-size:14px;font-weight:600;color:#0a7a52}

  /* Cytat niesie zdanie domykające tekst — stoi w większym stopniu pisma
     i na akcentowej kresce, bez cudzysłowów i bez kursywy. */
  .proza blockquote{margin:clamp(32px,3.6vw,44px) 0;padding:4px 0 4px clamp(20px,2.4vw,28px);border-left:3px solid var(--la-accent,#00CD77)}
  .proza blockquote p{margin:0;font-size:clamp(18px,2.1vw,21px);line-height:1.5;font-weight:650;letter-spacing:-0.014em;color:#16211a;text-wrap:pretty}

  .proza hr{height:1px;border:0;background:#e7ece4;margin:clamp(36px,4vw,48px) 0}
  .proza table{width:100%;border-collapse:collapse;margin:0 0 26px;font-size:15px}
  .proza th{text-align:left;font-weight:750;color:#16211a;padding:11px 12px 11px 0;border-bottom:2px solid #16211a}
  .proza td{padding:12px 12px 12px 0;border-bottom:1px solid #e7ece4;vertical-align:top;color:#4c5850}
  .proza code{font-family:ui-monospace,Menlo,monospace;font-size:0.88em;background:#f2f6f0;padding:2px 6px;border-radius:5px;color:#16211a}
  .proza pre{background:#0e2b1d;color:#e8ece7;padding:18px 20px;border-radius:12px;overflow-x:auto;margin:0 0 26px;font-size:13.5px;line-height:1.6}
  .proza pre code{background:none;padding:0;color:inherit}
  .proza img{display:block;width:100%;height:auto;border-radius:12px;margin:0 0 26px}
  /* Osadzone nagranie z YouTube'a — w treści przeniesionych wpisów jest jedno. */
  .proza .film{position:relative;aspect-ratio:16/9;margin:0 0 26px;border-radius:12px;overflow:hidden;background:#0e2b1d}
  .proza .film iframe{position:absolute;inset:0;width:100%;height:100%;border:0}

  /* ================= POD TEKSTEM ================= */
  .art-uslugi{display:flex;flex-wrap:wrap;align-items:center;gap:10px 12px;padding-top:clamp(30px,3.4vw,40px);margin-top:clamp(34px,4vw,48px);border-top:1px solid #e7ece4}
  .art-uslugi span{font-size:13.5px;color:#8b968d;margin-right:4px}
  .art-uslugi a{display:inline-flex;align-items:center;gap:7px;padding:9px 15px;border-radius:9px;background:#f2f6f0;font-size:14px;font-weight:650;color:#16211a;transition:background .16s,color .16s}
  .art-uslugi a:hover{background:#e4efe3;color:#0a7a52}

  .art-dalej{display:grid;grid-template-columns:1fr 1fr;gap:clamp(20px,3vw,40px);margin-top:clamp(52px,6vw,76px)}
  .art-dalej-r{padding-top:20px;border-top:2px solid #16211a}
  .art-dalej-k{font-size:12.5px;font-weight:700;color:#0a7a52}
  .art-dalej-t{display:block;margin-top:9px;font-size:clamp(18px,2.2vw,23px);line-height:1.22;letter-spacing:-0.022em;font-weight:750;color:#16211a;text-wrap:balance;transition:color .18s}
  .art-dalej-r:hover .art-dalej-t{color:#0a7a52}
  .art-dalej-l{display:block;margin-top:9px;font-size:14px;line-height:1.6;color:#6b766e;text-wrap:pretty}
  @media (max-width:760px){ .art-dalej{grid-template-columns:1fr;gap:28px} }

  .art-pas{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:clamp(24px,4vw,56px);align-items:center;margin:clamp(56px,7vw,90px) 0 0;padding:clamp(34px,4.4vw,54px) clamp(28px,4vw,52px);border-radius:22px;background:radial-gradient(700px 340px at 92% 0%, rgba(0,205,119,0.18), transparent 60%), #0e2b1d}
  .art-pas h2{margin:0;font-size:clamp(23px,3.2vw,34px);line-height:1.1;letter-spacing:-0.026em;font-weight:800;color:#ffffff;max-width:19ch;text-wrap:balance}
  .art-pas p{margin:14px 0 0;max-width:52ch;font-size:15.5px;line-height:1.6;color:rgba(255,255,255,0.72);text-wrap:pretty}
  /* minmax(0,1fr) i węższy padding: przy 320px sam `1fr` trzymał kolumnę
     na szerokości najdłuższego wyrazu i pas wychodził poza ekran. */
  @media (max-width:760px){ .art-pas{grid-template-columns:minmax(0,1fr)} }
  @media (max-width:420px){ .art-pas{padding-left:22px;padding-right:22px} }
</style>

<!-- ============ NAGŁÓWEK ============ -->
<div aria-hidden="true" style="position:absolute;left:0;right:0;top:0;height:540px;background:radial-gradient(820px 460px at 18% -12%, rgba(0,205,119,0.12), transparent 62%);pointer-events:none"></div>
<article style="position:relative">
<header class="art-wrap" style="padding-top:clamp(30px,4vw,54px)">
<a href="/baza-wiedzy" class="art-wroc"><i aria-hidden="true">←</i> Baza wiedzy</a>
<div class="art-meta">
<a href="/baza-wiedzy#artykuly">{kat.nazwa}</a>
<time datetime={a.data.data.toISOString().slice(0, 10)}>{dl.format(a.data.data)}</time>
<span>{czas} min czytania</span>
</div>
<h1 class="art-h1">{a.data.tytul}</h1>
<p class="art-lead">{a.data.lead}</p>
<div class="art-autor">
{autor
  ? <img src={autor.foto} alt="" loading="lazy" decoding="async" />
  : <span class="art-znak" aria-hidden="true">LA</span>}
<div><b>{a.data.autor}</b>{autor && <span>{autor.rola}, Let's automate</span>}</div>
</div>
{a.data.obraz && <img class="art-obraz" src={a.data.obraz} alt={a.data.obrazAlt || ''} width="1200" height="514" decoding="async" />}
</header>

<!-- ============ TREŚĆ ============ -->
<div class="art-wrap">
<div class="art-body">

<aside class="art-spis">
<div class="art-spis-h">W tekście</div>
{spis.map((h) => <a href={`#${h.slug}`} data-spis={h.slug}>{h.text}</a>)}
</aside>

<div>
<div class="proza"><Content /></div>

{a.data.powiazane.length > 0 && (
<div class="art-uslugi">
<span>Powiązane:</span>
{a.data.powiazane.map((p) => <a href={p.h}>{p.t} <i style="font-style:normal;color:#8b968d">→</i></a>)}
</div>
)}
</div>

</div>
</div>
</article>

<!-- ============ DALEJ + KONTAKT ============ -->
<section class="art-wrap" style="padding-bottom:clamp(64px,8vw,104px)">
{dalej.length > 0 && (
<div class="art-dalej">
{dalej.map((x) => (
  <a class="art-dalej-r" href={`/baza-wiedzy/${x.slug}`}>
    <span class="art-dalej-k">{KATEGORIE[x.data.kategoria].nazwa}</span>
    <span class="art-dalej-t">{x.data.tytul}</span>
    <span class="art-dalej-l">{x.data.lead}</span>
  </a>
))}
</div>
)}

<div class="art-pas">
<div>
<h2>Ten sam problem, tylko u Was</h2>
<p>Pierwsza rozmowa trwa czterdzieści minut i kończy się miarą stanu wyjściowego oraz kolejnością, w jakiej warto ruszać. Bez prezentacji.</p>
</div>
<a href="/darmowa-konsultacja" class="btn-accent" style="display:inline-flex;align-items:center;gap:9px;background:var(--la-accent,#00CD77);color:#0b1a11;padding:16px 26px;border-radius:12px;font-weight:750;font-size:16px;white-space:nowrap">Umów bezpłatną diagnozę →</a>
</div>
</section>

<script>
  // ---- Spis treści: podświetlenie sekcji, w której stoi czytelnik ----
  (function(){
    var linki = document.querySelectorAll('[data-spis]');
    if(!linki.length || !('IntersectionObserver' in window)) return;
    var mapa = {};
    linki.forEach(function(l){ mapa[l.dataset.spis] = l; });

    var io = new IntersectionObserver(function(wpisy){
      wpisy.forEach(function(w){
        if(!w.isIntersecting) return;
        linki.forEach(function(l){ l.classList.remove('tu'); });
        var l = mapa[w.target.id];
        if(l) l.classList.add('tu');
      });
    // Pas obserwacji zwężony do górnej części okna: inaczej „tutaj" skakałoby
    // na sekcję, która dopiero wchodzi na dole ekranu.
    }, { rootMargin: '-96px 0px -72% 0px' });

    Object.keys(mapa).forEach(function(id){
      var h = document.getElementById(id);
      if(h) io.observe(h);
    });
  })();
</script>
</LaBase>
