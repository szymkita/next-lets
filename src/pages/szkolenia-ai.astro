  }

  /* ================= trzy podejścia =================
     Kostka to pięć minut. Kreska odniesienia stoi tam, gdzie kończy się stary
     sposób — przy pierwszym podejściu nowy ją przekracza i to jest miejsce,
     w którym większość programów szkoleniowych się kończy.
     Odsłania się raz, przy wejściu w kadr; hero ma już własny zegar. */
  .pd{position:relative;margin-top:clamp(26px,3.2vw,38px)}
  .pd-row{display:grid;grid-template-columns:minmax(140px,180px) minmax(0,1fr);gap:clamp(16px,2.6vw,36px);align-items:start;padding:clamp(18px,2.2vw,26px) 0;border-top:1px solid #e2e9e0}
  .pd-row:first-of-type{padding-top:clamp(32px,3.6vw,42px)}
  .pd-row:last-of-type{border-bottom:1px solid #e2e9e0}
  .pd-e{display:block;font-size:15.5px;font-weight:700;letter-spacing:-0.01em;color:#16211a}
  .pd-t{display:block;margin-top:3px;font-family:ui-monospace,Menlo,monospace;font-size:11.5px;color:#a9b3aa}
  .pd-tor{position:relative;display:flex;align-items:center;gap:4px;height:14px}
  .pd-u{display:block;width:14px;height:12px;border-radius:2px;background:var(--la-accent,#00CD77);opacity:0;transform:translateY(5px);transition:opacity .3s ease,transform .3s cubic-bezier(.34,1.4,.5,1);transition-delay:var(--d)}
  .pd.on .pd-u{opacity:1;transform:none}
  .pd-u.dluzej{background:#d99a3c}
  /* Kreska odniesienia: koniec starego sposobu. Osiem kostek po 18 px. */
  .pd-linia{position:absolute;left:calc(8 * 18px - 4px);top:-9px;bottom:-9px;width:1px;background:#b9c4b8}
  .pd-linia b{position:absolute;left:9px;top:-18px;font-size:11.5px;font-weight:600;color:#8b968d;white-space:nowrap}
  .pd-min{margin:11px 0 0;font-size:14.5px;line-height:1.55;color:#4c5850;text-wrap:pretty}
  .pd-min b{font-weight:700;color:#16211a}
  .pd-legenda{margin:14px 0 0;font-size:13px;color:#8b968d}
  @media (max-width:760px){
    .pd-row{grid-template-columns:minmax(0,1fr);gap:12px}
    .pd-u{width:11px;height:11px}
    .pd-linia{left:calc(8 * 15px - 4px)}
  }
  /* Podpis kreski stoi w jednej linii obok niej — na najwęższych ekranach
     nie starczało na niego miejsca po prawej, więc łamie się na dwie linie. */
  @media (max-width:420px){
    .pd-linia b{white-space:normal;max-width:150px;line-height:1.3;top:auto;bottom:calc(100% + 4px)}
  }
  @media (prefers-reduced-motion:reduce){ .pd-u{transition:none} }

  /* ================= powody ================= */
  .pw-row{display:grid;grid-template-columns:minmax(0,0.95fr) minmax(0,1.15fr);gap:clamp(18px,3vw,48px);align-items:baseline;padding:clamp(20px,2.4vw,28px) 0;border-top:1px solid #e2e9e0}
  .pw-row:last-of-type{border-bottom:1px solid #e2e9e0}
  .pw-t{margin:0;font-size:clamp(17px,2vw,20px);font-weight:750;letter-spacing:-0.015em;line-height:1.3;color:#16211a;text-wrap:balance}
  .pw-d{margin:0;font-size:15px;line-height:1.6;color:#4c5850;text-wrap:pretty}
  @media (max-width:760px){ .pw-row{grid-template-columns:1fr;gap:7px} }

  /* ================= role =================
     Bez pojemników: nazwa roli trzyma kolumnę, pod nią czynności na liniach.
     Piąta rola rozpina się na dwie kolumny, żeby siatka nie zamknęła się
     równym prostokątem. */
  .rl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 clamp(36px,6vw,88px);margin-top:clamp(28px,3.4vw,42px)}
  .rl-b{padding:clamp(20px,2.4vw,26px) 0;border-top:1px solid #e7ece4}
