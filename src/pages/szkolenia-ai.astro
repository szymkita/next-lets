    kroki: [['według rutyny, z listą do sprawdzenia', 15]],
    tag: { k: 'ok', t: '25 min krócej' } },
].map((l) => {
  let od = 0;
  const kroki = l.kroki.map(([t, m]) => { const s = od; od += m; return { t, m, s, e: od }; });
  // łuki: krok cięty na 40 (bursztyn) i na 60 minutach (drugi pierścień)
  const seg = [];
  kroki.forEach((k, j) => {
    const ciecia = [k.s, ...[STARY_MIN, 60].filter((c) => c > k.s && c < k.e), k.e];
    for (let q = 0; q < ciecia.length - 1; q++) {
      const a = ciecia[q];
      const b = ciecia[q + 1] - (q === ciecia.length - 2 && j < kroki.length - 1 ? ZG_PRZERWA : 0);
      seg.push({ a, b, czk: !l.stary && a >= STARY_MIN, p: a >= 60 ? 2 : 1 });
    }
  });
  return { ...l, kroki, seg, min: od };
});
