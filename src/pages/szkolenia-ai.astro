    a: 'Nie. <a href="/strategia-ai" style="font-weight:700;color:#0a7a52">Strategia AI</a> układa kolejność wdrożeń wtedy, kiedy kandydatów jest kilkanaście. Ten program dotyczy pracy, którą Wasi ludzie wykonują dzisiaj ręcznie, i można go zacząć niezależnie. Jeśli po pomiarze wyjdzie, że czynność opłaca się przenieść z ludzi na system, to jest już <a href="/rozwiazania-ai" style="font-weight:700;color:#0a7a52">automatyzacja procesu z AI</a>.',
  },
];
dane['@graph'].push({
  '@type': 'FAQPage',
  '@id': `${kanon}#faq`,
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
  })),
});
---
<LaBase topbar={false} title={title} description={description} ctaHref="#kontakt" ctaLabel="Umów rozmowę" nav="uslugi">
<script type="application/ld+json" is:inline set:html={JSON.stringify(dane)} slot="head"></script>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap" slot="head">
<style is:global slot="head">
  /* Style tej usługi. Wspólny wygląd: src/components/usluga/Styl.astro. */
  .v3 .hi{display:block;flex-shrink:0;width:16px;height:16px;fill:currentColor}

  /* Twarz w duotonie: zdjęcie w szarości mnożone przez zieleń (ten sam
     chwyt co w zielonym pasie). Zieleń = osoba pracuje nowym sposobem;
     .sz = po staremu, szarość na papierze. */
  .v3 .tw{position:relative;display:block;flex-shrink:0;overflow:hidden;border-radius:50%;background:var(--ziel);isolation:isolate}
  .v3 .tw img{display:block;width:100%;height:100%;object-fit:cover;filter:grayscale(1) contrast(1.06) brightness(1.2);mix-blend-mode:multiply}
  .v3 .tw.sz{background:#e3e5e0}

  /* =====================================================================
     HERO · czternaście osób na dwóch polach
     Górne pole: wycena nowym sposobem w danym tygodniu; dolne, w kratce
     arkusza: po staremu. Każda osoba ma stałe miejsce (przód / tył jak na
     zdjęciu zespołu) i przechodzi tylko w pionie, między polami. Puste
     miejsca zostają jako przerywane kółka, więc skala (14) widać zawsze.
     Rozmiary liczone od szerokości rysunku (cqw).
     ===================================================================== */
  .hz{position:relative;margin:0;container-type:inline-size;color:var(--t1);-webkit-font-smoothing:antialiased}
  .hz-sc{--f0:min(11.2cqw,74px);--f1:calc(var(--f0) * 0.84);--pad:calc(var(--f0) * 0.26);--bh:calc(var(--pad) * 2 + var(--f1) * 0.5 + var(--f0));--gap:calc(var(--f0) * 0.3);--sh:calc(var(--f0) * 0.95);position:relative}
  .hz-gl{display:flex;justify-content:space-between;align-items:flex-end;gap:14px 24px;margin-bottom:10px}
  .hz-et{display:flex;align-items:baseline;flex-wrap:wrap;gap:0 9px}
  .hz-et b{font-size:clamp(34px,7.6cqw,54px);font-weight:750;letter-spacing:-0.055em;line-height:0.86;font-variant-numeric:tabular-nums;transition:color .3s}
  .hz-et small{font-size:15px;font-weight:600;color:var(--t3)}
  .hz-et span{display:flex;align-items:center;gap:7px;flex-basis:100%;margin-top:9px;font-size:13px;font-weight:650;color:var(--ziel-c)}
  .hz-et span svg{display:block;flex-shrink:0;width:14px;height:14px;fill:currentColor}
  .hz-et.g{padding-bottom:16px}
  .hz-et.d{flex-wrap:nowrap;align-items:center;gap:9px;margin-top:12px}
  .hz-et.d b{font-size:clamp(22px,4.2cqw,30px);color:var(--t2)}
  .hz-et.d small{font-size:13px}
  .hz-et.d span{flex-basis:auto;margin:0 0 0 4px;color:var(--t2)}
  .hz-sc.dl .hz-et.d b{color:var(--burs-c)}
  /* notatka tygodnia: kartka nachodzi na górne pole */
  .hz-not{position:relative;z-index:5;flex:0 1 340px;min-width:0;display:grid;grid-template-columns:auto minmax(0,1fr);align-items:start;gap:12px;margin-bottom:-24px;padding:11px 14px 13px 11px;border-radius:14px;background:#ffffff;transform:rotate(-1.4deg);
    box-shadow:0 0 0 1px rgba(15,26,20,0.06),0 24px 40px -22px rgba(7,20,13,0.45),0 4px 10px -6px rgba(7,20,13,0.16)}
  .hz-tn{display:grid;place-items:center;align-content:center;width:50px;height:54px;border-radius:10px;background:var(--ink);color:#ffffff;transition:background-color .3s}
  .hz-tn small{font-size:9.5px;font-weight:600;line-height:1;color:rgba(255,255,255,0.62)}
  .hz-tn b{margin-top:4px;font-size:23px;font-weight:750;letter-spacing:-0.04em;line-height:1;font-variant-numeric:tabular-nums}
  .hz-sc.dl .hz-tn{background:var(--burs-c)}
  .hz-nt{display:grid;min-width:0}
  .hz-nt > p{grid-area:1 / 1;margin:0;font-size:12.5px;line-height:1.42;color:var(--t2);opacity:0;transition:opacity .35s ease;text-wrap:pretty}
  .hz-nt > p.on{opacity:1}
  .hz-nt b{display:flex;align-items:center;gap:7px;margin-bottom:3px;font-size:13.5px;font-weight:700;letter-spacing:-0.01em;color:var(--t1)}
  .hz-nt > p.dl b{color:var(--burs-c)}
  .hz-nt b > span{display:flex}
  .hz-nt .tw{width:20px;height:20px;box-shadow:0 0 0 1.5px #ffffff}
  .hz-nt .tw + .tw{margin-left:-6px}
  /* pola */
  .hz-pola{position:relative;height:calc(var(--bh) * 2 + var(--gap))}
  .hz-pole{position:absolute;left:0;right:0;height:var(--bh);border-radius:calc(var(--f0) * 0.4)}
  .hz-pole.g{top:0;background:radial-gradient(90% 130% at 50% 0%,rgba(0,205,119,0.24),rgba(0,205,119,0.09) 72%),#ffffff;
    box-shadow:inset 0 0 0 1px rgba(0,205,119,0.32),0 28px 44px -32px rgba(0,110,64,0.5)}
  .hz-pole.a{top:calc(var(--bh) + var(--gap));
    background:linear-gradient(rgba(15,26,20,0.065) 1px,transparent 1px) 0 0 / 100% calc(var(--bh) / 4),linear-gradient(90deg,rgba(15,26,20,0.065) 1px,transparent 1px) 0 0 / calc(100% / 10) 100%,#fbfaf7;
    box-shadow:inset 0 0 0 1px rgba(15,26,20,0.1),inset 0 8px 16px -10px rgba(15,26,20,0.2)}
  .hz-m,.hz-o{position:absolute;left:var(--x);top:var(--y);width:var(--s);height:var(--s);margin-left:calc(var(--s) / -2)}
  .hz-m{z-index:1;border-radius:50%;border:1.5px dashed rgba(15,26,20,0.13)}
  .hz-m.a{transform:translateY(calc(var(--bh) + var(--gap)))}
  .hz-o{z-index:3;transition:transform .9s cubic-bezier(.65,0,.25,1) var(--dd)}
  .hz-o.r1{z-index:2}
  .hz-o .tw{width:100%;height:100%;box-shadow:0 0 0 2.5px #ffffff,0 16px 24px -14px rgba(7,20,13,0.6);transition:background-color .5s ease var(--dd),box-shadow .45s ease}
  .hz-o.dol{transform:translateY(calc(var(--bh) + var(--gap))) scale(0.9)}
  .hz-o.dol .tw{background:#e3e5e0;box-shadow:0 0 0 2.5px #fbfaf7,0 3px 6px -3px rgba(7,20,13,0.3)}
  .hz-o.akt .tw{box-shadow:0 0 0 2.5px #ffffff,0 0 0 5px var(--ink),0 16px 24px -14px rgba(7,20,13,0.6)}
  .hz-o.akt.dol .tw{box-shadow:0 0 0 2.5px #fbfaf7,0 0 0 5px var(--burs)}
  .hz-bez .hz-o,.hz-bez .hz-o .tw{transition:none !important}
  /* sznur sum: koralik na tydzień, wysokość = liczba osób nowym sposobem */
  .hz-sl{position:relative;height:calc(var(--sh) + 44px);margin-top:calc(var(--f0) * 0.34)}
  .hz-sl svg{position:absolute;left:0;top:13px;display:block;width:100%;height:var(--sh);overflow:visible}
  .hz-sl polyline{fill:none;stroke:rgba(10,122,82,0.42);stroke-width:1.5;stroke-linejoin:round;vector-effect:non-scaling-stroke}
  .hz-k{position:absolute;left:var(--x);top:calc(13px + var(--sh) * var(--y));z-index:1;display:grid;place-items:center;width:26px;height:26px;margin:-13px 0 0 -13px;border-radius:50%;background:#ffffff;
    box-shadow:0 0 0 1px rgba(15,26,20,0.14),0 4px 8px -4px rgba(7,20,13,0.35);font-size:11px;font-weight:700;color:var(--t1);font-variant-numeric:tabular-nums;
    transition:opacity .3s ease,transform .4s cubic-bezier(.3,1.5,.5,1),background-color .25s,color .25s}
  .hz-k.dl{color:var(--burs-c);box-shadow:0 0 0 1.5px var(--burs),0 4px 8px -4px rgba(7,20,13,0.35)}
  .hz-k.tu{background:var(--ink);color:#ffffff;transform:scale(1.18)}
  .hz-k.tu.dl{background:var(--burs-c);color:#ffffff}
  .hz-k.tu.kon{background:var(--ziel);color:var(--ink)}
  .hz-zd{position:absolute;left:0;right:0;bottom:0;height:16px;font-size:11px;font-weight:600;color:var(--t3)}
  .hz-zd > span{position:absolute;top:0;left:var(--x);transform:translateX(-50%);white-space:nowrap}
  .hz-zd > span.dl{color:var(--burs-c)}
  .hz-zd > span.dy{display:flex;align-items:center;gap:6px;transform:none;width:var(--w)}
  .hz-zd > span.dy::before,.hz-zd > span.dy::after{content:"";flex:1;border-top:1.5px dotted rgba(15,26,20,0.28)}
  /* ruch: koraliki i linia odsłaniają się tydzień po tygodniu */
  .hz.ruch .hz-k{opacity:0;transform:scale(.4)}
  .hz.ruch .hz-k.w{opacity:1;transform:none}
  .hz.ruch .hz-k.w.tu{transform:scale(1.18)}
  .hz.ruch .hz-sl svg{clip-path:inset(-4px var(--odsl,0%) -4px -4px);transition:clip-path .6s ease}
  @container (max-width:560px){
    .hz-gl{flex-direction:column-reverse;align-items:stretch;gap:16px;margin-bottom:12px}
    .hz-not{flex-basis:auto;margin:0;transform:rotate(-0.8deg)}
    .hz-et.g{padding-bottom:0}
    .hz-et span{margin-top:6px}
    .hz-k{width:21px;height:21px;margin:-10.5px 0 0 -10.5px;font-size:9.5px}
    .hz-zd > span:not(.dl):not(.pm){display:none}
    .hz-o.akt .tw{box-shadow:0 0 0 2px #ffffff,0 0 0 4px var(--ink)}
    .hz-o.akt.dol .tw{box-shadow:0 0 0 2px #fbfaf7,0 0 0 4px var(--burs)}
  }
  @media (max-width:1060px){ .hz{width:100%;max-width:760px;margin:0 auto} }

  /* =====================================================================
     DLACZEGO 1 · cztery tarcze, ta sama wycena zaczęta o 15:00
     Łuk to czas, obrót tarczy to godzina; po 60 minutach łuk przechodzi na
     wewnętrzny pierścień. Przerywana kreska na 40 minutach (15:40) to
     koniec starego sposobu; łuk za nią w kreskowanym bursztynie.
     ===================================================================== */
  .zg-kto{display:flex;align-items:center;gap:10px}
  .zg-kto .tw{width:30px;height:30px}
  .zg-sc{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(32px,3.4vw,48px) clamp(16px,2.4vw,40px)}
  .zg-p{display:flex;flex-direction:column;align-items:center;min-width:0}
  .zg-tar{position:relative;width:min(100%,228px);aspect-ratio:1;border-radius:50%;background:#ffffff;
    box-shadow:0 0 0 1px rgba(15,26,20,0.05),0 28px 46px -28px rgba(7,20,13,0.5),0 6px 12px -8px rgba(7,20,13,0.2)}
  .zg-tar svg{position:absolute;inset:0;display:block;width:100%;height:100%;overflow:visible}
  .zg-tk{stroke:rgba(15,26,20,0.2);stroke-width:1;stroke-linecap:round}
  .zg-tk.q{stroke:rgba(15,26,20,0.55);stroke-width:1.6}
  .zg-tor{fill:none;stroke:#f0f2ee;stroke-width:15}
  .zg-tor.p2{stroke-width:11}
  .zg-s{fill:none;stroke:var(--ziel);stroke-width:15}
  .zg-s.p2{stroke-width:11}
  .zg-p.stary .zg-s{stroke:#b9c2bb}
  .zg-s.czk{stroke:url(#zg-czk)}
  .zg-ref{stroke:var(--t1);stroke-width:1.6;stroke-dasharray:3 2.5}
  .zg-ref-t{font-size:11px;font-weight:700;fill:var(--t1)}
  .zg-gl circle{fill:var(--t1);stroke:#ffffff;stroke-width:2.5}
  .zg-p.stary .zg-gl circle{fill:var(--t2)}
  .zg-sr{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none}
  .zg-sr b{font-size:clamp(20px,2.1vw,30px);font-weight:750;letter-spacing:-0.045em;line-height:1;font-variant-numeric:tabular-nums}
  .zg-sr span{margin-top:5px;font-family:var(--mono);font-size:11px;color:var(--t3)}
  .zg-p.stary .zg-sr b{color:var(--t2)}
  .zg-op{align-self:stretch;margin-top:26px}
  .zg-op > b{display:block;font-size:15px;font-weight:700;letter-spacing:-0.01em}
  .zg-op > span{display:block;margin-top:2px;font-family:var(--mono);font-size:11.5px;color:var(--t3)}
  .zg-tag{display:flex;align-items:center;gap:7px;margin-top:10px;font-style:normal;font-size:13px;font-weight:700;transition:opacity .4s ease}
  .zg-tag i{display:block;flex-shrink:0;width:11px;height:11px;border-radius:3px}
  .zg-tag.zle{color:var(--burs-c)}
  .zg-tag.ok{color:var(--ziel-c)}
  .zg-tag.ok i{background:var(--ziel)}
  .zg-tag.rowno{color:var(--t2)}
  .zg-tag.rowno i{background:#b9c2bb}
  .zg-op p{margin:6px 0 0;font-size:13.5px;line-height:1.45;color:var(--t2);text-wrap:pretty}
  .zg-kr{margin:12px 0 0;padding:9px 0 0;list-style:none;border-top:1px solid var(--linia)}
  .zg-kr li{display:grid;grid-template-columns:44px minmax(0,1fr);gap:6px;padding:3px 0;font-size:12.5px;line-height:1.35;color:var(--t2)}
  .zg-kr li i{font-style:normal;font-family:var(--mono);font-size:11.5px;color:var(--t3);white-space:nowrap}
  .zg.gra .zg-tag{opacity:0}
  .zg.gra .zg-p.gotowe .zg-tag{opacity:1}
  @media (max-width:1100px){ .zg-sc{grid-template-columns:repeat(2,minmax(0,1fr))} }
  @media (max-width:640px){
    .zg-sc{grid-template-columns:minmax(0,1fr);gap:30px}
    .zg-p{display:grid;grid-template-columns:116px minmax(0,1fr);gap:18px;align-items:start}
    .zg-tar{width:116px}
    .zg-op{margin-top:0}
    .zg-ref-t{display:none}
    .zg-sr b{font-size:19px}
    .zg-sr span{font-size:9.5px;margin-top:3px}
    .zg-kr li{grid-template-columns:44px minmax(0,1fr);gap:4px}
    .zg-kr li i{font-size:10.5px;white-space:nowrap}
  }

  /* =====================================================================
     DLACZEGO 2 · raport z panelu obok przeglądu z liderem
     Dwie kartki z tego samego tygodnia, wiersz w wiersz. Osoby, które się
     zalogowały i wyceniły w arkuszu, łączy bursztynowy pas przez obie.
     ===================================================================== */
  .rp-sc{--rh:27px;--rx:22px;position:relative;display:grid;grid-template-columns:minmax(0,1fr) clamp(56px,7vw,104px) minmax(0,1fr);grid-template-rows:auto auto repeat(14,var(--rh)) auto}
  .rp-sc > *{position:relative;z-index:2;min-width:0}
  .rp-sc > .rp-ark{z-index:0;grid-row:1 / -1;border-radius:6px;background:#ffffff;
    box-shadow:0 0 0 1px rgba(15,26,20,0.06),0 30px 50px -34px rgba(7,20,13,0.5),0 6px 12px -8px rgba(7,20,13,0.15)}
  .rp-ark.l{grid-column:1}
  .rp-ark.r{grid-column:3;background:#fffefa}
  .rp-gl{padding:20px var(--rx) 14px}
  .rp-gl.l{grid-column:1;grid-row:1}
  .rp-gl.r{grid-column:3;grid-row:1}
  .rp-typ{display:inline-flex;align-items:center;gap:7px;font-size:11.5px;font-weight:650;color:var(--t3)}
  .rp-typ svg{display:block;width:13px;height:13px;fill:currentColor}
  .rp-gl.r .rp-typ{color:var(--ziel-c)}
  .rp-gl b{display:block;margin-top:6px;font-size:15px;font-weight:700;letter-spacing:-0.015em;line-height:1.25}
  .rp-gl > span:last-child{display:block;margin-top:2px;font-family:var(--mono);font-size:11px;color:var(--t3)}
  .rp-ng{grid-row:2;display:flex;justify-content:space-between;gap:10px;padding:8px var(--rx) 7px;border-top:1px solid var(--linia);border-bottom:1px solid var(--linia);font-size:11px;font-weight:600;color:var(--t3)}
  .rp-ng.l{grid-column:1}
  .rp-ng.r{grid-column:3}
  .rp-ng .kr{display:none}
  .rp-w{display:flex;align-items:center;gap:10px;padding:0 var(--rx);border-bottom:1px solid var(--linia2);font-size:12.5px;white-space:nowrap}
  .rp-w.l{grid-column:1;justify-content:space-between;font-family:var(--mono);font-size:11.5px;color:var(--t2)}
  .rp-w.l b{display:flex;align-items:center;gap:8px;font-weight:500;color:var(--t1)}
  .rp-w.l b i{display:block;width:6px;height:6px;border-radius:50%;background:var(--ziel)}
  .rp-w.l.n,.rp-w.l.n b{color:var(--t3)}
  .rp-w.l.n b i{background:#cdd3ce}
  .rp-w.l .dz{margin-right:6px;color:var(--t3)}
  .rp-w.r{grid-column:3;display:grid;grid-template-columns:minmax(0,1fr) 26px minmax(0,1.15fr);gap:8px}
  .rp-w.r b{font-weight:600;overflow:hidden;text-overflow:ellipsis}
  .rp-w.r em{overflow:hidden;font-style:italic;font-size:12px;color:var(--t2);text-overflow:ellipsis}
  .rp-zn{display:block;width:20px;height:16px;overflow:visible}
  .rp-zn path{fill:none;stroke-width:2.3;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:1}
  .rp-w.t .rp-zn path{stroke:var(--ziel-c)}
  .rp-w.a .rp-zn path,.rp-w.n .rp-zn path{stroke:var(--t3)}
  .rp-pas{z-index:1 !important;grid-column:1 / -1;margin:3px 8px;border-radius:4px;transform-origin:0 50%;background:repeating-linear-gradient(135deg,rgba(214,134,30,0.3) 0 1.5px,rgba(214,134,30,0) 1.5px 7px),rgba(240,163,58,0.13);box-shadow:inset 0 1.5px 0 rgba(227,150,47,0.8),inset 0 -1.5px 0 rgba(227,150,47,0.8)}
  .rp-ik{z-index:3 !important;grid-column:2;place-self:center;display:grid;place-items:center;width:24px;height:24px;border-radius:50%;background:#ffffff;box-shadow:0 0 0 1.5px var(--burs);color:var(--burs-c)}
  .rp-ik svg{display:block;width:12px;height:12px;fill:currentColor}
  .rp-st{grid-row:17;display:flex;align-items:baseline;justify-content:space-between;gap:4px 12px;padding:16px var(--rx) 20px;font-size:12.5px;color:var(--t2)}
  .rp-st.l{grid-column:1}
  .rp-st.r{grid-column:3}
  .rp-st b{font-size:clamp(24px,2.4vw,32px);font-weight:750;letter-spacing:-0.045em;line-height:1;color:var(--t1);white-space:nowrap}
  .rp-st.r b{color:var(--ziel-c)}
  .rp.gra .rp-zn{opacity:0}
  .rp.gra.on .rp-zn{opacity:1;transition:opacity .1s ease calc(0.5s + var(--i) * 0.12s)}
  .rp.gra .rp-zn path{stroke-dashoffset:1}
  .rp.gra.on .rp-zn path{stroke-dashoffset:0;transition:stroke-dashoffset .3s ease calc(0.5s + var(--i) * 0.12s)}
  .rp.gra .rp-w.r em{opacity:0}
  .rp.gra.on .rp-w.r em{opacity:1;transition:opacity .4s ease calc(0.65s + var(--i) * 0.12s)}
  .rp.gra .rp-st.r{opacity:0;transform:translateY(6px)}
  .rp.gra.on .rp-st.r{opacity:1;transform:none;transition:opacity .5s ease 2.3s,transform .6s cubic-bezier(.2,.8,.2,1) 2.3s}
  .rp.gra .rp-pas{transform:scaleX(0)}
  .rp.gra.on .rp-pas{transform:none;transition:transform .8s cubic-bezier(.6,0,.2,1) calc(2.6s + var(--j) * 0.1s)}
  .rp.gra .rp-ik{opacity:0;transform:scale(.4)}
  .rp.gra.on .rp-ik{opacity:1;transform:none;transition:opacity .3s ease calc(3.1s + var(--j) * 0.1s),transform .4s cubic-bezier(.3,1.6,.5,1) calc(3.1s + var(--j) * 0.1s)}
  @media (max-width:760px){
    .rp-sc{--rh:30px;--rx:10px;grid-template-columns:minmax(0,1fr) 26px 80px}
