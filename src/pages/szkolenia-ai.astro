// przechodzi na wewnętrzny pierścień. Wszystkie tarcze ruszają razem i idą
// w tym samym tempie (ZG_MS na minutę), więc dłuższe podejście kończy się
// później — czas animacji jest daną. Kreska na 40 minutach (15:40) to koniec
// starego sposobu; łuk nowego sposobu za nią jest w kreskowanym bursztynie.
const KOSTKA = 5;
const STARY_MIN = 40;
const ZG_MS = 34;
const ZG_PRZERWA = 0.45;          // przerwa między krokami na łuku (minuty)
const PODEJSCIA = [
  { e: 'Po staremu', t: 'arkusz i poczta', stary: true,
