  .rl-c i{flex-shrink:0;display:block;width:5px;height:5px;margin-top:8px;border-radius:50%;background:var(--la-accent,#00CD77)}
  .rl-b.szeroko .rl-lista{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 clamp(36px,6vw,88px)}
  @media (max-width:820px){
    .rl{grid-template-columns:1fr}
    .rl-b.szeroko .rl-lista{grid-template-columns:1fr}
  }

  /* ================= program ================= */
  .pr-row{display:grid;grid-template-columns:112px minmax(0,1fr) minmax(180px,0.5fr);gap:clamp(18px,3vw,44px);align-items:start;padding:clamp(20px,2.4vw,28px) 0;border-top:1px solid #e2e9e0}
  .pr-row:last-of-type{border-bottom:1px solid #e2e9e0}
  .pr-e{font-family:ui-monospace,Menlo,monospace;font-size:11.5px;letter-spacing:0.09em;color:#0a7a52;padding-top:5px}
  .pr-t{margin:0;font-size:clamp(18px,2.1vw,22px);font-weight:750;letter-spacing:-0.015em;color:#16211a}
  .pr-d{margin:9px 0 0;font-size:15px;line-height:1.62;color:#4c5850;text-wrap:pretty}
  .pr-z{padding-top:5px;font-size:14.5px;line-height:1.5;color:#4c5850}
  .pr-z b{display:block;margin-bottom:4px;font-size:12.5px;font-weight:500;color:#a0aba1}
  @media (max-width:960px){ .pr-row{grid-template-columns:112px minmax(0,1fr)} .pr-z{grid-column:2;padding-top:10px} }
  @media (max-width:700px){ .pr-row{grid-template-columns:1fr;gap:6px} .pr-z{grid-column:auto;padding-top:6px} }

  /* ================= podział zespołu (ciemny pas) =================
     Trzy rzędy kresek: pięć, siedem i dwie osoby. Ten sam alfabet, co w hero,
     tylko na ciemnym tle — na tej stronie wszystko da się policzyć. */
  .gr-row{display:grid;grid-template-columns:minmax(150px,210px) minmax(0,0.85fr) minmax(0,1.3fr);gap:clamp(20px,3.4vw,52px);align-items:start;padding:clamp(22px,2.8vw,32px) 0;border-top:1px solid rgba(255,255,255,0.14)}
  .gr-row:last-of-type{border-bottom:1px solid rgba(255,255,255,0.14)}
  .gr-lu{display:flex;flex-wrap:wrap;gap:5px;padding-top:4px}
  /* Dwie pierwsze grupy na zielono, trzecia przygaszona — pięć plus siedem
     daje dokładnie te dwanaście osób, które stoją w hero jako „12 z 14". */
  .gr-lu i{display:block;width:13px;height:26px;border-radius:3px;background:var(--la-accent,#00CD77);opacity:0;transform:translateY(6px);transition:opacity .35s ease,transform .35s cubic-bezier(.34,1.4,.5,1);transition-delay:var(--d)}
  .gr.on .gr-lu i{opacity:1;transform:none}
  .gr-row.slaba .gr-lu i{background:rgba(255,255,255,0.16)}
  .gr-ile{display:block;margin-top:11px;font-family:ui-monospace,Menlo,monospace;font-size:11.5px;color:rgba(255,255,255,0.5)}
  .gr-t{margin:0;font-size:clamp(17px,2vw,21px);font-weight:750;letter-spacing:-0.015em;line-height:1.25;color:#ffffff;text-wrap:balance}
  .gr-row.slaba .gr-t{color:rgba(255,255,255,0.62)}
  .gr-d{margin:0;font-size:15px;line-height:1.6;color:rgba(255,255,255,0.72);text-wrap:pretty}
  .gr-row.slaba .gr-d{color:rgba(255,255,255,0.5)}
  @media (max-width:900px){ .gr-row{grid-template-columns:1fr;gap:12px} }
  @media (prefers-reduced-motion:reduce){ .gr-lu i{transition:none} }

  /* ================= definicja adopcji =================
     Trzy warunki obok siebie, każdy z numerem. Bez pojemników i bez kartki —
     to jest definicja, a nie artefakt. */
  .df{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(20px,3.4vw,56px);margin-top:clamp(30px,3.6vw,44px)}
  .df-p{padding-top:14px;border-top:2px solid var(--la-accent,#00CD77)}
  .df-n{display:block;font-family:ui-monospace,Menlo,monospace;font-size:11.5px;color:#0a7a52}
  .df-t{display:block;margin-top:8px;font-size:clamp(16px,1.9vw,18.5px);font-weight:700;letter-spacing:-0.012em;line-height:1.3;color:#16211a;text-wrap:balance}
  .df-d{margin:8px 0 0;font-size:14.5px;line-height:1.55;color:#4c5850;text-wrap:pretty}
  @media (max-width:820px){ .df{grid-template-columns:1fr;gap:26px} }

  /* ================= pas wezwania (jasny, na linii) ================= */
  .ps{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:18px 40px;padding:clamp(26px,3vw,36px) 0;border-top:1px solid #e7ece4;border-bottom:1px solid #e7ece4}
  .ps p{margin:0;max-width:620px;font-size:clamp(18px,2.2vw,24px);line-height:1.35;letter-spacing:-0.018em;font-weight:700;color:#16211a;text-wrap:pretty}

  /* ================= przykłady =================
     Liczba osób rysowana kreskami, żeby dało się ją policzyć tak samo,
     jak w hero. Przy każdym zespole stoi też to, co się nie przyjęło. */
  .px-row{display:grid;grid-template-columns:minmax(190px,0.62fr) minmax(0,1.15fr) minmax(190px,0.66fr);gap:clamp(20px,3.2vw,52px);align-items:start;padding:clamp(26px,3.2vw,40px) 0;border-top:1px solid #dde7db}
  .px-row:last-of-type{border-bottom:1px solid #dde7db}
  .px-z{display:block;margin:0;font-size:clamp(18px,2.1vw,22px);font-weight:750;letter-spacing:-0.018em;color:#16211a}
  .px-f{display:block;margin-top:4px;font-size:13.5px;color:#8b968d}
  .px-c{margin:0;font-size:15px;line-height:1.6;color:#16211a;text-wrap:pretty}
  .px-nie{margin:14px 0 0;font-size:14px;line-height:1.55;color:#8b968d}
  .px-nie b{display:block;font-size:12.5px;font-weight:600;color:#a9b3aa;margin-bottom:3px}
  .px-l{display:flex;align-items:baseline;gap:8px;font-size:clamp(28px,3.4vw,38px);font-weight:800;letter-spacing:-0.03em;line-height:1;color:#16211a}
  .px-l span{font-size:14px;font-weight:650;letter-spacing:0;color:#8b968d}
  .px-lu{display:flex;flex-wrap:wrap;gap:4px;margin-top:14px}
  .px-lu i{display:block;width:8px;height:18px;border-radius:2px;background:#dbe3d9}
  .px-lu i.on{background:var(--la-accent,#00CD77)}
  .px-op{display:block;margin-top:10px;font-size:13px;line-height:1.5;color:#8b968d}
  @media (max-width:1000px){
    .px-row{grid-template-columns:minmax(0,1fr) minmax(180px,0.6fr)}
    .px-row > :first-child{grid-column:1 / -1}
  }
  @media (max-width:700px){
    .px-row{grid-template-columns:1fr;gap:16px}
    .px-row > :first-child{grid-column:auto}
  }

  /* ================= responsywność wspólna dla tej strony ================= */
  @media (max-width:900px){
    .hero-split{grid-template-columns:1fr !important;gap:clamp(30px,5vw,46px) !important}
  }
</style>

<!-- ============ 1 · HERO ============
     Rysunek robi całą robotę: dwanaście tygodni, w każdym tyle kresek, ilu
     ludzi pracuje nowym sposobem. Dołek w trzecim tygodniu jest narysowany
     na bursztynowo, bo to on tłumaczy, po co jest reszta programu. -->
<div aria-hidden="true" style="position:absolute;left:0;right:0;top:0;height:1080px;background:radial-gradient(900px 640px at 86% 2%, rgba(0,205,119,0.13), transparent 64%);pointer-events:none"></div>
<section style="position:relative;overflow:hidden;background:transparent;padding:clamp(28px,4vw,52px) max(clamp(20px,5vw,56px),calc((100% - 1440px) / 2)) clamp(56px,6.5vw,84px)">
<div class="hero-split" style="display:grid;grid-template-columns:1fr 1.06fr;gap:clamp(32px,4.5vw,64px);align-items:center;margin-top:clamp(10px,1.5vw,20px)">
<div>
<h1 style="margin:0;font-size:clamp(29px,4.4vw,51px);line-height:1.06;letter-spacing:-0.032em;font-weight:800;color:#16211a;text-wrap:balance">Zespół pracuje po nowemu także w dwunastym tygodniu</h1>
<p style="margin:26px 0 0;max-width:600px;font-size:clamp(16px,2.1vw,19px);line-height:1.6;color:#33413a;text-wrap:pretty">Warsztat prowadzimy na Waszych procesach i na Waszych sprawach. Potem wracamy w tygodniu, w którym takie programy zwykle umierają, i mierzymy, ilu ludzi zostało przy nowym sposobie.</p>
