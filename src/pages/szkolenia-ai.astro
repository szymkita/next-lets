  .kw-os span.zly{color:#b07524;font-weight:700}
  /* Podpis dołka schodzi pod oś tygodni — nad nią zderzał się z numerami. */
  .kw-dolek{position:absolute;top:calc(100% + 36px);transform:translateX(-50%);opacity:0}
  .kw-dolek b{font-size:12.5px;font-weight:700;color:#b07524;white-space:nowrap}
  .kw-pod{margin:64px 0 0;font-size:14.5px;line-height:1.55;color:#4c5850;max-width:520px;text-wrap:pretty}
