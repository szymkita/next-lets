<!-- ============ 9 · KONTAKT ============ -->
<Kontakt tytul="Zacznijmy od jednej roli" lead="Nazwijcie zespół, który chcecie przestawić, i pracę, którą wykonuje najczęściej. Odpowiemy z pytaniem o wielkość zespołu i z terminem pierwszej rozmowy." zrodlo="Szkolenia z AI" pytanie="Który zespół i jaka praca?" podpowiedz="Np. dwudziestoosobowy dział obsługi, każdy odpowiada dziennie na kilkadziesiąt zgłoszeń…" />

</div>

<GcFaq
  heading="Pytania, które padają przed decyzją"
  ctaLabel="Zadajcie nam swoje →"
  items={faq}
/>

<script>
  var redukcja = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var maIO = 'IntersectionObserver' in window;
  function czekaj(ms){ return new Promise(function(r){ setTimeout(r, ms); }); }
  function wszystkie(el, sel){ return Array.prototype.slice.call(el.querySelectorAll(sel)); }

  // ---- Hero: czternaście osób, tydzień po tygodniu ----
  // Najpierw chwilę stoi wynik z dwunastego tygodnia, potem pętla od karty
  // (tydzień 0) do pomiaru (12). Ludzie przechodzą między polami, liczby
  // przy polach i notatka zmieniają się z tygodniem, koraliki sznura
  // odsłaniają się po kolei. Stoi, kiedy rysunku nie widać.
  (function(){
    var fig = document.querySelector('[data-hz]');
    if(!fig || redukcja || !maIO) return;
    var sc = fig.querySelector('.hz-sc');
    var os = wszystkie(fig, '[data-hz-w]');
    var nar = wszystkie(fig, '[data-hz-n]');
    var kul = wszystkie(fig, '[data-hz-k]');
    var tn = fig.querySelector('[data-hz-tn]');
    var lg = fig.querySelector('[data-hz-g]'), ld = fig.querySelector('[data-hz-d]');
    var linia = fig.querySelector('[data-hz-linia]');
    var czasy = JSON.parse(fig.getAttribute('data-hz-czas') || '[]');
    var N = kul.length;
    var widoczny = false;
    async function gdyWidoczny(){ while(!widoczny) await czekaj(250); }
    function tydzien(k){
      var gora = 0;
      var akt = (nar[k].getAttribute('data-hz-os') || '').split(',').filter(Boolean).map(Number);
      os.forEach(function(o, i){
        var up = o.getAttribute('data-hz-w').charAt(k) === '1';
        o.classList.toggle('dol', !up);
        o.classList.toggle('akt', akt.indexOf(i) >= 0);
        if(up) gora++;
      });
      lg.textContent = gora;
      ld.textContent = os.length - gora;
      tn.textContent = k;
      nar.forEach(function(p, j){ p.classList.toggle('on', j === k); });
      sc.classList.toggle('dl', nar[k].hasAttribute('data-hz-dl'));
      kul.forEach(function(b, j){ b.classList.toggle('w', j <= k); b.classList.toggle('tu', j === k); });
      linia.style.setProperty('--odsl', (100 - (k + 0.5) / N * 100).toFixed(2) + '%');
    }
    sc.classList.add('hz-bez');
    fig.classList.add('ruch');
    tydzien(N - 1);
    void fig.offsetWidth;
    sc.classList.remove('hz-bez');
    async function petla(){
      await czekaj(3200);
      for(;;){
        for(var k = 0; k < N; k++){
          await gdyWidoczny();
          tydzien(k);
          await czekaj(czasy[k] || 1500);
        }
      }
    }
    new IntersectionObserver(function(w){ widoczny = w[0].isIntersecting; }, { threshold: 0.15 }).observe(fig);
    petla();
  })();

  // ---- Tarcze (Dlaczego, pierwszy blok) ----
  // Cztery tarcze ruszają razem i idą w tym samym tempie (data-ms na
  // minutę), więc dłuższe podejście kończy się później. Bez ruchu figura
  // nie dostaje .gra i pokazuje stan końcowy z markupu.
  (function(){
    var fig = document.querySelector('[data-zg]');
    if(!fig || redukcja || !maIO) return;
    var MS = +fig.getAttribute('data-ms') || 34;
    var tarcze = wszystkie(fig, '[data-zg-p]').map(function(p){
      return { p: p, min: +p.getAttribute('data-zg-p'), seg: wszystkie(p, '[data-a]'),
        gl: p.querySelector('[data-zg-gl]'), gk: p.querySelector('[data-zg-gk]'),
        cz: p.querySelector('[data-zg-cz]'), mn: p.querySelector('[data-zg-mn]') };
    });
    var max = tarcze.reduce(function(a, t){ return Math.max(a, t.min); }, 0);
    var znow = fig.querySelector('[data-zg-znow]');
    var bieg = 0;
    function hh(m){ var t = 900 + Math.floor(m); return Math.floor(t / 60) + ':' + ('0' + (t % 60)).slice(-2); }
    function ustaw(m){
      tarcze.forEach(function(t){
        var mm = Math.min(m, t.min);
        t.seg.forEach(function(s){
          var a = +s.getAttribute('data-a'), b = +s.getAttribute('data-b');
          s.setAttribute('stroke-dasharray', Math.max(0, Math.min(mm, b) - a).toFixed(2) + ' 60');
        });
        var kat = mm <= 0 ? 0 : (mm % 60 === 0 ? 360 : (mm % 60) * 6);
        t.gl.setAttribute('transform', 'rotate(' + kat.toFixed(2) + ')');
        t.gk.setAttribute('cy', mm > 60 ? -52 : -70);
        t.cz.textContent = hh(mm);
        t.mn.textContent = Math.floor(mm) + ' min';
        t.p.classList.toggle('gotowe', mm >= t.min);
      });
    }
    fig.classList.add('gra');
    ustaw(0);
    function graj(){
      var nr = ++bieg;
      ustaw(0);
      if(znow) znow.disabled = true;
      setTimeout(function(){
        if(nr !== bieg) return;
        var t0 = performance.now();
        function klatka(t){
          if(nr !== bieg) return;
          var m = Math.min((t - t0) / MS, max);
          ustaw(m);
          if(m < max) requestAnimationFrame(klatka);
          else if(znow) setTimeout(function(){ znow.disabled = false; }, 400);
        }
        requestAnimationFrame(klatka);
      }, 300);
    }
    if(znow) znow.addEventListener('click', graj);
    var io = new IntersectionObserver(function(w){
      if(w[0].isIntersecting){ io.disconnect(); graj(); }
    }, { threshold: 0.4 });
    io.observe(fig);
  })();

  // ---- Czternaście osób (§8) ----
  // Twarze stoją najpierw na swoich miejscach z pierwszego tygodnia, potem
  // schodzą do grup; trzecia grupa gaśnie, wchodzą liczby i tygodnie trzech
  // osób. Na wąskim ekranie bez lotu.
  (function(){
    var fig = document.querySelector('[data-gr]');
    if(!fig || redukcja || !maIO) return;
    var sloty = fig.querySelectorAll('[data-gr-slot]');
    var lu = wszystkie(fig, '[data-gr-lu]');
    fig.classList.add('gra');
    var io = new IntersectionObserver(function(w){
      if(!w[0].isIntersecting) return;
      io.disconnect();
      if(!window.matchMedia('(min-width: 901px)').matches){
        fig.classList.add('lec');
        setTimeout(function(){ fig.classList.add('dol'); }, 250);
        return;
      }
      lu.forEach(function(el, i){
        var a = sloty[i].getBoundingClientRect(), b = el.getBoundingClientRect();
        el.style.transition = 'none';
        el.style.transformOrigin = '0 0';
        el.style.transform = 'translate(' + (a.left - b.left).toFixed(1) + 'px,' + (a.top - b.top).toFixed(1) + 'px) scale(' + (a.width / b.width).toFixed(3) + ')';
      });
      void fig.offsetWidth;
      fig.classList.add('lec');
      setTimeout(function(){
        lu.forEach(function(el, i){
          el.style.transition = 'transform 1s cubic-bezier(.55,0,.2,1) ' + (i * 0.04).toFixed(3) + 's';
          el.style.transform = '';
        });
        setTimeout(function(){ fig.classList.add('dol'); }, 1000 + lu.length * 40);
      }, 550);
    }, { threshold: 0.35 });
    io.observe(fig.querySelector('.gr-start') || fig);
  })();
</script>
</LaBase>
