const hzPoz = (x) => {
  const [c, r] = x.m;
  const lewo = (((r ? c + 1 : c + 0.5) / 7.5) * 100).toFixed(3);
  return `--x:${lewo}%;--s:var(--${r ? 'f1' : 'f0'});--y:${r ? 'var(--pad)' : 'calc(var(--pad) + var(--f1) * 0.5)'};--dd:${(c * 0.035 + r * 0.02).toFixed(3)}s`;
};
