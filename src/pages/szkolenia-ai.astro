<svg width="0" height="0" style="position:absolute" aria-hidden="true"><symbol id="px-os" viewBox="0 0 12 24"><circle cx="6" cy="4.6" r="4.1" fill="currentColor"></circle><path d="M.6 24v-8.4a5.4 5.4 0 0 1 10.8 0V24z" fill="currentColor"></path></symbol></svg>
