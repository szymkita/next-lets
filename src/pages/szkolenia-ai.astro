<!-- ============ 7 · CZTERNAŚCIE OSÓB ============
     Zamiast „Pierwszego efektu": podział zespołu, z którego składa się
     12 z 14 w hero. Jedyne miejsce, które niczego nie sprzedaje — trzecia
     grupa jest w planie od początku. -->
<section id="zespol" class="v3-sek">
<div class="v8-gl">
<h2 class="v3-h2">Czternaście osób po dwunastu tygodniach</h2>
<p class="v3-sub">W każdym zespole ludzie dzielą się na trzy grupy i program musi obsłużyć wszystkie.</p>
</div>
<div class="gr" data-gr>
<div class="gr-start" aria-hidden="true"><b>Tydzień 1, po warsztacie</b><span class="gr-sloty">{LUDZIE.map((x) => (<span class="tw" data-gr-slot><img src={x.f} alt="" width="34" height="34" loading="lazy" decoding="async"></span>))}</span><span>próbuje {SUMY[0]} z {ZESPOL}</span></div>
<div class="gr-kol">
{GRUPY.map((g, gi) => {
  const o = LUDZIE[g.os];
  return (
  <div class={gi === 2 ? 'gr-g c' : 'gr-g'}>
    <span class="gr-lu" role="img" aria-label={`${g.idx.length} z ${ZESPOL} osób: ${g.idx.map((i) => `${LUDZIE[i].n} ${LUDZIE[i].s}`).join(', ')}`}>{g.idx.map((i) => (<span class="tw" data-gr-lu><img src={LUDZIE[i].f} alt="" width="48" height="48" loading="lazy" decoding="async"></span>))}</span>
    <div class="gr-n"><b>{g.idx.length}</b><span>z {ZESPOL} osób</span></div>
    <h3>{g.t}</h3>
    <p>{g.d}</p>
    <div class="gr-os">
      <div class="gr-os-gl"><span class={gi === 2 ? 'tw sz' : 'tw'}><img src={o.f} alt="" width="30" height="30" loading="lazy" decoding="async"></span><span><b>{o.n} {o.s}</b> <small>{o.r}</small></span></div>
      <span class="gr-pas" role="img" aria-label={`${o.n} ${o.s}: nowym sposobem w ${o.w.filter(Boolean).length} z ${TYG} tygodni`}>{o.w.map((v, k) => (<i class={v ? 't' : ''} style={`--k:${k}`}></i>))}</span>
      <span class="gr-pas-os" aria-hidden="true"><span>tydzień 1</span><span>12</span></span>
      <p>{g.notka}</p>
    </div>
  </div>
  );
})}
<div class="gr-suma"><b>{NOWY} z {ZESPOL}</b>pracuje nowym sposobem w dwunastym tygodniu</div>
</div>
</div>
