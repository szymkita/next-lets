    <h3>{x.f}<small>{x.m}</small></h3>
    <div class="px2-ud">
      <span class="px2-pas czk-j" role="img" aria-label={`${x.u}% spraw zamyka rozwiązanie, ${100 - x.u}% idzie do ludzi`}><i style={`--u:${x.u}%;--j:${i}`}></i></span>
      <div class="px2-op"><span><b>{x.u}%</b>zamyka rozwiązanie</span><span><b>{100 - x.u}%</b>do ludzi</span></div>
    </div>
    <p class="px2-d">{x.d}</p>
    <div class="px2-l"><b>Zostało u ludzi</b><ul>{x.ludzie.map((l) => (<li>{l}</li>))}</ul></div>
  </article>
))}
</div>
<figure class="v3-cyt rv" style="margin:0">
<blockquote><span>„</span>Bardzo dobrze zrozumieli nasze potrzeby i zaprojektowali scenariusz, który w pełni spełnił cele biznesowe. Otwartość i komunikacja to ich DNA.</blockquote>
<figcaption><span><b>Arkadiusz Andruch</b><span>Prezes Zarządu, X2O</span></span></figcaption>
</figure>
