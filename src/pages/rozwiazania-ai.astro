    r: 'Tu zaczyna się nasza robota.',
    nasze: true,
  },
];


// ---- PRZYKŁADY ---------------------------------------------------------
// PRZYKŁADOWE wdrożenia — do podmiany na potwierdzone przypadki.
// Pokrycie to udział spraw zamykanych bez człowieka po pierwszym kwartale.
const PRZYKLADY = [
  {
    f: 'Producent opakowań', m: '210 osób', p: 'Obieg faktur kosztowych',
    d: 'Faktura przychodzi na skrzynkę, rozwiązanie dopasowuje ją do zamówienia i do warunków z umowy, a potem księguje. Zgodność cen sprawdza w ERP przy każdej pozycji.',
    pokrycie: 78,
    ludzie: ['ceny rozjeżdżające się z umową', 'pierwsza faktura od nowego dostawcy'],
