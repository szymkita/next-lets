    function czekaj(ms){ return new Promise(function(r){ setTimeout(r, ms); }); }
    async function gdyWidoczny(){ while(!widoczny) await czekaj(300); }
    async function krok(ms){ await czekaj(ms); await gdyWidoczny(); }
    function licz(el, v){ el.textContent = String(v); el.classList.remove('tik'); void el.offsetWidth; el.classList.add('tik'); }
    function blysk(el){ el.classList.add('bl'); setTimeout(function(){ el.classList.remove('bl'); }, 60); }
    function zeruj(){
      wej.forEach(function(w){ w.classList.remove('zabrane'); });
      karty.forEach(function(k){ k.classList.remove('akt', 'mtr', 'wer'); k.querySelectorAll('[data-zr-o]').forEach(function(o){ o.classList.remove('on'); }); });
      Object.keys(wr).forEach(function(k){ wr[k].classList.add('ukr'); });
      ls.textContent = '0'; lc.textContent = '0';
      sw.classList.remove('gora', 'dol');
      tok.style.opacity = '0';
    }
    function jedz(sciezka, ms){
      return new Promise(function(r){
        var L = sciezka.getTotalLength(), t0 = null;
        function f(t){
          if(t0 === null) t0 = t;
          var u = Math.min(1, (t - t0) / ms), e = u < 0.5 ? 2 * u * u : 1 - Math.pow(-2 * u + 2, 2) / 2;
          var p = sciezka.getPointAtLength(e * L);
          tok.setAttribute('cx', p.x.toFixed(1)); tok.setAttribute('cy', p.y.toFixed(1));
          if(u < 1) requestAnimationFrame(f); else r();
        }
        requestAnimationFrame(f);
      });
    }
    async function petla(){
      for(;;){
        await gdyWidoczny();
        zeruj(); fig.classList.remove('od');
        await krok(800);
        var nS = 0, nC = 0;
        for(var i = 0; i < karty.length; i++){
          var k = karty[i], ok = k.classList.contains('s');
          karty.forEach(function(x){ x.classList.remove('akt'); });
          wej[i].classList.add('zabrane'); k.classList.add('akt');
          sw.classList.remove('gora', 'dol');
          await krok(500);
          var od = k.querySelectorAll('[data-zr-o]');
          for(var j = 0; j < od.length; j++){ od[j].classList.add('on'); await krok(320); }
          k.classList.add('mtr'); await krok(1050);
          k.classList.add('wer'); sw.classList.add(ok ? 'gora' : 'dol'); await krok(520);
          tok.setAttribute('class', ok ? 'zr-tok' : 'zr-tok c'); tok.style.opacity = '1';
          await jedz(ok ? pG : pD, 720);
          tok.style.opacity = '0';
          var w = wr[i]; w.classList.remove('ukr'); blysk(w);
          if(ok) licz(ls, ++nS); else licz(lc, ++nC);
          await krok(ok ? 700 : 1100);
        }
        await krok(4200);
        fig.classList.add('od'); await czekaj(520);
      }
    }
    new IntersectionObserver(function(w){ widoczny = w[0].isIntersecting; }, { threshold: 0.1 }).observe(fig);
    zeruj();
    petla();
  })(document.currentScript.previousElementSibling);
</script>
