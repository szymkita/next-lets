const SUMA_U = WARSTWY.reduce((a, w) => a + w.u, 0);
if (SUMA_U !== 100) throw new Error(`Udziały warstw muszą sumować się do 100, jest ${SUMA_U}`);
// Geometria w viewBox 760 × 500: przód płyty to prostokąt, góra i bok to
// równoległoboki przesunięte o (OX, −OY). Kolory nieprzezroczyste, bo płyty
// się zasłaniają; zieleń nasycona u góry stosu, jaśniejsza niżej.
const PK = { x: 300, fw: 290, ox: 120, oy: 66, y0: 100, ht: 324, gap: 5, wysun: 170 };
const mixZ = (a) => [0, 205, 119].map((c) => Math.round(255 - a * (255 - c)));
const rgb = (c) => `rgb(${c.join(',')})`;
let pkY = PK.y0, pkRzad = 0;
const PLYTY = WARSTWY.map((w, i) => {
  const h = (w.u / 100) * PK.ht;
  const y = pkY;
  pkY += h + PK.gap;
  let front, gora, bok;
  if (w.model) { front = [24, 38, 31]; gora = [52, 70, 60]; bok = [13, 22, 18]; }
  else {
    const a = 0.66 - (pkRzad++ / 5) * 0.46;
    front = mixZ(a); gora = mixZ(a * 0.6); bok = front.map((v) => Math.round(v * 0.86));
  }
  const { x, fw, ox, oy } = PK;
  return {
    ...w, i, h, y,
    front: rgb(front), gora: rgb(gora), bok: rgb(bok),
    pF: `${x},${y} ${x + fw},${y} ${x + fw},${y + h} ${x},${y + h}`,
    pG: `${x},${y} ${x + ox},${y - oy} ${x + fw + ox},${y - oy} ${x + fw},${y}`,
    pB: `${x + fw},${y} ${x + fw + ox},${y - oy} ${x + fw + ox},${y + h - oy} ${x + fw},${y + h}`,
    // odnośnik: od środka boku płyty w prawo, potem do etykiety
    ly: 40 + i * 70,
    sy: y + h / 2 - oy / 2,
    // opóźnienie wejścia: stos rośnie od dołu
    d: ((WARSTWY.length - 1 - i) * 0.13).toFixed(2),
  };
});
const PK_DOL = [...PLYTY].reverse();   // kolejność rysowania: od dołu stosu
const PK_M = PLYTY.find((p) => p.model);
