<GcCta
  heading="Zacznijmy od jednego procesu"
  lead="Wskażcie jedną sprawę, która przechodzi u Was przez najwięcej rąk. Odpowiemy z pytaniem o wolumen i z terminem pierwszej rozmowy."
  eyebrow="Z pierwszej rozmowy wychodzicie z"
  items={[
    { t: 'Werdyktem', d: 'czy to zadanie w ogóle warto budować pod siebie' },
    { t: 'Kształtem progu', d: 'na jakich sprawach da się go zmierzyć u Was' },
    { t: 'Zakresem do wyceny', d: 'systemy, wolumen i granica pierwszego etapu' },
  ]}
  placeholder="Np. dziennie wpada 60 zapytań ofertowych na skrzynkę i dwie osoby przepisują je do systemu…"
  submitLabel="Umów rozmowę"
  badges={[
    { i: 'klodka', t: 'Wasze dane bezpieczne' },
    { i: 'kartka', t: 'NDA przed startem' },
    { i: 'ptaszek', t: 'Repozytorium zostaje Wasze' },
