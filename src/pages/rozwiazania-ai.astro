<!-- ============ 6 · METODA ============
     Liczby ustalone 16.10.2026 (Szymon): ponad 200 wdrożeń, 140+ klientów (firm). -->
<Metoda tytul={'Własne <span style="white-space:nowrap">know-how</span> z&nbsp;ponad 200 wdrożeń'} sub="Typowy projekt AI za każdym razem ustala od nowa, jak sprawdzić, czy model rozstrzyga dobrze, i co zrobić, kiedy się myli. My mamy to rozstrzygnięte w WiseStacku i poprawiamy po każdym wdrożeniu." wiersze={METODA} typowy="Typowy projekt<br>wdrożenia AI" />

<!-- ============ 7 · NAJPIERW POMIAR, POTEM PRODUKCJA ============
     Rzecz sprawdzalna tej usługi: próg jakości zmierzony na sprawach
     klienta przed budową i zapisany w umowie razem z warunkiem
     odstąpienia. Harmonogram dwutorowy z bramką po czwartym tygodniu. -->
<section id="pomiar" class="v3-sek">
<div class="v8-gl">
<h2 class="v3-h2">Najpierw pomiar, potem produkcja</h2>
<p class="v3-sub">Dziewięć tygodni od warsztatu do produkcji. W czwartym puszczamy rozwiązanie przez sprawy z Waszego kwartału i porównujemy jego decyzje z decyzjami zespołu. Dalej idzie tylko wtedy, gdy wynik przekracza próg zapisany w umowie.</p>
</div>

<div class="hm" data-hm>
<div class="hm-wyk" role="img" aria-label={`Harmonogram dziewięciu tygodni w dwóch torach. Po naszej stronie: ${ETAPY.map((e) => `${e.tyg.toLowerCase()} ${e.n.toLowerCase()}`).join(', ')}. Po Waszej stronie: ${ETAPY.map((e) => e.w.toLowerCase()).join(', ')}. Po czwartym tygodniu bramka: pomiar na ${POMIAR.spraw} sprawach z kwartału, zgodność z decyzjami zespołu ${pl(POMIAR.zg)}% przy progu ${POMIAR.prog}% z umowy. Rozwiązanie zamknęłoby samo ${POMIAR.samo} z ${POMIAR.spraw} spraw. Poniżej progu rozwiązanie nie wchodzi na produkcję, a klient nie płaci za wdrożenie.`}>
<div class="hm-kto" aria-hidden="true"><span style="top:61px">Po naszej stronie</span><span style="top:133px">Po Waszej stronie</span></div>
<div class="hm-pl" style={`--x:${BR_X.toFixed(4)}`}>
<div class="hm-os" aria-hidden="true">{Array.from({ length: TYG }, (_, i) => (<span>tydz. {i + 1}</span>))}</div>
<div class="hm-tory">
{ETAPY.map((e, i) => (
  <div class={e.pm ? 'hm-e pm' : 'hm-e'} style={`--s:${e.s};--d:${e.d};--o:${i < 3 ? i : i + 3}`}>
    <span class="hm-tyg">{e.tyg}</span>
    <div class="hm-b n" data-hm-b data-s={e.s} data-d={e.d}><span class="hm-f"></span><b>{e.n}</b></div>
    <div class="hm-b w" data-hm-b data-s={e.s} data-d={e.d}><span class="hm-f"></span><b>{e.w}</b></div>
  </div>
))}
<span class="hm-br" aria-hidden="true"><i><svg class="ik" viewBox="0 0 16 16" set:html={IK['scale']}></svg></i></span>
<span class="hm-gl" aria-hidden="true" data-hm-gl></span>
</div>
<div class="hm-karta">
<div class="hm-k-gl"><b>Pomiar progu · tydzień {BRAMKA.s + 1}</b><span class="hm-ok"><svg class="ik" viewBox="0 0 16 16" set:html={IK['check-circle']}></svg>próg przekroczony</span></div>
<p class="hm-n"><b data-hm-n>{POMIAR.spraw}</b> spraw z ostatniego kwartału, rozstrzygniętych raz przez zespół i raz przez rozwiązanie</p>
<div class="hm-zg" style={`--w:${pmX(POMIAR.zg)}`}>
<div class="hm-zg-gl"><span>Zgodność z decyzjami zespołu w sprawach, które rozwiązanie zamknęłoby samo</span><b>{pl(POMIAR.zg)}%</b></div>
<div class="hm-zg-t"><i class="hm-zg-f"></i><b class="hm-zg-p" style={`left:${pmX(POMIAR.prog)}`}><span>próg w umowie {POMIAR.prog}%</span></b></div>
<div class="hm-zg-sk"><span>{POMIAR.od}%</span><span>{POMIAR.do}%</span></div>
</div>
<div class="hm-wy"><span><i></i>Zamknęłoby samo <b>{POMIAR.samo} z {POMIAR.spraw}</b></span><span><i></i>Do ludzi z powodem <b>{POMIAR.spraw - POMIAR.samo}</b></span></div>
<p class="hm-um"><b>Zapis w umowie</b>Poniżej ustalonego progu rozwiązanie nie wchodzi na produkcję, a Wy nie płacicie za wdrożenie.</p>
</div>
</div>
</div>
<div class="hm-dol">
<p class="rv">Decyzje rozwiązania idą obok decyzji, które przy tych sprawach podjął Wasz zespół. Zgodność jest liczbą, a przypadki sporne rozstrzygacie Wy, bo to Wasza praca wyznacza tu wzorzec.</p>
<p class="rv">Ten sam pomiar rozstrzyga o rzeczach, o których nie da się orzec z góry: który fragment procesu zostaje przy ludziach i czy w danych jest w ogóle to, czego decyzja wymaga.</p>
</div>
</div>
</section>

<!-- ============ 8 · DLA KOGO + KIEDY NIE WARTO ============
     Jedyne miejsce, gdzie odsyłamy: dwie z trzech dróg są tańsze. -->
<DlaKogo sub="Średnie i duże firmy, w których jeden proces zajmuje kilka osób przez większość dnia." warunki={DLA_KOGO} nieTytul="Kiedy nie warto tego budować" nie={NIE_WARTO} />

<!-- ============ 9 · KONTAKT ============ -->
<Kontakt tytul="Zacznijmy od spraw, które ktoś dziś czyta i ocenia" lead="Wskażcie proces, w którym decyzja zapada po przeczytaniu dokumentu albo zgłoszenia. Odpowiemy w jeden dzień roboczy z pytaniem o wolumen i z terminem pierwszej rozmowy." zrodlo="Automatyzacja procesów z AI" pytanie="Który to proces?" podpowiedz="Np. miesięcznie wpada 400 reklamacji ze zdjęciami, a trzy osoby sprawdzają je z fakturą i umową…" />

</div>

<GcFaq
  heading="Pytania, które padają przed decyzją"
  ctaLabel="Zadajcie nam swoje →"
  items={faq}
/>

<script>
  var redukcja = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function czekaj(ms){ return new Promise(function(r){ setTimeout(r, ms); }); }

  // ---- Teczka sprawy ----
  // Linie od źródeł do wierszy teczki i od decyzji do zapisów zwrotnych
  // liczone z położenia elementów (przy każdej zmianie szerokości od nowa).
  // Po wejściu w kadr: źródło po źródle linia się rysuje i wpadają jego
  // wiersze; potem wiersz modelu, decyzja i zapisy zwrotne. Przy
  // ograniczonym ruchu linie stoją narysowane od razu.
  (function(){
    var fig = document.querySelector('[data-tk]');
    if(!fig) return;
    var uk = fig.querySelector('.tk-uk'), svg = fig.querySelector('[data-tk-linie]');
    var zr = Array.prototype.slice.call(fig.querySelectorAll('[data-tk-s]'));
    var wiersze = Array.prototype.slice.call(fig.querySelectorAll('[data-tk-r]'));
    var wy = Array.prototype.slice.call(fig.querySelectorAll('[data-tk-o]'));
    var dec = fig.querySelector('[data-tk-dec]');
    var NS = 'http://www.w3.org/2000/svg';
    var gotowe = { z: redukcja ? 99 : -1, o: redukcja ? 99 : -1 };
    function linia(a, b, kol, klucz, wart){
      var u = uk.getBoundingClientRect(), r1 = a.getBoundingClientRect(), r2 = b.getBoundingClientRect();
      var x1 = r1.right - u.left, y1 = r1.top + r1.height / 2 - u.top, x2 = r2.left - u.left, y2 = r2.top + r2.height / 2 - u.top, dx = (x2 - x1) * 0.55;
      var p = document.createElementNS(NS, 'path');
      p.setAttribute('d', 'M' + x1.toFixed(1) + ',' + y1.toFixed(1) + ' C' + (x1 + dx).toFixed(1) + ',' + y1.toFixed(1) + ' ' + (x2 - dx).toFixed(1) + ',' + y2.toFixed(1) + ' ' + x2.toFixed(1) + ',' + y2.toFixed(1));
      p.setAttribute('pathLength', '1'); p.style.setProperty('--c', kol); p.setAttribute(klucz, wart);
      var c = document.createElementNS(NS, 'circle');
      c.setAttribute('cx', x2.toFixed(1)); c.setAttribute('cy', y2.toFixed(1)); c.setAttribute('r', '3'); c.style.setProperty('--c', kol); c.setAttribute(klucz, wart);
      svg.appendChild(p); svg.appendChild(c);
    }
    function rysuj(){
      while(svg.firstChild) svg.removeChild(svg.firstChild);
      if(getComputedStyle(svg).display === 'none') return;
      wiersze.forEach(function(w){
        var z = w.getAttribute('data-z'); if(z === null) return;
        linia(zr[+z], w, zr[+z].style.getPropertyValue('--c'), 'data-lz', z);
      });
      wy.forEach(function(o, i){ linia(dec, o, '#0a7a52', 'data-lo', String(i)); });
      svg.querySelectorAll('[data-lz]').forEach(function(el){ if(+el.getAttribute('data-lz') <= gotowe.z) el.classList.add('on'); });
      svg.querySelectorAll('[data-lo]').forEach(function(el){ if(+el.getAttribute('data-lo') <= gotowe.o) el.classList.add('on'); });
    }
    var czas = null;
    window.addEventListener('resize', function(){ clearTimeout(czas); czas = setTimeout(rysuj, 120); });
    if(document.fonts && document.fonts.ready) document.fonts.ready.then(rysuj);
    rysuj();
    if(redukcja || !('IntersectionObserver' in window)) return;
    fig.classList.add('ruch');
    function blysk(el){ el.classList.add('bl'); setTimeout(function(){ el.classList.remove('bl'); }, 60); }
    async function graj(){
      await czekaj(300);
      for(var i = 0; i < zr.length; i++){
        zr[i].classList.add('akt');
        gotowe.z = i;
        svg.querySelectorAll('[data-lz="' + i + '"]').forEach(function(el){ el.classList.add('on'); });
        await czekaj(480);
        var moje = wiersze.filter(function(w){ return w.getAttribute('data-z') === String(i); });
        for(var j = 0; j < moje.length; j++){ moje[j].classList.add('on'); blysk(moje[j]); await czekaj(200); }
        await czekaj(220);
        zr[i].classList.remove('akt');
      }
      var m = fig.querySelector('[data-krok="m"]'); m.classList.add('on'); blysk(m);
      await czekaj(650);
      dec.classList.add('on'); blysk(dec);
      await czekaj(450);
      for(var k = 0; k < wy.length; k++){
        gotowe.o = k;
        svg.querySelectorAll('[data-lo="' + k + '"]').forEach(function(el){ el.classList.add('on'); });
        await czekaj(420);
        wy[k].classList.add('on');
        await czekaj(200);
      }
    }
    var io = new IntersectionObserver(function(w){
      if(w[0].isIntersecting){ io.disconnect(); graj(); }
    }, { threshold: 0.4 });
    io.observe(fig);
  })();

  // ---- Harmonogram z bramką pomiaru ----
  // Głowica jedzie po osi tygodni ze stałą prędkością, bloki obu torów
  // wypełniają się za nią. Po czwartym tygodniu staje: liczy się pomiar,
  // pasek zgodności dojeżdża za kreskę progu, wychodzi „próg
  // przekroczony” i zapis z umowy. Potem jazda do końca osi.
  (function(){
    var fig = document.querySelector('[data-hm]');
    if(!fig || redukcja || !('IntersectionObserver' in window)) return;
    var pl = fig.querySelector('.hm-pl');
    var bloki = Array.prototype.slice.call(fig.querySelectorAll('[data-hm-b]'));
    var gl = fig.querySelector('[data-hm-gl]');
    var n = fig.querySelector('[data-hm-n]');
    var TYG = 9, BR = parseFloat(getComputedStyle(pl).getPropertyValue('--x')) * TYG, N = +n.textContent;
    var MS_TYG = 520;
    function ustaw(p){
      gl.style.left = (p / TYG * 100).toFixed(3) + '%';
      bloki.forEach(function(b){
        var s = +b.getAttribute('data-s'), d = +b.getAttribute('data-d');
        b.firstElementChild.style.width = (Math.max(0, Math.min(1, (p - s) / d)) * 100).toFixed(2) + '%';
      });
    }
    function jedz(od, doo){
      var ms = (doo - od) * MS_TYG;
      return new Promise(function(r){
        var t0 = null;
        function f(t){ if(t0 === null) t0 = t; var u = Math.min(1, (t - t0) / ms); ustaw(od + (doo - od) * u); if(u < 1) requestAnimationFrame(f); else r(); }
        requestAnimationFrame(f);
      });
    }
    function licz(ms){
      return new Promise(function(r){
        var t0 = null;
        function f(t){ if(t0 === null) t0 = t; var u = Math.min(1, (t - t0) / ms); n.textContent = String(Math.round(N * (1 - Math.pow(1 - u, 3)))); if(u < 1) requestAnimationFrame(f); else r(); }
        requestAnimationFrame(f);
      });
    }
    fig.classList.add('ruch');
    ustaw(0); n.textContent = '0';
    async function graj(){
      await czekaj(300);
      await jedz(0, BR);
      fig.classList.add('br');
      await licz(900);
      fig.classList.add('zm');
      await czekaj(1350);
      fig.classList.add('ok');
      await czekaj(900);
      await jedz(BR, TYG);
      fig.classList.add('kon');
    }
    var io = new IntersectionObserver(function(w){
      if(w[0].isIntersecting){ io.disconnect(); graj(); }
    }, { threshold: 0.35 });
    io.observe(fig);
  })();

  // ---- Zakładki widoków aplikacji ----
  (function(){
    var zak = Array.prototype.slice.call(document.querySelectorAll('[data-rk-zak]'));
    if(!zak.length) return;
    var widoki = document.querySelectorAll('[data-rk-widok]');
    var podpisy = document.querySelectorAll('[data-rk-podpis]');
    var okruch = document.querySelector('[data-rk-okruch]');
    function pokaz(i, fokus){
      zak.forEach(function(b, j){ b.setAttribute('aria-selected', i === j ? 'true' : 'false'); b.tabIndex = i === j ? 0 : -1; });
      widoki.forEach(function(w, j){ w.hidden = i !== j; });
      podpisy.forEach(function(p, j){ p.hidden = i !== j; });
      if(okruch) okruch.textContent = zak[i].textContent;
      if(fokus) zak[i].focus();
    }
    zak.forEach(function(b, i){
      b.addEventListener('click', function(){ pokaz(i); });
      b.addEventListener('keydown', function(e){
        if(e.key === 'ArrowRight'){ e.preventDefault(); pokaz((i + 1) % zak.length, true); }
        if(e.key === 'ArrowLeft'){ e.preventDefault(); pokaz((i - 1 + zak.length) % zak.length, true); }
      });
    });
  })();
</script>
</LaBase>
