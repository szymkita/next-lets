<script is:inline>
  // Poranek w pętli: zgłoszenie schodzi z kolejki na stanowisko, wpadają
  // trzy odczyty ze źródeł, pasek pewności dojeżdża do wartości, wychodzi
  // werdykt, zwrotnica się przestawia, kropka jedzie do kosza. Po pięciu
  // sprawach plansza stoi z wynikiem 3 : 2 i startuje od nowa. Pętla
  // czeka, kiedy rysunek jest poza kadrem. Markup trzyma stan końcowy.
  (function(fig){
    if(!window.requestAnimationFrame || !('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var $$ = function(q){ return Array.prototype.slice.call(fig.querySelectorAll(q)); };
    var wej = $$('[data-zr-w]'), karty = $$('[data-zr-k]'), sw = fig.querySelector('.zr-sw');
