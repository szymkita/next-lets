/>

<GcFaq
  heading="Pytania, które padają przed podpisaniem"
  lead="Odpowiedzi o dane i o utrzymanie są najdłuższe, bo to one najczęściej zatrzymują projekt po stronie IT."
  ctaLabel="Zadajcie nam swoje →"
  items={faq}
/>

<script>
  var redukcja = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- Odpalanie animacji, gdy element wchodzi w kadr ----
  (function(){
    var els = document.querySelectorAll('[data-anim]');
    if(!els.length) return;
    if(redukcja || !('IntersectionObserver' in window)){
      els.forEach(function(el){ el.classList.add('on'); });
      return;
    }
    var io = new IntersectionObserver(function(wpisy){
      wpisy.forEach(function(w){
        if(w.isIntersecting){ w.target.classList.add('on'); io.unobserve(w.target); }
      });
    }, { threshold: 0.25 });
    els.forEach(function(el){ io.observe(el); });
  })();

  // ---- Harmonogram sterowany scrollem ----
  // Jedyna animacja na tej stronie, która nie chodzi z własnego zegara.
  // --p to ułamek 0–1 wyliczony z położenia sekcji w kadrze; bloki liczą
  // sobie z niego własne wypełnienie w CSS, więc tutaj nie ma pętli po nich.
  (function(){
    var el = document.querySelector('[data-postep]');
    if(!el || redukcja) return;
    var bloki = el.querySelectorAll('.hg-blok');
    var TYG = 9;

    var czeka = false;
    function licz(){
      czeka = false;
      var r = el.getBoundingClientRect();
      var wys = window.innerHeight || document.documentElement.clientHeight;
      // Zero, kiedy pasek wjeżdża na trzy czwarte wysokości okna;
      // jeden, kiedy dojedzie do jednej trzeciej. Krótki odcinek celowo:
      // przy dłuższym głowica pełznie i wygląda na zepsutą.
      var start = wys * 0.78;
      var koniec = wys * 0.34;
      var p = (start - r.top) / (start - koniec);
      p = Math.max(0, Math.min(1, p));
      el.style.setProperty('--p', p.toFixed(4));
      for(var i = 0; i < bloki.length; i++){
        var b = bloki[i];
        var f = (p * TYG - parseFloat(b.dataset.s)) / parseFloat(b.dataset.d);
        b.firstElementChild.style.width = (Math.max(0, Math.min(1, f)) * 100).toFixed(2) + '%';
      }
    }
    function ruch(){
      if(czeka) return;
      czeka = true;
      requestAnimationFrame(licz);
    }

    el.style.setProperty('--p', '0');
    el.classList.add('zywy');
    licz();
    window.addEventListener('scroll', ruch, { passive: true });
