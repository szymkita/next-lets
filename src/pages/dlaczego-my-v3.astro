---
// STRONA „DLACZEGO MY" — WERSJA 3 · /dlaczego-my-v3
//
// TA SAMA TREŚĆ CO /dlaczego-my, INNA WARSTWA WIZUALNA.
// Przegląd z 29.08.2026: v1 miała pięć razy ten sam szkielet sekcji,
// dwanaście zaokrąglonych kafli i wersaliki przy każdym module.
// v3 rozbija to na wiersze na liniach, arkusz stykowy zamiast siatki
// awatarów, numery zamiast kółek z inicjałami, jedno wcięcie i jeden
// kontrast skali. Pełna lista zmian: docs/dlaczego-my-koncepcja.md.
//
// Obie wersje stoją równolegle do porównania — treść jest identyczna,
// więc różnica, którą widać, jest wyłącznie różnicą projektu.
//
//
// KOMU TO SIĘ WYŚWIETLA
// Człowiek, który wie już, co robimy, i zbiera argumenty przed decyzją.
// Ma na biurku 2–4 oferty i pytanie, którego nie zada wprost:
// „czym oni się różnią od tamtych i co się stanie, jak to pójdzie źle".
//
// KLUCZOWA DECYZJA
// Sekcja „dlaczego my" na stronie głównej to cztery zalety. Rozciągnięcie
// jej do całej strony dałoby dziesięć zalet i zero wiarygodności — bo
// każdy konkurent napisze u siebie to samo zdanie.
// Ta strona stoi więc na czymś, czego konkurencja nie skopiuje:
//   1. nazywa alternatywy z imienia i mówi, kiedy tamci są lepsi,
//   2. pokazuje własny zgrzyt w tym samym miejscu, co cudze,
//   3. kończy się listą sytuacji, w których odsyłamy klienta gdzie indziej.
// Każdy blok da się sprawdzić przed podpisaniem umowy — to jest obietnica
// całej strony i dlatego hero jest metryczką firmy, a nie makietą produktu.
//
// CZEGO TU NIE MA I DLACZEGO
// — Historii firmy na osi czasu. Kupujący nie kupuje naszej przeszłości.
// — Wartości („rzetelność, partnerstwo"). Nieweryfikowalne, więc puste.
// — Galerii zdjęć zespołu. Do czasu prawdziwej sesji zdjęciowej lepiej
//   wygląda uczciwy skład ról niż stockowe twarze (patrz TeamAvatar).
//
// LICZBY
// 140+ firm, 200+ wdrożeń, 30+ ekspertów — za stroną główną.
// Wszystko, czego nie mam u źródła, jest oznaczone [do uzupełnienia],
// zgodnie z konwencją z pozostałych podstron.

import LaBase from '../layouts/LaBase.astro';
import GcFaq from '../components/GcFaq.astro';
import GcCta from '../components/GcCta.astro';
import TeamAvatar from '../components/TeamAvatar.astro';
import { zespol } from '../data/zespol.js';

const title = "Dlaczego my (v3 — wariant wizualny) | Let's automate";
const description =
  'Skład studia, zasady rozliczeń, lista rzeczy przekazywanych na koniec projektu i sytuacje, w których odsyłamy do kogoś innego. Wszystko sprawdzalne przed podpisaniem umowy.';

// ── Metryczka firmy (hero, prawa kolumna) ────────────────────────────────
// Świadomie sucha tabela zamiast makiety produktu: pierwsze, co ta strona
// robi, to podanie faktów do weryfikacji.
const metryczka = [
  { k: 'Spółka', v: "Let's automate sp. z o.o.", m: 'NIP 5252908405' },
  { k: 'Grupa', v: 'Wise Group', m: 'Sellwise · HireWise · AdWise' },
  { k: 'Zespół', v: '30+ osób', m: 'w jednym studiu, bez podwykonawców' },
  { k: 'Zrealizowane', v: '200+ wdrożeń', m: 'dla ponad 140 firm' },
  { k: 'Własny produkt', v: 'appto.ai', m: 'budowany tą samą metodą' },
  { k: 'Rozliczenie', v: 'stała cena za etap', m: 'bez roboczogodzin' },
  { k: 'Siedziba', v: 'Warszawa', m: 'Nowy Świat 33/13' },
];

// ── Sekcja 1 · Krajobraz alternatyw ──────────────────────────────────────
// Najważniejszy blok strony. Każdy profil dostaje uczciwe „najlepszy wybór,
// gdy" — łącznie z nami, którzy dostajemy własny zgrzyt w tym samym polu.
// To jedyna konstrukcja, której konkurencja nie przepisze, bo nie może
// sobie pozwolić na napisanie u siebie „tu wygrywa ktoś inny".
const alternatywy = [
  {
    n: 'Software house',
    gdy: 'Zakres jest spisany i domknięty, a brakuje rąk do jego wykonania.',
    zgrzyt:
      'Specyfikację przygotowuje klient, więc pytanie, czy ten proces w ogóle powinien tak wyglądać, zostaje bez właściciela. Kod powstaje zgodnie z zamówieniem, także wtedy, gdy zamówienie było błędem.',
  },
  {
    n: 'Agencja od AI · integrator no-code',
    gdy: 'Chodzi o jeden scenariusz na już, w budżecie kilku tysięcy złotych.',
    zgrzyt:
      'Po roku scenariuszy jest czternaście, każdy żyje osobno i nikt nie umie powiedzieć, co się stanie, gdy jeden przestanie działać w piątek wieczorem.',
  },
  {
    n: 'Duże doradztwo',
    gdy: 'Zarząd potrzebuje strategii sygnowanej marką, którą rada nadzorcza zna z rynku.',
    zgrzyt:
      'Dokument kończy się w miejscu, w którym zaczyna się wdrożenie. Kod pisze potem inna firma, na podstawie slajdów, których autorzy już nie odbierają telefonu.',
  },
  {
    n: 'Wewnętrzny dział IT',
    gdy: 'Zespół ma wolne moce, a pierwsza automatyzacja działa u Was w produkcji od kilku miesięcy.',
    zgrzyt:
      'Backlog utrzymaniowy zjada każdą nową inicjatywę. Projekt transformacyjny przegrywa z awarią w systemie, który działa od ośmiu lat — i słusznie, bo awaria jest pilniejsza.',
  },
];

// ── Sekcja 2 · Skład projektowy ──────────────────────────────────────────
// TeamAvatar bez zdjęć renderuje inicjały — to celowe. Rola i zakres
// odpowiedzialności są prawdziwe, twarze pojawią się po sesji zdjęciowej.
const sklad = [
  {
    p: { name: 'Partner prowadzący' },
    kiedy: 'od pierwszej rozmowy',
    d: 'Odpowiada za wynik i za budżet. Rozmowę handlową i projekt prowadzi ta sama osoba, więc obietnice ze sprzedaży nie giną po drodze.',
  },
  {
    p: { name: 'Analityk procesu' },
    kiedy: 'diagnoza',
    d: 'Spisuje, jak proces działa dzisiaj, przy biurkach osób, które go wykonują. Schemat z prezentacji zarządu zwykle różni się od tego, co widać na miejscu.',
  },
  {
    p: { name: 'Lead developer' },
    kiedy: 'budowa',
    d: 'Projektuje rozwiązanie i pisze najtrudniejsze fragmenty. Ta sama osoba odbiera telefon, gdy pół roku później coś zacznie się zachowywać dziwnie.',
  },
  {
    p: { name: 'QA' },
    kiedy: 'budowa i wydanie',
    d: 'Sprawdza system na Waszych danych przed każdym wydaniem. Ma prawo wstrzymać wydanie i z tego prawa korzysta.',
  },
  {
    p: { name: 'Opiekun wdrożenia' },
    kiedy: 'po starcie',
    d: 'Prowadzi system po uruchomieniu i co miesiąc pokazuje metryki procesu: ile przeszło automatycznie, ile trafiło do ludzi.',
