// ── Sekcja 7 · Kiedy nie my ──────────────────────────────────────────────
// Blok, który sprzedaje najwięcej, bo jako jedyny na stronie nie sprzedaje.
const nieMy = [
  {
    t: 'Potrzebna jest jedna prosta automatyzacja',
    d: 'Przy budżecie kilku tysięcy złotych i jednym scenariuszu integrator no-code zrobi to szybciej i taniej. Podajemy nazwiska, jeśli poprosicie.',
  },
  {
    t: 'Decyduje najniższa stawka godzinowa',
    d: 'Pracujemy na stałej cenie za etap. W licytacji stawką zawsze znajdzie się ktoś, kto zejdzie niżej, i takiej licytacji nie wygrywamy.',
  },
  {
    t: 'Proces zmieni się w ciągu kwartału',
    d: 'Automatyzacja procesu, który za chwilę przestanie obowiązywać, to koszt bez zwrotu. Wracamy do rozmowy po zmianie.',
  },
  {
    t: 'Po Waszej stronie nikt nie odpowiada za wynik',
    d: 'Wdrożenie bez właściciela wewnątrz firmy zatrzymuje się na etapie pilota. Widzieliśmy to kilka razy i nie chcemy tego powtarzać za Wasze pieniądze.',
  },
];

// ── FAQ ──────────────────────────────────────────────────────────────────
// Pierwsze pytanie otwarte domyślnie (GcFaq) — celowo najtwardsze.
const faq = [
  {
    q: 'Czym różnicie się od software house’u?',
    a: 'Zakresem odpowiedzialności. Software house dostaje specyfikację i buduje to, co w niej jest — pytanie, czy proces powinien tak wyglądać, zostaje po Waszej stronie. My zaczynamy etap wcześniej: analityk siada przy biurkach ludzi, którzy proces wykonują, i dopiero z tego powstaje zakres. W praktyce w pierwszym tygodniu najczęściej wypada część rzeczy, które były w pierwotnym zamówieniu, i to jest tania zmiana. Ta sama zmiana po trzech miesiącach budowy jest droga.',
  },
  {
    q: 'Czy nie taniej zbudować to wewnętrznie?',
    a: 'Czasem tak i mówimy to wprost. Jeśli macie zespół z wolnymi mocami i pierwszą automatyzację, która działa w produkcji od kilku miesięcy, kolejne procesy zwykle opłaca się robić u siebie. Rachunek zmienia się, kiedy zespół ma pełny backlog utrzymaniowy — wtedy projekt transformacyjny przegrywa z każdą awarią, a przez rok nie powstaje nic. W takiej sytuacji koszt zewnętrznego studia jest niższy niż koszt roku bez zmian.',
  },
  {
    q: 'Co się stanie, jeśli przestaniecie istnieć?',
    a: 'System działa dalej. Repozytorium, konta i licencje są od pierwszego dnia na Waszej firmie, dokumentacja i runbook leżą w tym samym repozytorium, a stack dobieramy tak, żeby utrzymanie mógł przejąć dowolny zespół z rynku. Na koniec projektu podpisujemy protokół przekazania z listą tego, co dostajecie — jest wyżej na tej stronie. Bez tej listy nie zamykamy projektu.',
  },
  {
    q: 'Ile to kosztuje?',
    a: 'Diagnoza jest bezpłatna i kończy się liczbą: kosztem status quo w godzinach i złotówkach. Każdy kolejny etap ma stałą cenę, ustaloną przed jego rozpoczęciem, więc w dowolnym momencie znacie koszt następnego kroku i możecie się zatrzymać. Rozliczeń godzinowych nie prowadzimy — przy nich ryzyko przekroczenia budżetu przechodzi na klienta, a to my mamy wpływ na tempo, więc ryzyko zostaje u nas.',
  },
  {
    q: 'Za rok modele będą lepsze. Czy to nie zestarzeje się w pół roku?',
    a: 'Model jest w takim systemie wymienialnym elementem. Wartość zostaje w tym, co jest wokół niego: w opisanym procesie, w integracjach z Waszymi systemami, w danych doprowadzonych do stanu używalności i w regułach, kiedy decyzję podejmuje człowiek. Ta warstwa nie starzeje się razem z modelem, a podmiana modelu na nowszy jest u nas zmianą konfiguracji, nie przepisywaniem systemu.',
  },
  {
    q: 'Kto ma prawa do kodu i do danych?',
    a: 'Wy, od pierwszego dnia. Kod powstaje w repozytorium na Waszej organizacji, a prawa majątkowe przechodzą na Was wraz z odbiorem etapu. Waszych danych nie używamy do trenowania modeli. Umowę o poufności podpisujemy przed pierwszym spojrzeniem na Wasze systemy, także w trakcie bezpłatnej diagnozy.',
  },
