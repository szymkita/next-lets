// ── Sekcja 3 · Wise Group ────────────────────────────────────────────────
const grupa = [
  { n: 'Sellwise', d: 'doradztwo sprzedażowe', s: false },
  { n: 'HireWise', d: 'rekrutacja i zespoły', s: false },
  { n: 'AdWise', d: 'marketing B2B', s: false },
  { n: "Let's automate", d: 'transformacja AI', s: true },
];

// Konkretne sytuacje projektowe zamiast ogólnika „mamy zaplecze".
const zaplecze = [
  {
    t: 'Proces sprzedaży opisuje ktoś, kto go przebudowywał',
    d: 'Zanim zautomatyzujemy ofertowanie, ktoś sprawdza, czy ten sposób ofertowania ma sens. W większości projektów zmienia się najpierw proces, a dopiero potem powstaje system.',
  },
  {
    t: 'Po wdrożeniu zmieniają się role w zespole',
    d: 'Część pracy znika, a część stanowisk wygląda inaczej niż w dniu podpisania umowy. HireWise pracuje przy tym na co dzień, więc rozmowa o nowych rolach nie zaczyna się od zera.',
  },
  {
    t: 'Zarząd dostaje argument w swoim języku',
    d: 'Materiał na radę nadzorczą pisze ktoś, kto pisze takie materiały zawodowo. Wdrożenia AI zatrzymują się w firmach najczęściej na etapie obrony budżetu.',
  },
