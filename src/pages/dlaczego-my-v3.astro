---
<LaBase noindex
  title={title}
  description={description}
  ogImage="/og/hub.png"
  nav="dlaczego-my"
  ctaHref="#kontakt"
  ctaLabel="Umów bezpłatną diagnozę"
>
<style is:global slot="head">
  /* ---------- metryczka firmy (hero) ---------- */
  .mtx{width:100%;border-collapse:collapse}
  .mtx td{padding:11px 0;border-top:1px solid rgba(255,255,255,0.1);vertical-align:baseline}
  .mtx tr:first-child td{border-top:0}
  .mtx .k{font-family:ui-monospace,Menlo,monospace;font-size:10px;letter-spacing:0.12em;text-transform:uppercase;color:rgba(255,255,255,0.45);white-space:nowrap;padding-right:18px}
  .mtx .v{font-size:14.5px;font-weight:700;color:#ffffff;line-height:1.3}
  .mtx .m{display:block;margin-top:2px;font-size:12px;font-weight:400;color:rgba(255,255,255,0.55)}

  /* ---------- porównanie: wiersze, nie kafle ----------
     Pięć jednakowych kart obok siebie to najczytelniejszy podpis szablonu.
     Cztery alternatywy schodzą do cichych wierszy na liniach, a nasz wiersz
     dostaje akcentową krechę i większy stopień — hierarchia zamiast siatki. */
  .cmp{display:grid;grid-template-columns:250px 1fr 1fr;gap:clamp(18px,3vw,56px);padding:clamp(22px,2.4vw,30px) 0;border-top:1px solid rgba(255,255,255,0.15)}
  .cmp-n{font-size:clamp(19px,2.1vw,23px);font-weight:750;letter-spacing:-0.022em;line-height:1.18;color:#ffffff;text-wrap:balance}
  .cmp-lab{font-size:12.5px;font-weight:600;letter-spacing:0.005em;color:rgba(255,255,255,0.4)}
  .cmp-p{margin:7px 0 0;font-size:14.5px;line-height:1.6;color:rgba(255,255,255,0.72);text-wrap:pretty}
  .cmp-us{margin-top:clamp(26px,3vw,38px);border-top:2px solid var(--la-accent,#00CD77);padding-top:clamp(28px,3vw,38px)}
  .cmp-us .cmp-lab{color:var(--la-accent,#00CD77)}
  .cmp-us .cmp-p{font-size:15.5px;color:rgba(255,255,255,0.92)}
  .cmp-note{margin:16px 0 0;font-size:14px;line-height:1.55;color:rgba(255,255,255,0.6);text-wrap:pretty}

  /* ---------- skład projektowy ---------- */
  .cast{border-top:1px solid #e7ece4}
  .cast-row{display:grid;grid-template-columns:30px 1fr 190px;gap:clamp(14px,2vw,26px);align-items:baseline;padding:22px 4px;border-bottom:1px solid #e7ece4}
  .cast-when{font-size:13px;color:#98a29a;justify-self:end;text-align:right;white-space:nowrap}

  /* ---------- pełny skład studia ---------- */
  /* ---------- skład studia: arkusz stykowy, nie „poznaj zespół" ----------
     Kwadraty w gęstej siatce po jedenaście czytają się jak spis, okrągłe
     awatary wyśrodkowane po sześć — jak sekcja z szablonu. */
  .roster{display:grid;grid-template-columns:repeat(11,1fr);gap:clamp(18px,2vw,24px) clamp(8px,1vw,13px);margin-top:clamp(26px,3vw,36px)}
  .roster-p{display:block}
  .roster-ph{display:block;width:100%;aspect-ratio:1;border-radius:50%;overflow:hidden}
  .roster-ph img{width:100%;height:100%;object-fit:cover;display:block;filter:grayscale(1);transition:filter .3s,transform .3s cubic-bezier(.4,0,.2,1)}
  .roster-p:hover .roster-ph img{transform:scale(1.05)}
  .roster-n{display:block;margin-top:9px;font-size:12px;font-weight:700;line-height:1.2;letter-spacing:-0.004em;color:#16211a}
  .roster-r{display:block;margin-top:2px;font-size:10.5px;line-height:1.3;color:#98a29a;text-wrap:pretty}
  @media (prefers-reduced-motion:reduce){ .roster-ph img{transition:none} .roster-p:hover .roster-ph img{transform:none} }

  /* numer etapu zamiast zielonego kółka z inicjałami — „Q" samo wyglądało źle */
  .cast-i{font-family:ui-monospace,Menlo,monospace;font-size:12px;font-weight:700;color:#0a7a52;padding-top:5px}

  /* ---------- Wise Group ---------- */
  .wg{margin-top:clamp(36px,4.5vw,52px)}
  .wg-stem{position:relative;height:30px}
  .wg-stem::after{content:'';position:absolute;left:50%;top:0;bottom:0;width:1.5px;background:#c9d4c9}
  .wg-brace{height:24px;border-top:1.5px solid #c9d4c9;border-left:1.5px solid #c9d4c9;border-right:1.5px solid #c9d4c9;border-radius:16px 16px 0 0}
  .wg-tiles{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
  .wg-tile{padding:20px 18px;text-align:center;border-radius:12px;transition:background .25s}
  .wg-tile:hover{background:rgba(255,255,255,0.6)}
  .wg-tile.is-us{background:#0e2b1d}
  .wg-tile.is-us:hover{background:#123522}
