<section id="porownanie" style="position:relative;overflow:hidden;background:radial-gradient(900px 520px at 12% -2%, rgba(0,205,119,0.14), transparent 60%), #0e2b1d;padding:clamp(72px,10vw,120px) max(clamp(20px,5vw,56px),calc((100% - 1440px) / 2)) clamp(72px,9vw,110px);scroll-margin-top:16px">
