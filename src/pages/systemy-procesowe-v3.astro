  .aw-kafel em{display:block;margin-top:6px;font-style:normal;font-size:11.5px;color:var(--ziel-c);font-weight:600}
  .aw-kafel.uw b{color:var(--burs-c)}
  .aw-kp{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:24px;margin-top:20px}
  .aw-wyk{position:relative;padding:14px 16px 10px;border:1px solid #eceee9;border-radius:12px}
  .aw-wyk svg{display:block;width:100%;height:auto;margin-top:10px;overflow:visible}
  .aw-os{position:relative;height:16px;margin-top:6px;font-family:var(--mono);font-size:10px;color:#9aa39c}
  .aw-os span{position:absolute;top:0;white-space:nowrap}
