  .aw-filtry span{font-size:12px;font-weight:600;padding:6px 11px;border-radius:7px;border:1px solid #e6e9e3;color:#46524b}
  .aw-filtry span.on{background:var(--ink);border-color:var(--ink);color:#ffffff}
  .aw-filtry span.uw{border-color:rgba(240,163,58,0.5);color:var(--burs-c);background:#fdf5e8}
  .aw-filtry em{font-style:normal;font-family:var(--mono);margin-left:6px;opacity:0.7}
  .aw-rej{display:grid;grid-template-columns:82px minmax(0,1.2fr) minmax(0,1fr) 92px;gap:12px;align-items:center;padding:9px 10px;border-bottom:1px solid #f0f2ee;font-size:13px}
  .aw-rej.ng{font-size:11px;font-weight:650;color:#9aa39c;padding-top:0}
  .aw-rej b{font-family:var(--mono);font-size:11.5px;font-weight:500;color:#46524b}
  .aw-rej span:nth-child(2){font-weight:650;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .aw-rej span:nth-child(3){color:#46524b;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .aw-rej i{font-style:normal;text-align:right;color:#7b867f;font-variant-numeric:tabular-nums}
