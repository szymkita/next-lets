  .aw-krok.ok .aw-pkt{border-color:var(--ziel);background:var(--ziel)}
  .aw-krok.ok::before{background:var(--ziel)}
  .aw-krok.teraz .aw-pkt{border-color:var(--ziel);box-shadow:0 0 0 4px rgba(0,205,119,0.18)}
  .aw-krok b{display:block;font-size:13px;font-weight:650}
