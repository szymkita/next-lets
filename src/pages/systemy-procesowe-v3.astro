  .aw-r b{display:inline-block;margin-top:8px;font-size:14px;font-weight:700;padding:6px 10px;border-radius:7px;background:#f4f6f2;border:1px solid #e3e7e0}
  .v3-jw-dol{display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:12px 48px;margin-top:24px}
  .v3-jw-p{margin:0;max-width:620px;font-size:15.5px;line-height:1.6;color:rgba(255,255,255,0.78)}
  .v3-jw-p b{color:#ffffff;font-weight:700;margin-right:8px}
  .v3-jw-p[hidden]{display:none}
