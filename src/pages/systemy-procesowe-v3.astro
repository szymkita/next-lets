  /* ---- warunki zakupu i pas logotypów, na dole planszy ---- */
  .v3-war{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(18px,3vw,48px);margin:clamp(48px,5.6vw,80px) 0 0;padding:clamp(22px,2.4vw,30px) 0 0;border-top:1px solid rgba(255,255,255,0.1)}
  .v3-war dt{font-size:13px;font-weight:600;color:var(--ziel)}
  .v3-war dd{margin:8px 0 0;font-size:15px;line-height:1.55;color:rgba(255,255,255,0.68);text-wrap:pretty}
  .v3-war dd strong{font-weight:650;color:#ffffff}
  @media (max-width:820px){ .v3-war{grid-template-columns:1fr;gap:20px} }
  .v3-loga{display:flex;align-items:center;gap:36px;margin-top:clamp(40px,4.6vw,64px);padding:26px 0 30px;border-top:1px solid rgba(255,255,255,0.08)}
  .v3-loga > span{flex-shrink:0;max-width:200px;font-size:13.5px;line-height:1.45;color:rgba(255,255,255,0.55)}
  .v3-loga > span strong{color:#ffffff;font-weight:700}
  .v3-loga-o{flex:1;overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent)}
  .v3-loga-t{display:flex;align-items:center;gap:64px;width:max-content;animation:v3-loga 34s linear infinite}
  .v3-loga-t img{width:110px;height:26px;object-fit:contain;filter:grayscale(1) invert(1);mix-blend-mode:screen;opacity:0.62}
  @keyframes v3-loga{from{transform:translateX(0)}to{transform:translateX(calc(-50% - 32px))}}
  @media (max-width:700px){ .v3-loga{flex-direction:column;align-items:flex-start;gap:18px} .v3-loga-o{width:100%} }
  @media (prefers-reduced-motion:reduce){ .v3-loga-t{animation:none} }

  /* =====================================================================
     CZYM SĄ · definicja i indeks procesów
     ===================================================================== */
  .v3-def{display:grid;grid-template-columns:minmax(0,3.6fr) minmax(0,8.4fr);gap:clamp(24px,4vw,64px)}
  .v3-def-duzy{margin:0;font-size:clamp(22px,2.5vw,36px);line-height:1.26;letter-spacing:-0.026em;font-weight:500;color:var(--t1);text-wrap:pretty}
  .v3-def-2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(20px,3vw,48px);margin-top:clamp(28px,3.2vw,44px)}
  .v3-def-2 p{margin:0;font-size:16.5px;line-height:1.66;color:var(--t2);text-wrap:pretty}
  @media (max-width:900px){ .v3-def,.v3-def-2{grid-template-columns:1fr} }
  .v3-ix{margin-top:clamp(72px,9vw,136px)}
  .ix-gl{display:flex;justify-content:space-between;align-items:end;flex-wrap:wrap;gap:12px 48px;padding-bottom:18px;border-bottom:1.5px solid var(--t1)}
  .ix-gl h3{margin:0;font-size:15px;font-weight:700}
  .ix-gl p{margin:0;max-width:470px;font-size:14.5px;line-height:1.55;color:var(--t2)}
  .ix-w{display:grid;grid-template-columns:clamp(40px,5vw,72px) minmax(0,1fr) auto;gap:16px;align-items:center;padding:clamp(18px,2vw,28px) 0;border-bottom:1px solid var(--linia)}
  .ix-n{font-family:var(--mono);font-size:12px;color:var(--t3)}
  .ix-t{font-size:clamp(26px,3.5vw,50px);font-weight:650;letter-spacing:-0.04em;line-height:1.04;transition:transform .4s cubic-bezier(.2,.7,.2,1),color .2s}
  .ix-d{display:flex;align-items:center;gap:10px;font-family:var(--mono);font-size:12.5px;color:var(--t2);transition:color .2s}
  .ix-d i{display:block;width:26px;height:1px;background:currentColor;opacity:0.45}
  .ix-w:hover .ix-t{transform:translateX(12px);color:var(--ziel-c)}
  .ix-w:hover .ix-d{color:var(--ziel-c)}
  @media (max-width:760px){
    .ix-w{grid-template-columns:30px minmax(0,1fr);row-gap:8px}
    .ix-d{grid-column:2;flex-wrap:wrap;gap:6px 8px;font-size:11.5px}
    .ix-d i{width:14px}
  }

  /* =====================================================================
     DLACZEGO · teza, krzywa, trasa
     ===================================================================== */
  .v3-teza{margin:clamp(22px,2.6vw,34px) 0 0;max-width:1260px;font-size:clamp(30px,4.6vw,68px);line-height:1.03;letter-spacing:-0.047em;font-weight:650;color:var(--t1);text-wrap:balance}
  .v3-teza span{color:var(--t3)}
  .v3-kw{margin:clamp(56px,7vw,104px) 0 0;padding:clamp(18px,2vw,26px) 0 clamp(14px,1.6vw,20px);border-top:1px solid var(--linia);border-bottom:1px solid var(--linia)}
  .kw-ram{position:relative;aspect-ratio:1200 / 400}
  .kw-ram svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible}
  .kw-l{position:absolute;font-family:var(--mono);font-size:12px;line-height:1.35;color:var(--t2);white-space:nowrap}
  .kw-l.c{transform:translate(-50%,-100%)}
  .kw-pasmo-l{transform:translateX(-50%);top:0;text-align:center}
  .kw-kropka-l{width:clamp(210px,19vw,260px);transform:translateY(-100%);white-space:normal;font-family:inherit}
  .kw-kropka-l b{display:block;font-size:clamp(14px,1.25vw,16.5px);line-height:1.3;font-weight:700;letter-spacing:-0.012em;color:var(--t1)}
  .kw-kropka-l span{display:inline-flex;align-items:center;gap:8px;margin-top:8px;font-family:var(--mono);font-size:12px;color:var(--burs-c)}
  .kw-kropka-l span i{display:grid;grid-template-columns:repeat(3,5px);grid-auto-rows:4px;gap:1px;padding:2px;border:1px solid var(--burs-c);border-radius:2px}
  .kw-kropka-l span i u{display:block;background:rgba(156,95,20,0.35)}
  .kw-krzywa{fill:none;stroke:var(--t1);stroke-width:1.6;stroke-dasharray:1600;stroke-dashoffset:1600;transition:stroke-dashoffset 1.8s cubic-bezier(.5,0,.2,1)}
  .kw-pas,.kw-kr,.kw-ogon{opacity:0;transition:opacity .8s ease .9s}
  .kw-dot{transform-box:fill-box;transform-origin:center;transform:scale(0);transition:transform .5s cubic-bezier(.3,1.6,.5,1) 1.5s}
  .kw-l{opacity:0;transition:opacity .6s ease 1.2s}
  .v3-kw.on .kw-krzywa{stroke-dashoffset:0}
  .v3-kw.on .kw-pas,.v3-kw.on .kw-kr,.v3-kw.on .kw-ogon,.v3-kw.on .kw-l{opacity:1}
  .v3-kw.on .kw-dot{transform:none}
  .kw-puls{transform-box:fill-box;transform-origin:center;animation:v3-puls 2.4s ease-out infinite}
  @keyframes v3-puls{0%{transform:scale(0.6);opacity:0.7}100%{transform:scale(2.4);opacity:0}}
  /* Telefon: zamiast przewijania w bok plansza robi się wyższa (SVG się
     rozciąga, podpisy stoją w procentach), a podpis kropki przykleja się
     do prawej krawędzi. */
  @media (max-width:1000px){
    .kw-kropka-l{left:auto !important;right:0;width:min(210px,52%);text-align:right}
    .kw-kropka-l span{justify-content:flex-end}
  }
  @media (max-width:760px){
    .kw-ram{aspect-ratio:1200 / 720}
    .kw-l{font-size:10.5px}
    .kw-kropka-l span i{display:none}
  }

  .v3-trasa{margin-top:clamp(72px,8vw,120px)}
  .ts-rz{display:flex;align-items:flex-start;padding:30px 0 0}
  .ts-st{flex:0 0 auto;width:clamp(72px,7vw,104px);display:flex;flex-direction:column;align-items:center;gap:12px}
  .ts-kolo{display:flex;align-items:center;justify-content:center;width:58px;height:58px;border-radius:50%;background:#ffffff;border:2px solid var(--ziel);font-size:16px;font-weight:750;color:var(--t1);box-shadow:0 0 0 6px #ffffff,0 10px 24px -12px rgba(15,26,20,0.35)}
  .ts-st b{font-size:14.5px;font-weight:700}
  .ts-pr{flex:1;position:relative;height:58px}
  .ts-pr::before{content:"";position:absolute;left:0;right:0;top:50%;height:3px;margin-top:-1.5px;background:repeating-linear-gradient(90deg,var(--burs) 0 9px,transparent 9px 15px)}
  .ts-pr span{position:absolute;left:50%;bottom:calc(50% + 12px);transform:translateX(-50%);font-family:var(--mono);font-size:12px;color:var(--burs-c);white-space:nowrap}
  .ts-leg{display:flex;flex-wrap:wrap;gap:10px 30px;margin-top:28px;font-size:13.5px;color:var(--t2)}
  .ts-leg span{display:inline-flex;align-items:center;gap:10px}
  .ts-leg i{display:block}
  /* Telefon: trasa staje pionowo, podpis przerwy obok linii. */
  @media (max-width:760px){
    .ts-rz{flex-direction:column;align-items:flex-start;padding:0}
    .ts-st{flex-direction:row;width:auto;gap:16px}
    .ts-pr{flex:none;width:58px;height:58px}
    .ts-pr::before{left:50%;right:auto;top:0;bottom:0;width:3px;height:auto;margin:0 0 0 -1.5px;background:repeating-linear-gradient(180deg,var(--burs) 0 9px,transparent 9px 15px)}
    .ts-pr span{left:calc(100% + 16px);bottom:auto;top:50%;transform:translateY(-50%)}
  }
  .v3-pw{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(24px,3vw,52px);margin-top:clamp(56px,6.4vw,92px)}
  .pw-k{padding-top:20px;border-top:1.5px solid var(--t1)}
  .pw-k > span{font-family:var(--mono);font-size:12px;color:var(--t3)}
  .pw-k h3{margin:16px 0 0;font-size:clamp(19px,1.75vw,24px);font-weight:700;letter-spacing:-0.024em;line-height:1.2;text-wrap:balance}
  .pw-k p{margin:12px 0 0;font-size:15.5px;line-height:1.64;color:var(--t2);text-wrap:pretty}
  @media (max-width:900px){ .v3-pw{grid-template-columns:1fr} }

  /* =====================================================================
     JAK WYGLĄDA · ciemna scena z aplikacją
     ===================================================================== */
  .v3-scena{position:relative;overflow:hidden;color:#ffffff;
    background:radial-gradient(1100px 620px at 50% 104%,rgba(0,205,119,0.2),rgba(0,205,119,0) 70%),var(--ink)}
  .v3-scena > *{position:relative;z-index:1}
  .v3-jw-gl{display:flex;justify-content:space-between;align-items:end;flex-wrap:wrap;gap:20px 56px}
  .v3-zak{display:inline-flex;flex-wrap:wrap;gap:4px;padding:5px;margin-top:clamp(36px,4.4vw,56px);border-radius:999px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.09)}
  .v3-zak button{appearance:none;border:0;background:transparent;color:rgba(255,255,255,0.66);font:inherit;font-size:14px;font-weight:600;padding:10px 18px;border-radius:999px;cursor:pointer;transition:background .2s,color .2s}
  .v3-zak button:hover{color:#ffffff}
  .v3-zak button[aria-selected="true"]{background:#ffffff;color:var(--ink)}
  .v3-app{display:grid;grid-template-columns:212px minmax(0,1fr);height:clamp(540px,42vw,600px);margin-top:22px;border-radius:16px;overflow:hidden;background:#ffffff;color:var(--t1);
    box-shadow:0 0 0 1px rgba(255,255,255,0.14),0 70px 130px -50px rgba(0,0,0,0.8),0 0 140px -30px rgba(0,205,119,0.32)}
  .ap-bok{display:flex;flex-direction:column;padding:16px 12px;background:#f6f7f4;border-right:1px solid #eaece7}
  .ap-logo{display:flex;align-items:center;gap:10px;padding:4px 8px 18px;font-size:14px;font-weight:750;letter-spacing:-0.01em}
  .ap-logo i{position:relative;display:block;width:24px;height:24px;border-radius:7px;background:var(--ink)}
  .ap-logo i::after{content:"";position:absolute;left:7px;top:7px;width:10px;height:10px;border-radius:3px;background:var(--ziel)}
  .ap-nav{display:flex;flex-direction:column;gap:2px}
  .ap-nav span{display:flex;align-items:center;justify-content:space-between;padding:8px 10px;border-radius:8px;font-size:13.5px;color:#4a564f}
  .ap-nav span.on{background:#ffffff;color:var(--t1);font-weight:650;box-shadow:0 0 0 1px #e6e9e3,0 1px 2px rgba(0,0,0,0.04)}
  .ap-nav em{font-style:normal;font-family:var(--mono);font-size:11px;color:#8a948d}
  .ap-sekcja{margin:20px 10px 8px;font-size:11px;font-weight:600;color:#9aa39c}
  .ap-pr{display:flex;align-items:center;gap:8px;padding:5px 10px;font-size:12.5px;color:#4a564f}
  .ap-pr i{display:block;width:7px;height:7px;border-radius:2px}
  .ap-kto{display:flex;align-items:center;gap:10px;margin-top:auto;padding:12px 8px 2px;border-top:1px solid #eaece7;font-size:12.5px;font-weight:600}
  .ap-kto .av{display:flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:50%;background:#dcefe2;color:var(--ziel-c);font-size:10px;font-weight:800}
  .ap-kto em{display:block;font-style:normal;font-weight:400;font-size:11px;color:#8a948d}
  .ap-gl{display:flex;flex-direction:column;min-width:0}
  .ap-gora{display:flex;align-items:center;gap:12px;padding:12px 22px;border-bottom:1px solid #eaece7;font-size:13px;color:#7b867f}
  .ap-gora b{font-weight:600;color:var(--t1)}
  .ap-szukaj{margin-left:auto;display:flex;align-items:center;gap:8px;width:min(240px,34%);padding:7px 12px;border-radius:8px;background:#f3f4f1;font-size:12.5px;color:#9aa39c}
  .ap-szukaj kbd{margin-left:auto;font-family:var(--mono);font-size:10.5px;color:#9aa39c;border:1px solid #e3e6e0;border-radius:4px;padding:1px 5px;background:#ffffff}
  .ap-widok{flex:1;min-height:0;overflow:hidden;padding:22px 24px 20px}
  .ap-widok[hidden]{display:none}
  .aw-gl{display:flex;align-items:flex-start;flex-wrap:wrap;gap:10px 14px}
  .aw-gl h3{margin:2px 0 0;font-size:20px;font-weight:750;letter-spacing:-0.025em}
  .aw-nr{display:block;font-family:var(--mono);font-size:11.5px;color:#8a948d}
  .aw-chip{margin-top:6px;font-size:11.5px;font-weight:700;color:var(--ziel-c);background:#e2f5ea;border-radius:6px;padding:4px 9px}
  .aw-czeka{display:inline-flex;align-items:center;gap:7px;margin:7px 0 0 auto;font-size:12.5px;font-weight:650;color:var(--burs-c)}
  .aw-czeka i{display:block;width:7px;height:7px;border-radius:50%;background:var(--burs);box-shadow:0 0 0 3px rgba(240,163,58,0.22)}
  .aw-kol{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:26px;margin-top:20px}
  .aw-et{display:block;margin-bottom:8px;font-size:11px;font-weight:650;color:#9aa39c}
  .aw-blok + .aw-blok{margin-top:18px}
  .aw-pole{display:flex;align-items:baseline;gap:8px;padding:8px 0;border-bottom:1px solid #f0f2ee;font-size:13px}
  .aw-pole b{font-weight:650}
  .aw-pole .pr{margin-left:auto}
  .aw-zr{font-size:10.5px;font-weight:600;color:var(--ziel-c);background:#eef7f1;border-radius:4px;padding:2px 6px}
  .aw-poz{display:grid;grid-template-columns:minmax(0,1fr) 64px 118px;gap:10px;align-items:center;padding:8px 0;border-bottom:1px solid #f0f2ee;font-size:12.5px}
  .aw-poz span:nth-child(2){color:#7b867f;text-align:right}
