<script>
  var redukcja = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- Wejście w kadr: [data-anim] dostaje .on (krzywa, schody) ----
  (function(){
    var els = document.querySelectorAll('.v3 [data-anim]');
    if(!els.length) return;
    if(redukcja || !('IntersectionObserver' in window)){
      els.forEach(function(el){ el.classList.add('on'); });
      return;
    }
    els.forEach(function(el){ if(el.classList.contains('v3-sch')) el.classList.add('gra'); });
    var io = new IntersectionObserver(function(wpisy){
      wpisy.forEach(function(w){
        if(w.isIntersecting){ w.target.classList.add('on'); io.unobserve(w.target); }
      });
    }, { threshold: 0.3 });
    els.forEach(function(el){ io.observe(el); });
  })();

  // ---- Przyrząd w hero ----
  // Głowica jedzie przez obie osie z tą samą prędkością, więc krótka oś
  // kończy się w ułamku czasu długiej. Bez JS i przy reduced-motion
  // zostaje stan końcowy z markupu.
  (function(){
    var pz = document.querySelector('[data-pz]');
    if(!pz || redukcja || !window.requestAnimationFrame) return;
    var J = +pz.dataset.jazda, P = +pz.dataset.przerwa, T = +pz.dataset.cykl, G = +pz.dataset.gasnie;
    var U = +pz.dataset.udzial, D = +pz.dataset.dni;
    var J2 = J * U, S2 = J + P;
    var segs = Array.prototype.slice.call(pz.querySelectorAll('[data-od]')).map(function(s){
      return { od: +s.dataset.od, ud: +s.dataset.ud, i: s.firstElementChild };
    });
    var g1 = pz.querySelector('[data-g1]'), g2 = pz.querySelector('[data-g2]');
    var f2 = pz.querySelector('[data-f2]');
    var w1 = pz.querySelector('[data-w1]'), w2 = pz.querySelector('[data-w2]');
    var licz = pz.querySelector('[data-licznik]');
    function fmt(d){
      var dd = Math.floor(d + 1e-6), h = Math.round((d - dd) * 8);
      if(h === 8){ dd++; h = 0; }
      var s = dd > 0 ? dd + (dd === 1 ? ' dzień' : ' dni') : '';
      if(h > 0 || dd === 0) s += (s ? ' ' : '') + h + ' h';
      return s;
    }
    var cl = function(v){ return v < 0 ? 0 : v > 1 ? 1 : v; };
    pz.classList.add('gra');
    var start = null, przesun = 0, raf = null, ostatni = '';
    function klatka(ts){
      if(start === null) start = ts - przesun * 1000;
      var t = ((ts - start) / 1000) % T;
      przesun = t;
      var p1 = cl(t / J);
      segs.forEach(function(s){ s.i.style.width = (cl((p1 - s.od) / s.ud) * 100) + '%'; });
      g1.style.left = (p1 * 100) + '%';
      g1.style.opacity = t < J + 0.25 ? '1' : '0';
      var p2 = cl((t - S2) / J2);
      f2.style.width = (p2 * 100) + '%';
      g2.style.left = (p2 * U * 100) + '%';
      g2.style.opacity = (t > S2 - 0.1 && t < S2 + J2 + 0.25) ? '1' : '0';
      w1.classList.toggle('on', t >= J);
      w2.classList.toggle('on', t >= S2 + J2);
      pz.classList.toggle('gas', t > T - G);
      var tekst = t < S2 ? fmt(p1 * D) : fmt(p2 * U * D);
      if(tekst !== ostatni){ licz.textContent = tekst; ostatni = tekst; }
      raf = requestAnimationFrame(klatka);
    }
    // Pauza poza kadrem — po powrocie animacja rusza od miejsca, w którym stanęła.
    var io = new IntersectionObserver(function(w){
      if(w[0].isIntersecting){ if(raf === null){ start = null; raf = requestAnimationFrame(klatka); } }
      else if(raf !== null){ cancelAnimationFrame(raf); raf = null; }
    }, { threshold: 0.05 });
    io.observe(pz);
  })();

  // ---- Zakładki widoków systemu ----
  (function(){
    var zak = Array.prototype.slice.call(document.querySelectorAll('[data-zak]'));
    if(!zak.length) return;
    var widoki = document.querySelectorAll('[data-widok]');
    var podpisy = document.querySelectorAll('[data-podpis]');
    var nav = document.querySelectorAll('[data-nav]');
    var okruch = document.querySelector('[data-okruch]');
    function pokaz(i, fokus){
      zak.forEach(function(b, j){ b.setAttribute('aria-selected', i === j ? 'true' : 'false'); b.tabIndex = i === j ? 0 : -1; });
      widoki.forEach(function(w, j){ w.hidden = i !== j; });
      podpisy.forEach(function(p, j){ p.hidden = i !== j; });
      nav.forEach(function(n, j){ n.classList.toggle('on', i === j); });
      if(okruch) okruch.textContent = zak[i].textContent;
      if(fokus) zak[i].focus();
    }
    zak.forEach(function(b, i){
      b.addEventListener('click', function(){ pokaz(i); });
      b.addEventListener('keydown', function(e){
        if(e.key === 'ArrowRight'){ e.preventDefault(); pokaz((i + 1) % zak.length, true); }
        if(e.key === 'ArrowLeft'){ e.preventDefault(); pokaz((i - 1 + zak.length) % zak.length, true); }
      });
    });
  })();
</script>
