// =====================================================================
// v3 · DANE RYSUNKÓW
// =====================================================================

// ---- PRZYRZĄD (hero) ----
// Położenie każdego kroku na osi jako ułamek całego czasu sprawy.
let biegDni = 0;
const kroki = KROKI.map((x, i) => {
  const od = biegDni / DZIS_DNI;
  biegDni += kd(x);
  return { ...x, i, od, do: biegDni / DZIS_DNI, udzial: kd(x) / DZIS_DNI };
});
// Etykiety pracy stoją nad osią, na środku swojego kroku. Pierwsza
// przyklejona do lewej krawędzi, ostatnia do prawej — inaczej wyjeżdżają.
const PRACA = kroki.filter((x) => x.p).map((x, i, a) => ({
  ...x,
  srodek: (x.od + x.do) / 2,
  kotwica: i === 0 ? 'l' : i === a.length - 1 ? 'r' : 'c',
}));
const PZ = { jazda: 9, przerwa: 0.8, cykl: 16.5, gasnie: 1.2 };
const minOpis = (m) => `${m} min`;
const dniKrotko = (d) => String(d).replace('.', ',') + (d === 1 ? ' dzień' : Number.isInteger(d) ? ' dni' : ' dnia');

// ---- KRZYWA (dlaczego) ----
// Rozkład „jak firmy prowadzą ten proces". Środek przesunięty w lewo, żeby
// prawy ogon był długi — tam stoi Wasz sposób pracy. Pasmo konfiguracji to
// ±1,5 odchylenia: tyle, ile przewidział producent.
const KW = { w: 1200, h: 400, x0: 30, x1: 1170, y0: 330, mu: 450, s: 118, wys: 236 };
const gauss = (x) => Math.exp(-0.5 * ((x - KW.mu) / KW.s) ** 2);
const kwY = (x) => KW.y0 - gauss(x) * KW.wys;
const KW_PKT = Array.from({ length: Math.round((KW.x1 - KW.x0) / 6) + 1 }, (_, i) => KW.x0 + i * 6);
const KRZYWA_D = 'M' + KW_PKT.map((x) => `${x},${kwY(x).toFixed(1)}`).join(' L');
const PASMO = [KW.mu - 1.5 * KW.s, KW.mu + 1.5 * KW.s];
const PASMO_PKT = KW_PKT.filter((x) => x >= PASMO[0] && x <= PASMO[1]);
const PASMO_D = `M${PASMO[0]},${KW.y0} L` + PASMO_PKT.map((x) => `${x},${kwY(x).toFixed(1)}`).join(' L') + ` L${PASMO[1]},${KW.y0} Z`;
const KROPKA = { x: 940, y: KW.y0 };
const proc = (v, z) => `${(v / z * 100).toFixed(2)}%`;

// ---- TRASA (dlaczego) ----
const STACJE = [
  { n: 'CRM', z: 'C' },
  { n: 'ERP', z: 'E' },
  { n: 'Magazyn', z: 'M' },
  { n: 'Arkusz', z: 'A' },
  { n: 'Poczta', z: 'P' },
];

// ---- SCHODY (uruchomienia) ----
// Ten sam czas sprawy cztery razy, w skali osi z hero. Delta liczona od
// wartości nominalnych (6 → 3 → 1,5 → pół dnia), bo tak mówi tekst.
const NOMINAL = [6, 3, 1.5, PO_DNI];
const SCHODY = URUCHOMIENIA.map((o, i) => ({
  ...o,
  u: o.dni / DZIS_DNI,
  prev: (i === 0 ? DZIS_DNI : URUCHOMIENIA[i - 1].dni) / DZIS_DNI,
  delta: NOMINAL[i] - NOMINAL[i + 1],
  wartosc: o.dni >= 1 ? dniOpis(o.dni) : `${PO_GODZ} godziny`,
}));

// ---- APLIKACJA (jak wygląda) ----
const ZAKLADKI = [
  { t: 'Karta sprawy', nav: 'Zapytania', p: 'Komplet danych do decyzji w jednym miejscu, wciągnięty z CRM-a, ERP-a i magazynu. Widać, kto trzyma sprawę teraz i od ilu godzin.' },
  { t: 'Rejestr spraw', nav: 'Rejestr', p: 'Stan wszystkich zapytań z czasem oczekiwania przy każdym. Sprawa, która stoi za długo, sama wychodzi na wierzch.' },
  { t: 'Kokpit', nav: 'Kokpit', p: 'Czas sprawy liczony na żywo, razem z krokiem, na którym sprawy stoją najdłużej. To on wskazuje następne uruchomienie do zbudowania.' },
  { t: 'Reguły', nav: 'Ustawienia', p: 'Ekran, na którym Wasz człowiek przesuwa próg akceptacji albo termin przypomnienia. Zmiana wchodzi od razu, bez wdrożenia.' },
];
// Czas sprawy tydzień po tygodniu w kokpicie — schodki w dniach uruchomień.
// Poglądowe, spięte z ciemnym pasem: 6 → 3 → 1,5 dnia.
const TYGODNIE = [6.1, 6.0, 6.2, 5.9, 6.1, 6.0, 3.2, 3.0, 2.9, 3.1, 2.8, 1.7, 1.5, 1.6, 1.5];
const TYG_W = 300, TYG_H = 86;
const TYG_D = 'M' + TYGODNIE.map((v, i) => `${(i / (TYGODNIE.length - 1) * TYG_W).toFixed(1)},${(TYG_H - v / 6.5 * TYG_H).toFixed(1)}`).join(' L');

// ---- EKRAN Z ADNOTACJAMI (konfiguracja) ----
const OBIEG_USTAWIENIA = [
  { t: 'Rejestracja zapytania', kto: 'automatycznie' },
  { t: 'Wycena techniczna', kto: 'technolog' },
  { t: 'Potwierdzenie dostępności', kto: 'magazyn · automatycznie' },
  { t: 'Akceptacja marży', kto: 'zarząd · tylko poza widełkami', zm: true },
  { t: 'Wysyłka do klienta', kto: 'opiekun klienta' },
];

// ---- DOWODY ----
const rozbij = (s) => { const i = s.indexOf(' '); return [s.slice(0, i), s.slice(i + 1)]; };
