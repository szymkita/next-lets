<div class="mob-cta hide" id="mobCta">
<a href={TEL_HREF} aria-label="Zadzwoń" style="display:flex;align-items:center;justify-content:center;width:48px;height:48px;flex-shrink:0;border:1px solid #e2eade;border-radius:11px;color:#0a7a52"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .3 1.9.6 2.8a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.5 2.8.6a2 2 0 0 1 1.7 2z"/></svg></a>
<a href="#formularz" style="flex:1;display:flex;align-items:center;justify-content:center;gap:8px;background:#0a7a52;color:#fff;padding:15px 20px;border-radius:11px;font-weight:750;font-size:16px">Umów konsultację <span aria-hidden="true">→</span></a>
</div>

<script>
  // ---- Odsłanianie sekcji przy wejściu w kadr ----
  (function(){
    var els = document.querySelectorAll('[data-anim]');
    if(!els.length) return;
    var redukcja = window.matchMedia && window.matchMedia('(prefers-reduced-motion:reduce)').matches;
    if(redukcja || !('IntersectionObserver' in window)){
      els.forEach(function(el){ el.classList.add('on'); });
      return;
    }
    var io = new IntersectionObserver(function(wpisy){
      wpisy.forEach(function(w){
        if(w.isIntersecting){ w.target.classList.add('on'); io.unobserve(w.target); }
      });
    }, { threshold: 0.25 });
    els.forEach(function(el){ io.observe(el); });
  })();

  // ---- Formularze: walidacja, wysyłka, stan po wysłaniu ----
  //
  // Na stronie stoją dwa formularze (u góry i w domknięciu) i jeden skrypt
  // obsługuje oba. Wszystko, czego potrzebuje, siedzi wewnątrz [data-lead],
  // więc identyfikatory pól nie mają znaczenia.
  (function(){
    var ENDPOINT = '/api/kontakt';
    var MAIL = 'hello@letsautomate.pl';
    var formy = document.querySelectorAll('[data-lead]');
    if(!formy.length) return;

    var REGULY = [
      { pole: 'email',   msg: 'Sprawdź adres e-mail.',   ok: function(v){ return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v); } },
      { pole: 'telefon', msg: 'Sprawdź numer telefonu.', ok: function(v){ return v.replace(/\D/g, '').length >= 9; } }
    ];

    function pole(el){ return el.closest ? el.closest('.f-field') : null; }

    function bladWl(el, msg){
      var f = pole(el); if(!f) return;
      f.classList.add('err');
      el.setAttribute('aria-invalid', 'true');
      var box = f.querySelector('.f-err');
      if(box && msg) box.textContent = msg;
    }
    function bladWyl(el){
      var f = pole(el); if(!f) return;
      f.classList.remove('err');
      el.removeAttribute('aria-invalid');
    }

    formy.forEach(function(form){
      var karta = form.closest('.fk');
      var btn = form.querySelector('[data-submit]');
      var etykieta = btn.querySelector('[data-label]');
      var zgoda = form.querySelector('[data-consent]');
      var wierszZgody = form.querySelector('[data-consent-row]');
      var awaria = form.querySelector('[data-fallback]');
      var okBox = karta ? karta.querySelector('[data-ok]') : null;

      function sprawdz(){
        var pierwszy = null;
        REGULY.forEach(function(r){
          var el = form.elements[r.pole];
          var v = (el.value || '').trim();
          if(v && r.ok(v)){ bladWyl(el); }
          else { bladWl(el, v ? r.msg : 'To pole jest wymagane.'); if(!pierwszy) pierwszy = el; }
        });
        wierszZgody.classList.toggle('err', !zgoda.checked);
        if(!zgoda.checked && !pierwszy) pierwszy = zgoda;
        return pierwszy;
      }

      form.addEventListener('input', function(e){ if(pole(e.target)) bladWyl(e.target); });
      zgoda.addEventListener('change', function(){ wierszZgody.classList.toggle('err', !zgoda.checked); });

      function telefonPelny(){
        return (form.elements.kierunkowy.value + ' ' + (form.elements.telefon.value || '').trim()).trim();
      }

      function pokazOk(){
        // Echo adresu — literówkę widać od razu, zanim zaczniemy czekać na odpowiedź.
        var echo = okBox.querySelector('[data-echo]');
        var echoTxt = okBox.querySelector('[data-echo-text]');
        var mail = (form.elements.email.value || '').trim();
        if(echo && echoTxt && mail){
          echoTxt.textContent = mail;
          echo.hidden = false;
        }
        form.hidden = true;
        okBox.hidden = false;
        okBox.scrollIntoView({ block: 'nearest' });
        okBox.focus();
      }

      function pokazAwarie(){
        // Nie udajemy wysyłki — dajemy drogę, którą zgłoszenie naprawdę dojdzie.
        var mailto = awaria.querySelector('[data-mailto]');
        if(mailto){
          mailto.href = 'mailto:' + MAIL
            + '?subject=' + encodeURIComponent('Bezpłatna konsultacja — zgłoszenie')
            + '&body=' + encodeURIComponent(
                'E-mail: ' + (form.elements.email.value || '').trim()
                + '\nTelefon: ' + telefonPelny()
                + '\n\n' + (form.elements.wiadomosc.value || '').trim()
              );
        }
        awaria.hidden = false;
        awaria.scrollIntoView({ block: 'nearest' });
      }

      // Podgląd ekranu po wysłaniu (?sukces=1) omija wysyłkę — inaczej
      // podejrzenie stanu sukcesu wysyłałoby puste zgłoszenie na skrzynkę.
      form.podgladSukcesu = pokazOk;

      form.addEventListener('submit', function(e){
        e.preventDefault();
        var zly = sprawdz();
        if(zly){ zly.focus(); return; }

        btn.disabled = true;
        var napis = etykieta.textContent;
        etykieta.textContent = 'Wysyłam…';
        awaria.hidden = true;

        fetch(ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({
            email: (form.elements.email.value || '').trim(),
            telefon: telefonPelny(),
            wiadomosc: (form.elements.wiadomosc.value || '').trim(),
            firma_www: form.elements.firma_www.value || '',
            zrodlo: form.dataset.zrodlo || 'darmowa-konsultacja'
          })
        })
          .then(function(r){
            if(!r.ok) throw new Error('HTTP ' + r.status);
            pokazOk();
          })
          .catch(function(){
            btn.disabled = false;
            etykieta.textContent = napis;
            pokazAwarie();
          });
      });
    });

    // Podgląd ekranu po wysłaniu bez wysyłki: ?sukces=1
    if(location.search.indexOf('sukces=1') > -1){
      var pierwsza = formy[0];
      pierwsza.elements.email.value = 'jan@firma.pl';
      if(pierwsza.podgladSukcesu) pierwsza.podgladSukcesu();
    }
  })();

  // ---- Pasek CTA na mobile: tylko gdy żaden formularz nie jest w kadrze ----
  (function(){
    var bar = document.getElementById('mobCta');
    var cele = document.querySelectorAll('.fk');
    if(!bar || !cele.length || !('IntersectionObserver' in window)) return;
    var widoczne = 0;
    var io = new IntersectionObserver(function(wpisy){
      wpisy.forEach(function(w){ widoczne += w.isIntersecting ? 1 : -1; });
      if(widoczne < 0) widoczne = 0;
      bar.classList.toggle('hide', widoczne > 0);
    }, { threshold: 0.12 });
    cele.forEach(function(el){ io.observe(el); });
  })();
</script>

</LaBase>
