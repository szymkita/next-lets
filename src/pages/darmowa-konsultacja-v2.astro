---
import LaBase from '../layouts/LaBase.astro';
import GcFaq from '../components/GcFaq.astro';
import FormularzLead from '../components/FormularzLead.astro';

// ============================================================================
// BEZPŁATNA KONSULTACJA — strona, która jest formularzem.
//
// Różnica wobec /darmowa-konsultacja (wersja z 07.09.2026): tamta sprzedaje
// rozmowę splitem „argumenty po lewej, formularz po prawej". Ta zaczyna się
// od samego formularza, a wszystko poniżej odpowiada na jedno pytanie:
// co się wydarzy, kiedy go wyślesz. Kolejność sekcji idzie po osi czasu
// zgłoszenia — wysyłka, kontakt, rozmowa, mail — a nie po liście zalet.
//
// TEZA STRONY: mail po rozmowie zostaje u klienta niezależnie od tego, czy
// zaczniemy współpracę. Dlatego ma na stronie własny artefakt (sekcja S2),
// a nie zdanie w wyliczance.
//
// DO POTWIERDZENIA PRZED PUBLIKACJĄ
//   1. Czas rozmowy. Strona mówi 30 minut (za stroną główną i /darmowa-
//      konsultacja). Obecny letsautomate.pl obiecuje „pełną godzinę" —
//      trzeba wybrać jedną liczbę dla całego serwisu.
//   2. Podział tych 30 minut (tablica AGENDA) i wynikające z niego zdanie
//      „20 z 30 minut mówisz Ty". Liczby są z obserwacji, nie z pomiaru.
//   3. Termin maila po rozmowie: „kilka dni roboczych".
//   4. Treść przykładowego maila (S2) — czy tak wygląda to, co wysyłamy.
//   5. Kto prowadzi rozmowy (strona pokazuje Szymona) i czy zdjęcie zostaje.
//   6. Sekcja „Kiedy nie warto się umawiać" — obie granice są decyzją
//      handlową, nie faktem technicznym.
//   7. Adres /polityka-prywatnosci (link w zgodzie formularza).
//   8. Druga zgoda — marketingowa. Obecny formularz na letsautomate.pl ma
//      dwie; tutaj jest jedna, bo /api/kontakt nie zapisuje zgód osobno.
//
// PODGLĄD EKRANU PO WYSŁANIU: /darmowa-konsultacja-v2?sukces=1
// ============================================================================

const KONTAKT_MAIL = 'hello@letsautomate.pl';
const KONTAKT_TEL = '+48 571 399 932';
const TEL_HREF = 'tel:+48571399932';

// Oś czasu zgłoszenia. Akcent dostaje tylko etap oznaczony `mocny`: w tym
// jednym punkcie po drugiej stronie siedzi człowiek. Reszta to skrzynka.
const ETAPY = [
  {
    kiedy: 'po kliknięciu',
    t: 'Zgłoszenie idzie do nas',
    d: 'Trafia na skrzynkę i na kanał zespołu. Nie ma kolejki ani systemu ticketowego.',
  },
  {
    kiedy: '1 dzień roboczy',
    t: 'Piszemy albo dzwonimy',
    d: 'Na kontakt, który zostawisz. Ustawiamy termin — zwykle w tym samym tygodniu.',
  },
  {
    kiedy: '30 minut',
    t: 'Rozmawiamy o jednym procesie',
    d: 'Online przez Meet albo Zoom, jak wolisz — telefonicznie.',
    mocny: true,
  },
  {
    kiedy: 'kilka dni później',
    t: 'Przychodzi mail',
    d: 'Pierwszy krok opisany tak, żeby dało się go komuś zlecić. Bez oferty w załączniku.',
  },
];

// Podział rozmowy. Procenty liczą się z minut — po zmianie liczby pasek
// przelicza się sam i zdanie pod nim też.
const AGENDA = [
  { min: 5, t: 'Po co ta rozmowa', d: 'Co się dzieje w firmie, że w ogóle o tym myślisz.' },
  { min: 15, t: 'Jak to wygląda dziś', d: 'Ten jeden proces, krok po kroku, z nazwami narzędzi.', mocny: true },
  { min: 7, t: 'Co da się z tym zrobić', d: 'Od czego zacząć i co odłożyć na później.' },
  { min: 3, t: 'Ustalenia', d: 'Co dostaniesz mailem i kiedy.' },
];
const MINUTY = AGENDA.reduce((s, a) => s + a.min, 0);
const TWOJE_MINUTY = AGENDA[0].min + AGENDA[1].min;
const pct = (m) => (m / MINUTY) * 100;

// Pytania z drugiego etapu rozmowy — te same, które zajmują 15 minut paska.
const PYTANIA = [
  'Jak ten proces wygląda od pierwszego kontaktu do zamknięcia sprawy?',
  'Ile osób go dotyka i w których miejscach te same dane wpisujecie drugi raz?',
  'Ile spraw przechodzi przez niego w miesiącu?',
  'W czym to dziś siedzi — skrzynka, arkusz, CRM, system magazynowy?',
  'Co się dzieje, kiedy sprawa utknie? Kto to zauważa i po czym?',
  'Co się zmieni w firmie, jeśli ten proces zacznie działać inaczej?',
];

const NIE_BEDZIE = [
  {
    t: 'Prezentacji o nas',
    d: 'Nie mamy przygotowanego deka i nie wysyłamy go po spotkaniu. Cała rozmowa idzie po Twoim procesie.',
  },
  {
    t: 'Kwoty rzuconej w ciemno',
    d: 'Cena pada, kiedy znamy zakres. Na pierwszej rozmowie zwykle jest na to za wcześnie — dostajesz rząd wielkości i to, od czego on zależy.',
  },
  {
    t: 'Namawiania na AI',
    d: 'Część spraw tanio załatwia zmiana w procesie albo narzędzie, które już macie. Kiedy tak jest, mówimy to na spotkaniu.',
  },
  {
    t: 'Handlowca po drugiej stronie',
    d: 'Rozmowę prowadzi osoba, która potem odpowiada za wdrożenie. To ona zna koszt tego, co obiecuje.',
  },
];

const GRANICE = [
  'Szukasz wykonawcy do gotowej specyfikacji i najniższej stawki za godzinę. Wyślij ją mailem — odpowiemy, czy się tego podejmujemy, bez rozmowy.',
  'Potrzebujesz darmowej wyceny do przetargu albo do porównania z inną ofertą. Tego nie robimy.',
];

const OPINIE = [
  {
    q: 'Wprowadzenie danych trwało godzinę. Dziś przesłanie oferty to 10 minut — oszczędności liczymy w etatach.',
    kto: 'Mateusz Chinczewski',
    rola: 'Prezes Zarządu, Finerto',
  },
  {
    q: 'Let’s automate wziął pełną odpowiedzialność za projekt i dowiózł go do końca. To dlatego powierzyliśmy im kolejny, znacznie większy.',
    kto: 'Jakub Ciołkowski',
    rola: 'Członek Zarządu, NARS Polska',
  },
  {
    q: 'Bardzo dobrze zrozumieli nasze potrzeby i zaprojektowali scenariusz, który spełnił cele biznesowe. Otwartość i komunikacja to ich DNA.',
    kto: 'Arkadiusz Andruch',
    rola: 'Prezes Zarządu, X2O',
  },
];

const FAQ = [
  {
    q: 'Czym właściwie jest ta konsultacja?',
    a: 'To 30 minut z osobą, która buduje takie systemy na co dzień. Opowiadasz, jak wygląda jeden proces w Twojej firmie, my dopytujemy o szczegóły i mówimy, co da się z tym zrobić. Kilka dni później dostajesz to samo mailem, na piśmie.',
  },
  {
    q: 'Czy to mnie do czegoś zobowiązuje?',
    a: 'Nie. Konsultacja i mail po niej są bezpłatne. Jeśli po rozmowie uznasz, że to nie ten moment, zostaje u Ciebie opis pierwszego kroku i możesz go zrobić sam albo z kimś innym.',
  },
  {
    q: 'Nie mam sprecyzowanego pomysłu. Ma to sens?',
    a: 'Wtedy ma największy. Wystarczy jeden proces, który Was uwiera — reszta to nasze pytania. Nazwanie, co i w jakiej kolejności da się usprawnić, jest częścią tej rozmowy, nie warunkiem wstępnym.',
  },
  {
    q: 'Mam gotowy projekt. Możecie od razu wycenić?',
    a: 'Tak. Wtedy pomijamy diagnozę i rozmawiamy o zakresie, ryzykach i terminie. Opisz projekt w formularzu, a na rozmowę przyjdziemy z pytaniami do wyceny.',
  },
  {
    q: 'Jak wygląda rozmowa od strony technicznej?',
    a: 'Google Meet albo Zoom, link wysyłamy mailem. Jeśli wolisz telefon, dzwonimy. Nagrywamy tylko wtedy, gdy o to poprosisz.',
  },
  {
    q: 'Co z naszymi danymi?',
    a: 'Pracujemy zgodnie z RODO, a przed każdym projektem podpisujemy NDA — także przed samą rozmową, jeśli tego potrzebujecie. Do konsultacji nie potrzebujemy dostępu do żadnego z Waszych systemów.',
  },
];
---
<LaBase
  title="Bezpłatna konsultacja — Let's automate"
  description="Wypełnij formularz, odezwiemy się w jeden dzień roboczy. 30 minut o jednym procesie w Twojej firmie, a kilka dni po rozmowie mail z pierwszym krokiem. Bezpłatnie i bez zobowiązań."
  ctaHref="#formularz"
  nav={null}
  noindex={true}
>

<style is:global slot="head">

  /* Poświata biegnie od samej góry strony, więc pod przyklejoną nawigacją
     nie ma krawędzi koloru. LaBase daje `.page` białe — tu dokładamy tło. */
  .page{background:radial-gradient(940px 600px at 84% 0, rgba(0,205,119,0.14), transparent 62%) no-repeat, #ffffff}

  /* Kolumna węższa niż domyślne 1440 z `.sec-pad`: strona jest formularzem,
     a nie katalogiem — dłuższe wiersze robiłyby z niej ulotkę. */
  .sec{padding:clamp(64px,8vw,104px) max(clamp(20px,5vw,56px),calc((100% - 1320px) / 2));scroll-margin-top:80px}
  .sec-tint{background:#f4f8f2}
  .h-sec{text-wrap:pretty}

  /* ---------- S0 · FORMULARZ NAD ZGIĘCIEM ---------- */
  .fold{position:relative;z-index:1;padding:clamp(22px,3vw,40px) max(clamp(20px,5vw,56px),calc((100% - 1120px) / 2)) clamp(48px,6vw,76px)}
  .fold h1{margin:0;max-width:15ch;font-size:clamp(34px,5.4vw,60px);line-height:1.02;letter-spacing:-0.034em;font-weight:800;text-wrap:balance}
  .fold-lead{margin:18px 0 clamp(26px,3vw,34px);max-width:58ch;font-size:clamp(16px,1.5vw,18.5px);line-height:1.58;color:#3d4a42;text-wrap:pretty}
  .fold-pod{display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:14px 40px;margin-top:20px}
  .fold-pod p{margin:0;max-width:56ch;font-size:14.5px;line-height:1.6;color:#6d786f}
  .fold-kontakt{font-size:14.5px;color:#6d786f;white-space:nowrap}
  .fold-kontakt a{font-weight:700;color:#0a7a52}

  /* ---------- S1 · OŚ ZGŁOSZENIA ---------- */
  .os{position:relative;margin-top:clamp(38px,4.6vw,58px)}
  .os-tor{position:absolute;left:0;right:0;top:7px;height:1px;background:linear-gradient(90deg,#d7e2d4 0%,#d7e2d4 76%,rgba(215,226,212,0) 100%);transform:scaleX(0);transform-origin:left;transition:transform 1s cubic-bezier(.4,0,.2,1)}
  .os.on .os-tor{transform:scaleX(1)}
  .os-lista{position:relative;display:grid;grid-template-columns:repeat(4,1fr);gap:0 clamp(18px,2.4vw,36px)}
  .os-etap{position:relative;padding-right:12px;opacity:0;transform:translateY(10px);transition:opacity .5s ease,transform .5s cubic-bezier(.4,0,.2,1)}
  .os.on .os-etap{opacity:1;transform:none}
  .os.on .os-etap:nth-child(1){transition-delay:.10s}
  .os.on .os-etap:nth-child(2){transition-delay:.28s}
  .os.on .os-etap:nth-child(3){transition-delay:.46s}
  .os.on .os-etap:nth-child(4){transition-delay:.64s}
  .os-kropka{display:block;width:15px;height:15px;border-radius:50%;background:#ffffff;border:2px solid #c3d2bf}
  .os-etap.mocny .os-kropka{width:15px;height:15px;background:var(--la-accent,#00CD77);border-color:var(--la-accent,#00CD77);box-shadow:0 0 0 6px rgba(0,205,119,0.18)}
  .os-kiedy{margin-top:18px;font-family:ui-monospace,Menlo,monospace;font-size:11.5px;letter-spacing:0.08em;text-transform:uppercase;color:#8b968d}
  .os-etap.mocny .os-kiedy{color:#0a7a52}
  .os-t{margin-top:9px;font-size:clamp(17px,1.7vw,20px);font-weight:750;letter-spacing:-0.018em;color:#16211a}
  .os-d{margin:7px 0 0;font-size:14.5px;line-height:1.55;color:#4c5850;max-width:26ch}
  .os-stopka{margin-top:clamp(34px,4vw,46px);padding-top:20px;border-top:1px solid #dfe8db;font-size:15px;color:#4c5850}
  .os-stopka a{font-weight:700;color:#0a7a52}

  /* ---------- S2 · MAIL PO ROZMOWIE ---------- */
  .mail-grid{display:grid;grid-template-columns:1fr 640px;gap:clamp(36px,5vw,80px);align-items:start}
  .teza{margin:26px 0 0;font-size:clamp(21px,2.4vw,30px);line-height:1.24;letter-spacing:-0.02em;font-weight:700;color:#16211a;text-wrap:pretty}
  .teza em{font-style:normal;background:linear-gradient(transparent 62%, rgba(0,205,119,0.35) 62%)}
  .mail-poza{margin:22px 0 0;font-size:15px;line-height:1.6;color:#4c5850;max-width:44ch}
  .koperta{background:#ffffff;border:1px solid #e2e9df;border-radius:16px;box-shadow:0 34px 70px -46px rgba(18,38,28,0.5);overflow:hidden}
  .kop-head{padding:16px 22px;border-bottom:1px solid #eef2ec;background:#fbfcfa}
  .kop-linia{display:flex;gap:10px;font-size:13px;line-height:1.7;color:#6d786f}
  .kop-klucz{flex-shrink:0;width:46px;font-family:ui-monospace,Menlo,monospace;font-size:11px;letter-spacing:0.04em;text-transform:uppercase;color:#9aa69c;padding-top:3px}
  .kop-temat{font-size:15.5px;font-weight:750;color:#16211a}
  .kop-body{padding:24px 22px 26px}
  .kop-wiersz{display:grid;grid-template-columns:132px 1fr;gap:14px;padding:13px 0;border-top:1px solid #f0f3ee}
  .kop-wiersz:first-child{border-top:0;padding-top:0}
  .kop-et{font-size:12.5px;font-weight:700;line-height:1.5;color:#0a7a52}
  .kop-tr{font-size:14.5px;line-height:1.6;color:#33413a}
  .kop-tr strong{font-weight:750;color:#16211a}
  .kop-stopa{padding:14px 22px;border-top:1px solid #eef2ec;background:#fbfcfa;font-size:13px;line-height:1.55;color:#7c877e}
  .podpis-rys{margin:14px 0 0;font-size:13px;line-height:1.55;color:#8b968d}

  /* ---------- S3 · PASEK 30 MINUT ---------- */
  .min-head{display:grid;grid-template-columns:1fr 380px;gap:clamp(28px,4vw,72px);align-items:end}
  .pasek{display:flex;width:100%;height:clamp(56px,6vw,72px);margin-top:clamp(34px,4vw,48px);border-radius:12px;overflow:hidden;background:#e7ece4}
  /* Wypełnienie jedzie osobną warstwą, nie napisem — inaczej scaleX ściska
     też cyfry i podczas animacji „5 min" wygląda jak zgnieciony druk. */
  .pasek-seg{position:relative;overflow:hidden}
  .pasek-fill{position:absolute;inset:0;background:#cfe3d3;transform:scaleX(0);transform-origin:left;transition:transform .7s cubic-bezier(.4,0,.2,1)}
  .pasek-seg + .pasek-seg .pasek-fill{border-left:1px solid rgba(255,255,255,0.85)}
  .pasek-seg.mocny .pasek-fill{background:var(--la-accent,#00CD77)}
  .pasek-seg span{position:relative;z-index:1;display:flex;align-items:center;justify-content:center;height:100%;font-family:ui-monospace,Menlo,monospace;font-size:13px;font-weight:700;color:#0e2b1d;opacity:0;transition:opacity .3s ease}
  .pasek-seg.mocny span{color:#06170e}
  .pasek.on .pasek-seg .pasek-fill{transform:scaleX(1)}
  .pasek.on .pasek-seg span{opacity:1}
  .pasek.on .pasek-seg:nth-child(1) .pasek-fill{transition-delay:.05s}
  .pasek.on .pasek-seg:nth-child(2) .pasek-fill{transition-delay:.24s}
  .pasek.on .pasek-seg:nth-child(3) .pasek-fill{transition-delay:.50s}
  .pasek.on .pasek-seg:nth-child(4) .pasek-fill{transition-delay:.66s}
  .pasek.on .pasek-seg:nth-child(1) span{transition-delay:.45s}
  .pasek.on .pasek-seg:nth-child(2) span{transition-delay:.74s}
  .pasek.on .pasek-seg:nth-child(3) span{transition-delay:.90s}
  .pasek.on .pasek-seg:nth-child(4) span{transition-delay:1.02s}
  .pasek-opisy{display:flex;width:100%;margin-top:16px}
  .pasek-opis{padding-right:18px}
  .pasek-opis .t{font-size:15px;font-weight:700;letter-spacing:-0.01em;color:#16211a;text-wrap:balance}
  .pasek-opis .d{margin:5px 0 0;font-size:13.5px;line-height:1.5;color:#6d786f}
  .odczyt{margin:clamp(30px,3.6vw,42px) 0 0;max-width:24ch;font-size:clamp(20px,2.2vw,27px);line-height:1.25;letter-spacing:-0.02em;font-weight:700;color:#16211a}

  /* ---------- S3b · PYTANIA ---------- */
  .pyt{margin-top:clamp(46px,5.4vw,68px);padding-top:clamp(34px,4vw,44px);border-top:1px solid #dfe8db}
  .pyt-wstep{max-width:52ch;font-size:16.5px;line-height:1.6;color:#3d4a42}
  .pyt-lista{margin-top:clamp(20px,2.4vw,28px)}
  .pyt-w{display:flex;align-items:baseline;gap:clamp(14px,2vw,26px);padding:15px 0;border-top:1px solid #e4ebe0;font-size:clamp(16px,1.75vw,19.5px);line-height:1.45;letter-spacing:-0.012em;color:#22302a;text-wrap:pretty}
  .pyt-w:last-child{border-bottom:1px solid #e4ebe0}
  .pyt-n{flex-shrink:0;font-family:ui-monospace,Menlo,monospace;font-size:12px;font-weight:700;color:#9aa69c}

  /* ---------- S4 · CIEMNY PAS ---------- */
  .ciemny{position:relative;overflow:hidden;background:radial-gradient(860px 480px at 86% 0%, rgba(0,205,119,0.15), transparent 58%), #0e2b1d;border-radius:26px;padding:clamp(44px,5.6vw,76px) clamp(30px,4.4vw,66px)}
  .nb-lista{margin-top:clamp(32px,3.8vw,46px)}
  .nb-w{display:grid;grid-template-columns:300px 1fr;gap:8px clamp(24px,3vw,52px);padding:22px 0;border-top:1px solid rgba(255,255,255,0.13)}
  .nb-w:last-child{border-bottom:1px solid rgba(255,255,255,0.13)}
  .nb-t{font-size:clamp(18px,1.9vw,22px);font-weight:750;letter-spacing:-0.02em;color:#ffffff;text-wrap:balance}
  .nb-d{margin:0;font-size:15.5px;line-height:1.6;color:rgba(255,255,255,0.72);max-width:62ch}
  .granica{margin-top:clamp(34px,4vw,48px);display:grid;grid-template-columns:300px 1fr;gap:14px clamp(24px,3vw,52px)}
  .granica h3{margin:0;font-size:clamp(18px,1.9vw,22px);font-weight:750;letter-spacing:-0.02em;color:var(--la-accent,#00CD77);text-wrap:balance}
  .granica p{margin:0 0 14px;font-size:15.5px;line-height:1.6;color:rgba(255,255,255,0.72);max-width:62ch}
  .granica p:last-child{margin-bottom:0}
  .wroc{display:inline-flex;align-items:center;gap:9px;margin-top:clamp(34px,4vw,44px);background:var(--la-accent,#00CD77);color:#06170e;padding:16px 28px;border-radius:12px;font-weight:750;font-size:16px}

  /* ---------- S5 · DOWÓD ---------- */
  .dow{display:grid;grid-template-columns:300px 1fr;gap:clamp(32px,4vw,64px);align-items:start}
  .licz{display:flex;gap:34px;margin-top:22px}
  .licz-n{font-size:30px;font-weight:800;letter-spacing:-0.03em;color:#16211a}
  .licz-l{margin-top:2px;font-size:13px;color:#6d786f}
  .op-w{padding:22px 0;border-top:1px solid #e4ebe0}
  .op-w:last-child{border-bottom:1px solid #e4ebe0}
  .op-q{margin:0;font-size:clamp(16px,1.7vw,18.5px);line-height:1.55;color:#22302a;text-wrap:pretty}
  .op-kto{margin-top:11px;font-size:13.5px;color:#6d786f}
  .op-kto strong{font-weight:700;color:#16211a}

  /* ---------- S7 · DOMKNIĘCIE ---------- */
  .konc{max-width:760px;margin:0 auto;text-align:center}
  .konc h2{margin:0 auto;max-width:16ch}
  .konc .sub{margin:18px auto 0;max-width:50ch}
  .konc-form{margin-top:clamp(30px,3.6vw,42px);text-align:left}

  /* ---------- pasek CTA na mobile ---------- */
  .mob-cta{display:none}

  /* ---------- RESPONSYWNOŚĆ ---------- */
  @media (max-width:1080px){
    .mail-grid{grid-template-columns:1fr;gap:clamp(28px,4vw,40px)}
    .min-head{grid-template-columns:1fr;align-items:start;gap:18px}
    .nb-w,.granica,.dow{grid-template-columns:1fr;gap:10px}
    .dow{gap:26px}
  }
  @media (max-width:860px){
    /* Oś kładzie się pionowo: linia po lewej, etapy jeden pod drugim. */
    .os-lista{grid-template-columns:1fr;gap:0}
    .os-tor{left:7px;right:auto;top:0;bottom:0;width:1px;height:auto;background:linear-gradient(180deg,#d7e2d4 0%,#d7e2d4 82%,rgba(215,226,212,0) 100%);transform:scaleY(0);transform-origin:top;transition:transform 1s cubic-bezier(.4,0,.2,1)}
    .os.on .os-tor{transform:scaleY(1)}
    .os-etap{padding:0 0 26px 30px}
    .os-etap:last-child{padding-bottom:0}
    .os-kropka{position:absolute;left:0;top:3px}
    .os-kiedy{margin-top:0}
    .os-d{max-width:none}
    /* Pasek 30 minut: opisy pod paskiem przestają być kolumnami. */
    .pasek{height:44px}
    .pasek-seg span{font-size:11px}
    .pasek-opisy{display:block;margin-top:20px}
    .pasek-opis{display:grid;grid-template-columns:52px 1fr;gap:14px;width:auto !important;padding:12px 0;border-top:1px solid #dfe8db}
    .pasek-opis::before{content:attr(data-min);font-family:ui-monospace,Menlo,monospace;font-size:12px;font-weight:700;color:#0a7a52;padding-top:2px}
    .odczyt{max-width:none}
    .mob-cta{display:flex;align-items:center;gap:12px;position:fixed;left:0;right:0;bottom:0;z-index:70;padding:11px clamp(14px,4vw,20px) calc(11px + env(safe-area-inset-bottom));background:rgba(255,255,255,0.92);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-top:1px solid #e2eade;box-shadow:0 -10px 30px -18px rgba(18,38,28,0.4)}
    .mob-cta.hide{display:none}
    body{padding-bottom:74px}
  }
  @media (max-width:600px){
    .kop-wiersz{grid-template-columns:1fr;gap:5px}
    .licz{gap:24px}
  }
  @media (prefers-reduced-motion:reduce){
    .os-tor,.os-etap,.pasek-fill,.pasek-seg span,.faq-a,.faq-ico{transition:none}
    .os-tor{transform:none}
    .os-etap{opacity:1;transform:none}
    .pasek-fill{transform:scaleX(1)}
    .pasek-seg span{opacity:1}
  }
</style>

