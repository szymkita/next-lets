// ---- ROZKŁAD (dlaczego) ----
// Histogram „jak firmy z branży prowadzą tę samą sprawę" — poglądowy, nie
// z pomiaru. Szczyt na średniej rynku przesunięty w lewo, żeby prawy ogon
// był długi; tam stoi Wasz sposób pracy. Pasmo ±1,5 odchylenia to granice
// ustawień, które przewidział producent. Szum jest deterministyczny (ten sam
// przy każdym buildzie), żeby słupki nie układały się w gładki wzór.
const RZ = { n: 56, mu: 19, s: 5.2, wy: 46 };
const RZ_PASMO = [Math.round(RZ.mu - 1.5 * RZ.s), Math.round(RZ.mu + 1.5 * RZ.s)];
const rzSzum = (i) => { const x = Math.sin((i + 1) * 12.9898) * 43758.5453; return x - Math.floor(x); };
const RZ_SUROWE = Array.from({ length: RZ.n }, (_, i) => {
  const g = Math.exp(-0.5 * ((i - RZ.mu) / RZ.s) ** 2);
  const ogon = i > RZ.mu ? 0.1 * Math.exp(-(i - RZ.mu) / 15) : 0.04 * Math.exp(-(RZ.mu - i) / 5);
  return (g + ogon) * (0.86 + 0.28 * rzSzum(i));
});
const RZ_MAX = Math.max(...RZ_SUROWE);
const RZ_SLUPKI = RZ_SUROWE.map((v, i) => ({
  h: Math.max(0.025, v / RZ_MAX),
  pas: i >= RZ_PASMO[0] && i <= RZ_PASMO[1],
}));

