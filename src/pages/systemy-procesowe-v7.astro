<div class="kt-ramka kt-ta"><textarea class="kt-inp" id="kt-msg" name="wiadomosc" rows="3" placeholder="Np. od zapytania do oferty, przechodzi przez handel, technologa i magazyn…"></textarea></div>
</div>
