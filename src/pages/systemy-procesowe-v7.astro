</div>


<GcFaq
  heading="Pytania, które padają przed decyzją"
  ctaLabel="Zadajcie nam swoje →"
  items={faq}
/>

<script>
  var redukcja = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- Wejście w kadr: [data-anim] dostaje .on (krzywa, okna, schody, kafle) ----
  (function(){
    var els = document.querySelectorAll('.v3 [data-anim]');
    if(!els.length) return;
    if(redukcja || !('IntersectionObserver' in window)){
      els.forEach(function(el){ el.classList.add('on'); });
      return;
    }
    els.forEach(function(el){ if(/\b(v3-sch|v4-ts|v4-dw)\b/.test(el.className)) el.classList.add('gra'); });
    var io = new IntersectionObserver(function(wpisy){
      wpisy.forEach(function(w){
        if(w.isIntersecting){ w.target.classList.add('on'); io.unobserve(w.target); }
      });
    }, { threshold: 0.3 });
    els.forEach(function(el){ io.observe(el); });
  })();

  // ---- Rząd przykładów: strzałki przewijają o jedną kartę ----
  (function(){
    var sc = document.querySelector('[data-dw-sc]');
    if(!sc) return;
    var wstecz = document.querySelector('[data-dw-wstecz]');
    var dalej = document.querySelector('[data-dw-dalej]');
    function krok(){ var k = sc.querySelector('.dw4-k'); return k ? k.getBoundingClientRect().width + parseFloat(getComputedStyle(sc).columnGap || 0) : 320; }
    function stan(){
      var max = sc.scrollWidth - sc.clientWidth - 2;
      if(wstecz) wstecz.disabled = sc.scrollLeft <= 2;
      if(dalej) dalej.disabled = sc.scrollLeft >= max;
    }
    function jedz(kier){ sc.scrollBy({ left: kier * krok(), behavior: redukcja ? 'auto' : 'smooth' }); }
    if(wstecz) wstecz.addEventListener('click', function(){ jedz(-1); });
    if(dalej) dalej.addEventListener('click', function(){ jedz(1); });
    sc.addEventListener('scroll', stan, { passive: true });
    window.addEventListener('resize', stan);
    stan();
  })();

  // ---- Zakładki widoków systemu ----
  (function(){
    var zak = Array.prototype.slice.call(document.querySelectorAll('[data-zak]'));
    if(!zak.length) return;
    var widoki = document.querySelectorAll('[data-widok]');
    var podpisy = document.querySelectorAll('[data-podpis]');
    var nav = document.querySelectorAll('[data-nav]');
    var okruch = document.querySelector('[data-okruch]');
    function pokaz(i, fokus){
      zak.forEach(function(b, j){ b.setAttribute('aria-selected', i === j ? 'true' : 'false'); b.tabIndex = i === j ? 0 : -1; });
      widoki.forEach(function(w, j){ w.hidden = i !== j; });
      podpisy.forEach(function(p, j){ p.hidden = i !== j; });
      nav.forEach(function(n, j){ n.classList.toggle('on', i === j); });
      if(okruch) okruch.textContent = zak[i].textContent;
      if(fokus) zak[i].focus();
    }
    zak.forEach(function(b, i){
      b.addEventListener('click', function(){ pokaz(i); });
      b.addEventListener('keydown', function(e){
        if(e.key === 'ArrowRight'){ e.preventDefault(); pokaz((i + 1) % zak.length, true); }
        if(e.key === 'ArrowLeft'){ e.preventDefault(); pokaz((i - 1 + zak.length) % zak.length, true); }
      });
    });
  })();

  // ---- Formularz kontaktowy ----
  // Ta sama umowa z /api/kontakt co w GcCta: e-mail i telefon wymagane,
  // pole-pułapka na boty, 503 = formularz wyłączony (ponawianie nic nie da),
  // 502/inne = kanał odpadł (dane zostają w formularzu).
  // DO ZDARZEŃ (dataLayer) NIE WCHODZI TREŚĆ FORMULARZA ANI DANE KONTAKTOWE.
  (function(){
    var form = document.querySelector('[data-kt-form]');
    if(!form) return;
    var ENDPOINT = '/api/kontakt', MAIL = 'hello@letsautomate.pl';
    var karta = form.parentNode, okBox = karta.querySelector('[data-kt-ok]');
    var btn = form.querySelector('[data-kt-submit]'), etykieta = form.querySelector('[data-kt-label]');
    var zgoda = form.querySelector('[data-kt-zgoda]'), wierszZgody = form.querySelector('[data-kt-zgoda-row]');
    var awaria = form.querySelector('[data-kt-awaria]');
    var zrodlo = form.dataset.zrodlo || '';
    var wysylam = false, zaczety = false;
    function pomiar(nazwa, powod){
      var dane = { event: nazwa, usluga: zrodlo, strona: location.pathname };
      if(powod) dane.powod = powod;
      try {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push(dane);
        document.dispatchEvent(new CustomEvent('la:pomiar', { detail: dane }));
      } catch(e){}
    }
    document.addEventListener('click', function(e){
      var a = e.target && e.target.closest ? e.target.closest('a[href*="#kontakt"]') : null;
      if(a) pomiar('cta_klik');
    });
    var REGULY = [
      { pole: 'email', msg: 'Adres e-mail wygląda na niepełny.', ok: function(v){ return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v); } },
      { pole: 'telefon', msg: 'Numer telefonu ma za mało cyfr.', ok: function(v){ return v.replace(/\D/g, '').length >= 9; } }
    ];
    function pole(el){ return el && el.closest ? el.closest('.kt-pole') : null; }
    function blad(el, msg){ var f = pole(el); if(!f) return; f.classList.add('err'); el.setAttribute('aria-invalid', 'true'); f.querySelector('.kt-err').textContent = msg; }
    function dobrze(el){ var f = pole(el); if(!f) return; f.classList.remove('err'); el.removeAttribute('aria-invalid'); }
    function sprawdz(){
      var pierwszy = null;
      REGULY.forEach(function(r){
        var el = form.elements[r.pole], v = (el.value || '').trim();
        if(v && r.ok(v)) dobrze(el);
        else { blad(el, v ? r.msg : 'To pole jest wymagane.'); if(!pierwszy) pierwszy = el; }
      });
      wierszZgody.classList.toggle('err', !zgoda.checked);
      if(!zgoda.checked && !pierwszy) pierwszy = zgoda;
      return pierwszy;
    }
    form.addEventListener('input', function(e){
      if(pole(e.target)) dobrze(e.target);
      if(!zaczety){ zaczety = true; pomiar('formularz_start'); }
    });
    zgoda.addEventListener('change', function(){ wierszZgody.classList.toggle('err', !zgoda.checked); });
    function telefon(){ return (form.elements.kierunkowy.value + ' ' + (form.elements.telefon.value || '').trim()).trim(); }
    function opis(){ return (form.elements.wiadomosc.value || '').trim(); }
    function pokazOk(){
      var echo = okBox.querySelector('[data-kt-echo]'), mail = (form.elements.email.value || '').trim();
      if(echo && mail) echo.textContent = mail;
      pomiar('formularz_sukces');
      form.hidden = true;
      okBox.hidden = false;
      okBox.scrollIntoView({ block: 'nearest' });
      okBox.focus();
    }
    var AWARIE = {
      'brak-konfiguracji': ['Formularz jest chwilowo wyłączony.', 'Zgłoszenie nie zostało wysłane, a ponowna próba nic nie zmieni.'],
      'domyslna': ['Zgłoszenie nie doszło.', 'Wpisane dane zostały w formularzu — spróbujcie jeszcze raz za chwilę.']
    };
    function pokazAwarie(kod){
      pomiar('formularz_blad', kod || 'domyslna');
      var tr = AWARIE[kod] || AWARIE.domyslna;
      awaria.querySelector('[data-kt-awaria-t]').textContent = tr[0];
      awaria.querySelector('[data-kt-awaria-d]').textContent = tr[1];
      awaria.querySelector('[data-kt-mailto]').href = 'mailto:' + MAIL
        + '?subject=' + encodeURIComponent('Zapytanie ze strony — ' + zrodlo)
        + '&body=' + encodeURIComponent('E-mail: ' + (form.elements.email.value || '').trim() + '\nTelefon: ' + telefon() + '\n\n' + opis());
      awaria.hidden = false;
      awaria.scrollIntoView({ block: 'nearest' });
    }
    form.addEventListener('submit', function(e){
      e.preventDefault();
      if(wysylam) return;
      var zly = sprawdz();
      if(zly){ zly.focus(); return; }
      wysylam = true;
      btn.disabled = true;
      btn.classList.add('wysyla');
      var napis = etykieta.textContent;
      etykieta.textContent = 'Wysyłam…';
      awaria.hidden = true;
      fetch(ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({
          email: (form.elements.email.value || '').trim(),
          telefon: telefon(),
          wiadomosc: opis(),
          firma_www: form.elements.firma_www.value || '',
          zrodlo: zrodlo
        })
      })
        .then(function(r){
          if(r.ok){
            // Ptaszek na przycisku, a potwierdzenie chwilę później.
            btn.classList.remove('wysyla');
            btn.classList.add('wyslane');
            etykieta.textContent = 'Wysłane';
            return redukcja ? pokazOk() : setTimeout(pokazOk, 850);
          }
          return r.json().catch(function(){ return {}; }).then(function(j){ throw new Error(j.blad || 'domyslna'); });
        })
        .catch(function(err){
          wysylam = false;
          btn.disabled = false;
          btn.classList.remove('wysyla');
          etykieta.textContent = napis;
          pokazAwarie(err && err.message);
        });
    });
  })();
</script>
</LaBase>
