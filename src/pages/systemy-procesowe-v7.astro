// ---- OŚ CZASU SPRAWY (hero) --------------------------------------------
// Przykład: od zapytania klienta do wysłanej oferty. Kroki pracy są liczone
// w minutach, postoje w dniach roboczych (osiem godzin). Wszystkie szerokości
// i wszystkie czasy animacji wynikają z tej jednej tablicy.
//
// UWAGA techniczna: paski pracy mają min-width 3 px, więc przy tej skali
// zabierają około trzech procent szerokości ponad swój udział. Bez tego
// byłyby niewidoczne — a to one są pointą rysunku.
const GODZ_DNIA = 8;
const KROKI = [
  { p: true, min: 12, t: 'Handlowiec zakłada sprawę', k: 'zakłada sprawę' },
  { p: false, dni: 2, t: 'Czeka na wycenę technologa', k: 'czeka na wycenę' },
  { p: true, min: 24, t: 'Technolog liczy koszt', k: 'liczy koszt' },
  { p: false, dni: 1.5, t: 'Czeka na dostępność z magazynu', k: 'czeka na magazyn' },
  { p: true, min: 18, t: 'Przepisanie do arkusza i złożenie oferty', k: 'przepisuje do arkusza' },
  { p: false, dni: 2.5, t: 'Czeka na akceptację marży', k: 'czeka na akceptację' },
  { p: true, min: 6, t: 'Wysyłka do klienta', k: 'wysyła' },
];
const kd = (x) => (x.p ? x.min / 60 / GODZ_DNIA : x.dni);   // długość kroku w dniach
const DZIS_DNI = KROKI.reduce((a, x) => a + kd(x), 0);       // 6,125 dnia
const PRACA_MIN = KROKI.filter((x) => x.p).reduce((a, x) => a + x.min, 0);   // 60
const PO_GODZ = 4;
const PO_DNI = PO_GODZ / GODZ_DNIA;
// Odmiana po liczbie: 2-4 biora forme mnoga, ulamki i reszta pojedyncza.
const dniOpis = (d) => (Number.isInteger(d) && d >= 2 && d <= 4 ? d + ' dni' : String(d).replace('.', ',') + ' dnia');
const PRACA_PO_MIN = 42;   // znika przepisywanie do arkusza
const UDZIAL_PO = PO_DNI / DZIS_DNI;



