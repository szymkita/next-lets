<LuSkrypty />

<script>
  var shRedukcja = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var shMa = 'IntersectionObserver' in window;
  function shLista(root: ParentNode, sel: string){ return Array.prototype.slice.call(root.querySelectorAll(sel)) as HTMLElement[]; }
  // Treść odłożona w <template> trafia na swoje miejsce (raz).
  function shWstaw(t: Element | null){
    if(!t) return;
    t.replaceWith(document.importNode((t as HTMLTemplateElement).content, true));
  }

  // ---- SZYTE NA MIARĘ: etapy płótna 0 → 5, kiedy zakładka jest w kadrze ----
  // Rusza za każdym razem, gdy slajd staje się widoczny (także po kliknięciu
  // zakładki). Bez JS i przy ograniczonym ruchu: stan końcowy z HTML.
  // Płótno stoi w <template> zakładki 5, więc start po jego wstawieniu.
  function shSzyte(){
    var sz = document.querySelector('[data-sz]') as HTMLElement | null;
    if(!sz || shRedukcja || !shMa) return;
    var t: number[] = [];
    function czysc(){ t.forEach(function(x){ clearTimeout(x); }); t = []; }
    function graj(){
      czysc();
      sz!.classList.add('bez'); sz!.dataset.st = '0'; void sz!.offsetWidth; sz!.classList.remove('bez');
      [1, 2, 3, 4, 5].forEach(function(n, i){ t.push(window.setTimeout(function(){ sz!.dataset.st = String(n); }, 600 + i * 1500)); });
    }
    new IntersectionObserver(function(e){
      if(e[0].isIntersecting) graj(); else czysc();
    }, { threshold: 0.6 }).observe(sz);
  }

  // ---- CO MOŻEMY DLA WAS ZBUDOWAĆ: zakładki odłożone do pierwszego wyboru ----
  // Zakładka 1 (system Armatura) to kopia okna z hero, wstawiana, zanim
  // sekcja wejdzie w kadr. Zakładki 3–5 czekają w <template> do pierwszego
  // ruchu w pokazie: klik w zakładkę albo strzałkę, klawiatura, dotyk,
  // gest w bok, przewinięcie toru. Nasłuch w fazie przechwytywania, więc
  // treść jest na miejscu, zanim LuSkrypty przesunie tor.
  (function(){
    var sek = document.getElementById('zbudowac');
    if(!sek) return;
    var cel = sek.querySelector('[data-sh-sys]') as HTMLElement | null;
    var jest0 = false, jestReszta = false;
    function system(){
      if(jest0 || !cel) return;
      jest0 = true;
      var wz = document.querySelector('.shb-sys > .sa');
      if(wz) cel.appendChild(wz.cloneNode(true));
    }
    function wszystko(){
      system();
      if(jestReszta) return;
      jestReszta = true;
      shLista(sek!, 'template[data-sh-bu-t]').forEach(shWstaw);
      shSzyte();
    }
    if(!shMa){ wszystko(); return; }
    var io = new IntersectionObserver(function(e){
      if(e[0].isIntersecting){ io.disconnect(); system(); }
    }, { rootMargin: '100% 0px 100% 0px' });
    io.observe(sek);
    ['click', 'pointerdown', 'touchstart', 'keydown', 'focusin'].forEach(function(t){
      sek!.addEventListener(t, wszystko, { capture: true, passive: true });
    });
    sek.addEventListener('wheel', function(e){ if(Math.abs((e as WheelEvent).deltaX) > Math.abs((e as WheelEvent).deltaY)) wszystko(); }, { capture: true, passive: true });
    var tor = sek.querySelector('[data-u3a-tor]');
    if(tor) tor.addEventListener('scroll', wszystko, { passive: true });
  })();

  // ---- CO ROBIMY: sceny kart czekają w <template> i trafiają na miejsce,
  // zanim sekcja wejdzie w kadr (karty mają stałą wysokość, więc nic się
  // nie przesuwa).
  (function(){
    var sek = document.getElementById('program');
    if(!sek) return;
    function wstaw(){ shLista(sek!, 'template[data-sh-pr-t]').forEach(shWstaw); }
    if(!shMa){ wstaw(); return; }
    var io = new IntersectionObserver(function(e){
      if(e[0].isIntersecting){ io.disconnect(); wstaw(); }
    }, { rootMargin: '100% 0px 100% 0px' });
    io.observe(sek);
  })();

  // ---- CO ROBIMY: poprzednia karta cofa się, kiedy nachodzi następna ----
  // (jak LuSkrypty, ale już od 620 px wysokości okna)
  (function(){
    var st = document.querySelector('.sh-pr [data-u4p]') as HTMLElement | null;
    if(!st || shRedukcja) return;
    var k = Array.prototype.slice.call(st.querySelectorAll('.u4p-k')) as HTMLElement[];
    var mq = window.matchMedia('(min-width:1000px) and (min-height:620px)');
    var czeka = false;
    function licz(){
      czeka = false;
      for(var i = 0; i < k.length; i++){
        if(!mq.matches || i === k.length - 1){ k[i].style.removeProperty('--ss'); k[i].style.removeProperty('--oo'); continue; }
        var a = k[i].getBoundingClientRect(), b = k[i + 1].getBoundingClientRect();
        var pr = Math.max(0, Math.min(1, (a.bottom - b.top) / a.height));
        k[i].style.setProperty('--ss', String(1 - pr * 0.05));
        k[i].style.setProperty('--oo', String(pr * 0.5));
      }
    }
    function pros(){ if(!czeka){ czeka = true; requestAnimationFrame(licz); } }
    window.addEventListener('scroll', pros, { passive: true });
    window.addEventListener('resize', pros);
    pros();
  })();

  // ---- JEDNA SPRAWA: przełącznik firm i krok w środku ekranu ----
  // Każda firma ma własny rysunek i kroki. Firmy 2 i 3 czekają w <template>
  // do pierwszego kliknięcia zakładki; panele kroków 2–6 pierwszej firmy
  // trafiają na miejsce, zanim sekcja wejdzie w kadr. Obserwator kroków
  // działa tylko na wstawionych firmach (ukryte nie przecinają środka).
  // Na telefonie panele „Dziś / Po zmianie” stoją przy swoim kroku, pod
  // jego tekstem; na szerokim ekranie wracają do rysunku.
  (function(){
    var sek = document.querySelector('.sh-z') as HTMLElement | null;
    if(!sek) return;
    var sx = shLista(sek, '[data-sh-sx]');
    if(!sx.length) return;
    var zak = shLista(sek, '[data-sh-sx-zak]');
    var mq = window.matchMedia('(max-width:900px)');
    var gotowe: HTMLElement[] = [];
    var io = shMa ? new IntersectionObserver(function(e){
      e.forEach(function(x){
        if(!x.isIntersecting) return;
        var k = x.target as HTMLElement, p = k.closest('[data-sh-sx]') as HTMLElement;
        (p.querySelector('[data-shz]') as HTMLElement).dataset.krok = k.dataset.shzK || '0';
        shLista(p, '[data-shz-k]').forEach(function(y){ y.classList.toggle('on', y === k); });
      });
    }, { rootMargin: '-45% 0px -45% 0px' }) : null;
    function ustaw(){
      sek!.classList.toggle('sh-z-mob', mq.matches);
      gotowe.forEach(function(p){
        var st = p.querySelector('.sh-z-st') as HTMLElement | null;
        if(!st) return;
        var kroki = shLista(p, '[data-shz-k]');
        var panele = shLista(p, '.sh-z-s').sort(function(a, b){ return nr(a) - nr(b); });
        panele.forEach(function(el){
          var krok = kroki[nr(el)];
          if(!krok) return;
          var tekst = krok.firstElementChild as HTMLElement;
          if(mq.matches){
            krok.after(el);
            var cta = tekst.querySelector('.u6-mc');
            if(cta) el.after(cta);
          } else {
            var c2 = el.nextElementSibling;
            st!.appendChild(el);
            if(c2 && c2.classList.contains('u6-mc')) tekst.appendChild(c2);
          }
        });
      });
    }
    function nr(el: Element){ var m = /sh-z-s(\d+)/.exec(el.className); return m ? Number(m[1]) : 0; }
    function wypelnij(p: HTMLElement){
      shWstaw(p.querySelector(':scope > template[data-sh-sx-t]'));
      shWstaw(p.querySelector('template[data-shz-t]'));
      if(gotowe.indexOf(p) < 0){
        gotowe.push(p);
        if(io) shLista(p, '[data-shz-k]').forEach(function(k){ io!.observe(k); });
      }
      ustaw();
    }
    zak.forEach(function(b, i){
      b.addEventListener('click', function(){
        wypelnij(sx[i]);
        sx.forEach(function(p, j){ p.hidden = j !== i; });
        zak.forEach(function(z, j){ z.setAttribute('aria-selected', j === i ? 'true' : 'false'); });
        var w = sx[i].querySelector('[data-shz]') as HTMLElement;
        w.dataset.krok = '0';
        shLista(sx[i], '[data-shz-k]').forEach(function(k, j){ k.classList.toggle('on', j === 0); });
        var g = zak[0].parentElement!.getBoundingClientRect();
        if(g.top < 0) window.scrollTo({ top: window.scrollY + g.top - 110, behavior: 'instant' as ScrollBehavior });
      });
    });
    // Pierwsza firma: kroki i panel 1 od startu, panele 2–6 przed kadrem.
    gotowe.push(sx[0]);
    if(io) shLista(sx[0], '[data-shz-k]').forEach(function(k){ io!.observe(k); });
    ustaw();
    mq.addEventListener('change', ustaw);
    if(!shMa){ wypelnij(sx[0]); return; }
    var blisko = new IntersectionObserver(function(e){
      if(e[0].isIntersecting){ blisko.disconnect(); wypelnij(sx[0]); }
    }, { rootMargin: '100% 0px 100% 0px' });
    blisko.observe(sek);
  })();
</script>
</LaBase>
