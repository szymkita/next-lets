      linear-gradient(rgba(170,230,220,0.1) 1px,transparent 1px) 0 0/100px 100px,linear-gradient(90deg,rgba(170,230,220,0.1) 1px,transparent 1px) 0 0/100px 100px,radial-gradient(600px 400px at 80% 0%,rgba(0,205,119,0.16),transparent 70%),#0f2b33}
