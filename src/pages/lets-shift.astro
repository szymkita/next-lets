  /* =====================================================================
     8 · EKSPERTYZA PO NASZEJ STRONIE, DECYZJE PO WASZEJ: wzór #zespol
     z /dlaczego-my-v11 (.dm7-lu, .dm7-lk, .dm7-lu-st) 1:1 z przedrostkiem
     sh-: pięć portretów schodkowo, czerń-biel z zielonym tonem, kolor po
     najechaniu; pod spodem jedna wstęga z sygnetem
     ===================================================================== */
  /* zwarta wersja (Szymon: „strasznie wysoka, 4 wiersze nagłówka, wysokie
     zdjęcia”): nagłówek mniejszym stopniem na szerokość dwóch wierszy,
     portrety niższe, schodek i odstępy mniejsze */
  @media (min-width:901px){ #zespol .v8-gl{grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);align-items:end} }
  #zespol .u2-h2{font-size:clamp(34px,4.2vw,64px);line-height:1}
  #zespol .v8-gl .v3-sub{font-size:clamp(15px,1.15vw,17px)}
  .sh-lu{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:clamp(10px,1.2vw,18px);align-items:start;margin-top:clamp(32px,3.4vw,52px)}
  .sh-lk{position:relative;overflow:hidden;margin:0;aspect-ratio:1 / 1.25;border-radius:20px;background:#12261b;box-shadow:0 30px 60px -40px rgba(15,26,20,0.6)}
