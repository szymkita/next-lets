    .sh-lk.duch{display:block;aspect-ratio:auto;height:calc(var(--u) * 1.25);margin-top:clamp(18px,2vw,30px);pointer-events:none;box-shadow:none}
    .sh-lk.duch.l{-webkit-mask-image:linear-gradient(90deg,transparent 0%,rgba(0,0,0,0.85) 75%);mask-image:linear-gradient(90deg,transparent 0%,rgba(0,0,0,0.85) 75%)}
    .sh-lk.duch.p{-webkit-mask-image:linear-gradient(270deg,transparent 0%,rgba(0,0,0,0.85) 75%);mask-image:linear-gradient(270deg,transparent 0%,rgba(0,0,0,0.85) 75%)}
    .sh-lk.duch img{filter:grayscale(1) contrast(1.1) blur(3.5px) brightness(0.58);transform:scale(1.32);object-position:50% 38%}
    .sh-lk.duch::after{opacity:0.55}
    .sh-lk.duch.l img{object-position:62% 38%}
    .sh-lk.duch.p img{object-position:38% 38%}
    .sh-lk:not(.duch):nth-child(odd){margin-top:clamp(18px,2vw,30px)}
    .sh-lk:not(.duch):nth-child(even){margin-top:0}
