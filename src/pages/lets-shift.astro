  /* tło każdego zdjęcia przechodzi u góry w ciemną zieleń studia, więc jasne
     i ciemne tła portretów wyglądają jak z jednej sesji */
  .sh-lk::before{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;
    background:linear-gradient(180deg,rgba(7,20,13,0.78) 0%,rgba(7,20,13,0.28) 22%,rgba(7,20,13,0) 40%),radial-gradient(120% 60% at 50% 0%,rgba(0,205,119,0.16),rgba(0,205,119,0) 60%);
    mix-blend-mode:normal;transition:opacity .5s}
  .sh-lk::after{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;background:#0f2a1d;mix-blend-mode:color;opacity:0.35;transition:opacity .5s}
  .sh-lk:hover::after{opacity:0}
  .sh-lk figcaption{z-index:2}
  .sh-lk figcaption{position:absolute;left:0;right:0;bottom:0;padding:clamp(60px,6vw,90px) clamp(14px,1.4vw,20px) clamp(14px,1.4vw,18px);background:linear-gradient(180deg,rgba(7,20,13,0),rgba(7,20,13,0.62) 34%,rgba(7,20,13,0.95) 76%)}
  .sh-lk b{display:block;font-size:clamp(15px,1.3vw,18px);font-weight:700;letter-spacing:-0.02em;line-height:1.2;color:#ffffff;text-wrap:pretty}
  .sh-lk small{display:block;min-height:0;margin-top:4px;font-size:12.5px;line-height:1.3;color:rgba(255,255,255,0.62);text-wrap:pretty}
  .sh-lu-st{display:flex;align-items:center;gap:12px;margin-top:clamp(22px,2.4vw,34px);padding:16px 20px;border-radius:18px;background:var(--ink);color:#ffffff;font-size:15px;line-height:1.45}
