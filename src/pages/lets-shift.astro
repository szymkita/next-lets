  .sh-lk:hover img{filter:grayscale(0.15) contrast(1.04) brightness(0.98)}
  /* rozmyte osoby na krańcach: rząd na całą szerokość okna, siedem kolumn,
     skrajne karty wysunięte za krawędź, rozmyte i wygaszone ku zewnątrz */
  .sh-lk.duch{display:none}
  /* ODSTĘPY MIĘDZY SEKCJAMI (26.10.2026, pomiar w 1440): sekcje .v3-sek
     mają po ok. 158 px u góry i u dołu. Przy zmianie tła to dobrze dzieli
     bloki, ale na ciągłym papierze (od „Ekspertyzy” do „Dla kogo”) dwa
     odstępy sumowały się do 306–341 px pustki. Następna sekcja na tym
     samym tle zaczyna się więc bliżej (razem ok. 200 px, jak na stronie
     głównej), a za stosem kart przed zielonym pasem odstęp jest mniejszy
     (było 368 px). */
  html body .v3-sek.v3-papier + .v3-sek.v3-papier{padding-top:clamp(24px,3vw,44px)}
  html body #program{padding-bottom:clamp(56px,6vw,88px)}
  html body #czym-jest{padding-bottom:clamp(56px,6vw,88px)}
  /* zielony pas między kartami programu a „Co możemy zbudować”: ramka
     na tym samym papierze co sąsiednie sekcje (była biała) */
  html body #program + .v3-zl{background:var(--papier)}
  html body .sh-pr .u4p-st{padding-bottom:0}
