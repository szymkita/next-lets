// ---- FAQ ------------------------------------------------------------------------
const faq = [
  { q: 'Nie mamy działu IT ani doświadczenia z AI. Czy to dla nas?',
    a: 'Tak. Program prowadzi jeden prowadzący po naszej stronie, a nasz zespół robi analizę, projekt, wdrożenia i dokumentację. Po stronie firmy potrzebny jest sponsor w zarządzie i właściciel każdego etapu, który zna swój dział. Osoby z działu szkolimy na ich własnych zadaniach, a prowadzący co tydzień mówi, co trzeba przygotować po stronie firmy.' },
  { q: 'Czy musimy wymienić ERP?',
    a: 'Nie ma takiego założenia. O każdym systemie decydujemy na mapie i zapisujemy powód tej decyzji. U producenta armatury z tej strony ERP z 2009 r. zostaje jako księga firmy, a łączymy go z nowymi systemami. Każdą wymianę zatwierdza zarząd razem z planem etapów.' },
  { q: 'Ile trwa program?',
    a: 'Mapa trwa sześć tygodni. Liczba i długość etapów wynikają z mapy: u producenta armatury z tej strony to trzy etapy po dwa kwartały. Plan etapów z kosztami dostajecie po mapie, zanim zdecydujecie o pierwszym etapie.' },
  { q: 'Czy firma zatrzyma się na czas zmian?',
    a: 'Nie. Każdy etap obejmuje jeden obszar firmy, a nowy system przez kilka tygodni pracuje obok starego. Stary wyłączamy, kiedy zespół pracuje już w nowym.' },
  { q: 'Czy możemy zakończyć po mapie albo po pierwszym etapie?',
    a: 'Tak. Po mapie zostaje u Was spis systemów z decyzjami, plan firmy po zmianie i plan etapów z kosztami. O każdym kolejnym etapie decyduje zarząd na przeglądzie po poprzednim.' },
  { q: 'Kto jest właścicielem kodu i danych?',
    a: 'Wy. Konta projektu, od repozytorium po klucze do modeli AI, zakładamy na Waszą firmę, a my dostajemy do nich dostęp imiennie. Kiedy współpraca się kończy, odbieracie nam te dostępy i nie potrzebujecie od nas żadnej licencji.' },
  { q: 'Co z ludźmi, których praca się zmieni?',
    a: 'Osoby, które dziś przenoszą dane między systemami, najlepiej znają wyjątki i zasady firmy, więc w nowym układzie zajmują się właśnie nimi. Nowe role opisujemy w planie każdego etapu, a szkolenia prowadzimy na zadaniach działu.' },
  { q: 'Czym Let’s Shift różni się od strategii AI i od Let’s Up?',
    a: 'Strategia AI to trzy tygodnie, po których zarząd wie, od czego zacząć i ile to zwróci. Let’s Up to program dla mikro- i małych firm, którym przybywa pracy, prowadzony wokół jednego ograniczenia. Let’s Shift przechodzi przez wszystkie systemy firmy w kolejnych etapach.' },
  { q: 'Czy musimy korzystać z Appto?',
    a: 'Nie. Appto to nasz produkt i jedna z możliwości dla asystentów AI w firmie. Projektujemy też własne systemy i wdrażamy AI w narzędziach, które już macie.' },
  { q: 'Jak liczycie koszt?',
    a: 'Mapa ma stałą cenę znaną przed startem. Każdy kolejny etap ma stałą cenę, którą podajemy po mapie, zanim go zamówicie. Utrzymanie i rozwój po programie rozliczamy miesięcznie. Licencje i utrzymanie nowych systemów są osobno, w planie kosztów, razem z kosztami systemów, które wyłączamy.' },
];

const dane = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${kanon}#usluga`,
      name: 'Let’s Shift',
      alternateName: ['Program Let’s Shift', 'Program transformacji dla małych, średnich i dużych firm'],
      serviceType: 'Program transformacji firmy na systemy z czasów AI, prowadzony etapami',
      url: kanon,
      description: 'Program dla firm z wypracowanym sposobem działania: mapa wszystkich systemów z decyzją przy każdym (zostaje, łączymy, wymieniamy, wyłączamy), plan firmy po zmianie, wdrożenia etapami dział po dziale z pracą równoległą, nowe role zespołu i przegląd zarządu co kwartał.',
      provider: { '@id': new URL('/#organizacja', Astro.site).href },
      areaServed: { '@type': 'Country', name: 'Polska' },
      audience: { '@type': 'BusinessAudience', name: 'Małe, średnie i duże firmy' },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${kanon}#okruszki`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Strona główna', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: 'Let’s Shift', item: kanon },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${kanon}#faq`,
      mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })),
    },
  ],
};

const title = "Let’s Shift — program transformacji dla małych, średnich i dużych firm | Let's automate";
const description = 'Let’s Shift przenosi firmę z wypracowanym sposobem działania na systemy z czasów AI. Przy każdym systemie decydujemy, czy zostaje, łączymy go, wymieniamy czy wyłączamy, a zmiany wdrażamy etapami, dział po dziale.';
---
<LaBase topbar={false} title={title} description={description} ctaLabel="Umów rozmowę" nav="uslugi">
<script type="application/ld+json" is:inline set:html={JSON.stringify(dane)} slot="head"></script>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=Inter:wght@400;500;600;700&display=swap" slot="head">

<ShiftStyl />
<style is:global>
  /* Rysunki tej strony, przedrostek sh-. Wspólny wygląd: Styl.astro
     (usługi) i LuStyl.astro (Let’s Up). Kolory decyzji: jedno źródło
     niżej, na jasnym (--d) i na ciemnym tle (--dj). */
  .sh{--d-zo:#5d6862;--d-la:#127f93;--d-wy:#0a7a52;--d-wl:#a8650f;
    --dj-zo:#b6c1bb;--dj-la:#5ccfe0;--dj-wy:#00CD77;--dj-wl:#f0a33a;
    --sh-ez:cubic-bezier(.55,0,.2,1);--olowek:'Caveat',cursive}
  .sh-dzo{--d:var(--d-zo);--dj:var(--dj-zo)}
  .sh-dla{--d:var(--d-la);--dj:var(--dj-la)}
  .sh-dwy{--d:var(--d-wy);--dj:var(--dj-wy)}
  .sh-dwl{--d:var(--d-wl);--dj:var(--dj-wl)}

  /* pieczątka: małe litery, kolor decyzji, ramka jak odbita tuszem */
  .sh-pc{display:inline-block;padding:1px 7px 2px;border:1.5px solid var(--d);border-radius:5px;background:color-mix(in srgb,var(--d) 7%,#ffffff);
    font-style:normal;font-size:12px;font-weight:700;line-height:1.25;letter-spacing:0.01em;color:var(--d);white-space:nowrap;transform:rotate(-3deg)}

  /* =====================================================================
     3 · SYSTEMY ZBIERANE LATAMI: spis z natury na podkładce
     ===================================================================== */
  .sh-s-g{display:grid;grid-template-columns:minmax(0,5.2fr) minmax(0,6.8fr);gap:clamp(40px,6vw,110px);align-items:center}
  .sh-s-teza{margin:clamp(28px,3vw,44px) 0 0;max-width:560px;font-size:clamp(22px,2.1vw,32px);line-height:1.22;letter-spacing:-0.03em;font-weight:600;color:var(--t1);text-wrap:pretty}
  .sh-s-teza em{font-style:normal;color:var(--ziel-c)}
  .sh-s-pod{position:relative;margin:0;padding:34px 22px 22px;border-radius:18px;transform:rotate(1.2deg);
    background:linear-gradient(160deg,#c9a57c,#b78f63 60%,#a98258);box-shadow:inset 0 0 0 1px rgba(0,0,0,0.08),inset 0 2px 0 rgba(255,255,255,0.25),0 50px 80px -40px rgba(15,26,20,0.55),0 20px 30px -20px rgba(15,26,20,0.3)}
  .sh-s-kl{position:absolute;left:50%;top:-16px;width:150px;height:46px;transform:translateX(-50%);border-radius:10px 10px 14px 14px;
    background:linear-gradient(180deg,#e9ecea,#aab1ad 55%,#8d9490);box-shadow:0 6px 10px -4px rgba(0,0,0,0.35),inset 0 1px 0 rgba(255,255,255,0.8)}
  .sh-s-kl::after{content:"";position:absolute;left:50%;top:9px;width:34px;height:10px;transform:translateX(-50%);border-radius:6px;background:#6d7470;box-shadow:inset 0 2px 3px rgba(0,0,0,0.4)}
  .sh-s-k{padding:30px 28px 22px;border-radius:4px;background:#fffefa;box-shadow:0 2px 6px rgba(0,0,0,0.12)}
  .sh-s-k header{display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:4px 16px;padding-bottom:12px;border-bottom:1.5px solid var(--t1)}
  .sh-s-k header b{font-size:19px;font-weight:750;letter-spacing:-0.02em}
  .sh-s-k header span{font-size:12.5px;color:var(--t3)}
  .sh-s-kol,.sh-s-k li{display:grid;grid-template-columns:1.9em minmax(0,1fr) 3.4em minmax(0,1.15fr);gap:12px;align-items:baseline}
  .sh-s-kol{padding:9px 0 6px;font-size:11.5px;font-weight:650;color:var(--t3)}
  .sh-s-k ol{margin:0;padding:0;list-style:none}
  .sh-s-k li{padding:9px 0 8px;border-top:1px solid rgba(15,26,20,0.1);font-size:14.5px;line-height:1.3}
  .sh-s-k li em{font-style:normal;font-size:12px;color:var(--t3);font-variant-numeric:tabular-nums}
  .sh-s-k li b{font-weight:650}
  .sh-s-k li span{font-family:var(--mono);font-size:12.5px;color:var(--t2)}
  .sh-s-k li i{font-family:var(--olowek);font-style:normal;font-size:20px;font-weight:500;line-height:1.05;color:#4f5551;transform:rotate(-1.2deg);transform-origin:0 50%}
  .sh-s-k footer{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;margin-top:10px;padding-top:12px;border-top:1px solid rgba(15,26,20,0.1);font-size:12px;color:var(--t3)}
  .sh-s-k footer i{font-family:var(--olowek);font-style:normal;font-size:22px;color:#4f5551}
  @media (max-width:1000px){ .sh-s-g{grid-template-columns:1fr} .sh-s-pod{transform:none} }
  @media (max-width:600px){
    .sh-s-pod{padding:30px 10px 10px}
    .sh-s-k{padding:22px 14px 16px}
    .sh-s-kol{display:none}
    .sh-s-k li{grid-template-columns:1.6em minmax(0,1fr) auto;gap:4px 8px}
    .sh-s-k li i{grid-column:2 / -1;font-size:19px}
  }

  /* =====================================================================
     4 · CZYM JEST LET’S SHIFT? odpowiedź i dokument „Program w skrócie”
     ===================================================================== */
  .sh-cz-g{display:grid;grid-template-columns:minmax(0,5.6fr) minmax(0,6.4fr);gap:clamp(40px,6vw,110px);align-items:start}
  .sh-cz-odp{margin:clamp(28px,3vw,44px) 0 0;max-width:600px;font-size:clamp(20px,1.75vw,25px);line-height:1.45;letter-spacing:-0.015em;color:var(--t1);text-wrap:pretty}
  .sh-cz-dok{position:relative;margin:0;padding:10px 0 20px}
  .sh-cz-tyl{position:absolute;left:5%;right:-2%;top:22px;bottom:6px;border-radius:6px;background:#fbfaf6;transform:rotate(2.2deg);box-shadow:0 0 0 1px rgba(15,26,20,0.06),0 20px 40px -30px rgba(15,26,20,0.4)}
  .sh-cz-k{position:relative;padding:clamp(26px,3vw,44px) clamp(24px,3vw,48px) clamp(22px,2.4vw,34px);border-radius:6px;background:#ffffff;transform:rotate(-0.6deg);
    box-shadow:0 0 0 1px rgba(15,26,20,0.06),0 50px 80px -50px rgba(15,26,20,0.5),0 16px 30px -24px rgba(15,26,20,0.3)}
  .sh-cz-k header{display:flex;justify-content:space-between;align-items:center;gap:12px;padding-bottom:14px;border-bottom:1px solid var(--linia)}
  .sh-cz-k header .lg{display:flex;align-items:center;gap:9px}
  .sh-cz-k header svg{width:22px;height:22px;fill:var(--ziel-c)}
  .sh-cz-k header b{font-size:17px;font-weight:800;letter-spacing:-0.025em}
  .sh-cz-k header > span:last-child{font-size:12.5px;color:var(--t3)}
  .sh-cz-k h3{margin:22px 0 0;font-size:clamp(26px,2.4vw,36px);font-weight:700;letter-spacing:-0.04em;line-height:1.05}
  .sh-cz-os{position:relative;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));margin:22px 0 6px;padding:0;list-style:none}
  .sh-cz-os::before{content:"";position:absolute;left:6px;right:20%;top:6px;height:2px;background:linear-gradient(90deg,var(--ziel-c) 0 20%,rgba(10,122,82,0.35) 20% 100%)}
  .sh-cz-os li{position:relative;padding-top:22px;font-size:14px;line-height:1.25}
  .sh-cz-os li::before{content:"";position:absolute;left:0;top:0;width:14px;height:14px;border-radius:50%;background:#ffffff;box-shadow:inset 0 0 0 2px var(--ziel-c)}
  .sh-cz-os li:first-child::before{background:var(--ziel-c)}
  .sh-cz-os li:last-child::before{box-shadow:inset 0 0 0 2px var(--t3)}
  .sh-cz-os b{display:block;font-weight:700}
  .sh-cz-os small{display:block;margin-top:2px;font-size:12.5px;color:var(--t3)}
  .sh-cz-k dl{margin:18px 0 0}
  .sh-cz-k dl > div{display:grid;grid-template-columns:8.6em minmax(0,1fr);gap:4px 20px;padding:13px 0;border-top:1px solid var(--linia2)}
  .sh-cz-k dt{padding-top:1px;font-size:13.5px;font-weight:700;color:var(--ziel-c)}
  .sh-cz-k dd{margin:0;font-size:15.5px;line-height:1.5;color:var(--t1)}
  .sh-cz-k footer{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin-top:10px;padding-top:16px;border-top:1px solid var(--linia)}
  .sh-cz-k .pd i{display:block;font-family:var(--olowek);font-style:normal;font-size:30px;font-weight:600;line-height:1;color:#25358a;transform:rotate(-3deg);transform-origin:0 100%}
  .sh-cz-k .pd small{display:block;margin-top:4px;padding-top:4px;border-top:1px solid var(--linia);font-size:12.5px;color:var(--t3)}
  .sh-cz-k .dt{font-size:12.5px;color:var(--t3)}
  @media (max-width:1000px){ .sh-cz-g{grid-template-columns:1fr} }
  @media (max-width:600px){
    .sh-cz-tyl{display:none}
    .sh-cz-k{transform:none;padding:22px 18px 18px}
    .sh-cz-os li{font-size:12px}
    .sh-cz-os small{display:none}
    .sh-cz-k dl > div{grid-template-columns:1fr;gap:2px}
    .sh-cz-k footer{flex-direction:column;align-items:flex-start}
  }

  /* =====================================================================
     5 · JEDNA SPRAWA, DZIŚ I PO PROGRAMIE (.sh-z-, .sh-sx-, .sh-zw): opowieść
     przyklejona do przewijania z przełącznikiem trzech przykładów; wycinki
     w stylach hero (klasy shb-* z HeroB i system firmy .sh-zw.sys, --u = 1px)
