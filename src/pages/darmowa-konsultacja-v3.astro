<!-- ============ S2 · CO SIĘ DZIEJE PO WYSŁANIU ============ -->
<section id="co-dalej" class="sek">
<h2 class="h-sec" style="margin:0;max-width:18ch">Co się dzieje po wysłaniu formularza</h2>
<p class="lead-sek">Zgłoszenie trafia prosto do nas — nie ma kolejki ani systemu ticketowego.</p>

<div class="sciezka">
{KROKI.map((k, i) => (
  <div class={k.mocny ? 'kro mocny' : 'kro'}>
