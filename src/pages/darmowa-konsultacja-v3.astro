    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={g.ico}></svg>
    <span>{g.t}</span>
  </div>
))}
</div>
</div>

<p class="zg-alt">Wolisz napisać? <a href={`mailto:${KONTAKT_MAIL}`} class="lnk-green">{KONTAKT_MAIL}</a> · <a href={TEL_HREF} class="lnk-green" style="white-space:nowrap">{KONTAKT_TEL}</a></p>
