<svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .3 1.9.6 2.8a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.5 2.8.6a2 2 0 0 1 1.7 2z"/></svg>
<span>Sprawa pilna? Zadzwoń: <a href={TEL_HREF} class="lnk-green">{KONTAKT_TEL}</a></span>
</div>
</section>

<!-- ============ S3 · CO ZYSKUJESZ ============ -->
<section id="co-zyskujesz" class="sek sek-tlo">
<div class="kor-grid">
<div class="kor-naglowek">
<h2 class="h-sec" style="margin:0;max-width:16ch">Co zostaje u Ciebie po konsultacji</h2>
<p class="lead-sek" style="margin-bottom:clamp(26px,3vw,34px)">Trzy rzeczy — także wtedy, gdy nie zaczniemy współpracy.</p>
