<script is:inline>
(()=>{
const cl=(x,a=0,b=1)=>Math.min(b,Math.max(a,x)), seg=(p,a,b)=>cl((p-a)/(b-a)), eo=t=>1-Math.pow(1-t,3);
const $=(s,r=document)=>r.querySelector(s), $$=(s,r=document)=>[...r.querySelectorAll(s)];
const qs=new URLSearchParams(location.search), snap=()=>window.__snap||qs.has('s');
const desk=()=>innerWidth>=960;
const hhmm=m=>{m=Math.round(m);return String(Math.floor(m/60)).padStart(2,'0')+':'+String(m%60).padStart(2,'0');};
const zl=v=>{const a=Math.abs(v),i=Math.floor(a+1e-9),d=Math.round((a-i)*100);return String(i).replace(/\B(?=(\d{3})+(?!\d))/g,' ')+','+String(d).padStart(2,'0')+' zł';};
const set=(el,v)=>{if(el.textContent!==v)el.textContent=v;};
const show=(el,t,dy=10)=>{const e=eo(cl(t));el.style.opacity=e;el.style.transform=e>=1?'none':`translateY(${(1-e)*dy}px)`;};

/* nagłówki: słowa wysuwają się spod maski */
function slowa(h){
  const walk=n=>{[...n.childNodes].forEach(c=>{
    if(c.nodeType===3){const f=document.createDocumentFragment();
      c.textContent.split(/( +)/).forEach(t=>{if(!t)return; if(/^ +$/.test(t)){f.appendChild(document.createTextNode(t));return;}
        const w=document.createElement('span');w.className='wd';const i=document.createElement('i');i.textContent=t;w.appendChild(i);f.appendChild(w);});
      c.replaceWith(f);}
    else if(c.nodeType===1&&!c.classList.contains('wd'))walk(c);});};
  walk(h); return $$('.wd>i',h);
}
const t0=performance.now();
const NAG=[...$$('.hero h1'),...$$('.scene h2')].map(h=>({h,sec:h.closest('section'),w:slowa(h)}));
function nagl(){
  const vh=innerHeight;
  NAG.forEach(n=>{
    const e=snap()?1:n.sec.id==='hero'?cl((performance.now()-t0-100)/1000):seg(1-n.sec.getBoundingClientRect().top/vh,.25,.85);
    n.w.forEach((w,i)=>{const t=eo(cl(e*(1+n.w.length*.12)-i*.12)); const v=t>=1?'none':`translateY(${((1-t)*125).toFixed(1)}%)`; if(w.style.transform!==v)w.style.transform=v;});
  });
}

/* hak: paragony wchodzą po nagłówku */
const prs=$$('.pr'), hint=$('#hint');
function hak(){
  const t=snap()?9:(performance.now()-t0)/1000;
  prs.forEach((el,i)=>show(el,(t-.55-i*.18)/.6,24));
  show($('.hero .lead'),(t-.35)/.6,10); show($('.przyk'),(t-1.2)/.6,4);
  hint.style.opacity=cl((t-1.6)/.6)*(1-cl(scrollY/(innerHeight*.25)));
}

/* obraz wyścigu dopasowany do miejsca między nagłówkiem a zdaniem */
function fit(){
  $$('.box').forEach(b=>{const v=b.parentElement, s=Math.min(v.clientWidth/b.offsetWidth, v.clientHeight/b.offsetHeight, desk()?1.15:1); b.style.transform=`translate(-50%,-50%) scale(${s.toFixed(4)})`;});
}

/* wyścig: wspólny zegar, dwa biura */
const W=$('#wyscig'), zeg=$('#zeg'), fW=$('#fW');
const KOL=[['#papA','#liA',[.04,.14,.26,.44,.58,.74],[0,8,10,8,6,30],39.4,0],['#papB','#liB',[.04,.09,.14,.19,.24,.58],[0,0,0,1,0,0],0,9.2]].map(([pp,li,P_,M,ex,sys])=>{
  const pap=$(pp), okno=pap.parentElement, linie=$$('.pl',pap), suma=$('.ps',pap), led=$('.led',okno.parentElement), lic=$(li);
  return {pap,okno,linie,suma,led,lm:$('.lm',lic),lz:$('.lz',lic),P:P_,M,ex,sys,last:-1};
});
const ZEG=[[0,432],[.04,432],[.26,460],[.34,478],[.44,495],[.58,630],[.74,840],[1,840]];
function czas(p){for(let i=1;i<ZEG.length;i++){if(p<=ZEG[i][0]){const [a,ma]=ZEG[i-1],[b,mb]=ZEG[i];return ma+(mb-ma)*seg(p,a,b);}}return 840;}
const dol=el=>el.offsetTop+el.offsetHeight;
function wyscig(p){
  set(zeg,hhmm(czas(p)));
  KOL.forEach(k=>{
    /* ile wydrukowano: kolejne pozycje płynnie, na końcu podsumowanie */
    let h=k.linie[0].offsetTop;
    k.linie.forEach((l,i)=>{const t=eo(seg(p,k.P[i],k.P[i]+.05)); const prev=i?dol(k.linie[i-1]):l.offsetTop; h=t>0?prev+(dol(l)-prev)*t:h; l.style.opacity=t>0?1:0;});
    const ts=eo(seg(p,.82,.9)); if(ts>0)h=dol(k.linie[k.linie.length-1])+(dol(k.suma)-dol(k.linie[k.linie.length-1]))*ts; k.suma.style.opacity=ts>0?1:0;
    h+=8;
    const y=k.okno.clientHeight-h; const v=`translateY(${y.toFixed(1)}px)`; if(k.pap.style.transform!==v)k.pap.style.transform=v;
    k.led.classList.toggle('blink',Math.abs(h-k.last)>.4); k.last=h;
    let m=0; k.M.forEach((mm,i)=>m+=mm*seg(p,k.P[i],k.P[i]+.06));
    const z=m*.8+k.ex*seg(p,k.P[5],k.P[5]+.06)+k.sys*seg(p,k.P[1],k.P[1]+.04);
    set(k.lm,Math.floor(m+1e-6)+' min'); set(k.lz,zl(z));
  });
  show(fW,seg(p,.88,.95),10);
}

/* pętla */
const bar=$('#bar'), kontakt=document.getElementById('kontakt');
let P=0;
const prog=el=>{const r=el.getBoundingClientRect();const tot=r.height-innerHeight;return tot<=0?0:cl(-r.top/tot);};
function frame(){
  const t=prog(W); P=snap()?t:P+(t-P)*.15; if(Math.abs(t-P)<.0005)P=t;
  nagl(); hak(); wyscig(P);
  bar.classList.toggle('off',kontakt.getBoundingClientRect().top<innerHeight*.6);
  requestAnimationFrame(frame);
}
fit(); addEventListener('resize',fit); if(document.fonts&&document.fonts.ready)document.fonts.ready.then(fit);
const qsS=qs.get('s');
if(qsS){const el=document.getElementById(qsS); if(el){document.documentElement.style.scrollBehavior='auto'; scrollTo(0,el.getBoundingClientRect().top+scrollY+parseFloat(qs.get('p')||0)*Math.max(0,el.offsetHeight-innerHeight));}}
requestAnimationFrame(frame);
})();

/* ───── żółta karteczka „Chcesz tak u siebie?”: jedno pole (telefon albo e-mail) ─────
   POST /api/kontakt jak formularz strony (Zgody.astro dokłada Lead dla Mety).
   Do statystyk idzie tylko skąd i czy telefon czy e-mail, nigdy same dane. */
(()=>{
const $=(s)=>document.querySelector(s), $$=(s)=>[...document.querySelectorAll(s)];
const stat=(e,p)=>{try{window.laStat&&window.laStat(e,p||{});}catch(x){}};
const kartka=$('#kartka'), f=$('#kF'), inp=$('#kK'), err=$('#kE'), zg=$('#kZ'), btn=$('#kB'), btnT=$('#kBT'), ok=$('#kOk'), okT=$('#kOkT'), kc=$('#kc'), sekcja=document.getElementById('kontakt'), reszta=$('#wyscig');
if(!kartka||!f)return;
const MAIL=/^[^\s@]+@[^\s@]+\.[a-zA-Z]{2,}$/;
let wysylam=false, wyslane=false;
/* karteczka przykleja się, gdy wjedzie na ekran */
kartka.classList.add('pre');
const przyklej=()=>{kartka.classList.add('on'); requestAnimationFrame(()=>kartka.classList.remove('pre'));};
if('IntersectionObserver' in window&&!window.__snap){new IntersectionObserver((es,o)=>es.forEach(x=>{if(x.isIntersecting){przyklej();o.disconnect();}}),{threshold:.25}).observe(kartka);} else przyklej();
/* wszystkie „chcę” na stronie prowadzą do karteczki */
const doKartki=(skad)=>e=>{e.preventDefault(); stat('karteczka_klik',{skad:skad}); sekcja.scrollIntoView({behavior:'smooth',block:'center'}); setTimeout(()=>{try{inp.focus({preventScroll:true});}catch(x){}},700);};
kc.addEventListener('click',doKartki('rog'));
$$('a[href="#kontakt"]').forEach(a=>{if(a!==kc)a.addEventListener('click',doKartki(a.id==='barCta'?'pasek':'tresc'));});
$$('[data-tel]').forEach(el=>el.addEventListener('click',()=>stat('tel_klik',{skad:el.dataset.tel})));
function rozpoznaj(v){
  if(v.includes('@')) return MAIL.test(v)?{email:v,telefon:''}:{blad:'mail chyba niepełny?'};
  const c=v.replace(/\D/g,'');
  if(c.length<9) return {blad:v?'za mało cyfr?':'tu wpisz numer albo mail'};
  return {email:'',telefon:(c.length===9?'+48 ':'+')+c.replace(/^00/,'')};
}
inp.addEventListener('input',()=>{err.textContent='';});
zg.addEventListener('change',()=>zg.closest('.k-z').classList.toggle('err',false));
f.addEventListener('submit',e=>{
  e.preventDefault(); if(wysylam||wyslane)return;
  const r=rozpoznaj(inp.value.trim());
  if(r.blad){err.textContent=r.blad; inp.focus(); return;}
  if(!zg.checked){zg.closest('.k-z').classList.add('err'); err.textContent='zaznacz zgodę ↓'; return;}
  wysylam=true; btn.disabled=true; const napis=btnT.textContent; btnT.textContent='Wysyłam…';
  let ref=''; try{ref=localStorage.getItem('referrer')||'';}catch(x){}
  fetch('/api/kontakt',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},
    body:JSON.stringify({email:r.email,telefon:r.telefon,
      wiadomosc:'Karteczka „Chcesz tak u siebie?” z landingu /marza: proszę o '+(r.telefon?'telefon':'maila')+', chcę zobaczyć to na naszym zamówieniu.',
      firma_www:f.elements.kontrola.value||'',zrodlo:'Marża · karteczka · '+location.pathname,referrer:ref})})
  .then(o=>{ if(!o.ok) return o.json().catch(()=>({})).then(j=>{throw new Error(j.blad||'blad');});
    wyslane=true;
    try{window.dataLayer=window.dataLayer||[];window.dataLayer.push({event:'formularz_wyslany',zrodlo:'Marża · karteczka'});}catch(x){}
    stat('karteczka_wyslana',{kanal:r.telefon?'telefon':'email'});
    okT.textContent=r.telefon?'Dzięki! Oddzwonimy w jeden dzień roboczy.':'Dzięki! Odpiszemy w jeden dzień roboczy.';
    f.hidden=true; ok.hidden=false; requestAnimationFrame(()=>requestAnimationFrame(()=>ok.classList.add('on'))); kc.classList.remove('on'); })
  .catch(x=>{ wysylam=false; btn.disabled=false; btnT.textContent=napis;
    err.textContent=x&&x.message==='brak-konfiguracji'?'nie działa, zadzwoń ↓':'nie doszło, spróbuj jeszcze raz';
    stat('karteczka_blad',{powod:String(x&&x.message||'blad').slice(0,30)}); });
});
/* róg karteczki: od pomyłki o 14:00 do samej karteczki */
function rog(){
  const vh=innerHeight, rr=reszta&&reszta.getBoundingClientRect(), za=rr&&(rr.top<-(rr.height-vh)*.6), przed=sekcja.getBoundingClientRect().top>vh*.7;
  kc.classList.toggle('on',!wyslane&&za&&przed);
}
addEventListener('scroll',rog,{passive:true}); addEventListener('resize',rog); rog();
})();

</script>
