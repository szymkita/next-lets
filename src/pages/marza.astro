---
// MARŻA — /marza. Landing kampanii Meta „Marża” (paragon, klepsydra): historia jednego
// zamówienia przewijana palcem. Źródło w ~/filmy/lets-meta-marza/landing (strona.html/css/js,
// build.py generuje ten plik — zmiany rób tam). Szymon 20.11.2026: „jest ok… wrzuć na naszą
// www i będziemy testować”. v3 (branże, skalowane sceny) odrzucona: „dużo gorsze”; dopracowujemy v2.
// Liczby to przykład opisany na stronie (48 zł/h pracy biura).
// noindex, bez nawigacji, zgłoszenia ze źródłem „Marża”.
import LaBase from '../layouts/LaBase.astro';
import Styl from '../components/usluga/Styl.astro';
const title = "Podniesiemy Twoją marżę | Let's automate";
const description = "To samo zamówienie za 800 zł w dwóch firmach: u Ciebie zostaje 11 zł, u konkurencji 90 zł. Zobacz, gdzie jest różnica i jak zrobić to u siebie.";
---
<LaBase topbar={false} title={title} description={description} ctaHref="#kontakt" nav={null} naglowek={false} noindex={true}>
<Styl />
<style is:global>
.mz{

  --deep:#07140D; --deep2:#0C1E14; --card:#0F2419; --fg:#F4F8F2; --mut:#93A69B; --soft:#C9D5CE; --line:rgba(244,248,242,.12);
  --acc:#00CD77; --acc2:#7FE9B9; --amber:#F2B233; --pen:#D3261B; --pen2:#FF8A80;
  --paper:#F3F0E7; --paper2:#E9E4D6; --ink:#1C1C1A; --ok:#0A7A52;
  --f-d:"Schibsted Grotesk", "Helvetica Neue", Arial, sans-serif;
  --f-m:"JetBrains Mono", ui-monospace, Menlo, monospace;
  --f-h:"Caveat", "Comic Sans MS", cursive;
  color-scheme:dark;}
.mz *{
box-sizing:border-box}

.mz{
margin:0;background:var(--deep);color:var(--fg);font-family:var(--f-d);-webkit-font-smoothing:antialiased;overflow-x:clip}
.mz::before{
content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:30;background:var(--deep)}
.mz .hist{
background:var(--deep);color:var(--fg);font-family:var(--f-d);-webkit-font-smoothing:antialiased}
.mz .hist h1,.mz .hist h2{
margin:0;font-weight:800;letter-spacing:-.045em;text-wrap:balance;color:var(--fg);font-family:var(--f-d)}
.mz .hist h1 em,.mz .hist h2 em{
font-style:normal;color:var(--acc)}
.mz .lead{
margin:14px 0 0;font:500 clamp(16px,4.3vw,21px)/1.42 var(--f-d);color:var(--soft);max-width:32em;text-wrap:pretty}
.mz .ety{
font:700 12px/1 var(--f-m);letter-spacing:.12em;text-transform:uppercase;color:var(--ok)}
.mz .zle{
color:var(--pen2)}
.mz .bar{
position:fixed;left:0;right:0;top:0;z-index:20;padding-top:env(safe-area-inset-top,0px);padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));
  background:linear-gradient(180deg,rgba(7,20,13,.96) 60%,rgba(7,20,13,0));transition:opacity .3s,transform .3s}
.mz .bar.off{
opacity:0;transform:translateY(-100%);pointer-events:none}
.mz .bar.jasny{
background:linear-gradient(180deg,rgba(243,240,231,.96) 60%,rgba(243,240,231,0))}
.mz .bar.jasny .logo{
filter:invert(1) hue-rotate(180deg) brightness(.35)}
.mz .bar-in{
position:relative;max-width:1120px;margin:0 auto;height:60px;display:flex;align-items:center;justify-content:space-between}
.mz .logo svg{
height:17px;width:auto;display:block}
.mz .bar-cta{
font:700 14px/1 var(--f-d);color:#06170E;background:var(--acc);padding:11px 15px;border-radius:999px;text-decoration:none}
.mz .hero{
min-height:100svh;display:flex;align-items:center;padding:calc(84px + env(safe-area-inset-top,0px)) max(16px,env(safe-area-inset-left,0px)) 40px}
.mz .hero .w{
position:relative;max-width:1120px;width:100%;margin:0 auto}
.mz .hero h1{
font-size:clamp(34px,9.2vw,76px);line-height:1.02;max-width:14em}
.mz .dwa{
display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:28px;max-width:640px}
.mz .pr{
position:relative;border-radius:18px;padding:12px 10px 14px}
.mz .pr-ty{
background:var(--card);border:1px solid var(--line)}
.mz .pr-on{
background:var(--paper);color:var(--ink)}
.mz .pr-k{
display:flex;align-items:center;gap:7px;font:700 13px/1 var(--f-d);padding:2px 4px 10px}
.mz .pr-k::before{
content:"";width:8px;height:8px;border-radius:50%;background:var(--pen2)}
.mz .pr-on .pr-k::before{
background:var(--ok)}
.mz .pr-p{
position:relative;background:#FBF9F3;color:var(--ink);font-family:var(--f-m);padding:12px 10px 12px;border-radius:2px;box-shadow:0 14px 26px -16px rgba(0,0,0,.8)}
.mz .pr-ty .pr-p{
background:var(--paper)}
.mz .pr-p::before{
content:"";position:absolute;left:0;right:0;top:-1px;height:6px;background:linear-gradient(135deg,var(--card) 33%,transparent 34%) 0 0/8px 6px repeat-x,linear-gradient(225deg,var(--card) 33%,transparent 34%) 0 0/8px 6px repeat-x}
.mz .pr-on .pr-p::before{
background:linear-gradient(135deg,var(--paper) 33%,transparent 34%) 0 0/8px 6px repeat-x,linear-gradient(225deg,var(--paper) 33%,transparent 34%) 0 0/8px 6px repeat-x}
.mz .pr-p .r{
display:flex;justify-content:space-between;gap:6px;font-size:clamp(9.5px,2.6vw,13px);line-height:1.75;white-space:nowrap}
.mz .pr-p .r.zle{
color:#B3261E;font-weight:700}
.mz .pr-p .r.ok{
color:var(--ok);font-weight:700}
.mz .pr-p .dl{
border-top:2px dashed #8E8C84;margin:6px 0 5px;opacity:.8}
.mz .pr-p .z{
display:flex;justify-content:space-between;font-weight:700;font-size:clamp(15px,4.4vw,24px);line-height:1.2}
.mz .pr-ty .z{
color:#B3261E}
.mz .pr-p .z.ok{
color:var(--ok)}
.mz .przyk{
margin:12px 0 0;font:500 12.5px/1.3 var(--f-d);color:var(--mut)}
.mz .hint{
display:flex;align-items:center;gap:10px;margin-top:28px;font:600 12px/1 var(--f-d);letter-spacing:.12em;text-transform:uppercase;color:var(--mut)}
.mz .hint i{
width:1.5px;height:22px;background:linear-gradient(var(--mut),transparent);animation:mz-drip 1.6s infinite}
@keyframes mz-drip{
0%{
transform:scaleY(0);transform-origin:top}
50%{
transform:scaleY(1);transform-origin:top}
51%{
transform-origin:bottom}
100%{
transform:scaleY(0);transform-origin:bottom}}
.mz .scene{
position:relative;height:calc(var(--h) * 1svh)}
.mz .stage{
position:sticky;top:0;height:100svh;overflow:hidden;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.mz .inner{
position:relative;max-width:1120px;height:100%;margin:0 auto;display:grid;grid-template-rows:auto minmax(0,1fr) auto;grid-template-areas:"cap" "vis" "ft";row-gap:12px;
  padding-top:calc(70px + env(safe-area-inset-top,0px));padding-bottom:calc(80px + env(safe-area-inset-bottom,0px))}
.mz .cap{
grid-area:cap;display:flex;align-items:center;justify-content:space-between;gap:12px}
.mz .cap h2{
font-size:clamp(24px,6.4vw,46px);line-height:1.04}
.mz .zegar{
order:2;flex:none;font:700 clamp(26px,7vw,44px)/1 var(--f-m);letter-spacing:-.03em;color:var(--acc);text-shadow:0 0 18px rgba(0,205,119,.45);font-variant-numeric:tabular-nums}
.mz .vis{
grid-area:vis;position:relative;min-height:0}
.mz .ft{
grid-area:ft;min-height:56px}
.mz .box{
position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);transform-origin:50% 50%}
.mz .foot{
margin:0;font:650 clamp(16px,4.4vw,22px)/1.28 var(--f-d);letter-spacing:-.02em;opacity:0;text-wrap:balance}
.mz .foot b{
color:var(--acc);font-weight:800}
.mz .foot .zle{
font-weight:800}
.mz .foot small{
display:block;margin-top:6px;font:500 12px/1.35 var(--f-d);color:var(--mut);letter-spacing:0}
.mz .tory{
width:364px;display:grid;grid-template-columns:1fr 1fr;gap:8px}
.mz .tor{
border-radius:18px;padding:10px 8px 10px;display:flex;flex-direction:column;min-height:640px}
.mz .tor-ty{
background:var(--card);border:1px solid var(--line)}
.mz .tor-on{
background:var(--paper);color:var(--ink);box-shadow:0 0 0 1px rgba(255,255,255,.4),0 30px 60px -30px rgba(0,205,119,.35)}
.mz .tor-h{
display:flex;align-items:center;gap:7px;font:800 14px/1.1 var(--f-d);padding:2px 4px 10px}
.mz .tor-h i{
width:9px;height:9px;border-radius:50%;background:var(--pen2);flex:none}
.mz .tor-on .tor-h i{
background:var(--ok)}
.mz .kroki{
display:grid;gap:6px;align-content:start;flex:1}
.mz .kr{
border-radius:11px;padding:7px 8px 8px;opacity:0;transform:translateY(10px)}
.mz .tor-ty .kr{
background:rgba(244,248,242,.06);border:1px solid rgba(244,248,242,.08)}
.mz .tor-on .kr{
background:#fff;border:1px solid rgba(28,28,26,.08)}
.mz .kr small{
display:block;font:700 10.5px/1 var(--f-m);color:var(--mut);margin-bottom:4px;font-variant-numeric:tabular-nums}
.mz .tor-on .kr small{
color:#7A776E}
.mz .kr p{
margin:0;font:500 12.5px/1.32 var(--f-d)}
.mz .kr b{
display:inline-block;margin-top:5px;font:700 10.5px/1 var(--f-m);color:var(--pen2);background:rgba(211,38,27,.14);padding:3px 6px;border-radius:5px}
.mz .tor-on .kr b{
color:#7A4D00;background:#FFF0CC}
.mz .kr.zly{
background:linear-gradient(180deg,rgba(211,38,27,.25),rgba(211,38,27,.08))!important;border-color:rgba(211,38,27,.55)!important}
.mz .kr.pyt{
background:#FFF7E0!important;border-color:rgba(242,178,51,.6)!important}
.mz .kr.gotowe{
background:#DDF6EA!important;border-color:rgba(10,122,82,.35)!important}
.mz .kr.gotowe p{
font-weight:700;color:#0A5C3E}
.mz .kr.gotowe p::before{
content:"✓ ";color:var(--ok)}
.mz .licz{
margin-top:8px;border-radius:11px;padding:8px 9px;display:flex;justify-content:space-between;align-items:baseline;gap:6px;font:700 12px/1 var(--f-m);font-variant-numeric:tabular-nums;white-space:nowrap}
.mz .tor-ty .licz{
background:#020604;color:var(--pen2);border:1px solid rgba(211,38,27,.35)}
.mz .tor-ty .licz span:last-child{
font-size:16px}
.mz .tor-on .licz{
background:#E2F4EA;color:var(--ok);border:1px solid rgba(10,122,82,.25)}
.mz .tor-on .licz span:last-child{
font-size:16px}
.mz .roznica{
background:var(--paper);color:var(--ink);padding:clamp(64px,12vw,120px) max(16px,env(safe-area-inset-left,0px))}
.mz .roznica .w{
max-width:760px;margin:0 auto}
.mz .tab{
margin-top:22px;border-radius:18px;overflow:hidden;background:#fff;box-shadow:0 30px 60px -40px rgba(0,0,0,.5);border:1px solid rgba(28,28,26,.08)}
.mz .tw{
display:grid;grid-template-columns:1.2fr 1fr 1fr;align-items:center;gap:8px;padding:13px 14px;border-top:1px solid rgba(28,28,26,.07);font:600 15px/1.25 var(--f-d);opacity:0;transform:translateY(10px);transition:opacity .5s,transform .5s}
.mz .tw:first-child{
border-top:0}
.mz .tw.th{
background:var(--ink);color:var(--fg);font:800 13.5px/1.2 var(--f-d)}
.mz .tw.th span:nth-child(2){
color:var(--pen2)}
.mz .tw.th span:nth-child(3){
color:var(--acc)}
.mz .tw span:first-child{
color:#4A4A45}
.mz .tw.th span:first-child{
color:var(--mut)}
.mz .tw .a{
color:#B3261E;font-family:var(--f-m);font-weight:700}
.mz .tw .b{
color:var(--ok);font-family:var(--f-m);font-weight:800}
.mz .tw.duzy .a,.mz .tw.duzy .b{
font-size:clamp(20px,5.6vw,28px)}
.mz .tw.duzy{
background:#FBF9F3}
.mz .tab.on .tw{
opacity:1;transform:none}
.mz .roznica .t{
margin:26px 0 0;font:500 clamp(17px,4.4vw,21px)/1.5 var(--f-d);color:#33332F}
.mz .kartka-s{
background:var(--deep);padding-block:clamp(70px,12vw,130px) clamp(110px,14vw,150px);padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));overflow:hidden}
.mz .kartka-s .w{
max-width:520px;margin:0 auto;text-align:center}
.mz .kartka{
position:relative;text-align:left;background:#FFE36E;color:#2B2410;padding:34px 26px 28px;border-radius:2px 2px 26px 2px;transform:rotate(-2deg);
  background-image:linear-gradient(180deg,rgba(255,255,255,.25),transparent 30%),linear-gradient(135deg,transparent 80%,rgba(160,120,0,.18));
  box-shadow:0 2px 0 rgba(0,0,0,.05),0 40px 60px -30px rgba(0,0,0,.9),0 18px 30px -20px rgba(0,0,0,.6);opacity:0;transition:opacity .6s,transform .8s cubic-bezier(.2,.9,.3,1.2)}
.mz .kartka.pre{
transform:rotate(-8deg) translateY(60px) scale(.94)}
.mz .kartka.on{
opacity:1}
.mz .tasma{
position:absolute;left:50%;top:-14px;width:120px;height:30px;transform:translateX(-50%) rotate(3deg);background:rgba(244,248,242,.42);box-shadow:0 2px 6px rgba(0,0,0,.15)}
.mz .kartka-s h2.k-h{
margin:0;font:700 clamp(44px,12vw,62px)/.95 var(--f-h);letter-spacing:0;color:#1C1C1A}
.mz .k-t{
margin:10px 0 0;font:600 clamp(23px,6vw,28px)/1.15 var(--f-h);color:#3A3010}
.mz .k-f{
margin-top:22px}
.mz .k-l{
display:block;font:700 12px/1 var(--f-d);letter-spacing:.08em;text-transform:uppercase;color:#6B5A1A}
.mz .k-i{
display:block;width:100%;margin-top:4px;height:56px;border:0;border-bottom:2.5px solid #2B2410;background:transparent;padding:0 2px;font:700 32px/1 var(--f-h);color:#1C1C1A;outline:none;border-radius:0}
.mz .k-i::placeholder{
color:rgba(43,36,16,.32)}
.mz .k-i:focus{
border-bottom-color:#0A7A52}
.mz .k-err{
display:block;min-height:26px;padding-top:4px;font:700 21px/1 var(--f-h);color:#B0190F}
.mz .k-z{
display:flex;gap:10px;align-items:flex-start;font:500 13px/1.35 var(--f-d);color:#5A4C18;cursor:pointer}
.mz .k-z a{
color:#3A3010}
.mz .k-z input{
position:absolute;opacity:0;width:1px;height:1px}
.mz .k-box{
flex:none;width:20px;height:20px;border:2px solid #2B2410;border-radius:4px;margin-top:-1px;display:grid;place-items:center}
.mz .k-z input:checked + .k-box::after{
content:"✓";font:800 16px/1 var(--f-d);color:#0A7A52}
.mz .k-z input:focus-visible + .k-box{
box-shadow:0 0 0 3px rgba(10,122,82,.35)}
.mz .k-z.err .k-box{
border-color:#B0190F}
.mz .k-hp{
position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
.mz .k-btn{
margin-top:20px;width:100%;height:60px;border:0;border-radius:14px;background:#1C1C1A;color:#FFE36E;font:800 19px/1 var(--f-d);cursor:pointer;display:flex;align-items:center;justify-content:center;gap:10px;box-shadow:0 10px 24px -12px rgba(0,0,0,.7);transition:transform .15s}
.mz .k-btn:hover{
transform:translateY(-2px)}
.mz .k-btn:active{
transform:scale(.98)}
.mz .k-btn[disabled]{
opacity:.7;cursor:progress}
.mz .k-btn svg{
width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
.mz .k-ok{
margin-top:18px;text-align:center}
.mz .k-ok svg{
width:110px;height:74px;fill:none;stroke:#0A7A52;stroke-width:7;stroke-linecap:round;stroke-linejoin:round}
.mz .k-ok svg path{
stroke-dasharray:1;stroke-dashoffset:1;transition:stroke-dashoffset .7s ease-out}
.mz .k-ok.on svg path{
stroke-dashoffset:0}
.mz .k-ok p{
margin:8px 0 0;font:700 30px/1.1 var(--f-h);color:#1C1C1A}
.mz .k-kto{
display:inline-flex;align-items:center;gap:12px;margin:38px 0 0;font:500 14.5px/1.45 var(--f-d);color:var(--soft);text-align:left}
.mz .k-kto img{
width:40px;height:40px;border-radius:50%;object-fit:cover;object-position:50% 20%;border:2px solid rgba(0,205,119,.5);flex:none;background:#1A3326}
.mz .k-kto b,.mz .k-kto a{
color:var(--fg)}
.mz .k-fakty{
margin:14px 0 0;display:flex;flex-wrap:wrap;justify-content:center;gap:6px 18px;font:500 13.5px/1.4 var(--f-d);color:var(--mut)}
.mz .k-fakty b{
color:var(--soft)}
.mz .kc{
position:fixed;right:14px;bottom:0;z-index:25;width:178px;height:84px;padding:14px 14px 0 16px;display:flex;align-items:flex-start;justify-content:space-between;gap:6px;text-decoration:none;
  background:#FFE36E;color:#1C1C1A;border-radius:2px 2px 0 0;font:700 22px/1 var(--f-h);box-shadow:0 -10px 30px -8px rgba(0,0,0,.6);transform:translateY(110%) rotate(3deg);transition:transform .55s cubic-bezier(.2,.9,.3,1.2)}
.mz .kc.on{
transform:translateY(26px) rotate(3deg)}
.mz .kc.on:hover,.mz .kc.on:focus-visible{
transform:translateY(8px) rotate(1deg)}
.mz .kc i{
font-style:normal;font-family:var(--f-d);font-weight:800;font-size:18px;margin-top:2px}
.mz .wd{
display:inline-block;overflow:hidden;vertical-align:top;padding:.14em .02em .1em;margin:-.14em -.02em -.1em}
.mz .wd>i{
display:inline-block;font-style:normal;transform:translateY(125%);will-change:transform}
@media (min-width:960px){
.mz .hero .w{
display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center}
.mz .hero .dwa{
margin-top:0;grid-row:1 / span 4;grid-column:2}
.mz .hero h1,.mz .hero .lead,.mz .hero .przyk,.mz .hero .hint{
grid-column:1}
.mz .tory{
width:720px;gap:16px}
.mz .tor{
padding:14px 12px 12px;min-height:600px}
.mz .kr p{
font-size:14px}
.mz .kc{
right:max(24px,calc((100vw - 1120px)/2));width:210px;font-size:25px}
}
@media (prefers-reduced-motion:reduce){
.mz .hint i{
animation:none}
.mz .wd>i{
transform:none!important}
.mz .kartka,.mz .kc,.mz .tw{
transition:none}}
.mz .dwa{
grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:10px}
.mz .pr{
padding:10px 8px 12px}
.mz .pr-p{
padding:11px 8px 11px}
.mz .pr-p .r{
font-size:clamp(8.6px,2.35vw,13px)}
.mz .pr-p .z{
font-size:clamp(14px,4.2vw,24px)}
@media (min-width:960px){
.mz .hero .w{
grid-template-columns:1fr 1fr}
.mz .hero h1{
font-size:clamp(44px,4.6vw,64px)}
.mz .pr-p .r{
font-size:14px}
.mz .pr-p .z{
font-size:28px}
.mz .pr{
padding:14px 12px 16px}
.mz .pr-k{
font-size:15px}
}
@media (min-width:960px){
.mz .hero h1{
max-width:none}
.mz .hero .w{
grid-template-columns:1.15fr .85fr}}
.mz .inner{
padding-bottom:calc(76px + env(safe-area-inset-bottom,0px))}
.mz .tory{
position:absolute;inset:0;display:grid;grid-template-columns:1fr 1fr;gap:10px;max-width:860px;margin:0 auto}
.mz .kol{
display:flex;flex-direction:column;min-height:0}
.mz .kol-h{
display:flex;align-items:center;gap:7px;font:800 15px/1 var(--f-d);padding:0 2px 10px}
.mz .kol-h i{
width:9px;height:9px;border-radius:50%;background:var(--pen2);flex:none}
.mz .kol-on .kol-h i{
background:var(--acc)}
.mz .okno{
