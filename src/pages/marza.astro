  $$('.box').forEach(b=>{const v=b.parentElement, vw=v.clientWidth, vh=v.clientHeight, bw=b.offsetWidth, bh=b.offsetHeight; if(!bw||!bh||!vh)return;
    const s=Math.min(vw/bw, vh/bh, desk()?1.3:1); b.style.transform=b.classList.contains('rig')?`translateX(-50%) scale(${s.toFixed(4)})`:`translate(-50%,-50%) scale(${s.toFixed(4)})`;});
}

/* ───── 1. paragon ───── */
