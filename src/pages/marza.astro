    set(len){const v=len.toFixed(1)+'px'; if(clip.style.height!==v)clip.style.height=v; led.classList.toggle('blink',len>2&&len<paper.offsetHeight-1);}};
}

/* każdy obraz skalowany do swojej strefy: nic nie wchodzi na podpis ani na zdanie pod spodem */
