function paper(n){
  const r=T.rc, rows=r.rows.map(([l,v])=>`<div class="r"><span>${l}</span><span>${num(v)}</span></div>`).join('');
  if(n===1) return `<div class="hd"><b>${r.firma}</b>${r.nr}<br>${r.czas}</div><div class="dl"></div>${rows}<div class="r q"><span>${r.q[0]}</span><span>${num(r.q[1])}</span>${RING}</div><div class="dl"></div><div class="z"><span>ZOSTAJE</span><span>${num(r.zost)}</span></div><div class="ft">DZIĘKUJEMY · ZAPRASZAMY PONOWNIE</div>`;
  return `<div class="hd"><b>${r.firma}</b>${r.nr2}<br>${r.czas2}</div><div class="dl"></div>${rows}${r.po.map(([l,v])=>`<div class="r nowa"><span>${l}</span><span>${num(v)}</span></div>`).join('')}<div class="dl"></div><div class="z ok"><span>ZOSTAJE</span><span>${num(r.zost2)}</span></div><div class="ft">PRZYKŁAD · TWOJE LICZBY POLICZYMY RAZEM</div>`;
}
