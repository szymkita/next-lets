<script is:inline>
(()=>{
/* ───── pomocnicze ───── */
const cl=(x,a=0,b=1)=>Math.min(b,Math.max(a,x)), seg=(p,a,b)=>cl((p-a)/(b-a)), eo=t=>1-Math.pow(1-t,3), eio=t=>t<.5?4*t*t*t:1-Math.pow(-2*t+2,3)/2;
const $=(s,r=document)=>r.querySelector(s), $$=(s,r=document)=>[...r.querySelectorAll(s)];
const type=(el,t,full)=>{const n=Math.round(full.length*cl(t));const s=full.slice(0,n);if(el.textContent!==s)el.textContent=s;el.classList.toggle('caret',t>0&&t<1);};
const write=(el,t)=>{el.style.clipPath=`inset(-20% ${(1-cl(t))*100}% -20% 0)`;};
const show=(el,t,dy=12)=>{const e=eo(cl(t));el.style.opacity=e;el.style.transform=e>=1?'':`translateY(${(1-e)*dy}px)`;};
const pop=(el,t)=>{el.style.transform=`scale(${eo(cl(t))})`;};
const html=(el,h)=>{if(el.innerHTML!==h)el.innerHTML=h;};
const desk=()=>innerWidth>=960;
const hhmm=m=>{m=Math.round(m);return String(Math.floor(m/60)).padStart(2,'0')+':'+String(m%60).padStart(2,'0');};
const num=v=>{const a=Math.abs(v),i=Math.floor(a+1e-9),d=Math.round((a-i)*100);return (v<0?'-':'')+String(i).replace(/\B(?=(\d{3})+(?!\d))/g,' ')+','+String(d).padStart(2,'0');};
const zl=v=>num(v)+' zł';
