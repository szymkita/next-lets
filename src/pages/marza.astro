  if(zi!==E.zi){E.zi=zi; E.zrL.textContent=e.zr[zi][0]; E.zrT.innerHTML=e.zr[zi][1]; E.zrodlo.animate&&E.zrodlo.animate([{transform:'rotate(-.8deg) translateY(-4px)',opacity:.4},{transform:'rotate(-.8deg)',opacity:1}],{duration:260,easing:'ease-out'});}
  const st=zl(total); if(E.sum.textContent!==st)E.sum.textContent=st;
