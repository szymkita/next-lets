<script is:inline>
(()=>{
const cl=(x,a=0,b=1)=>Math.min(b,Math.max(a,x)), seg=(p,a,b)=>cl((p-a)/(b-a)), eo=t=>1-Math.pow(1-t,3), eio=t=>t<.5?4*t*t*t:1-Math.pow(-2*t+2,3)/2;
const eb=t=>{const c=1.70158;t=cl(t);return 1+(c+1)*Math.pow(t-1,3)+c*Math.pow(t-1,2);};
const $=(s,r=document)=>r.querySelector(s), $$=(s,r=document)=>[...r.querySelectorAll(s)];
const type=(el,t,full)=>{const n=Math.round(full.length*cl(t));const s=full.slice(0,n);if(el.textContent!==s)el.textContent=s;el.classList.toggle('caret',t>0&&t<1);};
const pen=(path,t)=>{path.style.strokeDashoffset=String(1-cl(t));};
const write=(el,t)=>{el.style.clipPath=`inset(-20% ${(1-cl(t))*100}% -20% 0)`;};
const mark=(bg,t)=>{bg.style.transform=`scaleX(${eo(cl(t))})`;};
const show=(el,t,dy=12)=>{const e=eo(cl(t));el.style.opacity=e;el.style.transform=e>=1?'none':`translateY(${(1-e)*dy}px)`;};
const desk=()=>innerWidth>=960;
const hhmm=m=>{m=Math.round(m);return String(Math.floor(m/60)).padStart(2,'0')+':'+String(m%60).padStart(2,'0');};
const zl=v=>{const a=Math.abs(v),i=Math.floor(a+1e-9),d=Math.round((a-i)*100);return String(i).replace(/\B(?=(\d{3})+(?!\d))/g,' ')+','+String(d).padStart(2,'0')+' zł';};
const IDS=['paragon','mail','przepisywanie','reszta','skala','zmiana','po'], S={}; IDS.forEach(id=>S[id]=document.getElementById(id));
const qs=new URLSearchParams(location.search), snap=()=>window.__snap||qs.has('s');

/* ───── nagłówki: każde słowo w masce, wysuwa się, gdy scena wchodzi na ekran ───── */
function slowa(h){
  const walk=n=>{[...n.childNodes].forEach(c=>{
    if(c.nodeType===3){const parts=c.textContent.split(/( +)/); const f=document.createDocumentFragment();
      parts.forEach(t=>{if(!t)return; if(/^ +$/.test(t)){f.appendChild(document.createTextNode(t));return;}
        const w=document.createElement('span');w.className='wd';const i=document.createElement('i');i.textContent=t;w.appendChild(i);f.appendChild(w);});
      c.replaceWith(f);}
    else if(c.nodeType===1&&!c.classList.contains('wd'))walk(c);});};
  walk(h); return $$('.wd>i',h);
}
const NAG=$$('.hist .scene h1,.hist .scene h2').filter(h=>!h.closest('.after')).map(h=>{const sec=h.closest('section'); return {h,sec,w:slowa(h),clk:$('.clock',sec),lead:$$('.lead',h.parentElement)};});
NAG.forEach(n=>n.lead.forEach(l=>{l.style.opacity=0;}));
const t0=performance.now();
function nagl(){
  const vh=innerHeight;
  NAG.forEach(n=>{
    let e;
    if(n.sec.id==='paragon') e=snap()?1:cl((performance.now()-t0-150)/900);
    else {const r=n.sec.getBoundingClientRect(); e=snap()?(r.top<vh?1:0):seg(1-r.top/vh,.25,.85);}
    const k=n.w.length;
    n.w.forEach((w,i)=>{const t=eo(cl(e*(1+k*.18)-i*.18)); const v=t>=1?'none':`translateY(${((1-t)*125).toFixed(2)}%)`; if(w.style.transform!==v)w.style.transform=v;});
    if(n.clk){const c=eo(seg(e,0,.5)); n.clk.style.opacity=c; n.clk.style.transform=c>=1?'none':`translateY(${(1-c)*8}px)`;}
    n.lead.forEach(l=>{const c=eo(seg(e,.45,1)); l.style.opacity=c; l.style.transform=c>=1?'none':`translateY(${(1-c)*10}px)`;});
  });
}

/* ───── obrazy scen dopasowane do strefy: nic nie wchodzi na nagłówek ani na zdanie pod spodem ───── */
function fit(){
  $$('.box').forEach(b=>{const v=b.parentElement, vw=v.clientWidth, vh=v.clientHeight, bw=b.offsetWidth, bh=b.offsetHeight; if(!bw||!bh||!vh)return;
    const s=Math.min(vw/bw, vh/bh, desk()?1.3:1).toFixed(4);
    b.style.transform=b.classList.contains('rig')?`translateX(-50%) scale(${s})`:`translate(-50%,-50%) scale(${s})`;});
}

/* ───── drukarka: okno nad szczeliną rośnie, papier ma stałą wysokość ───── */
function drukarka(rig){
  const clip=$('.clip',rig), paper=$('.paper',rig), rows=[...paper.children], led=$('.led',rig), pr=$('.printer',rig);
  const wys=()=>{rig.style.height=(paper.offsetHeight+63)+'px';}; wys();
  let last=-1;
  return {wys, rowEnd:i=>rows[i].offsetTop+rows[i].offsetHeight+6, H:()=>paper.offsetHeight,
    set(len){const v=len.toFixed(1)+'px'; if(clip.style.height!==v)clip.style.height=v; const ruch=Math.abs(len-last)>.3&&len>2&&len<paper.offsetHeight-1;
      led.classList.toggle('blink',ruch); pr.classList.toggle('druk',ruch); last=len;}};
