/* ───── 3. przepisywanie ───── */
const clk3=$('#clk3');
function s3(p){
  const e=T.erp;
  type(E.inp[0],seg(p,.02,.07),E.inp[0].dataset.type); type(E.inp[1],seg(p,.07,.1),E.inp[1].dataset.type);
  const W=[[.1,.23],[.24,.36],[.38,.62],[.64,.78]]; let total=0, zi=0;
  E.rows.forEach((row,i)=>{
    const [s,en]=W[i], t=seg(p,s,en), cells=[...row.children].slice(1); if(p>=s)zi=i+1;
    if(i===2){
      const bad=e.rows[2][0], good=e.rows[2][4], k=cells[0];
