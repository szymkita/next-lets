const qs=new URLSearchParams(location.search);
let start=qs.get('typ'); if(!B[start]){try{start=localStorage.getItem('mzTyp');}catch(e){start=null;}}
setTyp(B[start]?start:'handel');
const IDS=['paragon','mail','przepisywanie','reszta','skala','zmiana','po'], S={}, P={};
IDS.forEach(id=>{S[id]=document.getElementById(id);P[id]=0;});
const prog=el=>{const r=el.getBoundingClientRect();const tot=r.height-innerHeight;return tot<=0?0:cl(-r.top/tot);};
const snap=()=>window.__snap||qs.has('s');
const bar=$('#bar'), barCta=$('#barCta'), meter=$('#meter'), mlb=$('#mlb'), mzl=$('#mzl'), mmn=$('#mmn'), jak=$('#jak'), plz=$('#policzmy');
let lastMin=-1;
function frame(){
  const sn=snap();
  IDS.forEach(id=>{const t=prog(S[id]); let c=P[id]; c=sn?t:c+(t-c)*.16; if(Math.abs(t-c)<.0006)c=t; P[id]=c;});
  s1(P.paragon); const m2=s2(P.mail), m3=s3(P.przepisywanie), r4=s4(P.reszta); s5(P.skala); const m7=s7(P.zmiana); s8(P.po);
  const vh=innerHeight, po=S.zmiana.getBoundingClientRect().top<vh*.5;
  const on=S.mail.getBoundingClientRect().top<vh*.15 && jak.getBoundingClientRect().top>vh*.3;
  meter.classList.toggle('on',on); barCta.classList.toggle('off',on); meter.classList.toggle('po',po);
  let mins,money;
  if(po){mins=m7; money=mins*T.rate/60; if(mlb.textContent!=='po zmianie')mlb.textContent='po zmianie';}
  else{mins=m2+m3+r4.min; money=mins*T.rate/60+r4.zl; if(mlb.textContent!=='obsługi')mlb.textContent='obsługi';}
  const zt=zl(money); if(mzl.textContent!==zt)mzl.textContent=zt;
  const mi=Math.floor(mins+1e-6), mt=mi+' min'; if(mmn.textContent!==mt)mmn.textContent=mt;
  if(mi!==lastMin&&lastMin>=0&&on){meter.classList.remove('bump');void meter.offsetWidth;meter.classList.add('bump');} lastMin=mi;
  bar.classList.toggle('off',plz.getBoundingClientRect().top<vh*.55);
  requestAnimationFrame(frame);
}
