/* ───── lekcja i paragon CTA: pojawiają się, gdy wejdą na ekran ───── */
const naEkran=(el,cb,th=.4)=>{if(!('IntersectionObserver' in window)){cb();return;} new IntersectionObserver((es,o)=>es.forEach(x=>{if(x.isIntersecting){cb();o.disconnect();}}),{threshold:th}).observe(el);};
