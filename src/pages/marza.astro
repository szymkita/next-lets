      const isBad=tA>=1&&tDel<1; row.classList.toggle('bad',isBad);
      const eon=seg(p,s+.065,s+.08)*(1-seg(p,s+.12,s+.14)); E.err.style.opacity=eon; E.err.style.transform=`translateY(${(1-eo(eon))*6}px)`;
      const rest=seg(p,s+.19,en); cells.slice(1).forEach((c,j)=>type(c,seg(rest,j*.25,j*.25+.45),c.dataset.type));
    } else {
      const sg=[[0,.3],[.3,.75],[.75,.85],[.85,1]]; cells.forEach((c,j)=>type(c,seg(t,sg[j][0],sg[j][1]),c.dataset.type));
    }
