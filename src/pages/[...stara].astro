---
// STRONY PRZENIESIONE ZE STAREGO SERWISU — ten sam adres, ta sama treść.
//
// Po co: na start nowej strony nie wszystkie stare podstrony mają
// następców, a Google zna je pod starymi adresami (/o-nas: 326 kliknięć
// rocznie, doradztwo: 79, szkolenia: 74). Zamiast przekierowania stoi tu
// stara treść 1:1 w szablonie nowej strony — z nową nawigacją, stopką
// i działającym formularzem. Kiedy powstanie następca, ten adres dostaje
// przekierowanie na niego, a plik z src/content/stare-strony znika.
//
// Treść: src/content/stare-strony/*.json (docs/_migracja/strony-webflow.py).
// Lista wszystkich starych adresów i decyzji: docs/stare-adresy.md.
//
// UKŁAD
//   1. wejście — z pierwszej sekcji: etykieta, nagłówek, do dwóch akapitów,
//      przyciski i obrazy; reszta pierwszej sekcji idzie jako zwykła sekcja
//   2. sekcje starej strony po kolei, tła na przemian; sekcje-wezwania
//      (w Webflow klasy *cta*) na ciemnym pasie
//   3. sekcja z formularzem → wspólny moduł kontaktowy (GcCta) z nagłówkiem
//      i leadem starej sekcji
//
// Tytuł i opis meta są ze starej strony bez zmian. Jedna poprawka:
// gdy stara strona nie miała h1 (sześć stron usług), pierwszy nagłówek
// wejścia staje się h1.
import { getCollection } from 'astro:content';
import LaBase from '../layouts/LaBase.astro';
import GcCta from '../components/GcCta.astro';
import Bloki from '../components/stare/Bloki.astro';

export async function getStaticPaths() {
  const strony = await getCollection('stare-strony');
  return strony.map((s) => ({ params: { stara: s.data.adres.slice(1) }, props: { strona: s.data } }));
}

const { strona } = Astro.props;
const goly = (h = '') => h.replace(/<br\s*\/?>/g, ' ').replace(/<[^>]+>/g, '').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/\s+/g, ' ').trim();

const maH1 = strona.sekcje.some((s) => JSON.stringify(s.bloki).includes('"t":"h","n":1'));

// ---- wejście ----
const [pierwsza, ...dalej] = strona.sekcje;
const plaskie = pierwsza.bloki.flatMap((b) => (b.t === 'grupa' && b.rodzaj === 'karty' ? b.items.flat() : [b]));
const wejscie = [];
let reszta = [];
{
  const iH = plaskie.findIndex((b) => b.t === 'h');
  let i = 0, akapity = 0;
  for (; i < plaskie.length; i++) {
    const b = plaskie[i];
    if (iH >= 0 && i < iH) { wejscie.push(b); continue; }
    if (i === iH) { wejscie.push(!maH1 ? { ...b, n: 1 } : b); continue; }
    if (b.t === 'p' && akapity < 2) { wejscie.push(b); akapity++; continue; }
    if (b.t === 'cta' || b.t === 'img' || (b.t === 'grupa' && b.items.every((it) => it.every((x) => x.t === 'img')))) { wejscie.push(b); continue; }
    break;
  }
  reszta = plaskie.slice(i);
}
const naglowekWejscia = wejscie.find((b) => b.t === 'h');
const tekstWejscia = wejscie.filter((b) => !(b.t === 'img' || b.t === 'grupa'));
const obrazyWejscia = wejscie.filter((b) => b.t === 'img');
const galeriaWejscia = wejscie.filter((b) => b.t === 'grupa');

const sekcje = [
  ...(reszta.length ? [{ klasa: pierwsza.klasa, formularz: false, bloki: reszta }] : []),
  ...dalej,
];
// Dokument (strony Pipedrive): jedna sekcja tekstu bez kart — węższa kolumna.
const dokument = strona.sekcje.length === 1 && !JSON.stringify(strona.sekcje).includes('"t":"grupa"');
const ciemna = (s) => /cta/i.test(s.klasa) && !s.formularz;

function doFormularza(s) {
  const iH = s.bloki.findIndex((b) => b.t === 'h');
  const lead = s.bloki.slice(iH + 1).find((b) => b.t === 'p');
  return {
    heading: iH >= 0 ? goly(s.bloki[iH].html) : 'Porozmawiajmy o automatyzacji Twojej firmy',
    lead: lead ? goly(lead.html) : '',
  };
}
let tlo = 0;
---
<LaBase title={strona.tytul} description={strona.opis} ctaHref="#kontakt" ctaLabel="Umów rozmowę" nav={null} topbar={false}>
<style is:global slot="head">
  .st-w{max-width:1440px;margin:0 auto}
  .st-sek{padding:clamp(56px,7vw,96px) max(clamp(20px,5vw,56px),calc((100% - 1440px) / 2))}
  .st-sek.st-miekka{background:#f4f8f2}
  .st-sek.st-ciemna{background:radial-gradient(900px 480px at 88% 0%, rgba(0,205,119,0.16), transparent 62%),#0e2b1d;color:#ffffff}
  .st-sek > .st-w{display:flex;flex-direction:column;align-items:flex-start;gap:16px}
  .st-dok > .st-w{max-width:760px}

  /* tekst */
  .st-et{margin:0;font-size:13px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#0a7a52}
  .st-ciemna .st-et{color:#00CD77}
  .st-h{margin:0;color:#16211a;text-wrap:balance;letter-spacing:-0.02em;font-weight:800}
  .st-h :is(strong,b){font-weight:inherit}
  .st-tytul{font-size:clamp(28px,4vw,46px);line-height:1.06;letter-spacing:-0.032em;max-width:24ch}
  .st-h2{font-size:clamp(24px,3vw,34px);line-height:1.12;max-width:28ch}
  .st-h3{font-size:clamp(20px,2.3vw,26px);line-height:1.2}
  .st-h4{font-size:18px;line-height:1.3}
  .st-hk{font-size:18px;line-height:1.3;letter-spacing:-0.01em}
  .st-ciemna .st-h{color:#ffffff}
  .st-p{margin:0;max-width:70ch;font-size:16.5px;line-height:1.65;color:#33413a;text-wrap:pretty}
  .st-tytul + .st-p{font-size:clamp(16.5px,1.8vw,18.5px);color:#4c5850}
  .st-ciemna .st-p{color:rgba(255,255,255,0.78)}
  .st-p a,.st-lista a,.st-a a{color:#0a7a52;font-weight:650;text-decoration:underline;text-underline-offset:3px}
  .st-ciemna .st-p a{color:#00CD77}
  .st-lista{margin:0;padding:0 0 0 22px;display:grid;gap:9px;max-width:72ch;font-size:16px;line-height:1.6;color:#33413a}
  .st-lista li::marker{color:#0a7a52}
  .st-ciemna .st-lista{color:rgba(255,255,255,0.8)}

  /* przyciski */
  .st-cty{display:flex;flex-wrap:wrap;gap:10px;margin-top:6px}
  .st-cta{display:inline-flex;align-items:center;gap:6px;padding:14px 22px;border-radius:11px;background:#16211a;color:#ffffff;font-size:15px;font-weight:700;transition:background .18s}
  .st-cta:hover{background:#0a7a52}
  .st-cta-2{background:transparent;color:#16211a;border:1px solid #cfdacc}
  .st-cta-2:hover{background:transparent;border-color:#0a7a52;color:#0a7a52}
  .st-ciemna .st-cta{background:var(--la-accent,#00CD77);color:#0b1a11}
  .st-karta .st-cta{padding:10px 16px;font-size:14px}

  /* obrazy */
  .st-obrazy{width:100%;display:grid;gap:16px}
  .st-obrazy img{display:block;max-width:100%;height:auto;border-radius:14px}
  .st-sek .st-obrazy:not(.st-obrazy-n) img{width:auto;max-height:400px}
  .st-portret img,.st-sek .st-portret img{width:96px;height:96px;max-height:none;object-fit:cover;border-radius:50%}
  .st-obrazy-n{grid-template-columns:repeat(auto-fill,minmax(160px,1fr));align-items:center}
  .st-obrazy-n img{max-height:220px;width:auto;margin:0 auto;border-radius:10px}
  .st-galeria{display:flex;flex-wrap:wrap;gap:10px}
  .st-galeria img{width:84px;height:84px;object-fit:cover;border-radius:50%;background:#e7ece4}

  /* karty, kroki, zakładki */
  .st-karty{width:100%;display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:16px;margin-top:10px}
  .st-karty-2{grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr))}
  .st-k3{grid-template-columns:repeat(3,minmax(0,1fr))}
  .st-k4{grid-template-columns:repeat(4,minmax(0,1fr))}
  @media (max-width:1100px){ .st-k4{grid-template-columns:repeat(2,minmax(0,1fr))} }
  @media (max-width:900px){ .st-k3{grid-template-columns:repeat(2,minmax(0,1fr))} }
  @media (max-width:600px){ .st-k3,.st-k4{grid-template-columns:minmax(0,1fr)} }
  .st-karta{display:flex;flex-direction:column;align-items:flex-start;gap:10px;padding:22px;border:1px solid #e1e8de;border-radius:14px;background:#ffffff;min-width:0}
  .st-miekka .st-karta{border-color:#dfe7dd}
  .st-ciemna .st-karta{background:rgba(255,255,255,0.05);border-color:rgba(255,255,255,0.14)}
  .st-karta .st-p{font-size:15px;line-height:1.6}
  .st-karta .st-et{font-size:11.5px}
  .st-karta .st-obrazy img{border-radius:10px}
  .st-karta > .st-obrazy:first-child img{width:88px;height:88px;object-fit:cover;border-radius:50%;background:#e7ece4}
  .st-kt{margin:0;font-size:17px;line-height:1.35;font-weight:750;color:#16211a;letter-spacing:-0.01em}
  .st-ciemna .st-kt{color:#ffffff}
  .st-karta .st-karty{grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr))}
  .st-zakladki .st-karta{background:#ffffff}
  .st-kroki{list-style:none;margin:10px 0 0;padding:0;counter-reset:krok;width:100%;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:16px}
  .st-kroki > li{counter-increment:krok;display:flex;flex-direction:column;gap:10px;padding:22px;border-top:2px solid #16211a}
  .st-kroki > li::before{content:counter(krok,decimal-leading-zero);font-family:ui-monospace,Menlo,monospace;font-size:13px;color:#0a7a52}
  .st-kroki .st-p{font-size:15px}

  /* FAQ */
  .st-faq{width:100%;max-width:880px;border-top:1px solid #dfe7dd;margin-top:10px}
  .st-q{border-bottom:1px solid #dfe7dd}
  .st-q summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;gap:20px;padding:20px 0;font-size:17px;font-weight:700;line-height:1.4;color:#16211a}
  .st-q summary::-webkit-details-marker{display:none}
  .st-q summary::after{content:'+';flex-shrink:0;font-size:22px;line-height:1;color:#0a7a52;transition:transform .2s}
  .st-q[open] summary::after{transform:rotate(45deg)}
  .st-a{display:flex;flex-direction:column;gap:12px;padding:0 0 22px}

  /* wejście */
  .st-wej{position:relative;padding:clamp(40px,6vw,88px) max(clamp(20px,5vw,56px),calc((100% - 1440px) / 2)) clamp(48px,6vw,80px)}
  .st-wej-siatka{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,0.9fr);gap:clamp(32px,5vw,72px);align-items:center}
  .st-wej-siatka.st-bez-obrazu{grid-template-columns:minmax(0,1fr)}
  .st-wej-tekst{display:flex;flex-direction:column;align-items:flex-start;gap:18px}
  .st-wej h1,.st-wej .st-h{margin:0;font-size:clamp(34px,5.4vw,64px);line-height:1;letter-spacing:-0.04em;font-weight:800;color:#16211a;text-wrap:balance;max-width:20ch}
  .st-wej h1 :is(strong,b),.st-wej .st-h :is(strong,b){font-weight:inherit}
  .st-wej .st-p{font-size:clamp(16.5px,1.9vw,19px);color:#33413a;max-width:60ch}
  .st-wej-obraz{justify-self:center}
  .st-wej .st-obrazy img{width:auto;max-width:100%;max-height:440px;margin:0 auto;border-radius:18px}
  .st-wej .st-galeria{margin-top:clamp(28px,3vw,40px)}
  .st-dok-wej .st-wej-tekst{max-width:760px}
  @media (max-width:900px){ .st-wej-siatka{grid-template-columns:1fr} }
</style>

<!-- ============ 1 · WEJŚCIE ============ -->
<div aria-hidden="true" style="position:absolute;left:0;right:0;top:0;height:560px;background:radial-gradient(900px 520px at 12% -10%, rgba(0,205,119,0.14), transparent 62%);pointer-events:none"></div>
<section class={`st-wej${dokument ? ' st-dok-wej' : ''}`}>
<div class="st-w">
<div class={`st-wej-siatka${obrazyWejscia.length ? '' : ' st-bez-obrazu'}`}>
<div class="st-wej-tekst"><Bloki bloki={tekstWejscia} /></div>
{obrazyWejscia.length > 0 && <div class="st-wej-obraz"><Bloki bloki={obrazyWejscia} /></div>}
</div>
{galeriaWejscia.length > 0 && <Bloki bloki={galeriaWejscia} />}
</div>
</section>

<!-- ============ 2 · SEKCJE STAREJ STRONY ============ -->
{sekcje.map((s) => {
  if (s.formularz) {
    const f = doFormularza(s);
    return (
      <GcCta
        usluga={`Stara strona · ${strona.adres}`}
        heading={f.heading}
        lead={f.lead}
        osoba="ty"
        fieldLabel="Co chcesz usprawnić?"
        placeholder="Np. oferty przygotowujemy ręcznie w Excelu, trwa to dwa dni…"
        badges={[
          { i: 'klodka', t: 'Twoje dane bezpieczne' },
          { i: 'kartka', t: 'NDA przed startem' },
          { i: 'ptaszek', t: 'Bez zobowiązań' },
        ]}
      />
    );
  }
  const klasa = ciemna(s) ? 'st-sek st-ciemna' : (tlo++ % 2 === 0 ? 'st-sek st-miekka' : 'st-sek');
  return (
    <section class={`${klasa}${dokument ? ' st-dok' : ''}`}>
      <div class="st-w"><Bloki bloki={s.bloki} sekcja /></div>
    </section>
  );
})}
</LaBase>
