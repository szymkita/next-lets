<!-- ============ 7 · FORMULARZ NA KOŃCU ============ -->
<Kontakt
  tytul="Zacznijmy od jednego telefonu"
  lead="Zostawcie kontakt i jedno zdanie o procesie. Piotr oddzwoni w jeden dzień roboczy i sprawdzi, czy umiemy pomóc."
  zrodlo={ZRODLO}
  pytanie="Czego dotyczy sprawa?"
  podpowiedz="Np. zapytania ofertowe przychodzą mailem, a potem przepisujemy je do Excela i do ERP…"
  osoba={{ foto: '/piotr-wojciuk.jpg', w: 1002, h: 1100, imie: 'Piotr Wojciuk', rola: 'New Business Lead, oddzwania po zgłoszeniu' }}
  po="Bez zobowiązań. Odzywamy się w jeden dzień roboczy."
/>
</div>

<script>
  var redukcja = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- Formularz w hero ----
  // Ta sama umowa z /api/kontakt co w module Kontakt (e-mail i telefon
  // wymagane, pułapka na boty, 503 = formularz wyłączony) i te same zdarzenia
  // pomiaru. DO ZDARZEŃ NIE WCHODZI TREŚĆ FORMULARZA ANI DANE KONTAKTOWE.
  (function(){
    var form = document.querySelector('[data-zg-form]');
    if(!form) return;
    var ENDPOINT = '/api/kontakt', MAIL = 'hello@letsautomate.pl';
    var karta = form.parentNode, okBox = karta.querySelector('[data-zg-ok]');
    var btn = form.querySelector('[data-zg-submit]'), etykieta = form.querySelector('[data-zg-label]');
    var zgoda = form.querySelector('[data-zg-zgoda]'), wierszZgody = form.querySelector('[data-zg-zgoda-row]');
    var awaria = form.querySelector('[data-zg-awaria]');
    var zrodlo = form.dataset.zrodlo || '';
    var wysylam = false, zaczety = false;
    function pomiar(nazwa, powod){
      var dane = { event: nazwa, usluga: zrodlo, strona: location.pathname };
      if(powod) dane.powod = powod;
      try {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push(dane);
        document.dispatchEvent(new CustomEvent('la:pomiar', { detail: dane }));
      } catch(e){}
    }
    var REGULY = [
      { pole: 'email', msg: 'Adres e-mail wygląda na niepełny.', ok: function(v){ return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v); } },
      { pole: 'telefon', msg: 'Numer telefonu ma za mało cyfr.', ok: function(v){ return v.replace(/\D/g, '').length >= 9; } },
      // Opis sprawy obowiązkowy od 16.10.2026 (Szymon) — we wszystkich formularzach.
      { pole: 'wiadomosc', msg: 'To pole jest wymagane.', ok: function(v){ return v.length > 0; } }
    ];
    function pole(el){ return el && el.closest ? el.closest('.kt-pole') : null; }
    function blad(el, msg){ var f = pole(el); if(!f) return; f.classList.add('err'); el.setAttribute('aria-invalid', 'true'); f.querySelector('.kt-err').textContent = msg; }
    function dobrze(el){ var f = pole(el); if(!f) return; f.classList.remove('err'); el.removeAttribute('aria-invalid'); }
    function sprawdz(){
      var pierwszy = null;
      REGULY.forEach(function(r){
        var el = form.elements[r.pole], v = (el.value || '').trim();
        if(v && r.ok(v)) dobrze(el);
        else { blad(el, v ? r.msg : 'To pole jest wymagane.'); if(!pierwszy) pierwszy = el; }
      });
      wierszZgody.classList.toggle('err', !zgoda.checked);
      if(!zgoda.checked && !pierwszy) pierwszy = zgoda;
      return pierwszy;
    }
    form.addEventListener('input', function(e){
      if(pole(e.target)) dobrze(e.target);
      if(!zaczety){ zaczety = true; pomiar('formularz_start'); }
    });
    zgoda.addEventListener('change', function(){ wierszZgody.classList.toggle('err', !zgoda.checked); });
    function telefon(){ return (form.elements.kierunkowy.value + ' ' + (form.elements.telefon.value || '').trim()).trim(); }
    function opis(){ return (form.elements.wiadomosc.value || '').trim(); }
    function pokazOk(bezPomiaru){
      var echo = okBox.querySelector('[data-zg-echo]'), mail = (form.elements.email.value || '').trim();
      if(echo && mail) echo.textContent = mail;
      if(!bezPomiaru) pomiar('formularz_sukces');
      form.hidden = true;
      okBox.hidden = false;
      okBox.scrollIntoView({ block: 'nearest' });
      okBox.focus({ preventScroll: true });
    }
    var AWARIE = {
      'brak-konfiguracji': ['Formularz jest chwilowo wyłączony.', 'Zgłoszenie nie zostało wysłane, a ponowna próba nic nie zmieni.'],
      'domyslna': ['Zgłoszenie nie doszło.', 'Wpisane dane zostały w formularzu — spróbujcie jeszcze raz za chwilę.']
    };
    function pokazAwarie(kod){
      pomiar('formularz_blad', kod || 'domyslna');
      var tr = AWARIE[kod] || AWARIE.domyslna;
      awaria.querySelector('[data-zg-awaria-t]').textContent = tr[0];
      awaria.querySelector('[data-zg-awaria-d]').textContent = tr[1];
      awaria.querySelector('[data-zg-mailto]').href = 'mailto:' + MAIL
        + '?subject=' + encodeURIComponent('Bezpłatna konsultacja — zgłoszenie')
        + '&body=' + encodeURIComponent('E-mail: ' + (form.elements.email.value || '').trim() + '\nTelefon: ' + telefon() + '\n\n' + opis());
      awaria.hidden = false;
      awaria.scrollIntoView({ block: 'nearest' });
    }
    form.addEventListener('submit', function(e){
      e.preventDefault();
      if(wysylam) return;
      var zly = sprawdz();
      if(zly){ zly.focus(); return; }
      wysylam = true;
      btn.disabled = true;
      btn.classList.add('wysyla');
      var napis = etykieta.textContent;
      etykieta.textContent = 'Wysyłam…';
      awaria.hidden = true;
      fetch(ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({
          email: (form.elements.email.value || '').trim(),
          telefon: telefon(),
          wiadomosc: opis(),
          firma_www: form.elements.firma_www.value || '',
          zrodlo: zrodlo
        })
      })
        .then(function(r){
          if(r.ok){
            btn.classList.remove('wysyla');
            btn.classList.add('wyslane');
            etykieta.textContent = 'Wysłane';
            return redukcja ? pokazOk() : setTimeout(pokazOk, 850);
          }
          return r.json().catch(function(){ return {}; }).then(function(j){ throw new Error(j.blad || 'domyslna'); });
        })
        .catch(function(err){
          wysylam = false;
          btn.disabled = false;
          btn.classList.remove('wysyla');
          etykieta.textContent = napis;
          pokazAwarie(err && err.message);
        });
    });
    // Odnośniki do formularza w hero ustawiają kursor w pierwszym polu.
    document.querySelectorAll('a[href="#formularz"]').forEach(function(a){
      a.addEventListener('click', function(){
        pomiar('cta_klik');
        setTimeout(function(){ if(!form.hidden) form.elements.email.focus({ preventScroll: true }); }, 450);
      });
    });
    // Podgląd ekranu po wysłaniu bez wysyłki: ?sukces=1
    if(location.search.indexOf('sukces=1') > -1){
      form.elements.email.value = 'jan@firma.pl';
      pokazOk(true);
    }
  })();

  // ---- Wyniki: strzałki przewijają o jedną kartę (kopia z Dowody.astro);
  // gdy wszystkie karty mieszczą się w rzędzie, strzałki znikają ----
  (function(){
    var sc = document.querySelector('[data-dw-sc]');
    if(!sc) return;
    var wstecz = document.querySelector('[data-dw-wstecz]');
    var dalej = document.querySelector('[data-dw-dalej]');
    var dol = document.querySelector('#dowody .dw-dol');
