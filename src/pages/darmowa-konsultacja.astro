---
// BEZPŁATNA KONSULTACJA — /darmowa-konsultacja
// 16.10.2026 weszła tu dawna /darmowa-konsultacja-v4 (wariant zostaje pod tym adresem
// z noindex). Poprzednia wersja: /darmowa-konsultacja-old.
// Strona konwersji: jedno zadanie, wysłanie formularza. Układ jak strony konsultacji
// w grupie (wisegroup.pl, sellwise.pl, adwise.pl /bezplatna-konsultacja): w hero tekst,
// formularz i portret osoby, która oddzwania; pod spodem krótko to, co rozwiewa
// wątpliwości przed zgłoszeniem; na końcu ten sam formularz (moduł Kontakt).
// Treść z /darmowa-konsultacja-v3, język wizualny nowych podstron (tokeny i klasy
// z src/components/usluga/Styl.astro, formularz w wyglądzie modułu Kontakt).
//
// Kolejność: hero z formularzem → logotypy → zdania z rozmów → przebieg w czterech
// krokach (kto i kiedy) → co zostaje u Was → wyniki wdrożeń i cytat → FAQ → formularz.
// „Czego nie będzie" i „Jak się przygotować" z v3 weszły do FAQ.
//
// Formularz w hero ma własne atrybuty (data-zg-*) i własny skrypt: skrypt modułu
// Kontakt obsługuje jeden formularz na stronie ([data-kt-form]), ten na dole.
// Podgląd ekranu po wysłaniu: /darmowa-konsultacja?sukces=1
//
// DO POTWIERDZENIA PRZED PUBLIKACJĄ
//   1. Czas konsultacji nie pada na stronie (16.10.2026: rzadko kończy się
//      w 30 minut, a po rozmowie pracujemy dalej nad planem). Od tego dnia
//      także reszta serwisu mówi zamiast tego „bez zobowiązań”.
//   2. Marcel Bilski (Tech Lead) jako osoba prowadząca konsultację.
//   3. Przykład w „Co zostaje u Was": kwota 24 000 zł i pięć tygodni są przykładowe.
//   4. Cztery wyniki — te same co w #dowody na stronie głównej.
import LaBase from '../layouts/LaBase.astro';
import GcFaq from '../components/GcFaq.astro';
import Styl from '../components/usluga/Styl.astro';
import Anim from '../components/usluga/Anim.astro';
import Loga from '../components/usluga/Loga.astro';
import Cytat from '../components/usluga/Cytat.astro';
import CtaPasek from '../components/usluga/CtaPasek.astro';
import Kontakt from '../components/usluga/Kontakt.astro';
import { HI, SYGNET } from '../components/usluga/ikony';

const title = "Bezpłatna konsultacja — Let's automate";
const description = 'Krótki telefon, potem konsultacja o jednym procesie w Waszej firmie z osobą, która takie systemy buduje. Po niej dostajecie plan działania z ceną pierwszego etapu. Bezpłatnie i bez zobowiązań.';
const ZRODLO = 'Bezpłatna konsultacja';
const dwa = (n: number) => String(n).padStart(2, '0');

// Zdania, od których zaczynają się pierwsze rozmowy — te same co na stronie
// głównej i na /dlaczego-my.
const ZDANIA = [
  'Mamy siedem narzędzi i żadne nie rozmawia z pozostałymi.',
  'Zespół zbudował sobie aplikację w AI. Działa, tylko nikt nie wie, czy jest bezpieczna.',
  'Rok temu kupiliśmy strategię AI. Leży w PDF-ie.',
  'Ludzie proszą o AI, a ja nie chcę kolejnego pilota, z którego nic nie wynika.',
  'Mam na biurku trzy oferty i każda mówi dokładnie to samo.',
];

// Przebieg od formularza do planu. Ostatni krok to wynik, po który klient przychodzi.
const KROKI = [
  { t: 'Wypełniacie formularz', d: 'Dwa pola kontaktowe i jedno zdanie o tym, co Was uwiera.', kiedy: 'minuta' },
  { t: 'Dzwoni Piotr', d: 'Pyta, o czym jest sprawa i czy umiemy w niej pomóc. Kiedy nie umiemy, mówi to od razu.', kiedy: 'w 1 dzień roboczy',
    os: { f: '/piotr-avatar.jpg', n: 'Piotr Wojciuk', r: 'New Business Lead' } },
  { t: 'Konsultacja', d: 'Rozmowa z osobą, która takie systemy buduje: jak proces wygląda dziś, gdzie się zacina i co ma się zmienić, żeby było warto.', kiedy: 'w terminie, który Wam pasuje',
    os: { f: '/marcel-bilski.jpg', n: 'Marcel Bilski', r: 'Tech Lead' } },
  { t: 'Plan działania z ceną', d: 'Po konsultacji rozpisujemy pomysł na rozwiązanie i kolejne kroki, a pierwszy etap wyceniamy kwotą stałą.', kiedy: 'po konsultacji', mocny: true },
];

// Wyniki wdrożeń — ta sama czwórka co w #dowody na stronie głównej.
const WYNIKI = [
  { dz: 'Finanse', p: 'Obieg faktur kosztowych', l: '99,7%', ld: 'skuteczności księgowania',
    przed: 'Trzy osoby przepisują faktury z maili, zaległości rosną.',
    po: 'Faktury z maili księgują się same, zespół zajmuje się wyjątkami.' },
  { dz: 'Sprzedaż', p: 'Przygotowanie oferty', l: '−80%', ld: 'czasu przygotowania oferty',
    przed: 'Oferta sklejana z CRM, cenników i maili zajmuje pół dnia.',
    po: 'Szkic oferty powstaje z danych CRM w kilka minut, handlowiec go dopina.' },
  { dz: 'Operacje', p: 'Raport tygodniowy', l: '65 h', ld: 'odzyskanych co miesiąc',
    przed: 'Raport klejony z czterech arkuszy, decyzje na danych sprzed miesiąca.',
    po: 'Dane spływają same, raport czeka w poniedziałek o 7:00.' },
  { dz: 'Obsługa klienta', p: 'Pytania o zamówienia', l: '−90%', ld: 'zapytań obsługiwanych ręcznie',
    przed: 'Zespół odpisuje na te same pytania kilkanaście razy dziennie.',
    po: 'Agent AI odpowiada w kilka minut, z danymi zamówienia.' },
];

const faq = [
  {
    q: 'Czym dokładnie jest ta bezpłatna konsultacja?',
    a: 'To dwie rozmowy i praca po nich. Najpierw krótki telefon: o czym jest sprawa i czy umiemy w niej pomóc. Potem konsultacja z osobą, która takie systemy wdraża, o tym, jak Wasz proces wygląda dziś i co da się z nim zrobić. Po konsultacji rozpisujemy plan działania i wyceniamy jego pierwszy etap.',
  },
  {
    q: 'Czy konsultacja zobowiązuje do współpracy?',
    a: 'Nie. Konsultacja jest bezpłatna, a plan zostaje u Was. Możecie go zrealizować z własnym zespołem albo z inną firmą.',
  },
  {
    q: 'Nie mamy sprecyzowanego pomysłu. Czy to ma sens?',
    a: 'Wtedy ma największy. Wystarczy jeden proces, który Was uwiera, resztę wyciągniemy pytaniami. Ustalenie, co da się usprawnić i w jakiej kolejności, jest częścią konsultacji.',
  },
  {
    q: 'Jak się przygotować?',
    a: 'Nie potrzeba dokumentacji ani gotowego planu. Wystarczy pomyśleć o jednym procesie, który zabiera najwięcej ręcznej pracy. Zapytamy o wielkość firmy i działy, przez które przechodzi sprawa, o branżę, o to, co dziś najbardziej się zacina, i czego oczekujecie po wyniku.',
  },
  {
    q: 'Kto prowadzi konsultację?',
    a: 'Pierwszy telefon odbiera Piotr z new businessu. Na samej konsultacji jest już osoba, która potem odpowiada za wdrożenie, więc zna koszt tego, co proponuje. Nie mamy przygotowanej prezentacji o sobie, cała rozmowa idzie po Waszym procesie.',
  },
  {
    q: 'Czy będziecie namawiać nas na AI?',
    a: 'Nie. Część spraw tanio załatwia zmiana w procesie albo narzędzie, które już macie. Kiedy tak jest, mówimy to na konsultacji.',
  },
  {
    q: 'Co, jeśli nie umiecie nam pomóc?',
    a: 'Mówimy to w pierwszym telefonie i wtedy nie umawiamy konsultacji. Spotkanie na siłę zabrałoby czas obu stronom.',
  },
  {
    q: 'Mamy gotowy projekt. Możecie go od razu wycenić?',
    a: 'Tak. Wtedy pomijamy rozpoznanie procesu i rozmawiamy o zakresie i terminie. Opiszcie projekt w formularzu, a na rozmowę przyjdziemy z pytaniami do wyceny.',
  },
  {
    q: 'Jak wygląda sama konsultacja?',
    a: 'Online przez Google Meet albo Zoom, link przychodzi w zaproszeniu. Jeśli wolicie telefon, dzwonimy. Na rozmowę rezerwujemy tyle czasu, ile wymaga sprawa. Gdy proces przechodzi przez kilka działów i systemów, zwykle jest to więcej niż pół godziny.',
  },
  {
    q: 'Co z naszymi danymi?',
    a: 'Pracujemy zgodnie z RODO, a NDA podpisujemy także przed samą konsultacją, jeśli tego potrzebujecie. Do rozmowy nie potrzebujemy dostępu do żadnego z Waszych systemów.',
  },
];

const kanon = new URL('/darmowa-konsultacja', Astro.site).href;
const dane = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${kanon}#usluga`,
      name: 'Bezpłatna konsultacja',
      serviceType: 'Konsultacja automatyzacji procesów i wdrożeń AI',
      url: kanon,
      description: 'Bezpłatna konsultacja w Let’s automate: krótki telefon, potem konsultacja o jednym procesie w firmie z osobą, która takie systemy wdraża. Po niej klient dostaje plan działania: pomysł na rozwiązanie, kolejne kroki i cenę pierwszego etapu.',
      provider: { '@id': new URL('/#organizacja', Astro.site).href },
      areaServed: { '@type': 'Country', name: 'Polska' },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'PLN' },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${kanon}#okruszki`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Strona główna', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: 'Bezpłatna konsultacja', item: kanon },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${kanon}#faq`,
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
      })),
    },
  ],
};
---
<LaBase topbar={false} title={title} description={description} ctaHref="#formularz" ctaLabel="Umów konsultację" nav={null}>
<script type="application/ld+json" is:inline set:html={JSON.stringify(dane)} slot="head"></script>
<style is:global slot="head">
  /* =====================================================================
     HERO · plansza modułu Kontakt: tekst, formularz wprost na ciemnym tle
     (bez osobnego panelu, jak w Kontakt v12a), wąski portret osoby, która
     oddzwania. Szersza kolumna formularza, węższa portretu.
     ===================================================================== */
  .zg{padding:0 var(--ram);scroll-margin-top:84px}
  .zg .kt-in{--kp:clamp(40px,4.4vw,64px);grid-template-columns:minmax(0,4.6fr) minmax(0,5.4fr) minmax(0,2.3fr)}
  @media (max-width:1180px){ .zg .kt-in{grid-template-columns:minmax(0,1fr) minmax(0,1.3fr) minmax(0,0.5fr)} }
  .zg .hi{display:block;flex-shrink:0;fill:currentColor}
  .zg .kt-os img{object-position:42% 16%}
  .zg .kt-os figcaption{left:18px;right:14px}
  .zg .kt-os figcaption span{font-size:12.5px}
  .zg-h1{margin:0;font-size:clamp(34px,3.3vw,50px);line-height:1;letter-spacing:-0.045em;font-weight:700;color:#ffffff;text-wrap:balance}
  .zg-h1 span{color:var(--ziel)}
  .zg .kt-lewa .v3-sub{max-width:440px}
  .zg .kt-karta h2{margin:0 0 22px;font-size:clamp(22px,1.9vw,26px);font-weight:700;letter-spacing:-0.025em;line-height:1.15;color:#ffffff}
  .zg-kroki{margin:18px 0 0;padding:0;list-style:none;counter-reset:k}
  .zg-kroki li{display:grid;grid-template-columns:28px minmax(0,1fr);gap:10px;align-items:baseline;padding:10px 0;border-top:1px solid rgba(255,255,255,0.14);font-size:14.5px;line-height:1.5;color:rgba(255,255,255,0.72)}
  .zg-kroki li::before{counter-increment:k;content:"0" counter(k);font-size:12.5px;font-weight:650;color:var(--ziel)}
  .zg-kroki b{color:#ffffff}
  @media (max-width:1000px){ .zg .kt-karta h2{font-size:22px} }

  /* =====================================================================
     ZDANIA Z ROZMÓW · wątek: pięć zdań klienta i nasza odpowiedź
     ===================================================================== */
  .v3-h2.sr{font-size:clamp(32px,3.6vw,54px)}
  /* Strona konwersji: sekcje krótsze niż na podstronach usługowych, żeby
     od hero do formularza na końcu było jak najmniej przewijania. */
  .v3 > .v3-sek{padding-top:clamp(64px,7.5vw,112px);padding-bottom:clamp(64px,7.5vw,112px)}
  .zd{display:grid;grid-template-columns:minmax(0,4.6fr) minmax(0,7.4fr);gap:clamp(32px,5vw,96px);align-items:center}
  .zd .v3-sub{margin-top:22px;max-width:420px}
  .zd-w{display:flex;flex-direction:column;align-items:flex-start;gap:10px}
  .zd-d{max-width:620px;padding:15px 20px;border-radius:20px 20px 20px 6px;background:#ffffff;font-size:clamp(16px,1.35vw,18px);line-height:1.45;letter-spacing:-0.012em;color:var(--t1);text-wrap:pretty;
    box-shadow:0 0 0 1px rgba(15,26,20,0.06),0 14px 30px -26px rgba(15,26,20,0.5)}
  .zd-d:nth-child(2n){margin-left:clamp(0px,3vw,44px)}
  .zd-n{display:flex;align-items:center;gap:12px;align-self:flex-end;margin-top:8px;padding:15px 22px 15px 15px;border-radius:20px 20px 6px 20px;background:var(--ink);color:#ffffff;font-size:clamp(16px,1.35vw,18px);line-height:1.45;letter-spacing:-0.012em}
  .zd-n i{flex-shrink:0;display:grid;place-items:center;width:32px;height:32px;border-radius:50%;background:rgba(0,205,119,0.14)}
  .zd-n i svg{display:block;width:15px;height:15px;fill:var(--ziel)}
  .zd-n b{font-weight:700;color:var(--ziel)}
  .zd.gra .zd-d,.zd.gra .zd-n{opacity:0;transform:translateY(10px)}
  .zd.gra.on .zd-d,.zd.gra.on .zd-n{opacity:1;transform:none;transition:opacity .5s ease calc(var(--i) * .14s),transform .5s cubic-bezier(.2,.7,.2,1) calc(var(--i) * .14s)}
  @media (max-width:900px){ .zd{grid-template-columns:1fr} .zd-d:nth-child(2n){margin-left:0} }

  /* =====================================================================
     PRZEBIEG · cztery kroki na kropkowanej linii, kto i kiedy
     ===================================================================== */
  .pb{--g:clamp(20px,2.6vw,40px);position:relative;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--g);margin-top:clamp(48px,5vw,72px)}
  .pb::before{content:"";position:absolute;left:20px;right:calc((100% - 3 * var(--g)) / 4 - 20px);top:19px;height:1px;background:repeating-linear-gradient(90deg,rgba(15,26,20,0.28) 0 5px,transparent 5px 11px)}
  .pb-k{position:relative;display:flex;flex-direction:column}
  .pb-n{position:relative;z-index:1;display:grid;place-items:center;width:40px;height:40px;border-radius:50%;background:var(--ink);color:#ffffff;font-size:14px;font-weight:700;box-shadow:0 0 0 8px #ffffff}
  .pb-k.mocny .pb-n{background:var(--ziel);color:var(--ink)}
  .pb-k h3{margin:24px 0 0;font-size:clamp(19px,1.7vw,23px);font-weight:700;letter-spacing:-0.025em;line-height:1.15}
  .pb-os{display:flex;align-items:center;gap:10px;margin-top:12px;font-size:13.5px;line-height:1.3;color:var(--t2)}
  .pb-os img{flex-shrink:0;width:34px;height:34px;border-radius:50%;object-fit:cover;object-position:50% 14%;background:#e3e6e0}
  .pb-os b{display:block;font-weight:650;color:var(--t1)}
  .pb-k p{margin:12px 0 18px;font-size:15px;line-height:1.6;color:var(--t2);text-wrap:pretty}
  /* Czas u dołu kroku, we wszystkich czterech na tej samej wysokości */
  .pb-czas{display:inline-flex;align-self:flex-start;align-items:center;gap:7px;margin-top:auto;padding:8px 14px 8px 11px;border-radius:999px;background:var(--ink);color:#ffffff;font-size:13px;font-weight:650;white-space:nowrap}
  .pb-czas svg{display:block;width:14px;height:14px;fill:var(--ziel)}
  .pb-k.mocny .pb-czas{background:var(--ziel);color:var(--ink)}
  .pb-k.mocny .pb-czas svg{fill:var(--ink)}
  .pb-tel{display:flex;align-items:center;gap:10px;margin-top:clamp(40px,4vw,56px);padding-top:22px;border-top:1px solid var(--linia);font-size:15px;color:var(--t2)}
  .pb-tel svg{display:block;width:16px;height:16px;fill:var(--ziel-c)}
  .pb-tel a{font-weight:700;color:var(--ziel-c);white-space:nowrap}
  @media (max-width:1060px){ .pb{grid-template-columns:repeat(2,minmax(0,1fr));row-gap:44px} .pb::before{display:none} }
  @media (max-width:600px){ .pb{grid-template-columns:1fr;row-gap:34px} }

  /* =====================================================================
     CO ZOSTAJE U WAS · ciemna scena, trzy obiekty z prawdziwą treścią
     ===================================================================== */
  .zw{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:clamp(44px,5vw,72px);border-top:1px solid rgba(255,255,255,0.12);border-bottom:1px solid rgba(255,255,255,0.12)}
  .zw-k{display:flex;flex-direction:column;padding:clamp(24px,2.6vw,36px) clamp(20px,2.4vw,36px) clamp(28px,3vw,40px)}
  .zw-k + .zw-k{border-left:1px solid rgba(255,255,255,0.12)}
  .zw-ob{display:flex;align-items:center;justify-content:center;min-height:210px;padding:22px;border-radius:18px;background:rgba(255,255,255,0.045);box-shadow:inset 0 0 0 1px rgba(255,255,255,0.07)}
  .zw-k h3{margin:26px 0 0;font-size:clamp(19px,1.6vw,22px);font-weight:700;letter-spacing:-0.022em;color:#ffffff}
  .zw-k p{margin:10px 0 0;max-width:400px;font-size:15px;line-height:1.6;color:rgba(255,255,255,0.68);text-wrap:pretty}
  /* kartka planu */
  .zw-kar{width:100%;max-width:300px;padding:14px 16px 12px;border-radius:3px;background:#fffdf8;color:#141a16;font-size:12px;line-height:1.35;box-shadow:0 30px 50px -30px rgba(0,0,0,0.8)}
  .zw-kar-gl{display:flex;justify-content:space-between;gap:8px;padding-bottom:6px;border-bottom:1px solid rgba(15,26,20,0.12);font-size:10.5px;color:#7a827c}
  .zw-kar-gl span{display:inline-flex;align-items:center;gap:5px;font-weight:650;color:#141a16}
  .zw-kar-gl svg{display:block;width:10px;height:10px;fill:var(--ziel)}
  .zw-kar b.t{display:block;margin-top:9px;font-size:16px;font-weight:700;letter-spacing:-0.025em}
  .zw-kar small{display:block;margin-top:1px;font-size:10.5px;color:#7a827c}
  .zw-kar ol{margin:8px 0 0;padding:0;list-style:none}
  .zw-kar li{display:grid;grid-template-columns:22px minmax(0,1fr);align-items:baseline;padding:5px 0 5px 7px;border-top:1px solid rgba(15,26,20,0.07);font-weight:600}
  .zw-kar li.e1{box-shadow:inset 2px 0 0 var(--ziel)}
  .zw-kar li em{font-style:normal;font-family:var(--mono);font-size:10.5px;color:var(--ziel-c)}
  /* cena etapu */
  .zw-cena{width:100%;max-width:300px;padding:16px 18px;border-radius:3px;background:#fffdf8;color:#141a16;box-shadow:0 30px 50px -30px rgba(0,0,0,0.8)}
  .zw-cena span{display:block;font-size:12.5px;font-weight:650}
  .zw-cena small{display:block;margin-top:2px;font-size:11px;color:#7a827c}
  .zw-cena strong{display:flex;align-items:baseline;justify-content:space-between;gap:10px;margin-top:14px;padding-top:12px;border-top:1.5px solid #141a16;font-size:11.5px;font-weight:400;color:#7a827c}
  .zw-cena mark{padding:0 3px;font-size:30px;font-weight:750;letter-spacing:-0.04em;line-height:1;color:#141a16;background:linear-gradient(transparent 56%, rgba(0,205,119,0.5) 56%) no-repeat 0 0 / 100% 100%}
  .zw.gra .zw-cena mark{background-size:0% 100%}
  .zw.gra.on .zw-cena mark{background-size:100% 100%;transition:background-size .8s cubic-bezier(.4,0,.2,1) .5s}
  /* decyzja */
  .zw-dec{display:grid;grid-template-columns:1fr 1fr;gap:10px;width:100%;max-width:320px}
  .zw-dec div{padding:14px 14px 15px;border-radius:12px;font-size:12.5px;line-height:1.45}
  .zw-dec b{display:flex;align-items:center;gap:6px;margin-bottom:6px;font-size:13.5px;font-weight:700}
  .zw-dec b svg{display:block;width:14px;height:14px;fill:currentColor}
  .zw-dec .nie{background:rgba(255,255,255,0.06);box-shadow:inset 0 0 0 1px rgba(255,255,255,0.14);color:rgba(255,255,255,0.75)}
  .zw-dec .nie b{color:#ffffff}
  .zw-dec .tak{background:var(--ziel);color:var(--ink)}
