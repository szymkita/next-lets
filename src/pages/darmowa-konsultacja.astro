<!-- pasek CTA na mobile — pojawia się, gdy formularz zjedzie z ekranu -->
<div class="mob-cta hide" id="mobCta">
<a href={`tel:${CONTACT_PHONE.replace(/\s/g, '')}`} aria-label="Zadzwoń" style="display:flex;align-items:center;justify-content:center;width:48px;height:48px;flex-shrink:0;border:1px solid #e2eade;border-radius:11px;color:#0a7a52"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .3 1.9.6 2.8a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.5 2.8.6a2 2 0 0 1 1.7 2z"/></svg></a>
<a href="#formularz" style="flex:1;display:flex;align-items:center;justify-content:center;gap:8px;background:#0a7a52;color:#fff;padding:15px 20px;border-radius:11px;font-weight:750;font-size:16px">Umów konsultację <span aria-hidden="true">→</span></a>
</div>

<script>
  // ---- Sticky header: cień/obramowanie po scrollu ----
  (function(){
    var h = document.querySelector('.site-header');
    if(!h) return;
    function upd(){ h.classList.toggle('scrolled', window.scrollY > 65); }
    upd();
    window.addEventListener('scroll', upd, {passive:true});
  })();

  // ---- FAQ — akordeon ----
  (function(){
    var items = document.querySelectorAll('.faq-item');
    if(!items.length) return;
    items.forEach(function(item){
      var btn = item.querySelector('.faq-q');
      if(!btn) return;
      btn.addEventListener('click', function(){
        var willOpen = !item.classList.contains('open');
        items.forEach(function(other){
          other.classList.remove('open');
          var b = other.querySelector('.faq-q');
          if(b) b.setAttribute('aria-expanded', 'false');
        });
        if(willOpen){
          item.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  })();

  // Rotujące CTA prowadzi teraz komponent Nawigacja.astro. Kopia z tej strony
  // pisała do tego samego elementu równolegle z komponentem (bezpiecznik
  // `navInit` chroni tylko skrypt komponentu), więc napis migotał i gubił
  // wersję skróconą na telefonie.

  // ---- Pasek CTA na mobile: tylko gdy formularz jest poza ekranem ----
  (function(){
    var bar = document.getElementById('mobCta');
    var form = document.getElementById('formularz');
    if(!bar || !form || !('IntersectionObserver' in window)) return;
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ bar.classList.toggle('hide', e.isIntersecting); });
    }, { threshold: 0.12 });
    io.observe(form);
  })();

  // ---- Formularz: walidacja, wysyłka, stan sukcesu ----
  (function(){
    var form = document.getElementById('leadForm');
    if(!form) return;
    var endpoint = (form.dataset.endpoint || '').trim();
    var btn = document.getElementById('leadSubmit');
    var btnLabel = btn.querySelector('[data-label]');
    var okBox = document.getElementById('leadSuccess');
    var fallback = document.getElementById('leadFallback');
    var mailto = document.getElementById('leadMailto');

    var consent = document.getElementById('leadConsent');
    var consentRow = document.getElementById('consentRow');
    var RULES = [
      { id: 'leadEmail', msg: 'Sprawdź adres e-mail.',   test: function(v){ return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v); } },
      { id: 'leadPhone', msg: 'Sprawdź numer telefonu.', test: function(v){ return v.replace(/\D/g, '').length >= 9; } }
    ];

    function field(el){ return el.closest('.f-field'); }
    function passes(rule, v){ return v ? rule.test(v) : false; }

    function setErr(el, msg){
      var f = field(el); if(!f) return;
      f.classList.add('err');
      el.setAttribute('aria-invalid', 'true');
      var box = f.querySelector('.f-err');
      if(box && msg) box.textContent = msg;
    }
    function clearErr(el){
      var f = field(el); if(!f) return;
      f.classList.remove('err');
      el.removeAttribute('aria-invalid');
    }

    function validate(){
      var first = null;
      RULES.forEach(function(rule){
        var el = document.getElementById(rule.id);
        var v = (el.value || '').trim();
        if(passes(rule, v)){ clearErr(el); }
        else { setErr(el, v ? rule.msg : 'To pole jest wymagane.'); if(!first) first = el; }
      });
      consentRow.classList.toggle('err', !consent.checked);
      if(!consent.checked && !first) first = consent;
      return first;
    }

    // błąd znika, gdy tylko użytkownik poprawia pole
    form.addEventListener('input', function(e){ if(field(e.target)) clearErr(e.target); });
    consent.addEventListener('change', function(){ consentRow.classList.toggle('err', !consent.checked); });

    function showSuccess(){
      // Echo kontaktu — użytkownik od razu widzi, na co odpowiemy, i wyłapie literówkę.
      var echo = document.getElementById('okContact');
      var echoText = document.getElementById('okContactText');
      var mail = (document.getElementById('leadEmail').value || '').trim();
      if(echo && echoText && mail){
        echoText.textContent = mail;
        echo.hidden = false;
      }
      form.hidden = true;
      okBox.hidden = false;
      // karta zmienia wysokość — trzymamy ją w kadrze, zanim oddamy fokus
      okBox.scrollIntoView({ block: 'nearest' });
      okBox.focus();
    }

    // Podgląd ekranu podziękowania bez wysyłki: /darmowa-konsultacja?sukces=1
    if(location.search.indexOf('sukces=1') > -1){
      document.getElementById('leadEmail').value = 'jan@firma.pl';
      showSuccess();
    }

    function showFallback(){
      // Nie udajemy wysyłki — dajemy drogę, którą zgłoszenie naprawdę do nas dotrze.
      if(mailto){
        var mail = (document.getElementById('leadEmail').value || '').trim();
        var msg  = (document.getElementById('leadMsg').value || '').trim();
        var tel  = document.getElementById('leadPrefix').value + ' ' + (document.getElementById('leadPhone').value || '').trim();
        mailto.href = mailto.href.split('?')[0]
          + '?subject=' + encodeURIComponent('Bezpłatna konsultacja — zgłoszenie')
          + '&body=' + encodeURIComponent('E-mail: ' + mail + '\nTelefon: ' + tel + '\n\n' + msg);
      }
      fallback.hidden = false;
      fallback.scrollIntoView({ block: 'nearest' });
    }

    form.addEventListener('submit', function(e){
      e.preventDefault();
      var bad = validate();
      if(bad){ bad.focus(); return; }

      if(!endpoint){ showFallback(); return; }

      btn.disabled = true;
      var label = btnLabel.textContent;
      btnLabel.textContent = 'Wysyłam…';

      fetch(endpoint, { method: 'POST', headers: { 'Accept': 'application/json' }, body: new FormData(form) })
        .then(function(r){
          if(!r.ok) throw new Error('HTTP ' + r.status);
          showSuccess();
        })
        .catch(function(){
          btn.disabled = false;
          btnLabel.textContent = label;
          showFallback();
        });
    });
  })();
</script>

