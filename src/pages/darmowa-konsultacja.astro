---
import Nawigacja from '../components/Nawigacja.astro';
import Stopka from '../components/Stopka.astro';
// Landing konwersyjny: bezpłatna konsultacja.
// Bez klasycznego hero — formularz stoi nad zgięciem, w prawej kolumnie splitu.
//
// UWAGA: FORM_ENDPOINT musi wskazywać adres przyjmujący POST z formularza
// (własny endpoint, Formspree, HubSpot itp.). Dopóki jest pusty, formularz
// NIE udaje wysyłki — pokazuje drogę awaryjną z mailto, żeby nie gubić
// zgłoszeń po cichu.
const FORM_ENDPOINT = '';
const CONTACT_EMAIL = 'hello@letsautomate.pl';
const CONTACT_PHONE = '+48 571 399 932';
---
<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Bezpłatna konsultacja — Let's automate</title>
<meta name="description" content="30 minut rozmowy z założycielem Let's automate. Opowiadasz, jak pracujecie dziś — wychodzisz z konkretnym pierwszym krokiem. Bez zobowiązań i bez sprzedażowej gadki.">
<link rel="icon" href="/uploads/logo-2.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
<link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
<style>
  :root{--la-accent:#00CD77}
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;background:#ffffff;overflow-x:clip;font-family:'Schibsted Grotesk',system-ui,sans-serif;-webkit-font-smoothing:antialiased}
  a{color:inherit;text-decoration:none}
  /* reguła klasy autora bije [hidden] ze stylu przeglądarki — bez tego elementy
     z własnym display (np. .f-ok-echo) pokazują się mimo atrybutu hidden */
  [hidden]{display:none !important}
  ::selection{background:rgba(0,205,119,0.25)}
  /* Poświata biegnie od samej góry strony, więc pod nawigacją nie ma krawędzi koloru.
     Trzyma ją .page, a nie sekcja foldu — inaczej sticky header wychodzi poza tło. */
  .page{width:100%;margin:0 auto;background:radial-gradient(880px 560px at 88% 0, rgba(0,205,119,0.13), transparent 62%) no-repeat, #ffffff;color:#16211a}
  .nav-cta-sizer{visibility:hidden;pointer-events:none}
  .nav-cta-live{position:absolute;left:0;right:0;top:0;bottom:0;display:inline-flex;align-items:center;justify-content:center;white-space:nowrap}
  .nav-cta-caret{display:inline-block;width:2px;height:1.05em;margin-left:1px;background:currentColor;vertical-align:-0.14em;animation:cta-blink 1s steps(1) infinite}
  @keyframes cta-blink{0%,50%{opacity:1}50.01%,100%{opacity:0}}
  @media (prefers-reduced-motion:reduce){ .nav-cta-caret{animation:none;opacity:0} }

  /* hover / focus */
  .nav-lnk{padding:7px 11px;border-radius:9px;transition:color .15s,background .15s}
  .nav-lnk:hover{color:#0a7a52 !important;background:rgba(10,122,82,0.07)}
  .btn-dark{transition:background .2s,color .2s}
  .btn-dark:hover{background:#0a7a52 !important;color:#fff !important}
  .btn-accent{transition:background .2s}
  .btn-accent:hover{background:#00b96c !important;color:#0b1a11 !important}
  .lnk-green{transition:color .15s}
  .lnk-green:hover{color:#16211a !important}
  .foot-lnk{transition:color .15s}
  .foot-lnk:hover{color:#fff !important}

  /* ---------- STREFA NAD ZGIĘCIEM ---------- */
  .fold-grid{position:relative;z-index:1;display:grid;grid-template-columns:1fr 516px;gap:clamp(40px,5vw,80px);align-items:start;max-width:1240px;margin:0 auto}
  .fold-aside{padding-top:clamp(6px,1.4vw,20px)}
  .fa-h1{margin:0;font-size:clamp(32px,4.6vw,52px);line-height:1.04;letter-spacing:-0.032em;font-weight:800;color:#16211a;text-wrap:balance}
  .fa-lead{margin:20px 0 0;max-width:520px;font-size:clamp(16px,1.5vw,18.5px);line-height:1.58;color:#3d4a42;text-wrap:pretty}
  .fa-eyebrow{margin-top:clamp(28px,3vw,36px);font-family:ui-monospace,Menlo,monospace;font-size:11.5px;letter-spacing:0.14em;text-transform:uppercase;color:#808b83}
  .fa-list{display:flex;flex-direction:column;gap:13px;margin-top:15px;max-width:520px}
  .fa-item{display:flex;align-items:flex-start;gap:12px;font-size:15.5px;line-height:1.5;color:#3d4a42}
  .fa-item svg{flex-shrink:0;margin-top:2px}
  .fa-item strong{font-weight:700;color:#16211a}
  .fold-proof{display:flex;align-items:center;gap:20px;margin-top:clamp(30px,3.4vw,40px);padding-top:clamp(26px,3vw,32px);border-top:1px solid #e7ece4;max-width:520px}
  .fa-nm{font-size:15px;font-weight:750;color:#16211a}
  .fa-role{margin-top:2px;font-size:13px;line-height:1.45;color:#6d786f}
  .fa-num{font-size:21px;font-weight:800;letter-spacing:-0.02em;color:#16211a}
  .fa-lbl{margin-top:1px;font-size:12.5px;color:#6d786f}
  .fa-stars{font-size:15px;letter-spacing:1px;color:#0a7a52}
  .fa-group{display:flex;align-items:center;gap:15px;margin-top:26px}
  .fa-group span{font-family:ui-monospace,Menlo,monospace;font-size:11px;letter-spacing:0.13em;text-transform:uppercase;color:#93a094}
  .fa-group img{height:18px;width:auto;display:block;opacity:0.72}
  .fold-contact{position:relative;z-index:1;display:flex;justify-content:center;align-items:center;flex-wrap:wrap;gap:6px 14px;margin-top:clamp(30px,3.4vw,42px);font-size:15px;color:#4c5850}

  /* Poświata biegnie od samej góry .page, więc pod przyklejoną nawigacją nie ma
     krawędzi koloru. Każdy wariant zmienia tylko tę jedną powierzchnię. */
  .sec-plain{background:#ffffff}
  .sec-tint{background:#f4f8f2}

  /* ---------- FORMULARZ — ciemnozielone pudło, jak panele na stronie głównej ---------- */
  .form-card{position:relative;background:radial-gradient(120% 130% at 100% 0%, rgba(0,205,119,0.18), transparent 58%), #0e2b1d;border-radius:22px;box-shadow:0 44px 96px -46px rgba(8,26,17,0.72);overflow:hidden}
  /* wewnętrzna krawędź + akcentowa nitka u góry — pudło ma się odcinać od jasnej strony */
  .form-card::before{content:"";position:absolute;inset:0;border-radius:inherit;border:1px solid rgba(255,255,255,0.10);pointer-events:none;z-index:2}
  .form-card::after{content:"";position:absolute;top:0;left:14%;right:14%;height:1px;background:linear-gradient(90deg,transparent,rgba(0,205,119,0.7),transparent);pointer-events:none;z-index:2}
  .form-body{padding:clamp(28px,3vw,38px)}
  .f-field{display:block}
  .f-lab{display:block;font-size:12px;font-weight:600;letter-spacing:0.015em;color:rgba(255,255,255,0.62);margin-bottom:8px}
  .f-req{color:var(--la-accent,#00CD77);font-weight:700}

  /* Pola jasne — biel na ciemnym pudle. Cień pod polem sadza je na karcie,
     inaczej biały prostokąt wygląda jak dziura wycięta w tle. */
  .inp{width:100%;box-sizing:border-box;font-family:inherit;font-size:15.5px;color:#16211a;background:#ffffff;border:1px solid transparent;border-radius:11px;padding:14px 16px;outline:none;box-shadow:0 1px 2px rgba(0,0,0,0.24);transition:border-color .16s,box-shadow .16s}
  .inp::placeholder{color:#9aa69c}
  .inp:focus{border-color:var(--la-accent,#00CD77);box-shadow:0 0 0 3px rgba(0,205,119,0.42),0 1px 2px rgba(0,0,0,0.24)}
  textarea.inp{resize:vertical;min-height:88px;line-height:1.5}
  .phone-field{display:flex;align-items:center;background:#ffffff;border:1px solid transparent;border-radius:11px;box-shadow:0 1px 2px rgba(0,0,0,0.24);transition:border-color .16s,box-shadow .16s}
  .phone-field:focus-within{border-color:var(--la-accent,#00CD77);box-shadow:0 0 0 3px rgba(0,205,119,0.42),0 1px 2px rgba(0,0,0,0.24)}
  .phone-field select,.phone-field input{color:#16211a}
  .phone-field input::placeholder{color:#9aa69c}
  .f-err{display:none;margin-top:7px;font-size:12.5px;font-weight:600;color:#ff9c8d}
  .f-field.err .inp,.f-field.err .phone-field{border-color:#e0574a;box-shadow:0 0 0 3px rgba(224,87,74,0.3)}
  .f-field.err .f-err{display:block}

  /* natywny checkbox rysuje się chromem systemu — na ciemnym pudle wygląda jak wada */
  .f-consent{display:flex;align-items:flex-start;gap:11px;margin-top:4px;font-size:12.5px;line-height:1.55;color:rgba(255,255,255,0.56);cursor:pointer}
  .f-consent input{position:absolute;width:1px;height:1px;opacity:0}
  .f-cb{position:relative;width:18px;height:18px;border-radius:5px;border:1.5px solid rgba(255,255,255,0.32);flex-shrink:0;margin-top:1px;transition:background .16s,border-color .16s,box-shadow .16s}
  .f-cb svg{position:absolute;inset:0;margin:auto;opacity:0;transform:scale(.6);transition:opacity .16s,transform .16s}
  .f-consent input:checked + .f-cb{background:var(--la-accent,#00CD77);border-color:var(--la-accent,#00CD77)}
  .f-consent input:checked + .f-cb svg{opacity:1;transform:scale(1)}
  .f-consent input:focus-visible + .f-cb{box-shadow:0 0 0 3px rgba(0,205,119,0.45)}
  .f-consent .lnk-green{color:var(--la-accent,#00CD77) !important;font-weight:600}
  .f-consent .lnk-green:hover{color:#ffffff !important}
  .f-consent.err{color:#ff9c8d}
  .f-consent.err .f-cb{border-color:#ff9c8d}

  .btn-submit{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;margin-top:14px;font-family:inherit;background:var(--la-accent,#00CD77);color:#06170e;border:0;padding:18px 24px;border-radius:12px;font-weight:800;font-size:17px;letter-spacing:-0.01em;cursor:pointer;box-shadow:0 14px 32px -16px rgba(0,205,119,0.75);transition:background .2s,box-shadow .2s,transform .12s}
  .btn-submit:hover{background:#2ce08f;box-shadow:0 20px 42px -16px rgba(0,205,119,0.95)}
  .btn-submit:active{transform:translateY(1px)}
  .btn-submit:focus-visible{outline:3px solid #ffffff;outline-offset:3px}
  .btn-submit:disabled{opacity:.6;cursor:progress;box-shadow:none}
  .btn-submit [aria-hidden]{transition:transform .18s}
  .btn-submit:hover [aria-hidden]{transform:translateX(4px)}

  /* Pas pod CTA — trzy równe kolumny rozdzielone włoskową linią, zamiast
     zawijających się luzem trzech napisów o różnej długości. */
  .f-trust{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid rgba(255,255,255,0.10);background:rgba(255,255,255,0.035)}
  .f-trust span{display:flex;flex-direction:column;align-items:center;justify-content:flex-start;gap:8px;padding:17px 12px 18px;font-size:11.5px;font-weight:600;line-height:1.35;text-align:center;text-wrap:balance;color:rgba(255,255,255,0.62)}
  .f-trust span + span{border-left:1px solid rgba(255,255,255,0.08)}
  .f-trust svg{flex-shrink:0}

  .f-note{margin-top:16px;padding:14px 15px;border-radius:12px;background:rgba(255,196,120,0.12);border:1px solid rgba(255,196,120,0.32);font-size:13.5px;line-height:1.55;color:#ffd9a6}
  .f-note strong{color:#ffe9c9}
  .f-note .lnk-green{color:var(--la-accent,#00CD77) !important}
  /* ---- stan po wysłaniu ---- */
  .f-ok{text-align:center}
  .f-ok-in{padding:clamp(40px,4.2vw,52px) clamp(26px,3vw,34px) clamp(26px,3vw,32px)}
  .f-ok-ico{position:relative;display:flex;align-items:center;justify-content:center;width:64px;height:64px;margin:0 auto;border-radius:50%;background:rgba(0,205,119,0.15)}
  .f-ok-ico::before{content:"";position:absolute;inset:-9px;border-radius:50%;border:1px solid rgba(0,205,119,0.24)}
  .f-ok-t{margin-top:22px;font-size:clamp(22px,2.2vw,26px);font-weight:800;letter-spacing:-0.025em;color:#ffffff}
  .f-ok-p{margin:10px auto 0;max-width:330px;font-size:15px;line-height:1.6;color:rgba(255,255,255,0.68)}
  .f-ok-echo{display:inline-flex;align-items:center;gap:8px;margin-top:16px;padding:8px 14px;border-radius:999px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);font-size:13px;font-weight:600;color:rgba(255,255,255,0.72)}
  .f-ok-echo svg{color:var(--la-accent,#00CD77);flex-shrink:0}
  .f-ok-next{margin-top:clamp(24px,2.6vw,30px);text-align:left;background:rgba(255,255,255,0.045);border:1px solid rgba(255,255,255,0.12);border-radius:14px;padding:18px 18px 20px}
  .f-ok-eyebrow{font-family:ui-monospace,Menlo,monospace;font-size:10.5px;letter-spacing:0.14em;text-transform:uppercase;color:rgba(255,255,255,0.42)}
  .f-ok-step{display:flex;align-items:flex-start;gap:11px;margin-top:13px;font-size:13.5px;line-height:1.5;color:rgba(255,255,255,0.7)}
  .f-ok-step strong{font-weight:700;color:#ffffff}
  .f-ok-n{display:flex;align-items:center;justify-content:center;width:21px;height:21px;border-radius:7px;background:rgba(0,205,119,0.16);color:var(--la-accent,#00CD77);font-family:ui-monospace,Menlo,monospace;font-size:11px;font-weight:800;flex-shrink:0;margin-top:1px}
  .f-ok-note{margin:18px 0 0;font-size:13px;line-height:1.55;color:rgba(255,255,255,0.45)}
  .f-ok-foot{padding:15px 20px;border-top:1px solid rgba(255,255,255,0.10);background:rgba(255,255,255,0.035);font-size:13px;color:rgba(255,255,255,0.58)}
  .f-ok .lnk-green{color:var(--la-accent,#00CD77) !important;font-weight:700}
  .f-ok .lnk-green:hover{color:#ffffff !important}

  /* Jedna zaaranżowana chwila: fajka się rysuje, treść wjeżdża pod nią kaskadą. */
  .f-ok-ico svg path{stroke-dasharray:28;stroke-dashoffset:28;animation:ok-draw .5s cubic-bezier(.65,0,.35,1) .2s forwards}
  .f-ok-ico{animation:ok-pop .4s cubic-bezier(.34,1.4,.64,1) both}
  .f-ok-t{animation:ok-up .45s cubic-bezier(.4,0,.2,1) .22s both}
  .f-ok-p{animation:ok-up .45s cubic-bezier(.4,0,.2,1) .29s both}
  .f-ok-echo{animation:ok-up .45s cubic-bezier(.4,0,.2,1) .35s both}
  .f-ok-next{animation:ok-up .45s cubic-bezier(.4,0,.2,1) .41s both}
  .f-ok-note{animation:ok-up .45s cubic-bezier(.4,0,.2,1) .47s both}
  @keyframes ok-draw{to{stroke-dashoffset:0}}
  @keyframes ok-pop{from{opacity:0;transform:scale(.72)}to{opacity:1;transform:scale(1)}}
  @keyframes ok-up{from{opacity:0;transform:translateY(9px)}to{opacity:1;transform:none}}
  @media (prefers-reduced-motion:reduce){
    .f-ok-ico,.f-ok-ico svg path,.f-ok-t,.f-ok-p,.f-ok-echo,.f-ok-next,.f-ok-note{animation:none;stroke-dashoffset:0;opacity:1;transform:none}
  }
  @media (max-width:420px){
    .f-trust{grid-template-columns:1fr}
    .f-trust span{flex-direction:row;justify-content:flex-start;gap:10px;padding:13px 20px;text-align:left}
    .f-trust span + span{border-left:0;border-top:1px solid rgba(255,255,255,0.08)}
  }
  @media (prefers-reduced-motion:reduce){ .inp,.phone-field,.btn-submit,.btn-submit [aria-hidden],.f-cb,.f-cb svg{transition:none} }

  /* ---------- FAQ (akordeon) ---------- */
  .faq-item{border-top:1px solid #e7ece4}
  .faq-item:last-child{border-bottom:1px solid #e7ece4}
  .faq-q{appearance:none;width:100%;background:none;border:none;font-family:inherit;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:20px;text-align:left;padding:24px 4px;font-size:clamp(17px,2vw,20px);font-weight:700;letter-spacing:-0.01em;color:#16211a;transition:color .15s}
  .faq-q:hover{color:#0a7a52}
  .faq-ico{flex-shrink:0;display:flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:50%;background:#e9f2ea;color:#0a7a52;transition:transform .35s cubic-bezier(0.4,0,0.2,1),background .2s}
  .faq-item.open .faq-ico{transform:rotate(180deg);background:var(--la-accent,#00CD77);color:#0b1a11}
  .faq-a{overflow:hidden;max-height:0;transition:max-height .4s cubic-bezier(0.4,0,0.2,1)}
  .faq-item.open .faq-a{max-height:340px}
  .faq-a-inner{padding:0 4px 26px;max-width:660px;font-size:15.5px;line-height:1.65;color:#4c5850;text-wrap:pretty}
  @media (prefers-reduced-motion:reduce){ .faq-a,.faq-ico{transition:none} }

  /* ---------- OPINIE (marquee) ---------- */
  .marq{position:relative;overflow:hidden;
    -webkit-mask:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);
            mask:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent)}
  .marq-track{display:flex;gap:20px;width:max-content;will-change:transform;animation:marq-scroll 46s linear infinite}
  .marq:hover .marq-track{animation-play-state:paused}
  .marq-card{flex:0 0 auto;width:min(340px,80vw);display:flex;flex-direction:column;background:#ffffff;border:1px solid #e7ece4;border-radius:16px;padding:24px 24px 20px}
  @keyframes marq-scroll{from{transform:translateX(0)}to{transform:translateX(calc(-50% - 10px))}}
  @media (prefers-reduced-motion:reduce){
    .marq{overflow-x:auto;-webkit-mask:none;mask:none;scroll-snap-type:x mandatory}
    .marq-track{animation:none}
    .marq-card{scroll-snap-align:start}
    .marq-dup{display:none !important}
  }

  /* ---- sticky header + mega menu ---- */
  .site-header{position:sticky;top:0;z-index:60;padding:0 clamp(16px,4vw,40px);transition:padding-top .35s cubic-bezier(.4,0,.2,1)}
  .site-header.scrolled{padding-top:12px}
  .nav-pill{display:flex;align-items:center;justify-content:space-between;gap:20px;max-width:1440px;margin:0 auto;padding:16px 14px 16px 8px;background:transparent;border:1px solid transparent;border-radius:18px;box-shadow:none;transition:max-width .4s cubic-bezier(.4,0,.2,1),padding .35s cubic-bezier(.4,0,.2,1),background .3s,border-color .3s,box-shadow .3s}
  .site-header.scrolled .nav-pill{max-width:1180px;padding:8px 12px 8px 22px;background:rgba(255,255,255,0.78);backdrop-filter:blur(18px) saturate(1.5);-webkit-backdrop-filter:blur(18px) saturate(1.5);border-color:rgba(255,255,255,0.6);box-shadow:0 16px 46px -18px rgba(18,38,28,0.34)}
  .nav-item{display:flex;align-items:center}
  .mega-wrap{position:absolute;top:calc(100% - 20px);left:50%;transform:translateX(-50%) translateY(6px);width:min(940px,calc(100vw - 40px));padding-top:34px;opacity:0;visibility:hidden;pointer-events:none;transition:opacity .18s ease,transform .18s ease}
  .nav-item:hover .mega-wrap,.nav-item:focus-within .mega-wrap{opacity:1;visibility:visible;transform:translateX(-50%) translateY(0);pointer-events:auto}
  .nav-caret{transition:transform .2s}
  .nav-item:hover .nav-caret,.nav-item:focus-within .nav-caret{transform:rotate(180deg)}
  .mega-eyebrow{font-family:ui-monospace,Menlo,monospace;font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:#808b83;padding:0 11px;margin-bottom:6px}
  .mega-item{display:block;padding:9px 11px;border-radius:11px;transition:background .15s}
  .mega-item:hover{background:#f4f8f2}
  .mega-t{display:block;font-size:14.5px;font-weight:650;color:#16211a;transition:color .15s}
  .mega-item:hover .mega-t{color:#0a7a52}
  .mega-d{display:block;margin-top:2px;font-size:12.5px;line-height:1.4;color:#8b968d}
  .mega-feat{display:flex;flex-direction:column;justify-content:center;background:radial-gradient(120% 120% at 100% 0%, rgba(0,205,119,0.16), transparent 55%), #0e2b1d;border-radius:14px;padding:24px 22px;color:#ffffff;transition:transform .2s,box-shadow .2s}
  .mega-feat:hover{transform:translateY(-2px);box-shadow:0 22px 44px -22px rgba(0,0,0,0.5)}
  /* ---- Megamenu usług: triaż po sytuacji klienta ---- */
  .usl-grid{display:grid;grid-template-columns:1fr 1fr 1fr;grid-template-rows:auto auto auto;gap:0 6px}
  .usl-lane{display:grid;grid-template-rows:subgrid;grid-row:span 3;padding:15px 14px 11px;border-radius:14px;transition:background .2s}
  .usl-top{align-self:start}
  .usl-head{display:block;font-size:24px;font-weight:800;line-height:1.06;letter-spacing:-0.032em;text-wrap:balance;color:#16211a;transition:color .18s}
  .usl-head:hover{color:#0a7a52}
  .usl-sub{display:block;margin-top:9px;font-size:12.5px;line-height:1.45;color:#8b968d}
  .usl-rule{display:block;width:26px;height:2px;margin:16px 0 15px;border-radius:2px;background:var(--la-accent,#00CD77);transition:width .28s cubic-bezier(.4,0,.2,1)}
  .usl-lane:hover .usl-rule{width:78px}
  .usl-list .mega-item{padding:7px 9px;margin-left:-9px;border-radius:10px}
  .usl-list .mega-item:hover{background:#eef5ec}
  .usl-list .mega-t{font-size:14px;font-weight:650}
  .usl-list .mega-d{font-size:12px;color:#96a098}
  @media (prefers-reduced-motion:reduce){ .usl-rule{transition:none} }
  @media (max-width:900px){ .mega-wrap{display:none !important} }

  /* ---- Skala nagłówków ---- */
  .h-sec{font-size:clamp(30px,4.6vw,52px);line-height:1.05;letter-spacing:-0.028em;font-weight:800}
  .sub{font-size:17px;line-height:1.6;color:#4c5850;text-wrap:pretty}
  .sec-head{display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:24px 56px}
  .etap-card{transition:transform .3s cubic-bezier(.4,0,.2,1),box-shadow .3s,border-color .3s}
  .etap-card:hover{transform:translateY(-4px);border-color:var(--la-accent,#00CD77);box-shadow:0 26px 54px -32px rgba(18,38,28,0.22)}
  @media (prefers-reduced-motion:reduce){ .etap-card{transition:none} .etap-card:hover{transform:none} }

  /* ---- Pasek CTA na mobile ---- */
  .mob-cta{display:none}
  @media (max-width:900px){
    .mob-cta{display:flex;align-items:center;gap:12px;position:fixed;left:0;right:0;bottom:0;z-index:70;padding:11px clamp(14px,4vw,20px) calc(11px + env(safe-area-inset-bottom));background:rgba(255,255,255,0.92);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-top:1px solid #e2eade;box-shadow:0 -10px 30px -18px rgba(18,38,28,0.4)}
    .mob-cta.hide{display:none}
    body{padding-bottom:74px}
  }

  /* ---------- RESPONSYWNOŚĆ ---------- */
  @media (max-width:1100px){
    .fold-grid{grid-template-columns:1fr !important;gap:clamp(32px,5vw,44px) !important;max-width:640px !important}
    .fold-aside{order:2}
  }
  @media (max-width:1024px){
    .faq-grid{grid-template-columns:1fr !important;gap:clamp(32px,5vw,48px) !important}
  }
  @media (max-width:900px){
    /* Palec potrzebuje więcej niż wysokość linijki tekstu: linki-odnośniki
       dostają zapas w pionie bez zmiany odstępów (ujemny margines go znosi). */
    .lnk-green,.row-lnk{padding-block:10px;margin-block:-10px}
    .sub{text-wrap:wrap}
    .grid3{grid-template-columns:minmax(0,1fr) !important;gap:20px !important}
    .foot-grid{grid-template-columns:1fr 1fr !important;gap:40px !important}
    .nav-menu{display:none !important}
  }
  @media (max-width:600px){
    .grid2,.foot-grid{grid-template-columns:1fr !important}
    .fold-proof{flex-direction:column !important;align-items:flex-start !important;gap:18px !important}
    .form-body{padding-left:20px !important;padding-right:20px !important}
  }

  /* iOS Safari powiększa całą stronę, gdy kursor wchodzi w pole z krojem
     mniejszym niż 16px — po wyjściu z pola układ zostaje przesunięty.
     Na telefonie pola dostają więc równe 16px. */
  @media (max-width:900px){
    input,select,textarea{font-size:16px !important}
  }
</style>
</head>
<body>

<div class="page">

<Nawigacja />

<!-- ============ FOLD · OFERTA + FORMULARZ ============ -->
<section id="formularz" class="fold" style="position:relative;padding:clamp(26px,3.4vw,44px) clamp(20px,5vw,56px) clamp(56px,7vw,88px);scroll-margin-top:80px">


<div class="fold-grid">

<!-- LEWA: dlaczego warto -->
<div class="fold-aside">
<h1 class="fa-h1">Wyjdź z tej rozmowy z konkretnym pierwszym krokiem.</h1>
<p class="fa-lead">Opowiadasz, jak pracujecie dziś. My mówimy, co realnie da się usprawnić i od czego zacząć — na Twoich przykładach. Bez prezentacji i bez sprzedażowej gadki.</p>

<div class="fa-eyebrow">W 30 minut ustalimy</div>
<div class="fa-list">
<div class="fa-item"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#0a7a52" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg><span><strong>Gdzie ucieka czas i pieniądze</strong> — w Twoich procesach, nie w ogólnych statystykach</span></div>
<div class="fa-item"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#0a7a52" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg><span><strong>Co usprawnić najszybciej</strong> — z realnym zwrotem, nie w teorii</span></div>
<div class="fa-item"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#0a7a52" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg><span><strong>Konkretny pierwszy krok</strong> — na piśmie, w kilka dni roboczych</span></div>
</div>

<!-- dowód: z kim rozmawiasz -->
<div class="fold-proof">
<div style="display:flex;align-items:center;gap:14px;flex-shrink:0">
<img src="/szymon-kita.jpg" alt="Szymon Kita — założyciel Let's automate" style="width:62px;height:62px;border-radius:50%;object-fit:cover;object-position:50% 16%;flex-shrink:0;box-shadow:0 8px 20px -10px rgba(18,38,28,0.5)">
<div>
<div class="fa-nm">Szymon Kita</div>
<div class="fa-role">rozmawiasz bezpośrednio<br>z założycielem</div>
</div>
</div>
<div style="display:flex;gap:26px">
<div>
<div class="fa-num">140+</div>
<div class="fa-lbl">firm</div>
</div>
<div>
<div class="fa-num">200+</div>
<div class="fa-lbl">wdrożeń</div>
</div>
<div>
<div class="fa-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
<div class="fa-lbl" style="margin-top:3px">opinie klientów</div>
</div>
</div>
</div>

<div class="fa-group">
<span>Część grupy</span>
<img src="/uploads/wisegroup_logo_v2.webp" alt="Wise Group">
</div>
</div>

<!-- PRAWA: formularz -->
<div class="form-card">
<form id="leadForm" data-endpoint={FORM_ENDPOINT} novalidate>
<div class="form-body">
<div style="display:flex;flex-direction:column;gap:15px">

<div class="f-field">
<label class="f-lab" for="leadEmail">E-mail <span class="f-req">*</span></label>
<input class="inp" id="leadEmail" name="email" type="email" inputmode="email" autocomplete="email" placeholder="jan@firma.pl" aria-describedby="errEmail">
<div class="f-err" id="errEmail">Sprawdź adres e-mail.</div>
</div>

<div class="f-field">
<label class="f-lab" for="leadPhone">Telefon <span class="f-req">*</span></label>
<div class="phone-field">
<div style="position:relative;display:flex;align-items:center;flex-shrink:0">
<select id="leadPrefix" name="kierunkowy" aria-label="Numer kierunkowy" style="appearance:none;-webkit-appearance:none;-moz-appearance:none;border:0;background:transparent;font-family:inherit;font-size:15px;font-weight:600;color:#16211a;padding:14px 32px 14px 16px;outline:none;cursor:pointer">
<option value="+48">+48</option>
<option value="+49">+49</option>
<option value="+44">+44</option>
<option value="+380">+380</option>
<option value="+420">+420</option>
<option value="+1">+1</option>
</select>
<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#8a978c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position:absolute;right:13px;top:50%;transform:translateY(-50%);pointer-events:none" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
</div>
<span style="width:1px;height:22px;background:#e4ebe2;flex-shrink:0"></span>
<input id="leadPhone" name="telefon" type="tel" inputmode="tel" autocomplete="tel-national" placeholder="571 000 000" aria-describedby="errPhone" style="flex:1;min-width:0;border:0;background:transparent;font-family:inherit;font-size:15px;color:#16211a;padding:14px 16px 14px 14px;outline:none">
</div>
<div class="f-err" id="errPhone">Sprawdź numer telefonu.</div>
</div>

<div class="f-field">
<label class="f-lab" for="leadMsg">O czym chcesz porozmawiać?</label>
<textarea class="inp" id="leadMsg" name="wiadomosc" rows="3" placeholder="Kilka zdań o tym, jak pracujecie dziś — albo od razu konkretny pomysł. Nie musi być gotowy."></textarea>
</div>

<label class="f-consent" id="consentRow" for="leadConsent">
<input type="checkbox" id="leadConsent" name="zgoda">
<span class="f-cb"><svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="#06170e" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg></span>
<span>Wyrażam zgodę na kontakt i przetwarzanie moich danych w celu obsługi zapytania. <a href="#" class="lnk-green" style="font-weight:600">Polityka prywatności</a>.</span>
</label>

<button type="submit" class="btn-submit" id="leadSubmit"><span data-label>Umów bezpłatną konsultację</span> <span aria-hidden="true">→</span></button>

</div>

<div class="f-note" id="leadFallback" hidden>
<strong>Wysyłka formularza nie jest jeszcze podłączona.</strong><br>
Napisz do nas bezpośrednio — <a id="leadMailto" href={`mailto:${CONTACT_EMAIL}`} class="lnk-green" style="font-weight:700">{CONTACT_EMAIL}</a> — albo zadzwoń: <a href="tel:+48571399932" class="lnk-green" style="font-weight:700">{CONTACT_PHONE}</a>.
</div>
</div>

<div class="f-trust">
<span><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="#00CD77" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7.5V12l2.8 1.7"/></svg>Odpowiedź w 1 dzień roboczy</span>
<span><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="#00CD77" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>RODO i NDA przed startem</span>
<span><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="#00CD77" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>Zero zobowiązań</span>
</div>
</form>

<div class="f-ok" id="leadSuccess" role="status" tabindex="-1" hidden>
<div class="f-ok-in">

<div class="f-ok-ico">
<svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="#00CD77" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
</div>

<div class="f-ok-t">Mamy Twoje zgłoszenie.</div>
<p class="f-ok-p">Odezwiemy się w 1 dzień roboczy, żeby dobrać termin rozmowy.</p>

<!-- echo kontaktu — użytkownik od razu widzi, czy nie zrobił literówki -->
<div class="f-ok-echo" id="okContact" hidden>
<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 6.5L12 13l8.5-6.5"/></svg>
<span id="okContactText"></span>
</div>

<div class="f-ok-next">
<div class="f-ok-eyebrow">Co dalej</div>
<div class="f-ok-step"><span class="f-ok-n">1</span><span>Piszemy albo dzwonimy — <strong>w 1 dzień roboczy</strong>, na podany kontakt.</span></div>
<div class="f-ok-step"><span class="f-ok-n">2</span><span>Rozmawiamy <strong>30 minut</strong> — online albo telefonicznie, jak Ci wygodniej.</span></div>
<div class="f-ok-step"><span class="f-ok-n">3</span><span>Dostajesz <strong>kierunek na piśmie</strong> — w kilka dni roboczych po rozmowie.</span></div>
</div>

<p class="f-ok-note">Nie musisz się przygotowywać. Wystarczy, że opowiesz, jak pracujecie dziś.</p>

</div>

<div class="f-ok-foot">
Sprawa pilna? Zadzwoń: <a href="tel:+48571399932" class="lnk-green">{CONTACT_PHONE}</a>
</div>
</div>
</div>

</div>

<div class="fold-contact">
<span>Wolisz napisać lub zadzwonić?</span>
<a href={`mailto:${CONTACT_EMAIL}`} class="lnk-green" style="font-weight:700;color:#0a7a52">{CONTACT_EMAIL}</a>
<span style="color:#c3cbc2">·</span>
<a href="tel:+48571399932" class="lnk-green" style="font-weight:700;color:#0a7a52">{CONTACT_PHONE}</a>
</div>
</section>

<!-- ============ JAK TO WYGLĄDA ============ -->
<section id="jak" class="sec sec-tint" style="padding:clamp(64px,8vw,100px) max(clamp(20px,5vw,56px),calc((100% - 1440px) / 2));scroll-margin-top:80px">
<div class="sec-head">
<h2 class="h-sec" style="margin:0;max-width:520px;text-wrap:pretty">Trzy kroki. Zero zobowiązań.</h2>
<p class="sub" style="margin:0 0 6px;max-width:440px">Od Twojego zgłoszenia do konkretnego kierunku — bez formalności i bez presji.</p>
</div>
<div class="grid3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(20px,2.5vw,28px);margin-top:clamp(40px,5vw,56px)">
<div class="etap-card" style="background:#ffffff;border:1px solid #e7ece4;border-radius:20px;padding:30px 28px">
<div style="display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:12px;background:#0e2b1d;color:#fff;font-family:ui-monospace,Menlo,monospace;font-size:16px;font-weight:800">01</div>
<div style="margin-top:20px;font-size:20px;font-weight:750;letter-spacing:-0.015em;color:#16211a">Zostawiasz kontakt</div>
<p style="margin:9px 0 0;font-size:14.5px;line-height:1.6;color:#4c5850">Wypełniasz krótki formularz. Odzywamy się w 1 dzień roboczy, żeby dobrać dogodny termin.</p>
</div>
<div class="etap-card" style="background:#ffffff;border:1px solid #e7ece4;border-radius:20px;padding:30px 28px">
<div style="display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:12px;background:#0e2b1d;color:#fff;font-family:ui-monospace,Menlo,monospace;font-size:16px;font-weight:800">02</div>
<div style="margin-top:20px;font-size:20px;font-weight:750;letter-spacing:-0.015em;color:#16211a">Rozmawiamy 30 minut</div>
<p style="margin:9px 0 0;font-size:14.5px;line-height:1.6;color:#4c5850">Online albo telefonicznie. Słuchamy, jak działa Twoja firma i gdzie najbardziej boli. Więcej pytamy, niż mówimy.</p>
</div>
<div class="etap-card" style="background:#ffffff;border:1px solid #e7ece4;border-radius:20px;padding:30px 28px">
<div style="display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:12px;background:var(--la-accent,#00CD77);color:#0b1a11;font-family:ui-monospace,Menlo,monospace;font-size:16px;font-weight:800">03</div>
<div style="margin-top:20px;font-size:20px;font-weight:750;letter-spacing:-0.015em;color:#16211a">Dostajesz kierunek</div>
<p style="margin:9px 0 0;font-size:14.5px;line-height:1.6;color:#4c5850">Wstępny pomysł i od czego zacząć — na piśmie, w kilka dni roboczych. Co dalej, decydujesz Ty.</p>
</div>
</div>
</section>

<!-- ============ ROZBRAJANIE OBAW ============ -->
<section class="sec sec-plain" style="padding:clamp(56px,7vw,88px) max(clamp(20px,5vw,56px),calc((100% - 1440px) / 2)) clamp(8px,1vw,16px);scroll-margin-top:80px">
<div style="position:relative;overflow:hidden;background:radial-gradient(820px 460px at 88% 0%, rgba(0,205,119,0.14), transparent 58%), #0e2b1d;border-radius:26px;padding:clamp(48px,6vw,80px) clamp(36px,5vw,72px)">
<div style="max-width:560px">
<h2 class="h-sec" style="margin:0;color:#ffffff;text-wrap:pretty">Nie musisz być gotowy. Od tego jest ta rozmowa.</h2>
<p style="margin:20px 0 0;max-width:480px;font-size:17px;line-height:1.6;color:rgba(255,255,255,0.75);text-wrap:pretty">Najczęstszy powód, dla którego firmy zwlekają, to poczucie „najpierw musimy to sobie poukładać". Nie musicie — to nasza część roboty.</p>
</div>
<div class="grid2" style="display:grid;grid-template-columns:1fr 1fr;gap:16px 40px;margin-top:clamp(36px,4vw,48px);max-width:900px">
<div style="display:flex;align-items:flex-start;gap:13px"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#00CD77" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:2px" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg><span style="font-size:15.5px;line-height:1.55;color:rgba(255,255,255,0.9)"><strong style="color:#fff;font-weight:700">Nie musisz mieć dokumentacji ani planu.</strong> Wystarczy, że opowiesz, jak jest dziś.</span></div>
<div style="display:flex;align-items:flex-start;gap:13px"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#00CD77" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:2px" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg><span style="font-size:15.5px;line-height:1.55;color:rgba(255,255,255,0.9)"><strong style="color:#fff;font-weight:700">Nie musisz znać się na AI.</strong> Od tłumaczenia „co i jak" jesteśmy my.</span></div>
<div style="display:flex;align-items:flex-start;gap:13px"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#00CD77" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:2px" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg><span style="font-size:15.5px;line-height:1.55;color:rgba(255,255,255,0.9)"><strong style="color:#fff;font-weight:700">Nie usłyszysz sprzedażowej gadki.</strong> Jak coś nie ma sensu, powiemy wprost.</span></div>
<div style="display:flex;align-items:flex-start;gap:13px"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#00CD77" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:2px" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg><span style="font-size:15.5px;line-height:1.55;color:rgba(255,255,255,0.9)"><strong style="color:#fff;font-weight:700">Masz już konkretny projekt? Tym lepiej.</strong> Pominiemy diagnozę i przejdziemy do wyceny.</span></div>
</div>
<a href="#formularz" class="btn-accent" style="display:inline-flex;align-items:center;gap:9px;margin-top:clamp(36px,4vw,44px);background:var(--la-accent,#00CD77);color:#0b1a11;padding:16px 28px;border-radius:12px;font-weight:750;font-size:16px">Wróć do formularza <span aria-hidden="true">↑</span></a>
</div>
</section>

<!-- ============ OPINIE ============ -->
<section id="opinie" class="sec sec-plain" style="padding:clamp(72px,9vw,110px) 0 clamp(64px,8vw,96px);scroll-margin-top:80px;overflow:hidden">
<div style="padding:0 max(clamp(20px,5vw,56px),calc((100% - 1440px) / 2))">
<div class="sec-head">
<h2 class="h-sec" style="margin:0;max-width:520px;text-wrap:pretty">Zgłosili się przed Tobą. Nie żałują.</h2>
<p class="sub" style="margin:0 0 6px;max-width:460px">Firmy, które zaczęły od jednej rozmowy — o efektach współpracy własnymi słowami.</p>
</div>
</div>
<div class="marq" style="margin-top:clamp(32px,4vw,48px)" role="region" aria-label="Opinie klientów">
<div class="marq-track">
<figure class="marq-card" style="margin:0">
<div aria-hidden="true" style="font-size:13px;letter-spacing:2px;color:#0a7a52;margin-bottom:14px">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
<blockquote style="margin:0;flex:1;font-size:14.5px;line-height:1.6;color:#33413a;text-wrap:pretty">„Wprowadzenie danych trwało godzinę. Dziś przesłanie oferty to <span style="color:#0a7a52;font-weight:700">10 minut</span> — oszczędności liczymy w etatach."</blockquote>
<div style="display:inline-flex;align-items:center;gap:8px;margin-top:16px;background:#f4f8f2;border:1px solid #e7ece4;border-radius:8px;padding:6px 11px;align-self:flex-start">
<span style="font-size:12.5px;font-weight:700;color:#808b83;text-decoration:line-through">60 min</span>
<span style="color:#0a7a52;font-weight:800" aria-hidden="true">→</span>
