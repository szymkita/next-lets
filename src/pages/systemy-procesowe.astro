<p class="v3-sub">System nie powstaje naraz. Wchodzi na produkcję w uruchomieniach co kilka tygodni i każde od razu skraca czas sprawy. Tu na przykładzie ofertowania u producenta konstrukcji stalowych.</p>
</div>

<div class="ur13" data-anim data-gra>
<div class="ur13-wyk" role="img" aria-label="Wykres schodkowy czasu sprawy od zapytania do wysłanej oferty. Przed startem sprawa trwa 6 dni. Po pierwszym uruchomieniu w szóstym tygodniu 3 dni, po drugim w jedenastym tygodniu półtora dnia, po trzecim w piętnastym tygodniu 4 godziny.">
{UR13.map((x, i) => (
  <div class={i === 0 ? 'ur13-s przed' : 'ur13-s'} style={`--w:${x.w};--h:${(x.d / UR13_M).toFixed(4)};--m:${(6 / UR13_M).toFixed(4)};--i:${i}`}>
    {i > 0 && <span class="ur13-duch"></span>}
    <span class={i === 0 ? 'ur13-sl czk-j' : 'ur13-sl'}></span>
    <span class="ur13-w"><b>{x.l}</b>{x.j}</span>
    {i > 0 && <span class="ur13-nr">{i}</span>}
  </div>
))}
</div>
<div class="ur13-os" aria-hidden="true">
<span style="left:0">start</span>
{UR13_TYG.map((t) => (<span style={`left:${(t / 18 * 100).toFixed(2)}%`} data-k={`tydz. ${t}`}>tydzień {t}</span>))}
</div>
<ol class="ur13-et">
{SCHODY.map((o, i) => (
  <li>
    <span class="ur13-kiedy"><i>{i + 1}</i>{o.e} · tydzień {UR13_TYG[i]}</span>
    <h3>{o.t}</h3>
    <p>{o.d}</p>
    <span class="ur13-zn">{o.zn}</span>
  </li>
))}
</ol>
</div>
</section>

