  /* =====================================================================
     PIERWSZY EFEKT (v13) · wykres schodkowy w tygodniach od startu
     Kolumny stoją obok siebie, szerokość = tygodnie okresu (flex-grow),
     wysokość = czas sprawy / 6,6 dnia. Przed startem kreskowana jak
     „przed" w kartach dowodów, po uruchomieniach zielone; nad zielonymi
     przerywany duch do poziomu 6 dni. Numer uruchomienia stoi na
     krawędzi kolumny, na wysokości 6 dni.
     ===================================================================== */
  .ur13{margin-top:clamp(48px,5.6vw,80px)}
  .ur13-wyk{display:flex;gap:3px;height:clamp(260px,27vw,380px);padding-top:34px}
  .ur13-s{position:relative;flex:var(--w) 1 0;min-width:0}
