// ---- PRZEWAGA (dlaczego, v15) — tor procesu góra–dół ---------------
// Ofertowanie skacze trzy razy z gotowego systemu (górny pas) do arkusza
// obok i z powrotem. W arkuszu liczy się wynik, a kropka sprawy niesie go
// na górę jako wartość przepisaną ręcznie. Układ w viewBox 1200 × 400:
// fala składa się z sześciu jednakowych łuków, więc kolejne przystanki
// leżą co 1/6 długości linii (skrypt korzysta z tego przy animacji).
const TOR_SYS = ['Zapytanie', 'Pozycje oferty', 'Akceptacja marży', 'Wysłanie oferty'];
const TOR_ARK = [
  { plik: 'wycena_nietypowa_v7.xlsx', w: [['Konstrukcja', '61 200'], ['Spawanie, malowanie', '15 430'], ['Transport', '9 770']], wl: 'Razem', wv: '86 400', nies: '86 400 zł' },
  { plik: 'rabat_od_obłożenia.xlsx', w: [['Tydzień', '39'], ['Obłożenie hali', '51%'], ['Próg rabatu', '60%']], wl: 'Rabat', wv: '8%', nies: 'rabat 8%' },
  { plik: 'termin_z_planu.xlsx', w: [['Spawalnia', 'śr–cz'], ['Malarnia', 'pt'], ['Wysyłka', 'pn']], wl: 'Termin', wv: '24.09', nies: 'termin 24.09' },
];
const TOR_GY = 104, TOR_DY = 226, TOR_KROK = 170;
const TOR_X = Array.from({ length: 7 }, (_, i) => 90 + i * TOR_KROK);   // przystanki: parzyste u góry, nieparzyste w arkuszach
const TOR_FALA = 'M' + TOR_X[0] + ',' + TOR_GY + TOR_X.slice(1).map((x, i) => {
  const y0 = i % 2 === 0 ? TOR_GY : TOR_DY, y1 = i % 2 === 0 ? TOR_DY : TOR_GY, xm = x - TOR_KROK / 2;
  return ` C${xm},${y0} ${xm},${y1} ${x},${y1}`;
}).join('');
const torL = (x) => (x / 12).toFixed(2) + '%';
const torT = (y) => (y / 4).toFixed(2) + '%';


