     „Kiedy to nie ma sensu" bez kafla: osobna grupa pod mocną kreską,
     cztery zdania w dwóch kolumnach. -->
<DlaKogo sub="Najczęściej produkcja, dystrybucja i usługi." warunki={DLA_KOGO} nie={NIE_TERAZ} />

<!-- ============ 10 · KONTAKT ============
     Własny moduł zamiast GcCta (komponent wspólny dla 22 stron zostaje
     nietknięty). Plansza domyka stronę tak, jak otwiera ją hero. Prosto:
     nagłówek, kto odpisuje i trzy pola. W v4 stała tu próbka notatki po
     rozmowie i pytania wyboru o proces i skalę — „za bardzo złożone".
     Formularz jest prawdziwy: POST na /api/kontakt, ta sama walidacja,
     pułapka na boty i obsługa awarii co w GcCta. -->
<Kontakt tytul="Zacznijmy od jednego procesu" lead="Napiszcie, która sprawa przechodzi u Was przez najwięcej rąk. Odpowiemy w jeden dzień roboczy z propozycją terminu rozmowy." zrodlo="Systemy dopasowane do firmy" pytanie="Która to sprawa?" podpowiedz="Np. od zapytania do oferty, przechodzi przez handel, technologa i magazyn…" />



</div>


<GcFaq
  heading="Pytania, które padają przed decyzją"
  ctaLabel="Zadajcie nam swoje →"
  items={faq}
/>

<script>
  var redukcja = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- Droga sprawy przez pięć okien (v9) ----
  // Kropka idzie wzdłuż linii procesu. W oknie pracuje człowiek (okno się
  // podnosi, zapala się osoba z czasem pracy), w przerwie sprawa czeka:
  // pierścień wokół ikony się domyka, licznik czasu sprawy rośnie o dni
  // z data-dni. Kropka leży pod oknami, więc widać ją tylko w przerwach.
  // Bez ruchu figura nie dostaje .gra i od razu pokazuje stan końcowy.
  (function(){
    var fig = document.querySelector('[data-droga]');
    if(!fig || redukcja || !('IntersectionObserver' in window)) return;
    var sc = fig.querySelector('.ts4-sc');
    var tok = fig.querySelector('[data-droga-tok]');
    var okna = Array.prototype.slice.call(fig.querySelectorAll('[data-droga-ok]'));
    var osoby = Array.prototype.slice.call(fig.querySelectorAll('[data-droga-os]'));
    var przerwy = Array.prototype.slice.call(fig.querySelectorAll('[data-droga-pr]'));
    var czas = fig.querySelector('[data-droga-czas]');
    var znow = fig.querySelector('[data-droga-znow]');
    var bieg = 0;
    function dni(d){ var s = String(d).replace('.', ','); return d === 1 ? '1 dzień' : (Number.isInteger(d) ? s + ' dni' : s + ' dnia'); }
    function ustawCzas(d, tik){
      czas.textContent = dni(d);
      if(tik){ czas.classList.remove('tik'); void czas.offsetWidth; czas.classList.add('tik'); }
    }
    function czekaj(ms, nr){ return new Promise(function(r){ setTimeout(function(){ r(nr === bieg); }, ms); }); }
    function srodek(el){
      var a = el.getBoundingClientRect(), b = sc.getBoundingClientRect();
      return { x: a.left - b.left + a.width / 2, y: a.top - b.top + a.height / 2 };
    }
    // Linia biegnie poziomo (szeroko) albo pionowo (wąsko); punkt okna to
    // rzut jego środka na linię.
    function punkty(){
      var ik = przerwy.map(function(p){ return srodek(p.querySelector('.ts4-ik')); });
      var poziomo = Math.abs(ik[0].y - ik[ik.length - 1].y) < 2;
      var ok = okna.map(function(o){ var c = srodek(o); return poziomo ? { x: c.x, y: ik[0].y } : { x: ik[0].x, y: c.y }; });
      return { ik: ik, ok: ok };
    }
    function jedz(p, ms){
      tok.style.transition = ms ? 'transform ' + ms + 'ms cubic-bezier(.45,0,.25,1), opacity .25s' : 'opacity .25s';
      tok.style.transform = 'translate(' + p.x + 'px,' + p.y + 'px)';
    }
    function liczDo(od, doo, ms, nr){
      var kroki = Math.max(1, Math.round((doo - od) / 0.5)), i = 0;
      var t = setInterval(function(){
        if(nr !== bieg){ clearInterval(t); return; }
        i++; ustawCzas(od + i * 0.5, true);
        if(i >= kroki) clearInterval(t);
      }, ms / kroki);
    }
    function zeruj(){
      okna.forEach(function(o){ o.classList.remove('akt'); });
      osoby.forEach(function(o){ o.classList.remove('on'); });
      przerwy.forEach(function(p){ p.classList.remove('on', 'czeka'); });
      tok.classList.remove('on');
      ustawCzas(0);
    }
    async function graj(){
      var nr = ++bieg, suma = 0, P;
      zeruj();
      if(znow) znow.disabled = true;
      if(!(await czekaj(1100, nr))) return;
      P = punkty(); jedz(P.ok[0], 0);
      for(var k = 0; k < okna.length; k++){
        okna[k].classList.add('akt'); osoby[k].classList.add('on');
        if(!(await czekaj(850, nr))) return;
        okna[k].classList.remove('akt');
        if(k === przerwy.length) break;
        P = punkty();
        tok.classList.add('on'); jedz(P.ik[k], 420);
        if(!(await czekaj(320, nr))) return;
        przerwy[k].classList.add('on');
        if(!(await czekaj(240, nr))) return;
        var d = parseFloat(przerwy[k].getAttribute('data-dni')) || 1;
        var ms = Math.round(650 + d * 360);
        przerwy[k].style.setProperty('--t', ms + 'ms');
        przerwy[k].classList.add('czeka');
        liczDo(suma, suma + d, ms, nr); suma += d;
        if(!(await czekaj(ms + 140, nr))) return;
        jedz(P.ok[k + 1], 420);
        if(!(await czekaj(420, nr))) return;
      }
      tok.classList.remove('on');
      if(znow) znow.disabled = false;
    }
    zeruj();
    if(znow) znow.addEventListener('click', graj);
    var io = new IntersectionObserver(function(w){
      if(w[0].isIntersecting){ io.disconnect(); graj(); }
    }, { threshold: 0.45 });
    io.observe(fig);
  })();

  // ---- Tor procesu góra–dół (v15) ----
  // Kropka sprawy idzie po fali w pętli. Fala ma sześć jednakowych łuków,
  // więc przystanki leżą co 1/6 długości: parzyste to kroki w systemie,
  // nieparzyste to arkusze. W arkuszu wynik „pisze się" w komórce, w drodze
  // na górę kropka niesie go jako wartość przepisaną ręcznie. Pętla stoi,
  // kiedy rysunku nie widać albo kiedy jest w wersji pionowej (kropka
  // schowana). Bez ruchu zostaje stan końcowy z CSS.
  (function(){
    var fig = document.querySelector('[data-tor]');
    if(!fig || redukcja) return;
    var baza = fig.querySelector('[data-tor-baza]');
    var linia = fig.querySelector('[data-tor-linia]');
    var tok = fig.querySelector('[data-tor-tok]');
    var tokV = fig.querySelector('[data-tor-tok-v]');
    var kropki = Array.prototype.slice.call(fig.querySelectorAll('[data-tor-n]'));
    var arkusze = Array.prototype.slice.call(fig.querySelectorAll('[data-tor-ark]'));
    var wyniki = Array.prototype.slice.call(fig.querySelectorAll('[data-tor-wynik]'));
    if(!baza || !linia || !tok) return;
    var L = baza.getTotalLength();
    var widoczny = false;
    fig.classList.add('ruch');
    function pokazana(){ return widoczny && tok.offsetParent !== null; }
    function czekaj(ms){ return new Promise(function(r){ setTimeout(r, ms); }); }
    async function gdyWidoczny(){ while(!pokazana()) await czekaj(400); }
    function ustaw(p){
      var pt = baza.getPointAtLength(p * L);
      tok.style.left = (pt.x / 12) + '%';
      tok.style.top = (pt.y / 4) + '%';
      linia.style.strokeDashoffset = String(1 - p);
    }
    function jedz(od, doo, ms){
      return new Promise(function(r){
        var t0 = null;
        function klatka(t){
          if(t0 === null) t0 = t;
          var u = Math.min(1, (t - t0) / ms);
          var e = u < 0.5 ? 2 * u * u : 1 - Math.pow(-2 * u + 2, 2) / 2;
          ustaw(od + (doo - od) * e);
          if(u < 1) requestAnimationFrame(klatka); else r();
        }
        requestAnimationFrame(klatka);
      });
    }
    function zeruj(){
      kropki.forEach(function(k){ k.classList.remove('byl'); });
      wyniki.forEach(function(w){ w.classList.remove('on'); });
      arkusze.forEach(function(a){ a.classList.remove('akt'); });
      tok.classList.remove('niesie');
      ustaw(0);
    }
    async function petla(){
      for(;;){
        await gdyWidoczny();
        zeruj();
        kropki[0].classList.add('byl');
        await czekaj(700);
        for(var s = 0; s < 6; s++){
          await gdyWidoczny();
          var doArkusza = s % 2 === 0, i = Math.floor(s / 2);
          if(!doArkusza){ tokV.textContent = wyniki[i].getAttribute('data-nies'); tok.classList.add('niesie'); }
          await jedz(s / 6, (s + 1) / 6, 1100);
          if(doArkusza){
            arkusze[i].classList.add('akt');
            await czekaj(350);
            wyniki[i].classList.add('on');
            await czekaj(1150);
            arkusze[i].classList.remove('akt');
          } else {
            tok.classList.remove('niesie');
            kropki[i + 1].classList.add('byl');
            await czekaj(600);
          }
        }
        await czekaj(2200);
      }
    }
    new IntersectionObserver(function(w){ widoczny = w[0].isIntersecting; }, { threshold: 0.3 }).observe(fig);
    ustaw(0);
    petla();
  })();

  // ---- Zakładki widoków systemu ----
  (function(){
    var zak = Array.prototype.slice.call(document.querySelectorAll('[data-zak]'));
    if(!zak.length) return;
    var widoki = document.querySelectorAll('[data-widok]');
    var podpisy = document.querySelectorAll('[data-podpis]');
    var nav = document.querySelectorAll('[data-nav]');
    var okruch = document.querySelector('[data-okruch]');
    function pokaz(i, fokus){
      zak.forEach(function(b, j){ b.setAttribute('aria-selected', i === j ? 'true' : 'false'); b.tabIndex = i === j ? 0 : -1; });
      widoki.forEach(function(w, j){ w.hidden = i !== j; });
      podpisy.forEach(function(p, j){ p.hidden = i !== j; });
      nav.forEach(function(n, j){ n.classList.toggle('on', i === j); });
      if(okruch) okruch.textContent = zak[i].textContent;
      if(fokus) zak[i].focus();
    }
    zak.forEach(function(b, i){
      b.addEventListener('click', function(){ pokaz(i); });
      b.addEventListener('keydown', function(e){
        if(e.key === 'ArrowRight'){ e.preventDefault(); pokaz((i + 1) % zak.length, true); }
        if(e.key === 'ArrowLeft'){ e.preventDefault(); pokaz((i - 1 + zak.length) % zak.length, true); }
      });
    });
  })();


</script>
</LaBase>
