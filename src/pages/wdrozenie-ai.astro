<LaBase topbar={false} title={title} description={description} ctaLabel="Umów rozmowę" nav="uslugi">
<script type="application/ld+json" is:inline set:html={JSON.stringify(dane)} slot="head"></script>
<style is:global slot="head">
  /* Style tej usługi. Wspólny wygląd: src/components/usluga/Styl.astro. */

  /* =====================================================================
     HERO · dokument firmy i kartka z odpowiedzią (.wh-)
     Wymiary w em od font-size .wh-sc, więc rysunek skaluje się z kontenerem.
     ===================================================================== */
  .wh{margin:0;container-type:inline-size;container-name:wh}
  .wh-sc{position:relative;font-size:clamp(10.5px,1.95cqi,14.5px);padding:1.4em 0 3em}
  .wh-doki{position:relative;display:grid;width:64%;margin-left:0.6em}
  .wh-doki::before,.wh-doki::after{content:"";position:absolute;inset:0;border-radius:0.7em;background:#fbfaf6;box-shadow:0 0 0 1px rgba(15,26,20,0.06),0 18px 40px -26px rgba(15,26,20,0.4)}
  .wh-doki::before{transform:rotate(2.6deg) translate(1.2em,0.4em)}
  .wh-doki::after{transform:rotate(-3.4deg) translate(-0.6em,0.9em)}
  .wh-dok{grid-area:1 / 1;position:relative;z-index:1;display:flex;flex-direction:column;padding:2.2em 6.4em 1.6em 2.4em;border-radius:0.7em;background:#ffffff;box-shadow:0 0 0 1px rgba(15,26,20,0.07),0 30px 60px -32px rgba(15,26,20,0.45);transform:rotate(-1.2deg);
    opacity:0;visibility:hidden;transition:opacity .45s ease,visibility 0s linear .45s}
  .wh-dok.on{opacity:1;visibility:visible;transition:opacity .45s ease}
  .wh-dz{display:inline-flex;align-items:center;gap:0.5em;font-size:0.82em;font-weight:650;color:var(--ziel-c)}
  .wh-dz svg{width:1.1em;height:1.1em;fill:currentColor}
  .wh-dok h4{margin:0.6em 0 0;font-size:1.32em;font-weight:700;letter-spacing:-0.02em;line-height:1.2;color:var(--t1)}
  .wh-dok > small{display:block;margin-top:0.3em;font-size:0.85em;color:var(--t3)}
  .wh-pk{margin:1.3em 0 0;padding:1.1em 0 0;list-style:none;border-top:1px solid var(--linia);display:grid;gap:0.85em}
  .wh-pk li{display:grid;grid-template-columns:2.6em minmax(0,1fr);gap:0.4em;font-size:0.95em;line-height:1.5;color:var(--t2)}
  .wh-pk li > em{font-style:normal;font-weight:600;color:var(--t3)}
  .wh-pk b{font-weight:700;color:var(--t1)}
  .wh-pk mark{padding:0.05em 0.1em;color:var(--t1);background:linear-gradient(rgba(0,205,119,0.34),rgba(0,205,119,0.34)) no-repeat 0 62% / 100% 72%;-webkit-box-decoration-break:clone;box-decoration-break:clone}
  .wh-c{display:inline-grid;place-items:center;width:1.55em;height:1.55em;margin-left:0.3em;border-radius:50%;background:var(--ziel);color:var(--ink);font-size:0.72em;font-weight:800;line-height:1;vertical-align:0.25em}
  .wh-dok footer{margin-top:auto;padding-top:1.3em;font-size:0.8em;color:var(--t3)}
  .wh-dok footer b{font-weight:650;color:var(--t2)}
  /* plik zamknięty: treść zamazana, na niej kłódka */
  .wh-zam{position:relative;flex:1;margin-top:1.3em;padding-top:1.1em;border-top:1px solid var(--linia)}
  .wh-zam i{display:block;height:0.62em;margin:0 0 0.95em;border-radius:0.31em;background:rgba(15,26,20,0.08);filter:blur(1.5px)}
  .wh-zam i:nth-child(2n){width:78%}
  .wh-zam i:nth-child(3n){width:88%}
  .wh-zam > div{position:absolute;left:50%;top:50%;width:min(19em,92%);transform:translate(-50%,-46%);padding:1.2em 1.3em;border-radius:0.8em;background:#ffffff;box-shadow:0 0 0 1px rgba(15,26,20,0.08),0 20px 40px -20px rgba(15,26,20,0.35);text-align:center}
  .wh-zam svg{display:block;width:2.2em;height:2.2em;margin:0 auto 0.6em;padding:0.5em;border-radius:50%;background:var(--ink);fill:#ffffff}
  .wh-zam b{display:block;font-size:1em;font-weight:700;color:var(--t1)}
  .wh-zam span{display:block;margin-top:0.35em;font-size:0.82em;line-height:1.45;color:var(--t2)}
  /* kartka z odpowiedzią */
  .wh-odp{position:absolute;right:0;top:7.2em;z-index:2;display:grid;width:45%;padding:1.7em 1.8em 1.6em;border-radius:0.9em;background:#ffffff;
    box-shadow:0 0 0 1px rgba(15,26,20,0.06),0 46px 80px -34px rgba(7,20,13,0.55);transform:rotate(1.1deg)}
  .wh-st{grid-area:1 / 1;opacity:0;visibility:hidden;transition:opacity .4s ease,visibility 0s linear .4s}
  .wh-st.on{opacity:1;visibility:visible;transition:opacity .4s ease}
  .wh-kto{display:flex;align-items:center;gap:0.55em;margin:0;font-size:0.84em;color:var(--t3)}
  .wh-kto b{font-weight:650;color:var(--t2)}
  .wh-kto i{width:0.5em;height:0.5em;border-radius:50%;background:var(--ziel)}
  .wh-q{margin:0.55em 0 0;font-size:1.22em;font-weight:700;letter-spacing:-0.018em;line-height:1.3;color:var(--t1);text-wrap:pretty}
  .wh-a{margin:1em 0 0;padding-top:1em;border-top:1px solid var(--linia);font-size:1em;line-height:1.55;color:var(--t1);text-wrap:pretty}
  .wh-zr{margin:1em 0 0;padding:0;list-style:none;display:grid;gap:0.45em}
  .wh-zr li{display:flex;align-items:center;gap:0.55em;font-size:0.82em;color:var(--t2)}
  .wh-zr .wh-c{flex-shrink:0;margin:0;vertical-align:0;font-size:0.82em}
  .wh-brak{margin:1em 0 0;font-size:0.82em;line-height:1.45;color:var(--t3)}
  /* ruch: odpowiedź po pytaniu, przypisy razem z zakreśleniem w dokumencie */
  .wh.gra .wh-a,.wh.gra .wh-zr,.wh.gra .wh-brak{opacity:0;transform:translateY(0.4em);transition:opacity .45s ease,transform .45s ease}
  .wh.gra .wh-st.a .wh-a,.wh.gra .wh-st.z .wh-zr,.wh.gra .wh-st.a .wh-brak{opacity:1;transform:none}
  /* ukryty przypis nie zostawia dziury w wierszu: szerokość rośnie razem z nim */
  .wh.gra .wh-st .wh-a .wh-c{width:0;margin-left:0;transform:scale(0);transition:transform .3s cubic-bezier(.3,1.6,.5,1),width .25s ease,margin .25s ease}
  .wh.gra .wh-st.z .wh-a .wh-c{width:1.55em;margin-left:0.3em;transform:none}
  .wh.gra .wh-dok mark{background-size:0% 72%;transition:background-size .7s cubic-bezier(.4,0,.2,1)}
  .wh.gra .wh-dok .wh-c{width:0;margin-left:0;transform:scale(0);transition:transform .3s cubic-bezier(.3,1.6,.5,1) .55s,width .25s ease .5s,margin .25s ease .5s}
  .wh.gra .wh-dok.c1 li[data-c="1"] mark,.wh.gra .wh-dok.c2 li[data-c="2"] mark{background-size:100% 72%}
  .wh.gra .wh-dok.c1 li[data-c="1"] .wh-c,.wh.gra .wh-dok.c2 li[data-c="2"] .wh-c{width:1.55em;margin-left:0.3em;transform:none}
  .wh.gra .wh-zam > div{opacity:0;transform:translate(-50%,-40%);transition:opacity .4s ease,transform .4s ease}
  .wh.gra .wh-dok.c1 .wh-zam > div{opacity:1;transform:translate(-50%,-46%)}
  @container wh (max-width:639px){
    .wh-sc{font-size:clamp(10px,2.6cqi,13px);padding:0.6em 0 0.4em}
    .wh-doki{width:auto;margin:0 0.6em 0 0.2em}
    .wh-dok{padding:1.9em 1.9em 1.5em}
    .wh-odp{position:relative;top:auto;right:auto;width:auto;margin:-1.2em 0 0 2.4em;padding:1.5em 1.6em}
  }
  @container wh (max-width:420px){
    .wh-odp{margin-left:1.2em}
  }

  /* =====================================================================
     DLACZEGO · blok 1: trzy cenniki w jednym folderze (.wc-)
     ===================================================================== */
  .wc .ts4-licz > b{min-width:0}
