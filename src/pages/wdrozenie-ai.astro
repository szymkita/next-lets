  .wc-odp em{display:flex;align-items:center;gap:8px;margin-top:8px;font-style:normal;font-size:13px;font-weight:600}
  .wc-odp em::before{content:"";width:8px;height:8px;border-radius:50%;flex-shrink:0}
  .przed .wc-odp em{color:var(--burs-c)}
