<script>
  var redukcja = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- HERO: trzy pytania z działów ----
  // Kolejno: dokument i pytanie, po chwili odpowiedź, potem przypisy razem
  // z zakreśleniem w dokumencie. Trzecie pytanie trafia na plik poza
  // dostępem. Bez JS i przy ograniczonym ruchu stoi pierwsze pytanie
  // w stanie końcowym (klasy w HTML). Pętla stoi, kiedy hero nie widać.
  (function(){
    var f = document.querySelector('[data-wh]') as HTMLElement | null;
    if(!f || redukcja || !('IntersectionObserver' in window)) return;
    var doki = Array.prototype.slice.call(f.querySelectorAll('[data-wh-dok]')) as HTMLElement[];
    var st = Array.prototype.slice.call(f.querySelectorAll('[data-wh-st]')) as HTMLElement[];
    var T = { odp: 1100, c1: 2300, c2: 3100, dalej: 7600, zam: 6200 };
    var biez = 0, timery: number[] = [], widac = false;
    f.classList.add('gra');
    function czysc(){ timery.forEach(function(t){ clearTimeout(t); }); timery = []; }
    function krok(n: number){
      czysc();
      biez = n;
      doki.forEach(function(d, j){ d.classList.toggle('on', j === n); d.classList.remove('c1', 'c2'); });
      st.forEach(function(s, j){ s.classList.toggle('on', j === n); s.classList.remove('a', 'z'); });
      var zam = !st[n].querySelector('.wh-zr');
      timery.push(window.setTimeout(function(){ st[n].classList.add('a'); }, T.odp));
      timery.push(window.setTimeout(function(){ doki[n].classList.add('c1'); st[n].classList.add('z'); }, zam ? T.odp - 300 : T.c1));
      timery.push(window.setTimeout(function(){ doki[n].classList.add('c2'); }, T.c2));
      timery.push(window.setTimeout(function(){ if(widac) krok((n + 1) % st.length); }, zam ? T.zam : T.dalej));
    }
    var io = new IntersectionObserver(function(w){
      var teraz = w[0].isIntersecting;
      if(teraz && !widac){ widac = true; krok(biez); }
      else if(!teraz && widac){ widac = false; czysc(); }
    }, { threshold: 0.25 });
    io.observe(f);
  })();

  // ---- Zakładki: próba, asystenci, zasady, raport ----
  (function(){
    var zak = Array.prototype.slice.call(document.querySelectorAll('[data-zak]')) as HTMLElement[];
    if(!zak.length) return;
    var widoki = Array.prototype.slice.call(document.querySelectorAll('[data-widok]')) as HTMLElement[];
    var podpisy = Array.prototype.slice.call(document.querySelectorAll('[data-podpis]')) as HTMLElement[];
    function pokaz(i: number, fokus?: boolean){
      zak.forEach(function(b, j){ b.setAttribute('aria-selected', i === j ? 'true' : 'false'); b.tabIndex = i === j ? 0 : -1; });
      widoki.forEach(function(w, j){ w.hidden = i !== j; });
      podpisy.forEach(function(p, j){ p.hidden = i !== j; });
      if(fokus) zak[i].focus();
    }
    zak.forEach(function(b, i){
      b.addEventListener('click', function(){ pokaz(i); });
      b.addEventListener('keydown', function(e){
        if(e.key === 'ArrowRight'){ e.preventDefault(); pokaz((i + 1) % zak.length, true); }
        if(e.key === 'ArrowLeft'){ e.preventDefault(); pokaz((i - 1 + zak.length) % zak.length, true); }
      });
    });
  })();
</script>
