---
// 404 — Vercel serwuje dist/404.html dla każdego adresu, którego nie ma.
//
// Po przeniesieniu serwisu z Webflow tu trafi każdy stary adres bez
// odpowiednika i bez przekierowania (lista: docs/stare-adresy.md), więc
// strona prowadzi tam, gdzie najczęściej szło się ze starego serwisu:
// na stronę główną, do bazy wiedzy i do formularza konsultacji.
import LaBase from '../layouts/LaBase.astro';
---
<LaBase title="Nie ma takiej strony | Let's automate" description="Pod tym adresem nie ma strony." ctaLabel="Umów rozmowę" nav={null} noindex topbar={false}>
<style is:global slot="head">
  .e4-h1{margin:0;font-size:clamp(38px,6.4vw,74px);line-height:0.98;letter-spacing:-0.042em;font-weight:800;color:#16211a;text-wrap:balance;max-width:14ch}
  .e4-lead{margin:clamp(20px,2.4vw,28px) 0 0;max-width:560px;font-size:clamp(16.5px,2vw,20px);line-height:1.55;color:#33413a;text-wrap:pretty}
  .e4-linki{display:flex;flex-wrap:wrap;gap:12px;margin-top:clamp(28px,3.4vw,40px)}
  .e4-linki a{display:inline-flex;align-items:center;gap:8px;padding:14px 22px;border:1px solid #d3ded1;border-radius:11px;font-size:15px;font-weight:650;color:#16211a;transition:border-color .16s,color .16s}
  .e4-linki a:hover{border-color:#0a7a52;color:#0a7a52}
  .e4-linki a.e4-glowny{border-color:#16211a;background:#16211a;color:#ffffff}
  .e4-linki a.e4-glowny:hover{border-color:#0a7a52;background:#0a7a52;color:#ffffff}
</style>

<div aria-hidden="true" style="position:absolute;left:0;right:0;top:0;height:560px;background:radial-gradient(900px 520px at 12% -10%, rgba(0,205,119,0.14), transparent 62%);pointer-events:none"></div>
<section style="position:relative;min-height:52vh;padding:clamp(56px,8vw,120px) max(clamp(20px,5vw,56px),calc((100% - 1440px) / 2)) clamp(64px,8vw,120px)">
<h1 class="e4-h1">Pod tym adresem nie ma strony</h1>
<p class="e4-lead">Mogła zmienić adres, kiedy przenosiliśmy serwis, albo w linku jest literówka.</p>
<div class="e4-linki">
<a href="/" class="e4-glowny">Strona główna</a>
<a href="/blog">Baza wiedzy</a>
<a href="/darmowa-konsultacja">Umów bezpłatną konsultację</a>
</div>
</section>
</LaBase>
