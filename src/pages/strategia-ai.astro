  .pb-przed > .pb-zo{margin-left:auto;font-size:13px;color:var(--t3)}
  .pb-przed > .pb-zo b{color:var(--t1);font-weight:650}
  .pb-wy{display:inline-flex;align-items:center;gap:6px;width:max-content;padding:4px 10px 4px 6px;border-radius:999px;background:var(--ink);color:#ffffff;font-size:11.5px;font-weight:650;white-space:nowrap}
