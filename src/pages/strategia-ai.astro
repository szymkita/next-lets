// ============================================================================
const KLIENT = 'Producent mebli · 140 osób';

// Cele zarządu. p = ile celu pokrywa plan (suma wkładów pozycji). Żaden nie
// dochodzi do stu procent — reszta celu zostaje na kolejny przegląd.
const CELE = [
