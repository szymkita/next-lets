// od miesiąca startu, więc późne pozycje zwracają mniej niż jeden raz.
const KOLEJNOSC = [
  { nr: '01', t: 'Wycena nietypowego zlecenia w kwadrans', c: 1, d: 47, zw: '2,1×', st: 'miesiąc 1', m: 1, zn: 'dwa dni czekania na technologa' },
  { nr: '02', t: 'Zamówienia z maila prosto do ERP', c: 2, d: 31, zw: '1,2×', st: 'miesiąc 2', m: 2, zn: 'przepisywanie zamówień z poczty' },
  { nr: '03', t: 'Wykrywanie zleceń, które zjadają marżę', c: 0, d: 38, zw: '1,6×', st: 'kwartał 2', m: 4, zn: 'koszt liczony dopiero po zamknięciu zlecenia' },
  { nr: '04', t: 'Potwierdzenie terminu w dniu zamówienia', c: 2, d: 27, zw: '0,9×', st: 'kwartał 2', m: 5, zn: 'telefon do produkcji o wolne moce' },
  { nr: '05', t: 'Szybsza odpowiedź na zapytanie ofertowe', c: 1, d: 34, zw: '1,4×', st: 'kwartał 3', m: 7, zn: 'zapytania czekające w skrzynce do rana' },
  { nr: '06', t: 'Dobór parametrów produkcji pod marżę', c: 0, d: 26, zw: '0,5×', st: 'kwartał 4', m: 10, zn: 'ustawienia z pamięci brygadzisty' },
];
const CEL_P = CELE.map((_, i) => KOLEJNOSC.filter((k) => k.c === i).reduce((a, k) => a + k.d, 0));   // 64, 81, 58

// Lista z działów w kolejności przeglądu (hero). ks = nazwa, pod którą
// pomysł przyszedł z działu (krótka, mieści się w wierszu rozkładówki),
// k = miejsce w planie, pw = powód odrzucenia (krótko na rozkładówce,
// dłużej na stronie „Odrzucone"), h = godziny miesięcznie, które pozycja
// zdjęłaby z zespołu (dwie kolejności w „Dlaczego").
const STRUMIEN = [
  { t: 'Raport zarządczy z arkuszy', ks: 'Raport zarządczy z arkuszy', dz: 'finanse', pw: 'nie rusza celu', h: 156 },
  { t: 'Wycena nietypowego zlecenia w kwadrans', ks: 'Wycena nietypowych zleceń', dz: 'handel', k: 0, h: 36 },
  { t: 'Chatbot na stronie', ks: 'Chatbot na stronie', dz: 'marketing', pw: 'za mały wolumen', h: 18 },
  { t: 'Zamówienia z maila prosto do ERP', ks: 'Zamówienia z maila do ERP', dz: 'obsługa zamówień', k: 1, h: 109 },
  { t: 'Planowanie produkcji', ks: 'Planowanie produkcji', dz: 'produkcja', pw: 'dane poza systemem' },
  { t: 'Wykrywanie zleceń, które zjadają marżę', ks: 'Zlecenia, które zjadają marżę', dz: 'kontroling', k: 2, h: 12 },
  { t: 'Zamówienia do dostawców', ks: 'Zamówienia do dostawców', dz: 'zakupy', pw: 'taniej integracją' },
  { t: 'Ocena CV kandydatów', ks: 'Ocena CV kandydatów', dz: 'kadry', pw: 'ryzyko regulacyjne' },
  { t: 'Potwierdzenie terminu w dniu zamówienia', ks: 'Termin w dniu zamówienia', dz: 'logistyka', k: 3, h: 24 },
  { t: 'Notatki ze spotkań handlowych', ks: 'Notatki ze spotkań handlowych', dz: 'handel', pw: 'brak właściciela', h: 30 },
  { t: 'Obieg faktur kosztowych', ks: 'Obieg faktur kosztowych', dz: 'księgowość', pw: 'nie rusza celu', h: 84 },
  { t: 'Szybsza odpowiedź na zapytanie ofertowe', ks: 'Odpowiedź na zapytanie ofertowe', dz: 'handel', k: 4, h: 18 },
  { t: 'Wnioski urlopowe', ks: 'Wnioski urlopowe', dz: 'kadry', pw: 'już rozwiązane' },
  { t: 'Rejestr reklamacji', ks: 'Rejestr reklamacji', dz: 'jakość', pw: 'zbyt rzadkie' },
  { t: 'Dobór parametrów produkcji pod marżę', ks: 'Parametry produkcji pod marżę', dz: 'technologia', k: 5, h: 6 },
  { t: 'Opisy produktów do sklepu', ks: 'Opisy produktów do sklepu', dz: 'marketing', pw: 'nie rusza celu', h: 42 },
  { t: 'Rozliczenia delegacji', ks: 'Rozliczenia delegacji', dz: 'finanse', pw: 'nie rusza celu', h: 48 },
  { t: 'Prognoza zużycia płyty na kwartał', ks: 'Prognoza zużycia płyty', dz: 'zakupy', pw: 'za mało historii' },
];
const ODRZUCONE_N = STRUMIEN.filter((x) => x.pw).length;   // 12
// Hero pokazuje pierwsze HS_N pozycji; reszta to jeden dopisek pod listą.
// Przyjęte z reszty (05, 06) zapalają się po prawej razem z dopiskiem.
const HS_N = 10;
const HS_L = STRUMIEN.slice(0, HS_N);
const HS_R = STRUMIEN.slice(HS_N);
const HS_R_PLAN = HS_R.filter((x) => x.k !== undefined);
const HS_R_ODRZ = HS_R.length - HS_R_PLAN.length;            // 6
// Na prawej stronie hero pozycje noszą te same krótkie nazwy co na lewej
// (jeden wiersz zamiast dwóch); pełne nazwy stoją na stronie kolejności niżej.
const HS_KR = KOLEJNOSC.map((_, i) => STRUMIEN.find((x) => x.k === i).ks);

const HS_ARIA = `Rozkładówka dokumentu strategii AI na przykładzie producenta mebli, który zatrudnia 140 osób. Na lewej stronie pierwsze ${HS_N} z ${STRUMIEN.length} pomysłów z działów: ${HS_L.filter((x) => x.pw).length} skreślonych ołówkiem z powodem, na przykład „nie rusza celu” albo „taniej integracją”, i ${HS_L.filter((x) => x.k !== undefined).length} zakreślone z numerem w kolejności. Pod listą dopisek: z ${HS_R.length} kolejnych ${HS_R_PLAN.length} weszły do planu, ${HS_R_ODRZ} odrzucono; razem odrzuconych ${ODRZUCONE_N} z ${STRUMIEN.length}. Na prawej stronie kolejność wdrożeń na dwanaście miesięcy: sześć pozycji z celem zarządu, miesiącem startu i zwrotem w pierwszym roku, od ${KOLEJNOSC[0].zw} do ${KOLEJNOSC[5].zw}. Plan pokrywa trzy cele zarządu w ${CEL_P[0]}, ${CEL_P[1]} i ${CEL_P[2]} procentach. Na wierzchu kartka z podpisaną decyzją zarządu: start pozycji 01 i 02 w pierwszym kwartale i jeden cennik w ERP przed startem 01.`;


// ---- RACHUNEK POZYCJI 02 (tarcza, strona rachunku) ------------------------
// Wejścia z kolumną „skąd" (wartości z koncepcji: 1 240 × 6,5 min, 12%, 68 zł,
// nakład 68 000 zł). Kontrolę i utrzymanie wycenia zespół wdrożeniowy — to
// jedyne wiersze, których firma doradcza nie ma skąd wziąć.
const R = { zam: 1240, min: 6.5, stawka: 68, wyj: 0.12, kontr: 0.5, naklad: 68000, utrz: 9600 };
const R_wyjN = Math.round(R.zam * R.wyj);              // 149 zamówień przy człowieku
const R_autoN = R.zam - R_wyjN;                        // 1 091 przyjętych automatycznie
const R_pracaH = R.zam * R.min / 60;                   // 134,3 h miesięcznie
const R_wyjH = R_wyjN * R.min / 60;                    // 16,1 h
const R_kontrH = R_autoN * R.kontr / 60;               // 9,1 h
const R_odzH = R_pracaH - R_wyjH - R_kontrH;           // 109,1 h
const naRok = (h) => Math.round(h * R.stawka * 12 / 100) * 100;
const R_naiwny = naRok(R_pracaH);                      // 109 600 zł
const R_wyjZl = naRok(R_wyjH);                         // 13 200 zł
const R_kontrZl = naRok(R_kontrH);                     // 7 400 zł
const R_wartosc = R_naiwny - R_wyjZl - R_kontrZl;      // 89 000 zł
const R_netto = R_wartosc - R.utrz;                    // 79 400 zł
const R_zwrot = pl(R_netto / R.naklad);                // 1,2
const R_prog = R.naklad / (R_netto / 12);              // 10,3 miesiąca
const R_progN = R.naklad / (R_naiwny / 12);            // 7,4 miesiąca
const R_progM = Math.ceil(R_prog);                     // 11.
const R_progNM = Math.ceil(R_progN);                   // 8.
const h = (x) => Math.round(x);

const ARKUSZ = [
  { t: 'Zamówienia z maila miesięcznie', v: tys(R.zam), z: 'eksport skrzynki zamówień, 3 miesiące' },
  { t: 'Czas przepisania jednego zamówienia', v: `${pl(R.min)} min`, z: 'pomiar na 40 zamówieniach w tygodniu 1' },
  { t: 'Koszt godziny działu obsługi', v: zl(R.stawka), z: 'stawka od działu kadr' },
  { t: 'Zamówienia, które zostają przy człowieku', v: `${Math.round(R.wyj * 100)}%`, z: 'przegląd 3 miesięcy historii' },
  { t: 'Kontrola zamówienia przyjętego automatycznie', v: `${pl(R.kontr)} min`, z: 'obiegi, które utrzymujemy u klientów', my: true },
  { t: 'Nakład na wdrożenie', v: zl(R.naklad), z: 'wycena zespołu, który to zbuduje', my: true },
  { t: 'Utrzymanie przez rok', v: zl(R.utrz), z: 'koszt utrzymania podobnych obiegów', my: true },
];

// Założenia potwierdzane z klientem w drugim tygodniu (przebieg: dzień 9).
const ZALOZENIA = [
  { t: `${Math.round(R.wyj * 100)}% zamówień zostaje przy człowieku`, k: 'kierownik działu obsługi zamówień' },
  { t: `${R.stawka} zł za godzinę pracy działu`, k: 'dział kadr' },
