// ---- TARCZA (dlaczego, blok 2) --------------------------------------------
// Tarcza to dwanaście miesięcy pierwszego roku. Łuk do miesiąca spłaty jest
// ciemny, po nim zielony. Przerywany łuk w środku: spłata z samych godzin.
// Czasy wejścia łuków liczone z tych samych liczb co tekst.
const TR = { r: 140, c: 200, rd: 111 };
const trPkt = (m, r) => {
  const a = (m / 12) * 2 * Math.PI;
  return [TR.c + r * Math.sin(a), TR.c - r * Math.cos(a)].map((v) => v.toFixed(1));
};
const TR_MIES = Array.from({ length: 12 }, (_, i) => i + 1);
const TR_DUCH_D = (() => {
  const [x0, y0] = trPkt(0, TR.rd), [x1, y1] = trPkt(R_progN, TR.rd);
  return `M${x0},${y0} A${TR.rd},${TR.rd} 0 ${R_progN > 6 ? 1 : 0} 1 ${x1},${y1}`;
})();
const TR_T = { start: 1.3, luk: 3.2 };
const TR_DUCH = (TR_T.start + TR_T.luk * (R_progN / R_prog)).toFixed(2);
const TR_RACH = [
  { t: 'Z samych godzin', d: `${h(R_pracaH)} h × ${R.stawka} zł × 12 miesięcy`, v: zl(R_naiwny), duch: true },
  { t: 'Sprawy, które zostają przy człowieku', d: `${Math.round(R.wyj * 100)}% zamówień · przegląd 3 miesięcy historii`, v: `−${zl(R_wyjZl)}` },
  { t: 'Kontrola zamówień przyjętych automatycznie', d: `${pl(R.kontr)} min na zamówienie`, v: `−${zl(R_kontrZl)}`, my: true },
  { t: 'Utrzymanie przez rok', d: 'wycena zespołu, który to utrzymuje', v: `−${zl(R.utrz)}`, my: true },
];

// ---- DWIE KOLEJNOŚCI (dlaczego, blok 1) -----------------------------------
// Dwanaście pomysłów z policzonymi godzinami. Z lewej po godzinach, które
// zdjęłyby z zespołu (od największej), z prawej po celach zarządu: sześć
// pozycji planu w jego kolejności, pod kreską „poza planem" reszta.
// Linie łączą to samo z dwóch stron. Wiersz ma stałą wysokość (--rh), lewa
// lista jest przesunięta o pół wiersza, więc y liczy się z numeru wiersza;
// skrypt przelicza ścieżki z prawdziwego rozmiaru rysunku.
const SG = STRUMIEN.filter((x) => x.h).sort((a, b) => b.h - a.h);
const SG_SUMA = SG.reduce((a, x) => a + x.h, 0);                                       // 583 h
const SG_PLAN_H = SG.filter((x) => x.k !== undefined).reduce((a, x) => a + x.h, 0);    // 205 h
const SL_PLAN = SG.filter((x) => x.k !== undefined).sort((a, b) => a.k - b.k);
const SL_POZA = SG.filter((x) => x.k === undefined);
const SL_R = [...SL_PLAN, null, ...SL_POZA];                                           // 13 wierszy
const SL_N = SL_R.length;
const SL_W = 200, SL_RH = 36;
const slD = (i, j) => { const yl = (i + 1) * SL_RH, yr = (j + 0.5) * SL_RH; return `M0,${yl} C${SL_W / 2},${yl} ${SL_W / 2},${yr} ${SL_W},${yr}`; };

