  .pb.gra .pb-b{transform:scaleX(0)}
  .pb.gra.on .pb-b{transform:none;transition:transform calc(var(--n) * var(--dz)) linear calc(var(--d0) * var(--dz) + 0.25s)}
  .pb.gra .pb-l{opacity:0;translate:0 5px}
  .pb.gra.on .pb-l{opacity:1;translate:0 0;transition:opacity .4s ease calc(var(--d0) * var(--dz) + 0.2s),translate .5s cubic-bezier(.2,.8,.2,1) calc(var(--d0) * var(--dz) + 0.2s)}
  .pb.gra .pb-zost > *{opacity:0;translate:0 -18px}
