  /* =====================================================================
     PRZYKŁADY · jedna skala czterech etapów, trzy firmy jako drogi
     Kreskowany bursztyn = etap, na którym firma była na starcie (stan
     „przed"), zieleń = droga przebyta od startu, przerywana szarość =
     to, co przed nimi. Etapy w nagłówku raz dla wszystkich. Droga rysuje
     się tyle, ile trwała (--m = miesiące), więc dystrybutor kończy ostatni.
     ===================================================================== */
  #przyklady .v3-cyt{margin-top:clamp(56px,7vw,96px) !important}
  .pm{margin:clamp(40px,4.4vw,64px) 0 0;container:pm / inline-size}
  .pm-gl,.pm-w{display:grid;grid-template-columns:minmax(0,2fr) minmax(0,5.4fr) minmax(0,3.6fr);gap:clamp(18px,2.6cqw,44px)}
  .pm-gl{align-items:end;padding-bottom:12px;border-bottom:1.5px solid var(--t1);font-size:12.5px;font-weight:650;color:var(--t3)}
  .pm-et{display:grid;grid-template-columns:repeat(4,minmax(0,1fr))}
  .pm-et span{padding:0 10px 0 8px;border-left:1px solid var(--linia);font-size:13px;font-weight:650;line-height:1.25;color:var(--t1)}
  .pm-et em{display:block;margin-bottom:3px;font-style:normal;font-family:var(--mono);font-size:11px;font-weight:400;color:var(--t3)}
  .pm-w{align-items:center;padding:clamp(22px,2.6cqw,34px) 0;border-bottom:1px solid var(--linia)}
  .pm-f h3{margin:0;font-size:clamp(18px,1.5vw,21px);font-weight:700;letter-spacing:-0.02em;line-height:1.2}
  .pm-f small{display:block;margin-top:3px;font-size:13px;color:var(--t3)}
  .pm-tor{position:relative;height:74px;background:linear-gradient(90deg,var(--linia) 1px,transparent 1px) 0 0 / 25% 100% repeat-x}
  .pm-tor::before{content:"";position:absolute;left:0;right:0;top:45px;height:2px;background:repeating-linear-gradient(90deg,rgba(15,26,20,0.2) 0 4px,rgba(15,26,20,0) 4px 9px)}
  .pm-przed{position:absolute;left:0;top:40px;width:calc((var(--od) - 0.5) * 25%);height:12px;border-radius:3px}
  .pm-droga{position:absolute;left:calc((var(--od) - 0.5) * 25%);top:42px;width:calc((var(--do) - var(--od)) * 25%);height:8px;border-radius:4px;background:var(--ziel);transform-origin:0 50%}
  .pm-pkt{position:absolute;top:38px;width:16px;height:16px;margin-left:-8px;border-radius:50%}
  .pm-pkt.od{left:calc((var(--od) - 0.5) * 25%);background:#ffffff;box-shadow:inset 0 0 0 3px var(--burs)}
  .pm-pkt.do{left:calc((var(--do) - 0.5) * 25%);background:var(--ziel);box-shadow:0 0 0 5px rgba(0,205,119,0.18)}
  .pm-lab{position:absolute;top:10px;font-size:12.5px;font-weight:700;white-space:nowrap;transform:translateX(-50%)}
  .pm-lab.od{left:calc((var(--od) - 0.5) * 25%);color:var(--burs-c)}
  .pm-lab.do{left:calc((var(--do) - 0.5) * 25%);color:var(--ziel-c)}
  .pm-lab.do.kon{transform:translateX(calc(-100% + 12px))}
  .pm-etm{display:none}
  .pm-zm{margin:0;padding:0;list-style:none}
  .pm-zm li{position:relative;padding:4px 0 4px 19px;font-size:14px;line-height:1.48;color:var(--t2);text-wrap:pretty}
  .pm-zm li::before{content:"";position:absolute;left:0;top:14px;width:10px;height:2px;background:var(--ziel)}
  .pm.gra .pm-droga{transform:scaleX(0)}
  .pm.gra .pm-pkt.do,.pm.gra .pm-lab.do{opacity:0}
  /* czas rysowania drogi = miesiące do dziś (0,12 s na miesiąc); wszystkie ruszają razem */
  .pm.gra.on .pm-droga{transform:none;transition:transform calc(var(--m) * 0.12s) cubic-bezier(.35,.1,.35,1) .35s}
  .pm.gra.on .pm-pkt.do,.pm.gra.on .pm-lab.do{opacity:1;transition:opacity .35s ease calc(var(--m) * 0.12s + .35s)}
