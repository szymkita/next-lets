<script>
  var redukcja = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- Odpalanie animacji, gdy element wchodzi w kadr ----
  (function(){
    var els = document.querySelectorAll('[data-anim]');
    if(!els.length) return;
    if(redukcja || !('IntersectionObserver' in window)){
      els.forEach(function(el){ el.classList.add('on'); });
      return;
    }
    var io = new IntersectionObserver(function(wpisy){
      wpisy.forEach(function(w){
        if(w.isIntersecting){ w.target.classList.add('on'); io.unobserve(w.target); }
      });
    }, { threshold: 0.22 });
    els.forEach(function(el){ io.observe(el); });
  })();

  // ---- Liczniki ----
  (function(){
    var els = document.querySelectorAll('.cnt');
    if(!els.length) return;
    function pisz(el, v, dec){
      var znak = v < 0 ? '−' : '';
      var abs = Math.abs(v);
      el.textContent = znak + (dec ? abs.toFixed(dec).replace('.', ',') : Math.round(abs).toString());
    }
    function licz(el){
      var cel = parseFloat(el.dataset.n);
      var dec = parseInt(el.dataset.dec || '0', 10);
      if(redukcja){ pisz(el, cel, dec); return; }
      var start = 0;
      function krok(teraz){
        if(!start) start = teraz;
        var p = Math.min(1, (teraz - start) / 1000);
        var e = 1 - Math.pow(1 - p, 3);
        pisz(el, cel * e, dec);
        if(p < 1) requestAnimationFrame(krok);
      }
      requestAnimationFrame(krok);
    }
    if(!('IntersectionObserver' in window)){ els.forEach(licz); return; }
    var io = new IntersectionObserver(function(wpisy){
      wpisy.forEach(function(w){ if(w.isIntersecting){ licz(w.target); io.unobserve(w.target); } });
    }, { threshold: 0.5 });
    els.forEach(function(el){ io.observe(el); });
  })();

</script>
</LaBase>
