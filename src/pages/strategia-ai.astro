  .pb-tyg:last-child{padding-right:0}
  .pb-tyg + .pb-tyg{border-left:1px solid var(--linia)}
  .pb-tg{font-size:18px;font-weight:700;letter-spacing:-0.018em}
  .pb-tg small{margin-left:8px;font-size:12.5px;font-weight:500;letter-spacing:0;color:var(--t3)}
  .pb-dni{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));margin-top:14px;padding-bottom:6px;border-bottom:1.5px solid var(--t1);font-family:var(--mono);font-size:11px;color:var(--t3)}
  .pb-dni span{padding-left:5px;border-left:1px solid var(--linia)}
  .pb-zad{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));row-gap:20px;padding:18px 0 26px;
    background:linear-gradient(90deg,var(--linia2) 1px,transparent 1px) 0 0 / 20% 100% repeat-x}
  .pb-b{grid-row:var(--r);grid-column:var(--c) / span var(--n);align-self:start;height:5px;margin:0 2px;border-radius:3px;background:var(--ziel);transform-origin:0 50%}
  .pb-l{grid-row:var(--r);grid-column:var(--c) / 6;display:flex;flex-direction:column;align-items:flex-start;gap:3px;margin-top:13px;padding:0 2px;min-width:0}
  .pb-l.prawo{grid-column:1 / calc(var(--c) + var(--n));align-items:flex-end;text-align:right}
  .pb-l em{font-style:normal;font-family:var(--mono);font-size:11px;color:var(--ziel-c)}
  .pb-l b{font-size:14.5px;font-weight:650;letter-spacing:-0.012em;line-height:1.3;text-wrap:balance}
  .pb-l .pb-wy{margin-top:5px}
  .pb-zost{position:relative;display:grid;margin-top:auto;padding:4px 14px 14px 0}
  .pb-zost > *{grid-area:1 / 1}
  .pb-kart{position:relative;display:flex;flex-direction:column;gap:3px;min-height:78px;padding:14px 32px 14px 16px;border-radius:3px;background:#ffffff;
    box-shadow:0 0 0 1px rgba(15,26,20,0.08),0 16px 28px -18px rgba(15,26,20,0.45)}
  .pb-kart::after{content:"";position:absolute;right:0;top:0;width:16px;height:16px;border-radius:0 3px 0 4px;background:linear-gradient(225deg,#ffffff 50%,#e2e5de 50%)}
  .pb-kart span{font-size:12px;color:var(--t3)}
  .pb-kart b{font-size:15px;font-weight:700;letter-spacing:-0.014em;line-height:1.3}
  .pb-kart.pod{transform:translate(7px,7px) rotate(1.3deg)}
  .pb-kart.pod2{transform:translate(13px,13px) rotate(-0.7deg)}
  .pb-okl{position:relative;display:flex;flex-direction:column;gap:3px;min-height:78px;padding:14px 18px 14px 22px;border-radius:2px 6px 6px 2px;background:linear-gradient(170deg,#153826,#07140d 70%);color:#ffffff;
    box-shadow:inset 4px 0 0 rgba(255,255,255,0.06),inset 5px 0 0 rgba(0,0,0,0.35),0 22px 36px -18px rgba(7,20,13,0.7)}
