<div class="v8-gl">
<h2 class="v3-h2">Trzy tygodnie od dostępów do dokumentu</h2>
<p class="v3-sub">Piętnaście dni roboczych i zwykle od 5 do 20 tysięcy złotych. Dokładną kwotę podajemy po bezpłatnej rozmowie, na której ustalamy zakres.</p>
</div>

<div class="pb" data-anim data-gra>
<div class="pb-przed">
<span>Przed startem</span>
<b>NDA i dostęp do systemów</b>
<span class="pb-n">Nie musicie niczego wcześniej opisywać ani porządkować.</span>
<span class="pb-wy"><svg viewBox="0 0 16 16" set:html={HL['user-group']} aria-hidden="true"></svg>Wy · lista procesów</span>
<span class="pb-zo">zostaje: <b>Lista procesów do przejrzenia</b></span>
</div>
<div class="pb-tygs">
{PRZEBIEG.map((w, wi) => (
  <div class="pb-tyg">
    <div class="pb-tg">{w.t}<small>dni {wi * 5 + 1}–{wi * 5 + 5}</small></div>
    <div class="pb-dni" aria-hidden="true">{[1, 2, 3, 4, 5].map((d) => (<span>{wi * 5 + d}</span>))}</div>
    <div class="pb-zad">
      {w.seg.map((s, si) => {
        const c = s.od - wi * 5;
        const st = `--c:${c};--n:${s.n};--r:${si + 1};--d0:${s.od - 1}`;
        return (<>
          <i class="pb-b" style={st} aria-hidden="true"></i>
          <div class={c >= 4 ? 'pb-l prawo' : 'pb-l'} style={st}>
            <em>{dniOpis(s)}</em>
            <b>{s.t}</b>
            {s.wy && <span class="pb-wy"><svg viewBox="0 0 16 16" set:html={HL['user-group']} aria-hidden="true"></svg>Wy · {s.wy}</span>}
          </div>
        </>);
      })}
    </div>
    <div class="pb-zost" style={`--d1:${wi * 5 + 5}`}>
      {wi >= 2 && <div class="pb-kart pod2" aria-hidden="true"></div>}
      {wi >= 1 && <div class="pb-kart pod" aria-hidden="true"></div>}
      {wi < PRZEBIEG.length - 1
        ? <div class="pb-kart"><span>zostaje</span><b>{w.zost}</b></div>
        : <div class="pb-okl"><span>zostaje</span><b>{w.zost}</b><i>kolejność · rachunek · ryzyka · plan kwartału</i></div>}
    </div>
  </div>
))}
</div>
</div>
</section>

<!-- ============ 8 · DLA KOGO ============
     „Jeszcze nie, jeśli" — jedyne miejsce, gdzie odsyłamy (z obecnej strony). -->
<DlaKogo sub="Najlepiej w kwartale, w którym zapada decyzja o budżecie na AI." warunki={DLA_KOGO} nieTytul="Jeszcze nie, jeśli" nie={NIE_TERAZ} />

<!-- ============ 9 · KONTAKT ============ -->
<Kontakt tytul="Zacznijmy od Waszej listy" lead="Wypiszcie cele, które macie na ten rok, i to, co próbowaliście już z AI. Odpowiemy z najbliższym wolnym terminem rozmowy." zrodlo="Strategia AI" pytanie="Co jest dziś na Waszej liście?" podpowiedz="Np. mamy 1 200 faktur kosztowych miesięcznie i dwie osoby, które je przepisują…" />

</div>

<GcFaq
  heading="Pytania, które padają przed decyzją"
  ctaLabel="Zadajcie nam swoje →"
  items={faq}
/>

<script>
  var redukcja = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var tablica = function(l){ return Array.prototype.slice.call(l); };

  // ---- HERO: przegląd listy na rozkładówce ----
  // Wiersz po wierszu: ołówek przechodzi przez listę z działów, odrzucony
  // dostaje kreskę i powód, przyjęty kółko i numer, a jego pozycja składa
  // się na prawej stronie na swoim miejscu; pasek celu rośnie o wkład.
  // Po liście spada kartka z decyzją i rysuje się podpis, chwila stanu
  // końcowego, wygaszenie, od nowa. Zegar idzie tylko, kiedy hero widać.
  (function(){
    var hs = document.querySelector('[data-hs]');
    if(!hs || redukcja || !window.requestAnimationFrame || !('IntersectionObserver' in window)) return;
    var P = tablica(hs.querySelectorAll('[data-hs-p]'));
    var K = tablica(hs.querySelectorAll('[data-hs-k]'));
    var C = tablica(hs.querySelectorAll('[data-hs-cel]'));
    var odrz = hs.querySelector('[data-hs-odrz]');
    var dal = hs.querySelector('[data-hs-dal]');
    var stan = C.map(function(){ return 0; }), ile = 0;
    var KROK = 0.6, START = 0.8, KON = START + P.length * KROK;
    var zd = [];
    P.forEach(function(p, i){
      var t = START + i * KROK;
      zd.push([t, function(){ p.classList.add('akt'); }]);
      zd.push([t + 0.28, function(){ werdykt(p); }]);
      zd.push([t + KROK - 0.01, function(){ p.classList.remove('akt'); }]);
    });
    zd.push([KON + 0.1, function(){ reszta(); }]);
    zd.push([KON + 0.95, function(){ hs.classList.add('dec'); }]);
    zd.push([KON + 1.55, function(){ hs.classList.add('pod'); }]);
    zd.push([KON + 7.8, function(){ hs.classList.add('zgas'); }]);
    zd.push([KON + 8.4, function(){ zeruj(); }]);
    zd.sort(function(a, b){ return a[0] - b[0]; });
    var zegar = 0, nr = 0, ost = null, widoczny = false, raf = 0;
    function cel(i, p, anim){
      var c = C[i], b = c.querySelector('[data-hs-pr]'), od = stan[i];
      c.style.setProperty('--p', p); stan[i] = p;
      if(!anim){ b.textContent = p + '%'; return; }
      var t0 = performance.now();
      (function k(t){
        var u = Math.min(1, (t - t0) / 750);
        b.textContent = Math.round(od + (p - od) * (1 - Math.pow(1 - u, 3))) + '%';
        if(u < 1) requestAnimationFrame(k);
      })(t0);
    }
    function werdykt(p){
      p.classList.add('on');
      var k = p.getAttribute('data-k');
      if(k !== null){
        var r = K[+k]; r.classList.add('on'); r.classList.remove('bl'); void r.offsetWidth; r.classList.add('bl');
        var c = +p.getAttribute('data-cel');
        cel(c, stan[c] + (+p.getAttribute('data-d')), true);
      } else {
        ile++; odrz.textContent = String(ile);
      }
    }
    // dopisek pod listą: przyjęte spoza strony zapalają się po prawej,
    // licznik odrzuconych dochodzi do pełnej liczby
    function reszta(){
      if(!dal) return;
      dal.classList.add('on');
      var suma = {};
      (dal.getAttribute('data-hs-dal') || '').split(' ').filter(Boolean).forEach(function(z){
        var a = z.split(':'), r = K[+a[0]];
        r.classList.add('on'); r.classList.remove('bl'); void r.offsetWidth; r.classList.add('bl');
        suma[a[1]] = (suma[a[1]] || 0) + (+a[2]);
      });
      Object.keys(suma).forEach(function(c){ cel(+c, stan[+c] + suma[c], true); });
      ile += +dal.getAttribute('data-x'); odrz.textContent = String(ile);
    }
    function zeruj(){
      hs.classList.add('bez');
      if(dal) dal.classList.remove('on');
      hs.classList.remove('dec', 'pod', 'zgas');
      P.forEach(function(p){ p.classList.remove('on', 'akt'); });
      K.forEach(function(r){ r.classList.remove('on', 'bl'); });
      C.forEach(function(_, i){ stan[i] = 0; cel(i, 0, false); });
      ile = 0; odrz.textContent = '0';
      void hs.offsetWidth;
      hs.classList.remove('bez');
      zegar = 0; nr = 0;
    }
    function klatka(t){
      raf = 0;
      if(!widoczny){ ost = null; return; }
      if(ost === null) ost = t;
      zegar += Math.min(0.1, (t - ost) / 1000); ost = t;
      while(nr < zd.length && zd[nr][0] <= zegar){ zd[nr++][1](); }
      raf = requestAnimationFrame(klatka);
    }
    hs.classList.add('gra'); zeruj();
    new IntersectionObserver(function(w){
      widoczny = w[0].isIntersecting;
      if(widoczny && !raf){ ost = null; raf = requestAnimationFrame(klatka); }
    }, { threshold: 0.15 }).observe(hs);
  })();

  // ---- Dwie kolejności ----
  // Ścieżki liczone z prawdziwego rozmiaru rysunku (viewBox = piksele), więc
  // kreska ma tę samą grubość przy każdej szerokości. Po wejściu w kadr linie
  // rysują się od największej oszczędności; licznik „w planie" rośnie tylko
  // na zielonych. Bez ruchu: stan końcowy z markupu.
  (function(){
    var sl = document.querySelector('[data-sl]');
    if(!sl) return;
    var svg = sl.querySelector('.sl-svg');
    var ln = tablica(sl.querySelectorAll('[data-sl-ln]'));
    var L = tablica(sl.querySelectorAll('[data-sl-l]'));
    var R = {}; tablica(sl.querySelectorAll('[data-sl-r]')).forEach(function(e){ R[e.getAttribute('data-j')] = e; });
    var licz = sl.querySelector('[data-sl-licz]');
    var N = 13;
    function geo(){
      var W = svg.clientWidth, H = svg.clientHeight;
      if(!W || !H) return;
      var rh = H / N, x = (W / 2).toFixed(1);
      svg.setAttribute('viewBox', '0 0 ' + W + ' ' + H);
      ln.forEach(function(p){
        var yl = ((+p.getAttribute('data-i') + 1) * rh).toFixed(1), yr = ((+p.getAttribute('data-j') + 0.5) * rh).toFixed(1);
        p.setAttribute('d', 'M0,' + yl + ' C' + x + ',' + yl + ' ' + x + ',' + yr + ' ' + W + ',' + yr);
      });
    }
    geo();
    window.addEventListener('resize', geo);
    if(redukcja || !('IntersectionObserver' in window)) return;
    sl.classList.add('gra');
    licz.textContent = '0 h';
    function czekaj(ms){ return new Promise(function(r){ setTimeout(r, ms); }); }
    async function graj(){
      var suma = 0;
      for(var i = 0; i < ln.length; i++){
        var l = L[i], p = ln[i], r = R[p.getAttribute('data-j')];
        l.classList.add('akt'); p.classList.add('on');
        await czekaj(420);
        r.classList.add('on'); l.classList.remove('akt'); l.classList.add('on');
        if(l.getAttribute('data-z') === '1'){
          suma += +l.getAttribute('data-h');
          licz.textContent = suma + ' h';
          licz.classList.remove('tik'); void licz.offsetWidth; licz.classList.add('tik');
        }
        await czekaj(160);
      }
    }
    var io = new IntersectionObserver(function(w){
      if(w[0].isIntersecting){ io.disconnect(); setTimeout(graj, 300); }
    }, { threshold: 0.35 });
    io.observe(sl);
  })();

  // ---- Dokument strategii: stos kartek i przekładki ----
  // Kolejność w stosie trzyma tablica (wierzch na początku). Wybrana kartka
  // wysuwa się spod stosu w prawo, przechodzi na wierzch i wraca na miejsce;
  // reszta przesuwa się o jedną pozycję w dół. Potem zakreślacz na nowej
  // kartce. Na wąskim ekranie i przy ograniczonym ruchu: zwykłe przełączenie.
  (function(){
    var sd = document.querySelector('[data-sd]');
    if(!sd) return;
    var zak = tablica(sd.querySelectorAll('[data-sd-zak]'));
    var strony = tablica(sd.querySelectorAll('[data-sd-v]'));
    var podpisy = tablica(document.querySelectorAll('[data-sd-p]'));
    var kolej = JSON.parse(sd.getAttribute('data-kolej'));
    var ruch = !redukcja && typeof Element.prototype.animate === 'function' && 'IntersectionObserver' in window;
    var trwa = false;
    if(ruch) sd.classList.add('gra');
    function ustaw(){
      kolej.forEach(function(i, g){
        var s = strony[i], na = g === 0;
        s.style.setProperty('--g', g);
        s.classList.toggle('akt', na);
        s.inert = !na;
        if(na) s.removeAttribute('aria-hidden'); else s.setAttribute('aria-hidden', 'true');
      });
      zak.forEach(function(b, j){ var na = j === kolej[0]; b.setAttribute('aria-selected', na ? 'true' : 'false'); b.tabIndex = na ? 0 : -1; });
      podpisy.forEach(function(p, j){ p.hidden = j !== kolej[0]; });
    }
    function zakresl(s){
      if(!ruch) return;
      strony.forEach(function(x){ if(x !== s) x.classList.remove('zk'); });
      s.classList.remove('zk'); void s.offsetWidth; s.classList.add('zk');
    }
    function pokaz(i, fokus){
      if(fokus) zak[i].focus();
      if(i === kolej[0] || trwa) return;
      var s = strony[i];
      kolej = [i].concat(kolej.filter(function(x){ return x !== i; }));
      // poniżej 760 px stos to jedna kartka na dwóch atrapach (CSS), bez wysuwania
      if(!ruch || sd.clientWidth < 760){ ustaw(); zakresl(s); return; }
      trwa = true;
      var start = getComputedStyle(s).transform;
      var wyj = 'translate(26%, -2%) rotate(2.6deg)';
      s.style.transition = 'none';
      var a1 = s.animate([{ transform: start }, { transform: wyj }], { duration: 300, easing: 'cubic-bezier(.45,0,.55,1)', fill: 'forwards' });
      a1.onfinish = function(){
        ustaw();
        var a2 = s.animate([{ transform: wyj }, { transform: 'none' }], { duration: 460, easing: 'cubic-bezier(.2,.8,.25,1)' });
        a1.cancel();
        a2.onfinish = function(){ s.style.transition = ''; trwa = false; };
        zakresl(s);
      };
    }
    zak.forEach(function(b, i){
      b.addEventListener('click', function(){ pokaz(i); });
      b.addEventListener('keydown', function(e){
        if(e.key === 'ArrowRight' || e.key === 'ArrowDown'){ e.preventDefault(); pokaz((i + 1) % zak.length, true); }
        if(e.key === 'ArrowLeft' || e.key === 'ArrowUp'){ e.preventDefault(); pokaz((i - 1 + zak.length) % zak.length, true); }
      });
    });
    ustaw();
    if(ruch){
      var io = new IntersectionObserver(function(w){
        if(w[0].isIntersecting){ io.disconnect(); zakresl(strony[kolej[0]]); }
      }, { threshold: 0.35 });
      io.observe(sd);
    }
  })();
</script>
</LaBase>
