  .pb-tygs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:clamp(30px,3.4vw,46px)}
  .pb-tyg{display:flex;flex-direction:column;min-width:0;padding:0 clamp(14px,1.6vw,26px)}
