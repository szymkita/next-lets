  ...luki,
  ...finisze,
  ...procenty.map((x) => x.kl),
  ...lista.filter((z) => z.typ !== 'ogon').map((z) => {
    const kon = z.typ === 'tak' ? '1' : (z.typ === 'powod' ? '.3' : '.18');
    return `@keyframes st-w${z.i}{0%,${pc(z.werdykt)}{opacity:1}${pc(z.werdykt + 0.45)}{opacity:${kon}}100%{opacity:${kon}}}`;
  }),
  ...przyjete.map((z) => `@keyframes st-szk${z.i}{0%,${pc(z.werdykt)}{opacity:1}${pc(z.werdykt + 0.25)}{opacity:0}100%{opacity:0}}
@keyframes st-txt${z.i}{0%,${pc(z.werdykt + 0.1)}{opacity:0;filter:blur(7px)}${pc(z.werdykt + 0.55)}{opacity:1;filter:blur(0)}100%{opacity:1;filter:blur(0)}}`),
  ...lista.filter((z) => z.typ === 'tak' || z.typ === 'powod').map((z) => `@keyframes st-werd${z.i}{0%,${pc(z.werdykt)}{opacity:0;transform:scale(.75)}${pc(z.werdykt + 0.3)}{opacity:1;transform:scale(1)}100%{opacity:1;transform:scale(1)}}`),
  ...lista.filter((z) => z.typ !== 'ogon').map((z) => `@keyframes st-bada${z.i}{0%,${pc(z.werdykt - 0.75)}{opacity:0}${pc(z.werdykt - 0.6)}{opacity:1}${pc(z.werdykt - 0.06)}{opacity:1}${pc(z.werdykt)}{opacity:0}100%{opacity:0}}`),
].join('\n');


