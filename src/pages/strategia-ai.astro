const KOLKO = 'M20 3.6C9 2.6 2.6 7 3 13c.6 6.5 10 8.5 19 7.5 8-.9 12-5.5 11-10.5S24 2.8 14.6 4.3';
const PODPIS = 'M8 30C12 14 20 6 24 12s-6 22-8 18 14-16 20-10-0 12 6 10 8-14 12-12-0 12 6 11 10-11 16-9-2 10 6 8 12-14 20-12-2 12 10 10 26-10 46-14';
