function losowy(ziarno) {
  let a = ziarno;
  return () => {
    a |= 0; a = (a + 0x6D2B79F5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rnd = losowy(20260831);

// Chwila werdyktu wynika z tego, kiedy wiersz mija linię decyzji.
// Procent celu to suma wkładów wszystkich pozycji, które do niego trafiły.
const suma = [0, 0, 0];
const lista = strumien.map((z, i) => {
  const w = {
    ...z, i,
    werdykt: PRZEWIJ * ((i * WIERSZ + WIERSZ / 2 + WIDOK - LINIA) / TOR),
    kreski: [56 + rnd() * 30, 26 + rnd() * 32],
  };
  if (z.typ === 'tak') {
    suma[z.cel] += z.d;
    w.p = suma[z.cel];
  }
  return w;
});
const przyjete = lista.filter((z) => z.typ === 'tak');

const pc = (sek) => `${(Math.max(0, Math.min(1, sek / CYKL)) * 100).toFixed(2)}%`;

const luki = cele.map((c, ci) => {
  const kroki = przyjete.filter((z) => z.cel === ci);
  let kl = `@keyframes ce-luk${ci}{0%,${pc(kroki[0].werdykt)}{stroke-dashoffset:1}`;
  kroki.forEach((z, j) => {
    const doc = (1 - z.p / 100).toFixed(3);
    kl += `${pc(z.werdykt + 0.8)}{stroke-dashoffset:${doc}}`;
    if (j < kroki.length - 1) kl += `${pc(kroki[j + 1].werdykt)}{stroke-dashoffset:${doc}}`;
  });
  kl += `${pc(ZGASNIE)}{stroke-dashoffset:0}100%{stroke-dashoffset:1}}`;
  return kl;
});

const finisze = cele.map((c, ci) => {
  const kroki = przyjete.filter((z) => z.cel === ci);
  const t = kroki[kroki.length - 1].werdykt + 0.8;
  return `@keyframes ce-fin${ci}{0%,${pc(t)}{opacity:0;transform:scale(1)}${pc(t + 0.18)}{opacity:.55;transform:scale(1.02)}${pc(t + 1.2)}{opacity:0;transform:scale(1.36)}100%{opacity:0;transform:scale(1.36)}}
@keyframes ce-pop${ci}{0%,${pc(t)}{transform:scale(1)}${pc(t + 0.22)}{transform:scale(1.055)}${pc(t + 0.8)}{transform:scale(1)}100%{transform:scale(1)}}`;
});

const procenty = [];
cele.forEach((c, ci) => {
  const kroki = przyjete.filter((z) => z.cel === ci);
  kroki.forEach((z, j) => {
    const nast = kroki[j + 1];
    const ostatni = !nast;
    procenty.push({
      ci, j, p: z.p, ostatni,
      kl: ostatni
        ? `@keyframes ce-pro${ci}_${j}{0%,${pc(z.werdykt + 0.5)}{opacity:0}${pc(z.werdykt + 0.75)}{opacity:1}${pc(ODDECH)}{opacity:1}${pc(ZGASNIE)}{opacity:0}100%{opacity:0}}`
        : `@keyframes ce-pro${ci}_${j}{0%,${pc(z.werdykt + 0.5)}{opacity:0}${pc(z.werdykt + 0.75)}{opacity:1}${pc(nast.werdykt + 0.45)}{opacity:1}${pc(nast.werdykt + 0.65)}{opacity:0}100%{opacity:0}}`,
    });
  });
});

const klatki = [
