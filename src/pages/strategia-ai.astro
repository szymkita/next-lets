const CYKL = 32;
const PRZEWIJ = 27;            // ile trwa przesuw strumienia
const ODDECH = 29.6;           // ile stoi na komplecie, zanim zgaśnie
const ZGASNIE = 31;            // po tym reset dzieje się już niewidocznie
const WIERSZ = 40, WIDOK = 360, ILE = 32;
const LINIA = 320;             // wysokość, na której zapada werdykt
const TOR = ILE * WIERSZ;

