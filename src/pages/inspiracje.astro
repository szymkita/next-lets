// Iskierka: prawdziwa łamana SVG zamiast rzędu <div>-ów.
const iskra = (v, w, h) => {
  const mx = Math.max(...v);
  const mn = Math.min(...v);
  const r = mx - mn || 1;
  return v.map((x, i) => `${((i / (v.length - 1)) * w).toFixed(1)},${(h - ((x - mn) / r) * h).toFixed(1)}`).join(' ');
};

