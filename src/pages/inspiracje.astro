  { q: 'Ile trwa zbudowanie takiej aplikacji?', a: 'Od trzech tygodni do trzech miesięcy, zależnie od tego, ile systemów trzeba dotknąć i ile przypadków szczególnych ma Wasz proces. Zaczynamy od jednej rzeczy, uruchamiamy ją na produkcji i dopiero potem bierzemy następną. Ciemny pas wyżej pokazuje, jak wyglądał taki rok w jednej firmie.' },
  { q: 'Czy do wszystkiego potrzebny jest model AI?', a: 'Nie. Aplikacje z showreelu to w większości zwykłe oprogramowanie: rejestry, karty spraw, obiegi, kokpity. Model dokładamy tam, gdzie wąskim gardłem jest czytanie albo słuchanie — i to są rzeczy z sekcji pod spodem. Jedno i drugie budujemy tak samo często.' },
  { q: 'Ile to kosztuje?', a: 'Cena idzie za wielkością rzeczy i za liczbą wyjątków w Waszym procesie. Największy wpływ mają trzy sprawy: ile systemów trzeba dotknąć, ile przypadków szczególnych obsługujecie i czy dane są już w jednym miejscu. Widełki podajemy po pierwszej rozmowie, na której przechodzimy jedną pozycję do końca. Nie mamy prowizji od żadnego dostawcy, więc wybór narzędzia nie zmienia naszego przychodu.' },
  { q: 'Czyja jest ta aplikacja po odbiorze?', a: 'Wasza. Repozytorium, klucze i dostępy są Wasze od pierwszego dnia, więc utrzymanie może przejąć Wasz zespół albo inny dostawca. Kiedy utrzymujemy my, umowa jest osobna od budowy i wypowiadalna z miesięcznym terminem. Jeśli chcecie budować sami, tym zajmuje się <a href="/guided-coding" style="font-weight:700;color:#0a7a52">Guided Coding</a> — kod pisze Wasz zespół, my pilnujemy jakości.' },
];
dane['@graph'].push({ '@type': 'FAQPage', '@id': `${kanon}#faq`, mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })) });
---
<LaBase title={title} description={description} ctaHref="#kontakt" ctaLabel="Umów rozmowę" nav="inspiracje">
<script type="application/ld+json" is:inline set:html={JSON.stringify(dane)} slot="head"></script>
<style is:global slot="head">
  /* =====================================================================
     SYSTEM MAKIET

     Jedna biblioteka kontrolek, SIEDEM MAREK KLIENTÓW. Ekran nie jest
     przemalowanym szablonem: każda firma ma własny odcień szarości,
     własny akcent, własny promień narożnika, własny krój i własny znak.
     Dlatego dwanaście ekranów obok siebie wygląda jak dwanaście produktów,
     a nie jak jeden wygenerowany dwanaście razy.

       WELDON   konstrukcje stalowe      kobalt     kanty 6   chłodna stal
       NORDIS   dystrybucja techniki     terakota   kanty 3   ciepła szarość
       KALTER   zakład produkcyjny       limonka    kanty 4   ciemny, na ścianę
       AERIS    serwis klimatyzacji      turkus     kanty 10  miękki, mobilny
       MEDIRA   sieć przychodni          fiolet     kanty 8   jasny, gęsty
       REJENT   kancelaria               bordo      kanty 2   szeryf, dokument
       VANTIS   grupa usługowa           grafit     kanty 8   liczby monospace
     ===================================================================== */
  .ap{
    /* wartości domyślne — nadpisuje je klasa marki */
    --n0:#ffffff; --n1:#f7f8f7; --n2:#eceeec; --n3:#dfe2df;
    --n4:#9ba49d; --n5:#5f6a62; --n6:#18211c;
    --ac:#0a7a52; --ac2:#00CD77; --acr:0,205,119; --acfg:#0b1a11;
    --acs:#e7f6ee; --acs2:#cdeddd; --acm:#7fd8ae;
    --am:#b5761d; --ams:#fdf1df; --amb:#e0a854;
    --ink:#16211a; --inkfg:#ffffff;
    --mkbg:#16211a; --mkfg:#ffffff; --mkr:6px;
    --r1:6px; --r2:8px; --r3:13px;
    --nvw:196px; --ffh:inherit; --ffn:inherit;
    --shr:20,32,25;
    --st1:#f4f6f4; --st2:#e9ede9;
    display:grid;grid-template-columns:var(--nvw) minmax(0,1fr);width:100%;min-width:0;
    background:var(--n0);border-radius:var(--r3);overflow:hidden;color:var(--n6);
    font-size:12.5px;line-height:1.45;
    box-shadow:0 0 0 1px rgba(var(--shr),0.08),0 2px 4px -2px rgba(var(--shr),0.10),0 14px 26px -14px rgba(var(--shr),0.18),0 40px 72px -40px rgba(var(--shr),0.38);
  }
  .ap.solo{grid-template-columns:minmax(0,1fr)}
  .ap.rail{--nvw:52px}

  /* ---------- A · WELDON — konstrukcje stalowe i montaże ---------- */
  .b-wel{
    --acm:#90a9f5;
    --st1:#edf0f6; --st2:#e2e8f2;
    --n0:#ffffff; --n1:#f5f7fa; --n2:#e5eaf1; --n3:#d3dae5;
    --n4:#8c96a8; --n5:#556075; --n6:#131a26;
    --ac:#2743b4; --ac2:#3358ea; --acr:51,88,234; --acfg:#ffffff;
    --acs:#e9eeff; --acs2:#d5e0ff;
    --am:#a2620d; --ams:#fdf0da; --amb:#dda03e;
    --ink:#131a26; --inkfg:#ffffff;
    --mkbg:#131a26; --mkfg:#ffffff; --mkr:3px;
    --r1:5px; --r2:6px; --r3:11px;
    --shr:24,34,56;
  }
  /* znak: kwadrat ze ściętym narożnikiem */
  .b-wel .nv-ws i,.b-wel .mk-znak{clip-path:polygon(0 0,100% 0,100% 68%,68% 100%,0 100%)}

  /* ---------- B · NORDIS — dystrybucja techniki grzewczej ---------- */
  .b-nor{
    --acm:#eba071;
    --st1:#f7f2eb; --st2:#f0e7dc;
    --n0:#ffffff; --n1:#faf8f5; --n2:#eee8e1; --n3:#e0d8cd;
    --n4:#a3968a; --n5:#6c6056; --n6:#1f1913;
    --ac:#a8400f; --ac2:#cf5510; --acr:207,85,16; --acfg:#ffffff;
    --acs:#fceee5; --acs2:#f8dcc9;
    --am:#7c6412; --ams:#f9f2d6; --amb:#c4a52a;
    --ink:#241c14; --inkfg:#ffffff;
    --mkbg:#cf5510; --mkfg:#ffffff; --mkr:0px;
    --r1:2px; --r2:3px; --r3:6px;
    --ffn:ui-monospace,'SF Mono',Menlo,monospace;
    --shr:52,38,26;
  }
  /* znak: sześciokąt */
  .b-nor .nv-ws i,.b-nor .mk-znak{clip-path:polygon(25% 3%,75% 3%,100% 50%,75% 97%,25% 97%,0 50%)}

  /* ---------- C · KALTER — zakład produkcyjny, tablica na ścianie ---------- */
  .b-kal{
    --acm:rgba(185,244,92,0.42);
    --st1:#242b2c; --st2:#12191a;
    --n0:#0c110f; --n1:#131a16; --n2:#1f2a24; --n3:#2b3830;
    --n4:#77877d; --n5:#a7b5ab; --n6:#eef4ef;
    --ac:#b9f45c; --ac2:#b9f45c; --acr:185,244,92; --acfg:#16210b;
    --acs:rgba(185,244,92,0.13); --acs2:rgba(185,244,92,0.22);
    --am:#f2af46; --ams:rgba(242,175,70,0.14); --amb:#f2af46;
    --ink:#eef4ef; --inkfg:#0c110f;
    --mkbg:#b9f45c; --mkfg:#16210b; --mkr:2px;
    --r1:3px; --r2:4px; --r3:10px;
    --shr:0,0,0;
  }
  .ap.b-kal{box-shadow:0 0 0 1px rgba(255,255,255,0.10),0 40px 72px -36px rgba(0,0,0,0.7)}

  /* ---------- D · AERIS — serwis klimatyzacji i wentylacji ---------- */
  .b-aer{
    --acm:#6ec3d6;
    --st1:#e8f3f6; --st2:#d9ecf1;
    --n0:#ffffff; --n1:#f1f8f9; --n2:#dfeef1; --n3:#c9e1e6;
    --n4:#7e9aa1; --n5:#4b656c; --n6:#0c2126;
    --ac:#046b7e; --ac2:#0898b4; --acr:8,152,180; --acfg:#ffffff;
    --acs:#e1f5f8; --acs2:#c6ebf2;
    --am:#b0651c; --ams:#fdeedc; --amb:#e19a4d;
    --ink:#0c2126; --inkfg:#ffffff;
    --mkbg:#0898b4; --mkfg:#ffffff; --mkr:50%;
    --r1:8px; --r2:11px; --r3:18px;
    --shr:12,44,52;
  }

  /* ---------- E · MEDIRA — sieć przychodni i laboratoriów ---------- */
  .b-med{
    --acm:#b294f3;
    --st1:#f4f1fb; --st2:#ebe5f7;
    --n0:#ffffff; --n1:#f8f6fd; --n2:#ebe6f7; --n3:#dcd4ee;
    --n4:#9a91ad; --n5:#605777; --n6:#191231;
    --ac:#5730c0; --ac2:#7549e8; --acr:117,73,232; --acfg:#ffffff;
    --acs:#f0eaff; --acs2:#e0d5ff;
    --am:#a1571a; --ams:#fdefdf; --amb:#e0a05a;
    --ink:#191231; --inkfg:#ffffff;
    --mkbg:#7549e8; --mkfg:#ffffff; --mkr:9px;
    --r1:7px; --r2:9px; --r3:14px;
    --shr:34,24,64;
  }

  /* ---------- F · REJENT — kancelaria, obsługa umów ---------- */
  .b-rej{
    --acm:#d18d92;
    --st1:#f3f1ed; --st2:#eae5de;
    --n0:#ffffff; --n1:#f7f6f4; --n2:#e9e6e1; --n3:#dad6cf;
    --n4:#98928a; --n5:#5e5a53; --n6:#181613;
    --ac:#94272f; --ac2:#ab2f38; --acr:171,47,56; --acfg:#ffffff;
    --acs:#f8eaea; --acs2:#f0d6d7;
    --am:#7f6415; --ams:#f8f1d9; --amb:#c0a233;
    --ink:#181613; --inkfg:#ffffff;
    --mkbg:#94272f; --mkfg:#ffffff; --mkr:1px;
    --r1:1px; --r2:2px; --r3:4px;
    --ffh:'Iowan Old Style',Georgia,'Times New Roman',serif;
    --shr:40,32,26;
  }

  /* ---------- G · VANTIS — grupa usługowa, finanse i zarząd ---------- */
  .b-van{
    --acm:#6db7a7;
    --st1:#edf1f1; --st2:#e0e7e7;
    --n0:#ffffff; --n1:#f6f7f7; --n2:#e8eaea; --n3:#d7dbdb;
    --n4:#909798; --n5:#5a6263; --n6:#141819;
    --ac:#0d6b5c; --ac2:#0f8571; --acr:15,133,113; --acfg:#ffffff;
    --acs:#e4f2ef; --acs2:#cbe6e0;
    --am:#8f5f10; --ams:#fbf0dc; --amb:#d09a3a;
    --ink:#141819; --inkfg:#ffffff;
    --mkbg:#141819; --mkfg:#ffffff; --mkr:50%;
    --r1:7px; --r2:9px; --r3:12px;
    --ffn:ui-monospace,'SF Mono',Menlo,monospace;
    --shr:20,28,28;
  }

  /* ---------- boczny pasek ---------- */
  .nv{display:flex;flex-direction:column;gap:1px;padding:11px 9px;background:var(--n1);border-right:1px solid var(--n2)}
  .nv-ws{display:flex;align-items:center;gap:9px;padding:7px 8px;margin-bottom:11px;border-radius:var(--r2);background:var(--n0);box-shadow:0 1px 2px rgba(var(--shr),0.07),0 0 0 1px rgba(var(--shr),0.07)}
  .nv-ws i{flex:0 0 21px;height:21px;border-radius:var(--mkr);background:var(--mkbg);color:var(--mkfg);font-size:9.5px;font-weight:800;display:grid;place-items:center;font-style:normal;letter-spacing:0.02em}
  .nv-ws b{font-size:12px;font-weight:700;letter-spacing:-0.01em;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .nv-ws svg{margin-left:auto;flex-shrink:0;color:var(--n4)}
  .nv-g{margin:13px 0 4px;padding:0 8px;font-size:9.5px;font-weight:650;letter-spacing:0.07em;text-transform:uppercase;color:var(--n4)}
  .nv-i{display:flex;align-items:center;gap:9px;padding:6px 8px;border-radius:var(--r2);font-size:12.5px;color:var(--n5);white-space:nowrap;overflow:hidden}
  .nv-i > svg{flex:0 0 15px}
  .nv-i em{margin-left:auto;font-style:normal;font-size:10.5px;font-weight:650;color:var(--n4);font-family:var(--ffn)}
  .nv-i em.tag{padding:1px 6px;border-radius:20px;background:var(--ams);color:var(--am);font-weight:700}
  .nv-i.on{background:var(--n0);color:var(--n6);font-weight:650;box-shadow:0 1px 2px rgba(var(--shr),0.07),0 0 0 1px rgba(var(--shr),0.07)}
  .nv-i.on > svg{color:var(--ac)}
  .nv-b{margin-top:auto;display:flex;align-items:center;gap:8px;padding:8px;border-radius:var(--r2);background:var(--n0);box-shadow:0 0 0 1px rgba(var(--shr),0.07)}
  /* pasek ikon — węższy pokrój bocznej nawigacji.
     Etykiety to gołe węzły tekstowe, więc gasi je font-size, nie display. */
  .ap.rail .nv{padding:10px 6px;align-items:center;gap:4px}
  .ap.rail .nv-ws{padding:0;margin-bottom:13px;background:none;box-shadow:none}
  .ap.rail .nv-ws b,.ap.rail .nv-ws > svg,.ap.rail .nv-g,.ap.rail .nv-i em,.ap.rail .nv-b span:not(.av){display:none}
  .ap.rail .nv-ws i{flex-basis:26px;height:26px;font-size:11px}
  .ap.rail .nv-i{padding:0;width:34px;height:34px;font-size:0;place-content:center;justify-content:center}
  .ap.rail .nv-i > svg{flex:0 0 16px;width:16px;height:16px}
  .ap.rail .nv-b{padding:0;background:none;box-shadow:none;justify-content:center}
  /* kropka zamiast licznika — informacja zostaje, miejsca nie ma */
  .ap.rail .nv-i:has(em.tag){position:relative}
  .ap.rail .nv-i:has(em.tag)::after{content:"";position:absolute;top:5px;right:5px;width:6px;height:6px;border-radius:50%;background:var(--amb);box-shadow:0 0 0 2px var(--n1)}

  /* ciemna makieta — akcent świeci zamiast leżeć */
  .b-kal .nv-i.on{background:rgba(255,255,255,0.07);box-shadow:none}

  /* ---------- pasek górny ---------- */
  .tp{display:flex;align-items:center;gap:12px;padding:10px 15px;border-bottom:1px solid var(--n2);background:var(--n0)}
  .bc{display:flex;align-items:center;gap:7px;font-size:12px;color:var(--n4);min-width:0}
  /* Ekran bez bocznego paska i tak musi mówić, czyja to aplikacja. */
  .mk-znak{display:grid;place-items:center;flex:0 0 21px;height:21px;border-radius:var(--mkr);background:var(--mkbg);color:var(--mkfg);font-size:9.5px;font-weight:800;font-style:normal;letter-spacing:0.02em}
  .mk-nm{font-weight:750;letter-spacing:-0.012em;color:var(--n6)}
  .mk-sep{width:1px;height:14px;background:var(--n3);margin:0 2px}
  /* Rejent czyta dokumenty, więc i wygląda jak dokument */
  .b-rej .mk-nm,.b-rej .bc b,.b-rej .as-a p,.b-rej .ttl{font-family:var(--ffh)}
  .b-rej .as-a p{font-size:13px;line-height:1.6}
  .bc b{font-weight:650;color:var(--n6)}
  .bc svg{flex-shrink:0;transform:rotate(-90deg);color:var(--n3)}
  .sr{margin-left:auto;display:flex;align-items:center;gap:8px;width:clamp(140px,17vw,216px);padding:5px 9px;border-radius:var(--r2);background:var(--n1);box-shadow:inset 0 0 0 1px var(--n2);font-size:11.5px;color:var(--n4)}
  .sr kbd{margin-left:auto;font-family:ui-monospace,Menlo,monospace;font-size:9px;padding:1.5px 5px;border-radius:calc(var(--r1) - 1px);background:var(--n0);box-shadow:0 0 0 1px var(--n3);color:var(--n4)}
  .ico{display:grid;place-items:center;width:26px;height:26px;border-radius:var(--r1);color:var(--n5);flex-shrink:0}
  .ico.dot{position:relative}
  .ico.dot::after{content:"";position:absolute;top:5px;right:6px;width:6px;height:6px;border-radius:50%;background:var(--ac2);box-shadow:0 0 0 2px var(--n0)}
  .av{flex-shrink:0;display:grid;place-items:center;width:25px;height:25px;border-radius:50%;background:var(--n2);color:var(--n5);font-size:9.5px;font-weight:750;letter-spacing:0.01em}
  .av.s{width:20px;height:20px;font-size:8.5px}
  .av.ac{background:var(--acs2);color:var(--ac)}

  /* ---------- nagłówek strony i pasek narzędzi ---------- */
  .hd{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;padding:15px 15px 0}
  .hd h4{margin:0;font-family:var(--ffh);font-size:16.5px;font-weight:750;letter-spacing:-0.022em;line-height:1.2}
  .hd p{margin:3px 0 0;font-size:11.5px;color:var(--n4)}
  .hd-a{display:flex;align-items:center;gap:7px;flex-shrink:0}
  .tl{display:flex;align-items:center;gap:7px;flex-wrap:wrap;padding:12px 15px 11px}
  .sg{display:flex;gap:2px;padding:2px;border-radius:var(--r2);background:var(--n1);box-shadow:inset 0 0 0 1px var(--n2)}
  .sg span{padding:4px 10px;border-radius:var(--r1);font-size:11.5px;color:var(--n5);white-space:nowrap}
  .sg span.on{background:var(--n0);color:var(--n6);font-weight:650;box-shadow:0 1px 2px rgba(var(--shr),0.10)}
  .fc{display:inline-flex;align-items:center;gap:6px;padding:4px 9px;border-radius:var(--r1);font-size:11.5px;color:var(--n5);box-shadow:inset 0 0 0 1px var(--n3)}
  .fc b{font-weight:650;color:var(--n6)}
  .fc svg{color:var(--n4)}
  .bn{display:inline-flex;align-items:center;gap:6px;padding:6px 11px;border-radius:var(--r2);font-size:11.5px;font-weight:650;white-space:nowrap}
  .bn.p{background:var(--ink);color:var(--inkfg)}
  .bn.g{color:var(--n5);box-shadow:inset 0 0 0 1px var(--n3)}
  .bn.a{background:var(--ac2);color:var(--acfg)}

  /* ---------- tabela ---------- */
  .tb{width:100%}
  .th{display:grid;gap:0 12px;padding:0 15px 8px;font-size:10.5px;font-weight:600;color:var(--n4);border-bottom:1px solid var(--n2)}
  .th .srt{display:inline-flex;align-items:center;gap:4px;color:var(--n5)}
  .tr{display:grid;gap:0 12px;padding:9px 15px;border-bottom:1px solid var(--n2);align-items:center}
  .tr:last-of-type{border-bottom:0}
  .tr.sel{background:var(--acs);box-shadow:inset 2px 0 0 var(--ac2)}
  .id{font-family:ui-monospace,Menlo,monospace;font-size:10.5px;color:var(--n4)}
  .ttl{display:block;font-weight:600;letter-spacing:-0.005em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  /* Nazwa `sub` zderzała się z globalnym akapitem wiodącym .sub z LaBase:
     ten <style> jest is:global, więc podpis w makiecie (11px, jedna linia,
     wielokropek) przykrywał lead każdej sekcji na tej stronie. */
  .mk-sub{display:block;font-size:11px;color:var(--n4);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .cel{display:flex;align-items:center;gap:8px;min-width:0}
  .num{font-family:var(--ffn);font-variant-numeric:tabular-nums}
  .tg{display:inline-flex;align-items:center;gap:5px;padding:2.5px 8px;border-radius:var(--r1);font-size:10.5px;font-weight:650;white-space:nowrap}
  .tg::before{content:"";width:5px;height:5px;border-radius:50%;background:currentColor}
  .tg.g{background:var(--acs);color:var(--ac)}
  .tg.a{background:var(--ams);color:var(--am)}
  .tg.n{background:var(--n2);color:var(--n5)}
  .tg.plain::before{display:none}
  .pg{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 15px;border-top:1px solid var(--n2);font-size:11px;color:var(--n4)}
  .pg-n{display:flex;gap:4px}
  .pg-n span{display:grid;place-items:center;min-width:21px;height:21px;padding:0 5px;border-radius:var(--r1);font-size:10.5px;color:var(--n5)}
  .pg-n span.on{background:var(--n1);color:var(--n6);font-weight:650;box-shadow:inset 0 0 0 1px var(--n2)}

  /* ---------- pasek postępu / miernik ---------- */
  .mr{position:relative;height:5px;border-radius:3px;background:var(--n2);overflow:hidden}
  .mr i{display:block;height:100%;border-radius:3px;background:var(--ac2)}
  .mr i.am{background:var(--amb)}
  .mr i.n{background:var(--n3)}

  /* ---------- kafel z liczbą ---------- */
  .mt{padding:12px 13px;border-radius:var(--r2);background:var(--n0);box-shadow:inset 0 0 0 1px var(--n2)}
  .mt-l{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:11px;color:var(--n4)}
  .mt-v{margin-top:5px;font-family:var(--ffn);font-size:21px;font-weight:750;letter-spacing:-0.032em;line-height:1}
  .mt-d{margin-top:5px;font-size:11px;font-weight:650;color:var(--ac)}
  .mt-d.am{color:var(--am)}
  .mt-d.n{color:var(--n4);font-weight:500}
  .spark{display:block;width:100%;height:26px;margin-top:9px;overflow:visible}

  /* ---------- karta sprawy: zakładki i oś ---------- */
  .tabs{display:flex;gap:2px;padding:0 15px;border-bottom:1px solid var(--n2)}
  .tabs span{padding:8px 10px 9px;font-size:12px;color:var(--n5);border-bottom:2px solid transparent;margin-bottom:-1px}
  .tabs span.on{color:var(--n6);font-weight:650;border-bottom-color:var(--ac2)}
  .os{position:relative;padding-left:19px}
  .os::before{content:"";position:absolute;left:5px;top:6px;bottom:10px;width:1px;background:var(--n2)}
  .os-i{position:relative;padding:0 0 13px}
  .os-i::before{content:"";position:absolute;left:-18px;top:4px;width:9px;height:9px;border-radius:50%;background:var(--n0);box-shadow:0 0 0 1.5px var(--n3)}
  .os-i.ac::before{background:var(--ac2);box-shadow:0 0 0 3px rgba(var(--acr),0.18)}
  .os-t{font-size:12px;font-weight:600}
  .os-d{margin-top:2px;font-size:11px;color:var(--n4)}
  .pnl{padding:13px 14px;border-radius:var(--r2);background:var(--n1);box-shadow:inset 0 0 0 1px var(--n2)}
  .kv{display:grid;grid-template-columns:auto minmax(0,1fr);gap:6px 12px;font-size:11.5px}
  .kv dt{color:var(--n4)}
  .kv dd{margin:0;font-weight:600;text-align:right}
  .plik{display:flex;align-items:center;gap:8px;padding:7px 9px;border-radius:var(--r2);background:var(--n0);box-shadow:0 0 0 1px var(--n2);font-size:11.5px}
  .plik em{margin-left:auto;font-style:normal;font-size:10px;color:var(--n4);font-family:var(--ffn)}

  /* ---------- dokument ---------- */
  .dk{padding:14px 15px;border-radius:var(--r2);background:var(--n0);box-shadow:0 1px 2px rgba(var(--shr),0.06),0 10px 22px -14px rgba(var(--shr),0.3),0 0 0 1px var(--n2)}
  .ln{display:block;height:4px;border-radius:3px;background:var(--n2);margin-bottom:6px}
  .ln.hl{background:var(--acs2)}

  /* ---------- telefon ---------- */
  .fn{flex:0 0 auto;width:clamp(178px,15.5vw,208px);border-radius:30px;padding:7px;background:var(--ink);box-shadow:0 0 0 1px rgba(255,255,255,0.10) inset,0 2px 4px rgba(var(--shr),0.2),0 34px 60px -30px rgba(var(--shr),0.62)}
  .fn-e{position:relative;border-radius:24px;background:var(--n0);overflow:hidden}
  .fn-s{display:flex;align-items:center;justify-content:space-between;padding:8px 14px 4px;font-size:9.5px;font-weight:650;color:var(--n6)}
  .fn-s em{font-style:normal;display:inline-flex;gap:3px;align-items:center}
  .fn-b{padding:6px 13px 12px}
  .fn-t{display:flex;justify-content:space-around;padding:8px 0 10px;border-top:1px solid var(--n2);background:var(--n1)}
  .fn-t i{display:grid;place-items:center;gap:3px;color:var(--n4);font-size:8px;font-style:normal}
  .fn-t i.on{color:var(--ac)}

  /* ---------- tablica na hali ---------- */
  .hl-g{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
  .hl-k{padding:14px 15px;border-radius:var(--r2);background:rgba(255,255,255,0.045);box-shadow:inset 0 0 0 1px rgba(255,255,255,0.08)}
  .hl-l{font-size:10.5px;letter-spacing:0.05em;text-transform:uppercase;color:var(--n4)}
  .hl-v{margin-top:6px;font-family:var(--ffn);font-size:clamp(24px,3vw,36px);font-weight:800;letter-spacing:-0.035em;line-height:1;color:var(--n6)}
  .hl-v.ok{color:var(--ac2)}
  .hl-v.am{color:var(--am)}
  .hl-d{margin-top:6px;font-size:11px;color:var(--n4)}

  /* ---------- kalendarz / planer ---------- */
  .gd{display:grid;gap:3px;align-items:center}
  .gd-d{font-size:9.5px;color:var(--n4);text-align:center;padding-bottom:2px}
  .gd-n{font-size:11.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding-right:8px}
  .gd-c{height:24px;border-radius:var(--r1);background:var(--n1);box-shadow:inset 0 0 0 1px var(--n2)}
  .gd-c.a{background:var(--acm);box-shadow:none}
  .gd-c.b{background:var(--ac2);box-shadow:none}
  .gd-c.c{background:var(--acs);box-shadow:none}
  .gd-c.x{background:var(--ams);box-shadow:inset 0 0 0 1.5px var(--amb)}
  .gd-t{display:grid;place-items:center;height:28px;border-radius:var(--r1);background:var(--n1);box-shadow:inset 0 0 0 1px var(--n2);font-size:10px;color:var(--n5)}
  .gd-t.r{background:var(--acs);color:var(--ac);box-shadow:none;font-weight:650}
  .gd-t.p{background:var(--acs2);color:var(--ac);box-shadow:none;font-weight:650}
  .gd-t.p{background:var(--acs2)}
  .gd-t.luka{background:var(--ams);color:var(--am);box-shadow:inset 0 0 0 1.5px var(--amb);font-weight:700}

  /* ---------- asystent ---------- */
  .as-q{display:flex;align-items:center;gap:9px;padding:9px 12px;border-radius:var(--r2);background:var(--n1);box-shadow:inset 0 0 0 1px var(--n2);font-size:13px;font-weight:600}
  .as-a{margin-top:11px;padding:13px 14px;border-radius:var(--r2);background:var(--acs);box-shadow:inset 0 0 0 1px rgba(var(--acr),0.22)}
  .as-a p{margin:0;font-size:12.5px;line-height:1.55}
  .zr{display:inline-flex;align-items:center;gap:7px;margin-top:10px;padding:4px 9px;border-radius:var(--r1);background:var(--n0);box-shadow:0 0 0 1px rgba(var(--acr),0.3);font-size:10.5px;font-weight:650;color:var(--ac)}

  /* ---------- makiety na telefonie ----------
     Boczny pasek i wyszukiwarka wypadają, zostaje sama treść modułu.
     Reguły muszą stać w tym samym bloku co bazowe, bo Astro potrafi
     odwrócić kolejność dwóch osobnych bloków is:global. */
  @media (max-width:660px){
    .ap{grid-template-columns:minmax(0,1fr)}
    .nv,.sr{display:none}
    .hd{padding:12px 12px 0}
    .hd h4{font-size:15px}
    .tp{padding:9px 12px;gap:8px}
    .th,.tr,.pg{padding-left:12px;padding-right:12px}
    .tl{padding:10px 12px;gap:6px}
    .sg span{padding:4px 8px;font-size:11px}
    .hl-g{grid-template-columns:repeat(2,minmax(0,1fr))}
    .fn{width:100%;max-width:280px;margin:0 auto}
    .e2 .tabs{overflow-x:auto}
    .hr-dwa{grid-template-columns:1fr !important;gap:16px !important}
    .mst{grid-template-columns:1fr !important;gap:14px !important}
    /* 01 rejestr: wypadają kolumny „prowadzi", „termin" i menu */
    .e1 .th,.e1 .tr{grid-template-columns:58px minmax(0,1fr) 82px !important}
    .e1 .th > :nth-child(3),.e1 .tr > :nth-child(3),
    .e1 .th > :nth-child(4),.e1 .tr > :nth-child(4),
    .e1 .th > :nth-child(6),.e1 .tr > :nth-child(6){display:none !important}
    /* 03 oferta: wypada kolumna z ilością */
    .e3 .th,.e3 .tr{grid-template-columns:minmax(0,1fr) 66px !important}
    .e3 .th > :nth-child(2),.e3 .tr > :nth-child(2){display:none !important}
    /* 05 planer i 09 grafik: gęstsza siatka */
    .e5 .gd{grid-template-columns:56px repeat(10,minmax(0,1fr)) !important;gap:2px}
    .e5 .gd-c{height:14px}
    .e9 .gd{grid-template-columns:48px repeat(7,minmax(0,1fr)) !important;gap:2px}
    .e9 .gd-t{height:22px;font-size:8px}
    .e9 .gd-n{font-size:9.5px}
    /* 06 hala: wypada pasek postępu przy zleceniu */
    .e6 .hl-k > div[style*="grid-template-columns:64px"]{grid-template-columns:56px minmax(0,1fr) 62px !important}
    .e6 .hl-k > div[style*="grid-template-columns:64px"] > :nth-child(3){display:none !important}
    /* 10 reklamacje: zostaje numer, klient i termin */
    .e10 .th,.e10 .tr{grid-template-columns:62px minmax(0,1fr) 68px !important}
    .e10 .th > :nth-child(3),.e10 .tr > :nth-child(3),
    .e10 .th > :nth-child(4),.e10 .tr > :nth-child(4){display:none !important}
    /* 12 kokpit: dwa kafle w rzędzie, marża bez kolumny z kwotą */
    .e12 .mst:first-of-type{grid-template-columns:repeat(2,minmax(0,1fr)) !important}
    .e12 .tr{grid-template-columns:minmax(0,1fr) 72px 46px !important}
    .e12 .tr > :nth-child(4){display:none !important}
    .e7 .ap{max-width:none !important}
  }
  /* =====================================================================
     HERO
     Jeden duży ekran pulpitu, bez playlisty. Scena jest neutralna —
     zieleń zostaje w poświacie za oknem, nie pod nim.
     ===================================================================== */
  .hr{display:grid;grid-template-columns:minmax(0,0.92fr) minmax(0,1.4fr);gap:clamp(28px,3.6vw,54px);align-items:center;margin-top:clamp(20px,2.6vw,36px)}

  /* Ekran nie leży pod hero, tylko jest hero: siedzi na własnej scenie
     w barwach Weldona i wychodzi poza prawy margines strony. */
  .hr-sc{position:relative;margin-right:calc(-1 * var(--gut));padding:clamp(18px,2vw,30px) clamp(18px,2vw,30px) clamp(30px,2.8vw,44px);
    border-radius:clamp(14px,1.5vw,20px) 0 0 clamp(14px,1.5vw,20px);
    background:radial-gradient(64% 72% at 74% -16%, rgba(51,88,234,0.15), transparent 62%),linear-gradient(166deg,#f1f4fa 0%,#e4eaf4 100%);
    box-shadow:inset 0 1px 0 rgba(255,255,255,0.7)}
  .hr-okno{position:relative;min-width:0;animation:hr-in .9s cubic-bezier(.22,1,.36,1) both}
  @media (min-width:1041px){ .hr-okno > .ap{width:max(100%,880px)} }
  .hr-kar{position:absolute;left:clamp(-38px,-2.5vw,-18px);bottom:clamp(-34px,-2.3vw,-16px);width:min(262px,46%);padding:13px 15px;border-radius:var(--r2,11px);background:#fff;box-shadow:0 0 0 1px rgba(24,34,56,0.07),0 3px 6px -3px rgba(24,34,56,0.16),0 28px 50px -26px rgba(24,34,56,0.42);animation:hr-in .9s cubic-bezier(.22,1,.36,1) .35s both;z-index:3}
  .hr-kar-t{display:flex;align-items:center;gap:8px;font-size:12px;font-weight:700;color:#131a26}
  .hr-kar-t i{display:grid;place-items:center;width:20px;height:20px;border-radius:var(--r1,5px);background:#e9eeff;color:#2743b4;font-style:normal;flex-shrink:0}
  .hr-kar p{margin:7px 0 0;font-size:11.5px;line-height:1.5;color:#7b8395}
  .hr-kar .mr{margin-top:10px}
  @keyframes hr-in{from{opacity:0;transform:translateY(16px) scale(.985)}to{opacity:1;transform:none}}

  /* ---- przyciski hero ---- */
  .hr-cta{display:flex;align-items:center;flex-wrap:wrap;gap:12px;margin-top:clamp(24px,3vw,34px)}
  .hr-b1{display:inline-flex;align-items:center;gap:10px;padding:16px 28px;border-radius:12px;background:#16211a;color:#fff;font-size:16.5px;font-weight:700;letter-spacing:-0.012em;box-shadow:0 14px 30px -14px rgba(16,33,26,0.45);transition:background .2s,transform .2s}
  .hr-b1:hover{background:#0a7a52;transform:translateY(-1px)}
  .hr-b2{display:inline-flex;align-items:center;gap:11px;padding:11px 20px 11px 11px;border-radius:12px;background:#fff;color:#16211a;font-size:16px;font-weight:650;letter-spacing:-0.012em;box-shadow:0 0 0 1px rgba(22,33,26,0.10),0 10px 22px -16px rgba(22,33,26,0.35);transition:box-shadow .2s,transform .2s}
  .hr-b2:hover{transform:translateY(-1px);box-shadow:0 0 0 1px rgba(10,122,82,0.32),0 14px 26px -16px rgba(22,33,26,0.4)}
  .hr-b2 b{display:grid;place-items:center;width:32px;height:32px;border-radius:9px;background:#eef4f0;color:#0a7a52;font-size:14px;font-weight:800;letter-spacing:-0.02em}
  .hr-b2 svg{color:#a3aea4;transition:transform .2s}
  .hr-b2:hover svg{transform:translateY(2px)}

  /* ---- pasek pod przyciskami: siedem marek, dwanaście ekranów ---- */
  .hr-pas{display:flex;align-items:center;flex-wrap:wrap;gap:12px 28px;margin-top:clamp(24px,2.8vw,34px);padding-top:clamp(19px,2.2vw,26px);border-top:1px solid #e2e9e0}
  .hr-pas > div{display:flex;flex-direction:column;gap:4px}
  .hr-pas b{font-size:clamp(19px,2.2vw,25px);font-weight:800;letter-spacing:-0.03em;line-height:1;color:#16211a}
  .hr-pas span{font-size:12.5px;color:#8b968d}
  .hr-mrk{display:flex;gap:4px;height:25px;align-items:center}
  .hr-mrk i{width:9px;height:9px;border-radius:2px}

  @media (max-width:1040px){
    .hr{grid-template-columns:1fr;gap:clamp(28px,5vw,44px)}
    .hr-sc{margin-right:calc(-1 * var(--gut));margin-left:calc(-1 * var(--gut));border-radius:0}
  }
  @media (max-width:660px){
    .hr-sc{padding:16px}
    .hr-kar{position:static;width:auto;margin-top:14px}
  }
  @media (prefers-reduced-motion:reduce){ .hr-okno,.hr-kar{animation:none} }

  /* =====================================================================
     SHOWREEL
     ===================================================================== */
  .rl{display:grid;grid-template-columns:clamp(232px,22vw,300px) minmax(0,1fr);gap:clamp(20px,3vw,44px);align-items:start;margin-top:clamp(26px,3.4vw,42px)}
  .rl > *{min-width:0}
  .rl-l{border-top:1px solid #dde7db}
  .rl-i{position:relative;display:grid;grid-template-columns:auto minmax(0,1fr);gap:0 11px;width:100%;padding:9px 0;border:0;border-bottom:1px solid #dde7db;background:none;font-family:inherit;text-align:left;cursor:pointer;transition:padding-left .2s}
  .rl-i:hover{padding-left:5px}
  .rl-n{font-family:ui-monospace,Menlo,monospace;font-size:10.5px;color:#b6c6b4;padding-top:3px;transition:color .18s}
  .rl-t{font-size:15px;font-weight:700;letter-spacing:-0.015em;line-height:1.25;color:#7c877e;transition:color .18s}
  .rl-p{display:flex;align-items:center;gap:6px;margin-top:3px;font-size:11px;color:#a9b3aa}
  .rl-p i{flex:0 0 7px;height:7px;border-radius:2px;opacity:.5;transition:opacity .18s}
  .rl-i:hover .rl-p i,.rl-i.on .rl-p i{opacity:1}
  .rl-i.on .rl-p{color:#79857b}
  .rl-i:hover .rl-t,.rl-i.on .rl-t{color:#16211a}
  .rl-i.on .rl-n{color:var(--la-accent,#00CD77)}
  .rl-pr{position:absolute;left:0;bottom:-1px;height:2px;width:0;background:var(--la-accent,#00CD77)}
  .rl-i.on .rl-pr{animation:rl-pr var(--rl) linear forwards}
  .rl-i.on.stop .rl-pr{animation:none;width:100%}
  @keyframes rl-pr{from{width:0}to{width:100%}}
  /* Scena nie ma stałego koloru — bierze go od marki firmy, do której należy
     ekran. Warstwa tła siedzi w slajdzie, więc przy zmianie pozycji tło
     przenika razem z makietą, a hala Kaltera przyciemnia całą scenę. */
  .rl-sc{position:relative;display:grid;min-width:0;padding:clamp(18px,2.2vw,34px);border-radius:clamp(16px,1.8vw,22px);background:#eef1ee;overflow:hidden}
  .rl-e{grid-area:1/1;position:relative;z-index:1;display:flex;align-items:center;justify-content:center;gap:clamp(12px,1.8vw,24px);opacity:0;transform:translateY(9px);transition:opacity .45s cubic-bezier(.4,0,.2,1),transform .45s cubic-bezier(.4,0,.2,1);pointer-events:none}
  .rl-e::before{content:"";position:absolute;inset:calc(-1 * clamp(18px,2.2vw,34px));pointer-events:none;
    background:radial-gradient(58% 62% at 82% -12%, rgba(var(--acr),0.20), transparent 64%),linear-gradient(168deg,var(--st1) 0%,var(--st2) 100%)}
  /* makieta musi stać nad warstwą tła — obie są pozycjonowane, więc
     decyduje kolejność w drzewie, a ::before jest pierwszy */
  .rl-e > *{position:relative}
  .rl-e.on{opacity:1;transform:none;pointer-events:auto}
  .rl-pod{display:grid;margin-top:clamp(16px,2vw,24px)}
  .rl-c{grid-area:1/1;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:16px clamp(24px,3vw,52px);align-items:start;opacity:0;transform:translateY(8px);transition:opacity .4s,transform .4s;pointer-events:none}
  .rl-c.on{opacity:1;transform:none;pointer-events:auto}
  .rl-mk{display:flex;align-items:center;gap:9px;margin-bottom:11px;font-size:12.5px;color:#8b968d}
  .rl-mk i{display:grid;place-items:center;width:19px;height:19px;border-radius:4px;color:#fff;font-size:9px;font-weight:800;font-style:normal}
  .rl-mk b{font-weight:750;color:#2c3830;letter-spacing:-0.01em}
  .rl-mk span::before,.rl-mk em::before{content:"·";margin-right:8px;color:#c3ccc4}
  .rl-mk em{font-style:normal;color:#a3aea4}
  .rl-z{margin:0;font-size:clamp(16px,1.85vw,19.5px);line-height:1.45;font-weight:650;letter-spacing:-0.014em;color:#16211a;text-wrap:pretty;max-width:640px}
  .rl-dl{display:flex;flex-direction:column;align-items:flex-end;gap:3px;text-align:right}
  .rl-a{font-size:14px;color:#9aa69c;white-space:nowrap}
  .rl-k{display:block;width:9px;height:9px;border-right:2px solid var(--la-accent,#00CD77);border-bottom:2px solid var(--la-accent,#00CD77);transform:rotate(45deg);margin:3px 3px 6px 0}
  .rl-b{font-size:clamp(22px,2.5vw,30px);font-weight:800;letter-spacing:-0.034em;line-height:1;color:#16211a;white-space:nowrap}
  .rl-cap{margin:5px 0 0;font-size:12px;color:#8b968d;max-width:210px}
  .rl-nt{margin:clamp(18px,2.2vw,26px) 0 0;font-size:13px;color:#a3aea4}
  @media (max-width:1040px){
    .rl{grid-template-columns:1fr}
    .rl-l{order:2;border-top:0}
    .rl-i:first-child{border-top:1px solid #dde7db}
    .rl-sc{order:1}
    .rl-pod{order:1}
  }
  @media (max-width:660px){
    .rl-sc{padding:12px}
    .rl-mk{flex-wrap:wrap;gap:5px 8px;margin-bottom:9px}
    .rl-mk em{display:none}
    .rl-e{display:none;flex-direction:column;align-items:stretch;gap:10px}
    .rl-e.on{display:flex}
    .rl-c{grid-template-columns:1fr}
    .rl-dl{flex-direction:row;align-items:baseline;justify-content:flex-start;gap:10px;text-align:left}
    .rl-k{transform:rotate(-45deg);margin:0 3px}
    .rl-cap{max-width:none}
  }
  @media (prefers-reduced-motion:reduce){ .rl-e,.rl-c{transition:none} .rl-i.on .rl-pr{animation:none;width:100%} }

  /* =====================================================================
     CIEMNY PAS · UMIEJĘTNOŚCI · GRANICE
     ===================================================================== */
  .sh{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:clamp(10px,1.4vw,18px);margin-top:clamp(28px,3.4vw,44px);align-items:end}
  .sh-k{display:flex;flex-direction:column;justify-content:flex-end;padding:clamp(15px,1.8vw,21px);border-radius:13px;background:rgba(255,255,255,0.055);box-shadow:inset 0 0 0 1px rgba(255,255,255,0.09)}
  .sh-m{font-family:ui-monospace,Menlo,monospace;font-size:10.5px;letter-spacing:0.08em;text-transform:uppercase;color:rgba(255,255,255,0.42)}
  .sh-t{margin:9px 0 0;font-size:14.5px;font-weight:750;letter-spacing:-0.014em;line-height:1.3;color:#ffffff;text-wrap:balance}
  .sh-d{margin:7px 0 0;font-size:12.5px;line-height:1.5;color:rgba(255,255,255,0.6);text-wrap:pretty}
  .sh-os{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:clamp(10px,1.4vw,18px);margin-top:14px}
  .sh-v{display:flex;flex-direction:column;gap:7px;padding-top:14px;border-top:1px solid rgba(255,255,255,0.16)}
  .sh-v b{font-size:clamp(17px,2.1vw,25px);font-weight:800;letter-spacing:-0.03em;line-height:1;color:#ffffff}
  .sh-v.ost b{color:var(--la-accent,#00CD77)}
  .sh-v span{font-size:11px;color:rgba(255,255,255,0.42)}
  @media (max-width:960px){ .sh,.sh-os{grid-template-columns:repeat(2,minmax(0,1fr))} .sh-k{justify-content:flex-start} }
  @media (max-width:540px){ .sh,.sh-os{grid-template-columns:1fr} }

  .um{margin-top:clamp(28px,3.4vw,44px)}
  .um-r{display:grid;grid-template-columns:minmax(0,0.72fr) minmax(0,1.5fr);gap:clamp(16px,3vw,56px);align-items:start;padding:clamp(24px,2.8vw,34px) 0;border-top:1px solid #dde7db}
  .um-r:last-of-type{border-bottom:1px solid #dde7db}
