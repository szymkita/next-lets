<script>
  // ---- SHOWREEL -----------------------------------------------------------
  // Playlista steruje sceną. Obieg leci sam, kliknięcie zatrzymuje go na dobre.
  (function(){
    var wrap = document.querySelector('.rl');
    if(!wrap) return;
    var lista = [].slice.call(wrap.querySelectorAll('.rl-i'));
    var ekrany = [].slice.call(wrap.querySelectorAll('.rl-e'));
    var podpisy = [].slice.call(wrap.querySelectorAll('.rl-c'));
    if(!lista.length || lista.length !== ekrany.length) return;

    var ms = parseInt(wrap.getAttribute('data-ms'), 10) || 5600;
    var bezRuchu = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var i = 0, zegar = null, zatrzymany = bezRuchu;

    function pokaz(n){
      i = n;
      lista.forEach(function(el, k){
        el.classList.toggle('on', k === n);
        el.classList.toggle('stop', zatrzymany && k === n);
        el.setAttribute('aria-selected', k === n ? 'true' : 'false');
      });
      ekrany.forEach(function(el, k){ el.classList.toggle('on', k === n); });
      podpisy.forEach(function(el, k){ el.classList.toggle('on', k === n); });
    }

    lista.forEach(function(el, k){
      el.addEventListener('click', function(){
        zatrzymany = true;
        if(zegar){ clearInterval(zegar); zegar = null; }
        pokaz(k);
      });
    });

    pokaz(0);
    if(!zatrzymany){ zegar = setInterval(function(){ pokaz((i + 1) % lista.length); }, ms); }
  })();
</script>
