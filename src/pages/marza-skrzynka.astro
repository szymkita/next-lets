---
// MARŻA · SKRZYNKA — /marza-skrzynka. Druga, osobna wersja landingu kampanii Meta „Marża”
// (obok /marza). Szymon 21.11.2026: „zaproponuj zupełnie inny landing page, zaprojektuj to od zera,
// fokus na zostawienie kontaktu”. Jeden dzień skrzynki mailowej: zamówienie Marka u Ciebie
// i u konkurencji; kontakt to wiadomość do Piotra (pierwszy ekran, pasek „Wersja robocza”,
// odpowiedź na jego maila na końcu). Źródło: ~/filmy/lets-meta-marza/landing-skrzynka
// (strona.html/css/js, build.py generuje ten plik — zmiany rób tam).
// Liczby to przykład (48 zł/h pracy biura), te same co na /marza. noindex, bez nawigacji.
// Zgłoszenia ze źródłem „Marża · skrzynka · <miejsce>”.
import LaBase from '../layouts/LaBase.astro';
const title = "Podniesiemy Twoją marżę | Let's automate";
const description = "Jeden dzień skrzynki mailowej: to samo zamówienie za 800 zł u Ciebie i u konkurencji. Zobacz, gdzie znika marża, i napisz do Piotra, pokażemy to na Twoim zamówieniu.";
---
<LaBase topbar={false} title={title} description={description} ctaHref="#hero" nav={null} naglowek={false} noindex={true} ogImage="/og/marza.jpg">
<style is:global>
@font-face{
font-family:"SkInter";font-style:normal;font-weight:400 700;font-display:swap;src:url(/fonts/inter-v20-normal-400-700-latin-ext.woff2) format("woff2");unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}
@font-face{
font-family:"SkInter";font-style:normal;font-weight:400 700;font-display:swap;src:url(/fonts/inter-v20-normal-400-700-latin.woff2) format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{
font-family:"SkPis";font-style:normal;font-weight:400 700;font-display:swap;src:url(/fonts/caveat-v23-normal-400-700-latin-ext.woff2) format("woff2");unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}
@font-face{
font-family:"SkPis";font-style:normal;font-weight:400 700;font-display:swap;src:url(/fonts/caveat-v23-normal-400-700-latin.woff2) format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{
font-family:"SkMono";font-style:normal;font-weight:400 700;font-display:swap;src:url(/fonts/jetbrains-mono-v24-normal-400-700-latin-ext.woff2) format("woff2");unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}
@font-face{
font-family:"SkMono";font-style:normal;font-weight:400 700;font-display:swap;src:url(/fonts/jetbrains-mono-v24-normal-400-700-latin.woff2) format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
.sk{

  --ink:#07140d; --ink2:#0d2118; --papier:#f4f3ee; --papier2:#ebe9e1;
  --t1:#0f1a14; --t2:#46524b; --t3:#7b867f; --linia:rgba(15,26,20,.13);
  --ziel:#00CD77; --ziel-c:#0a7a52; --burs:#f0a33a; --burs-c:#9c5f14;
  --f:"Schibsted Grotesk",system-ui,-apple-system,sans-serif;
  --f-ui:"SkInter","Inter",-apple-system,"Segoe UI",system-ui,sans-serif;
  --f-m:"SkMono","JetBrains Mono",ui-monospace,Menlo,monospace;
  --f-pis:"SkPis","Caveat","Segoe Print",cursive;
  
  --ui-bg:#ffffff; --ui-bg2:#f5f6f8; --ui-l:#e4e7eb; --ui-t:#1d2125; --ui-t2:#5c6670; --ui-t3:#8a939c; --ui-a:#1a66d6; --ui-sel:#e6effc;
  --pad:clamp(16px,5vw,56px);
  --barH:0px;}
.sk{
margin:0;background:#ffffff;color:var(--t1);font-family:var(--f);-webkit-font-smoothing:antialiased;overflow-x:clip}
.sk *{
box-sizing:border-box}
.sk a{
color:inherit}
.sk .w{
max-width:1240px;margin:0 auto;padding:0 var(--pad)}
.sk .bar{
position:relative;z-index:5}
.sk .bar-in{
max-width:1440px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;padding:14px var(--pad)}
.sk .logo{
display:block;line-height:0}
.sk .logo svg{
width:132px;height:auto}
.sk .bar-tel{
display:inline-flex;align-items:center;gap:8px;font-weight:650;font-size:15px;text-decoration:none;color:var(--t1);padding:8px 14px;border-radius:999px;background:var(--papier)}
.sk .bar-tel svg{
width:15px;height:15px;fill:var(--ziel-c)}
.sk .hero{
padding:0 clamp(6px,0.9vw,14px)}
.sk .hero-pl{
position:relative;border-radius:clamp(20px,2.2vw,32px);background:var(--papier);padding:clamp(26px,5vw,72px) var(--pad) clamp(22px,4vw,56px);display:grid;gap:22px;max-width:1440px;margin:0 auto;overflow:hidden}
.sk .hero-pl::before{
content:"";position:absolute;inset:auto -10% -40% 30%;height:80%;background:radial-gradient(closest-side,rgba(0,205,119,.13),rgba(0,205,119,0));pointer-events:none}
.sk .hero-pl > *{
position:relative}
.sk .etyk{
display:inline-flex;align-items:center;gap:10px;margin:0 0 16px;font-size:14px;font-weight:600;color:var(--t2)}
.sk .etyk i{
width:7px;height:7px;border-radius:50%;background:var(--ziel);box-shadow:0 0 0 4px rgba(0,205,119,.16)}
.sk .hero h1{
margin:0;font-size:clamp(38px,10.4vw,84px);line-height:1.02;letter-spacing:-.05em;font-weight:700;text-wrap:balance}
.sk .hero h1 span{
color:#a3aba5}
.sk .lead{
margin:16px 0 0;font-size:clamp(16px,4.2vw,19px);line-height:1.55;color:var(--t2);max-width:560px;text-wrap:pretty}
.sk .hero-pod{
display:flex;align-items:center;gap:10px;margin:0;font-size:14px;line-height:1.4;color:var(--t2)}
.sk .hero-pod img{
width:28px;height:28px;border-radius:50%;object-fit:cover}
.sk .dalej{
display:flex;align-items:center;justify-content:center;gap:10px;margin:18px auto 6px;font-size:14px;font-weight:600;color:var(--t2);text-decoration:none}
.sk .dalej i{
width:9px;height:9px;border-right:2px solid currentColor;border-bottom:2px solid currentColor;transform:translateY(-3px) rotate(45deg)}
.sk .nowa,.sk .sz-ark{
background:var(--ui-bg);border-radius:14px;box-shadow:0 1px 0 rgba(15,26,20,.05),0 18px 50px -18px rgba(15,26,20,.32),0 0 0 1px rgba(15,26,20,.07);overflow:hidden;font-family:var(--f-ui);color:var(--ui-t)}
.sk .nowa{
opacity:0;transform:translateY(14px);transition:opacity .6s ease .15s,transform .7s cubic-bezier(.2,.8,.2,1) .15s}
.sk .nowa.on{
opacity:1;transform:none}
.sk .ok-pas{
display:flex;align-items:center;justify-content:space-between;padding:10px 14px;background:#2b3138;color:#fff;font-size:14px}
.sk .ok-pas b{
font-weight:600}
.sk .ok-ik{
display:flex;gap:12px}
.sk .ok-ik i{
width:10px;height:10px;border:1.5px solid rgba(255,255,255,.7);border-radius:2px}
.sk .ok-ik i:first-child{
height:0;border-width:1.5px 0 0;margin-top:5px;border-radius:0}
.sk .kz{
display:block;font-family:var(--f-ui)}
.sk .kz-r{
display:flex;align-items:center;gap:10px;min-height:42px;padding:6px 14px;border-bottom:1px solid var(--ui-l);font-size:15px;color:var(--ui-t)}
.sk .kz-l{
color:var(--ui-t3);min-width:48px}
.sk .kz-do{
display:inline-flex;align-items:center;gap:7px;padding:3px 10px 3px 3px;border-radius:999px;background:var(--ui-bg2);font-weight:500}
.sk .kz-do img{
width:22px;height:22px;border-radius:50%;object-fit:cover}
.sk .kz-tm{
font-weight:600}
.sk .kz-b{
padding:12px 14px 4px}
.sk .kz-p{
display:block;margin:0 0 8px;font-size:15px;line-height:1.5;color:var(--ui-t)}
.sk .kz-i{
display:block;width:100%;font:600 22px/1.2 var(--f-ui);letter-spacing:.01em;color:var(--ui-t);padding:10px 12px;border:0;border-radius:10px;background:#fff8e6;box-shadow:inset 0 0 0 1.5px #f0c46a;outline:none;caret-color:var(--ui-a);transition:box-shadow .2s,background .2s}
.sk .kz-i::placeholder{
color:#b09a6a;font-weight:500}
.sk .kz-i:focus{
background:#fff;box-shadow:inset 0 0 0 2px var(--ui-a)}
.sk .kz-err{
display:block;min-height:18px;margin-top:5px;font-size:13px;color:#c0392b}
.sk .kz-st{
display:flex;align-items:center;justify-content:space-between;gap:12px;padding:6px 14px 14px}
.sk .kz-z{
display:flex;align-items:flex-start;gap:9px;font-size:12px;line-height:1.4;color:var(--ui-t2);cursor:pointer;flex:1;min-width:0}
.sk .kz-z input{
position:absolute;opacity:0;pointer-events:none}
.sk .kz-box{
flex-shrink:0;width:18px;height:18px;border-radius:5px;box-shadow:inset 0 0 0 1.5px #a8b0b8;background:#fff;position:relative;transition:background .15s,box-shadow .15s}
.sk .kz-z input:checked + .kz-box{
background:var(--ui-a);box-shadow:none}
.sk .kz-z input:checked + .kz-box::after{
content:"";position:absolute;left:6px;top:2.5px;width:5px;height:9px;border:solid #fff;border-width:0 2px 2px 0;transform:rotate(45deg)}
.sk .kz-z input:focus-visible + .kz-box{
outline:2px solid var(--ui-a);outline-offset:2px}
.sk .kz-z.err .kz-box{
box-shadow:inset 0 0 0 2px #c0392b}
.sk .kz-z a{
color:var(--ui-t2)}
.sk .kz-wy{
flex-shrink:0;display:inline-flex;align-items:center;gap:10px;border:0;cursor:pointer;font:700 16px/1 var(--f);letter-spacing:-.01em;color:var(--ink);background:var(--ziel);padding:12px 14px 12px 20px;border-radius:999px;transition:background .2s,transform .15s}
.sk .kz-wy svg{
width:18px;height:18px;fill:none;stroke:var(--ink);stroke-width:1.8;stroke-linejoin:round}
.sk .kz-wy:hover{
background:#25dd8b}
.sk .kz-wy:active{
transform:scale(.97)}
.sk .kz-wy[disabled]{
opacity:.6;cursor:default}
.sk .kz-hp{
position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
.sk .kz-ok{
display:flex;align-items:center;gap:10px;padding:18px 14px 20px;font-size:16px;font-weight:600;color:var(--ziel-c)}
.sk .kz-ok svg{
width:22px;height:22px;fill:none;stroke:var(--ziel-c);stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}
.sk .kz-ok[hidden]{
display:none}
.sk .kz.wyslane .kz-b,.sk .kz.wyslane .kz-st{
display:none}
.sk .scena{
position:relative;height:calc(var(--h) * 1vh);height:calc(var(--h) * 1svh)}
.sk .sc-ty{
background:var(--papier)}
.sk .sc-kon{
background:#ffffff}
.sk .st{
position:sticky;top:0;height:100vh;height:100svh;display:flex;flex-direction:column;gap:12px;padding:16px var(--pad) calc(14px + var(--barH));max-width:1240px;margin:0 auto;overflow:hidden}
.sk .cap{
flex-shrink:0}
.sk .cap-g{
display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
.sk .znak{
display:inline-flex;align-items:center;gap:9px;font-size:14px;font-weight:700;letter-spacing:-.005em;padding:6px 12px 6px 10px;border-radius:999px}
.sk .znak i{
width:8px;height:8px;border-radius:50%}
.sk .znak-ty{
background:rgba(240,163,58,.18);color:var(--burs-c)}
.sk .znak-ty i{
background:var(--burs)}
.sk .znak-kon{
background:rgba(0,205,119,.13);color:var(--ziel-c)}
.sk .znak-kon i{
background:var(--ziel)}
.sk .zeg{
font:600 clamp(22px,6vw,30px)/1 var(--f-m);letter-spacing:-.02em;color:var(--t1);font-variant-numeric:tabular-nums}
.sk .cap-zd{
position:relative;height:calc(4 * 1.26em);font-size:clamp(19px,5.1vw,23px)}
.sk .cz{
position:absolute;inset:0 0 auto;margin:0;font-weight:650;line-height:1.26;letter-spacing:-.02em;text-wrap:pretty;opacity:0;transform:translateY(8px);transition:opacity .35s ease,transform .45s cubic-bezier(.2,.8,.2,1)}
.sk .cz.on{
opacity:1;transform:none}
.sk .app{
position:relative;flex:1;min-height:0;border-radius:14px;background:var(--ui-bg);font-family:var(--f-ui);color:var(--ui-t);box-shadow:0 1px 0 rgba(15,26,20,.04),0 22px 60px -26px rgba(15,26,20,.35),0 0 0 1px rgba(15,26,20,.08);overflow:hidden;display:flex}
.sk .app-l{
position:relative;flex:1;min-width:0;display:flex;flex-direction:column}
.sk .app-top{
flex-shrink:0;display:flex;align-items:center;gap:8px;padding:12px 14px 10px;border-bottom:1px solid var(--ui-l)}
.sk .app-top b{
font-size:19px;font-weight:700;letter-spacing:-.01em}
.sk .app-n{
min-width:22px;height:20px;padding:0 6px;border-radius:999px;background:var(--ui-a);color:#fff;font-size:12px;font-weight:600;display:inline-flex;align-items:center;justify-content:center;transition:transform .2s}
.sk .app-n.zero{
opacity:0}
.sk .app-sz{
margin-left:auto;display:inline-flex;align-items:center;gap:6px;font-size:13px;color:var(--ui-t3);background:var(--ui-bg2);padding:6px 12px 6px 9px;border-radius:8px}
.sk .app-sz svg{
width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round}
.sk .lista{
position:relative;flex:1;min-height:0;overflow:hidden;--rh:78px;isolation:isolate}
.sk .m{
position:absolute;left:0;right:0;top:0;height:var(--rh);display:flex;gap:11px;padding:11px 14px 0 26px;border-bottom:1px solid var(--ui-l);background:var(--ui-bg);will-change:transform}
.sk .m::before{
content:"";position:absolute;left:10px;top:21px;width:8px;height:8px;border-radius:50%;background:var(--ui-a);opacity:0;transition:opacity .3s}
.sk .m.nw::before{
opacity:1}
.sk .m.sel{
background:var(--ui-sel)}
.sk .av{
flex-shrink:0;width:36px;height:36px;border-radius:50%;background:var(--c);color:#fff;font-style:normal;font-size:13px;font-weight:600;display:flex;align-items:center;justify-content:center;letter-spacing:.02em}
.sk .av-img{
object-fit:cover;background:#ddd}
.sk .m-t{
flex:1;min-width:0}
.sk .m-g{
display:flex;align-items:baseline;justify-content:space-between;gap:8px}
.sk .m-g b{
font-size:15px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sk .m-g time{
flex-shrink:0;font-size:12.5px;color:var(--ui-t3)}
.sk .m.nw .m-g time{
color:var(--ui-a);font-weight:600}
.sk .m-s{
display:flex;align-items:center;gap:5px;margin-top:1px;font-size:14px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sk .m:not(.nw) .m-g b,.sk .m:not(.nw) .m-s{
font-weight:500;color:var(--ui-t2)}
.sk .spin{
width:14px;height:14px;flex-shrink:0;fill:none;stroke:var(--ui-t3);stroke-width:1.6;stroke-linecap:round}
.sk .m-p{
margin-top:2px;font-size:13.5px;line-height:1.35;color:var(--ui-t2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sk .toast{
position:absolute;left:12px;right:12px;bottom:12px;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:11px 14px;border-radius:10px;background:#2b3138;color:#fff;font-size:13.5px;opacity:0;transform:translateY(12px);pointer-events:none;box-shadow:0 10px 30px -10px rgba(0,0,0,.4);z-index:3}
.sk .toast b{
color:#8fb8ff;font-weight:600}
.sk .czyt{
position:absolute;inset:0;z-index:2;background:var(--ui-bg);transform:translateX(calc((1 - var(--o,0)) * 104%));box-shadow:-12px 0 30px -18px rgba(0,0,0,.3);overflow:hidden}
.sk .cz-pusto{
display:none}
.sk .cz-in{
position:relative;padding:0 16px 16px;will-change:transform}
.sk .cz-nav{
display:flex;align-items:center;height:44px;font-size:15px;color:var(--ui-a);border-bottom:1px solid var(--ui-l);margin:0 -16px 12px;padding:0 14px}
.sk .cz-h{
display:flex;align-items:center;gap:11px}
.sk .cz-h b{
display:block;font-size:15.5px;font-weight:600}
.sk .cz-h span{
display:block;font-size:13px;color:var(--ui-t3)}
.sk .cz-t{
margin:12px 0 6px;font-size:18px;font-weight:700;letter-spacing:-.01em}
.sk .cz-b{
font-size:15px;line-height:1.5;color:var(--ui-t)}
.sk .cz-b p{
margin:0 0 8px}
.sk .cz-zal{
display:flex;align-items:center;gap:12px;margin-top:10px;padding:8px;border:1px solid var(--ui-l);border-radius:10px}
.sk .skan{
flex-shrink:0;width:86px;height:64px;border-radius:5px;background:linear-gradient(180deg,#fbfaf6,#f0ede4);box-shadow:inset 0 0 0 1px rgba(0,0,0,.06);padding:5px 7px;display:flex;flex-direction:column;justify-content:space-between;font:600 13px/1 var(--f-pis);color:#2a3a8c;transform:rotate(-1.5deg);filter:blur(.25px)}
.sk .skan span:nth-child(2){
padding-left:4px}
.sk .skan span:nth-child(4){
transform:rotate(-3deg);transform-origin:left}
.sk .cz-zi b{
display:block;font-size:14px;font-weight:600}
.sk .cz-zi span{
font-size:12.5px;color:var(--ui-t3)}
.sk .asy{
position:relative;margin-top:14px;border-radius:12px;background:#f4fbf7;box-shadow:inset 0 0 0 1px rgba(10,122,82,.22);padding:10px 12px 12px;font-size:14px}
.sk .asy-g{
display:flex;align-items:center;gap:8px;margin-bottom:6px;flex-wrap:wrap}
.sk .asy-g i{
width:8px;height:8px;border-radius:50%;background:var(--ziel);box-shadow:0 0 0 3px rgba(0,205,119,.2)}
.sk .asy-g b{
font-weight:700;color:var(--ziel-c)}
.sk .asy-g span{
font-size:12.5px;color:var(--ui-t3)}
.sk .asy-w{
display:grid;grid-template-columns:1fr auto 40px;align-items:center;gap:10px;padding:7px 0;border-top:1px solid rgba(10,122,82,.14);font-variant-numeric:tabular-nums}
.sk .asy-w span:first-child{
font-weight:600}
.sk .asy-w small{
display:block;font-size:12px;font-weight:400;color:var(--ui-t3)}
.sk .asy-w em{
font-style:normal;font-size:12px;font-weight:600;color:var(--ziel-c);text-align:right}
.sk .asy-w em.pyt{
color:var(--burs-c)}
.sk .asy-p{
padding:8px 0 2px;border-top:1px solid rgba(10,122,82,.14)}
.sk .asy-p p{
margin:0 0 8px;font-weight:600}
.sk .asy-b{
display:flex;gap:8px}
.sk .asy-t{
padding:8px 18px;border-radius:8px;background:#fff;box-shadow:inset 0 0 0 1px var(--ui-l);font-weight:600;transition:background .15s,color .15s,transform .12s}
.sk .asy-t.wc{
