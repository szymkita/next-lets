<script is:inline>
/* MARŻA · SKRZYNKA — ruch scen przewijany palcem i wiadomość do Piotra.
   Sceny: postęp p (0–1) z położenia sekcji, wygładzony; wszystkie elementy są w kodzie od początku,
   zmieniają się tylko położenie, przezroczystość i tekst. */
(()=>{
const SNAP=!!window.__snap, RM=matchMedia('(prefers-reduced-motion: reduce)').matches;
const $=(s,r=document)=>r.querySelector(s), $$=(s,r=document)=>[...r.querySelectorAll(s)];
const cl=(v,a=0,b=1)=>Math.min(b,Math.max(a,v));
const ss=(v)=>{v=cl(v);return v*v*(3-2*v);};
const okno=(p,a,b,f=.03)=>ss((p-a)/f)*(1-ss((p-b)/f));
const zl=(v)=>v.toFixed(2).replace('.',',')+' zł';

/* dane scen: kroki (próg p → godzina, podpis), koszt [od, do, minuty, zł poza pracą] */
const DANE={
  ty:{kroki:[[0,'07:12'],[.115,'07:14'],[.265,'07:31'],[.37,'07:58'],[.5,'08:15'],[.615,'10:30'],[.72,'14:00'],[.9,'16:00']],
      koszt:[[.13,.245,10,0],[.275,.345,4,0],[.39,.49,14,0],[.505,.565,6,0],[.63,.685,4,0],[.74,.85,24,0],[.865,.895,0,39.04]],
      czyt:[.11,.255], toast:[[.3,.36],[.52,.575],[.645,.7]], kon:.9,
      kursor:{od:[.13,.2], cel:'.skan'}},
  kon:{kroki:[[0,'07:12'],[.095,'07:12'],[.3,'07:13'],[.45,'07:13'],[.56,'07:14'],[.68,'10:25'],[.83,'16:00']],
      koszt:[[.34,.42,1,0],[.84,.9,0,8.72]],
      czyt:[.085,.535], wiersze:[.15,.2,.25,.3,.445], kursor:{od:[.32,.4], cel:'[data-klik]'}, klik:.41, kon:.86}
};

const sceny=$$('.scena').map(el=>{
  const d=DANE[el.dataset.s], app=$('.app',el);
  return {el,d,app,
    rows:$$('.m',el).map(m=>({el:m,a:parseFloat(m.dataset.in)})),
    caps:$$('.cz',el), zeg:$('[data-zeg]',el), n:$('[data-n]',el),
    czyt:$('.czyt',el), czIn:$('.cz-in',el), otw:$('[data-otw]',el),
    toasty:$$('.toast',el), min:$('[data-min]',el), zl:$('[data-zl]',el), kon:$('[data-kon]',el),
    kur:$('.kur',el), w:$$('[data-w]',el), klik:$('[data-klik]',el),
    cur:-1, tgt:0, krok:-1};
});

function ustaw(s){
  const p=s.cur, d=s.d;
  /* lista: nowa wiadomość wjeżdża na górę, starsze zsuwają się w dół */
  const rh=s.rows[0].el.offsetHeight||78;
  const przyj=s.rows.map(r=>r.a<0?1:ss((p-r.a)/.035));
  let nowe=0;
  s.rows.forEach((r,i)=>{
    let y=0; s.rows.forEach((q,j)=>{ if(q.a>r.a) y+=przyj[j]; });
    const a=przyj[i];
    r.el.style.transform=`translateY(${(y*rh - (1-a)*rh*.55).toFixed(1)}px)`;
    r.el.style.opacity=r.a<0?1:a.toFixed(3);
    r.el.style.zIndex=String(100-Math.round(y*2));
    if(r.a>=0&&a>.5) nowe++;
  });
  /* przeczytana wiadomość Marka traci kropkę po otwarciu */
  const o=okno(p,d.czyt[0],d.czyt[1],.035);
  if(s.otw){ const czytana=p>d.czyt[0]+.02; s.otw.classList.toggle('nw',!czytana); s.otw.classList.toggle('sel',o>.5); if(czytana) nowe--; }
  if(s.n){ s.n.textContent=String(Math.max(0,nowe)); s.n.classList.toggle('zero',nowe<=0); }
  s.czyt.style.setProperty('--o',o.toFixed(3));
  /* podpis i zegar */
  let k=0; d.kroki.forEach(([q],i)=>{ if(p>=q) k=i; });
  if(k!==s.krok){ s.krok=k; s.caps.forEach((c,i)=>c.classList.toggle('on',i===k)); s.zeg.textContent=d.kroki[k][1]; }
  /* licznik */
  let mn=0, ex=0; d.koszt.forEach(([a,b,m,z])=>{ const t=ss((p-a)/(b-a)); mn+=m*t; ex+=z*t; });
  s.min.textContent=Math.round(mn)+' min'; s.zl.textContent=zl(mn*.8+ex);
  const kk=ss((p-d.kon)/.03); s.kon.style.opacity=kk.toFixed(3); s.kon.style.transform=`translateY(${(6*(1-kk)).toFixed(1)}px)`;
  /* potwierdzenia „wysłane” */
  s.toasty.forEach((t,i)=>{ const w=d.toast&&d.toast[i]; if(!w) return; const v=okno(p,w[0],w[1],.015); t.style.opacity=v.toFixed(3); t.style.transform=`translateY(${(12*(1-v)).toFixed(1)}px)`; });
  /* asystent: wiersze po kolei, potem pytanie i odpowiedź Ani */
  if(d.wiersze) s.w.forEach((w,i)=>{ const v=ss((p-d.wiersze[i])/.03); w.style.opacity=v.toFixed(3); w.style.transform=`translateY(${(8*(1-v)).toFixed(1)}px)`; });
  if(s.klik) s.klik.classList.toggle('wc',p>=d.klik);
  /* kursor Ani: wjeżdża z prawego dołu do celu */
  if(s.kur){
    const kd=d.kursor, cel=$(kd.cel,s.czIn);
    if(cel){
      const box=s.kur.offsetParent||s.czIn, rb=box.getBoundingClientRect(), rc=cel.getBoundingClientRect();
      const tx=rc.left-rb.left+rc.width*.78, ty=rc.top-rb.top+rc.height*.62;
      const sx=rb.width*.92, sy=rb.height+40, t=ss((p-kd.od[0])/(kd.od[1]-kd.od[0]));
      const wid=ss((p-kd.od[0]+.02)/.03)*(1-ss((p-d.czyt[1]+.02)/.02));
      const tap=d.klik?(1-.12*okno(p,d.klik-.006,d.klik+.008,.004)):1;
      s.kur.style.opacity=wid.toFixed(3);
      s.kur.style.transform=`translate(${(sx+(tx-sx)*t).toFixed(1)}px,${(sy+(ty-sy)*t).toFixed(1)}px) scale(${tap.toFixed(3)})`;
    }
  }
  /* na niskim ekranie treść maila podjeżdża, żeby asystent się zmieścił */
  if(s.czIn){
    const nad=Math.max(0,s.czIn.scrollHeight-s.czyt.clientHeight+8);
    const v=d.wiersze?ss((p-d.wiersze[0])/(d.wiersze[4]-d.wiersze[0]+.02)):0;
    s.czIn.style.transform=nad?`translateY(${(-nad*v).toFixed(1)}px)`:'';
  }
}

let raf=0;
function cel(){
  const vh=innerHeight;
  sceny.forEach(s=>{ const r=s.el.getBoundingClientRect(); s.tgt=cl(-r.top/Math.max(1,r.height-vh)); s.wid=r.bottom>-vh&&r.top<vh*2; });
}
function klatka(){
  raf=0; let dalej=false;
  sceny.forEach(s=>{
    if(!s.wid&&s.cur>=0) return;
    const nowy=(SNAP||RM||s.cur<0)?s.tgt:s.cur+(s.tgt-s.cur)*.16;
    const koniec=Math.abs(s.tgt-nowy)<.0004;
    s.cur=koniec?s.tgt:nowy; ustaw(s); if(!koniec) dalej=true;
  });
  if(dalej) raf=requestAnimationFrame(klatka);
}
const ruch=()=>{ cel(); if(!raf) raf=requestAnimationFrame(klatka); };
addEventListener('scroll',ruch,{passive:true}); addEventListener('resize',ruch);
cel(); sceny.forEach(s=>{s.cur=s.tgt; ustaw(s);});
if(document.fonts&&document.fonts.ready) document.fonts.ready.then(()=>{cel(); sceny.forEach(ustaw);});

/* hero: okno nowej wiadomości wjeżdża */
const nowa=$('#nowa'); if(nowa){ if(SNAP||RM) nowa.classList.add('on'); else requestAnimationFrame(()=>requestAnimationFrame(()=>nowa.classList.add('on'))); }
})();

/* ───── wiadomość do Piotra: trzy formularze (hero, pasek, odpowiedź), jedna treść ─────
   POST /api/kontakt jak formularz strony (Zgody.astro dokłada Lead dla Mety).
   Do statystyk idzie tylko miejsce i kanał, nigdy same dane. */
(()=>{
const $=(s,r=document)=>r.querySelector(s), $$=(s,r=document)=>[...r.querySelectorAll(s)];
const SNAP=!!window.__snap;
const stat=(e,p)=>{try{window.laStat&&window.laStat(e,p||{});}catch(x){}};
const formy=$$('.kz'), szkic=$('#szkic'), bar=$('#szBar'), szT=$('#szT'), szS=$('#szS'), szGo=$('#szGo');
const hero=$('#nowa'), teraz=$('#teraz'), tzApp=$('#tzApp');
const MAIL=/^[^\s@]+@[^\s@]+\.[a-zA-Z]{2,}$/;
let wysylam=false, wyslane=false, otwarty=false;
function rozpoznaj(v){
  if(v.includes('@')) return MAIL.test(v)?{email:v,telefon:''}:{blad:'adres chyba niepełny?'};
  const c=v.replace(/\D/g,'');
  if(c.length<9) return {blad:v?'za mało cyfr?':'tu wpisz swój numer'};
  return {email:'',telefon:(c.length===9?'+48 ':'+')+c.replace(/^00/,'')};
}
/* jedna treść we wszystkich trzech miejscach */
formy.forEach(f=>{
  const i=$('.kz-i',f), z=$('input[name=zgoda]',f);
  i.addEventListener('input',()=>{ formy.forEach(g=>{ if(g!==f) $('.kz-i',g).value=i.value; $('.kz-err',g).textContent=''; }); pasek(); });
  i.addEventListener('focus',()=>stat('skrzynka_pole',{miejsce:f.dataset.k}),{once:true});
  z.addEventListener('change',()=>formy.forEach(g=>{ $('input[name=zgoda]',g).checked=z.checked; $('.kz-z',g).classList.remove('err'); }));
  f.addEventListener('submit',e=>{ e.preventDefault(); wyslij(f); });
});
function pasek(){
  const v=$('.kz-i',formy[0]).value.trim();
  if(wyslane){ szT.textContent='Wysłane do Piotra'; szS.textContent='Zadzwoni w jeden dzień roboczy'; szGo.textContent='✓'; return; }
  szT.textContent=v?'Wersja robocza do Piotra':'Wiadomość do Piotra';
  szS.textContent=v?('Mój numer: '+v):'Wpisz numer telefonu';
  szGo.textContent=v?'Wyślij':'Napisz';
}
/* pasek: widać go, gdy okno z hero zniknie, a odpowiedź na dole jeszcze nie weszła */
function widocznosc(){
  const vh=innerHeight, h=hero.getBoundingClientRect(), t=tzApp.getBoundingClientRect();
  const on=h.bottom<vh*.35 && t.top>vh*.9;
  szkic.classList.toggle('on',on);
  document.documentElement.classList.toggle('sk-pasek',on);
  if(!on&&otwarty) zamknij();
}
addEventListener('scroll',widocznosc,{passive:true}); addEventListener('resize',widocznosc); widocznosc();
function otworz(){ otwarty=true; szkic.classList.add('otw'); stat('skrzynka_pasek_otworz',{}); setTimeout(()=>{try{$('.kz-i',$('.sz-ark')).focus({preventScroll:true});}catch(x){}},300); }
function zamknij(){ otwarty=false; szkic.classList.remove('otw'); }
bar.addEventListener('click',()=>{ if(wyslane) return; otworz(); });
$$('[data-zamknij]',szkic).forEach(b=>b.addEventListener('click',zamknij));
addEventListener('keydown',e=>{ if(e.key==='Escape'&&otwarty) zamknij(); });
$$('[data-tel]').forEach(el=>el.addEventListener('click',()=>stat('tel_klik',{skad:el.dataset.tel})));

/* odpowiedź na dole: mail Piotra „przychodzi”, gdy wjedzie na ekran */
if(tzApp){ if(SNAP||!('IntersectionObserver' in window)) tzApp.classList.add('in');
  else new IntersectionObserver((es,o)=>es.forEach(x=>{ if(x.isIntersecting){ tzApp.classList.add('in'); o.disconnect(); } }),{threshold:.3}).observe(tzApp); }

function wyslij(f){
  if(wysylam||wyslane) return;
  const i=$('.kz-i',f), err=$('.kz-err',f), z=$('input[name=zgoda]',f), btn=$('.kz-wy',f), bt=$('.kz-wt',f);
  const r=rozpoznaj(i.value.trim());
  if(r.blad){ err.textContent=r.blad; i.focus(); return; }
  if(!z.checked){ $('.kz-z',f).classList.add('err'); err.textContent='zaznacz zgodę poniżej'; return; }
  wysylam=true; btn.disabled=true; bt.textContent='Wysyłam…';
  const miejsce=f.dataset.k;
  let ref=''; try{ref=localStorage.getItem('referrer')||'';}catch(x){}
  fetch('/api/kontakt',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},
    body:JSON.stringify({email:r.email,telefon:r.telefon,
      wiadomosc:'Wiadomość do Piotra z landingu '+location.pathname+' ('+miejsce+'): proszę o '+(r.telefon?'telefon':'maila')+', chcę zobaczyć na naszym zamówieniu, ile może u nas zostawać.',
      firma_www:f.elements.kontrola.value||'',zrodlo:'Marża · skrzynka · '+location.pathname+' · '+miejsce,referrer:ref})})
  .then(o=>{ if(!o.ok) return o.json().catch(()=>({})).then(j=>{throw new Error(j.blad||'blad');});
    wyslane=true;
    try{window.dataLayer=window.dataLayer||[];window.dataLayer.push({event:'formularz_wyslany',zrodlo:'Marża · skrzynka'});}catch(x){}
    stat('skrzynka_wyslana',{miejsce:miejsce,kanal:r.telefon?'telefon':'email'});
    formy.forEach(g=>{ g.classList.add('wyslane'); $('.kz-ok',g).hidden=false; });
    $('#tzNr').textContent=r.telefon||r.email;
    tzApp.classList.add('in','wys');
    const t0=Date.now();
    setTimeout(()=>{ tzApp.classList.add('odp'); $('#tzCzas').textContent='po '+Math.max(1,Math.round((Date.now()-t0)/1000))+' s'; },3000);
    pasek(); setTimeout(zamknij,1400);
    if(miejsce!=='koniec') setTimeout(()=>{ szkic.classList.remove('on'); },4200);
  })
  .catch(x=>{ wysylam=false; btn.disabled=false; bt.textContent='Wyślij';
    err.textContent=x&&x.message==='brak-konfiguracji'?'nie działa, zadzwoń: 571 399 932':'nie doszło, spróbuj jeszcze raz';
    stat('skrzynka_blad',{powod:String(x&&x.message||'blad').slice(0,30)}); });
}
pasek();
})();

</script>
</LaBase>
