---
// INTEGRACJA SYSTEMÓW Z AI — /integracja-systemow-z-ai (do 3.11.2026 /kazdy-system,
// stary adres przekierowuje tutaj: vercel.json)
// Landing pod film „Każdy system” (LinkedIn Szymona, 3.11.2026). Strona
// konwersji jak /darmowa-konsultacja: formularz w hero z portretem Szymona,
// formularz na końcu nad FAQ (moduł Kontakt). Pierwszy krok nazywa się tu
// „bezpłatna diagnoza”, bo tak mówi film (głos i plansza końcowa).
//
// Kolejność idzie za łukiem filmu: hero z formularzem → AI nie ma dostępu
// do systemów firmy → ludzie przepisują → film → sześć scenariuszy w dwóch
// grupach (systemy rozmawiają z AI i ze sobą; AI robi pracę w systemach)
// → diagnoza i plan → formularz → FAQ.
//
// Grafiki: public/kazdy-system/g/, generowane z kitu systemów filmu
// (~/filmy/lets-kazdy-system/strona/build.py render). Film z napisami
// w wersji na stronę: public/kazdy-system/film-kazdy-system.mp4 (1080p, 31 MB),
// źródło ~/filmy/lets-kazdy-system/film/renders/kazdy-system-1080p-napisy.mp4.
// Przykład jest fikcyjny (Okna Brzozowski, OknoPlan, pan Nowak).
//
// Strony nie ma w menu, jest w mapie strony. Wchodzi się z posta na LinkedIn
// i z kart na /automatyzacje-integracje i /lets-shift (KartaKazdySystem).
// UTM-y z adresu i ?z= (karta, z której kliknięto) dopisują się do źródła
// zgłoszenia skryptem na końcu strony. Podgląd po wysłaniu: /integracja-systemow-z-ai?sukces=1
//
// DO POTWIERDZENIA
//   1. Z którymi systemami połączenie jest sprawdzone (Sztab, d-erp).
//   2. FAQ „Co z bezpieczeństwem danych?”: zakres dostępu AI w systemie
//      ustalany z klientem przed startem.
//   3. „Bezpłatna diagnoza” tutaj, „Bezpłatna konsultacja” na reszcie
//      serwisu (Sztab, d-pierwszy-krok).
import LaBase from '../layouts/LaBase.astro';
import GcFaq from '../components/GcFaq.astro';
import Styl from '../components/usluga/Styl.astro';
import Anim from '../components/usluga/Anim.astro';
import Loga from '../components/usluga/Loga.astro';
import Kontakt from '../components/usluga/Kontakt.astro';
import Film from '../components/Film.astro';
import { FILM_KAZDY_SYSTEM as F } from '../data/film-kazdy-system.js';
import { HI, SYGNET } from '../components/usluga/ikony';

const title = "Integracja systemów z AI: podłączymy każdy system — Let's automate";
const description = 'Integracja systemów z AI w Let’s automate. Stary ERP, program branżowy albo portal dostawcy, lokalnie w biurze albo w chmurze. Podłączamy go do sztucznej inteligencji i łączymy z resztą firmy, bez wymiany systemu. Bezpłatna diagnoza kończy się planem działania z ceną pierwszego etapu.';
const ZRODLO = 'Bezpłatna diagnoza · Każdy system';
const dwa = (n: number) => String(n).padStart(2, '0');
const K = '/kazdy-system';             // katalog plików w public/ (film, grafiki)
const ADRES = '/integracja-systemow-z-ai';

// Scenariusze z grafikami z kitu systemów filmu (ta sama fikcyjna firma:
// Okna Brzozowski). Pierwsza karta w grupie szeroka.
const ROZMAWIAJA = [
  { f: 'czat', alt: 'Claude odpowiada na pytanie o zamówienie danymi z programu produkcyjnego OknoPlan',
    t: 'Handlowiec pyta czat o zamówienie',
    dzis: 'Dzwoni na halę, żeby sprawdzić termin i wymiary, i czeka, aż ktoś zajrzy do programu produkcyjnego.',
    po: 'Pyta ChatGPT albo Claude. Odpowiedź przychodzi prosto z programu produkcyjnego, z terminem i wymiarami każdej pozycji.' },
  { f: 'oferta', alt: 'Oferta złożona z danych z programu cenowego, ERP i programu produkcyjnego',
    t: 'Oferta z trzech programów naraz',
    dzis: 'Handlowiec przepisuje ceny z cennika, sprawdza stany w ERP i kopiuje rysunek z programu produkcyjnego.',
    po: 'AI składa ofertę z danych w tych programach, razem z rysunkiem i terminem. Handlowiec ją czyta i wysyła.' },
  { f: 'dostawa', alt: 'Odpowiedź dla klienta z numerem przesyłki, przygotowana z danych magazynu i panelu kuriera',
    t: 'Klient pyta, kiedy dojadą okna',
    dzis: 'Biuro sprawdza magazyn, potem panel kuriera i dopiero wtedy odpisuje.',
    po: 'Odpowiedź z numerem przesyłki czeka gotowa w skrzynce. Wystarczy ją wysłać.' },
];
const PRACUJA = [
  { f: 'faktura', alt: 'Faktura z maila wpisana do programu księgowego w Accessie i czekająca na zatwierdzenie',
    t: 'Faktura z maila sama w programie księgowym',
    dzis: 'Ktoś otwiera PDF, przepisuje pozycje do programu księgowego w Accessie i porównuje je z zamówieniem.',
    po: 'Appto wpisuje fakturę, sprawdza ją z zamówieniem i zostawia księgowej do zatwierdzenia.' },
  { f: 'braki', alt: 'Braki w terminalu magazynu i gotowy koszyk w portalu hurtowni czekający na zatwierdzenie',
    t: 'Braki w magazynie zamawiają się same',
    dzis: 'Magazynier przegląda stany w terminalu, a zakupowiec klika pozycje w portalu hurtowni.',
    po: 'Kiedy kończy się towar na zlecenia z przyszłego tygodnia, koszyk w portalu jest gotowy. Zakupowiec tylko zatwierdza.' },
  { f: 'cennik', alt: 'Nowy cennik dostawcy wpisany do programu cenowego i wiadomość dla handlowców o ofertach do przeliczenia',
    t: 'Nowy cennik dostawcy bez przepisywania',
    dzis: 'Ktoś przenosi zmiany z Excela do programu z cennikiem, a handlowcy dowiadują się o nich po fakcie.',
    po: 'Ceny w programie zmieniają się same, a handlowcy od razu wiedzą, które wysłane oferty przeliczyć.' },
];
const GRUPY = [
  { id: 'rozmawiaja', t: 'Systemy rozmawiają z AI i ze sobą', d: 'Dane ze starego programu trafiają do czatu i do dokumentów, które dziś ktoś składa ręcznie.', k: ROZMAWIAJA },
  { id: 'pracuja', t: 'AI robi pracę w systemach', d: 'Wpisuje dane i przygotowuje zamówienia w programach, w których dziś klikają ludzie. Decyzja zostaje przy człowieku.', k: PRACUJA },
];

// Przebieg od formularza do planu. Ostatni krok to wynik, po który klient przychodzi.
const KROKI = [
  { t: 'Formularz', d: 'Kontakt i nazwa systemu, który chcecie podłączyć. Wystarczy jedno zdanie.', kiedy: 'minuta' },
  { t: 'Dzwoni Piotr', d: 'Pyta o system i o pracę, która dziś się wokół niego kręci. Kiedy nie umiemy pomóc, mówi to od razu.', kiedy: 'w 1 dzień roboczy',
    os: { f: '/piotr-avatar.jpg', n: 'Piotr Wojciuk', r: 'New Business Lead' } },
  { t: 'Diagnoza', d: 'Przechodzimy przez Wasze systemy: gdzie leżą dane, kto je przepisuje i dokąd. Bez dostępu do systemów, wystarczy rozmowa.', kiedy: 'w terminie, który Wam pasuje' },
  { t: 'Plan działania z ceną', d: 'Który system podłączamy pierwszy, jaka praca z niego znika i ile kosztuje pierwszy etap. Kwota stała.', kiedy: 'po diagnozie', mocny: true },
];

const faq = [
  {
    q: 'Czy musimy wymienić albo zaktualizować system?',
    a: 'Zwykle nie. Zaczynamy od wersji, którą macie, także jeśli ma kilkanaście lat. Jeśli na diagnozie wyjdzie, że któryś program taniej jest wymienić, powiemy to wprost.',
  },
  {
    q: 'Producent mówi, że integracji nie ma. Czy to ma sens?',
    a: 'Tak. Od takich systemów zaczynamy najczęściej, bo wokół nich najwięcej pracy idzie na przepisywanie. Na diagnozie sprawdzamy Wasz konkretny program i mówimy, czy i jak go podłączymy.',
  },
  {
    q: 'Nasz program działa lokalnie, w biurze. Czy to przeszkoda?',
    a: 'Nie. Podłączamy programy zainstalowane na serwerze w firmie i systemy w chmurze. Połączenie działa na serwerze, więc komputery pracowników zostają bez zmian. Jeśli Wasz program działa dziś tylko na pojedynczych komputerach, na diagnozie ustalimy z osobą odpowiedzialną za IT, jak przenieść go na serwer.',
  },
  {
    q: 'Czy musimy korzystać z Appto?',
    a: 'Nie. System podłączamy do Appto albo do modeli, z których już korzystacie, np. ChatGPT albo Claude. Appto przydaje się, kiedy z AI ma korzystać cała firma, a ludzie nie mają uczyć się pisania promptów.',
  },
  {
    q: 'Co z bezpieczeństwem danych?',
    a: 'Pracujemy zgodnie z RODO, a NDA podpisujemy także przed samą diagnozą, jeśli tego potrzebujecie. Do diagnozy nie potrzebujemy dostępu do żadnego systemu. Przed startem ustalamy z Wami, co AI może w systemie odczytać i co może w nim zrobić.',
  },
  {
    q: 'Ile to kosztuje?',
    a: 'Diagnoza jest bezpłatna. W planie działania wyceniamy pierwszy etap kwotą stałą, znaną przed startem. Każdy kolejny etap też ma cenę, zanim go zaczniemy.',
  },
  {
    q: 'Czy diagnoza zobowiązuje do współpracy?',
    a: 'Nie. Plan zostaje u Was. Możecie go zrealizować z własnym zespołem albo z inną firmą.',
  },
];

const kanon = new URL(ADRES, Astro.site).href;
const dane = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${kanon}#usluga`,
      name: 'Integracja systemów z AI',
      serviceType: 'Integracja systemów firmowych z AI',
      url: kanon,
      description: 'Let’s automate podłącza do sztucznej inteligencji systemy firmy działające lokalnie i w chmurze: ERP, programy branżowe, portale dostawców, także te bez integracji. Pierwszy krok to bezpłatna diagnoza zakończona planem działania z ceną pierwszego etapu.',
      provider: { '@id': new URL('/#organizacja', Astro.site).href },
      areaServed: { '@type': 'Country', name: 'Polska' },
    },
    {
      '@type': 'VideoObject',
      '@id': `${kanon}#film`,
      name: 'Każdy system — Let’s automate',
      description: 'Jak podłączyć do AI program branżowy, którego nie da się zintegrować. Przykład: program produkcyjny w firmie produkującej okna.',
      thumbnailUrl: new URL(`${K}/plakat.jpg`, Astro.site).href,
      contentUrl: F.mux ? `https://stream.mux.com/${F.mux}.m3u8` : new URL(F.mp4, Astro.site).href,
      uploadDate: '2026-11-03',
      duration: 'PT2M25S',
      inLanguage: 'pl',
    },
    {
      '@type': 'FAQPage',
      '@id': `${kanon}#faq`,
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---
<LaBase topbar={false} title={title} description={description} ogImage="/og/kazdy-system.jpg" ctaHref="#formularz" ctaLabel="Umów diagnozę" nav={null}>
<script type="application/ld+json" is:inline set:html={JSON.stringify(dane)} slot="head"></script>
<style is:global slot="head">
  /* =====================================================================
     HERO · plansza modułu Kontakt jak na /darmowa-konsultacja
     ===================================================================== */
  .zg{padding:0 var(--ram);scroll-margin-top:84px}
  .zg .kt-in{--kp:clamp(40px,4.4vw,64px);grid-template-columns:minmax(0,4.8fr) minmax(0,5.4fr) minmax(0,2.1fr)}
  @media (max-width:1180px){ .zg .kt-in{grid-template-columns:minmax(0,1fr) minmax(0,1.3fr) minmax(0,0.5fr)} }
  .zg .hi{display:block;flex-shrink:0;fill:currentColor}
  .zg .kt-os img{object-position:50% 14%}
  .zg .kt-os figcaption{left:18px;right:14px}
  .zg .kt-os figcaption span{font-size:12.5px}
  .zg-h1{margin:0;font-size:clamp(34px,3.3vw,50px);line-height:1.02;letter-spacing:-0.045em;font-weight:700;color:#ffffff;text-wrap:balance}
  .zg-h1 span{color:var(--ziel)}
  .zg-h1 small{display:block;margin-bottom:18px;font-size:15px;line-height:1.3;letter-spacing:-0.005em;font-weight:650;color:var(--ziel)}
  .zg .kt-lewa .v3-sub{max-width:450px}
  .zg-film{display:inline-flex;align-items:center;gap:12px;margin-top:clamp(22px,2.2vw,30px);padding:6px 16px 6px 6px;border-radius:999px;background:rgba(255,255,255,0.07);box-shadow:inset 0 0 0 1px rgba(255,255,255,0.14);font-size:14.5px;font-weight:650;color:#ffffff;transition:background .18s}
  .zg-film:hover{background:rgba(255,255,255,0.13)}
  .zg-film i{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:var(--ziel)}
  .zg-film i svg{display:block;width:12px;height:12px;margin-left:2px;fill:var(--ink)}
  .zg-film small{font-size:13px;font-weight:500;color:rgba(255,255,255,0.6)}
  .zg .kt-karta h2{margin:0 0 22px;font-size:clamp(22px,1.9vw,26px);font-weight:700;letter-spacing:-0.025em;line-height:1.15;color:#ffffff}
  .zg-kroki{margin:18px 0 0;padding:0;list-style:none;counter-reset:k}
  .zg-kroki li{display:grid;grid-template-columns:28px minmax(0,1fr);gap:10px;align-items:baseline;padding:10px 0;border-top:1px solid rgba(255,255,255,0.14);font-size:14.5px;line-height:1.5;color:rgba(255,255,255,0.72)}
  .zg-kroki li::before{counter-increment:k;content:"0" counter(k);font-size:12.5px;font-weight:650;color:var(--ziel)}
  .zg-kroki b{color:#ffffff}
  @media (max-width:1000px){ .zg .kt-karta h2{font-size:22px} }

  .v3 > .v3-sek{padding-top:clamp(72px,8.5vw,128px);padding-bottom:clamp(72px,8.5vw,128px)}
  .v3-h2.sr{font-size:clamp(32px,3.8vw,56px)}

  /* =====================================================================
     PROBLEM · dwa kadry z filmu, tekst obok, układ na zmianę
     ===================================================================== */
  .pr{display:grid;gap:clamp(64px,8vw,120px)}
  .pr-w{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,6.4fr);gap:clamp(32px,5vw,88px);align-items:center}
  .pr-w.odw{grid-template-columns:minmax(0,6.4fr) minmax(0,5fr)}
  .pr-w.odw .pr-t{order:2}
  .pr-t .v3-sub{margin-top:22px}
  .pr-t .v3-sub + .v3-sub{margin-top:14px}
  .pr-t b{color:var(--t1);font-weight:650}
  .pr-cyt{display:block;margin-top:24px;padding-left:16px;border-left:3px solid var(--burs);font-size:clamp(17px,1.4vw,19px);line-height:1.45;letter-spacing:-0.012em;color:var(--t1);text-wrap:pretty}
  .pr-cyt s{text-decoration:none;font-family:var(--mono);font-size:.92em;padding:1px 6px;border-radius:5px;background:rgba(240,163,58,0.18);color:var(--burs-c)}
  .kadr{position:relative;margin:0;border-radius:16px;overflow:hidden;background:#ECEEE8;box-shadow:0 0 0 1px rgba(15,26,20,0.08),0 40px 80px -48px rgba(8,26,17,0.55)}
  .kadr img{display:block;width:100%;height:auto;aspect-ratio:16/10;object-fit:cover}
  .kadr figcaption{position:absolute;left:12px;bottom:12px;padding:5px 10px;border-radius:999px;background:rgba(7,20,13,0.78);font-size:12px;font-weight:600;color:rgba(255,255,255,0.86);backdrop-filter:blur(6px)}
  @media (max-width:900px){
    .pr-w,.pr-w.odw{grid-template-columns:1fr}
    .pr-w.odw .pr-t{order:0}
  }

  /* =====================================================================
     FILM · ciemna scena, odtwarzacz na całą szerokość treści
     ===================================================================== */
  #film{scroll-margin-top:24px}
  .fm-gl{display:flex;flex-wrap:wrap;align-items:end;justify-content:space-between;gap:20px 48px}
  .fm-gl .v3-sub{max-width:520px}
  .fm-ok{position:relative;margin-top:clamp(36px,4vw,56px);border-radius:18px;overflow:hidden;background:#000;box-shadow:0 0 0 1px rgba(255,255,255,0.1),0 60px 120px -60px rgba(0,205,119,0.35)}
  .fm-dol{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:14px 32px;margin-top:22px;font-size:14.5px;color:rgba(255,255,255,0.62)}
  .fm-dol a{display:inline-flex;align-items:center;gap:8px;font-weight:700;color:var(--ziel)}
  .fm-dol a svg{display:block;width:14px;height:14px;fill:currentColor;transition:transform .18s}
  .fm-dol a:hover svg{transform:translateX(3px)}

  /* =====================================================================
     SCENARIUSZE · grafiki z kitu filmu, pary Dziś / Po; pierwsza karta w grupie szeroka
     ===================================================================== */
  .zm{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(16px,2vw,28px);margin-top:clamp(20px,2vw,28px)}
  .zg2{margin-top:clamp(52px,6vw,88px)}
  .zg2-gl{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 24px;padding-bottom:16px;border-bottom:1px solid var(--linia)}
  .zg2-gl h3{margin:0;font-size:clamp(22px,2vw,28px);font-weight:700;letter-spacing:-0.03em}
  .zg2-gl p{margin:0;max-width:560px;font-size:15.5px;line-height:1.55;color:var(--t2)}
  .zm-dob{margin:clamp(40px,4vw,56px) 0 0;max-width:760px;font-size:16.5px;line-height:1.6;color:var(--t2)}
  .zm-dob b{color:var(--t1);font-weight:650}
  .zm-k{display:flex;flex-direction:column;border-radius:20px;overflow:hidden;background:#ffffff;box-shadow:0 0 0 1px rgba(15,26,20,0.07),0 30px 60px -50px rgba(8,26,17,0.5)}
  .zm-k img{display:block;width:100%;height:auto;aspect-ratio:16/10;object-fit:cover;background:#ECEEE8;border-bottom:1px solid var(--linia2)}
  .zm-tx{display:flex;flex-direction:column;padding:clamp(22px,2.4vw,32px)}
  .zm-k h3{margin:0;font-size:clamp(20px,1.8vw,24px);font-weight:700;letter-spacing:-0.025em;line-height:1.15}
  .zm-pp{display:grid;gap:14px;margin:18px 0 0}
  .zm-pp dt{display:flex;align-items:center;gap:7px;font-size:12.5px;font-weight:700;color:var(--burs-c)}
  .zm-pp dt::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--burs)}
  .zm-pp .po dt{color:var(--ziel-c)}
  .zm-pp .po dt::before{background:var(--ziel)}
  .zm-pp dd{margin:4px 0 0;font-size:15px;line-height:1.55;color:var(--t2);text-wrap:pretty}
  .zm-pp .po dd{color:var(--t1)}
  .zm-k.szer{grid-column:1 / -1;flex-direction:row}
  .zm-k.szer img{width:62%;flex-shrink:0;border-bottom:0;border-right:1px solid var(--linia2)}
  .zm-k.szer .zm-tx{justify-content:center;padding:clamp(28px,3.2vw,48px)}
  .zm-k.szer h3{font-size:clamp(24px,2.3vw,32px)}
  .zm-k.szer .zm-pp dd{font-size:16px}
  .zm.gra .zm-k{opacity:0;transform:translateY(14px)}
  .zm.gra.on .zm-k{opacity:1;transform:none;transition:opacity .55s ease calc(var(--i) * .1s),transform .55s cubic-bezier(.2,.7,.2,1) calc(var(--i) * .1s)}
  @media (max-width:980px){
    .zm{grid-template-columns:1fr}
    .zm-k.szer{flex-direction:column}
    .zm-k.szer img{width:100%;border-right:0;border-bottom:1px solid var(--linia2)}
  }

  /* =====================================================================
     DIAGNOZA · kroki w pionie, obok kartka planu
     ===================================================================== */
  .dg{display:grid;grid-template-columns:minmax(0,6fr) minmax(0,5fr);gap:clamp(36px,6vw,104px);align-items:start;margin-top:clamp(44px,5vw,72px)}
  .dg-k{margin:0;padding:0;list-style:none}
  .dg-k li{position:relative;display:grid;grid-template-columns:40px minmax(0,1fr);gap:20px;padding-bottom:34px}
  .dg-k li:last-child{padding-bottom:0}
  .dg-k li::before{content:"";position:absolute;left:19.5px;top:46px;bottom:6px;width:1px;background:repeating-linear-gradient(180deg,rgba(255,255,255,0.3) 0 5px,transparent 5px 11px)}
  .dg-k li:last-child::before{display:none}
  .dg-n{display:grid;place-items:center;width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,0.08);box-shadow:inset 0 0 0 1px rgba(255,255,255,0.18);font-size:14px;font-weight:700;color:#ffffff}
  .dg-k li.mocny .dg-n{background:var(--ziel);box-shadow:none;color:var(--ink)}
  .dg-k h3{display:flex;flex-wrap:wrap;align-items:center;gap:8px 14px;margin:7px 0 0;font-size:clamp(19px,1.7vw,23px);font-weight:700;letter-spacing:-0.025em;line-height:1.15;color:#ffffff}
  .dg-czas{display:inline-flex;align-items:center;gap:6px;padding:4px 11px 4px 9px;border-radius:999px;background:rgba(255,255,255,0.08);font-size:12.5px;font-weight:600;letter-spacing:0;color:rgba(255,255,255,0.72)}
