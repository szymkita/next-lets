  .ka-w{display:grid;grid-template-columns:minmax(120px,0.42fr) minmax(0,1fr);gap:14px;align-items:baseline;padding:11px 0;border-top:1px solid rgba(255,255,255,0.1)}
  .ka-k{font-size:12.5px;color:rgba(255,255,255,0.45)}
