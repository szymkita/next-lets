---
// AUTOMATYZACJE I INTEGRACJE — /automatyzacje-integracje
// Trzecia i ostatnia podstrona z pionu „Budujemy aplikacje". Domyka komplet.
//
// LEKCJA Z /systemy-dla-klientow (oceniona jako najsłabsza z pięciu):
// tamta strona miała dwa rysunki tego samego gatunku — listę słupków w hero
// i listę słupków w ciemnym pasie — a tezę („portal musi być szybszy od
// telefonu") tylko wypowiadała. Tutaj: JEDNA animacja z prawdziwym ruchem
// i JEDEN artefakt, dwa różne rejestry. Teza jest pokazana, nie opisana:
// w hero trzecia linia po prostu przestaje pulsować.
//
// CZYM SIĘ RÓŻNI OD RESZTY PIONU:
//   /systemy-procesowe    — system prowadzi proces, miarą jest czas sprawy
//   /systemy-dla-klientow — system stoi u klienta, miarą są pytania
//   tutaj                 — dane przechodzą między systemami, miarą jest to,
//                           czy wiadomo, kiedy przestaną przechodzić
// To jest podłoga tego pionu: najtańsza rzecz, jaką można kupić, i jedyna,
// która zwraca się w tygodniach. Po niej widać, czy sensowny jest system.
//
// POZYCJONOWANIE — dwa argumenty:
//   1. ROLA. Integracja kosztuje dni, nie miesiące, i widać po niej w kilka
//      tygodni, czy warto iść dalej. Jest też warunkiem wstępnym dla dwóch
//      pozostałych usług z pionu: zanim system poprowadzi proces, dane muszą
//      być w jednym miejscu i aktualne.
//   2. TEZA. Automatyzacja, która pada po cichu, jest gorsza od jej braku —
//      bo ludzie już przestali robić to ręcznie, a system przestał robić to
//      za nich. Kategoria sprzedaje scenariusze; my sprzedajemy to, że
//      o awarii dowiadujecie się w minutach.
//
// TRZY RZECZY SPRAWDZALNE PRZED PODPISANIEM UMOWY:
//   1. Każde połączenie ma kartę: co uruchamia, co robi, co się dzieje przy
//      błędzie, kto jest właścicielem i na czym stoi. Karta jest w ciemnym
//      pasie w całości, więc klient wie, co dostanie, zanim zapłaci.
//   2. Alarm z progiem czasowym, nie „monitoring" w ogólności. Osiem minut
//      ciszy i wiadomość idzie do imiennie wskazanej osoby.
//   3. Odsyłamy do zrobienia samemu, kiedy chodzi o jedno połączenie
//      i ktoś u Was umie kliknąć w Make'u.
//
// WARSTWA WIZUALNA — szósty osobny słownik w serwisie:
//   /strategia-ai:         łuki, przewijany strumień, siatka stu kwadratów
//   /rozwiazania-ai:       przekrój warstw, próg pewności, tory harmonogramu
//   /szkolenia-ai:         jednostki do policzenia (ludzie, minuty)
//   /systemy-procesowe:    oś czasu sprawy — praca kontra czekanie
//   /systemy-dla-klientow: lista pytań
//   tutaj:                 PULS. Cztery automatyzacje biją we własnym rytmie,
//     trzecia milknie w połowie i dopiero wtedy zapala się alarm.
//     Ruch jest tu argumentem: cisza jednej linii na tle bijących pozostałych
//     jest dokładnie tym, czego w prawdziwej firmie nikt nie zauważa.
//   Drugi nośnik to artefakt, nie wykres: karta automatyzacji w całości.
//
// DO POTWIERDZENIA PRZED PUBLIKACJĄ:
// · Zawartość karty automatyzacji — kształt jest pewny, wartości przykładowe.
// · Próg alarmu (osiem minut ciszy) i trzy próby co pięć minut — założenie
//   o standardzie, do potwierdzenia jako obietnica handlowa.
// · Zdanie o odsyłaniu do zrobienia samemu — decyzja Szymona.
// · Trzy przykłady w sekcji DOWODY są PRZYKŁADOWE, do podmiany.
// · Kwoty świadomie nie ma. Miejsce na nią czeka w FAQ „Ile kosztuje".
// · /og/automatyzacje-integracje.png — strona dziedziczy /og/hub.png.
import LaBase from '../layouts/LaBase.astro';
import GcFaq from '../components/GcFaq.astro';
import GcCta from '../components/GcCta.astro';

const kanon = new URL('/automatyzacje-integracje', Astro.site).href;

const dane = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${kanon}#usluga`,
      name: 'Automatyzacje i integracje',
      alternateName: ['Integracje systemów', 'Automatyzacja procesów', 'Przepływ danych między systemami'],
      serviceType: 'Łączenie systemów firmowych i automatyzacja przepływu danych między nimi',
      url: kanon,
      description: 'Połączenia między CRM, ERP, magazynem i pocztą, dzięki którym nikt nie przepisuje danych z systemu do systemu. Każde połączenie dostaje kartę, imiennego właściciela, opisane zachowanie przy błędzie i alarm z progiem czasowym.',
      provider: { '@id': new URL('/#organizacja', Astro.site).href },
      areaServed: { '@type': 'Country', name: 'Polska' },
      audience: { '@type': 'BusinessAudience', name: 'Firmy z kilkoma systemami, które nie wymieniają danych' },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${kanon}#okruszki`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Strona główna', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: 'Automatyzacje i integracje', item: kanon },
      ],
    },
  ],
};

const title = "Automatyzacje i integracje systemów — z alarmem, nie na wiarę | Let's automate";
const description = 'Łączymy CRM, ERP, magazyn i pocztę tak, żeby nikt nie przepisywał danych. Każde połączenie ma kartę, właściciela i alarm — bo automatyzacja, która pada po cichu, jest gorsza od jej braku.';


// ---- PULS (hero) --------------------------------------------------------
// Cztery automatyzacje, każda z własnym odstępem między przebiegami. Trzecia
// milknie w połowie osi i dopiero po chwili ciszy zapala się alarm. Cały
// argument strony jest tu pokazany ruchem: cisza jednej linii na tle
// bijących pozostałych to dokładnie to, czego nikt w firmie nie zauważa.
// Wszystkie czasy wynikają z odstępów w tej tablicy.
const SLOTY = 30;
const PULS = [
  { t: 'Faktury z poczty → ERP', o: 0.55, ile: SLOTY, st: '1 240 / mies.' },
  { t: 'Zamówienia z portalu → produkcja', o: 0.86, ile: SLOTY, st: '380 / mies.' },
  { t: 'Nowy klient w CRM → księgowość', o: 0.62, ile: 12, st: '420 / mies.', awaria: 'stanęła 03:12', pada: true },
  { t: 'Stany magazynowe → sklep', o: 0.41, ile: SLOTY, st: '4 / godz.' },
];
const PU_C = 20;
const PU_START = 0.5;
const IDX_PADA = PULS.findIndex((x) => x.pada);
const OSTATNI = PU_START + (PULS[IDX_PADA].ile - 1) * PULS[IDX_PADA].o;
const CISZA = OSTATNI + 2.1;      // kiedy widać, że kolejny przebieg nie przyszedł
const ALARM = CISZA + 0.9;
const PU_GASNIE = 18.2;
const up = (s) => `${(Math.max(0, Math.min(1, s / PU_C)) * 100).toFixed(2)}%`;

// Wszystkie kreski dzielą jedną klatkę i różnią się wyłącznie opóźnieniem —
// przy równym czasie cyklu układ powtarza się co obieg, bez rozjazdu.
const klatkiPuls = [
  `@keyframes pu-tik{0%{opacity:0;transform:scaleY(.3)}2.2%{opacity:1;transform:scaleY(1)}${up(PU_GASNIE)}{opacity:1;transform:scaleY(1)}${up(PU_GASNIE + 0.7)}{opacity:0;transform:scaleY(.3)}100%{opacity:0;transform:scaleY(.3)}}`,
  `@keyframes pu-brak{0%,${up(CISZA)}{opacity:0}${up(CISZA + 0.6)}{opacity:1}${up(PU_GASNIE)}{opacity:1}${up(PU_GASNIE + 0.6)}{opacity:0}100%{opacity:0}}`,
  `@keyframes pu-cisza{0%,${up(CISZA)}{color:#8b968d}${up(CISZA + 0.5)}{color:#b07524}${up(PU_GASNIE)}{color:#b07524}100%{color:#8b968d}}`,
  `@keyframes pu-stare{0%,${up(CISZA)}{opacity:1}${up(CISZA + 0.35)}{opacity:0}${up(PU_GASNIE)}{opacity:0}100%{opacity:1}}`,
  `@keyframes pu-nowe{0%,${up(CISZA + 0.2)}{opacity:0}${up(CISZA + 0.6)}{opacity:1}${up(PU_GASNIE)}{opacity:1}100%{opacity:0}}`,
  `@keyframes pu-kropka{0%,${up(CISZA)}{background:var(--la-accent,#00CD77);transform:scale(1)}${up(CISZA + 0.25)}{background:#d99a3c;transform:scale(1.5)}${up(CISZA + 0.5)}{background:#d99a3c;transform:scale(1)}${up(PU_GASNIE)}{background:#d99a3c;transform:scale(1)}100%{background:var(--la-accent,#00CD77);transform:scale(1)}}`,
  `@keyframes pu-alarm{0%,${up(ALARM)}{opacity:0;transform:translateY(-4px)}${up(ALARM + 0.45)}{opacity:1;transform:translateY(0)}${up(PU_GASNIE)}{opacity:1;transform:translateY(0)}${up(PU_GASNIE + 0.6)}{opacity:0;transform:translateY(-4px)}100%{opacity:0;transform:translateY(-4px)}}`,
  `@keyframes pu-pod{0%,${up(ALARM + 0.6)}{opacity:0}${up(ALARM + 1.2)}{opacity:1}${up(PU_GASNIE)}{opacity:1}${up(PU_GASNIE + 0.6)}{opacity:0}100%{opacity:0}}`,
].join('\n');


// ---- CO ŁĄCZYMY (kolumna przy definicji) --------------------------------
const POLACZENIA = [
  { t: 'Faktury kosztowe z poczty do ERP', d: 'bez przepisywania pozycji i kwot' },
  { t: 'Zamówienia ze sklepu i portalu do produkcji', d: 'razem z terminem i rezerwacją materiału' },
  { t: 'Nowy klient z CRM do księgowości i magazynu', d: 'jeden komplet danych, jeden raz' },
  { t: 'Stany i ceny z ERP do sklepu i cenników', d: 'co godzinę albo przy każdej zmianie' },
  { t: 'Dokumenty z systemu na dysk i do archiwum', d: 'nazwane tak, żeby dało się je znaleźć' },
];


// ---- DLACZEGO AUTOMATYZACJE CICHO UMIERAJĄ ------------------------------
const POWODY = [
  {
    t: 'Nikt nie jest ich właścicielem',
    d: 'Powstały przy okazji, w narzędziu, do którego dostęp ma jedna osoba. Ta osoba zmieniła stanowisko albo firmę, a scenariusze zostały — bez nazwy, bez opisu i bez nikogo, kto miałby je sprawdzać.',
  },
  {
    t: 'Zmiana po drugiej stronie nie daje znać',
    d: 'Dostawca dodał pole w formularzu, ktoś przemianował kolumnę w arkuszu, wygasł token dostępowy. Połączenie przestaje działać w sposób, który niczego nikomu nie wyświetla.',
  },
  {
    t: 'Sukces i awaria wyglądają identycznie',
    d: 'Jedyną różnicą między działającą a martwą automatyzacją jest to, czego nie ma w systemie docelowym. Nikt nie sprawdza codziennie, czy czegoś nie brakuje — i właśnie dlatego znajduje się to przy zamknięciu miesiąca.',
  },
];


// ---- KARTA AUTOMATYZACJI (ciemny pas) -----------------------------------
// Artefakt, nie wykres. Świadomie pokazany w całości: to jest dokładnie to,
// co klient dostaje przy każdym połączeniu, więc może go ocenić przed wyceną.
const KARTA = [
  { k: 'Co ją uruchamia', v: 'Nowa wiadomość na skrzynce faktury@' },
  { k: 'Co robi', v: 'Odczytuje dane z załącznika i tworzy w ERP dokument dopasowany do zamówienia' },
  { k: 'Wolumen', v: 'Około 1 200 dokumentów miesięcznie' },
  { k: 'Przy błędzie', v: 'Trzy próby co pięć minut, potem sprawa wraca do skrzynki z etykietą', wazne: true },
  { k: 'Alarm', v: 'Wiadomość i kanał na Slacku po ośmiu minutach ciszy', wazne: true },
  { k: 'Właściciel', v: 'Kierownik księgowości, imiennie', wazne: true },
  { k: 'Stoi na', v: 'n8n na Waszej infrastrukturze' },
  { k: 'Koszt utrzymania', v: 'Licencja platformy, bez naszej opłaty abonamentowej' },
];


// ---- DLA JAKICH FIRM ----------------------------------------------------
const DLA_KOGO = [
  {
    t: 'Te same dane wpisujecie w dwóch miejscach',
    d: 'Zamówienie w CRM i w ERP, klient w systemie i w arkuszu, dane przesyłki w panelu kuriera i w mailu do klienta. Każde przepisanie to miejsce, w którym da się pomylić cyfrę.',
  },
  {
    t: 'Ktoś ma w kalendarzu stały punkt „eksport i wysyłka"',
    d: 'Raport dla zarządu, zestawienie dla księgowej, plik z zamówieniami dla magazynu. Praca, o której nikt nie mówi, bo zajmuje tylko dwadzieścia minut dziennie.',
  },
  {
    t: 'Macie systemy, które nie rozmawiają, i nie zamierzacie ich wymieniać',
    d: 'Integracja jest tańsza od wymiany i szybsza o rok. Przy okazji pokazuje, czy wymiana w ogóle jest potrzebna.',
  },
  {
    t: 'Chcecie sprawdzić, czy warto iść dalej',
    d: 'Pierwsze połączenie idzie na produkcję w kilka dni i po miesiącu wiadomo, ile pracy naprawdę z Was zdjęło. Dopiero na tej podstawie warto decydować o systemie prowadzącym cały proces.',
  },
];
const NIE_TERAZ = [
  'Chodzi o jedno połączenie, a u Was jest ktoś, kto umie kliknąć scenariusz w Make’u. Wtedy zróbcie to sami — chętnie powiemy, na co uważać.',
  'Rzecz dzieje się raz w miesiącu i zajmuje kwadrans. Automatyzacja kosztuje wtedy więcej niż ten kwadrans przez najbliższy rok.',
  'Któryś z systemów po drodze wymieniacie w tym roku. Połączenie do systemu, który za kwartał wypada, jest pracą do wyrzucenia.',
];


// ---- PRZYKŁADY ----------------------------------------------------------
// PRZYKŁADOWE wdrożenia — do podmiany. Druga liczba jest tu ważniejsza od
// pierwszej: pokazuje, że rzeczy się psują i że o tym wiadomo.
const PRZYKLADY = [
  {
    f: 'Dystrybutor części', m: '9 połączeń', p: 'Zamówienia, faktury i stany',
    d: 'Zamówienia z trzech kanałów wpadają do jednego rejestru, faktury kosztowe księgują się same, a stany jadą do sklepu co godzinę.',
    ile: '5 800 dokumentów miesięcznie', alarmy: '4 alarmy w kwartale, każdy zamknięty tego samego dnia',
  },
  {
    f: 'Producent mebli', m: '4 połączenia', p: 'Od zamówienia do produkcji',
    d: 'Zamówienie z portalu trafia do planowania razem z rezerwacją materiału, a zmiana terminu wraca do klienta bez udziału handlowca.',
    ile: '760 zleceń miesięcznie', alarmy: '1 alarm w kwartale, przyczyną była zmiana po stronie dostawcy',
  },
  {
    f: 'Sieć gabinetów', m: '6 połączeń', p: 'Rejestracja, rozliczenia i raporty',
    d: 'Wizyty z rejestracji online lądują w grafiku i w rozliczeniach, a raport dla zarządu składa się sam w poniedziałek rano.',
    ile: '11 400 wizyt miesięcznie', alarmy: '2 alarmy w kwartale, oba przy wygaśnięciu tokenu',
  },
];


const faq = [
  {
    q: 'Czym to się różni od Make’a albo Zapiera, które nasz człowiek sam sklika?',
    a: 'Niczym, jeśli chodzi o jedno połączenie i macie kogoś, kto to zrobi — wtedy zróbcie to sami, a my chętnie powiemy, na co uważać. Różnica zaczyna się przy kilku połączeniach naraz. Wtedy liczy się to, czy ktoś zauważy awarię, czy przy zmianie po drugiej stronie wiadomo, co jeszcze się posypie, i czy da się to przekazać nowej osobie. Sam scenariusz jest najprostszą częścią tej pracy.',
  },
  {
    q: 'Ile kosztują automatyzacje i integracje?',
    a: 'Wyceniamy połączenie po połączeniu, a kwota jest stała i podawana po rozmowie, na której wypisujemy, co z czym i jak często. O kwocie rozstrzyga przede wszystkim to, czy systemy mają API. Dalej idzie liczba wyjątków, które połączenie ma obsłużyć, i to, czy dane wymagają uporządkowania po drodze. Pierwsze połączenie zwykle zwraca się w kilka tygodni.',
  },
  {
    q: 'Co się dzieje, kiedy automatyzacja wywali się w nocy?',
    a: 'Najpierw trzy próby w odstępach kilku minut, bo większość awarii to chwilowa niedostępność drugiej strony. Jeśli nie pomogą, sprawa wraca tam, skąd przyszła, z etykietą, żeby człowiek mógł ją dokończyć ręcznie. Równolegle idzie alarm do imiennie wskazanej osoby po Waszej stronie i do nas. Zachowanie przy błędzie jest zapisane w karcie połączenia, więc nie jest przedmiotem domysłów.',
  },
  {
    q: 'Nasze systemy nie mają API. Da się coś zrobić?',
    a: 'Zwykle tak, tylko drożej w utrzymaniu i o tym mówimy przed wyceną. Kolejność wygląda tak: API, jeśli jest; wymiana plików w uzgodnionym formacie, jeśli system ją umie; odczyt bezpośrednio z bazy po ustaleniu z Waszym IT. Ostatnią drogą jest sterowanie interfejsem, ale wtedy uprzedzamy, że każda aktualizacja dostawcy może to zepsuć.',
  },
  {
    q: 'Czy nie zrobimy sobie plątaniny, której za rok nikt nie ogarnie?',
    a: 'Przed tym broni karta przy każdym połączeniu i jedno miejsce, w którym stoją wszystkie. Widać z niej, co skąd bierze dane i kto za to odpowiada, więc przy zmianie w jednym systemie wiadomo, co jeszcze trzeba sprawdzić. Kartę aktualizujemy przy każdej zmianie połączenia i numer wersji stoi na jej górze.',
  },
  {
    q: 'Na czym to budujecie?',
    a: 'Na platformie automatyzacji tam, gdzie liczy się to, żeby zmiana zajmowała kwadrans, i we własnym kodzie tam, gdzie połączenie dotyka reguł albo dużego wolumenu. Platformę stawiamy najczęściej na Waszej infrastrukturze, żeby dane nie wychodziły na zewnątrz i żeby licencja była Wasza. Nie mamy prowizji od żadnego dostawcy.',
  },
  {
    q: 'Ile to trwa?',
    a: 'Proste połączenie między systemami z API to zwykle kilka dni. Takie, które wymaga uporządkowania danych po drodze albo obsługi wyjątków, to dwa do czterech tygodni. Zaczynamy od jednego, uruchamiamy je na produkcji i dopiero potem bierzemy następne — także dlatego, że pierwsze zwykle zmienia listę kolejnych.',
  },
  {
    q: 'Kto to utrzymuje?',
    a: 'Scenariusze, dokumentacja i dostęp do platformy są Wasze od pierwszego dnia, więc utrzymanie może przejąć Wasz zespół. Jeśli utrzymujemy my, umowa obejmuje monitoring, reakcję na alarmy i poprawki po zmianach u dostawców — bo to one psują połączenia najczęściej. Umowa jest osobna od budowy i wypowiadalna z miesięcznym terminem.',
  },
  {
    q: 'Mamy trzydzieści pomysłów. Od czego zacząć?',
    a: 'Od tego, które przepisywanie zdarza się najczęściej i kosztuje najwięcej przy pomyłce. Na pierwszej rozmowie przechodzimy listę i wskazujemy jedną pozycję, plus te, które odradzamy jako zbyt rzadkie. Jeśli okaże się, że pomysłów jest kilkanaście i nikt nie umie ich uszeregować, właściwą usługą jest <a href="/strategia-ai" style="font-weight:700;color:#0a7a52">strategia transformacji AI</a>, a nie kolejne połączenie.',
  },
  {
    q: 'Czym to się różni od systemu dla kluczowego procesu?',
    a: 'Skalą i tym, gdzie leży stan sprawy. Integracja przenosi dane między systemami, które już macie, i nie zmienia sposobu pracy. <a href="/systemy-procesowe" style="font-weight:700;color:#0a7a52">System dla kluczowego procesu</a> prowadzi sprawę od początku do końca i sam trzyma jej stan. Automatyzacje są tańszym wejściem i często pierwszym krokiem — a bywają też ostatnim, jeśli okaże się, że wystarczą.',
  },
];
dane['@graph'].push({
  '@type': 'FAQPage',
  '@id': `${kanon}#faq`,
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
  })),
});
---
<LaBase title={title} description={description} ctaHref="#kontakt" ctaLabel="Umów rozmowę" nav="uslugi">
<script type="application/ld+json" is:inline set:html={JSON.stringify(dane)} slot="head"></script>
<style is:global slot="head">
  /* ================= puls (hero) =================
     Cztery automatyzacje, każda z własnym odstępem między przebiegami.
     Wszystkie kreski dzielą jedną klatkę i różnią się wyłącznie opóźnieniem,
     więc przy równym czasie cyklu układ powtarza się bez rozjazdu.
     Trzecia linia po prostu przestaje pulsować — i to jest cały argument
     strony, pokazany zamiast opisany. */
  .pu-gora{display:flex;align-items:baseline;justify-content:space-between;gap:16px;padding-bottom:11px;border-bottom:1px solid #e7ece4}
  .pu-gora b{font-size:13px;font-weight:700;color:#16211a}
  .pu-gora span{font-family:ui-monospace,Menlo,monospace;font-size:11px;color:#a9b3aa}
  .pu-row{padding:14px 0;border-bottom:1px solid #f0f3ee}
  .pu-t{display:flex;align-items:baseline;justify-content:space-between;gap:14px}
  .pu-t b{font-size:14px;font-weight:650;color:#16211a}
  .pu-st{display:inline-flex;align-items:center;gap:7px;flex-shrink:0;font-family:ui-monospace,Menlo,monospace;font-size:11.5px;color:#8b968d}
  .pu-kropka{display:block;width:7px;height:7px;border-radius:50%;background:var(--la-accent,#00CD77)}
  /* Dwa stany statusu leżą na sobie, żeby wiersz nie skakał przy zmianie. */
  .pu-zmiana{display:grid}
  .pu-zmiana em{grid-area:1/1;font-style:normal;white-space:nowrap}
  .pu-pas{display:flex;align-items:flex-end;gap:5px;height:20px;margin-top:10px}
  .pu-tik{flex:0 0 6px;height:100%;border-radius:2px;background:#2ecf8b;opacity:0;transform-origin:bottom}
  /* Brakujące przebiegi pojawiają się dopiero w chwili ciszy — wcześniej
     zdradzałyby pointę, zanim linia zdąży zamilknąć. */
  .pu-tik.pusty{flex:0 0 6px;height:6px;border-radius:2px;background:#e8c99a;opacity:0}
  .pu-alarm{display:inline-flex;align-items:center;gap:8px;margin-top:11px;padding:7px 12px;border-radius:8px;background:#fdf3e4;font-size:12.5px;font-weight:650;color:#b07524;opacity:0}
  .pu-alarm svg{flex-shrink:0}
  .pu-pod{margin:clamp(16px,2vw,22px) 0 0;font-size:14.5px;line-height:1.6;color:#4c5850;max-width:540px;text-wrap:pretty;opacity:0}
  .pu-pod strong{font-weight:700;color:#16211a}
  @media (max-width:560px){
    .pu-t{flex-direction:column;gap:5px}
    .pu-t b{font-size:13px}
    .pu-pas{height:17px}
  }
  @media (prefers-reduced-motion:reduce){
    .pu-tik,.pu-alarm,.pu-pod,.pu-kropka,.pu-st,.pu-zmiana em{animation:none !important;opacity:1}
    .pu-tik.pusty{opacity:1}
    /* Bez ruchu zostaje stan po awarii — to on niesie argument. */
    .pu-row.pada .pu-kropka{background:#d99a3c}
    .pu-row.pada .pu-st{color:#b07524}
    .pu-zmiana em{opacity:0}
    .pu-zmiana em.nowe{opacity:1}
  }

  /* ================= co łączymy (kolumna przy definicji) ================= */
  .pl-h{margin:0 0 4px;font-size:15.5px;font-weight:750;letter-spacing:-0.01em;color:#16211a}
  .pl-row{padding:12px 0;border-top:1px solid #e4ebe2}
  .pl-row:last-of-type{border-bottom:1px solid #e4ebe2}
  .pl-t{display:block;font-size:14.5px;font-weight:700;letter-spacing:-0.01em;line-height:1.3;color:#16211a;text-wrap:balance}
  .pl-d{display:block;margin-top:3px;font-size:12.5px;color:#8b968d}
  .pl-nota{margin:13px 0 0;font-size:13px;line-height:1.55;color:#8b968d;text-wrap:pretty}

  /* ================= powody ================= */
  .pw-row{display:grid;grid-template-columns:minmax(0,0.95fr) minmax(0,1.15fr);gap:clamp(18px,3vw,48px);align-items:baseline;padding:clamp(20px,2.4vw,28px) 0;border-top:1px solid #e2e9e0}
  .pw-row:last-of-type{border-bottom:1px solid #e2e9e0}
  .pw-t{margin:0;font-size:clamp(17px,2vw,20px);font-weight:750;letter-spacing:-0.015em;line-height:1.3;color:#16211a;text-wrap:balance}
  .pw-d{margin:0;font-size:15px;line-height:1.6;color:#4c5850;text-wrap:pretty}
  @media (max-width:760px){ .pw-row{grid-template-columns:1fr;gap:7px} }

  /* ================= karta automatyzacji (ciemny pas) =================
     Artefakt, nie wykres — na tej stronie drugi nośnik jest celowo z innego
     gatunku niż hero. Pokazana w całości, bo to jest dokładnie to, co klient
