// ---- HERO · POŁĄCZENIA NA ŻYWO -------------------------------------------
// Ostatnia godzina u dystrybutora części, 9:45–10:45. Czas w minutach od
// północy. Każdy przebieg to kreska na wspólnej osi; skrypt odsłania je od
// LN_START w tempie jednej minuty na 330 ms (wszystkie czasy biorą się
// z data-t w znacznikach). Stan w HTML to stan końcowy: przerwa, alarm
// i powrót są widoczne bez JS i przy ograniczonym ruchu.
let ziarno = 11;
const los = () => { ziarno = (ziarno * 16807) % 2147483647; return (ziarno - 1) / 2147483646; };
const LN_OD = 9 * 60 + 45, LN_DO = 10 * 60 + 45, LN_START = 9 * 60 + 58;
const LN_STOP = 10 * 60 + 12, LN_ALARM = LN_STOP + 8, LN_PRZEJ = 10 * 60 + 23, LN_WRACA = 10 * 60 + 41;
const lnX = (t: number) => ((t - LN_OD) / (LN_DO - LN_OD) * 100).toFixed(2) + '%';
const lnW = (d: number) => (d / (LN_DO - LN_OD) * 100).toFixed(2) + '%';
const hhmm = (t: number) => `${Math.floor(t / 60)}:${String(Math.floor(t % 60)).padStart(2, '0')}`;
const rytm = (od: number, krok: number, rozrzut: number) => {
  const o: number[] = [];
  for (let t = od; t < LN_DO - 0.3; t += krok) o.push(+Math.min(LN_DO - 0.2, Math.max(LN_OD + 0.2, t + (los() - 0.5) * rozrzut)).toFixed(2));
  return o;
};
