  .ka{display:grid;grid-template-columns:minmax(0,1fr) minmax(300px,0.92fr);gap:clamp(30px,5vw,72px);align-items:start;margin-top:clamp(30px,3.6vw,44px)}
  .ka-dok{background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.16);border-radius:16px;overflow:hidden}
  .ka-gora{display:flex;align-items:baseline;justify-content:space-between;gap:12px;padding:15px 18px;border-bottom:1px solid rgba(255,255,255,0.12);background:rgba(255,255,255,0.04)}
  .ka-gora b{font-size:12.5px;font-weight:750;letter-spacing:0.02em;color:rgba(255,255,255,0.6)}
  .ka-gora span{font-family:ui-monospace,Menlo,monospace;font-size:11px;color:rgba(255,255,255,0.35)}
