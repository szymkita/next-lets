    <div class="cs-m"><span class="cs-pol"></span></div>
    <div class="cs-c r"><em>{x.k}</em><b>{x.n}</b></div>
  </div>
))}
<div class="cs-przerwa" data-cs-k data-ms="1100" aria-hidden="true"><i><svg viewBox="0 0 16 16" set:html={ik('key')}></svg></i><b>4.09, 16:40</b>wygasa token programu księgowego</div>
{CS_PO.map((x: any, i) => (
  <div class={`cs-w${i === 0 ? ' g' : ''}${i === CS_PO.length - 1 ? ' d' : ''}`} data-cs-k data-dni={x.dni} data-ms={x.reszta ? '900' : '620'} aria-hidden="true">
