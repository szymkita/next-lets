<GcFaq
  heading="Pytania, które padają przed decyzją"
  ctaLabel="Zadajcie nam swoje →"
  items={faq}
/>

<script>
  var redukcja = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var jestIO = 'IntersectionObserver' in window;
  function czekaj(ms: number){ return new Promise(function(r){ setTimeout(r, ms); }); }

  // ---- Hero: połączenia na żywo ----
  // Zegar symulowany: jedna minuta = 330 ms. Wszystko, co ma data-t
  // (przebiegi, klamra alarmu, wpisy w dzienniku), pojawia się, kiedy zegar
  // dojdzie do jego minuty. Kreskowana cisza rośnie od 10:12 do powrotu,
  // stan połączenia liczy minuty ciszy. Na końcu godziny stan końcowy stoi
  // siedem sekund, potem pętla wraca do 9:58. Stoi, kiedy tablicy nie widać.
  (function(){
    var fig = document.querySelector('[data-ln]') as HTMLElement | null;
    if(!fig || redukcja) return;
    var f = fig;
    var OD = +f.dataset.od!, DO = +f.dataset.do!, START = +f.dataset.start!;
    var STOP = +f.dataset.stop!, ALARM = +f.dataset.alarm!, WRACA = +f.dataset.wraca!;
    var MS = 330, TRZYMAJ = 7000;
    var el = Array.prototype.slice.call(f.querySelectorAll('[data-t]')).map(function(e: HTMLElement){
      return { e: e, t: +e.dataset.t!, p: e.dataset.p || '', w: e.closest('[data-ln-w]') as HTMLElement | null };
    }).sort(function(a: any, b: any){ return a.t - b.t; });
    var zegar = f.querySelector('[data-zegar]') as HTMLElement;
    var cz = f.querySelector('[data-ln-cz]') as HTMLElement;
    var st = f.querySelector('[data-ln-st]') as HTMLElement;
    var stT = st.querySelector('[data-st-t]') as HTMLElement;
    var stS = st.querySelector('[data-st-s]') as HTMLElement;
    var stPrzed = stS.dataset.przed || '';
    function hh(t: number){ var h = Math.floor(t / 60), m = Math.floor(t % 60); return h + ':' + (m < 10 ? '0' : '') + m; }
    var t = START, i = 0, faza = 'gra', licz = 0, widoczny = true, pop: number | null = null, ostM = -1, ostStan = '';
    function ost(x: any){
      if(!x.p || !x.w) return;
      var o = x.w.querySelector('[data-ost]');
      if(o) o.textContent = x.p + ' · ' + hh(x.t);
    }
    function stan(){
      var c = Math.floor(t - STOP), k, a, b;
      if(t < STOP + 2){ k = ''; a = 'działa'; b = stPrzed; }
      else if(t < ALARM){ k = 'uw'; a = 'cisza ' + c + ' min'; b = 'ostatni ' + hh(STOP); }
      else if(t < WRACA){ k = 'uw'; a = 'alarm wysłany'; b = 'cisza ' + c + ' min'; }
      else { k = ''; a = 'działa'; b = 'przerwa ' + hh(STOP) + '–' + hh(WRACA); }
      var klucz = k + a + b;
      if(klucz === ostStan) return;
      ostStan = klucz;
      st.className = k ? 'ln-st ' + k : 'ln-st';
      stT.textContent = a; stS.textContent = b;
    }
    function szer(){ var w = Math.max(0, Math.min(t, WRACA - 0.2) - STOP - 0.2); cz.style.width = (w / (DO - OD) * 100) + '%'; }
    function zeruj(){
      t = START; i = 0; ostM = -1; ostStan = '';
      el.forEach(function(x: any){ x.e.classList.remove('nowy'); x.e.classList.add('ukr'); });
      while(i < el.length && el[i].t <= t){ el[i].e.classList.remove('ukr'); ost(el[i]); i++; }
      zegar.textContent = hh(t); stan(); szer();
      f.classList.remove('gasnie');
    }
    function klatka(ts: number){
      if(pop === null) pop = ts;
      var dt = Math.min(ts - pop, 100); pop = ts;
      if(widoczny){
        if(faza === 'gra'){
          t = Math.min(DO, t + dt / MS);
          while(i < el.length && el[i].t <= t){
            var x = el[i++];
            x.e.classList.remove('ukr');
            if(x.e.classList.contains('ln-zd')) x.e.classList.add('nowy');
            ost(x);
          }
          var m = Math.floor(t);
          if(m !== ostM){ ostM = m; zegar.textContent = hh(t); }
          stan(); szer();
          if(t >= DO){ faza = 'trzyma'; licz = TRZYMAJ; }
        } else if(faza === 'trzyma'){
          licz -= dt;
          if(licz <= 0){ faza = 'gasnie'; licz = 500; f.classList.add('gasnie'); }
        } else {
          licz -= dt;
          if(licz <= 0){ zeruj(); faza = 'gra'; }
        }
      }
      requestAnimationFrame(klatka);
    }
    f.classList.add('ruch');
    zeruj();
    if(jestIO) new IntersectionObserver(function(w){ widoczny = w[0].isIntersecting; }, { threshold: 0.05 }).observe(f);
    requestAnimationFrame(klatka);
  })();

  // ---- Dlaczego 1: zamek ----
  // Wiersze wypełniają się po kolei; licznik „Nikt nie wie od" bierze dni
  // z data-dni wiersza. Raz po wejściu w kadr, potem przycisk powtórki.
  (function(){
    var fig = document.querySelector('[data-cs]') as HTMLElement | null;
    if(!fig || redukcja || !jestIO) return;
    var f = fig;
    var kroki = Array.prototype.slice.call(f.querySelectorAll('[data-cs-k]')) as HTMLElement[];
    var licz = f.querySelector('[data-cs-licz]') as HTMLElement;
    var znow = f.querySelector('[data-cs-znow]') as HTMLButtonElement;
    var bieg = 0;
    function ustaw(n: number, tik?: boolean){
      licz.textContent = n === 1 ? '1 dzień' : n + ' dni';
      if(tik){ licz.classList.remove('tik'); void licz.offsetWidth; licz.classList.add('tik'); }
    }
    function zeruj(){ kroki.forEach(function(k){ k.classList.remove('on'); }); ustaw(0); }
    async function graj(){
      var nr = ++bieg;
      zeruj(); znow.disabled = true;
      await czekaj(500); if(nr !== bieg) return;
      for(var j = 0; j < kroki.length; j++){
        kroki[j].classList.add('on');
        var d = kroki[j].dataset.dni;
        if(d) ustaw(+d, true);
        await czekaj(+(kroki[j].dataset.ms || 650)); if(nr !== bieg) return;
      }
      znow.disabled = false;
    }
    f.classList.add('ruch');
    zeruj();
    znow.addEventListener('click', graj);
    var io = new IntersectionObserver(function(w){ if(w[0].isIntersecting){ io.disconnect(); graj(); } }, { threshold: 0.35 });
    io.observe(f);
  })();

  // ---- Dlaczego 2: powiadomienie donikąd ----
  // Trzy błędy w logu, scenariusz się wyłącza, koperta jedzie na skrzynkę,
  // skrzynka odrzuca, zwrot wraca na no-reply. Elementy z data-pw-k
  // pojawiają się w kolejności numerów.
  (function(){
    var fig = document.querySelector('[data-pw]') as HTMLElement | null;
    if(!fig || redukcja || !jestIO) return;
    var f = fig;
    var kroki = Array.prototype.slice.call(f.querySelectorAll('[data-pw-k]')) as HTMLElement[];
    var wiersz = f.querySelector('[data-pw-sc]') as HTMLElement;
    var skr = f.querySelector('[data-pw-skr]') as HTMLElement;
    var znow = f.querySelector('[data-pw-znow]') as HTMLButtonElement;
    var bieg = 0;
    function pokaz(n: number){ kroki.forEach(function(k){ if(+k.dataset.pwK! === n) k.classList.add('on'); }); }
    function blysk(){ wiersz.classList.remove('blysk'); void wiersz.offsetWidth; wiersz.classList.add('blysk'); }
    function zeruj(){ kroki.forEach(function(k){ k.classList.remove('on'); }); f.classList.remove('wyl'); skr.classList.remove('uderz'); }
    var PLAN: [number, () => void][] = [
      [700, function(){ pokaz(1); blysk(); }],
      [850, function(){ pokaz(2); blysk(); }],
      [850, function(){ pokaz(3); blysk(); f.classList.add('wyl'); }],
      [800, function(){ pokaz(4); }],
      [1300, function(){ pokaz(5); skr.classList.add('uderz'); }],
      [700, function(){ pokaz(6); }],
      [1300, function(){ pokaz(7); }],
    ];
    async function graj(){
      var nr = ++bieg;
      zeruj(); znow.disabled = true;
      for(var j = 0; j < PLAN.length; j++){
        await czekaj(PLAN[j][0]); if(nr !== bieg) return;
        PLAN[j][1]();
      }
      znow.disabled = false;
    }
    f.classList.add('ruch');
    zeruj();
    znow.addEventListener('click', graj);
    var io = new IntersectionObserver(function(w){ if(w[0].isIntersecting){ io.disconnect(); graj(); } }, { threshold: 0.35 });
    io.observe(f);
  })();

  // ---- Zakładki: karta, alarm, rejestr ----
  (function(){
    var zak = Array.prototype.slice.call(document.querySelectorAll('[data-zak]')) as HTMLElement[];
    if(!zak.length) return;
    var widoki = Array.prototype.slice.call(document.querySelectorAll('[data-widok]')) as HTMLElement[];
    var podpisy = Array.prototype.slice.call(document.querySelectorAll('[data-podpis]')) as HTMLElement[];
    function pokaz(i: number, fokus?: boolean){
      zak.forEach(function(b, j){ b.setAttribute('aria-selected', i === j ? 'true' : 'false'); b.tabIndex = i === j ? 0 : -1; });
      widoki.forEach(function(w, j){ w.hidden = i !== j; });
      podpisy.forEach(function(p, j){ p.hidden = i !== j; });
      if(fokus) zak[i].focus();
    }
    zak.forEach(function(b, i){
      b.addEventListener('click', function(){ pokaz(i); });
      b.addEventListener('keydown', function(e){
        if(e.key === 'ArrowRight'){ e.preventDefault(); pokaz((i + 1) % zak.length, true); }
        if(e.key === 'ArrowLeft'){ e.preventDefault(); pokaz((i - 1 + zak.length) % zak.length, true); }
      });
    });
  })();
</script>
