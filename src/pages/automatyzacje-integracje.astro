  .dl-nie{margin:clamp(32px,3.8vw,48px) 0 0 clamp(0px,4vw,64px);padding-left:clamp(18px,2vw,26px);border-left:2px solid #dde7db;max-width:760px}
  .dl-nie h3{margin:0;font-size:15.5px;font-weight:750;letter-spacing:-0.01em;color:#4c5850}
  .dl-nie p{margin:10px 0 0;font-size:14.5px;line-height:1.6;color:#8b968d;text-wrap:pretty}
  @media (max-width:860px){
    .dl-row{grid-template-columns:34px minmax(0,1fr);gap:12px 14px}
    .dl-row > p:last-child{grid-column:2}
  }

  /* ================= pas wezwania ================= */
  .ps{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:18px 40px;padding:clamp(26px,3vw,36px) 0;border-top:1px solid #e7ece4;border-bottom:1px solid #e7ece4}
  .ps p{margin:0;max-width:640px;font-size:clamp(18px,2.2vw,24px);line-height:1.35;letter-spacing:-0.018em;font-weight:700;color:#16211a;text-wrap:pretty}

  /* ================= przykłady =================
     Druga liczba jest ważniejsza od pierwszej: pokazuje, że rzeczy się psują
     i że o tym wiadomo. Dlatego stoi w tej samej kolumnie, nie w przypisie. */
  .px-row{display:grid;grid-template-columns:minmax(190px,0.6fr) minmax(0,1.2fr) minmax(210px,0.8fr);gap:clamp(20px,3.2vw,52px);align-items:start;padding:clamp(26px,3.2vw,40px) 0;border-top:1px solid #dde7db}
  .px-row:last-of-type{border-bottom:1px solid #dde7db}
  .px-f{display:block;margin:0;font-size:clamp(18px,2.1vw,22px);font-weight:750;letter-spacing:-0.018em;color:#16211a}
  .px-m{display:block;margin-top:4px;font-size:13.5px;color:#8b968d}
  .px-p{display:block;margin-top:14px;font-size:14px;font-weight:700;color:#0a7a52}
  .px-d{margin:0;font-size:15px;line-height:1.6;color:#16211a;text-wrap:pretty}
  .px-ile{display:block;font-size:clamp(17px,2vw,20px);font-weight:750;letter-spacing:-0.015em;color:#16211a}
  .px-cap{display:block;margin-top:4px;font-size:12.5px;color:#a0aba1}
  .px-al{display:flex;align-items:flex-start;gap:9px;margin-top:16px;padding-top:14px;border-top:1px solid #dde7db;font-size:13.5px;line-height:1.5;color:#4c5850}
  .px-al i{flex-shrink:0;display:block;width:7px;height:7px;margin-top:6px;border-radius:50%;background:#d99a3c}
  @media (max-width:1000px){
