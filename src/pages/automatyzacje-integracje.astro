<div class="cs-w cs-n g" aria-hidden="true">
<div class="cs-c l"><i style={`background:${KOLOR['CRM']}`}></i><b>CRM</b><span>etap „Klient”</span></div>
<div class="cs-m"><span>połączenie</span></div>
<div class="cs-c r"><i style={`background:${KOLOR['Program księgowy']}`}></i><b>Program księgowy</b><span>kontrahenci</span></div>
</div>
{CS_PRZED.map((x, i) => (
  <div class={i === CS_PRZED.length - 1 ? 'cs-w d' : 'cs-w'} data-cs-k data-ms="420" aria-hidden="true">
