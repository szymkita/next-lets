<script is:inline>
/* MAPA CZYNNOŚCI v6 · ruch rysunków. Każdy rysunek to „odtwarzacz” z czasem w sekundach: gra, kiedy jest
   w kadrze, stoi poza kadrem, przy ograniczonym ruchu od razu pokazuje stan końcowy. Układ makiet jest stały:
   zmienia się tylko tekst, przezroczystość i położenie kursorów. ?t=<s> zatrzymuje wszystko w danej chwili (zrzuty). */
(()=>{
const $=(s,r=document)=>r.querySelector(s), $$=(s,r=document)=>[...r.querySelectorAll(s)];
const qs=new URLSearchParams(location.search), STOP=qs.has('t')?parseFloat(qs.get('t')):null;
const RED=matchMedia('(prefers-reduced-motion: reduce)').matches;
const cl=(x,a=0,b=1)=>x<a?a:x>b?b:x, seg=(t,a,b)=>cl((t-a)/(b-a)), ez=t=>t*t*(3-2*t), lerp=(a,b,t)=>a+(b-a)*t;
const OS={ania:'#d6336c',marek:'#6d4aff',kasia:'#e8590c',pawel:'#1c7ed6',tomek:'#0b8a7c',ai:'#0f1a14'};
const IM={ania:'Ania',marek:'Marek',kasia:'Kasia',pawel:'Paweł',tomek:'Tomek',ai:'AI · Mapa czynności'};
const STRZ='<svg viewBox="0 0 16 20"><path d="M1 1v15.5l4.2-3.9 2.7 6.1 2.6-1.2-2.7-6h5.9z"/></svg>';

/* ── tekst, geometria, kursory ── */
const cv=document.createElement('canvas').getContext('2d'), fonty=new WeakMap();
function szer(el,t){let f=fonty.get(el);if(!f){const s=getComputedStyle(el);f=`${s.fontStyle} ${s.fontWeight} ${s.fontSize} ${s.fontFamily}`;fonty.set(el,f);}cv.font=f;return cv.measureText(t).width;}
let geoC=new Map();
function geo(el,root){let g=geoC.get(el);if(g)return g;let x=0,y=0,e=el;while(e&&e!==root){x+=e.offsetLeft;y+=e.offsetTop;e=e.offsetParent;}
  const s=getComputedStyle(el);g={x,y,w:el.offsetWidth,h:el.offsetHeight,pl:parseFloat(s.paddingLeft)||0,pr:parseFloat(s.paddingRight)||0,mn:el.classList.contains('mn')};geoC.set(el,g);return g;}
function tekst(el,t){if(el._t!==t){el.textContent=t;el._t=t;}}
function klasa(el,k,on){if(!!el['_'+k]!==on){el.classList.toggle(k,on);el['_'+k]=on;}}
function kursor(root,kto){const k=document.createElement('span');k.className='mc-k';k.style.setProperty('--c',OS[kto]);k.innerHTML=STRZ+'<em>'+IM[kto]+'</em>';root.appendChild(k);return{el:k,root,x:-1,y:-1,o:-1,l:null};}
function stawK(k,x,y,o){const l=x>k.root.offsetWidth-110;if(l!==k.l){k.el.classList.toggle('lewo',l);k.l=l;}
  if(Math.abs(k.x-x)>.15||Math.abs(k.y-y)>.15){k.el.style.transform=`translate3d(${x.toFixed(1)}px,${y.toFixed(1)}px,0)`;k.x=x;k.y=y;}
  o=cl(o);if(Math.abs(k.o-o)>.004){k.el.style.opacity=o.toFixed(3);k.o=o;}}
function punkt(el,root,txt,klik){const g=geo(el,root);if(klik)return[g.x+Math.min(g.w*.45,60),g.y+g.h*.55];
  const wolne=el.classList.contains('t')?1e4:g.w-g.pl-g.pr-2;
  const x=g.mn?g.x+g.w-g.pr:g.x+g.pl+Math.min(szer(el,txt),wolne);return[x+1,g.y+g.h*.5-2];}

/* ── wpisywanie: zadania {kto, el, tekst, a, b (sekundy), klik, el2 (pokaż też tu, np. pasek formuły)} ── */
function silnik(root,zad,{ruch=.45,widoczny={}}={}){
  const ksy={};zad.forEach(z=>{z.dl=z.tekst?z.tekst.length:0;if(!ksy[z.kto])ksy[z.kto]=kursor(root,z.kto);});
  const wpis=(z,t)=>z.klik?null:(t<z.a?'':z.tekst.slice(0,Math.round(z.dl*seg(t,z.a,z.b))));
  return t=>{
    for(const z of zad){const w=wpis(z,t);if(w!=null){tekst(z.t||z.el,w);}
      const akt=t>=z.a-ruch*.5&&t<=z.b+ruch*.7;
      if(akt&&z.el._c!==z.kto){z.el.style.setProperty('--c',OS[z.kto]);z.el._c=z.kto;}
      if(!z.bezRamki)klasa(z.el,'akt',akt);klasa(z.kar||z.el,'pisze',!z.klik&&t>=z.a&&t<z.b);}
    for(const kto in ksy){const L=zad.filter(z=>z.kto===kto);let i=L.findIndex(z=>t<z.a);if(i<0)i=L.length;
      const ter=L[Math.max(0,i-1)],nast=L[i];const pt=z=>punkt(z.t||z.el,root,z.klik?'':(wpis(z,t)??''),z.klik);
      let[x,y]=pt(i===0?L[0]:ter);
      if(nast&&i>0&&t>nast.a-ruch){const k=ez(seg(t,nast.a-ruch,nast.a));const[x2,y2]=punkt(nast.t||nast.el,root,'',nast.klik);x=lerp(x,x2,k);y=lerp(y,y2,k);}
      const w=widoczny[kto]||[L[0].a-ruch*1.6,L[L.length-1].b+ruch*2];
      stawK(ksy[kto],x,y,Math.min(seg(t,w[0],w[0]+.3),1-seg(t,w[1],w[1]+.3)));}
  };
}

/* ── odtwarzacze ── */
const GRACZE=[];
function gracz(el,dl,f,{petla=true,koniec=null}={}){const g={el,dl,f,petla,t:0,wid:false,koniec:koniec??dl};GRACZE.push(g);return g;}

/* 1 · HERO: trzy pliki, każda osoba wpisuje jedną czynność */
const mh=$('[data-mh]');
if(mh){
  const okna=$$('.xl',mh), fs=[];
  okna.forEach((xl,i)=>{const kto=xl.dataset.kto, cel=$$('.c[data-w]',xl), fv=$('.xl-fv',xl), nb=$('.xl-nb',xl);
    let t=.6+i*1.3; const zad=[];
    cel.forEach(c=>{if(!c.offsetParent||c.offsetWidth<8)return; t+=.45; const d=Math.max(.4,c.dataset.w.length/16); zad.push({kto,el:c,tekst:c.dataset.w,a:t,b:t+d}); t+=d+.3;});
    const f=silnik(xl,zad,{widoczny:{[kto]:[.1+i*1.3,99]}});
    fs.push(t2=>{f(t2); const z=zad.filter(z=>t2>=z.a-.2).pop(); tekst(fv,z?z.tekst.slice(0,Math.round(z.dl*seg(t2,z.a,z.b))):''); tekst(nb,z?z.el.dataset.adr:'B5');});
  });
  const kon=.6+okna.length*1.3+9;
  const zan=t=>{const o=1-seg(t,kon+1.8,kon+2.3);mh.style.setProperty('--o',o.toFixed(3));$$('.c[data-w]',mh).forEach(c=>c.style.opacity=o.toFixed(3));};
  gracz(mh,kon+2.4,t=>{fs.forEach(f=>f(t));zan(t);},{koniec:kon});
}

/* 3a · procedura i arkusz Ani: 14 kroków w pasku formuły, 11 spoza procedury */
const ma=$('[data-ma]');
if(ma){
  const xl=$('.xl',ma), linie=$$('.ma-l',ma), licz=$('[data-ma-licz]',ma), proc=$$('.ma-proc li',ma), d5=$('[data-d5]',ma), c5=$('[data-c5]',ma), f5=$('[data-f5]',ma);
  const zad=[{kto:'ania',el:c5,tekst:c5.dataset.v,a:.8,b:2}];
  let t=2.6; linie.forEach(l=>{const tx=$('.t',l).dataset.v; zad.push({kto:'ania',el:d5,t:$('.t',l),kar:l,tekst:tx,a:t,b:t+Math.max(.5,tx.length/26),bezRamki:true}); t+=Math.max(.5,tx.length/26)+.18;});
  const kJ=t; zad.push({kto:'ania',el:f5,tekst:'22',a:kJ+.5,b:kJ+.8});
  const f=silnik(xl,zad,{widoczny:{ania:[.2,kJ+2.5]}}), pelny=linie.map(l=>$('.t',l).dataset.v);
  const DOP={0:0,6:1,11:2};
  gracz(ma,kJ+6,t=>{
    f(t); let n=0, ile=0;
    linie.forEach((l,i)=>{const z=zad[i+1],o=t>=z.a-.05?1:0; if(l._o!==o){l.style.opacity=o;l._o=o;} const nz=$('.nz',l); const q=seg(t,z.b,z.b+.25); if(nz&&nz._q!==q){nz.style.opacity=q;nz._q=q;} if(t>=z.b){n=i+1; if(l.classList.contains('nowy'))ile++;}});
    klasa(d5,'akt',t>=2.3&&t<kJ+.3); d5.style.setProperty('--c',OS.ania);
    tekst(d5,pelny.slice(0,n).join(' → '));
    proc.forEach((li,j)=>klasa(li,'ok',Object.entries(DOP).some(([k,v])=>v===j&&n>+k)));
    tekst(licz,String(ile));
  },{koniec:kJ+1});
}

/* 3b · arkusze zespołu: wiersze przychodzą z kart osób, potem kolumna „Procedura” */
const mz=$('[data-mz]');
if(mz){
  const rw=$$('.rw',mz), w=$$('.w',mz), licz=$('[data-mz-licz]',mz), ile=+mz.dataset.poza;
  const N=rw.length/5;
  gracz(mz,13,t=>{
    for(let r=0;r<N;r++){const o=ez(seg(t,.4+r*.45,.75+r*.45));for(let c=0;c<5;c++){const el=rw[r*5+c];if(Math.abs((el._o??-1)-o)>.01){el.style.opacity=o.toFixed(3);el.style.transform=`translate3d(0,${(8*(1-o)).toFixed(1)}px,0)`;el._o=o;}}}
    w.forEach((el,i)=>{const on=t>.4+N*.45+.3+i*.22; klasa(el,'on',on); tekst(el,on?el.dataset.v:'');});
    tekst(licz,Math.round(ile*ez(seg(t,.4+N*.45+.3,.4+N*.45+.3+w.length*.22)))+' h');
  },{koniec:9});
}

/* 4 · scena: zakładki kroków skilla, same idą dalej, dopóki ktoś nie kliknie */
const kz=$('[data-kz]');
if(kz){
  const btn=$$('button',kz), pan=$$('[data-kz-p] > article');
  let akt=0, klik=false, od=0, wid=false;
  const pokaz=i=>{akt=i;btn.forEach((b,j)=>b.setAttribute('aria-selected',j===i?'true':'false'));pan.forEach((p,j)=>{p.classList.toggle('akt',j===i);p.toggleAttribute('inert',j!==i);});od=performance.now();};
  btn.forEach((b,i)=>b.addEventListener('click',()=>{klik=true;pokaz(i);}));
  new IntersectionObserver(e=>e.forEach(x=>{wid=x.isIntersecting;od=performance.now();}),{threshold:.35}).observe($('[data-kz-p]'));
  setInterval(()=>{if(!klik&&wid&&!RED&&performance.now()-od>9000)pokaz((akt+1)%btn.length);},500);
  pokaz(STOP!=null&&qs.has('k')?+qs.get('k'):0);
}

/* ── pętla ── */
const io=new IntersectionObserver(e=>e.forEach(x=>{const g=GRACZE.find(g=>g.el===x.target);if(g)g.wid=x.isIntersecting;}),{threshold:.2});
GRACZE.forEach(g=>io.observe(g.el));
let ost=performance.now();
function klatka(now){const dt=Math.min(.1,(now-ost)/1000);ost=now;
  for(const g of GRACZE){ if(RED){if(!g.fin){g.f(g.koniec);g.fin=1;}continue;}
    if(STOP!=null){if(g._s!==STOP){g.f(STOP);g._s=STOP;}continue;}
    if(!g.wid)continue; g.t+=dt; if(g.t>g.dl){g.t=g.petla?0:g.dl;} g.f(g.t);}
  requestAnimationFrame(klatka);}
const start=()=>{geoC=new Map();GRACZE.forEach(g=>g.f(STOP??0));};
start(); if(document.fonts&&document.fonts.ready)document.fonts.ready.then(start);
let rT;addEventListener('resize',()=>{clearTimeout(rT);rT=setTimeout(()=>{geoC=new Map();},150);});
requestAnimationFrame(klatka);
})();

/* ── 7 · pobranie zestawu: e-mail w komórce arkusza, Enter ──
   POST /api/kontakt jak każdy formularz strony (Zgody.astro dokłada Lead dla Mety). Do statystyk idzie tylko
   zdarzenie, nigdy dane osoby. ?z= dopisuje źródło (np. raport, mail-d8). */
(()=>{
const $=(s)=>document.querySelector(s);
const stat=(e,p)=>{try{window.laStat&&window.laStat(e,p||{});}catch(x){}};
const MAIL=/^[^\s@]+@[^\s@]+\.[a-zA-Z]{2,}$/, z=new URLSearchParams(location.search).get('z')||'';
const pob=$('.pob'), f=$('#fZ'), i=$('#iZ'), e=$('#eZ'), c=$('#cZ'), zg=$('#zgZ'), ok=$('#okZ'), b=$('#bZ');
if(!f)return;
let w=false;
i.addEventListener('input',()=>{e.textContent='';});
i.addEventListener('focus',()=>stat('mapa_pole',{}),{once:true});
c.addEventListener('change',()=>zg.classList.remove('err'));
document.querySelectorAll('a[href="#pobierz"]').forEach(a=>a.addEventListener('click',()=>{stat('mapa_cta',{skad:a.closest('section')?.id||'nav'});setTimeout(()=>{try{i.focus({preventScroll:true});}catch(x){}},900);}));
f.addEventListener('submit',ev=>{
  ev.preventDefault(); if(w)return;
  const v=i.value.trim();
  if(!MAIL.test(v)){e.textContent=v?'Ten e-mail chyba jest niepełny.':'Wpiszcie e-mail, na który wyślemy zestaw.';i.focus();return;}
  if(!c.checked){zg.classList.add('err');e.textContent='Zaznaczcie zgodę poniżej.';return;}
  w=true; b.disabled=true; b.textContent='…';
  let ref='';try{ref=localStorage.getItem('referrer')||'';}catch(x){}
  fetch('/api/kontakt',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({email:v,telefon:'',
    wiadomosc:'Pobranie zestawu „Mapa czynności” (arkusz + skill) z landingu /mapa-czynnosci.',firma_www:f.elements.kontrola.value||'',
    zrodlo:'Mapa czynności · pobranie'+(z?' · '+z:'')+' · '+location.pathname,referrer:ref})})
  .then(o=>{if(!o.ok)return o.json().catch(()=>({})).then(j=>{throw new Error(j.blad||'blad');});
    try{window.dataLayer=window.dataLayer||[];window.dataLayer.push({event:'formularz_wyslany',zrodlo:'Mapa czynności · pobranie'});}catch(x){}
    stat('mapa_pobranie',{}); pob.classList.add('ok'); b.textContent='✓'; i.readOnly=true; zg.hidden=true; ok.hidden=false;
    setTimeout(()=>{try{$('#dZip').click();}catch(x){}},400);})
  .catch(x=>{w=false;b.disabled=false;b.textContent='↵';e.textContent='Nie doszło. Spróbujcie jeszcze raz albo napiszcie: hello@letsautomate.pl';stat('mapa_blad',{powod:String(x&&x.message||'blad').slice(0,30)});});
});
})();

</script>
