(()=>{
const $=(s)=>document.querySelector(s);
const stat=(e,p)=>{try{window.laStat&&window.laStat(e,p||{});}catch(x){}};
const MAIL=/^[^\s@]+@[^\s@]+\.[a-zA-Z]{2,}$/;
const qs=new URLSearchParams(location.search);
const z=qs.get('z')||'';
const ref=()=>{try{return localStorage.getItem('referrer')||'';}catch(x){return '';}};
function wyslij(dane){
  return fetch('/api/kontakt',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(dane)})
   .then(o=>{if(!o.ok)return o.json().catch(()=>({})).then(j=>{throw new Error(j.blad||'blad');});});
}
/* 1. pobranie */
const fZ=$('#fZ'), iZ=$('#iZ'), eZ=$('#eZ'), cZ=$('#cZ'), zgZ=$('#zgZ'), okZ=$('#okZ'), ark=$('#arkCta'), bZ=$('#bZ');
let w1=false;
iZ.addEventListener('input',()=>{eZ.textContent='';});
cZ.addEventListener('change',()=>zgZ.classList.remove('err'));
iZ.addEventListener('focus',()=>stat('mapa_pole',{}),{once:true});
document.querySelectorAll('a[href="#wiersz"]').forEach(a=>a.addEventListener('click',e=>{e.preventDefault();stat('mapa_cta',{skad:a.id||'tresc'});$('#wiersz').scrollIntoView({behavior:'smooth',block:'start'});setTimeout(()=>{try{iZ.focus({preventScroll:true});}catch(x){}},800);}));
fZ.addEventListener('submit',e=>{
  e.preventDefault(); if(w1)return;
  const v=iZ.value.trim();
  if(!MAIL.test(v)){eZ.textContent=v?'Ten e-mail chyba jest niepełny.':'Wpisz e-mail, na który wyślemy zestaw.';iZ.focus();return;}
  if(!cZ.checked){zgZ.classList.add('err');eZ.textContent='Zaznacz zgodę poniżej.';return;}
  w1=true; bZ.disabled=true; bZ.textContent='…';
  wyslij({email:v,telefon:'',wiadomosc:'Pobranie zestawu „Mapa czynności” (arkusz + 5 skilli) z landingu /mapa-czynnosci.',
    firma_www:fZ.elements.kontrola.value||'',zrodlo:'Mapa czynności · pobranie'+(z?' · '+z:'')+' · '+location.pathname,referrer:ref()})
  .then(()=>{
    try{window.dataLayer=window.dataLayer||[];window.dataLayer.push({event:'formularz_wyslany',zrodlo:'Mapa czynności · pobranie'});}catch(x){}
    stat('mapa_pobranie',{});
    ark.classList.add('ok'); bZ.textContent='✓'; iZ.readOnly=true; zgZ.hidden=true; okZ.hidden=false;
    setTimeout(()=>{try{$('#dZip').click();}catch(x){}},400);
  })
  .catch(x=>{w1=false;bZ.disabled=false;bZ.textContent='↵';eZ.textContent='Nie doszło. Spróbuj jeszcze raz albo napisz: hello@letsautomate.pl';stat('mapa_blad',{powod:String(x&&x.message||'blad').slice(0,30)});});
});
/* 2. omówienie */
const fO=$('#fO'), iO=$('#iO'), eO=$('#eO'), okO=$('#okO'), om=$('#omowienie'), bO=$('#bO');
let w2=false;
iO.addEventListener('input',()=>{eO.textContent='';});
fO.addEventListener('submit',e=>{
  e.preventDefault(); if(w2)return;
  const v=iO.value.trim(); let email='',telefon='';
  if(v.includes('@')){if(!MAIL.test(v)){eO.textContent='Ten e-mail chyba jest niepełny.';return;}email=v;}
  else{const c=v.replace(/\D/g,''); if(c.length<9){eO.textContent=v?'Za mało cyfr?':'Wpisz telefon albo e-mail.';return;} telefon=(c.length===9?'+48 ':'+')+c.replace(/^00/,'');}
  w2=true; bO.disabled=true; bO.textContent='…';
  wyslij({email,telefon,wiadomosc:'Prośba o omówienie wyników „Mapy czynności” (30 min, bezpłatnie).',
    firma_www:fO.elements.kontrola.value||'',zrodlo:'Mapa czynności · omówienie'+(z?' · '+z:'')+' · '+location.pathname,referrer:ref()})
  .then(()=>{
    try{window.dataLayer=window.dataLayer||[];window.dataLayer.push({event:'formularz_wyslany',zrodlo:'Mapa czynności · omówienie'});}catch(x){}
    stat('mapa_omowienie',{kanal:telefon?'telefon':'email'});
    om.classList.add('ok'); bO.textContent='✓'; iO.readOnly=true; okO.hidden=false;
  })
  .catch(x=>{w2=false;bO.disabled=false;bO.textContent='↵';eO.textContent='Nie doszło. Spróbuj jeszcze raz.';});
});
if(location.hash==='#omowienie'||z==='raport'){setTimeout(()=>{om.scrollIntoView({block:'center'});},300);}
})();

</script>
