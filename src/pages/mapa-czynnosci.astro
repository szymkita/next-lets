/* ── dopasowanie obrazów sceny do ich strefy (na telefonie tylko zmniejsza, na dużym ekranie do 1,3×) ── */
function fit(){
  $$('[data-fit]').forEach(el=>{const o=el.closest('.obraz');if(!o)return;el.style.scale='';
    const max=innerWidth>=1100&&innerHeight>=760?1.3:1, k=Math.min(max,o.clientHeight/el.offsetHeight,o.clientWidth/el.offsetWidth);el.style.scale=Math.abs(k-1)>.005?k.toFixed(3):'';});
}

const SC=[['s1',s1],['s2',s2],['s3',s3],['s4',s4],['s5',s5],['s6',s6],['s7',s7]].map(([id,f])=>({el:document.getElementById(id),f,p:0,cel:0,ost:-1}));
const bar=$('#bar'), kon=$('#wiersz'), hEl=$('#h');
function cel(s,vh){const r=s.el.getBoundingClientRect();return {p:cl(-r.top/Math.max(1,r.height-vh)),blisko:r.bottom>-vh*.5&&r.top<vh*1.5};}
let ostT=performance.now();
function klatka(now){
  const vh=innerHeight, dt=Math.min(.1,(now-ostT)/1000); ostT=now;
  const k=SNAP?1:1-Math.exp(-dt*14);
  /* najpierw wszystkie odczyty układu, potem zapisy: bez przeliczania strony w środku klatki */
  const cele=SC.map(s=>cel(s,vh)), hr=hEl.getBoundingClientRect(), tr=teza.getBoundingClientRect(), kr=kon.getBoundingClientRect();
  SC.forEach((s,i)=>{
    const c=cele[i]; if(!c.blisko&&!SNAP)return;
    s.p+=(c.p-s.p)*k; if(Math.abs(c.p-s.p)<.0004)s.p=c.p;
    if(Math.abs(s.p-s.ost)>.0002){s.ost=s.p;s.f(s.p);}
  });
  if(hr.bottom>0)klatkaHero(now);
  przek.style.setProperty('--k',ez(seg(vh-tr.top,vh*.35,vh*.7)).toFixed(3));
  klasa(bar,'off',kr.top<vh*.5&&kr.bottom>0);
  if(!window.__snap)requestAnimationFrame(klatka);
}
function start(){
  geoC=new Map(); fit(); zbudujHero();
  SC.forEach(s=>{s.ost=-1;});
  if(SNAP){const c=cel; SC.forEach(s=>{s.p=c(s,innerHeight).p;s.f(s.p);});}
}
let rT; addEventListener('resize',()=>{clearTimeout(rT);rT=setTimeout(()=>{geoC=new Map();$$('.ark').forEach(a=>a._w=0);fit();zbudujHero();SC.forEach(s=>{s.ost=-1;});},150);});
start();
if(document.fonts&&document.fonts.ready)document.fonts.ready.then(()=>{geoC=new Map();$$('.ark').forEach(a=>a._w=0);fit();zbudujHero();SC.forEach(s=>s.ost=-1);if(window.__snap)requestAnimationFrame(klatka);});
const qsS=qs.get('s');
if(qsS){const el=document.getElementById(qsS); if(el){document.documentElement.style.scrollBehavior='auto'; scrollTo(0,el.getBoundingClientRect().top+scrollY+parseFloat(qs.get('p')||0)*Math.max(0,el.offsetHeight-innerHeight));}}
requestAnimationFrame(klatka);
if(window.__snap)addEventListener('scroll',()=>{ostT=performance.now();requestAnimationFrame(klatka);},{passive:true});
window.__klatka=klatka;
})();

