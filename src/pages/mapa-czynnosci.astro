</span><span class="c rw">Dzwonię do klientów przed sezonem</span><span class="c rw mn">7</span><span class="c rw w nie" data-v="brak"></span><i class="rn rw">9</i><span class="c rw kto" style="--kc:#e8590c">Kasia</span><span class="c rw">Przepisuję protokół do faktury</span><span class="c rw mn">28</span><span class="c rw w tak" data-v="✓ jest"></span><i class="rn rw">10</i><span class="c rw kto" style="--kc:#d6336c">Ania</span><span class="c rw">Przypominam o przeglądach</span><span class="c rw mn">6</span><span class="c rw w nie" data-v="brak"></span><i class="rn rw">11</i><span class="c rw kto" style="--kc:#0b8a7c">Tomek</span><span class="c rw">Odpowiadam technikom o części</span><span class="c rw mn">15</span><span class="c rw w nie" data-v="brak"></span><i class="rn">12</i><span class="suma">Razem</span><span class="suma">61 czynności, tu pierwsze 10</span><span class="suma mn">312</span><span class="suma">41 bez procedury</span></div><div class="xl-tabs"><span style="--c:#d6336c">Ania</span><span style="--c:#6d4aff">Marek</span><span style="--c:#e8590c">Kasia</span><span style="--c:#1c7ed6">Paweł</span><span style="--c:#0b8a7c">Tomek</span><span class="on">Zestawienie</span></div></div>
