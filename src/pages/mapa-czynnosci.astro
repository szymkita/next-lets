---
// MAPA CZYNNOŚCI — /mapa-czynnosci. Landing kampanii „Mapa czynności” (arkusz + 5 skilli za e-mail).
// Źródło w ~/filmy/lets-mapa-czynnosci/landing (strona.html/css/js, build.py generuje ten plik i kopiuje
// zestaw do public/materialy — zmiany rób tam). Plan kampanii: ~/filmy/lets-mapa-czynnosci/PLAN.md.
// Liczby na stronie to opisany przykład (firma serwisowa, 5 osób). noindex, bez nawigacji.
// Zgłoszenia: „Mapa czynności · pobranie” i „Mapa czynności · omówienie” (?z= dopisuje źródło, np. raport).
import LaBase from '../layouts/LaBase.astro';
const title = "Mapa czynności: sprawdź, co AI może przejąć w Twojej firmie | Let's automate";
const description = "Arkusz i 5 skilli do Claude, ChatGPT, Copilota i Gemini. Zespół spisuje swoją pracę przez tydzień, a AI robi z tego plan na start. Za darmo.";
---
<LaBase topbar={false} title={title} description={description} ctaHref="#wiersz" nav={null} naglowek={false} noindex={true}>
<style is:global>
html{scroll-behavior:smooth}
.mc{

  --deep:#07140D; --deep2:#0C1E14; --card:#0F2419; --fg:#F4F8F2; --mut:#93A69B; --soft:#C9D5CE; --line:rgba(244,248,242,.12);
  --acc:#00CD77; --amber:#F2B233; --pen:#E5484D;
  --paper:#FBFAF6; --grid:#DCE2DE; --head:#EEF2EF; --ink:#1C2420; --gray:#6B7A72; --ok:#0A7A52;
  --t-ai:#00A862; --t-sys:#2F7FE0; --t-cz:#D98A00; --t-zn:#9AA39E;
  --p-ania:#E5487F; --p-marek:#7C5CFF; --p-kasia:#F2762E; --p-piotr:#0EA5E9; --p-tomek:#14B8A6; --p-ai:#1C2420;
  --f-d:"Schibsted Grotesk","Helvetica Neue",Arial,sans-serif;
  --f-m:"JetBrains Mono",ui-monospace,Menlo,monospace;
  color-scheme:dark;}
.mc *{
box-sizing:border-box}

.mc{
margin:0;background:var(--deep);color:var(--fg);font-family:var(--f-d);-webkit-font-smoothing:antialiased;overflow-x:clip}
.mc .hist h1,.mc .hist h2{
margin:0;font-weight:800;letter-spacing:-.04em;line-height:1.04;text-wrap:balance;color:var(--fg)}
.mc .hist h1 em,.mc .hist h2 em{
font-style:normal;color:var(--acc)}
.mc .wrap{
max-width:1120px;margin:0 auto;padding:0 max(16px,env(safe-area-inset-left,0px))}
.mc .ety{
margin:0;font:700 12px/1.2 var(--f-m);letter-spacing:.12em;text-transform:uppercase;color:var(--acc)}
.mc .lead{
margin:14px 0 0;font:500 clamp(16px,4.3vw,21px)/1.42 var(--f-d);color:var(--soft);max-width:34em;text-wrap:pretty}
.mc .btn{
display:inline-flex;align-items:center;justify-content:center;gap:8px;font:700 16px/1 var(--f-d);color:#06170E;background:var(--acc);padding:16px 22px;border-radius:999px;text-decoration:none;border:0;cursor:pointer}
.mc .btn-2{
background:transparent;color:var(--fg);box-shadow:inset 0 0 0 1.5px var(--line)}
.mc .sr{
position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.mc .pulapka{
position:absolute;left:-9999px;width:1px;height:1px;opacity:0}
.mc .bar{
position:fixed;left:0;right:0;top:0;z-index:20;padding-top:env(safe-area-inset-top,0px);background:linear-gradient(180deg,rgba(7,20,13,.96) 60%,rgba(7,20,13,0));transition:opacity .3s,transform .3s}
.mc .bar.off{
opacity:0;transform:translateY(-100%);pointer-events:none}
.mc .bar-in{
max-width:1120px;margin:0 auto;height:60px;display:flex;align-items:center;justify-content:space-between;padding:0 max(16px,env(safe-area-inset-left,0px))}
.mc .logo svg{
height:17px;width:auto;display:block}
.mc .bar-cta{
font:700 14px/1 var(--f-d);color:#06170E;background:var(--acc);padding:11px 15px;border-radius:999px;text-decoration:none}
.mc .ark{
position:relative;background:var(--paper);color:var(--ink);border-radius:14px;box-shadow:0 30px 80px -30px rgba(0,0,0,.75),0 0 0 1px rgba(0,0,0,.05);font-family:var(--f-d)}
.mc .ark-tab{
display:flex;align-items:flex-end;gap:2px;padding:8px 10px 0;background:#E4EAE6;border-radius:14px 14px 0 0;font:600 12px/1 var(--f-d);color:var(--gray)}
.mc .ark-tab span{
padding:8px 12px;border-radius:8px 8px 0 0;white-space:nowrap}
.mc .ark-tab .on{
background:var(--paper);color:var(--ink)}
.mc .ark-g{
position:relative;display:grid;font-size:13.5px;line-height:1.3}
.mc .ark-g>*{
border-right:1px solid var(--grid);border-bottom:1px solid var(--grid);padding:0 9px;min-width:0;height:38px;display:flex;align-items:center}
.mc .ark-g>b{
background:var(--head);font:700 12px/1.2 var(--f-d);color:#3D4A43;height:32px}
.mc .ark-g>.rn{
background:var(--head);font:500 11px/1 var(--f-m);color:var(--gray);font-style:normal;justify-content:center;padding:0}
.mc .c{
white-space:nowrap;overflow:hidden;position:relative}
.mc .mn{
justify-content:flex-end;font-family:var(--f-m)}
.mc .c.akt{
box-shadow:inset 0 0 0 2px var(--c,var(--t-ai));z-index:1}
.mc .pisze::after{
content:"";display:inline-block;width:1.5px;height:1.05em;background:var(--c,var(--ink));margin-left:1px;flex:none}
.mc .kur{
position:absolute;left:0;top:0;z-index:5;pointer-events:none;will-change:transform,opacity;opacity:0;display:block;width:15px;height:19px}
.mc .kur svg{
display:block;width:15px;height:19px;fill:var(--c);stroke:#fff;stroke-width:1.4;filter:drop-shadow(0 2px 3px rgba(0,0,0,.25));flex:none}
.mc .kur em{
font:700 11px/1 var(--f-d);font-style:normal;color:#fff;background:var(--c);padding:4px 7px;border-radius:5px 9px 9px 9px;position:absolute;left:10px;top:16px;white-space:nowrap;box-shadow:0 2px 6px rgba(0,0,0,.2)}
.mc .kur.lewo em{
left:auto;right:8px;border-radius:9px 5px 9px 9px}
.mc .hero{
min-height:100svh;display:flex;flex-direction:column;justify-content:center;gap:34px;padding:calc(88px + env(safe-area-inset-top,0px)) 0 40px}
.mc .hero h1{
font-size:clamp(38px,10.4vw,78px);margin-top:14px;max-width:13em}
.mc .hero-cta{
margin-top:26px;display:flex;flex-wrap:wrap;align-items:center;gap:12px 18px}
.mc .hero-dop{
font:500 14px/1.3 var(--f-d);color:var(--mut)}
.mc .g-hero{
grid-template-columns:30px .9fr 1.2fr 1.9fr 64px}
.mc .g-hero>span{
height:46px}
.mc .g-hero .c{
color:rgba(28,36,32,var(--o,1))}
@media (min-width:1000px){
.mc .hero{
display:grid;grid-template-columns:1.05fr .95fr;align-items:center;max-width:1120px;margin:0 auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:16px;gap:40px}
.mc .hero>.wrap{
padding:0;max-width:none}
.mc #arkH{
width:100%}
.mc .g-hero{
grid-template-columns:30px 1fr 1.6fr 60px;font-size:15px}
.mc .g-hero .d{
display:none}
.mc .g-hero>span{
height:60px}
.mc .g-hero>b{
height:38px;font-size:13px}
}
@media (max-width:640px){
.mc .g-hero{
grid-template-columns:24px 1fr 1.5fr 48px}
.mc .g-hero .d{
display:none}
.mc .g-hero>*{
padding:0 7px}}
.mc .teza{
padding:16vh 0 10vh}
.mc .teza h2{
font-size:clamp(30px,8vw,60px);margin-top:12px;max-width:15em}
.mc .przek{
position:relative;color:var(--mut);white-space:nowrap}
.mc .przek::after{
content:"";position:absolute;left:-2%;right:-2%;top:54%;height:.08em;background:var(--pen);transform:scaleX(var(--k,0));transform-origin:0 50%}
.mc .sc{
position:relative;height:calc(var(--h) * 1svh)}
.mc .pin{
position:sticky;top:0;height:100svh;overflow:hidden;display:flex}
.mc .strefy{
display:flex;flex-direction:column;width:100%;padding-top:calc(76px + env(safe-area-inset-top,0px));padding-bottom:max(22px,env(safe-area-inset-bottom,0px))}
.mc .pod{
font-size:clamp(25px,6.8vw,50px);margin-top:10px;max-width:16em}
.mc .obraz{
flex:1;min-height:0;position:relative;margin:16px 0 12px;display:flex;align-items:center;justify-content:center}
.mc [data-fit]{
transform-origin:50% 50%}
.mc .zd{
position:relative;margin:0;min-height:4.1em;font:600 clamp(16px,4.4vw,22px)/1.35 var(--f-d);color:var(--fg);max-width:34em}
.mc .zd p{
margin:0;position:absolute;left:0;right:0;top:0;opacity:0;will-change:opacity,transform}
.mc .zd p:first-child{
opacity:1}
.mc .zd b{
color:var(--acc)}
.mc .zd.cicha{
min-height:2.8em;font-size:clamp(14px,3.8vw,18px);color:var(--soft);font-weight:500}
.mc .scena1{
position:relative;width:min(580px,100%);height:520px}
.mc .proc{
position:absolute;left:0;right:0;top:40px;margin:0 auto;width:min(420px,92%);background:#fff;color:var(--ink);border-radius:6px;padding:20px 22px 24px;box-shadow:0 30px 80px -30px rgba(0,0,0,.75);transform-origin:50% 0;will-change:transform,opacity;z-index:2}
.mc .proc-h{
font:700 11.5px/1.3 var(--f-m);letter-spacing:.06em;text-transform:uppercase;color:var(--gray);padding-bottom:12px;border-bottom:2px solid var(--ink)}
.mc .proc ol{
margin:14px 0 0;padding-left:26px;font:600 20px/1.6 var(--f-d)}
.mc .ark-ania{
position:absolute;left:0;right:0;top:0;will-change:transform,opacity}
.mc .g-ania{
grid-template-columns:30px 1fr 64px 150px}
.mc .lista-c::before{
content:"▾";order:2;margin-left:auto;color:var(--gray);font-size:11px}
.mc .lista{
position:absolute;right:10px;top:74px;width:178px;background:#fff;border-radius:8px;box-shadow:0 14px 30px -8px rgba(0,0,0,.35),0 0 0 1px var(--grid);padding:4px;z-index:4;opacity:0;transform-origin:50% 0;will-change:transform,opacity}
.mc .lista span{
display:block;padding:7px 9px;border-radius:5px;font:500 13px/1.2 var(--f-d)}
.mc .lista span.hl{
background:#E6F6EE;color:var(--ok);font-weight:700}
.mc .jak{
padding:8px 0 10px;background:#fff;border-radius:0 0 14px 14px}
.mc .jak-h{
font:700 11.5px/1 var(--f-m);color:var(--gray);letter-spacing:.06em;text-transform:uppercase;padding:2px 12px 6px}
.mc .jak ol{
margin:0;padding:0;list-style:none;display:grid}
.mc .jak li{
display:flex;gap:8px;align-items:center;height:24px;padding:0 12px;font:500 13.5px/1 var(--f-d);color:var(--ink);opacity:0;will-change:opacity}
.mc .jak li .k{
font:600 11px/1 var(--f-m);color:var(--gray);min-width:16px;text-align:right;flex:none}
.mc .jak li.nowy .k{
color:var(--pen)}
.mc .jak li .t{
white-space:nowrap;overflow:hidden;position:relative;display:flex;align-items:center}
.mc .jak li .nz{
margin-left:auto;font:600 10.5px/1 var(--f-m);color:var(--gray);background:var(--head);padding:4px 6px;border-radius:4px;white-space:nowrap;opacity:0;flex:none}
@media (max-width:640px){
.mc .g-ania{
grid-template-columns:24px 1fr 52px 126px}
.mc .g-ania>*{
padding:0 7px}
.mc .jak li{
font-size:12.5px;height:23px}
.mc .lista{
width:150px}
.mc .lista span{
font-size:12px}}
.mc .ark-zesp{
width:min(700px,100%)}
.mc .dzien{
margin-left:auto;background:transparent!important;color:var(--ok);font-weight:700;font-family:var(--f-m)}
.mc .g-zesp{
grid-template-columns:30px 70px 1fr 78px}
.mc .g-zesp>span{
height:34px;font-size:13px}
.mc .g-zesp .kto{
font-weight:700;color:var(--kc)}
.mc .g-zesp>span.drob{
transition:background .4s}
.mc .ark-zesp.drob-on .drob{
background:#FFF1CF}
.mc .suma{
display:flex;align-items:baseline;justify-content:flex-end;gap:10px;padding:12px 14px;background:var(--deep2);color:var(--fg);font:600 14px/1 var(--f-d);border-radius:0 0 14px 14px}
.mc .suma b{
font:700 28px/1 var(--f-m);color:var(--acc);min-width:3.6em;text-align:right}
@media (max-width:640px){
.mc .g-zesp{
grid-template-columns:24px 54px 1fr 58px}
.mc .g-zesp>*{
padding:0 7px}
.mc .g-zesp>span{
font-size:12.5px}}
.mc .spr{
display:flex;flex-direction:column;gap:12px;width:min(720px,100%)}
.mc .spr-st{
margin-left:auto;background:transparent!important;color:var(--t-cz);font-weight:700}
.mc .spr-st.gotowy{
color:var(--ok)}
.mc .g-spr{
grid-template-columns:28px 1fr 1.5fr .8fr}
.mc .g-spr>span{
font-size:12.5px;transition:background .3s;height:52px;white-space:normal;line-height:1.25}
.mc .g-spr>span.flag{
background:#FFF1CF}
.mc .uwagi{
margin:0;padding:0;list-style:none;display:grid;gap:7px}
.mc .uwagi li{
display:grid;grid-template-columns:auto 1fr;gap:10px;align-items:baseline;padding:10px 12px;border-radius:10px;background:var(--card);border:1px solid var(--line);border-left:4px solid var(--t-cz);font:500 14px/1.35 var(--f-d);color:var(--fg);opacity:0;will-change:opacity,transform;transition:border-color .3s}
.mc .uwagi li.zal{
border-left-color:var(--t-ai)}
.mc .uwagi li.zal span{
color:var(--mut);text-decoration:line-through;text-decoration-color:rgba(147,166,155,.6)}
.mc .uwagi b{
font:700 11px/1.4 var(--f-m);color:var(--t-cz);white-space:nowrap;letter-spacing:.03em}
.mc .uwagi li.zal b{
color:var(--t-ai)}
@media (max-width:640px){
.mc .g-spr{
grid-template-columns:22px 1fr 1.3fr .7fr}
.mc .g-spr>*{
padding:0 6px}
.mc .g-spr>span{
font-size:11.5px}
.mc .uwagi li{
font-size:13px;padding:8px 10px}}
.mc .diag{
width:min(620px,100%);display:flex;flex-direction:column;gap:14px}
.mc .tabs{
display:flex;gap:6px;flex-wrap:wrap}
.mc .tabs span{
display:flex;align-items:center;gap:6px;padding:7px 10px;border-radius:8px;background:var(--paper);color:var(--ink);font:700 12px/1 var(--f-d);will-change:transform,opacity;box-shadow:0 8px 20px -10px rgba(0,0,0,.6)}
.mc .tabs span::before{
content:"";width:8px;height:8px;border-radius:2px;background:var(--c)}
.mc .procesy{
display:grid;gap:9px}
.mc .pr{
background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px 14px;opacity:0;will-change:transform,opacity;transition:border-color .4s,box-shadow .4s}
.mc .pr.start{
border-color:var(--acc);box-shadow:0 0 0 1px var(--acc)}
.mc .pr-g{
display:flex;justify-content:space-between;gap:12px;align-items:baseline}
.mc .pr-g b{
font:700 16.5px/1.2 var(--f-d)}
.mc .pr-h{
font:700 19px/1 var(--f-m);color:var(--acc);white-space:nowrap}
.mc .pr-h i{
font-style:normal}
.mc .pr-kto{
margin-top:4px;font:500 13px/1.2 var(--f-d);color:var(--mut)}
.mc .pr-bar{
margin-top:9px;height:6px;border-radius:3px;background:rgba(255,255,255,.07);overflow:hidden}
.mc .pr-bar i{
display:block;height:100%;width:100%;background:var(--acc);border-radius:3px;transform-origin:0 50%;transform:scaleX(0);will-change:transform}
.mc .pr-uw{
margin-top:8px;font:600 13px/1.3 var(--f-d);color:var(--amber);opacity:0}
.mc .rozk-w{
position:relative;width:min(760px,100%);display:flex;flex-direction:column;gap:10px}
.mc .leg{
display:flex;flex-wrap:wrap;gap:6px 14px;font:700 12px/1 var(--f-m);letter-spacing:.04em}
.mc .leg span::before{
content:"";display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:6px;vertical-align:-1px}
.mc .l-ai::before{
background:var(--t-ai)}
.mc .l-sys::before{
background:var(--t-sys)}
.mc .l-cz::before{
background:var(--t-cz)}
.mc .l-zn::before{
background:var(--t-zn)}
.mc .rozk{
margin:0;padding:0;list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:5px 6px;will-change:transform,opacity}
.mc .rozk li{
display:flex;gap:7px;align-items:center;height:40px;padding:0 9px;border-radius:7px;background:#16301F;font:500 12.5px/1.2 var(--f-d);color:var(--soft);border-left:4px solid transparent;transition:background .35s,border-color .35s,color .35s,opacity .35s}
.mc .rozk li b{
font:600 10px/1 var(--f-m);color:var(--mut);min-width:14px}
.mc .rozk li.ai{
border-color:var(--t-ai);background:rgba(0,168,98,.17);color:var(--fg)}
.mc .rozk li.sys{
border-color:var(--t-sys);background:rgba(47,127,224,.18);color:var(--fg)}
.mc .rozk li.cz{
border-color:var(--t-cz);background:rgba(217,138,0,.2);color:var(--fg)}
.mc .rozk li.zn{
border-color:var(--t-zn);color:var(--mut);text-decoration:line-through;opacity:.55}
.mc .po{
position:absolute;left:0;right:0;top:50%;margin:0 auto;width:min(540px,100%);opacity:0;pointer-events:none;background:var(--paper);color:var(--ink);border-radius:14px;padding:18px 18px 16px;box-shadow:0 30px 80px -30px rgba(0,0,0,.75);will-change:transform,opacity}
.mc .po-h{
font:700 11.5px/1 var(--f-m);letter-spacing:.08em;text-transform:uppercase;color:var(--gray);margin-bottom:10px}
.mc .po ol{
margin:0;padding:0;list-style:none;display:grid;gap:7px}
.mc .po li{
padding:10px 12px;border-radius:9px;font:600 15px/1.3 var(--f-d);border-left:5px solid}
.mc .po .t-ai{
border-color:var(--t-ai);background:#E6F6EE}
.mc .po .t-sys{
border-color:var(--t-sys);background:#E7F0FC}
.mc .po .t-cz{
border-color:var(--t-cz);background:#FCF1DC}
@media (max-width:640px){
.mc .rozk li{
font-size:11px;padding:0 6px;gap:5px;height:38px}
.mc .rozk li b{
display:none}}
.mc .odz{
width:min(640px,100%);display:grid;gap:12px}
.mc .odz-r{
display:grid;grid-template-columns:1fr 64px;grid-template-areas:"n v" "b b";gap:6px 10px;align-items:baseline}
.mc .odz-r span{
grid-area:n;font:600 15px/1.2 var(--f-d);color:var(--soft)}
.mc .odz-r b{
grid-area:v;text-align:right;font:700 18px/1 var(--f-m);color:var(--fg)}
.mc .odz-b{
grid-area:b;position:relative;height:14px;border-radius:7px;background:rgba(255,255,255,.06);overflow:hidden}
.mc .odz-b i{
position:absolute;left:0;top:0;bottom:0;width:100%;border-radius:7px;transform-origin:0 50%;will-change:transform}
.mc .odz-b .was{
background:rgba(229,72,77,.38)}
.mc .odz-b .jest{
background:var(--acc)}
.mc .odz-w{
margin-top:10px;padding:16px 18px;border-radius:14px;background:var(--paper);color:var(--ink);opacity:0;will-change:transform,opacity}
.mc .odz-w b{
display:block;font:800 clamp(34px,9vw,52px)/1 var(--f-d);letter-spacing:-.03em;color:var(--ok)}
.mc .odz-w span{
display:block;margin-top:6px;font:600 15px/1.35 var(--f-d)}
.mc .raport{
width:min(500px,100%);background:#fff;color:var(--ink);border-radius:6px;padding:20px 20px 18px;box-shadow:0 30px 80px -30px rgba(0,0,0,.75);opacity:0;will-change:transform,opacity}
.mc .raport header{
display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;gap:4px 12px;border-bottom:2px solid var(--ink);padding-bottom:9px}
.mc .raport header b{
font:800 18px/1 var(--f-d);white-space:nowrap}
.mc .raport header span{
font:500 12px/1 var(--f-m);color:var(--gray);white-space:nowrap}
.mc .raport h3{
margin:14px 0 6px;font:700 11px/1 var(--f-m);letter-spacing:.08em;text-transform:uppercase;color:var(--gray)}
.mc .raport ol{
margin:0;padding-left:20px;display:grid;gap:6px}
.mc .raport li b{
display:block;font:700 15px/1.2 var(--f-d)}
.mc .raport li span{
font:500 13px/1.3 var(--f-d);color:#46524C}
.mc .tyg{
display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
.mc .tyg span{
background:var(--head);border-radius:6px;padding:8px 6px;font:600 12px/1.1 var(--f-d);text-align:center;color:#3D4A43}
.mc .tyg b{
