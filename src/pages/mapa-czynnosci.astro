  e.preventDefault(); if(w1)return;
  const v=iZ.value.trim();
  if(!MAIL.test(v)){eZ.textContent=v?'Ten e-mail chyba jest niepełny.':'Wpisz e-mail, na który wyślemy zestaw.';iZ.focus();return;}
  if(!cZ.checked){zgZ.classList.add('err');eZ.textContent='Zaznacz zgodę poniżej.';return;}
