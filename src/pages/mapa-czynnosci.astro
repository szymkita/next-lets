---
// MAPA CZYNNOŚCI — /mapa-czynnosci. Landing kampanii „Mapa czynności” (arkusz + 5 skilli za e-mail).
// Źródło w ~/filmy/lets-mapa-czynnosci/landing (strona.html/css/js, build.py generuje ten plik i kopiuje
// zestaw do public/materialy — zmiany rób tam). Plan kampanii: ~/filmy/lets-mapa-czynnosci/PLAN.md.
// Liczby na stronie to opisany przykład (firma serwisowa, 5 osób). noindex, bez nawigacji.
// Zgłoszenia: „Mapa czynności · pobranie” i „Mapa czynności · omówienie” (?z= dopisuje źródło, np. raport).
import LaBase from '../layouts/LaBase.astro';
const title = "Mapa czynności: sprawdź, co AI może przejąć w Twojej firmie | Let's automate";
const description = "Arkusz i 5 skilli do Claude, ChatGPT, Copilota i Gemini. Zespół spisuje swoją pracę przez tydzień, a AI robi z tego plan na start. Za darmo.";
---
<LaBase topbar={false} title={title} description={description} ctaHref="#wiersz" nav={null} naglowek={false} noindex={true}>
<style is:global>
html{scroll-behavior:smooth}
.mc{

  --deep:#07140D; --deep2:#0C1E14; --card:#0F2419; --fg:#F4F8F2; --mut:#93A69B; --soft:#C9D5CE; --line:rgba(244,248,242,.12);
  --acc:#00CD77; --acc2:#7FE9B9; --amber:#F2B233; --pen:#D3261B; --blue:#5AA9FF;
  --paper:#FBFAF6; --grid:#DCE2DE; --head:#EEF2EF; --ink:#1C2420; --gray:#6B7A72; --ok:#0A7A52;
  --t-ai:#00A862; --t-sys:#2F7FE0; --t-cz:#D98A00; --t-zn:#9AA39E;
  --f-d:"Schibsted Grotesk","Helvetica Neue",Arial,sans-serif;
  --f-m:"JetBrains Mono",ui-monospace,Menlo,monospace;
  color-scheme:dark;}
.mc *{
box-sizing:border-box}

.mc{
margin:0;background:var(--deep);color:var(--fg);font-family:var(--f-d);-webkit-font-smoothing:antialiased;overflow-x:clip}
.mc .hist h1,.mc .hist h2{
margin:0;font-weight:800;letter-spacing:-.04em;line-height:1.04;text-wrap:balance;color:var(--fg)}
.mc .hist h1 em,.mc .hist h2 em{
font-style:normal;color:var(--acc)}
.mc .wrap{
max-width:1120px;margin:0 auto;padding:0 max(16px,env(safe-area-inset-left,0px))}
.mc .ety{
margin:0;font:700 12px/1.2 var(--f-m);letter-spacing:.12em;text-transform:uppercase;color:var(--acc)}
.mc .lead{
margin:14px 0 0;font:500 clamp(16px,4.3vw,21px)/1.42 var(--f-d);color:var(--soft);max-width:34em;text-wrap:pretty}
.mc .btn{
display:inline-flex;align-items:center;justify-content:center;gap:8px;font:700 16px/1 var(--f-d);color:#06170E;background:var(--acc);padding:16px 22px;border-radius:999px;text-decoration:none;border:0;cursor:pointer}
.mc .btn-2{
background:transparent;color:var(--fg);box-shadow:inset 0 0 0 1.5px var(--line)}
.mc .sr{
position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.mc .pulapka{
position:absolute;left:-9999px;width:1px;height:1px;opacity:0}
.mc .bar{
position:fixed;left:0;right:0;top:0;z-index:20;padding-top:env(safe-area-inset-top,0px);background:linear-gradient(180deg,rgba(7,20,13,.96) 60%,rgba(7,20,13,0));transition:opacity .3s,transform .3s}
.mc .bar.off{
opacity:0;transform:translateY(-100%);pointer-events:none}
.mc .bar-in{
max-width:1120px;margin:0 auto;height:60px;display:flex;align-items:center;justify-content:space-between;padding:0 max(16px,env(safe-area-inset-left,0px))}
.mc .logo svg{
height:17px;width:auto;display:block}
.mc .bar-cta{
font:700 14px/1 var(--f-d);color:#06170E;background:var(--acc);padding:11px 15px;border-radius:999px;text-decoration:none}
.mc .hero{
min-height:100svh;display:flex;flex-direction:column;justify-content:center;gap:34px;padding:calc(88px + env(safe-area-inset-top,0px)) 0 40px}
.mc .hero h1{
font-size:clamp(38px,10.4vw,78px);margin-top:14px;max-width:13em}
.mc .hero-cta{
margin-top:26px;display:flex;flex-wrap:wrap;align-items:center;gap:12px 18px}
.mc .hero-dop{
font:500 14px/1.3 var(--f-d);color:var(--mut)}
.mc .ark{
background:var(--paper);color:var(--ink);border-radius:14px;box-shadow:0 30px 80px -30px rgba(0,0,0,.7),0 0 0 1px rgba(0,0,0,.05);overflow:hidden;font-family:var(--f-d)}
.mc .ark-tab{
display:flex;gap:2px;padding:8px 10px 0;background:#E7ECE8;font:600 12px/1 var(--f-d);color:var(--gray)}
.mc .ark-tab span{
padding:8px 12px;border-radius:8px 8px 0 0}
.mc .ark-tab .on{
background:var(--paper);color:var(--ink)}
.mc .ark-g{
display:grid;font-size:14px;line-height:1.3}
.mc .ark-g>*{
border-right:1px solid var(--grid);border-bottom:1px solid var(--grid);padding:9px 10px;min-height:38px;min-width:0}
.mc .ark-g>b{
background:var(--head);font:700 12px/1.2 var(--f-d);color:#3D4A43;display:flex;align-items:center}
.mc .ark-g>.rn{
background:var(--head);font:500 11px/1 var(--f-m);color:var(--gray);font-style:normal;display:flex;align-items:center;justify-content:center;padding:0}
.mc .mn{
text-align:right;justify-content:flex-end;font-family:var(--f-m)}
.mc .g-hero{
grid-template-columns:30px 1fr 1.4fr 2fr 70px}
.mc .g-hero>span{
height:44px}
.mc .kur{
position:relative;outline:2px solid var(--t-ai);outline-offset:-2px}
.mc .kursor{
display:inline-block;width:2px;height:18px;background:var(--ink);animation:mc-blink 1s steps(1) infinite;vertical-align:middle}
@keyframes mc-blink{
50%{
opacity:0}}
@media (min-width:1000px){
.mc .hero{
display:grid;grid-template-columns:1.1fr .9fr;align-items:center;max-width:1120px;margin:0 auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:16px}
.mc .hero>.wrap{
padding:0;max-width:none}
.mc .ark-hero{
transform:rotate(1.5deg);width:100%}
.mc .g-hero>span{
height:56px}}
@media (max-width:640px){
.mc .g-hero{
grid-template-columns:26px 1fr 1.2fr 1.4fr}
.mc .g-hero .mn{
display:none}}
.mc .sc{
position:relative;height:calc(var(--h) * 1svh)}
.mc .pin{
position:sticky;top:0;height:100svh;overflow:hidden;display:flex}
.mc .strefy{
display:flex;flex-direction:column;width:100%;padding-top:calc(76px + env(safe-area-inset-top,0px));padding-bottom:max(22px,env(safe-area-inset-bottom,0px))}
.mc .pod{
font-size:clamp(26px,7vw,52px);margin-top:10px;max-width:16em}
.mc .obraz{
flex:1;min-height:0;position:relative;margin:18px 0 14px;display:flex;align-items:center;justify-content:center}
.mc .zd{
margin:0;font:600 clamp(17px,4.6vw,23px)/1.35 var(--f-d);color:var(--fg);max-width:32em;position:relative;min-height:2.7em}
.mc .zd small{
display:block;margin-top:6px;font:500 13px/1.3 var(--f-d);color:var(--mut)}
.mc .zd .z0,.mc .zd .z1{
display:block;transition:opacity .35s}
.mc .zd .z1{
position:absolute;inset:0;opacity:0}
.mc .zd.dwa .z0{
opacity:0}
.mc .zd.dwa .z1{
opacity:1}
.mc .zd b{
color:var(--acc)}
.mc .proc{
position:absolute;inset:auto 0;margin:auto;width:min(520px,100%);background:#fff;color:var(--ink);border-radius:6px;padding:22px 24px 26px;box-shadow:0 30px 80px -30px rgba(0,0,0,.7);transform-origin:50% 0;transition:transform .5s cubic-bezier(.2,.8,.2,1),opacity .5s}
.mc .proc-h{
font:700 12px/1.3 var(--f-m);letter-spacing:.06em;text-transform:uppercase;color:var(--gray);padding-bottom:12px;border-bottom:2px solid var(--ink)}
.mc .proc ol{
margin:14px 0 0;padding-left:26px;font:600 20px/1.6 var(--f-d)}
.mc .proc.won{
transform:translateY(-38%) scale(.6) rotate(-3deg);opacity:.35}
.mc .ark-ania{
position:relative;width:min(560px,100%);opacity:0;transform:translateY(40px);transition:opacity .45s,transform .45s cubic-bezier(.2,.8,.2,1)}
.mc .ark-ania.on{
opacity:1;transform:none}
.mc .g-ania{
grid-template-columns:30px 1fr 78px}
.mc .g-ania .co{
font-weight:600}
.mc .jak{
padding:10px 12px 12px;border-top:2px solid var(--t-ai);background:#fff}
.mc .jak-h{
font:700 12px/1 var(--f-m);color:var(--t-ai);letter-spacing:.04em;margin-bottom:6px}
.mc .jak ol{
margin:0;padding:0;list-style:none;counter-reset:k;display:grid;gap:3px}
.mc .jak li{
counter-increment:k;display:flex;gap:8px;align-items:baseline;font:500 13.5px/1.3 var(--f-d);color:var(--ink);animation:mc-wjedz .3s ease-out both}
.mc .jak li::before{
content:counter(k);font:600 11px/1 var(--f-m);color:var(--gray);min-width:16px;text-align:right}
.mc .jak li i{
font-style:normal;font:600 10.5px/1 var(--f-m);color:var(--gray);background:var(--head);padding:3px 5px;border-radius:4px;white-space:nowrap;margin-left:auto}
.mc .jak li.nowy::before{
color:var(--pen)}
@keyframes mc-wjedz{
from{
opacity:0;transform:translateY(6px)}}
@media (max-height:740px){
.mc .jak li{
font-size:12.5px}
.mc .jak ol{
gap:1px}}
.mc .ark-zesp{
width:min(760px,100%)}
.mc .g-zesp{
grid-template-columns:30px 64px 1fr 74px 1fr}
.mc .g-zesp>span{
font-size:13px;animation:mc-wjedz .25s ease-out both}
.mc .g-zesp .kto{
font-weight:700;color:#3D4A43}
.mc .g-zesp .ai{
font-size:12px;color:var(--gray)}
.mc .g-zesp .ai.brak{
color:var(--pen)}
.mc .suma{
display:flex;align-items:baseline;justify-content:flex-end;gap:10px;padding:12px 14px;background:var(--deep2);color:var(--fg);font:600 14px/1 var(--f-d)}
.mc .suma b{
font:700 30px/1 var(--f-m);color:var(--acc)}
@media (max-width:640px){
.mc .g-zesp{
grid-template-columns:24px 50px 1fr 58px}
.mc .g-zesp .ai{
display:none}
.mc .g-zesp>*{
padding:7px 7px}}
.mc #s3o{
justify-content:center}
.mc .spr{
display:flex;flex-direction:column;gap:12px;width:min(720px,100%)}
.mc .ark-spr{
width:min(720px,100%)}
.mc .spr-st{
margin-left:auto;background:transparent!important;color:var(--t-cz);font-weight:700;transition:opacity .3s}
.mc .g-spr{
grid-template-columns:28px 1fr 1.5fr .8fr}
.mc .g-spr>span{
font-size:12.5px;transition:background .35s,box-shadow .35s}
.mc .g-spr>span.pusta{
background:#FFF4CC}
.mc .g-spr>span.flag{
background:#FCEBC4}
.mc .g-spr>span.ok{
background:#E6F6EE}
.mc .uwagi{
margin:0;padding:0;list-style:none;display:grid;gap:7px;width:min(720px,100%)}
.mc .uwagi li{
display:grid;grid-template-columns:auto 1fr;gap:10px;align-items:baseline;padding:10px 12px;border-radius:10px;background:var(--card);border:1px solid var(--line);border-left:4px solid var(--t-cz);font:500 14px/1.35 var(--f-d);color:var(--fg);opacity:0;transform:translateY(12px);transition:opacity .35s,transform .4s cubic-bezier(.2,.8,.2,1)}
.mc .uwagi li.on{
opacity:1;transform:none}
.mc .uwagi b{
font:700 11px/1.4 var(--f-m);color:var(--t-cz);white-space:nowrap;letter-spacing:.03em}
@media (max-width:640px){
.mc .g-spr{
grid-template-columns:22px 1fr 1.35fr .75fr}
.mc .g-spr>*{
padding:7px 6px}
.mc .g-spr>span{
font-size:11.5px}
.mc .uwagi li{
font-size:13px;padding:8px 10px}}
.mc .procesy{
width:min(620px,100%);display:grid;gap:10px}
.mc .pr{
background:var(--card);border:1px solid var(--line);border-radius:12px;padding:13px 14px;opacity:0;transform:translateX(30px);transition:opacity .4s,transform .45s cubic-bezier(.2,.8,.2,1)}
.mc .pr.on{
opacity:1;transform:none}
.mc .pr-g{
display:flex;justify-content:space-between;gap:12px;align-items:baseline}
.mc .pr-g b{
font:700 17px/1.2 var(--f-d)}
.mc .pr-h{
font:700 20px/1 var(--f-m);color:var(--acc);white-space:nowrap}
.mc .pr-h i{
font-style:normal}
.mc .pr-kto{
margin-top:4px;font:500 13px/1.2 var(--f-d);color:var(--mut)}
.mc .pr-bar{
margin-top:9px;height:6px;border-radius:3px;background:rgba(255,255,255,.07);overflow:hidden}
.mc .pr-bar i{
display:block;height:100%;width:0;background:var(--acc);border-radius:3px;transition:width .6s}
.mc .pr-uw{
margin-top:9px;font:600 13px/1.3 var(--f-d);color:var(--amber);opacity:0;transition:opacity .4s}
.mc .pr.uw .pr-uw{
opacity:1}
.mc #s5o{
flex-direction:column;align-items:stretch;justify-content:center;gap:10px}
.mc .leg{
display:flex;flex-wrap:wrap;gap:6px 14px;font:700 12px/1 var(--f-m);letter-spacing:.04em}
.mc .leg span::before{
content:"";display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:6px;vertical-align:-1px}
.mc .l-ai::before{
background:var(--t-ai)}
.mc .l-sys::before{
background:var(--t-sys)}
.mc .l-cz::before{
background:var(--t-cz)}
.mc .l-zn::before{
background:var(--t-zn)}
.mc .rozk{
margin:0;padding:0;list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:5px 6px;max-width:760px;width:100%;transition:opacity .5s,transform .5s}
.mc .rozk li{
display:flex;gap:7px;align-items:center;padding:7px 9px;border-radius:7px;background:#16301F;font:500 12.5px/1.2 var(--f-d);color:var(--soft);border-left:4px solid transparent;transition:background .35s,border-color .35s,color .35s,opacity .35s}
.mc .rozk li b{
font:600 10px/1 var(--f-m);color:var(--mut);min-width:14px}
.mc .rozk li.ai{
border-color:var(--t-ai);background:rgba(0,168,98,.16);color:var(--fg)}
.mc .rozk li.sys{
border-color:var(--t-sys);background:rgba(47,127,224,.16);color:var(--fg)}
.mc .rozk li.cz{
border-color:var(--t-cz);background:rgba(217,138,0,.18);color:var(--fg)}
.mc .rozk li.zn{
border-color:var(--t-zn);color:var(--mut);text-decoration:line-through;opacity:.6}
.mc .rozk.zwin{
opacity:0;transform:scale(.94)}
.mc .leg{
transition:opacity .4s}
.mc .leg.zwin{
opacity:0}
.mc .po{
position:absolute;left:0;right:0;top:50%;margin:0 auto;width:min(560px,100%);transform:translateY(-40%);opacity:0;transition:opacity .5s,transform .5s cubic-bezier(.2,.8,.2,1);pointer-events:none;background:var(--paper);color:var(--ink);border-radius:14px;padding:18px 18px 16px;box-shadow:0 30px 80px -30px rgba(0,0,0,.7)}
.mc .po.on{
opacity:1;transform:translateY(-50%)}
.mc .po-h{
font:700 12px/1 var(--f-m);letter-spacing:.08em;text-transform:uppercase;color:var(--gray);margin-bottom:10px}
.mc .po ol{
margin:0;padding:0;list-style:none;display:grid;gap:7px}
.mc .po li{
padding:10px 12px;border-radius:9px;font:600 15px/1.3 var(--f-d);border-left:5px solid}
.mc .po .t-ai{
border-color:var(--t-ai);background:#E6F6EE}
.mc .po .t-sys{
border-color:var(--t-sys);background:#E7F0FC}
.mc .po .t-cz{
border-color:var(--t-cz);background:#FCF1DC}
@media (max-width:640px){
.mc .rozk{
grid-template-columns:1fr 1fr}
.mc .rozk li{
font-size:11px;padding:5px 6px;gap:5px}
.mc .rozk li b{
display:none}}
.mc .raport{
width:min(500px,100%);background:#fff;color:var(--ink);border-radius:6px;padding:20px 20px 18px;box-shadow:0 30px 80px -30px rgba(0,0,0,.7);transform:rotate(-1.2deg) translateY(30px);opacity:0;transition:all .6s cubic-bezier(.2,.8,.2,1)}
.mc .raport.on{
transform:rotate(-1.2deg);opacity:1}
.mc .raport header{
display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;gap:4px 12px;border-bottom:2px solid var(--ink);padding-bottom:9px}
.mc .raport header b{
font:800 18px/1 var(--f-d);white-space:nowrap}
.mc .raport header span{
font:500 12px/1 var(--f-m);color:var(--gray);white-space:nowrap}
.mc .raport h3{
margin:14px 0 6px;font:700 11px/1 var(--f-m);letter-spacing:.08em;text-transform:uppercase;color:var(--gray)}
.mc .raport ol{
margin:0;padding-left:20px;display:grid;gap:6px}
.mc .raport li b{
display:block;font:700 15px/1.2 var(--f-d)}
.mc .raport li span{
font:500 13px/1.3 var(--f-d);color:#46524C}
.mc .tyg{
display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
.mc .tyg span{
background:var(--head);border-radius:6px;padding:8px 6px;font:600 12px/1.1 var(--f-d);text-align:center;color:#3D4A43}
.mc .tyg b{
display:block;font:700 16px/1 var(--f-m);color:var(--ok);margin-bottom:3px}
.mc .decyzja{
margin-top:12px;padding:11px 12px;border-radius:8px;background:#E6F6EE;border-left:5px solid var(--t-ai);font:700 14px/1.3 var(--f-d)}
.mc .zestaw{
padding:90px 0 40px}
.mc .zestaw h2{
font-size:clamp(28px,7.4vw,52px);margin-top:10px;max-width:16em}
.mc .pliki{
margin:26px 0 0;padding:0;list-style:none;display:grid;gap:8px;max-width:640px}
.mc .pliki li{
display:flex;gap:14px;align-items:center;padding:12px 14px;border-radius:12px;background:var(--card);border:1px solid var(--line)}
.mc .pliki b{
display:block;font:700 16px/1.2 var(--f-d)}
.mc .pliki li span:not(.ik){
font:500 14px/1.3 var(--f-d);color:var(--mut)}
.mc .ik{
flex:none;width:38px;height:38px;border-radius:9px;display:grid;place-items:center;font:700 15px/1 var(--f-m);background:rgba(0,205,119,.14);color:var(--acc)}
.mc .ik.xl{
background:#1D6F42;color:#fff;font-size:11px}
.mc .ik.txt{
background:#2A3B32;color:var(--soft);font-size:11px}
.mc .gdzie{
margin:20px 0 0;font:500 15px/1.45 var(--f-d);color:var(--soft);max-width:36em}
.mc .koniec{
padding:70px 0 70px}
.mc .koniec h2{
font-size:clamp(34px,9vw,64px)}
.mc .ark-cta{
margin-top:24px;max-width:760px}
.mc .g-cta{
grid-template-columns:30px .8fr 1.3fr 1.5fr}
.mc .g-cta .szary{
color:var(--gray);font-size:13px}
.mc .cel-in{
position:relative;display:flex;align-items:center;padding:0!important;outline:2px solid var(--t-ai);outline-offset:-2px;background:#fff;animation:mc-puls 1.8s ease-in-out infinite}
.mc .cel-in input{
flex:1;min-width:0;border:0;background:transparent;font:600 16px/1 var(--f-d);color:var(--ink);padding:12px 8px 12px 10px;outline:none}
.mc .cel-in input::placeholder{
color:#9AA7A0}
.mc .cel-in button{
flex:none;border:0;background:var(--t-ai);color:#fff;font:700 18px/1 var(--f-m);width:42px;align-self:stretch;cursor:pointer}
@keyframes mc-puls{
50%{
outline-color:rgba(0,168,98,.35)}}
.mc .ark-cta.ok .cel-in,.mc .ark-om.ok .cel-in{
animation:none;outline-color:var(--t-ai);background:#E6F6EE}
.mc .ark-cta.ok .g-cta>span{
background:#E6F6EE}
.mc .blad{
margin:0;min-height:0;padding:0 14px;font:600 13px/1.3 var(--f-d);color:var(--pen)}
.mc .blad:not(:empty){
padding:8px 14px}
.mc .zgoda{
display:flex;gap:9px;align-items:flex-start;padding:10px 14px 14px;font:500 12px/1.35 var(--f-d);color:var(--gray)}
.mc .zgoda input{
margin-top:2px;accent-color:var(--t-ai)}
.mc .zgoda a{
color:var(--gray)}
.mc .zgoda.err{
color:var(--pen)}
.mc .pobrane{
padding:4px 14px 16px;color:var(--ink);font:500 15px/1.4 var(--f-d)}
.mc .pobrane p{
margin:8px 0}
.mc .pob-l{
display:flex;flex-wrap:wrap;gap:8px}
.mc .pob-l .btn{
font-size:14px;padding:12px 16px}
.mc .pob-l .btn-2{
color:var(--ink);box-shadow:inset 0 0 0 1.5px var(--grid)}
.mc .pob-d{
font-size:13px;color:var(--gray)}
.mc .ark-om{
