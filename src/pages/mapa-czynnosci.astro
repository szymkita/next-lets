            ['marek',['Po telefonie klienta','Przygotowuję wycenę','Cennik w Excelu → kopiuję do maila','35']],
            ['kasia',['Po wizycie technika','Wystawiam fakturę','Protokół ze zdjęcia → przepisuję','15']]];
let hero=null, heroT0=performance.now();
function zbudujHero(){
  $$('.kur',arkH).forEach(k=>k.remove());
  const rzedy=$$('.g-hero>.c',arkH), zad=[]; let koniec=0;
  HERO.forEach(([kto,tx],r)=>{
    let t=.6+r*1.1;
    tx.forEach((s,c)=>{const el=rzedy[r*4+c]; if(!el.offsetParent)return; t+=.5; const d=Math.max(.35,s.length/17); zad.push({kto,el,tekst:s,a:t,b:t+d}); t+=d+.25;});
    koniec=Math.max(koniec,t);
  });
  const L=koniec+2.4, f=silnik(arkH,zad,{ruch:.5,widoczny:{ania:[-.2,koniec+1.6],marek:[-.2,koniec+1.6],kasia:[-.2,koniec+1.6]}});
  const g=$('.g-hero',arkH);
  hero={L,f,g,koniec};
}
function klatkaHero(now){
  if(!hero)return;
  let t=SNAP?hero.koniec*.62:((now-heroT0)/1000)%hero.L;
  const zanik=1-seg(t,hero.koniec+1.6,hero.koniec+2.2);
  hero.g.style.setProperty('--o',zanik.toFixed(3));
  hero.f(t);
}

