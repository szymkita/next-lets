(()=>{
const $=(s,r=document)=>r.querySelector(s);
const qs=new URLSearchParams(location.search);
const stat=(e,p)=>{try{window.laStat&&window.laStat(e,p||{});}catch(x){}};

/* pasek: znika nad samym końcem, żeby nie zasłaniał wiersza */
const bar=$('#bar'), kon=$('#wiersz');

/* ── s1: 14 kroków Ani ── */
const KROKI=[
 ['Czytam mail od klienta','Outlook'],['Szukam klienta w systemie po nazwie','system'],
 ['Otwieram umowę serwisową','PDF na dysku'],['Sprawdzam, czy urządzenie jest na gwarancji','arkusz'],
 ['Brak numeru seryjnego: proszę klienta o zdjęcie tabliczki','Outlook',1],['Czekam, wracam do maila po 2 h','',1],
 ['Szukam wolnego technika','kalendarz'],['Dzwonię do technika, czy zdąży','telefon',1],
 ['Pytam magazyn o część','WhatsApp',1],['Wpisuję zlecenie do systemu','system'],
 ['Przeklejam opis usterki z maila','system',1],['Wysyłam klientowi termin','Outlook'],
 ['Wpisuję termin technikowi','kalendarz',1],['Odhaczam zgłoszenie w zestawieniu','arkusz',1]];
const kroki=$('#kroki'), jakN=$('#jakN'), aMin=$('#aMin'), proc=$('#proc'), ania=$('#ania'), s1z=$('#s1z');
let n1=-1;
function s1(p){
  proc.classList.toggle('won',p>.12); ania.classList.toggle('on',p>.14);
  const n=Math.max(0,Math.min(14,Math.round((p-.18)/.62*14)));
  if(n!==n1){
    if(n>n1){for(let i=Math.max(0,n1);i<n;i++){const [t,nz,nw]=KROKI[i];const li=document.createElement('li');if(nw)li.className='nowy';li.innerHTML=t+(nz?'<i>'+nz+'</i>':'');kroki.appendChild(li);}}
    else{while(kroki.children.length>n)kroki.lastChild.remove();}
    n1=n; jakN.textContent=n; aMin.textContent=Math.round(n/14*22)+' min';
  }
  s1z.classList.toggle('dwa',n>=14);
}

/* ── s2: zespół ── */
const ZESP=[
 ['Ania','Przyjmuję zgłoszenie serwisowe',33,'nie używam'],['Marek','Przygotowuję wycenę naprawy',24,'ChatGPT do maila, cennik ręcznie'],
 ['Kasia','Przepisuję protokół technika do faktury',28,'nie wiem, czy mogę wkleić dane klienta'],['Ania','Odpowiadam, kiedy przyjedzie technik',19,'nie używam'],
 ['Piotr','Raport miesięczny dla klienta',17,'Copilot do podsumowania'],['Marek','Przyjmuję zgłoszenie z telefonu',27,'nie używam'],
 ['Tomek','Sprawdzam stan części i zamawiam',22,'nie używam'],['Kasia','Przyjmuję zgłoszenie z formularza',26,'nie używam'],
 ['Piotr','Akceptuję wyceny powyżej progu',17,'nie używam'],['Kasia','Przypominam o niezapłaconych fakturach',12,'nie używam'],
 ['Tomek','Odpowiadam technikom o części',15,'nie używam'],['Ania','Uzupełniam zestawienie zgłoszeń',21,'nie używam']];
const zesp=$('#zesp'), suma=$('#suma');
let n2=0; const lim2=()=>innerHeight<700?6:innerWidth<640?8:12;
function s2(p){
  const L=lim2(), n=Math.max(0,Math.min(L,Math.round((p-.06)/.6*L)));
  while(n2<n){const [k,c,h,a]=ZESP[n2];zesp.insertAdjacentHTML('beforeend',`<i class="rn">${n2+5}</i><span class="kto">${k}</span><span>${c}</span><span class="mn">${h}</span><span class="ai${/nie używam|nie wiem/.test(a)?' brak':''}">${a}</span>`);n2++;}
  while(n2>n){for(let i=0;i<5;i++)zesp.lastElementChild.remove();n2--;}
  const t=Math.max(0,Math.min(1,(p-.1)/.75));
  suma.textContent=Math.round(312*t*t*(3-2*t))+' h';
}

/* ── s3: skill sprawdza arkusz Marka ── */
const uw=[...document.querySelectorAll('#uwagi li')], kom=[...document.querySelectorAll('.g-spr>span')], sprSt=$('#sprSt');
function s3(p){
  let n=0;
  uw.forEach((li,i)=>{const on=p>.18+i*.18; li.classList.toggle('on',on); if(on)n++;});
  const flagi=uw.filter(li=>li.classList.contains('on')).map(li=>li.dataset.w);
  kom.forEach(k=>{k.classList.toggle('flag',flagi.includes(k.dataset.w)); k.classList.toggle('ok',k.dataset.w==='3'&&p>.75);});
  sprSt.textContent=p>.75?'Prawie gotowy · 3 pytania':(p>.12?'Sprawdzam…':'');
}

/* ── s4: procesy ── */
const prs=[...document.querySelectorAll('.pr')];
function s4(p){
  prs.forEach((el,i)=>{
    const on=p>.08+i*.13; el.classList.toggle('on',on);
    const h=+el.dataset.h, t=on?Math.min(1,(p-.08-i*.13)/.25):0;
    el.querySelector('.pr-h i').textContent=Math.round(h*t);
    el.querySelector('.pr-bar i').style.width=(on?h/86*100*t:0)+'%';
  });
  prs[0].classList.toggle('uw',p>.7);
}

/* ── s5: rozkład kroków ── */
const RODZ=['ai','sys','ai','ai','ai','zn','sys','cz','sys','sys','zn','sys','sys','zn'];
const rozk=$('#rozk'); rozk.innerHTML=KROKI.map((k,i)=>`<li><b>${i+1}</b>${k[0]}</li>`).join('');
const rl=[...rozk.children], leg=document.querySelector('#s5 .leg'), po=$('#po'), s5z=$('#s5z')||document.querySelector('#s5 .zd');
function s5(p){
  rl.forEach((li,i)=>{li.className=p>.1+i*.04?RODZ[i]:'';});
  const zw=p>.76; rozk.classList.toggle('zwin',zw); po.classList.toggle('on',zw); leg.classList.toggle('zwin',zw);
  s5z.classList.toggle('dwa',zw);
}

/* ── s6: raport ── */
const raport=$('#raport');
function s6(p){raport.classList.toggle('on',p>.08);}

/* dopasowanie: obraz sceny nigdy nie wychodzi poza swoją strefę (zmniejsza, nie powiększa) */
function fit(){document.querySelectorAll('[data-fit]').forEach(el=>{const o=el.closest('.obraz');if(!o)return;el.style.scale='';
  const k=Math.min(1,o.clientHeight/el.offsetHeight,o.clientWidth/el.offsetWidth);el.style.scale=k<1?k.toFixed(3):'';});}
addEventListener('resize',fit);
const SC=[['s1',s1],['s2',s2],['s3',s3],['s4',s4],['s5',s5],['s6',s6]].map(([id,f])=>({el:document.getElementById(id),f,last:-1}));
function frame(){
  const vh=innerHeight;
  for(const s of SC){
    const r=s.el.getBoundingClientRect(), span=Math.max(1,r.height-vh);
    const p=Math.max(0,Math.min(1,-r.top/span));
    if(r.bottom>-vh&&r.top<vh*2&&Math.abs(p-s.last)>.002){s.last=p;s.f(p);fit();}
  }
  const k=kon.getBoundingClientRect(); bar.classList.toggle('off',k.top<vh*.5&&k.bottom>0);
  if(!window.__snap)requestAnimationFrame(frame);
}
if(window.__snap||qs.get('s')){SC.forEach(s=>s.f(0));}
const qsS=qs.get('s');
if(qsS){const el=document.getElementById(qsS); if(el){document.documentElement.style.scrollBehavior='auto'; scrollTo(0,el.getBoundingClientRect().top+scrollY+parseFloat(qs.get('p')||0)*Math.max(0,el.offsetHeight-innerHeight));}}
window.__klatka=frame;
requestAnimationFrame(frame);
if(window.__snap)addEventListener('scroll',()=>requestAnimationFrame(frame),{passive:true});
})();

/* ── wiersze w arkuszu: pobranie zestawu (e-mail) i omówienie (telefon albo e-mail) ──
