/* ── narzędzia: tekst, geometria, kursory ── */
const cv=document.createElement('canvas').getContext('2d'), fonty=new WeakMap();
function szer(el,txt){let f=fonty.get(el);if(!f){const s=getComputedStyle(el);f=`${s.fontStyle} ${s.fontWeight} ${s.fontSize} ${s.fontFamily}`;fonty.set(el,f);}cv.font=f;return cv.measureText(txt).width;}
let geoC=new Map();
function geo(el,root){
  let g=geoC.get(el); if(g&&g.root===root)return g;
  let x=0,y=0,e=el; while(e&&e!==root){x+=e.offsetLeft;y+=e.offsetTop;e=e.offsetParent;}
  const s=getComputedStyle(el);
  g={root,x,y,w:el.offsetWidth,h:el.offsetHeight,pl:parseFloat(s.paddingLeft)||0,pr:parseFloat(s.paddingRight)||0,mn:el.classList.contains('mn'),zaw:s.whiteSpace==='normal',lh:parseFloat(s.lineHeight)||parseFloat(s.fontSize)*1.25};
  geoC.set(el,g); return g;
}
function tekst(el,t){if(el._t!==t){el.textContent=t;el._t=t;}}
function klasa(el,k,on){if(!!el['_'+k]!==on){el.classList.toggle(k,on);el['_'+k]=on;}}
function kursor(root,kto){
  const k=document.createElement('span'); k.className='kur'; k.style.setProperty('--c',OS[kto]);
  k.innerHTML='<svg viewBox="0 0 16 20"><path d="M1 1v15.5l4.2-3.9 2.7 6.1 2.6-1.2-2.7-6h5.9z"/></svg><em>'+IM[kto]+'</em>';
  root.appendChild(k); return {el:k,root,x:-1,y:-1,o:-1,l:null};
}
function stawK(k,x,y,o){
  const l=x>(k.root._w||(k.root._w=k.root.offsetWidth))-96; if(l!==k.l){k.el.classList.toggle('lewo',l);k.l=l;}
  if(Math.abs(k.x-x)>.15||Math.abs(k.y-y)>.15){k.el.style.transform=`translate3d(${x.toFixed(1)}px,${y.toFixed(1)}px,0)`;k.x=x;k.y=y;}
  o=cl(o); if(Math.abs(k.o-o)>.004){k.el.style.opacity=o.toFixed(3);k.o=o;}
}
/* punkt karetki: koniec wpisanego tekstu w komórce */
function punkt(el,root,txt,klik){
  const g=geo(el,root);
  if(klik) return [g.x+Math.min(g.w*.45,60),g.y+g.h*.5];
  const sz=szer(el,txt), dost=g.w-g.pl-g.pr;
  if(g.zaw&&sz>dost){const n=Math.ceil(sz/dost), l=n-1; return [g.x+g.pl+Math.min(sz-l*dost,dost)+1, g.y+g.h/2-n*g.lh/2+(l+.5)*g.lh-3];}
  const x=g.mn?g.x+g.w-g.pr:g.x+g.pl+Math.min(sz,dost);
  return [x+1,g.y+g.h*.5-3];
}
/* napisy pod sceną: kilka zdań na zmianę, płynnie */
function napisy(box,progi){
  const ps=$$('p',box);
  return p=>ps.forEach((el,i)=>{
    const a=i?seg(p,progi[i-1]-.025,progi[i-1]+.025):1, b=i<ps.length-1?1-seg(p,progi[i]-.025,progi[i]+.025):1, o=Math.min(a,b);
    if(Math.abs((el._o??-1)-o)>.004){el.style.opacity=o.toFixed(3);el.style.transform=`translate3d(0,${((1-o)*(i&&a<1?8:-8)).toFixed(1)}px,0)`;el._o=o;}
  });
}

/* ── silnik wpisywania: zadania {kto, el, tekst, a, b, z (tekst do skasowania), klik} ──
   Kursor osoby jedzie do komórki przed startem zadania (RUCH), wpisuje tekst w [a,b], potem czeka. */
function silnik(root,zad,opt={}){
  const RUCH=opt.ruch||.035, ksy={};
  zad.forEach(z=>{z.dl=z.tekst?z.tekst.length:0; if(!ksy[z.kto])ksy[z.kto]=kursor(root,z.kto);});
  const po=kto=>zad.filter(z=>z.kto===kto);
  const wid=opt.widoczny||{};
  function wpis(z,p){
    const t=seg(p,z.a,z.b);
    if(z.klik) return null;
    if(z.z!=null){ if(p<z.a) return z.z; if(t<.35) return z.z.slice(0,Math.ceil(z.z.length*(1-t/.35))); return z.tekst.slice(0,Math.round(z.dl*(t-.35)/.65)); }
    if(p<z.a) return z.przed??'';
    return z.tekst.slice(0,Math.round(z.dl*t));
  }
  return p=>{
    for(const z of zad){
      const w=wpis(z,p); if(w!=null) tekst(z.el,w);
      const akt=p>=z.a-RUCH*.4&&p<=z.b+RUCH*.6;
      if(akt&&z.el._c!==z.kto){z.el.style.setProperty('--c',OS[z.kto]);z.el._c=z.kto;}
      klasa(z.el,'akt',akt);
      klasa(z.el,'pisze',!z.klik&&p>=z.a&&p<z.b);
    }
    for(const kto in ksy){
      const L=po(kto); let i=L.findIndex(z=>p<z.a); if(i<0)i=L.length;
      const ter=L[Math.max(0,i-1)], nast=L[i];
      const pt=z=>punkt(z.el,root,z.klik?'':(wpis(z,p)??''),z.klik);
      let [x,y]=pt(i===0?L[0]:ter);
      if(nast&&i>0&&p>nast.a-RUCH){const t=ez(seg(p,nast.a-RUCH,nast.a));const[x2,y2]=punkt(nast.el,root,'',nast.klik);x=lerp(x,x2,t);y=lerp(y,y2,t);}
      const pierw=L[0], ost=L[L.length-1], w=wid[kto]||[pierw.a-RUCH*1.8, ost.b+RUCH*2.2];
      const o=Math.min(seg(p,w[0],w[0]+RUCH*.8),1-seg(p,w[1],w[1]+RUCH*.8));
      stawK(ksy[kto],x,y,o);
    }
  };
}

