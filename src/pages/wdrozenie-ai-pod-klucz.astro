// Przykład dla Wolsenty z filmu; cena etapu 1 to pole „stała kwota” bez liczby.
const KARTKA = [
  { t: 'Od czego zaczynamy', d: 'Oferty serwisowe dla biurowców. Dziś Marta składa je ręcznie z HubSpota, notatek ze spotkań i cennika.' },
  { t: 'Co przejmie AI', d: 'Szkic oferty w szablonie firmy. Marta sprawdza go i wysyła.' },
  { t: 'Które systemy podłączymy', d: 'HubSpot, Gmail, notatki ze spotkań i cennik serwisu.' },
  { t: 'Kto zaczyna pracę', d: 'Sprzedaż, potem obsługa zgłoszeń serwisowych.' },
  { t: 'Co dalej', d: 'Odpowiedzi na zgłoszenia i raport po każdym przeglądzie.' },
];

const faq = [
  {
    q: 'Czym jest bezpłatna diagnoza?',
    a: 'To pierwszy krok wdrożenia. Razem z Wami przechodzimy przez procesy, dokumenty i systemy, szukamy miejsc, w których ucieka czas, i ustalamy, od czego zacząć. Po diagnozie dostajecie plan wdrożenia z ceną pierwszego etapu.',
  },
  {
    q: 'Ile kosztuje wdrożenie?',
    a: 'Pierwszy etap wyceniamy w planie kwotą stałą, znaną przed startem. Każdy kolejny etap też ma cenę, zanim go zaczniemy.',
  },
  {
    q: 'Ile to trwa?',
    a: 'Zależy od tego, który proces idzie pierwszy i ile systemów trzeba podłączyć. Zakres i kolejność etapów rozpisujemy w planie po diagnozie, a termin startu ustalamy razem z Wami.',
  },
  {
    q: 'Czy musimy korzystać z appto?',
    a: 'Nie. Appto to nasza platforma i przydaje się, kiedy z AI ma korzystać cała firma. Jeśli pracujecie w Copilocie, ChatGPT albo Claude, ustawiamy AI tam.',
  },
  {
    q: 'Co z systemami, do których nie ma integracji?',
    a: 'Podłączamy pocztę, CRM, ERP i programy branżowe, także starsze i bez API. Na diagnozie sprawdzamy Wasze konkretne systemy i mówimy, czy i jak je podłączymy. <a href="/integracja-systemow-z-ai" style="font-weight:700;color:#0a7a52">Jak podłączamy systemy bez integracji →</a>',
  },
  {
    q: 'Kto u nas musi się tym zajmować?',
    a: 'Potrzebujemy osoby, która zna Wasze procesy i znajdzie czas na rozmowy z nami, oraz dostępu do dokumentów i systemów, które podłączamy. Resztę robimy my.',
  },
  {
    q: 'Czy nie uzależnimy się od Was?',
    a: 'Nie. Na koniec wdrożenia przekazujemy zespołowi know-how: jak rozwijać agentów i instrukcje, jak dodawać nowe sprawy i co robić, gdy coś się zmieni. Firma może dalej radzić sobie sama.',
  },
  {
    q: 'Co z danymi firmy?',
    a: 'Do diagnozy nie potrzebujemy dostępu do systemów, a NDA podpisujemy także przed nią, jeśli tego potrzebujecie. Przed startem ustalamy z Wami, do czego AI ma dostęp i co może zrobić.',
  },
  {
    q: 'Czy diagnoza zobowiązuje do współpracy?',
    a: 'Nie. Plan zostaje u Was. Możecie go zrealizować z własnym zespołem albo z inną firmą.',
  },
  {
    q: 'Czym to się różni od Let’s Up i Let’s Shift?',
    a: 'Wdrożenie pod klucz ustawia AI w narzędziach i procesach, które już macie. Programy <a href="/lets-up" style="font-weight:700;color:#0a7a52">Let’s Up</a> i <a href="/lets-shift" style="font-weight:700;color:#0a7a52">Let’s Shift</a> idą dalej: oprócz AI wymieniają albo budują systemy, na których pracuje firma.',
  },
];

const kanon = new URL(ADRES, Astro.site).href;
const dane = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${kanon}#usluga`,
      name: 'Wdrożenie AI pod klucz',
      serviceType: 'Wdrożenie sztucznej inteligencji w firmie',
      url: kanon,
      description: 'Let’s automate poznaje, jak pracuje firma, i ustawia AI za zespół: kontekst firmy, agentów AI i automatyzacje, połączenia z systemami i testy na sprawach firmy. Pierwszy krok to bezpłatna diagnoza zakończona planem z ceną pierwszego etapu.',
      provider: { '@id': new URL('/#organizacja', Astro.site).href },
      areaServed: { '@type': 'Country', name: 'Polska' },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${kanon}#okruszki`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Strona główna', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: 'Wdrożenie AI pod klucz', item: kanon },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${kanon}#faq`,
      mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })),
