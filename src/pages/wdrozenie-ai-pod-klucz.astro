---
<LaBase topbar={false} title={title} description={description} ctaHref="#kontakt" nav="uslugi">
<script type="application/ld+json" is:inline set:html={JSON.stringify(dane)} slot="head"></script>
<KitStyl slot="head" />
<NarzedziaStyl slot="head" />
<style is:global slot="head">
  /* =====================================================================
     HERO: pytanie z reklamy i kadr z reklamy w pętli
     ===================================================================== */
  .pk-hero{position:relative;overflow:hidden;margin:0 var(--ram);border-radius:clamp(20px,2.2vw,32px);padding:clamp(28px,3.4vw,52px) calc(var(--pad) - var(--ram)) clamp(28px,3vw,40px);background:
      radial-gradient(900px 560px at 86% 70%,rgba(0,205,119,0.16),rgba(0,205,119,0) 70%),
      radial-gradient(700px 420px at 4% -10%,rgba(0,205,119,0.06),rgba(0,205,119,0) 70%),
      var(--ink);color:#ffffff}
  .pk-hero-in{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,6.4fr);grid-template-areas:"t v" "r v";column-gap:clamp(32px,5vw,88px);align-items:center;margin-top:0}
  .pk-ht{grid-area:t;align-self:end}
  .pk-hr{grid-area:r;align-self:start}
