      description: 'Let’s automate poznaje, jak pracuje firma, i ustawia AI za zespół: kontekst firmy, agentów AI i automatyzacje, połączenia z systemami i testy na sprawach firmy. Pierwszy krok to bezpłatna diagnoza zakończona planem z ceną pierwszego etapu.',
      provider: { '@id': new URL('/#organizacja', Astro.site).href },
      areaServed: { '@type': 'Country', name: 'Polska' },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${kanon}#okruszki`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Strona główna', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: 'Wdrożenie AI pod klucz', item: kanon },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${kanon}#faq`,
      mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })),
    },
  ],
};
---
<LaBase topbar={false} title={title} description={description} ctaHref="#kontakt" nav="uslugi">
<script type="application/ld+json" is:inline set:html={JSON.stringify(dane)} slot="head"></script>
<KitStyl slot="head" />
<style is:global slot="head">
  /* =====================================================================
     HERO: pytanie z reklamy i kadr z reklamy w pętli
     ===================================================================== */
  .pk-hero{position:relative;overflow:hidden;padding:clamp(28px,3.4vw,52px) var(--pad) clamp(28px,3vw,40px);background:
      radial-gradient(900px 560px at 86% 70%,rgba(0,205,119,0.16),rgba(0,205,119,0) 70%),
      radial-gradient(700px 420px at 4% -10%,rgba(0,205,119,0.06),rgba(0,205,119,0) 70%),
      var(--ink);color:#ffffff}
  .pk-hero-in{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,6.4fr);grid-template-areas:"t v" "r v";column-gap:clamp(32px,5vw,88px);align-items:center;margin-top:0}
  .pk-ht{grid-area:t;align-self:end}
  .pk-hr{grid-area:r;align-self:start}
  .pk-kadr{grid-area:v}
  .pk-ety{display:block;margin:0 0 20px;font-size:15px;font-weight:650;letter-spacing:-0.005em;color:var(--ziel)}
  .pk-h1{margin:0;font-size:clamp(42px,5.1vw,78px);line-height:0.98;letter-spacing:-0.05em;font-weight:800;color:#ffffff;text-wrap:balance}
  .pk-lead{margin:clamp(22px,2.4vw,32px) 0 0;max-width:520px;font-size:clamp(17px,1.35vw,19px);line-height:1.6;color:#C9D1CB;text-wrap:pretty}
  .pk-lead b{display:block;margin-bottom:6px;font-size:clamp(22px,2vw,28px);line-height:1.2;letter-spacing:-0.03em;font-weight:800;color:#ffffff}
  .pk-akcje{display:flex;flex-wrap:wrap;align-items:center;gap:14px 26px;margin-top:clamp(28px,3vw,40px)}
  .pk-po{margin:18px 0 0;font-size:14px;color:#A3ABA5}
  .pk-kl{display:flex;align-items:center;gap:16px clamp(28px,4vw,64px);margin-top:clamp(48px,6vw,88px);padding-top:clamp(22px,2.4vw,32px);border-top:1px solid rgba(255,255,255,0.12)}
  .pk-kl p{flex-shrink:0;max-width:220px;margin:0;font-size:14px;line-height:1.45;color:#A3ABA5}
  .pk-kl strong{color:#ffffff;font-weight:700}
  .pk-kl ul{flex:1;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:4px 32px;margin:0;padding:0;list-style:none}
  .pk-kl img{display:block;height:50px;width:auto;filter:grayscale(1) invert(1);mix-blend-mode:screen;opacity:0.6}
  @media (max-width:900px){
    .pk-kl{flex-direction:column;align-items:flex-start}
    .pk-kl ul{justify-content:flex-start;gap:0 22px}
    .pk-kl img{height:40px}
  }
  .pk-kadr{position:relative;border-radius:clamp(14px,1.6vw,22px);overflow:hidden;box-shadow:0 0 0 1px rgba(255,255,255,0.08),0 50px 100px -50px rgba(0,0,0,0.8)}
  @media (max-width:980px){
    .pk-hero-in{grid-template-columns:minmax(0,1fr);grid-template-areas:"t" "v" "r";row-gap:clamp(24px,4vw,40px)}
    .pk-kadr{margin:0 calc(var(--pad) * -1 + 16px)}
    .pk-lead{margin-top:0}
  }
  @media (max-width:560px){
    .pk-akcje{flex-direction:column;align-items:stretch}
    .pk-akcje .v3-btn{justify-content:space-between}
    .pk-akcje .v3-lnk{align-self:flex-start}
  }

  /* =====================================================================
     PROBLEM: instrukcja wdrożenia, kroki jak znaczniki z reklamy
     ===================================================================== */
  .pk-pr{display:grid;grid-template-columns:minmax(0,6fr) minmax(0,5fr);gap:clamp(40px,6vw,104px);align-items:center}
  .pk-h2s{font-size:clamp(34px,4vw,58px)}
  .pk-pr .v3-sub{margin-top:22px}
  .pk-pr .v3-sub + .v3-sub{margin-top:14px}
  .pk-pr .v3-sub b{color:var(--t1);font-weight:650}
  .pk-is{width:100%;max-width:520px;justify-self:end}
  @media (max-width:900px){ .pk-pr{grid-template-columns:minmax(0,1fr)} .pk-is{justify-self:start;max-width:520px} }

  /* =====================================================================
     PLAN: zielona linia z kropkami, jak w reklamie
     ===================================================================== */
  .pk-plan{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,6.4fr);gap:clamp(40px,6vw,104px);align-items:start}
  .pk-plan-l{position:sticky;top:48px}
  .pk-plan-l .v3-sub{margin-top:24px;max-width:440px}
  .pk-plan-l .v3-btn{margin-top:clamp(28px,3vw,40px)}
  .pk-ph{margin:0;font-size:clamp(28px,2.6vw,40px);line-height:1;letter-spacing:-0.04em;font-weight:800;color:#ffffff}
  .pk-ps{margin:10px 0 0;font-size:clamp(16px,1.3vw,19px);font-weight:500;color:#A3ABA5}
  .pk-os{margin:clamp(28px,3vw,40px) 0 0;padding:0;list-style:none}
  .pk-os li{position:relative;display:grid;grid-template-columns:34px minmax(0,1fr);gap:clamp(18px,2vw,30px);padding-bottom:clamp(26px,2.6vw,38px)}
  .pk-os li:last-child{padding-bottom:0}
  /* linia: szara pod spodem, zielona rośnie, gdy krok wchodzi w kadr */
  .pk-os li::before,.pk-os li::after{content:"";position:absolute;left:15px;top:34px;bottom:-4px;width:4px;border-radius:2px;background:#1F2C24}
  .pk-os li::after{background:var(--ziel);transform:scaleY(0);transform-origin:50% 0;transition:transform .7s cubic-bezier(.4,0,.2,1) .15s}
  .pk-os li:last-child::before,.pk-os li:last-child::after{display:none}
  .pk-nd{position:relative;z-index:1;width:34px;height:34px;border-radius:50%;border:4px solid #3A4A3F;background:var(--ink);margin-top:2px}
  .pk-nd::after{content:"";position:absolute;inset:-4px;border-radius:50%;background:var(--ziel);transform:scale(0);transition:transform .4s cubic-bezier(.34,1.5,.64,1)}
  .pk-os li.on .pk-nd::after{transform:scale(1)}
  .pk-os li.on::after{transform:scaleY(1)}
  .pk-os h3{margin:0;font-size:clamp(22px,2.2vw,32px);line-height:1.08;letter-spacing:-0.035em;font-weight:800;color:#ffffff}
  .pk-os li:last-child h3{color:var(--ziel)}
  .pk-os .p{display:block;margin-top:6px;letter-spacing:-0.005em;line-height:1.35;font-size:clamp(15.5px,1.3vw,18px);font-weight:500;color:#A3ABA5}
  .pk-os-po{margin:clamp(30px,3vw,42px) 0 0 64px;max-width:520px;padding-top:20px;border-top:1px solid rgba(255,255,255,0.14);font-size:16px;line-height:1.6;color:rgba(255,255,255,0.7)}
  .pk-os-po b{color:#ffffff;font-weight:700}
  @media (max-width:560px){ .pk-os-po{margin-left:0} }
  .pk-os p{margin:12px 0 0;max-width:520px;font-size:15.5px;line-height:1.6;color:rgba(255,255,255,0.62);text-wrap:pretty}
  @media (max-width:980px){ .pk-plan{grid-template-columns:minmax(0,1fr)} .pk-plan-l{position:static} }
  /* na telefonie przycisk daje pasek na dole ekranu, w planie byłby drugi raz */
  @media (max-width:720px){ .pk-plan-l .v3-btn{display:none} }

  /* =====================================================================
     ZESPÓŁ NA GOTOWE: prawdziwy appto, rozmowa od polecenia do oferty
     ===================================================================== */
  /* scena oferty: ekran appto w oknie przeglądarki na tle, jak pokazy produktu na appto.ai */
  .pk-ok{max-width:1180px;margin-left:auto;margin-right:auto;position:relative;isolation:isolate;overflow:hidden;margin-top:clamp(36px,4vw,56px);padding:clamp(14px,2.8vw,40px);border-radius:clamp(20px,2vw,28px);background:#C9C3D6}
  .pk-ok .ak.czat{display:none}
  .pk-ok .ak.czat .w-top{padding-left:96px}
  .pk-ok .ak.czat .w-rail{display:none}
  .pk-ok .ak.czat [data-w="w-chat"]{width:600px}
  .ak.krotki .w-rail{top:140px}
  @media (max-width:760px){ .pk-ok .ak.caly{display:none} .pk-ok .ak.czat{display:block} }
  .pk-ok-wy{display:flex;align-items:center;gap:clamp(18px,2.4vw,32px);margin-top:clamp(28px,3vw,40px);padding:clamp(18px,2vw,24px) 0;border-top:1px solid var(--linia);border-bottom:1px solid var(--linia)}
  .pk-ok-wy b{flex-shrink:0;font-size:clamp(44px,5vw,72px);line-height:0.9;letter-spacing:-0.05em;font-weight:800;color:var(--t1)}
  .pk-ok-wy p{margin:0;font-size:clamp(15.5px,1.3vw,18px);line-height:1.5;color:var(--t2);text-wrap:pretty}
  .pk-ok-wy span{display:block;font-weight:700;color:var(--t1)}
  .pk-ok-op{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px clamp(32px,5vw,88px);margin-top:clamp(32px,3.4vw,48px)}
  .pk-ok-op p{margin:0;font-size:clamp(16px,1.3vw,18px);line-height:1.6;color:var(--t2);text-wrap:pretty}
  .pk-ok-op b{color:var(--t1);font-weight:700}
  .pk-ok-op small{display:block;margin-top:12px;font-size:13.5px;color:var(--t3)}
  @media (max-width:760px){ .pk-ok-op{grid-template-columns:minmax(0,1fr)} }

  /* =====================================================================
     DOWODY: liczby, logotypy i wyniki ze strony głównej, cytat
     ===================================================================== */
  .pk-li{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:clamp(40px,4.4vw,64px);border-top:1px solid var(--linia)}
  .pk-li div{padding:clamp(20px,2.4vw,32px) clamp(16px,2vw,28px) 0 0}
  .pk-li div + div{padding-left:clamp(16px,2vw,28px);border-left:1px solid var(--linia)}
  .pk-li b{display:block;font-size:clamp(44px,6vw,92px);line-height:0.95;letter-spacing:-0.05em;font-weight:800;color:var(--t1)}
  .pk-li span{display:block;margin-top:8px;font-size:clamp(15px,1.3vw,18px);color:var(--t2)}
  /* przykłady jak „AI na każdą potrzebę” na appto.ai: okno przeglądarki na tle */
  .pk-mz2{margin-top:clamp(32px,3.4vw,48px)}
  .pk-mz2-st{max-width:1180px;margin:0 auto;position:relative;isolation:isolate;overflow:hidden;padding:clamp(14px,2.8vw,40px) clamp(10px,2.8vw,40px) clamp(14px,2.2vw,32px);border-radius:clamp(20px,2vw,28px);background:#C9C3D6}
  .pk-mz2-bg{position:absolute;inset:0;z-index:-1;width:100%;height:100%;object-fit:cover}
  .pk-mz2-s{display:none}
  .pk-mz2-s.on{display:block}
  .pk-mz2-pod{position:relative;min-height:3.2em;max-width:820px;margin:18px auto 0;text-align:center}
  .pk-mz2-pod p{display:none;margin:0;font-size:15px;line-height:1.55;color:var(--t2);text-wrap:pretty}
  .pk-mz2-pod p.on{display:block}
  .pk-mz2-pod b{color:var(--t1);font-weight:700}
  .pk-mz2-pod .w{color:var(--t2)}
  @media (max-width:560px){
    .pk-li b{font-size:38px}
    .pk-li span{font-size:14px}
  }

  /* =====================================================================
     DIAGNOZA: od formularza do planu, obok to, co jest w planie
     ===================================================================== */
  .pk-dg{display:grid;grid-template-columns:minmax(0,6fr) minmax(0,5fr);gap:clamp(40px,6vw,104px);align-items:start;margin-top:clamp(44px,5vw,72px)}
  .pk-dk{margin:0;padding:0;list-style:none}
  .pk-dk li{position:relative;display:grid;grid-template-columns:40px minmax(0,1fr);gap:20px;padding-bottom:34px}
  .pk-dk li:last-child{padding-bottom:0}
  .pk-dk li::before{content:"";position:absolute;left:19.5px;top:46px;bottom:6px;width:1px;background:repeating-linear-gradient(180deg,rgba(15,26,20,0.3) 0 5px,transparent 5px 11px)}
  .pk-dk li:last-child::before{display:none}
  .pk-dn{display:grid;place-items:center;width:40px;height:40px;border-radius:50%;box-shadow:inset 0 0 0 1px rgba(15,26,20,0.22);font-size:14px;font-weight:700;color:var(--t1)}
  .pk-dk li.mocny .pk-dn{background:var(--ziel);box-shadow:none;color:var(--ink)}
  .pk-dk h3{margin:7px 0 0;font-size:clamp(19px,1.7vw,23px);font-weight:750;letter-spacing:-0.025em;line-height:1.15;color:var(--t1)}
  .pk-dk .kiedy{display:block;margin-top:4px;font-size:14px;font-weight:600;color:var(--ziel-c)}
  .pk-dk p{margin:10px 0 0;max-width:520px;font-size:15.5px;line-height:1.6;color:var(--t2);text-wrap:pretty}
  .pk-dos{display:flex;align-items:center;gap:10px;margin-top:12px;font-size:13.5px;line-height:1.3;color:var(--t3)}
  .pk-dos img{flex-shrink:0;width:32px;height:32px;border-radius:50%;object-fit:cover;object-position:50% 14%}
  .pk-dos b{display:block;font-weight:650;color:var(--t1)}
  /* kartka planu: wydruk leżący na tle (obiekt, nie karta interfejsu) */
  .pk-kt{margin:0;justify-self:center;width:100%;max-width:470px}
  .pk-kt-p{position:relative;padding:28px 30px 26px;border-radius:3px;background:#fffefb;color:#141a16;transform:rotate(-1.2deg);box-shadow:0 1px 0 rgba(0,0,0,.04),0 2px 6px -2px rgba(20,30,22,.18),0 40px 70px -40px rgba(20,30,22,.55)}
  .pk-kt-gl{display:flex;justify-content:space-between;align-items:center;gap:10px;padding-bottom:12px;border-bottom:1px solid rgba(15,26,20,.14);font-size:12px;color:#7a827c}
  .pk-kt-gl span:first-child{display:inline-flex;align-items:center;gap:7px;font-weight:700;color:#141a16}
  .pk-kt-gl svg{width:14px;height:14px}
  .pk-kt-t{display:block;margin-top:18px;font-size:27px;font-weight:800;letter-spacing:-.035em;line-height:1.05}
  .pk-kt-f{display:block;margin-top:4px;font-size:13.5px;color:#5f6a63}
  .pk-kt ol{margin:18px 0 0;padding:0;list-style:none}
  .pk-kt li{display:grid;grid-template-columns:30px minmax(0,1fr);gap:4px;padding:11px 0;border-top:1px solid rgba(15,26,20,.09)}
  .pk-kt em{font-style:normal;font-family:var(--mono);font-size:12px;line-height:1.6;color:var(--ziel-c)}
  .pk-kt li b{display:block;font-size:14.5px;font-weight:700}
  .pk-kt li span{display:block;margin-top:2px;font-size:13.5px;line-height:1.45;color:#4f5a53}
  .pk-kt-c{display:flex;align-items:baseline;justify-content:space-between;gap:14px;flex-wrap:wrap;margin-top:8px;padding-top:14px;border-top:1.5px solid #141a16;font-size:13px;color:#5f6a63}
  .pk-kt-c .pole{padding:2px 8px 3px;border-bottom:2px dashed #0a7a52;background:rgba(0,205,119,.12);font-weight:700;color:#0a5c3e}
  .pk-kt figcaption{margin-top:22px;font-size:14px;line-height:1.5;color:var(--t3);text-align:center}
  @media (max-width:980px){ .pk-dg{grid-template-columns:minmax(0,1fr)} }

  #kontakt{padding-top:clamp(64px,8vw,120px);padding-bottom:clamp(56px,7vw,96px);background:#ffffff}
  .v3 > .v3-sek{padding-top:clamp(80px,9vw,140px);padding-bottom:clamp(80px,9vw,140px)}

  /* =====================================================================
     TELEFON: przycisk przyklejony do dołu ekranu między hero a formularzem
     ===================================================================== */
  .pk-pasek{display:none}
  @media (max-width:720px){
    .pk-pasek{display:block;position:fixed;left:12px;right:12px;bottom:12px;z-index:50;transform:translateY(140%);transition:transform .35s cubic-bezier(.2,.8,.2,1)}
    .pk-pasek.on{transform:none}
    .pk-pasek .v3-btn{display:flex;justify-content:space-between;width:100%;box-shadow:0 18px 40px -16px rgba(7,20,13,0.7)}
  }
  @media (prefers-reduced-motion:reduce){ .pk-pasek,.pk-os li::after,.pk-nd::after{transition:none} }
</style>

<div class="v3">
<Styl />
<Anim />

<!-- ============ 1 · HERO ============
     Nagłówek = pytanie z reklamy (?h= podmienia go na inny hak z testu,
     skrypt zaraz pod nagłówkiem). Kadr z reklamy w pętli obok. -->
<section class="pk-hero" id="start">
<div class="pk-hero-in">
<div class="pk-ht">
<span class="pk-ety">Wdrożenie AI pod klucz</span>
<h1 class="pk-h1" data-naglowek>Przytłacza Cię wdrażanie AI w&nbsp;firmie?</h1>
<script is:inline>
  (function(){
    var H = {
      h02: 'AI w firmie kupione. Kto je teraz ustawi?',
      h03: 'Licencje na AI są. Ile osób naprawdę z nich korzysta?',
      h04: 'Wdrożenie AI czeka, aż znajdziesz wolny tydzień?',
      h05: 'Ile kroków dzieli Twoją firmę od działającego AI?',
      h06: 'Kontekst, instrukcje, skille, testy. Kto to u Was złoży?',
      h07: 'Chcesz AI w firmie, ale nie masz kiedy go wdrożyć?'
    };
    try {
      var h = (new URLSearchParams(location.search).get('h') || '').toLowerCase();
      if (H[h]) { document.querySelector('[data-naglowek]').textContent = H[h]; document.documentElement.dataset.hak = h; }
    } catch (e) {}
  })();
</script>
</div>
<div class="pk-hr">
<p class="pk-lead"><b>Zrobimy to za Was</b>Poznajemy, jak pracuje Twoja firma, i ustawiamy AI za Was. Podłączamy je też do Waszych systemów, a zespół wchodzi na gotowe.</p>
<div class="pk-akcje">
<a href="#kontakt" class="v3-btn">{CTA} <span aria-hidden="true">→</span></a>
<a href="#plan" class="v3-lnk">Zobacz, jak wygląda wdrożenie pod klucz</a>
</div>
<p class="pk-po">{CTA_POD}</p>
</div>
<div class="pk-kadr">
<PulpitMontaz />
</div>
</div>
<!-- Dół hero: klienci zamiast zapowiedzi diagnozy (v2, Szymon: dół hero
     „zlewa się” z sekcją diagnozy). Logotypy jak w pasku pod hero podstron. -->
<div class="pk-kl">
<p><strong>140+ firm</strong> zmienia z nami sposób działania</p>
<ul>
{LOGA.map(([plik, nazwa, w]) => (<li><img src={`/uploads/klienci/${plik}`} alt={nazwa} width={w} height="88" loading="lazy"></li>))}
</ul>
</div>
</section>

<!-- ============ 2 · PROBLEM ============ -->
<section id="problem" class="v3-sek">
<div class="pk-pr">
<div>
<h2 class="v3-h2 pk-h2s">Wdrożenie AI na własną rękę to długa lista kroków</h2>
<p class="v3-sub">Wdrożenia AI najczęściej stoją z dwóch powodów. W firmie brakuje czasu, żeby się tym zająć, i brakuje know-how, żeby zrobić to dobrze i przekonać zespół.</p>
<p class="v3-sub"><b>Know-how da się uzupełnić, ale bez czasu nic to nie da.</b> Wdrożenie ciągnie się wtedy miesiącami bez wyraźnego postępu. Lista pokazuje, na co idzie ten czas.</p>
</div>
<div class="pk-is"><ListaKrokow /></div>
</div>
</section>

<!-- ============ 3 · PLAN 6 KROKÓW ============
     Tytuły i podpisy kroków słowo w słowo z reklamy. -->
<section id="plan" class="v3-sek v3-scena v3-ziarno">
<div class="pk-plan">
<div class="pk-plan-l">
<h2 class="v3-h2 jasny">Zrobimy to za Was</h2>
<p class="v3-sub jasny">Wy pokazujecie, jak pracujecie, i dajecie dostęp do dokumentów i systemów. Resztę składamy my.</p>
<a href="#kontakt" class="v3-btn">{CTA} <span aria-hidden="true">→</span></a>
</div>
