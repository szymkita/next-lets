{/* SKĄD PRZYSZEDŁ KLIENT: UTM-y z linku reklamy (schemat z WYTYCZNE-reklamy §7:
     utm_source={{site_source_name}}, utm_medium=reklama, utm_campaign=lets-meta,
     utm_content=pod-klucz, utm_term={{ad.name}}) i wariant nagłówka ?h=
     dopisują się do data-zrodlo formularza, zanim ruszy jego skrypt (moduł).
     Zapis w sessionStorage, żeby przetrwały przeładowanie. */}
<script is:inline>
  (function(){
    var K = ['utm_source','utm_medium','utm_campaign','utm_content','utm_term'], u = {};
    try {
      var p = new URLSearchParams(location.search);
      K.forEach(function(k){ var v = (p.get(k) || '').replace(/[^\w.-]/g, '').slice(0, 60); if(v) u[k] = v; });
      if(Object.keys(u).length) sessionStorage.setItem('pk-utm', JSON.stringify(u));
      else u = JSON.parse(sessionStorage.getItem('pk-utm') || '{}') || {};
    } catch(e){}
    var d = '';
    var w = K.map(function(k){ return u[k]; }).filter(Boolean);
    if(w.length) d += ' · utm ' + w.join('/');
    var hak = document.documentElement.dataset.hak;
    if(hak) d += ' · nagłówek ' + hak;
    if(!d) return;
    document.querySelectorAll('[data-zrodlo]').forEach(function(f){ f.dataset.zrodlo += d; });
  })();
</script>

<script>
  var redukcja = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- Skalowanie scen o stałym rozmiarze (kadr z reklamy, kit appto) ----
  (function(){
    var sceny = Array.prototype.slice.call(document.querySelectorAll('[data-pm],[data-lk],[data-ak-skaluj]')) as HTMLElement[];
    function licz(el: HTMLElement){
      var w = el.clientWidth;
      if(!w) return;
      if(el.hasAttribute('data-pm')) el.style.setProperty('--ps', String(w / 1080));
      else if(el.hasAttribute('data-lk')) el.style.setProperty('--lk', String(w / 560));
      else el.style.setProperty('--s', String(w / parseFloat(getComputedStyle(el).getPropertyValue('--kk') || '1920')));
    }
    sceny.forEach(licz);
    if('ResizeObserver' in window){
      var ro = new ResizeObserver(function(w){ w.forEach(function(x){ licz(x.target as HTMLElement); }); });
      sceny.forEach(function(s){ ro.observe(s); });
    } else window.addEventListener('resize', function(){ sceny.forEach(licz); });
  })();

  // ---- HERO: kadr z reklamy, potem zespół przy gotowym narzędziu ----
  // 0–8 s: okna i znaczki kroków według data-t, duży licznik. 8,2 s: wszystko
  // wpada w ekran, instrukcja się zamyka, „Zrobimy to za Was”. Od 10,8 s trzy
  // puste okna appto; kursory Marty, Tomka i Ani wchodzą po kolei, klikają
  // kompozytor, piszą polecenie i wysyłają, a wynik pojawia się po nich.
  // Pętla stoi, kiedy hero nie widać. Bez ruchu zostaje stan końcowy (.stat).
  (function(){
    var pm = document.querySelector('[data-pm]') as HTMLElement | null;
    if(!pm || redukcja || !('IntersectionObserver' in window)) return;
    var el = Array.prototype.slice.call(pm.querySelectorAll('[data-t]')) as HTMLElement[];
    var la = pm.querySelector('[data-t-la]') as HTMLElement;
    var okna = Array.prototype.slice.call(pm.querySelectorAll('[data-pz]')) as HTMLElement[];
    var kursory = Array.prototype.slice.call(pm.querySelectorAll('[data-pz-k]')) as HTMLElement[];
    var puste = okna.map(function(o){ return (o.querySelector('[data-pz-pole]') as HTMLElement).innerHTML; });
    var T = { zwin: 8200, app: 8700, la: 9300, laOff: 10700, zespol: 10800, reset: 23500, od: 24300 };
    var timery: number[] = [], widac = false;
    function czysc(){ timery.forEach(function(t){ clearTimeout(t); }); timery = []; }
    function po(ms: number, fn: () => void){ timery.push(window.setTimeout(fn, ms)); }
    function xy(k: HTMLElement, v: string){ var p = v.split(','); k.style.setProperty('--x', p[0] + 'px'); k.style.setProperty('--y', p[1] + 'px'); }
    function osoba(k: HTMLElement){
      var i = +(k.dataset.pzK || 0), okno = okna[i];
      var pole = okno.querySelector('[data-pz-pole]') as HTMLElement;
      var msg = okno.querySelector('[data-pz-msg]') as HTMLElement;
      var tekst = (msg.firstChild && msg.firstChild.textContent) || '';
      var wzm = msg.querySelector('.w-mention');
      var t = +(k.dataset.t0 || 0);
      var cel = k.dataset.cel || '0,0', c = cel.split(',').map(Number);
      po(t, function(){ k.classList.add('bez'); xy(k, k.dataset.start || cel); k.classList.add('on'); });
      po(t + 60, function(){ k.classList.remove('bez'); xy(k, cel); });
      po(t + 1450, function(){ k.classList.add('klik'); pole.innerHTML = '<span class="ak-kursor"></span>'; });
      po(t + 1600, function(){ k.classList.remove('klik'); });
      var t1 = t + 1750;
      for(var n = 1; n <= tekst.length; n++){
        (function(n){ po(t1 + n * 55, function(){ pole.textContent = tekst.slice(0, n); var kk = document.createElement('span'); kk.className = 'ak-kursor'; pole.appendChild(kk); }); })(n);
      }
      var t2 = t1 + tekst.length * 55 + 200;
      if(wzm) po(t2, function(){ pole.insertBefore(wzm!.cloneNode(true), pole.querySelector('.ak-kursor')); });
      po(t2 + 500, function(){ okno.classList.add('wyslij'); k.classList.add('klik'); });
      po(t2 + 650, function(){ k.classList.remove('klik'); });
      po(t2 + 800, function(){ okno.classList.remove('wyslij'); pole.innerHTML = puste[i]; okno.classList.add('f1'); xy(k, (c[0] + 70) + ',' + (c[1] + 60)); });
      po(t2 + 1500, function(){ okno.classList.add('f2'); });
      po(t2 + 2500, function(){ okno.classList.add('f3'); });
    }
    function start(){
      czysc();
      pm!.classList.remove('stat', 'zwin', 'app', 'reset', 'zespol');
      el.forEach(function(e){ e.classList.remove('on'); });
      la.classList.remove('on');
      okna.forEach(function(o, i){ o.classList.remove('f1', 'f2', 'f3', 'wyslij'); (o.querySelector('[data-pz-pole]') as HTMLElement).innerHTML = puste[i]; });
      kursory.forEach(function(k){ k.classList.remove('on', 'klik'); });
      el.forEach(function(e){ po(+(e.dataset.t || 0), function(){ e.classList.add('on'); }); });
      po(T.zwin, function(){ pm!.classList.add('zwin'); });
      po(T.app, function(){ pm!.classList.add('app'); });
      po(T.la, function(){ la.classList.add('on'); });
      po(T.laOff, function(){ la.classList.remove('on'); });
      po(T.zespol, function(){ pm!.classList.add('zespol'); });
      kursory.forEach(osoba);
      po(T.reset, function(){ pm!.classList.add('reset'); });
      po(T.od, function(){ if(widac) start(); });
    }
    new IntersectionObserver(function(w){
      var teraz = w[0].isIntersecting;
      if(teraz && !widac){ widac = true; start(); }
      else if(!teraz && widac){ widac = false; czysc(); }
    }, { threshold: 0.2 }).observe(pm);
  })();

  // ---- PROBLEM: lista kroków, najpierw czerwona, potem zielona ----
  // Gra raz, kiedy scena wejdzie w kadr, i stoi na końcu (cała lista
  // zielona). Kroki wpadają od razu i coraz szybciej; lista przewija się
  // w oknie o całe wiersze, a wiersze nad oknem gasną. Zwrot „Tym wszystkim
  // zajmiemy się my”, lista wraca na górę i po kolei robi się zielona.
  (function(){
    var lk = document.querySelector('[data-lk]') as HTMLElement | null;
    if(!lk || redukcja || !('IntersectionObserver' in window)) return;
    var N = +(lk.dataset.n || 0), H = +(lk.dataset.wiersz || 64), V = +(lk.dataset.widac || 8);
    var wejscia = JSON.parse(lk.dataset.wejscia || '[]') as number[];
    var zwrot = +(lk.dataset.zwrot || 0), zielen = +(lk.dataset.zielen || 0);
    var lista = lk.querySelector('[data-lk-lista]') as HTMLElement;
    var wiersze = Array.prototype.slice.call(lk.querySelectorAll('.lk-k')) as HTMLElement[];
    var zr = lk.querySelector('[data-lk-zr]') as HTMLElement, pas = lk.querySelector('[data-lk-pas]') as HTMLElement;
    var pod = lk.querySelector('[data-lk-pod]') as HTMLElement;
    function kroki(n: number){ var r = n % 10, rr = n % 100; return n + (n === 1 ? ' krok' : (r >= 2 && r <= 4 && (rr < 12 || rr > 14)) ? ' kroki' : ' kroków'); }
    function przewin(od: number){
      lista.style.setProperty('--y', (-od * H) + 'px');
      wiersze.forEach(function(w, i){ w.classList.toggle('poza', i < od || i >= od + V); });
    }
    lk.classList.remove('stat');
    zr.textContent = '0'; pas.style.setProperty('--p', '0'); pod.textContent = '0 kroków';
    przewin(0);
    var ruszylo = false;
    function start(){
      ruszylo = true;
      wejscia.forEach(function(t, i){
        window.setTimeout(function(){
          if(i >= V) przewin(i - V + 1);
          wiersze[i].classList.add('on');
          pod.textContent = kroki(i + 1) + ', zrobione: 0';
        }, t);
      });
      window.setTimeout(function(){ lk!.classList.add('zwrot'); }, zwrot);
      window.setTimeout(function(){ przewin(0); }, zwrot + 500);
      window.setTimeout(function(){ lk!.classList.remove('zwrot'); lk!.classList.add('zielen'); }, zielen);
      var t = zielen + 300, d = 380;
      for(var j = 0; j < N; j++){
        (function(j, t){
          window.setTimeout(function(){
            var od = Math.min(N - V, Math.max(0, j - V + 3));
            przewin(od);
            wiersze[j].classList.add('zrob');
            zr.textContent = String(j + 1);
            pas.style.setProperty('--p', String((j + 1) / N));
            pod.textContent = j + 1 === N ? kroki(N) + ', zrobione wszystkie' : kroki(N) + ', zrobione: ' + (j + 1);
          }, t);
        })(j, t);
        t += d; d = Math.max(90, d * 0.88);
      }
    }
    var io = new IntersectionObserver(function(w){
      if(w[0].isIntersecting && !ruszylo){ start(); io.disconnect(); }
    }, { threshold: 0.4 });
    io.observe(lk);
  })();

  // ---- PLAN: kropki zapalają się, linia rośnie, gdy krok wchodzi w kadr ----
  (function(){
    var li = Array.prototype.slice.call(document.querySelectorAll('[data-os] li')) as HTMLElement[];
    if(!li.length) return;
    if(redukcja || !('IntersectionObserver' in window)){ li.forEach(function(x){ x.classList.add('on'); }); return; }
    var io = new IntersectionObserver(function(w){
      w.forEach(function(x){ if(x.isIntersecting){ x.target.classList.add('on'); io.unobserve(x.target); } });
    }, { rootMargin: '0px 0px -35% 0px' });
    li.forEach(function(x){ io.observe(x); });
  })();

  // ---- APPTO: praca od stanu „przed” (studio/ZASADY.md) ----
  // v4: od początku pełny ekran appto w oknie przeglądarki, pusty czat (v3 miał
  // sam kompozytor, Szymon: „toporne”). Wchodzi kursor Marty, klika, pisze
  // polecenie i wysyła; potem kroki z HubSpota, notatek i Kontekstu, dokument wjeżdża z prawej
  // i jego pola wypełniają się po kolei, na końcu „Gotowe” z kartą dokumentu.
  // Pętla, póki scena jest w kadrze; po wyjściu z kadru wraca do pustego czatu.
  // Przy ograniczonym ruchu stan końcowy.
  (function(){
    var kity = Array.prototype.slice.call(document.querySelectorAll('[data-ak-demo]')) as HTMLElement[];
    if(!kity.length) return;
    if(redukcja || !('IntersectionObserver' in window)){ kity.forEach(function(ak){ ak.classList.remove('gra'); }); return; }
    kity.forEach(function(ak){
      var pole = ak.querySelector('[data-w="w-composer-text"]') as HTMLElement;
      var msg = ak.querySelector('[data-w="w-msg1"]') as HTMLElement;
      var tytul = ak.querySelector('[data-w="w-top-title"]') as HTMLElement;
      var kur = ak.querySelector('[data-ak-kur]') as HTMLElement;
      var pola = Array.prototype.slice.call(ak.querySelectorAll('.w-field')) as HTMLElement[];
      var wzmianka = msg.querySelector('.w-mention') as HTMLElement;
      var tekst = (msg.firstChild && msg.firstChild.textContent) || '';
      var pusto = pole.innerHTML, tytulKoniec = tytul.textContent || '';
      // cel kursora: pole tekstowe kompozytora na dole pustego czatu (px logiczne kitu)
      var czat = ak.classList.contains('czat');
      var wys = parseFloat(getComputedStyle(ak).getPropertyValue('--kh')) || 1080;
      var cel = czat ? [190, wys - 125] : [720, wys - 125], skad = czat ? [600, wys - 330] : [1500, wys - 330];
      var timery: number[] = [], widac = false;
      function czysc(){ timery.forEach(function(t){ clearTimeout(t); }); timery = []; }
      function po(ms: number, fn: () => void){ timery.push(window.setTimeout(fn, ms)); }
      function faza(n: number){ for(var i = 1; i <= 7; i++) ak.classList.toggle('f' + i, i <= n); }
      var scroll = ak.querySelector('[data-w="w-scroll"]') as HTMLElement | null;
      var strona = ak.querySelector('[data-w="w-page"]') as HTMLElement | null;
      var plotno = ak.querySelector('.w-canvas') as HTMLElement | null;
      function przewin(dol: boolean){
        if(!scroll || !strona || !plotno) return;
        var ile = dol ? Math.max(0, scroll.offsetTop + strona.offsetHeight + 28 - plotno.clientHeight) : 0;
        scroll.style.transition = dol ? 'transform 3.2s cubic-bezier(.45,0,.2,1)' : 'none';
        scroll.style.transform = 'translateY(' + (-ile) + 'px)';
      }
      function kursor(x: number, y: number, bez?: boolean){ kur.classList.toggle('bez', !!bez); kur.style.setProperty('--kx', x + 'px'); kur.style.setProperty('--ky', y + 'px'); }
      function przed(){
        czysc();
        ak.classList.add('gra');
        ak.classList.remove('wyslij');
        faza(0);
        pola.forEach(function(f){ f.classList.add('pusty'); });
        tytul.textContent = 'Nowa rozmowa';
        pole.innerHTML = pusto;
        kur.classList.remove('on', 'klik');
        kursor(skad[0], skad[1], true);
        przewin(false);
      }
      function start(){
        przed();
        po(500, function(){ kur.classList.add('on'); });
        po(560, function(){ kursor(cel[0], cel[1]); });
        po(1900, function(){ kur.classList.add('klik'); pole.innerHTML = '<span class="ak-kursor"></span>'; });
        po(2050, function(){ kur.classList.remove('klik'); });
        var t = 2200;
        for(var i = 1; i <= tekst.length; i++){
          (function(n){ po(t + n * 45, function(){ pole.innerHTML = ''; pole.appendChild(document.createTextNode(tekst.slice(0, n))); var k = document.createElement('span'); k.className = 'ak-kursor'; pole.appendChild(k); }); })(i);
        }
        t += tekst.length * 45 + 150;
        po(t, function(){ var k = pole.querySelector('.ak-kursor'); pole.insertBefore(wzmianka.cloneNode(true), k); });
        t += 700;
        po(t, function(){ ak.classList.add('wyslij'); kur.classList.add('klik'); kursor(cel[0] + (czat ? 420 : 560), cel[1]); });
        po(t + 150, function(){ kur.classList.remove('klik'); });
        po(t + 300, function(){ ak.classList.remove('wyslij'); pole.innerHTML = pusto; kur.classList.remove('on'); });
        po(t + 1000, function(){ tytul.textContent = tytulKoniec; faza(1); });
        po(t + 1800, function(){ faza(2); });
        po(t + 2500, function(){ faza(3); });
        po(t + 3300, function(){ faza(4); });
        po(t + 4100, function(){ faza(5); });
        po(t + 5000, function(){ faza(6); });
        pola.forEach(function(f, i){ po(t + 6100 + i * 420, function(){ f.classList.remove('pusty'); }); });
        po(t + 6100 + pola.length * 420 + 300, function(){ faza(7); });
        // dokument przewija się do wyceny i harmonogramu, żeby było widać, z czego jest suma
        po(t + 6100 + pola.length * 420 + 900, function(){ przewin(true); });
        po(t + 17000, function(){ if(widac) start(); });
      }
      przed();
      new IntersectionObserver(function(w){
        var teraz = w[0].isIntersecting;
        if(teraz && !widac){ widac = true; start(); }
        else if(!teraz && widac){ widac = false; przed(); }
      }, { threshold: 0.35 }).observe(ak);
    });
  })();

  // ---- CO JESZCZE MOŻE PRZEJĄĆ AI: karty przeglądarki jak na appto.ai ----
  // Wybrana karta: wątek stoi zrobiony, po chwili poprawka pisana w kompozytorze,
  // wysłana, kroki, odpowiedź i zmiana w pliku. Potem następna karta; pasek
  // na karcie pokazuje, ile zostało. Kliknięcie wybiera kartę i zatrzymuje
  // przełączanie. Poza kadrem stoi. Przy ograniczonym ruchu stan po poprawce.
  (function(){
    var mz = document.querySelector('[data-mz]') as HTMLElement | null;
    if(!mz) return;
    var karty = Array.prototype.slice.call(mz.querySelectorAll('[data-karta]')) as HTMLElement[];
    var sceny = Array.prototype.slice.call(mz.querySelectorAll('[data-mz-s]')) as HTMLElement[];
    var podpisy = Array.prototype.slice.call(mz.querySelectorAll('[data-mz-p]')) as HTMLElement[];
    var okna = sceny.map(function(s){ return s.querySelector('[data-op]') as HTMLElement; });
    var biez = 0, timery: number[] = [], widac = false, sam = true;
    function czysc(){ timery.forEach(function(t){ clearTimeout(t); }); timery = []; }
    function po(ms: number, fn: () => void){ timery.push(window.setTimeout(fn, ms)); }
    function koniec(o: HTMLElement){ var n = +(o.dataset.fazy || 3); for(var k = 1; k <= n; k++) o.classList.add('f' + k); o.classList.add('zmiana'); }
    function zeruj(o: HTMLElement){ for(var k = 1; k <= 8; k++) o.classList.remove('f' + k); o.classList.remove('zmiana', 'wyslij'); var pole = o.querySelector('[data-op-pole]') as HTMLElement; pole.innerHTML = '<span class="w-composer-ph">Pokieruj agentem…</span>'; }
    function pokaz(i: number){
      biez = i;
      karty.forEach(function(b, j){ b.classList.toggle('is-on', i === j); b.classList.remove('gra'); b.setAttribute('aria-selected', i === j ? 'true' : 'false'); });
      sceny.forEach(function(s, j){ s.classList.toggle('on', i === j); });
      podpisy.forEach(function(p, j){ p.classList.toggle('on', i === j); });
      window.dispatchEvent(new Event('resize'));
    }
    function graj(i: number){
      czysc();
      pokaz(i);
      var o = okna[i];
      if(redukcja){ koniec(o); return; }
      zeruj(o);
      var pole = o.querySelector('[data-op-pole]') as HTMLElement, tekst = o.dataset.pol || '', n = +(o.dataset.fazy || 3);
      var t = 1400;
      po(t - 150, function(){ pole.innerHTML = '<span class="ak-kursor"></span>'; });
      for(var c = 1; c <= tekst.length; c++){
        (function(c){ po(t + c * 40, function(){ pole.textContent = tekst.slice(0, c); var k = document.createElement('span'); k.className = 'ak-kursor'; pole.appendChild(k); }); })(c);
      }
      t += tekst.length * 40 + 500;
      po(t, function(){ o.classList.add('wyslij'); });
      po(t + 250, function(){ o.classList.remove('wyslij'); pole.innerHTML = '<span class="w-composer-ph">Pokieruj agentem…</span>'; });
      for(var f = 1; f <= n; f++){ (function(f){ po(t + 250 + f * 750, function(){ o.classList.add('f' + f); }); })(f); }
      t += 250 + n * 750 + 400;
      po(t, function(){ o.classList.add('zmiana'); });
      var calosc = t + 4200;
      var karta = karty[i];
      karta.style.setProperty('--czas', calosc + 'ms');
      if(sam){ requestAnimationFrame(function(){ requestAnimationFrame(function(){ karta.classList.add('gra'); }); }); po(calosc, function(){ if(widac) graj((biez + 1) % sceny.length); }); }
    }
    karty.forEach(function(b, i){
      b.addEventListener('click', function(){ sam = false; graj(i); });
      b.addEventListener('keydown', function(e){
        if(e.key === 'ArrowRight' || e.key === 'ArrowLeft'){ e.preventDefault(); var j = (i + (e.key === 'ArrowRight' ? 1 : -1) + karty.length) % karty.length; sam = false; graj(j); karty[j].focus(); }
      });
    });
    if(!('IntersectionObserver' in window)){ okna.forEach(koniec); return; }
    new IntersectionObserver(function(w){
      var teraz = w[0].isIntersecting;
      if(teraz && !widac){ widac = true; graj(biez); }
      else if(!teraz && widac){ widac = false; czysc(); }
    }, { threshold: 0.3 }).observe(mz);
  })();

  // ---- Telefon: przycisk na dole ekranu, gdy hero i formularz są poza kadrem ----
  (function(){
    var pasek = document.querySelector('[data-pasek]') as HTMLElement | null;
    var hero = document.getElementById('start'), kontakt = document.getElementById('kontakt'), faq = document.getElementById('faq');
    if(!pasek || !hero || !kontakt || !('IntersectionObserver' in window)) return;
    var stan: Record<string, boolean> = { start: true, kontakt: false, faq: false };
    var io = new IntersectionObserver(function(w){
      w.forEach(function(x){ stan[(x.target as HTMLElement).id] = x.isIntersecting; });
      var pokaz = !stan.start && !stan.kontakt && !stan.faq;
      pasek!.classList.toggle('on', pokaz);
      pasek!.setAttribute('aria-hidden', pokaz ? 'false' : 'true');
      pasek!.querySelector('a')!.tabIndex = pokaz ? 0 : -1;
    });
    [hero, kontakt, faq].forEach(function(s){ if(s) io.observe(s); });
  })();

  // ---- Meta: zdarzenie „Lead” po wysłanym formularzu ----
  // Moduł Kontakt wysyła `la:pomiar` z `formularz_sukces`. Piksel ładuje
  // Zgody.astro dopiero po zgodzie na marketing; bez zgody nic nie idzie.
  // Ten sam sukces trafia do GTM (dataLayer `formularz_wyslany`) — jeśli
  // kontener GTM ma już tag „Lead”, ten fragment trzeba wyłączyć, żeby nie
  // liczyć zgłoszeń podwójnie.
  document.addEventListener('la:pomiar', function(e){
    var d = (e as CustomEvent).detail || {};
    if(d.event !== 'formularz_sukces') return;
    var w = window as any;
    try { if(typeof w.fbq === 'function') w.fbq('track', 'Lead', { content_name: 'Wdrożenie AI pod klucz' }); } catch(err){}
  });
</script>
