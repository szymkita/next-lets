{/* SKĄD PRZYSZEDŁ KLIENT: UTM-y z linku reklamy (schemat z WYTYCZNE-reklamy §7:
     utm_source={{site_source_name}}, utm_medium=reklama, utm_campaign=lets-meta,
     utm_content=pod-klucz, utm_term={{ad.name}}) i wariant nagłówka ?h=
     dopisują się do data-zrodlo formularza, zanim ruszy jego skrypt (moduł).
     Zapis w sessionStorage, żeby przetrwały przeładowanie. */}
<script is:inline>
  (function(){
    var K = ['utm_source','utm_medium','utm_campaign','utm_content','utm_term'], u = {};
    try {
      var p = new URLSearchParams(location.search);
      K.forEach(function(k){ var v = (p.get(k) || '').replace(/[^\w.-]/g, '').slice(0, 60); if(v) u[k] = v; });
      if(Object.keys(u).length) sessionStorage.setItem('pk-utm', JSON.stringify(u));
      else u = JSON.parse(sessionStorage.getItem('pk-utm') || '{}') || {};
    } catch(e){}
    var d = '';
    var w = K.map(function(k){ return u[k]; }).filter(Boolean);
    if(w.length) d += ' · utm ' + w.join('/');
    var hak = document.documentElement.dataset.hak;
    if(hak) d += ' · nagłówek ' + hak;
    if(!d) return;
    document.querySelectorAll('[data-zrodlo]').forEach(function(f){ f.dataset.zrodlo += d; });
  })();
</script>

<script>
  var redukcja = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- Skalowanie scen o stałym rozmiarze (kadr z reklamy, kit appto) ----
  (function(){
    var sceny = Array.prototype.slice.call(document.querySelectorAll('[data-pm],[data-is],[data-ak-skaluj]')) as HTMLElement[];
    function licz(el: HTMLElement){
      var w = el.clientWidth;
      if(!w) return;
      if(el.hasAttribute('data-pm')) el.style.setProperty('--ps', String(w / 1080));
      else if(el.hasAttribute('data-is')) el.style.setProperty('--is', String(w / 720));
      else el.style.setProperty('--s', String(w / parseFloat(getComputedStyle(el).getPropertyValue('--kk') || '1920')));
    }
    sceny.forEach(licz);
    if('ResizeObserver' in window){
      var ro = new ResizeObserver(function(w){ w.forEach(function(x){ licz(x.target as HTMLElement); }); });
      sceny.forEach(function(s){ ro.observe(s); });
    } else window.addEventListener('resize', function(){ sceny.forEach(licz); });
  })();

  // ---- HERO: pętla kadru z reklamy ----
  // Okna i znaczki wchodzą według data-t (ms), duży licznik, potem wszystko
  // wpada w ekran, otwiera się appto i „Zrobimy to za Was”. Pętla stoi,
  // kiedy hero nie widać. Bez ruchu zostaje kadr z oknami (.stat).
  (function(){
    var pm = document.querySelector('[data-pm]') as HTMLElement | null;
    if(!pm || redukcja || !('IntersectionObserver' in window)) return;
    var el = Array.prototype.slice.call(pm.querySelectorAll('[data-t]')) as HTMLElement[];
    var la = pm.querySelector('[data-t-la]') as HTMLElement;
    var T = { zwin: 6500, app: 6950, la: 7500, reset: 12600, od: 13300 };
    var timery: number[] = [], widac = false;
    function czysc(){ timery.forEach(function(t){ clearTimeout(t); }); timery = []; }
    function po(ms: number, fn: () => void){ timery.push(window.setTimeout(fn, ms)); }
    function start(){
      czysc();
      pm!.classList.remove('stat', 'zwin', 'app', 'reset');
      el.forEach(function(e){ e.classList.remove('on'); });
      la.classList.remove('on');
      el.forEach(function(e){ po(+(e.dataset.t || 0), function(){ e.classList.add('on'); }); });
      po(T.zwin, function(){ pm!.classList.add('zwin'); });
      po(T.app, function(){ pm!.classList.add('app'); });
      po(T.la, function(){ la.classList.add('on'); });
      po(T.reset, function(){ pm!.classList.add('reset'); });
      po(T.od, function(){ if(widac) start(); });
    }
    new IntersectionObserver(function(w){
      var teraz = w[0].isIntersecting;
      if(teraz && !widac){ widac = true; start(); }
      else if(!teraz && widac){ widac = false; czysc(); }
    }, { threshold: 0.2 }).observe(pm);
  })();

  // ---- PROBLEM: instrukcja, która się sypie ----
  // Gra raz, kiedy scena wejdzie w kadr, i kończy się kulminacją (stoi).
  // Kroki i okna wchodzą według data-t, licznik według data-licznik,
  // przy oknie psuje się jego krok (czerwony numer). Od pierwszego nowego
  // kroku lista jedzie w górę i się rozjeżdża, na końcu osiada.
  (function(){
    var sc = document.querySelector('[data-is]') as HTMLElement | null;
    if(!sc || redukcja || !('IntersectionObserver' in window)) return;
    var el = Array.prototype.slice.call(sc.querySelectorAll('[data-t]')) as HTMLElement[];
    var zr = sc.querySelector('[data-is-zr]') as HTMLElement, wsz = sc.querySelector('[data-is-wsz]') as HTMLElement;
    var licznik = JSON.parse(sc.dataset.licznik || '[]') as number[][];
    var kulminacja = +(sc.dataset.kulminacja || 8300);
    var pierwszyNowy = 0;
    el.forEach(function(e){ var nr = +(e.dataset.nr || 0); if(nr === 10) pierwszyNowy = +(e.dataset.t || 0); });
    sc.classList.remove('stat');
    zr.textContent = '0'; wsz.textContent = '64'; wsz.classList.remove('ucieka');
    var ruszylo = false;
    function start(){
      ruszylo = true;
      el.forEach(function(e){
        window.setTimeout(function(){
          e.classList.add('on');
          var nr = e.dataset.psuje;
          if(nr){ var k = sc!.querySelector('.is-k[data-nr="' + nr + '"]'); if(k) k.classList.add('zepsuty'); }
        }, +(e.dataset.t || 0));
      });
      licznik.forEach(function(x){
        window.setTimeout(function(){ zr.textContent = String(x[1]); wsz.textContent = String(x[2]); wsz.classList.toggle('ucieka', x[2] > 64); }, x[0]);
      });
      window.setTimeout(function(){ sc!.classList.add('rosnie', 'rozjazd'); }, pierwszyNowy);
      window.setTimeout(function(){ sc!.classList.add('osiada'); }, kulminacja);
    }
    var io = new IntersectionObserver(function(w){
      if(w[0].isIntersecting && !ruszylo){ start(); io.disconnect(); }
    }, { threshold: 0.45 });
    io.observe(sc);
  })();

  // ---- PLAN: kropki zapalają się, linia rośnie, gdy krok wchodzi w kadr ----
  (function(){
    var li = Array.prototype.slice.call(document.querySelectorAll('[data-os] li')) as HTMLElement[];
    if(!li.length) return;
    if(redukcja || !('IntersectionObserver' in window)){ li.forEach(function(x){ x.classList.add('on'); }); return; }
    var io = new IntersectionObserver(function(w){
      w.forEach(function(x){ if(x.isIntersecting){ x.target.classList.add('on'); io.unobserve(x.target); } });
    }, { rootMargin: '0px 0px -35% 0px' });
    li.forEach(function(x){ io.observe(x); });
  })();

  // ---- APPTO: praca od stanu „przed” (studio/ZASADY.md) ----
  // Kit startuje w HTML jako pusty appto (klasa .gra). Kolejno: polecenie
  // pisane znak po znaku, wysłanie, kroki z HubSpota, notatek i Kontekstu,
  // dokument wjeżdża z prawej i jego pola wypełniają się po kolei, na końcu
  // odpowiedź „Gotowe” z kartą dokumentu. Pętla, póki scena jest w kadrze; po
  // wyjściu z kadru wraca do pustego okna. Przy ograniczonym ruchu stan końcowy.
  (function(){
    var kity = Array.prototype.slice.call(document.querySelectorAll('[data-ak-demo]')) as HTMLElement[];
    if(!kity.length) return;
    if(redukcja || !('IntersectionObserver' in window)){ kity.forEach(function(ak){ ak.classList.remove('gra'); }); return; }
    kity.forEach(function(ak){
      var pole = ak.querySelector('[data-w="w-composer-text"]') as HTMLElement;
      var msg = ak.querySelector('[data-w="w-msg1"]') as HTMLElement;
      var tytul = ak.querySelector('[data-w="w-top-title"]') as HTMLElement;
      var pola = Array.prototype.slice.call(ak.querySelectorAll('.w-field')) as HTMLElement[];
      var wzmianka = msg.querySelector('.w-mention') as HTMLElement;
      var tekst = (msg.firstChild && msg.firstChild.textContent) || '';
      var pusto = pole.innerHTML, tytulKoniec = tytul.textContent || '';
      var timery: number[] = [], widac = false;
      function czysc(){ timery.forEach(function(t){ clearTimeout(t); }); timery = []; }
      function po(ms: number, fn: () => void){ timery.push(window.setTimeout(fn, ms)); }
      function faza(n: number){ for(var i = 1; i <= 7; i++) ak.classList.toggle('f' + i, i <= n); }
      function przed(){
        czysc();
        ak.classList.add('gra');
        ak.classList.remove('wyslij');
        faza(0);
        pola.forEach(function(f){ f.classList.add('pusty'); });
        tytul.textContent = 'Nowa rozmowa';
        pole.innerHTML = pusto;
      }
      function start(){
        przed();
        var t = 900;
        po(t - 200, function(){ pole.innerHTML = '<span class="ak-kursor"></span>'; });
        for(var i = 1; i <= tekst.length; i++){
          (function(n){ po(t + n * 38, function(){ pole.innerHTML = ''; pole.appendChild(document.createTextNode(tekst.slice(0, n))); var k = document.createElement('span'); k.className = 'ak-kursor'; pole.appendChild(k); }); })(i);
        }
        t += tekst.length * 38 + 150;
        po(t, function(){ var k = pole.querySelector('.ak-kursor'); pole.insertBefore(wzmianka.cloneNode(true), k); });
        t += 700;
        po(t, function(){ ak.classList.add('wyslij'); });
        po(t + 250, function(){ ak.classList.remove('wyslij'); pole.innerHTML = pusto; tytul.textContent = tytulKoniec; faza(1); });
        po(t + 900, function(){ faza(2); });
        po(t + 1500, function(){ faza(3); });
        po(t + 2300, function(){ faza(4); });
        po(t + 3100, function(){ faza(5); });
        po(t + 3900, function(){ faza(6); });
        pola.forEach(function(f, i){ po(t + 5000 + i * 380, function(){ f.classList.remove('pusty'); }); });
        po(t + 5000 + pola.length * 380 + 300, function(){ faza(7); });
        po(t + 15000, function(){ if(widac) start(); });
      }
      przed();
      new IntersectionObserver(function(w){
        var teraz = w[0].isIntersecting;
        if(teraz && !widac){ widac = true; start(); }
        else if(!teraz && widac){ widac = false; przed(); }
      }, { threshold: 0.35 }).observe(ak);
    });
  })();

  // ---- Telefon: przycisk na dole ekranu, gdy hero i formularz są poza kadrem ----
  (function(){
    var pasek = document.querySelector('[data-pasek]') as HTMLElement | null;
    var hero = document.getElementById('start'), kontakt = document.getElementById('kontakt'), faq = document.getElementById('faq');
    if(!pasek || !hero || !kontakt || !('IntersectionObserver' in window)) return;
    var stan: Record<string, boolean> = { start: true, kontakt: false, faq: false };
    var io = new IntersectionObserver(function(w){
      w.forEach(function(x){ stan[(x.target as HTMLElement).id] = x.isIntersecting; });
      var pokaz = !stan.start && !stan.kontakt && !stan.faq;
      pasek!.classList.toggle('on', pokaz);
      pasek!.setAttribute('aria-hidden', pokaz ? 'false' : 'true');
      pasek!.querySelector('a')!.tabIndex = pokaz ? 0 : -1;
    });
    [hero, kontakt, faq].forEach(function(s){ if(s) io.observe(s); });
  })();

  // ---- Meta: zdarzenie „Lead” po wysłanym formularzu ----
  // Moduł Kontakt wysyła `la:pomiar` z `formularz_sukces`. Piksel ładuje
  // Zgody.astro dopiero po zgodzie na marketing; bez zgody nic nie idzie.
  // Ten sam sukces trafia do GTM (dataLayer `formularz_wyslany`) — jeśli
  // kontener GTM ma już tag „Lead”, ten fragment trzeba wyłączyć, żeby nie
  // liczyć zgłoszeń podwójnie.
  document.addEventListener('la:pomiar', function(e){
    var d = (e as CustomEvent).detail || {};
    if(d.event !== 'formularz_sukces') return;
    var w = window as any;
    try { if(typeof w.fbq === 'function') w.fbq('track', 'Lead', { content_name: 'Wdrożenie AI pod klucz' }); } catch(err){}
  });
</script>
</LaBase>
