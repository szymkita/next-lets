---
// WDROŻENIE AI POD KLUCZ — /wdrozenie-ai-pod-klucz
// Strona reklamowa pod kampanię Meta Stories „Przytłacza Cię wdrażanie AI
// w firmie?” (reklama pk3 v7, ~/filmy/appto-stories, brief:
// ~/Downloads/landing-pod-klucz/BRIEF.md, wytyczne: WYTYCZNE-reklamy.md).
// Reklama kończy się CTA „Zobacz, jak wygląda wdrożenie pod klucz”, więc
// strona od pierwszego ekranu pokazuje to, co było w reklamie, i prowadzi
// dalej tą samą drogą: chaos samodzielnego montażu → „Zrobimy to za Was”
// → plan 6 kroków (słowo w słowo jak w reklamie) → zespół pisze polecenie
// w appto → dowody → bezpłatna diagnoza → formularz → pytania.
//
// Osobna strona zamiast rozbudowy /wdrozenie-ai: /wdrozenie-ai sprzedaje
// wybór narzędzia AI dla całej firmy (próba Copilot/Gemini/ChatGPT/Appto,
// przykład hurtowni) i ma inną obietnicę. Ta strona przedłuża jedną reklamę,
// więc ma odchudzony nagłówek (logo, telefon, jeden przycisk), jest poza
// menu i poza sitemapą, z noindex.
//
// Wzorzec techniczny: /integracja-systemow-z-ai (strona pod film z posta).
// Formularz: moduł Kontakt (POST /api/kontakt: e-mail, telefon, opis).
// UTM-y z linku reklamy i wariant nagłówka (?h=) dopisują się do źródła
// zgłoszenia. Zdarzenie Meta „Lead” idzie po udanym wysłaniu (piksel
// z Zgody.astro, tylko po zgodzie na marketing).
//
// v2 (18.11, uwagi Szymona do v1, studio/DZIENNIK.md): sekcja problemu
// z instrukcją, która się sypie (InstrukcjaSypie), krok 1 planu i diagnoza
// mówią o analizie, CTA „Zbudujmy plan wdrożenia” z diagnozą jako pierwszym
// krokiem, jedna scena appto od pustego okna (hero bez appto), hero kończy
// się pasem klientów, a diagnoza stoi na jasnym tle.
//
// DO POTWIERDZENIA PRZED PUBLIKACJĄ (pytania w raportach z 18.11.2026):
//   1. Obietnica po formularzu: zostaje to, co już jest na stronie (telefon
//      w jeden dzień roboczy, diagnoza, plan z ceną pierwszego etapu).
//   2. Nazwa pierwszego kroku: „bezpłatna diagnoza” jak w nawigacji, na
//      stronie głównej i na /integracja-systemow-z-ai (Sztab d-pierwszy-krok).
//   3. Liczby 140+ / 200+ / 30+ i wyniki ze strony głównej (Sztab d-claimy:
//      liczba wdrożeń w rewizji).
//   4. Nazwy w przykładzie appto („Firma Przykładowa”, „Twoja firma”, Marta
//      Zielińska) zamiast VeloPol i Norda Systems z kitu reklamy.
//   5. Zdania kroków planu pod podpisami z reklamy są nowe (propozycja).
//   6. Podpis kroku 1 („diagnoza: gdzie ucieka czas, co przejmie AI”) różni
//      się od reklamy („rozmowy z zespołem, Wasze procesy”) po uwadze Szymona.
//   7. CTA „Zbudujmy plan wdrożenia” (Sztab d-pierwszy-krok nadal otwarta).
import LaBase from '../layouts/LaBase.astro';
import GcFaq from '../components/GcFaq.astro';
import Styl from '../components/usluga/Styl.astro';
import Anim from '../components/usluga/Anim.astro';
import Kontakt from '../components/usluga/Kontakt.astro';
import Cytat from '../components/usluga/Cytat.astro';
import KitStyl from '../components/pod-klucz/KitStyl.astro';
import AppKit from '../components/pod-klucz/AppKit.astro';
import PulpitMontaz from '../components/pod-klucz/PulpitMontaz.astro';
import InstrukcjaSypie from '../components/pod-klucz/InstrukcjaSypie.astro';
import { HI } from '../components/usluga/ikony';

const ADRES = '/wdrozenie-ai-pod-klucz';
const ZRODLO = 'Wdrożenie AI pod klucz';
const title = "Wdrożenie AI pod klucz — Let's automate";
const description = 'Przytłacza Cię wdrażanie AI w firmie? Zrobimy to za Was. Poznajemy, jak pracuje Twoja firma, ustawiamy AI i automatyzacje i podłączamy je do Waszych systemów. Pierwszy krok to bezpłatna diagnoza.';
// CTA: napis wszystkich przycisków strony (hero, nagłówek, plan, pasek na
// telefonie, formularz) zmienia się tutaj. Pierwszy krok nazywa się dalej
// „bezpłatna diagnoza” (Sztab d-pierwszy-krok, otwarta).
const CTA = 'Zbudujmy plan wdrożenia';
const CTA_POD = 'Zaczynamy od bezpłatnej diagnozy. Po niej dostajecie plan z ceną pierwszego etapu.';
const TEL = '+48 571 399 932';
const TEL_H = 'tel:+48571399932';
const dwa = (n: number) => String(n).padStart(2, '0');

// Plan wdrożenia: tytuły (t) słowo w słowo z reklamy, podpisy (p) też,
// poza krokiem 1 (v2, Szymon: „nie tylko rozmawiamy, ale też analizujemy,
// diagnozujemy”; w reklamie: „rozmowy z zespołem, Wasze procesy”).
// d = jedno zdanie rozwinięcia, nowe na stronie (propozycja).
const PLAN = [
  { t: 'Analizujemy, jak pracujecie', p: 'diagnoza: gdzie ucieka czas, co przejmie AI',
    d: 'Przechodzimy przez Wasze procesy, dokumenty i systemy. Sprawdzamy, gdzie ucieka czas, i wskazujemy, co oddać AI na początek.' },
  { t: 'Zbieramy kontekst firmy', p: 'cenniki, umowy, procedury',
    d: 'Porządkujemy dokumenty, z których korzysta AI, żeby odpowiadało według Waszych zasad.' },
  { t: 'Ustawiamy agentów AI i automatyzacje', p: 'oferty, obsługa klienta, umowy',
    d: 'Piszemy instrukcje i skille. Gdy gotowe narzędzie nie wystarcza, budujemy aplikację dopasowaną do firmy.' },
  { t: 'Podłączamy Wasze systemy', p: 'poczta, CRM, ERP, także bez API',
    d: 'AI sięga do danych tam, gdzie leżą, także w starszych programach bez gotowej integracji. Ustalamy, do czego ma dostęp.' },
  { t: 'Testujemy na Waszych sprawach', p: 'zanim zespół zacznie pracę',
    d: 'Sprawdzamy odpowiedzi na prawdziwych przykładach z firmy i poprawiamy, aż się zgadzają.' },
  { t: 'Zespół wchodzi na gotowe', p: 'na naszej platformie appto albo w Waszych narzędziach',
    d: 'Uczymy zespół pracy z gotowymi agentami na jego własnych sprawach.' },
];

// Liczby i wyniki ze strony głównej (index.astro: pasek liczb i karty efektów),
// słowo w słowo. Liczba wdrożeń w rewizji (Sztab d-claimy).
const LICZBY = [
  { l: '140+', d: 'firm' },
  { l: '200+', d: 'wdrożeń' },
  { l: '30+', d: 'ekspertów' },
];
// Wynik „Przygotowanie oferty” stoi pod sceną appto (ta sama praca), reszta w dowodach.
const OFERTA = { l: '−80%', ld: 'czasu przygotowania oferty', po: 'Szkic oferty powstaje z danych CRM w kilka minut, handlowiec go dopina.' };
const WYNIKI = [
  { dz: 'Finanse', p: 'Obieg faktur kosztowych', l: '99,7%', ld: 'skuteczności księgowania',
    po: 'Faktury z maili księgują się same, zespół zajmuje się wyjątkami.' },
  { dz: 'Operacje', p: 'Raport tygodniowy', l: '65 h', ld: 'odzyskanych co miesiąc',
    po: 'Dane spływają same, raport czeka w poniedziałek o 7:00.' },
  { dz: 'Obsługa klienta', p: 'Pytania o zamówienia', l: '−90%', ld: 'zapytań obsługiwanych ręcznie',
    po: 'Agent AI odpowiada w kilka minut, z danymi zamówienia.' },
];
const LOGA = [
  ['sports-med.svg', 'Sports-Med', 308], ['nars.svg', 'NARS', 235], ['sevium.svg', 'Sevium', 206],
  ['odo-24.svg', 'ODO 24', 158], ['x3d.svg', 'X3D', 143],
];

// Od formularza do planu (jak na /integracja-systemow-z-ai).
const KROKI = [
  { t: 'Formularz', d: 'E-mail, telefon i jedno zdanie o tym, co AI ma przejąć najpierw.', kiedy: 'minuta' },
  { t: 'Dzwoni Piotr', d: 'Pyta, jak dziś wygląda ta praca i na czym pracujecie. Jeśli nie umiemy pomóc, mówi to od razu.', kiedy: 'w jeden dzień roboczy',
    os: { f: '/piotr-avatar.jpg', n: 'Piotr Wojciuk', r: 'New Business Lead' } },
  { t: 'Bezpłatna diagnoza', d: 'Analizujemy Wasze procesy, dokumenty i systemy. Szukamy miejsc, w których ucieka czas, i ustalamy, co oddać AI na początek. Dostęp do systemów nie jest do tego potrzebny.', kiedy: 'w terminie, który Wam pasuje' },
  { t: 'Plan wdrożenia z ceną', d: 'Kolejne kroki wdrożenia i cena pierwszego etapu. Kwota stała.', kiedy: 'po diagnozie', mocny: true },
];
const W_PLANIE = [
  { t: 'Od czego zaczynamy', d: 'Obszar, w którym AI da efekt najszybciej, np. oferty albo odpowiedzi na zapytania klientów.' },
  { t: 'Co przejmie AI', d: 'Które czynności robią agenci i automatyzacje, a które zostają przy ludziach.' },
  { t: 'Które systemy podłączymy', d: 'Poczta, CRM, ERP i programy branżowe, z których korzystacie.' },
  { t: 'Ile kosztuje pierwszy etap', d: 'Kwota stała, znana przed startem. Każdy kolejny etap też ma cenę, zanim go zaczniemy.' },
  { t: 'Co dalej', d: 'Kolejne procesy i działy w kolejności, która ma dla Was sens.' },
];

const faq = [
  {
    q: 'Czym jest bezpłatna diagnoza?',
    a: 'To pierwszy krok wdrożenia. Razem z Wami przechodzimy przez procesy, dokumenty i systemy, szukamy miejsc, w których ucieka czas, i ustalamy, od czego zacząć. Po diagnozie dostajecie plan wdrożenia z ceną pierwszego etapu.',
  },
  {
    q: 'Ile kosztuje wdrożenie?',
    a: 'Pierwszy etap wyceniamy w planie kwotą stałą, znaną przed startem. Każdy kolejny etap też ma cenę, zanim go zaczniemy.',
  },
  {
    q: 'Ile to trwa?',
    a: 'Zależy od tego, który proces idzie pierwszy i ile systemów trzeba podłączyć. Zakres i kolejność etapów rozpisujemy w planie po diagnozie, a termin startu ustalamy razem z Wami.',
  },
  {
    q: 'Czy musimy korzystać z appto?',
    a: 'Nie. Appto to nasza platforma i przydaje się, kiedy z AI ma korzystać cała firma. Jeśli pracujecie w Copilocie, ChatGPT albo Claude, ustawiamy AI tam.',
  },
  {
    q: 'Co z systemami, do których nie ma integracji?',
    a: 'Podłączamy pocztę, CRM, ERP i programy branżowe, także starsze i bez API. Na diagnozie sprawdzamy Wasze konkretne systemy i mówimy, czy i jak je podłączymy. <a href="/integracja-systemow-z-ai" style="font-weight:700;color:#0a7a52">Jak podłączamy systemy bez integracji →</a>',
  },
  {
    q: 'Kto u nas musi się tym zajmować?',
    a: 'Potrzebujemy osoby, która zna Wasze procesy i znajdzie czas na rozmowy z nami, oraz dostępu do dokumentów i systemów, które podłączamy. Resztę robimy my.',
  },
  {
    q: 'Co z danymi firmy?',
    a: 'Do diagnozy nie potrzebujemy dostępu do systemów, a NDA podpisujemy także przed nią, jeśli tego potrzebujecie. Przed startem ustalamy z Wami, do czego AI ma dostęp i co może zrobić.',
  },
  {
    q: 'Czy diagnoza zobowiązuje do współpracy?',
    a: 'Nie. Plan zostaje u Was. Możecie go zrealizować z własnym zespołem albo z inną firmą.',
  },
];

const kanon = new URL(ADRES, Astro.site).href;
const dane = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${kanon}#usluga`,
      name: 'Wdrożenie AI pod klucz',
      serviceType: 'Wdrożenie sztucznej inteligencji w firmie',
      url: kanon,
      description: 'Let’s automate poznaje, jak pracuje firma, i ustawia AI za zespół: kontekst firmy, agentów AI i automatyzacje, połączenia z systemami i testy na sprawach firmy. Pierwszy krok to bezpłatna diagnoza zakończona planem z ceną pierwszego etapu.',
      provider: { '@id': new URL('/#organizacja', Astro.site).href },
      areaServed: { '@type': 'Country', name: 'Polska' },
    },
  ],
};
---
<LaBase topbar={false} naglowek={false} noindex={true} title={title} description={description} ctaHref="#kontakt" nav={null}>
<script type="application/ld+json" is:inline set:html={JSON.stringify(dane)} slot="head"></script>
<KitStyl slot="head" />
<style is:global slot="head">
  /* =====================================================================
     NAGŁÓWEK STRONY REKLAMOWEJ: logo, telefon, jeden przycisk
     ===================================================================== */
  .pk-top{position:relative;z-index:3;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:clamp(18px,2.2vw,28px) 0}
  .pk-top img{display:block;height:30px;width:auto}
  .pk-top-r{display:flex;align-items:center;gap:clamp(14px,2vw,28px)}
  .pk-tel{font-size:15px;font-weight:650;color:rgba(255,255,255,0.78);transition:color .15s}
  .pk-tel:hover{color:#ffffff}
  .pk-top .v3-btn{font-size:15px;padding:7px 7px 7px 20px;gap:12px}
  .pk-top .v3-btn span{width:32px;height:32px}
  @media (max-width:720px){ .pk-tel{display:none} .pk-top .v3-btn{display:none} .pk-top img{height:26px} }

  /* =====================================================================
     HERO: pytanie z reklamy i kadr z reklamy w pętli
     ===================================================================== */
  .pk-hero{position:relative;overflow:hidden;padding:0 var(--pad) clamp(28px,3vw,40px);background:
      radial-gradient(900px 560px at 86% 70%,rgba(0,205,119,0.16),rgba(0,205,119,0) 70%),
      radial-gradient(700px 420px at 4% -10%,rgba(0,205,119,0.06),rgba(0,205,119,0) 70%),
      var(--ink);color:#ffffff}
  .pk-hero-in{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,6.4fr);grid-template-areas:"t v" "r v";column-gap:clamp(32px,5vw,88px);align-items:center;margin-top:clamp(20px,3.4vw,56px)}
  .pk-ht{grid-area:t;align-self:end}
  .pk-hr{grid-area:r;align-self:start}
  .pk-kadr{grid-area:v}
  .pk-ety{display:block;margin:0 0 20px;font-size:15px;font-weight:650;letter-spacing:-0.005em;color:var(--ziel)}
  .pk-h1{margin:0;font-size:clamp(42px,5.1vw,78px);line-height:0.98;letter-spacing:-0.05em;font-weight:800;color:#ffffff;text-wrap:balance}
  .pk-lead{margin:clamp(22px,2.4vw,32px) 0 0;max-width:520px;font-size:clamp(17px,1.35vw,19px);line-height:1.6;color:#C9D1CB;text-wrap:pretty}
  .pk-lead b{display:block;margin-bottom:6px;font-size:clamp(22px,2vw,28px);line-height:1.2;letter-spacing:-0.03em;font-weight:800;color:#ffffff}
  .pk-akcje{display:flex;flex-wrap:wrap;align-items:center;gap:14px 26px;margin-top:clamp(28px,3vw,40px)}
  .pk-po{margin:18px 0 0;font-size:14px;color:#A3ABA5}
  .pk-kl{display:flex;align-items:center;gap:16px clamp(28px,4vw,64px);margin-top:clamp(48px,6vw,88px);padding-top:clamp(22px,2.4vw,32px);border-top:1px solid rgba(255,255,255,0.12)}
  .pk-kl p{flex-shrink:0;max-width:220px;margin:0;font-size:14px;line-height:1.45;color:#A3ABA5}
  .pk-kl strong{color:#ffffff;font-weight:700}
  .pk-kl ul{flex:1;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:4px 32px;margin:0;padding:0;list-style:none}
  .pk-kl img{display:block;height:50px;width:auto;filter:grayscale(1) invert(1);mix-blend-mode:screen;opacity:0.6}
  @media (max-width:900px){
    .pk-kl{flex-direction:column;align-items:flex-start}
    .pk-kl ul{justify-content:flex-start;gap:0 22px}
    .pk-kl img{height:40px}
  }
  .pk-kadr{position:relative;border-radius:clamp(14px,1.6vw,22px);overflow:hidden;box-shadow:0 0 0 1px rgba(255,255,255,0.08),0 50px 100px -50px rgba(0,0,0,0.8)}
  @media (max-width:980px){
    .pk-hero-in{grid-template-columns:minmax(0,1fr);grid-template-areas:"t" "v" "r";row-gap:clamp(24px,4vw,40px)}
    .pk-kadr{margin:0 calc(var(--pad) * -1 + 16px)}
    .pk-lead{margin-top:0}
  }
  @media (max-width:560px){
    .pk-akcje{flex-direction:column;align-items:stretch}
    .pk-akcje .v3-btn{justify-content:space-between}
    .pk-akcje .v3-lnk{align-self:flex-start}
  }

  /* =====================================================================
     PROBLEM: instrukcja montażu, kroki jak znaczniki z reklamy
     ===================================================================== */
  .pk-pr{display:grid;grid-template-columns:minmax(0,6fr) minmax(0,5fr);gap:clamp(40px,6vw,104px);align-items:center}
  .pk-h2s{font-size:clamp(34px,4vw,58px)}
  .pk-pr .v3-sub{margin-top:22px}
  .pk-pr .v3-sub + .v3-sub{margin-top:14px}
  .pk-pr .v3-sub b{color:var(--t1);font-weight:650}
  .pk-is{width:100%;max-width:560px;justify-self:end}
  @media (max-width:900px){ .pk-pr{grid-template-columns:minmax(0,1fr)} .pk-is{justify-self:start;max-width:520px} }

  /* =====================================================================
     PLAN: zielona linia z kropkami, jak w reklamie
     ===================================================================== */
  .pk-plan{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,6.4fr);gap:clamp(40px,6vw,104px);align-items:start}
  .pk-plan-l{position:sticky;top:48px}
  .pk-plan-l .v3-sub{margin-top:24px;max-width:440px}
  .pk-plan-l .v3-btn{margin-top:clamp(28px,3vw,40px)}
  .pk-ph{margin:0;font-size:clamp(28px,2.6vw,40px);line-height:1;letter-spacing:-0.04em;font-weight:800;color:#ffffff}
  .pk-ps{margin:10px 0 0;font-size:clamp(16px,1.3vw,19px);font-weight:500;color:#A3ABA5}
  .pk-os{margin:clamp(28px,3vw,40px) 0 0;padding:0;list-style:none}
  .pk-os li{position:relative;display:grid;grid-template-columns:34px minmax(0,1fr);gap:clamp(18px,2vw,30px);padding-bottom:clamp(26px,2.6vw,38px)}
  .pk-os li:last-child{padding-bottom:0}
  /* linia: szara pod spodem, zielona rośnie, gdy krok wchodzi w kadr */
  .pk-os li::before,.pk-os li::after{content:"";position:absolute;left:15px;top:34px;bottom:-4px;width:4px;border-radius:2px;background:#1F2C24}
  .pk-os li::after{background:var(--ziel);transform:scaleY(0);transform-origin:50% 0;transition:transform .7s cubic-bezier(.4,0,.2,1) .15s}
  .pk-os li:last-child::before,.pk-os li:last-child::after{display:none}
  .pk-nd{position:relative;z-index:1;width:34px;height:34px;border-radius:50%;border:4px solid #3A4A3F;background:var(--ink);margin-top:2px}
  .pk-nd::after{content:"";position:absolute;inset:-4px;border-radius:50%;background:var(--ziel);transform:scale(0);transition:transform .4s cubic-bezier(.34,1.5,.64,1)}
  .pk-os li.on .pk-nd::after{transform:scale(1)}
  .pk-os li.on::after{transform:scaleY(1)}
  .pk-os h3{margin:0;font-size:clamp(22px,2.2vw,32px);line-height:1.08;letter-spacing:-0.035em;font-weight:800;color:#ffffff}
  .pk-os li:last-child h3{color:var(--ziel)}
  .pk-os .p{display:block;margin-top:6px;letter-spacing:-0.005em;line-height:1.35;font-size:clamp(15.5px,1.3vw,18px);font-weight:500;color:#A3ABA5}
  .pk-os p{margin:12px 0 0;max-width:520px;font-size:15.5px;line-height:1.6;color:rgba(255,255,255,0.62);text-wrap:pretty}
  @media (max-width:980px){ .pk-plan{grid-template-columns:minmax(0,1fr)} .pk-plan-l{position:static} }
  /* na telefonie przycisk daje pasek na dole ekranu, w planie byłby drugi raz */
  @media (max-width:720px){ .pk-plan-l .v3-btn{display:none} }

  /* =====================================================================
     ZESPÓŁ NA GOTOWE: prawdziwy appto, rozmowa od polecenia do oferty
     ===================================================================== */
  .pk-ok{margin-top:clamp(40px,4.4vw,64px);border-radius:14px;overflow:hidden;background:#FAF9F7;box-shadow:0 0 0 1px rgba(15,26,20,0.12),0 60px 120px -60px rgba(8,26,17,0.55)}
  .pk-ok-bar{display:flex;align-items:center;gap:14px;height:40px;padding:0 14px;background:#ECEAE6;border-bottom:1px solid rgba(20,20,20,0.08)}
  .pk-ok-bar .pm-tl{display:flex;gap:8px}.pk-ok-bar .pm-tl i{width:12px;height:12px;border-radius:50%;display:block}
