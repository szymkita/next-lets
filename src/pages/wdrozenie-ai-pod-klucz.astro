const LOGA = [
  ['sports-med.svg', 'Sports-Med', 308], ['nars.svg', 'NARS', 235], ['sevium.svg', 'Sevium', 206],
  ['odo-24.svg', 'ODO 24', 158], ['x3d.svg', 'X3D', 143],
];

// Od formularza do planu (jak na /integracja-systemow-z-ai).
const KROKI = [
  { t: 'Formularz', d: 'E-mail, telefon i jedno zdanie o tym, co AI ma przejąć najpierw.', kiedy: 'minuta' },
  { t: 'Dzwoni Piotr', d: 'Pyta, jak dziś wygląda ta praca i na czym pracujecie. Jeśli nie umiemy pomóc, mówi to od razu.', kiedy: 'w jeden dzień roboczy',
    os: { f: '/piotr-avatar.jpg', n: 'Piotr Wojciuk', r: 'New Business Lead' } },
  { t: 'Bezpłatna diagnoza', d: 'Analizujemy Wasze procesy, dokumenty i systemy. Szukamy miejsc, w których ucieka czas, i ustalamy, co oddać AI na początek. Dostęp do systemów nie jest do tego potrzebny.', kiedy: 'w terminie, który Wam pasuje' },
  { t: 'Plan wdrożenia z ceną', d: 'Kolejne kroki wdrożenia i cena pierwszego etapu. Kwota stała.', kiedy: 'po diagnozie', mocny: true },
