---
// WDROŻENIE AI POD KLUCZ — /wdrozenie-ai-pod-klucz
// Strona reklamowa pod kampanię Meta Stories „Przytłacza Cię wdrażanie AI
// w firmie?” (reklama pk3 v7, ~/filmy/appto-stories, brief:
// ~/Downloads/landing-pod-klucz/BRIEF.md, wytyczne: WYTYCZNE-reklamy.md).
// Reklama kończy się CTA „Zobacz, jak wygląda wdrożenie pod klucz”, więc
// strona od pierwszego ekranu pokazuje to, co było w reklamie, i prowadzi
// dalej tą samą drogą: chaos samodzielnego wdrożenia → „Zrobimy to za Was”
// → plan 6 kroków (słowo w słowo jak w reklamie) → zespół pisze polecenie
// w appto → dowody → bezpłatna diagnoza → formularz → pytania.
//
// Osobna strona zamiast rozbudowy /wdrozenie-ai: /wdrozenie-ai sprzedaje
// wybór narzędzia AI dla całej firmy (próba Copilot/Gemini/ChatGPT/Appto,
// przykład hurtowni) i ma inną obietnicę. Ta strona przedłuża jedną reklamę.
// Od 18.11.2026 (Szymon: „to chyba tak zróbmy”) jest w strukturze serwisu:
// pierwsza pozycja pasa „Wdrażamy AI” w menu Usługi, link pod tą drogą na
// stronie głównej i blok „Całość za Was” na /strategia-ai, /wdrozenie-ai
// i /szkolenia-ai; pełne menu, w sitemapie, bez noindex.
//
// Wzorzec techniczny: /integracja-systemow-z-ai (strona pod film z posta).
// Formularz: moduł Kontakt (POST /api/kontakt: e-mail, telefon, opis).
// UTM-y z linku reklamy i wariant nagłówka (?h=) dopisują się do źródła
// zgłoszenia. Zdarzenie Meta „Lead” idzie po udanym wysłaniu (piksel
// z Zgody.astro, tylko po zgodzie na marketing).
//
// v2 (18.11, uwagi Szymona do v1, studio/DZIENNIK.md): sekcja problemu
// z instrukcją, która się sypie (InstrukcjaSypie), krok 1 planu i diagnoza
// mówią o analizie, CTA „Zbudujmy plan wdrożenia” z diagnozą jako pierwszym
// krokiem, jedna scena appto od pustego okna (hero bez appto), hero kończy
// się pasem klientów, a diagnoza stoi na jasnym tle.
//
// v3 (18.11, uwagi do v2): „Instrukcja wdrożenia AI” zamiast montażu; hero
// kończy się zespołem przy gotowym appto (kursory z imionami); instrukcja
// w sekcji problemu dłuższa, bez części i bez ucinania krawędzią; scena oferty
// od samego kompozytora, oferta Wolsenty dla Strelano z filmu (46 740 zł
// netto); nowa sekcja „Co jeszcze może przejąć AI” połączona z wynikami
// klientów; „Co jest w planie” jako kartka planu.
//
// DO POTWIERDZENIA PRZED PUBLIKACJĄ (pytania w raportach z 18.11.2026):
//   1. Obietnica po formularzu: zostaje to, co już jest na stronie (telefon
//      w jeden dzień roboczy, diagnoza, plan z ceną pierwszego etapu).
//   2. Nazwa pierwszego kroku: „bezpłatna diagnoza” jak w nawigacji, na
//      stronie głównej i na /integracja-systemow-z-ai (Sztab d-pierwszy-krok).
//   3. Liczby 140+ / 200+ / 30+ i wyniki ze strony głównej (Sztab d-claimy:
//      liczba wdrożeń w rewizji).
//   4. Nazwy w przykładach: Wolsenta, Strelano, Joanna Krawiec, Marta, Tomek,
//      Ania, Kamil Nowak (świat filmu ~/filmy/lets-pod-klucz-film, niepotwierdzone).
//   5. Zdania kroków planu pod podpisami z reklamy są nowe (propozycja).
//   6. Podpis kroku 1 („diagnoza: gdzie ucieka czas, co przejmie AI”) różni
//      się od reklamy („rozmowy z zespołem, Wasze procesy”) po uwadze Szymona.
//   7. CTA „Zbudujmy plan wdrożenia” (Sztab d-pierwszy-krok nadal otwarta).
import LaBase from '../layouts/LaBase.astro';
import GcFaq from '../components/GcFaq.astro';
import Styl from '../components/usluga/Styl.astro';
import Anim from '../components/usluga/Anim.astro';
import Kontakt from '../components/usluga/Kontakt.astro';
import KitStyl from '../components/pod-klucz/KitStyl.astro';
import AppKit from '../components/pod-klucz/AppKit.astro';
import PulpitMontaz from '../components/pod-klucz/PulpitMontaz.astro';
import ListaKrokow from '../components/pod-klucz/ListaKrokow.astro';
import PorownanieCzasu from '../components/pod-klucz/PorownanieCzasu.astro';
import ScenaNarzedzia from '../components/pod-klucz/ScenaNarzedzia.astro';
import NarzedziaStyl from '../components/pod-klucz/NarzedziaStyl.astro';
import Przegladarka from '../components/pod-klucz/Przegladarka.astro';
import { HI } from '../components/usluga/ikony';

const ADRES = '/wdrozenie-ai-pod-klucz';
const ZRODLO = 'Wdrożenie AI pod klucz';
const title = "Wdrożenie AI pod klucz — Let's automate";
const description = 'Przytłacza Cię wdrażanie AI w firmie? Zrobimy to za Was. Poznajemy, jak pracuje Twoja firma, ustawiamy AI i automatyzacje i podłączamy je do Waszych systemów. Pierwszy krok to bezpłatna diagnoza.';
// CTA: napis wszystkich przycisków strony (hero, nagłówek, plan, pasek na
// telefonie, formularz) zmienia się tutaj. Pierwszy krok nazywa się dalej
// „bezpłatna diagnoza” (Sztab d-pierwszy-krok, otwarta).
const CTA = 'Zbudujmy plan wdrożenia';
const CTA_POD = 'Zaczynamy od bezpłatnej diagnozy. Po niej dostajecie plan z ceną pierwszego etapu.';
const dwa = (n: number) => String(n).padStart(2, '0');

// Plan wdrożenia: tytuły (t) słowo w słowo z reklamy, podpisy (p) też,
// poza krokiem 1 (v2, Szymon: „nie tylko rozmawiamy, ale też analizujemy,
// diagnozujemy”; w reklamie: „rozmowy z zespołem, Wasze procesy”).
// d = jedno zdanie rozwinięcia, nowe na stronie (propozycja).
const PLAN = [
  { t: 'Analizujemy, jak pracujecie', p: 'diagnoza: gdzie ucieka czas, co przejmie AI',
    d: 'Przechodzimy przez Wasze procesy, dokumenty i systemy. Sprawdzamy, gdzie ucieka czas, i wskazujemy, co oddać AI na początek.' },
  { t: 'Zbieramy kontekst firmy', p: 'cenniki, umowy, procedury',
    d: 'Sami zbieramy i tworzymy kontekst dla agentów: porządkujemy dokumenty, żeby AI odpowiadało według Waszych zasad.' },
  { t: 'Ustawiamy agentów AI i automatyzacje', p: 'oferty, obsługa klienta, umowy',
    d: 'Piszemy instrukcje i skille. Gdy gotowe narzędzie nie wystarcza, budujemy aplikację dopasowaną do firmy.' },
  { t: 'Podłączamy Wasze systemy', p: 'poczta, CRM, ERP, także bez API',
    d: 'AI sięga do danych tam, gdzie leżą, także w starszych programach bez gotowej integracji. Ustalamy, do czego ma dostęp.' },
  { t: 'Testujemy na Waszych sprawach', p: 'zanim zespół zacznie pracę',
    d: 'Sprawdzamy odpowiedzi na prawdziwych sprawach z firmy i poprawiamy je, zanim oddamy rozwiązanie. Zespół nie traci godzin na poprawianie wyników AI.' },
  { t: 'Zespół wchodzi na gotowe', p: 'na naszej platformie appto albo w Waszych narzędziach',
    d: 'Uczymy zespół pracy z gotowymi agentami na jego własnych sprawach.' },
];

// Liczby i wyniki ze strony głównej (index.astro: pasek liczb i karty efektów),
// słowo w słowo. Liczba wdrożeń w rewizji (Sztab d-claimy).
const LICZBY = [
  { l: '140+', d: 'firm' },
  { l: '200+', d: 'wdrożeń' },
  { l: '30+', d: 'ekspertów' },
];
// ZESPÓŁ WCHODZI NA GOTOWE (v5, Szymon: „żeby to się scrollowało lewo-prawo…
// ciekawsze”): pozioma karuzela spraw zespołu Wolsenty. Każda karta ma kursor
// osoby, a wynik powstaje na oczach. v6 (Szymon o „Co jeszcze może przejąć
// AI”: „ta sekcja chyba nie ma sensu, skoro wyżej jest bardziej rozbudowana”):
// tamta sekcja zniknęła, a jej przykłady, które się nie powtarzają, są kartami
// tutaj. Pierwsza karta: oferta Marty w appto; reszta w narzędziach klienta
// (wierne UI z kitu web apps filmów appto, ScenaNarzedzia, narzedzia.ts).
// Wyniki klientów tylko przy przykładach z kart efektów strony głównej
// (index.astro), słowo w słowo. Pytania o zamówienia (−90%, Slack) wypadły,
// bo dublowały kartę Tomka w Slacku; awaria zostaje jako jedyny przykład z
// pracy w terenie. Osoby, firmy i kwoty zmyślone.
// fazy = liczba kroków efektu (data-n); tel = kadr na telefonie [x, szerokość];
// wskaz = element, na który na koniec wskazuje kursor osoby.
const W_PODPIS = 'wynik wdrożenia u naszego klienta';
const OFERTA = { l: '−80%', ld: 'czasu przygotowania oferty' };
interface Sprawa {
  kto: string; t: string; d: string; w?: { l: string; ld: string };
  scena?: string; fazy?: number; tel?: [number, number]; karta?: string; ikona?: 'gmail' | 'slack' | 'sheets' | 'hubspot'; adres?: string;
  kursor?: { imie: string; rola: string; kol: string; skad: [number, number] }; pol?: string; wyslij?: boolean; wskaz?: string; opis: string;
}
const SPRAWY: Sprawa[] = [
  { kto: 'Marta · sprzedaż', t: 'Oferta dla Strelano', d: 'Jedno polecenie w appto, a oferta składa się z CRM-u, notatek ze spotkania i cennika.', w: OFERTA,
    opis: 'Marta ze sprzedaży pisze w appto polecenie „Przygotuj ofertę dla Strelano z szablonu Oferta serwisowa”. Appto pobiera dane z HubSpota, notatek ze spotkania i cennika serwisu, otwiera ofertę i wypełnia jej pola: roczny serwis 42 jednostek klimatyzacji w trzech biurowcach za 46 740 zł netto.' },
  { kto: 'Ania · obsługa klienta', t: 'Odpowiedź na reklamację', d: 'Szkic zgodny z procedurą reklamacji czeka w Gmailu, z protokołem przeglądu w załączniku. Ania czyta go i wysyła jednym kliknięciem.',
    scena: 'ania', fazy: 6, tel: [330, 620], karta: 'Re: Reklamacja – jednostka 14 – Gmail', ikona: 'gmail', adres: 'mail.google.com/mail/u/0/#drafts', wyslij: true,
