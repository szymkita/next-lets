    opis: 'W Gmailu Ani powstaje szkic odpowiedzi na reklamację jednostki 14, napisany przez agenta, z protokołem przeglądu w załączniku. Ania klika Wyślij.' },
  { kto: 'Ewa · księgowość', t: 'Faktury kosztowe', d: 'Faktury z maili lądują w systemie księgowym, a w skrzynce dostają etykietę „Zaksięgowane”.', w: { l: '99,7%', ld: 'skuteczności księgowania' },
    scena: 'faktury', fazy: 5, tel: [256, 660], karta: 'Odebrane – Wolsenta – Gmail', ikona: 'gmail', adres: 'mail.google.com/mail/u/0/#inbox', wskaz: '[data-n="5"]',
    kursor: { imie: 'Ewa', rola: 'księgowość', kol: '#C2410C', skad: [1100, 620] },
    opis: 'W skrzynce Ewy z księgowości faktury od dostawców po kolei dostają etykietę Zaksięgowane.' },
  { kto: 'Tomek · serwis', t: 'Awaria w biurowcu B', d: 'Agent znajduje najbliższego serwisanta, wpisuje mu wizytę i daje znać klientce.',
    scena: 'tomek', fazy: 2, tel: [330, 580], karta: 'serwis (kanał) – Wolsenta – Slack', ikona: 'slack', adres: 'app.slack.com/client/wolsenta/serwis', pol: '@Wise kto może dziś pojechać do Strelano, biurowiec B?',
    kursor: { imie: 'Tomek', rola: 'serwis', kol: '#E0922F', skad: [900, 560] },
    opis: 'Tomek z serwisu pisze w Slacku do Wise: kto może dziś pojechać do Strelano, biurowiec B. Wise odpowiada: najbliżej jest Kamil Nowak, ma części w aucie, wizyta wpisana na 15:00, klientka powiadomiona.' },
  { kto: 'Kuba · sprzedaż', t: 'CRM po spotkaniu', d: 'Z notatek ze spotkania agent uzupełnia transakcję w HubSpocie i dodaje Kubie zadanie: oferta do 25 listopada.',
    scena: 'crm', fazy: 2, tel: [372, 680], karta: 'Biurowce Korvina – serwis 2027 – HubSpot', ikona: 'hubspot', adres: 'app-eu1.hubspot.com/contacts/wolsenta/deal', wskaz: '[data-n="2"]',
    kursor: { imie: 'Kuba', rola: 'sprzedaż', kol: '#0EA5E9', skad: [1150, 600] },
    opis: 'W HubSpocie przy transakcji Biurowce Korvina pojawia się notatka ze spotkania utworzona przez Appto i zadanie dla Kuby: przygotować ofertę serwisową.' },
  { kto: 'Piotr · zarząd', t: 'Raport tygodniowy', d: 'Dane z ERP i CRM same wpadają do arkusza. W poniedziałek rano raport czeka na zarząd.', w: { l: '65 h', ld: 'odzyskanych co miesiąc' },
    scena: 'raport', fazy: 7, tel: [0, 640], karta: 'Raport tygodniowy – Arkusze Google', ikona: 'sheets', adres: 'docs.google.com/spreadsheets/d/raport-tygodniowy', wskaz: '[data-n="7"]',
