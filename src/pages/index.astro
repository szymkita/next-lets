<!-- ============ S10b/S11 · PAS GRUPY + STOPKA ============
     Jedno źródło dla całego serwisu: src/components/Stopka.astro -->
<Stopka />

</div>

<script>
  // ---- Hero: makieta pulpitu skalowana do szerokości kontenera ----
  (function(){
    var frame = document.querySelector('.mockup-frame');
    var scale = document.querySelector('.mockup-scale');
    if(!frame || !scale) return;
    function fit(){
      var w = frame.clientWidth;
      var s = Math.min(1, w / 1180);
      scale.style.transform = 'scale(' + s + ')';
      frame.style.height = (400 * s) + 'px';
    }
    fit();
    window.addEventListener('resize', fit);
    window.addEventListener('load', fit);
  })();

  // ---- Rotator (S1b) — pionowe przewijanie fraz co 3s ----
  (function(){
    var col = document.getElementById('rotator-col');
    if(!col) return;
    var count = col.children.length;
    var i = 0;
    setInterval(function(){
      i = (i + 1) % count;
      var h = col.children[0].offsetHeight || 60;
      col.style.transform = 'translateY(-' + (i * h) + 'px)';
    }, 3000);
  })();

  // ---- Droga pod hero (S1b, wariant A) — reveal wykresu i osi czasu ----
  (function(){
    var sec = document.querySelector('.la-droga');
    if(!sec) return;
    if(!('IntersectionObserver' in window)){ sec.classList.add('in'); return; }
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if(e.isIntersecting){ sec.classList.add('in'); io.disconnect(); } });
    }, { threshold: 0.25 });
    io.observe(sec);
  })();

  // ---- FAQ (S9b) — akordeon ----
  (function(){
    var items = document.querySelectorAll('.faq-item');
    if(!items.length) return;
    items.forEach(function(item){
      var btn = item.querySelector('.faq-q');
      if(!btn) return;
      btn.addEventListener('click', function(){
        var willOpen = !item.classList.contains('open');
        items.forEach(function(other){
          other.classList.remove('open');
          var b = other.querySelector('.faq-q');
          if(b) b.setAttribute('aria-expanded', 'false');
        });
        if(willOpen){
          item.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  })();

  // ---- Zakładki oferty (S4) — Wdrażamy AI / Budujemy / Guided Coding ----
  // Zakładki krążą same, dopóki nikt ich nie tknie: bez tego dwie trzecie
  // oferty nigdy się nie pokazują. Pierwsze kliknięcie zatrzymuje rotację
  // NA DOBRE — nic nie przełącza się pod ręką czytającego. Rotacja chodzi
  // wyłącznie wtedy, gdy sekcja jest na ekranie, żeby nikt nie wracał
  // do losowo przestawionej zakładki.
  (function(){
    var box = document.querySelector('.krok-tabs');
    var tabs = document.querySelectorAll('.krok-tab');
    var layers = document.querySelectorAll('.krok-layer');
    if(!tabs.length) return;

    var KROKI = ['wdrazamy','budujemy','guided'];
    var CZAS = 7000;
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion:reduce)').matches;
    var auto = !reduce, widoczna = false, biezacy = 'wdrazamy', timer = null;

    function pasek(t, aktywna){
      if(!t) return;
      var i = t.querySelector('.krok-pasek i');
      if(!i) return;
      i.style.transition = 'none';
      i.style.width = '0%';
      if(aktywna && auto && widoczna){
        void i.offsetWidth;                     // reflow, inaczej przeglądarka sklei oba zapisy w jeden
        i.style.transition = 'width ' + CZAS + 'ms linear';
        i.style.width = '100%';
      }
    }
    function plan(){
      clearTimeout(timer);
      if(!auto || !widoczna) return;
      timer = setTimeout(function(){
        setKrok(KROKI[(KROKI.indexOf(biezacy) + 1) % KROKI.length]);
      }, CZAS);
    }
    function setKrok(k, odUzytkownika){
      if(odUzytkownika && auto){
        auto = false;
        clearTimeout(timer);
        if(box) box.classList.add('krok-stop');
      }
      biezacy = k;
      tabs.forEach(function(t){
        var on = t.dataset.krok === k;
        t.classList.toggle('krok-on', on);
        t.style.background = on ? '#ffffff' : 'transparent';
        t.style.boxShadow = on ? '0 12px 28px -16px rgba(12,28,20,0.3)' : 'none';
        var num = t.querySelector('.krok-num');
        if(num) num.style.color = on ? '#0a7a52' : '#808b83';
        pasek(t, on);
      });
      layers.forEach(function(l){
        var on = l.dataset.layer === k;
        l.style.opacity = on ? '1' : '0';
        l.style.transform = on ? 'translateY(0)' : 'translateY(14px)';
        l.style.pointerEvents = on ? 'auto' : 'none';
        l.classList.toggle('active', on);
      });
      plan();
    }

    tabs.forEach(function(t){ t.addEventListener('click', function(){ setKrok(t.dataset.krok, true); }); });
    document.querySelectorAll('[data-krok-link]').forEach(function(el){
      el.addEventListener('click', function(){ setKrok(el.dataset.krokLink, true); });
    });
    setKrok('wdrazamy');

    var sec = document.getElementById('oferta');
    if(sec && 'IntersectionObserver' in window){
      new IntersectionObserver(function(e){
        widoczna = e[0].isIntersecting;
        if(widoczna){ pasek(document.querySelector('.krok-tab.krok-on'), true); plan(); }
        else clearTimeout(timer);
      }, {threshold:0.3}).observe(sec);
    } else {
      widoczna = true;
      plan();
    }
  })();

  // ---- Rachunek (S2) — licznik od 0 do wartości docelowej gdy widoczny ----
  (function(){
    var el = document.getElementById('la8-rachunek');
    if(!el) return;
    var vals = el.querySelectorAll('.rcpt-val');
    var totalEl = document.getElementById('rcpt-total');
    var done = false;
    function animate(){
      if(done) return; done = true;
      var t0 = performance.now();
      function step(t){
        var p = Math.min(1, (t - t0) / 1500);
        var rp = 1 - Math.pow(1 - p, 3);
        vals.forEach(function(v){ v.textContent = Math.round(v.dataset.h * rp) + ' h'; });
        if(totalEl) totalEl.textContent = Math.round(totalEl.dataset.total * rp);
        if(p < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }
    if('IntersectionObserver' in window){
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(e){ if(e.isIntersecting){ animate(); io.disconnect(); } });
      }, { threshold: 0.2 });
      io.observe(el);
    } else { animate(); }
  })();

  // ---- Pulpit (hero) — sporadyczny wzrost licznika zadań ----
  (function(){
    var numEl = document.getElementById('tasksNum');
    var labelEl = document.getElementById('tasksLabel');
    if(!numEl) return;
    var n = 42;
    function word(x){
      var m10 = x % 10, m100 = x % 100;
      return (m10 >= 2 && m10 <= 4 && !(m100 >= 12 && m100 <= 14)) ? 'zadania' : 'zadań';
    }
    setInterval(function(){
      if(Math.random() < 0.45){
        n += 1;
        numEl.textContent = n;
        if(labelEl) labelEl.textContent = n + ' ' + word(n) + ' zrobione dziś';
      }
    }, 5200);
  })();


</script>

</body>
</html>
