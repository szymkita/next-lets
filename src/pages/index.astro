---
// STRONA GŁÓWNA — /
// Wariant roboczy index-v2 wszedł tu 07.09.2026. Poprzednia wersja strony
// siedzi w gicie (ostatni commit sprzed podmiany: 2414ed6).
//
// ZDJĘCIA — REGUŁA, KTÓRA TU OBOWIĄZUJE
// Portret wtapia się w sekcję maską tylko wtedy, gdy tło kadru zgadza się
// z tłem sekcji. Zdjęcie Piotra jest z zielonej ściany z neonem, więc wchodzi
// w #0e2b1d w „Czym się różnimy" bez szwu i bez ramki. Portrety ze studyjnego
// jasnego tła (/szymon-kita.jpg) tak NIE zadziałają — maska zostawia tam szarą
// plamę, dlatego Szymon występuje w okrągłych kadrach (sekcja drogi, oferta,
// FAQ) i w ramce przy formularzu, gdzie jego tło zgadza się z białą kartą.
//
// CZEGO TU CELOWO NIE MA
// — Kółek 46 px z rejestru zespołu na ciemnej zieleni: szare wycinki na
//   ciemnym tle robią z ludzi kropki, których nie da się rozpoznać.
// — Fotografii nastrojowej (krajobrazy pod wykresem, tła sekcji).
// — Osobnej sekcji „skład studia": zdjęcia mają siedzieć w sekcjach, które
//   już są, a pełny rejestr zespołu żyje na /dlaczego-my.
//
import Nawigacja from '../components/Nawigacja.astro';

// Ściana opinii. Taśma musi być zawsze szersza niż DWA ekrany, inaczej po
// przewinięciu pierwszego zestawu widać pustkę — przy dwóch kopiach taśma
// miała 2860 px i dziura pojawiała się już na 1440 px. Stąd KOPIE = 5:
// 20 kart to 7180 px, czyli pętla trzyma się do 3590 px szerokości okna.
// Krok animacji musi równać się szerokości JEDNEGO zestawu: przy N kopiach
// to -(100/N)% minus odstęp/N, czyli tutaj calc(-20% - 4px). Zmieniasz KOPIE
// — zmieniasz też @keyframes marq-scroll.
const KOPIE = 5;
const OPINIE = [
  { cytat: 'Wprowadzenie danych trwało godzinę. Dziś przesłanie oferty to <span style="color:#0a7a52;font-weight:700">10 minut</span> — oszczędności liczymy w etatach.',
    odznaka: { z: '60 min', na: '10 min' }, kto: 'Mateusz Chinczewski', rola: 'Prezes Zarządu, Finerto' },
  { cytat: 'Let\'s automate wziął pełną odpowiedzialność za projekt i dowiózł go do końca. To dlatego powierzyliśmy im kolejny, znacznie większy.',
    kto: 'Jakub Ciołkowski', rola: 'Członek Zarządu, NARS Polska' },
  { cytat: 'Bardzo dobrze zrozumieli nasze potrzeby i zaprojektowali scenariusz, który w pełni spełnił cele biznesowe. Otwartość i komunikacja to ich DNA.',
    kto: 'Arkadiusz Andruch', rola: 'Prezes Zarządu, X2O' },
  { cytat: 'Korzystamy z usług Let\'s automate od roku. Świetna komunikacja, łatwo się dogadać, a jakość usług na wysokim poziomie.',
    kto: 'Dominik Chylewski', rola: 'Wspólnik, X3D' },
];

import Stopka from '../components/Stopka.astro';

---
<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Let's automate — Studio transformacji AI</title>
<link rel="icon" href="/uploads/logo-2.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
<link href="https://fonts.googleapis.com/css2?family=Courier+Prime:wght@400;700&family=Schibsted+Grotesk:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
<style>
  :root{--la-accent:#00CD77}
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;background:#ffffff;overflow-x:clip;font-family:'Schibsted Grotesk',system-ui,sans-serif;-webkit-font-smoothing:antialiased}
  /* makieta hero: box 1180px skalowany transformem — poniżej 1240px przycinamy,
     żeby jego layoutowa szerokość nie powodowała poziomego przewijania */
  @media (max-width:1240px){ .mockup-frame{overflow:hidden} }
  a{color:inherit;text-decoration:none}
  ::selection{background:rgba(0,205,119,0.25)}
  input::placeholder,textarea::placeholder{color:#808b83}
  .inp{background:#f6f9f5 !important;border-color:#e4ebe2 !important;border-radius:11px !important;padding:14px 16px !important;transition:border-color .15s,background .15s,box-shadow .15s}
  .inp:focus{border-color:#0a7a52 !important;background:#ffffff !important;box-shadow:0 0 0 3px rgba(10,122,82,0.1)}
  .phone-field{transition:border-color .15s,box-shadow .15s,background .15s}
  .phone-field:focus-within{border-color:#0a7a52 !important;background:#ffffff !important;box-shadow:0 0 0 3px rgba(10,122,82,0.1)}
  @keyframes la-pulse{0%,100%{opacity:1}50%{opacity:.4}}
  @keyframes la-float{0%,100%{transform:translateY(-4px) rotate(var(--rot,0deg))}50%{transform:translateY(5px) rotate(var(--rot,0deg))}}
  .nav-cta-sizer{visibility:hidden;pointer-events:none}
  .nav-cta-live{position:absolute;left:0;right:0;top:0;bottom:0;display:inline-flex;align-items:center;justify-content:center;white-space:nowrap}
  .nav-cta-caret{display:inline-block;width:2px;height:1.05em;margin-left:1px;background:currentColor;vertical-align:-0.14em;animation:cta-blink 1s steps(1) infinite}
  @keyframes cta-blink{0%,50%{opacity:1}50.01%,100%{opacity:0}}
  @media (prefers-reduced-motion:reduce){ .nav-cta-caret{animation:none;opacity:0} }

  .page{width:100%;margin:0 auto;background:#ffffff;color:#16211a}

  /* hover / focus */
  .nav-lnk{padding:7px 11px;border-radius:9px;transition:color .15s,background .15s}
  .nav-lnk:hover{color:#0a7a52 !important;background:rgba(10,122,82,0.07)}
  .btn-dark{transition:background .2s,color .2s}
  .btn-dark:hover{background:#0a7a52 !important;color:#fff !important}
  .btn-ghost{transition:color .15s,background .15s}
  .btn-ghost:hover{color:#0a7a52 !important;background:#fff !important}
  .btn-accent{transition:background .2s}
  .btn-accent:hover{background:#00b96c !important;color:#0b1a11 !important}
  .btn-cta{transition:background .2s,box-shadow .2s}
  .btn-cta:hover{background:#0c6a49 !important;box-shadow:0 14px 30px -14px rgba(10,122,82,0.6)}
  .lnk-green{transition:color .15s}
  .lnk-green:hover{color:#16211a !important}
  .lnk-accent{transition:color .15s}
  .lnk-accent:hover{color:#fff !important}
  .row-lnk{transition:color .15s}
  .row-lnk:hover{color:#0a7a52 !important}
  .foot-lnk{transition:color .15s}
  .foot-lnk:hover{color:#fff !important}
  .inp{transition:border-color .15s}
  .inp:focus{border-color:#0a7a52 !important}

  /* ---------- WARIANT A · DROGA POD HERO — reveal na scroll ---------- */
  .la-droga .dg-line{stroke-dasharray:1;stroke-dashoffset:1;transition:stroke-dashoffset 1.5s ease .1s}
  .la-droga.in .dg-line{stroke-dashoffset:0}
  .la-droga .dg-fill{opacity:0;transition:opacity 1.4s ease .1s}
  .la-droga.in .dg-fill{opacity:1}
  .la-droga .dg-dot{opacity:0;transform:scale(.3);transition:opacity .45s ease,transform .45s ease}
  .la-droga.in .dg-dot{opacity:1;transform:scale(1)}
  .la-droga .dg-conn{opacity:0;transition:opacity .5s ease}
  .la-droga.in .dg-conn{opacity:.9}
  .la-droga .dg-chip{opacity:0;transition:opacity .5s ease}
  .la-droga.in .dg-chip{opacity:1}
  .la-droga .dg-card{opacity:0;transform:translateY(14px);transition:opacity .5s ease,transform .5s cubic-bezier(0.4,0,0.2,1)}
  .la-droga.in .dg-card{opacity:1;transform:none}
  @media (prefers-reduced-motion:reduce){
    .la-droga .dg-line,.la-droga .dg-fill,.la-droga .dg-dot,.la-droga .dg-conn,.la-droga .dg-chip,.la-droga .dg-card{transition:none}
  }

  /* ---------- „CZYM SIĘ RÓŻNIMY" · zdjęcie wtopione w sekcję (wariant v2) ----------
     Maska, nie nakładka w kolorze tła: nakładka nigdy nie trafia w radialny
     gradient sekcji i zostawia widoczną krawędź. Prawa krawędź trzyma się
     kolumny treści (te same 1440 px co reszta strony), więc na szerokim
     ekranie portret nie ucieka w sam róg ekranu. */
  .dm-foto{position:absolute;right:max(clamp(20px,5vw,56px),calc((100% - 1440px) / 2));top:0;bottom:0;width:min(50%,600px);z-index:1}
  .dm-foto img{width:100%;height:100%;object-fit:cover;object-position:54% 18%;display:block;filter:brightness(.94) saturate(.96);
    -webkit-mask-image:linear-gradient(to right,transparent 0%,rgba(0,0,0,0.10) 8%,rgba(0,0,0,0.34) 16%,rgba(0,0,0,0.64) 24%,rgba(0,0,0,0.88) 32%,#000 39%,#000 76%,rgba(0,0,0,0.86) 84%,rgba(0,0,0,0.52) 91%,rgba(0,0,0,0.18) 96.5%,transparent 100%);
            mask-image:linear-gradient(to right,transparent 0%,rgba(0,0,0,0.10) 8%,rgba(0,0,0,0.34) 16%,rgba(0,0,0,0.64) 24%,rgba(0,0,0,0.88) 32%,#000 39%,#000 76%,rgba(0,0,0,0.86) 84%,rgba(0,0,0,0.52) 91%,rgba(0,0,0,0.18) 96.5%,transparent 100%)}
  .dm-podpis{position:absolute;right:clamp(16px,2.2vw,32px);bottom:clamp(18px,2.6vw,30px);z-index:2;text-align:right}
  .dm-podpis b{display:block;font-size:15px;font-weight:800;color:#ffffff}
  .dm-podpis span{display:block;margin-top:2px;font-size:12.5px;color:rgba(255,255,255,0.7)}
  .dm-tresc{position:relative;z-index:2;max-width:min(56%,640px)}
  @media (max-width:1100px){ .dm-tresc{max-width:min(64%,600px)} .dm-foto{width:min(44%,430px)} }
  @media (max-width:860px){
    .dm-tresc{max-width:100%}
    .dm-foto{position:relative;right:auto;top:auto;bottom:auto;width:100%;height:250px;margin-bottom:30px;border-radius:18px;overflow:hidden}
    .dm-foto img{object-position:50% 16%;
      -webkit-mask-image:linear-gradient(to bottom,#000 58%,rgba(0,0,0,0.72) 86%,rgba(0,0,0,0.42) 100%);
              mask-image:linear-gradient(to bottom,#000 58%,rgba(0,0,0,0.72) 86%,rgba(0,0,0,0.42) 100%)}
    .dm-podpis{right:auto;left:18px;bottom:14px;text-align:left}
  }

  /* ---------- Zakładki oferty (S4) ----------
     Pasek pokazuje, ile zostało do samoczynnej zmiany zakładki. Po pierwszym
     kliknięciu rotacja gaśnie na dobre (klasa .krok-stop na kontenerze) —
     wybór użytkownika nie może mu zniknąć spod kursora. */
  .krok-pasek{display:block;height:2px;margin-top:12px;border-radius:2px;background:#e3e9e1;overflow:hidden;opacity:0;transition:opacity .25s}
  .krok-tab.krok-on .krok-pasek{opacity:1}
  .krok-tabs.krok-stop .krok-pasek{opacity:0 !important}
  .krok-pasek i{display:block;height:100%;width:0;border-radius:2px;background:var(--la-accent,#00CD77)}
  @media (prefers-reduced-motion:reduce){ .krok-pasek{display:none} }

  /* ---------- FAQ (akordeon) ---------- */
  .faq-item{border-top:1px solid #e7ece4}
  .faq-item:last-child{border-bottom:1px solid #e7ece4}
  .faq-q{appearance:none;width:100%;background:none;border:none;font-family:inherit;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:20px;text-align:left;padding:24px 4px;font-size:clamp(17px,2vw,20px);font-weight:700;letter-spacing:-0.01em;color:#16211a;transition:color .15s}
  .faq-q:hover{color:#0a7a52}
  .faq-ico{flex-shrink:0;display:flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:50%;background:#e9f2ea;color:#0a7a52;transition:transform .35s cubic-bezier(0.4,0,0.2,1),background .2s}
  .faq-item.open .faq-ico{transform:rotate(180deg);background:var(--la-accent,#00CD77);color:#0b1a11}
  .faq-a{overflow:hidden;max-height:0;transition:max-height .4s cubic-bezier(0.4,0,0.2,1)}
  .faq-item.open .faq-a{max-height:340px}
  .faq-a-inner{padding:0 4px 26px;max-width:660px;font-size:15.5px;line-height:1.65;color:#4c5850;text-wrap:pretty}
  @media (prefers-reduced-motion:reduce){ .faq-a,.faq-ico{transition:none} }

  /* ---------- RACHUNEK (S2) ----------
     Courier Prime zamiast ui-monospace. SF Mono/Menlo czyta się jak okno
     terminala — a ten blok ma wyglądać na wydruk z drukarki fiskalnej.
     Courier ma niższy x-height i szerszy krój, więc zerujemy ujemny tracking
     i lekko podbijamy najmniejsze rozmiary. */
  #la8-rachunek{letter-spacing:0}
  #la8-rachunek span{letter-spacing:inherit}
  #la8-rachunek .rcpt-head{letter-spacing:0.2em}
  #la8-rachunek .rcpt-lbl{letter-spacing:0.14em}

  /* ---------- OPINIE (ściana / marquee) ---------- */
  .marq{position:relative;overflow:hidden;
    -webkit-mask:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);
            mask:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent)}
  .marq-track{display:flex;gap:20px;width:max-content;will-change:transform;animation:marq-scroll 46s linear infinite}
  .marq:hover .marq-track{animation-play-state:paused}
  .marq-card{flex:0 0 auto;width:min(340px,80vw);display:flex;flex-direction:column;background:#ffffff;border:1px solid #e7ece4;border-radius:16px;padding:24px 24px 20px}
  /* Krok = szerokość jednego zestawu kart: -(100/KOPIE)% minus odstęp/KOPIE.
     Przy KOPIE = 5 i gap 20px daje to calc(-20% - 4px). */
  @keyframes marq-scroll{from{transform:translateX(0)}to{transform:translateX(calc(-20% - 4px))}}
  @media (prefers-reduced-motion:reduce){
    .marq{overflow-x:auto;-webkit-mask:none;mask:none;scroll-snap-type:x mandatory}
    .marq-track{animation:none}
    .marq-card{scroll-snap-align:start}
    .marq-dup{display:none !important}
  }

  /* ---------- Pozioma pętla logotypów w pasku trust (chowają się pod napisem) ---------- */
  .trust-logos{overflow:hidden;position:relative;z-index:1;margin-left:-76px}
  .trust-track{display:flex;align-items:center;gap:56px;width:max-content;animation:trust-scroll 30s linear infinite}
  .trust-logos:hover .trust-track{animation-play-state:paused}
  @keyframes trust-scroll{from{transform:translateX(0)}to{transform:translateX(calc(-50% - 28px))}}
  @media (prefers-reduced-motion:reduce){ .trust-track{animation:none} }

  /* ---------- RESPONSYWNOŚĆ ---------- */
  @media (max-width:1024px){
    .faq-grid{grid-template-columns:1fr !important;gap:clamp(32px,5vw,48px) !important}
    .droga-cards{grid-template-columns:repeat(3,1fr) !important;gap:28px 22px !important}
    /* minmax(0,1fr): samo `1fr` nie schodzi poniżej najszerszej treści
       w kolumnie — przy 320px makieta rachunku wypychała sekcję o 52px. */
    .s2-grid,.s6-grid,.s9-grid{grid-template-columns:minmax(0,1fr) !important;gap:clamp(40px,6vw,64px) !important}
    .grid4{grid-template-columns:1fr 1fr !important}
  }
  @media (max-width:900px){
    .droga-cards{grid-template-columns:repeat(2,1fr) !important}
    .droga-cta{flex-direction:column !important;align-items:flex-start !important;gap:28px !important}
    .droga-cta-btns{align-items:stretch !important;width:100%}
    .droga-cta-btns a{justify-content:center !important;text-align:center}
    .s4-grid,.s8-grid,.metody-grid{grid-template-columns:1fr !important;gap:48px !important}
    .grid3{grid-template-columns:1fr !important;gap:32px !important}
    .foot-grid{grid-template-columns:1fr 1fr !important;gap:40px !important}
    .nav-menu{display:none !important}
    .s4-layers{position:static !important;height:auto !important;min-height:0 !important}
    .krok-layer{position:static !important;opacity:1 !important;transform:none !important;display:none !important}
    .krok-layer.active{display:block !important}
    /* Palec potrzebuje więcej niż wysokość linijki tekstu: linki-odnośniki
       dostają zapas w pionie bez zmiany odstępów (ujemny margines go znosi). */
    .lnk-green,.row-lnk{padding-block:10px;margin-block:-10px}
  }
  @media (max-width:600px){
    .droga-cards{grid-template-columns:1fr !important;gap:24px !important}
    .grid4,.grid2,.foot-grid{grid-template-columns:1fr !important}
    .hero-actions{flex-direction:column !important;align-items:stretch !important;width:100%}
    .hero-actions>div{width:100%}
    .hero-actions a{justify-content:center !important}
    /* Napis idzie nad logotypy, a pętla dostaje całą szerokość. Wcześniej
       `flex-wrap` siedział na .trust-logos, a zawijać musiałby się .trust-track
       (ma width:max-content) — przy 390px pas wyjeżdżał 627px poza kadr. */
    .trust{flex-wrap:wrap !important;justify-content:center !important;gap:18px !important;text-align:center}
    .trust>span{max-width:none !important;padding-right:0 !important}
    .trust-logos{flex:1 0 100% !important;margin-left:0 !important;overflow:hidden !important}
    .trust-track{gap:34px !important}
    .stat-row{flex-wrap:wrap !important;gap:24px 32px !important}
    .metody-badge-row{flex-direction:column !important;align-items:flex-start !important;gap:16px !important}
    .final-badge-row{flex-wrap:wrap !important}
    .cta-card{grid-template-columns:1fr !important}
    .cta-portrait{display:none !important}
  }
  /* ---- sticky header + mega menu ---- */
  .site-header{position:sticky;top:0;z-index:60;padding:0 clamp(16px,4vw,40px);transition:padding-top .35s cubic-bezier(.4,0,.2,1)}
  .site-header.scrolled{padding-top:12px}
  .nav-pill{display:flex;align-items:center;justify-content:space-between;gap:20px;max-width:1440px;margin:0 auto;padding:16px 14px 16px 8px;background:transparent;border:1px solid transparent;border-radius:18px;box-shadow:none;transition:max-width .4s cubic-bezier(.4,0,.2,1),padding .35s cubic-bezier(.4,0,.2,1),background .3s,border-color .3s,box-shadow .3s}
  .site-header.scrolled .nav-pill{max-width:1180px;padding:8px 12px 8px 22px;background:rgba(255,255,255,0.78);backdrop-filter:blur(18px) saturate(1.5);-webkit-backdrop-filter:blur(18px) saturate(1.5);border-color:rgba(255,255,255,0.6);box-shadow:0 16px 46px -18px rgba(18,38,28,0.34)}
  .nav-item{display:flex;align-items:center}
  .mega-wrap{position:absolute;top:calc(100% - 20px);left:50%;transform:translateX(-50%) translateY(6px);width:min(940px,calc(100vw - 40px));padding-top:34px;opacity:0;visibility:hidden;pointer-events:none;transition:opacity .18s ease,transform .18s ease}
  .nav-item:hover .mega-wrap,.nav-item:focus-within .mega-wrap{opacity:1;visibility:visible;transform:translateX(-50%) translateY(0);pointer-events:auto}
  .nav-caret{transition:transform .2s}
  .nav-item:hover .nav-caret,.nav-item:focus-within .nav-caret{transform:rotate(180deg)}
  .mega-eyebrow{font-weight:700;font-size:11px;letter-spacing:0.07em;text-transform:uppercase;color:#808b83;padding:0 11px;margin-bottom:6px}
  .mega-item{display:block;padding:9px 11px;border-radius:11px;transition:background .15s}
  .mega-item:hover{background:#f4f8f2}
  .mega-t{display:block;font-size:14.5px;font-weight:650;color:#16211a;transition:color .15s}
  .mega-item:hover .mega-t{color:#0a7a52}
  .mega-d{display:block;margin-top:2px;font-size:12.5px;line-height:1.4;color:#8b968d}
  .mega-feat{display:flex;flex-direction:column;justify-content:center;background:radial-gradient(120% 120% at 100% 0%, rgba(0,205,119,0.16), transparent 55%), #0e2b1d;border-radius:14px;padding:24px 22px;color:#ffffff;transition:transform .2s,box-shadow .2s}
  .mega-feat:hover{transform:translateY(-2px);box-shadow:0 22px 44px -22px rgba(0,0,0,0.5)}
  /* ---- Megamenu usług: triaż po sytuacji klienta ---- */
  .usl-grid{display:grid;grid-template-columns:1fr 1fr 1fr;grid-template-rows:auto auto auto;gap:0 6px}
  .usl-lane{display:grid;grid-template-rows:subgrid;grid-row:span 3;padding:15px 14px 11px;border-radius:14px;transition:background .2s}
  .usl-top{align-self:start}
  .usl-head{display:block;font-size:24px;font-weight:800;line-height:1.06;letter-spacing:-0.032em;text-wrap:balance;color:#16211a;transition:color .18s}
  .usl-head:hover{color:#0a7a52}
  .usl-sub{display:block;margin-top:9px;font-size:12.5px;line-height:1.45;color:#8b968d}
  .usl-rule{display:block;width:26px;height:2px;margin:16px 0 15px;border-radius:2px;background:var(--la-accent,#00CD77);transition:width .28s cubic-bezier(.4,0,.2,1)}
  .usl-lane:hover .usl-rule{width:78px}
  .usl-list .mega-item{padding:7px 9px;margin-left:-9px;border-radius:10px}
  .usl-list .mega-item:hover{background:#eef5ec}
  .usl-list .mega-t{font-size:14px;font-weight:650}
  .usl-list .mega-d{font-size:12px;color:#96a098}
