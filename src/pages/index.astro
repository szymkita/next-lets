<script>
  // ---- Hero: makieta pulpitu skalowana do szerokości kontenera ----
  (function(){
    var frame = document.querySelector('.mockup-frame');
    var scale = document.querySelector('.mockup-scale');
    if(!frame || !scale) return;
    // v7: środek zestawu (590 px) zawsze na środku kolumny. Wcześniej
    // margin:auto przy pudełku szerszym niż kolumna zerował się, a skala
    // od środka przesuwała makietę w prawo — na telefonie wypadała poza
    // ekran. Poniżej 700 px widać środek pulpitu (główną kolumnę) w większej
    // skali zamiast całego pulpitu w skali 0,3.
    function fit(){
      var w = frame.clientWidth;
      var s = w < 700 ? w / 640 : Math.min(1, w / 1180);
      scale.style.transformOrigin = 'top left';
      scale.style.margin = '0';
      scale.style.transform = 'translateX(' + (w / 2 - 590 * s) + 'px) scale(' + s + ')';
      frame.style.height = (400 * s) + 'px';
    }
    fit();
    window.addEventListener('resize', fit);
    window.addEventListener('load', fit);
  })();


  // ---- Opinie (v8): cztery cytaty w jednym miejscu ----
  // Przenikanie co 8 s, gdy cytat jest na ekranie; pauza pod kursorem i przy
  // fokusie; przy prefers-reduced-motion tylko strzałki.
  (function(){
    var w = document.querySelector('[data-op9]');
    if(!w) return;
    var k = Array.prototype.slice.call(w.querySelectorAll('[data-op9-k]'));
    var red = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var CZAS = 8000, i = 0, timer = null, widoczna = false, pauza = false;
    function plan(){
      clearTimeout(timer);
      if(red || pauza || !widoczna) return;
      timer = setTimeout(function(){ pokaz(i + 1); }, CZAS);
    }
    function pokaz(n){
      i = (n + k.length) % k.length;
      k.forEach(function(el, j){ el.classList.toggle('on', j === i); el.setAttribute('aria-hidden', j === i ? 'false' : 'true'); });
      plan();
    }
    w.querySelector('[data-op9-wstecz]').addEventListener('click', function(){ pokaz(i - 1); });
    w.querySelector('[data-op9-dalej]').addEventListener('click', function(){ pokaz(i + 1); });
    w.addEventListener('mouseenter', function(){ pauza = true; plan(); });
    w.addEventListener('mouseleave', function(){ pauza = false; plan(); });
    w.addEventListener('focusin', function(){ pauza = true; plan(); });
    w.addEventListener('focusout', function(e){ if(!w.contains(e.relatedTarget)){ pauza = false; plan(); } });
    if('IntersectionObserver' in window){
      new IntersectionObserver(function(e){ widoczna = e[0].isIntersecting; plan(); }, { threshold: 0.5 }).observe(w);
    } else { widoczna = true; plan(); }
  })();

  // ---- Rotator (S1b) — pionowe przewijanie fraz co 3s ----
  (function(){
    var col = document.getElementById('rotator-col');
    if(!col) return;
    var count = col.children.length;
    var i = 0;
    setInterval(function(){
      i = (i + 1) % count;
      var h = col.children[0].offsetHeight || 60;
      col.style.transform = 'translateY(-' + (i * h) + 'px)';
    }, 3000);
  })();

  // ---- Droga pod hero (S1b, wariant A) — reveal wykresu i osi czasu ----
  (function(){
    var sec = document.querySelector('.la-droga');
    if(!sec) return;
    if(!('IntersectionObserver' in window)){ sec.classList.add('in'); return; }
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if(e.isIntersecting){ sec.classList.add('in'); io.disconnect(); } });
    }, { threshold: 0.12 });   // v9: sekcja na telefonie ma ok. 3 ekrany wysokości — 0.25 łapało się na styk
    io.observe(sec);
  })();

  // ---- FAQ (S9b) — akordeon ----
  (function(){
    var items = document.querySelectorAll('.faq-item');
    if(!items.length) return;
    items.forEach(function(item){
      var btn = item.querySelector('.faq-q');
      if(!btn) return;
      btn.addEventListener('click', function(){
        var willOpen = !item.classList.contains('open');
        items.forEach(function(other){
          other.classList.remove('open');
          var b = other.querySelector('.faq-q');
          if(b) b.setAttribute('aria-expanded', 'false');
        });
        if(willOpen){
          item.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  })();

  // ---- Oferta (S4) — linki dróg z megamenu ----
  // Zakładek już nie ma: wszystkie trzy drogi stoją na stronie. Klik w nazwę
  // drogi w megamenu (data-krok-link) przewija do jej grupy, jeśli link
  // prowadzi na tę samą stronę.
  (function(){
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion:reduce)').matches;
    document.querySelectorAll('[data-krok-link]').forEach(function(el){
      var k = el.dataset.krokLink;
      var cel = k && document.getElementById('oferta-' + k);
      if(!cel) return;
      el.addEventListener('click', function(e){
        if(new URL(el.href, location.href).pathname !== location.pathname) return;
        e.preventDefault();
        cel.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      });
    });
  })();

  // ---- Rachunek (S2) — licznik od 0 do wartości docelowej gdy widoczny ----
  (function(){
    var el = document.getElementById('la8-rachunek');
    if(!el) return;
    var vals = el.querySelectorAll('.rcpt-val');
    var totalEl = document.getElementById('rcpt-total');
    var done = false;
    function animate(){
      if(done) return; done = true;
      var t0 = performance.now();
      function step(t){
        var p = Math.min(1, (t - t0) / 1500);
        var rp = 1 - Math.pow(1 - p, 3);
        vals.forEach(function(v){ v.textContent = Math.round(v.dataset.h * rp) + ' h'; });
        if(totalEl) totalEl.textContent = Math.round(totalEl.dataset.total * rp);
        if(p < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }
    if('IntersectionObserver' in window){
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(e){ if(e.isIntersecting){ animate(); io.disconnect(); } });
      }, { threshold: 0.2 });
      io.observe(el);
    } else { animate(); }
  })();

  // ---- Pulpit (hero) — sporadyczny wzrost licznika zadań ----
  (function(){
    var numEl = document.getElementById('tasksNum');
    var labelEl = document.getElementById('tasksLabel');
    if(!numEl) return;
    var n = 42;
    function word(x){
      var m10 = x % 10, m100 = x % 100;
      return (m10 >= 2 && m10 <= 4 && !(m100 >= 12 && m100 <= 14)) ? 'zadania' : 'zadań';
    }
    setInterval(function(){
      if(Math.random() < 0.45){
        n += 1;
        numEl.textContent = n;
        if(labelEl) labelEl.textContent = n + ' ' + word(n) + ' zrobione dziś';
      }
    }, 5200);
  })();


</script>

