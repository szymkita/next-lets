// ---- HERO: UDZIAŁ AI W POWSTAWANIU KODU --------------------------------
// Jeden rysunek, dwa łuki na wspólnym środku: ile kodu powstaje z agentem
// w zespole, który ma narzędzia i nie ma spisanych zasad, i ile powstaje
// u zespołu pracującego w WiseStacku. Bez karty i bez cienia — rysunek
// leży na poświacie hero, więc nie odcina się od tła jak wklejony widget.
const KOLA = [
  { t: 'Zespół w WiseStacku', o: 'reguły i szablony w repozytorium', v: 100, r: 104, my: true },
  { t: 'Zespół z agentami', o: 'narzędzia są, zasad nie ma', v: 31, r: 66 },
];
const obwod = (r) => +(2 * Math.PI * r).toFixed(2);
const luk = (r, v) => (obwod(r) * (1 - v / 100)).toFixed(2);

const KO = { c: 10, start: 0.5, krok: 0.75, rysuje: 1.6, trzyma: 4.6, wyjscie: 0.6 };
const kp = (t) => `${((t / KO.c) * 100).toFixed(2)}%`;
const KO_KRES = KO.start + (KOLA.length - 1) * KO.krok + KO.rysuje + KO.trzyma;
const klatkiKol = [
  ...KOLA.map((k, i) => {
    const t = KO.start + i * KO.krok;
    const pusty = obwod(k.r);
    return `@keyframes ko-luk${i}{0%,${kp(t)}{stroke-dashoffset:${pusty}}${kp(t + KO.rysuje)}{stroke-dashoffset:${luk(k.r, k.v)}}${kp(KO_KRES)}{stroke-dashoffset:${luk(k.r, k.v)}}${kp(KO_KRES + KO.wyjscie)}{stroke-dashoffset:${pusty}}100%{stroke-dashoffset:${pusty}}}`;
  }),
  ...KOLA.map((_, i) => {
    const t = KO.start + i * KO.krok + KO.rysuje;
    return `@keyframes ko-licz${i}{0%,${kp(t - 0.55)}{opacity:0;transform:translateY(5px)}${kp(t)}{opacity:1;transform:none}${kp(KO_KRES)}{opacity:1;transform:none}${kp(KO_KRES + KO.wyjscie)}{opacity:0;transform:translateY(5px)}100%{opacity:0;transform:translateY(5px)}}`;
  }),
].join('\n');


