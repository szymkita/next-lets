];
const NA_W = 1200, NA_H = 190;          // układ współrzędnych krzywej
const nx = (i) => +((i / (NASZ.length - 1)) * NA_W).toFixed(1);
const ny = (v) => +(NA_H - (v / 100) * NA_H).toFixed(1);
const NA_LINIA = NASZ.map((p, i) => `${nx(i)},${ny(p.v)}`).join(' ');
const NA_POLE = `0,${NA_H} ${NA_LINIA} ${NA_W},${NA_H}`;
