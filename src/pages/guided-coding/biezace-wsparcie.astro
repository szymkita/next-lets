// =====================================================================
// MIARA STRONY · pół roku jednego zespołu (bez działu IT)
// Słupek miesiąca to wszystkie nowe wersje, kreskowane — te, które wróciły
// z uwagami (liczby ze starej strony). „z" to jedna z zasad dopisanych w tym
// miesiącu, „zasad" — ile ich doszło.
// =====================================================================
const MIESIACE = [
  { wersji: 18, uwag: 11, zasad: 4, z: 'Klucze i hasła trzymamy poza kodem' },
  { wersji: 24, uwag: 11, zasad: 4, z: 'Dane klientów nie trafiają do dziennika zdarzeń' },
  { wersji: 31, uwag: 10, zasad: 3, z: 'AI nie zmienia pieniędzy bez zgody człowieka' },
  { wersji: 38, uwag: 11, zasad: 4, z: 'Każda rzecz podpięta z zewnątrz ma właściciela z imienia' },
  { wersji: 46, uwag: 8, zasad: 3, z: 'Pliki z danymi klientów wychodzą tylko linkiem' },
  { wersji: 55, uwag: 7, zasad: 3, z: 'Eksporty i raporty pobierają dane porcjami' },
];
const ZASAD_RAZEM = MIESIACE.reduce((a, m) => a + m.zasad, 0);   // 21
const proc = (m) => Math.round((m.uwag / m.wersji) * 100);
const odm = (n, jeden, kilka, wiele) => (n === 1 ? jeden : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? kilka : wiele);

// ---- KARTKA MIESIĄCA · zespół bez działu IT (szósty miesiąc) ------------
// Liczby wersji, pytań, sesji i dni z uwagą — ze starej strony (tablica DNI).
// Treść uwag, pytań i tematów sesji — PRZYKŁADOWA. Uwaga dotyczy ostatniej
// wersji danego dnia; „zt" = z tej uwagi powstała zasada.
// Miesiąc zaczyna się w poniedziałek, więc daty to 1–5, 8–12, 15–19, 22–26.
const DNI = [
  { w: 2, q: 1, qt: 'Jak cofnąć wersję, która poszła do ludzi?' },
  { w: 3, p: 'Przycisk „Anuluj” kasuje zamówienie z bazy' },
  { w: 2, q: 2, qt: 'Skąd Claude Code bierze nasze zasady?' },
  { w: 4, p: 'Zmiana statusu zamówienia bez śladu, kto ją zrobił', zt: 'Każda zmiana statusu zapisuje, kto i kiedy jej dokonał', q: 1 },
  { w: 3 },
  { w: 3, q: 1 },
  { w: 2, p: 'Formularz reklamacji przyjmuje plik dowolnej wielkości', q: 1 },
  { w: 3, s: 'integracja z kurierem' },
  { w: 2, q: 1 },
  { w: 4, p: 'Zdjęcia z reklamacji zapisują się w pełnej rozdzielczości', zt: 'Zdjęcia od klientów zmniejszamy przed zapisem' },
  { w: 2, q: 2, qt: 'Czy da się dodać logowanie przez Google?' },
  { w: 3 },
  { w: 2, p: 'Raport marży pomija koszt wysyłki', q: 1 },
  { w: 4, s: 'sprawdzanie zmian na kopii danych' },
  { w: 2, q: 1 },
  { w: 3, p: 'Powiadomienie do klienta wychodzi dwa razy', q: 1 },
  { w: 2 },
  { w: 4, p: 'Eksport pobiera wszystkie zamówienia naraz', zt: 'Eksporty i raporty pobierają dane porcjami', q: 2 },
  { w: 2, q: 1 },
  { w: 3, d: true },
];
const DNI_TYG = ['pn', 'wt', 'śr', 'cz', 'pt'];
const dzien = (i) => ({ tydz: Math.floor(i / 5) + 1, dz: DNI_TYG[i % 5], data: Math.floor(i / 5) * 7 + (i % 5) + 1 });
let bieg = 0;
const KAL = DNI.map((x, i) => {
  bieg += x.w;
  return { ...x, i, ...dzien(i), v: bieg, ten: bieg === 50 };   // v = ostatnia wersja dnia
});
const M6 = {
  wersji: bieg,                                              // 55
  uwag: KAL.filter((x) => x.p).length,                       // 7
  zasad: KAL.filter((x) => x.zt).length,                     // 3
};
// Wersje z uwagą w szóstym miesiącu — te same kwadraty na wykresie półrocza.
const UWAGI_M6 = KAL.filter((x) => x.p).map((x) => x.v);     // 5, 11, 19, 28, 35, 44, 50
const rozloz = (n, u) => Array.from({ length: u }, (_, k) => Math.min(n, Math.round(((k + 0.5) * n) / u) + 1));
const MS = MIESIACE.map((m, r) => {
  const u = new Set(r === 5 ? UWAGI_M6 : rozloz(m.wersji, m.uwag));
  return { ...m, r, chipy: Array.from({ length: m.wersji }, (_, j) => ({ j, u: u.has(j + 1), ten: r === 5 && j + 1 === 50 })) };
});

// ---- KARTKA MIESIĄCA · dział IT z agentami (trzeci miesiąc) --------------
// Kształt z KADENCJA na /guided-coding/dla-zespolow-old: sesja co tydzień
// na zadaniu z backlogu (tu: wtorki), kanał na zadania, które agentowi nie
// wyszły, co dwa tygodnie kolejny moduł dostaje reguły i testy granic, raz
// w miesiącu godzina z leadami. Treść PRZYKŁADOWA. „zt" = plik w .agents/,
// do którego trafiła reguła z tego zadania.
const DNI_IT = [
  {}, { s: 'zwrot części rezerwacji' }, {}, { k: 'Agent mylił rezerwację wstępną z potwierdzoną', zt: 'domena.md' }, {},
  {}, { s: 'limity miejsc na zajęciach grupowych' }, {}, { m: 'Płatności' }, { k: 'Agent zmienił publiczny interfejs modułu płatności', zt: 'architektura.md' },
  { k: 'Agent zgadywał kolejność kroków z ogólnego opisu', zt: 'szablon opisu zadania' }, { s: 'faktury zbiorcze dla firm' }, {}, {}, {},
  {}, { s: 'przypomnienia SMS przed wizytą' }, { k: 'Migracja bazy bez drogi powrotu' }, { m: 'Zwroty' }, { l: true },
];
const KAL_IT = DNI_IT.map((x, i) => ({ ...x, i, ...dzien(i) }));

// Pozycje dnia na kartce: c = klasa koloru, ik = ikona, t = treść, em = dopisek.
const POZ_BEZ = (x) => [
  x.p && { c: 'u', ik: 'exclamation-triangle', t: x.p, em: `uwaga do wersji ${x.v}` },
  x.zt && { c: 'z', ik: 'document-check', t: 'Nowa zasada w repozytorium' },
  x.s && { c: 's', ik: 'users', t: `Sesja przy jednym ekranie, 90 min: ${x.s}` },
  x.q && { c: '', ik: 'chat-bubble-left-ellipsis', t: x.qt || `${x.q} ${odm(x.q, 'pytanie', 'pytania', 'pytań')} na kanale` },
  x.d && { c: 'd', ik: 'document-text', t: 'Podsumowanie miesiąca, godzina' },
].filter(Boolean);
const POZ_IT = (x) => [
  x.s && { c: 's', ik: 'users', t: `Sesja na zadaniu z backlogu: ${x.s}` },
  x.k && { c: 'u', ik: 'exclamation-triangle', t: x.k, em: 'zadanie z kanału' },
  x.zt && { c: 'z', ik: 'document-check', t: `Nowa reguła: ${x.zt}` },
  x.m && { c: 'm', ik: 'code-bracket', t: `Moduł ${x.m}: reguły domeny i testy granic` },
  x.l && { c: 'd', ik: 'document-text', t: 'Godzina z leadami przy czterech liczbach' },
].filter(Boolean);

// Liczniki w nagłówku kartki. „l" = klucz atrybutu data-c-<l> dnia; skrypt
// liczy je od zera razem z wypełnianiem dni. W markupie stoją wartości końcowe.
const KARTKI = [
  {
    v: 'bez', tytul: 'Miesiąc 6 abonamentu', pod: 'Panel zamówień · Anna K. i Adam W. z działu operacji',
    dni: KAL.map((x) => ({ ...x, poz: POZ_BEZ(x), chipy: Array.from({ length: x.w }, (_, k) => (x.p && k === x.w - 1 ? 'u' : '')), c: { w: x.w, u: x.p ? 1 : 0, z: x.zt ? 1 : 0 } })),
    licz: [{ l: 'w', t: 'Nowe wersje', n: M6.wersji }, { l: 'u', t: 'Z uwagami', n: M6.uwag }, { l: 'z', t: 'Nowe zasady', n: M6.zasad }],
  },
  {
    v: 'it', tytul: 'Miesiąc 3 abonamentu', pod: 'Platforma rezerwacji wizyt · zespół ośmiu inżynierów',
    dni: KAL_IT.map((x) => ({ ...x, poz: POZ_IT(x), chipy: [], c: { s: x.s ? 1 : 0, k: x.k ? 1 : 0, m: x.m ? 1 : 0 } })),
    licz: [{ l: 's', t: 'Sesje', n: KAL_IT.filter((x) => x.s).length }, { l: 'k', t: 'Zadania z kanału', n: KAL_IT.filter((x) => x.k).length }, { l: 'm', t: 'Moduły z regułami', n: KAL_IT.filter((x) => x.m).length }],
  },
];

// ---- WYBÓR ZESPOŁU · co się różni i co wspólne ---------------------------
// Kadencje, czasy i stawki z huba (DROGI) i ze starych stron.
const OPCJE = [
