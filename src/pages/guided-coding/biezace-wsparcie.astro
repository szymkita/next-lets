};
---

<LaBase topbar={false} title={title} description={description} ctaHref="#kontakt" ctaLabel="Umów rozmowę" nav="uslugi">
<script type="application/ld+json" is:inline set:html={JSON.stringify(dane)} slot="head"></script>
<style is:global slot="head">
  /* Style rysunków tej usługi. Wspólny wygląd: src/components/usluga/Styl.astro.
     Każdy rysunek ma stan końcowy w markupie; animacja dokłada .gra
     i dopiero pod nią chowają się stany pośrednie. */

  /* =====================================================================
     HERO · zdjęcie prowadzącego i jedna wymiana (.rh-)
     ===================================================================== */
  .rh{margin:0;container-type:inline-size;container-name:rh}
  /* zdjęcie i stos wiadomości w jednej komórce siatki: wysokość rysunku
     to wyższy z nich, więc dłuższe wiadomości nie wychodzą poza planszę */
  .rh-sc{position:relative;display:grid;grid-template-columns:53% 47%;align-items:start;font-size:clamp(11px,1.85cqi,14px);padding:0.6em 0}
  .rh-foto{position:relative;grid-column:2;grid-row:1;margin:0;width:100%;aspect-ratio:0.76;border-radius:1.6em;overflow:hidden;background:#cdd0ce;box-shadow:0 50px 90px -40px rgba(0,0,0,0.85)}
  .rh-foto img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 12%}
  .rh-foto::after{content:"";position:absolute;left:0;right:0;bottom:0;height:42%;background:linear-gradient(to top,rgba(7,20,13,0.9),rgba(7,20,13,0))}
  .rh-foto figcaption{position:absolute;left:30%;right:1.3em;bottom:1.25em;z-index:1;color:#ffffff;text-align:right}
  .rh-foto figcaption b{display:block;font-size:1.08em;font-weight:700;letter-spacing:-0.01em}
  .rh-foto figcaption span{display:block;margin-top:0.2em;font-size:0.85em;color:rgba(255,255,255,0.72)}
  /* stos przypięty do góry: rosnąca odpowiedź nie przesuwa wiadomości nad nią */
  .rh-rozm{position:relative;grid-column:1 / 3;grid-row:1;z-index:2;display:grid;gap:0.8em;width:62%;margin-top:4%}
  .rh-k{padding:1.05em 1.25em 1.15em;border-radius:1.1em;background:#ffffff;color:var(--t1);box-shadow:0 0 0 1px rgba(15,26,20,0.05),0 34px 60px -30px rgba(0,0,0,0.7)}
  .rh-k.my{margin-left:2.6em}
  .rh-kto{display:flex;align-items:center;gap:0.6em;margin:0;font-size:0.82em;color:var(--t3)}
  .rh-kto img{flex-shrink:0;width:2.1em;height:2.1em;border-radius:50%;object-fit:cover;background:#dfe3e0}
  .rh-kto b{font-weight:700;color:var(--t1)}
  .rh-kto time{margin-left:auto;white-space:nowrap}
  .rh-tx{margin:0.6em 0 0;font-size:1em;line-height:1.5;color:var(--t1);text-wrap:pretty}
  .rh-zal{display:flex;align-items:center;gap:0.55em;margin-top:0.75em;padding:0.6em 0.8em;border-radius:0.7em;background:var(--papier);font-size:0.82em;font-weight:600;color:var(--t2)}
  .rh-zal svg{flex-shrink:0;width:1.1em;height:1.1em;fill:var(--ziel-c)}
  .rh-pisze{display:none;gap:0.3em;margin-top:0.8em}
  .rh-pisze i{width:0.45em;height:0.45em;border-radius:50%;background:var(--t3);animation:rh-kropka 1s ease-in-out infinite}
  .rh-pisze i:nth-child(2){animation-delay:.15s}
  .rh-pisze i:nth-child(3){animation-delay:.3s}
  @keyframes rh-kropka{0%,60%,100%{opacity:0.25}30%{opacity:1}}
  .rh-czas{display:flex;align-items:center;gap:0.5em;margin-left:2.6em;font-size:0.8em;font-weight:650;color:var(--ziel)}
  .rh-czas::before{content:"";width:1.6em;height:1.5px;background:currentColor;opacity:0.6}
  .rh-z{margin-left:2.6em;padding:1em 1.25em 1.05em;border-radius:1.1em;background:var(--ziel);color:var(--ink);box-shadow:0 26px 50px -24px rgba(0,205,119,0.65)}
  .rh-z small{display:block;font-size:0.8em;font-weight:650;opacity:0.72}
  .rh-z b{display:block;margin-top:0.25em;font-size:1.14em;font-weight:750;letter-spacing:-0.018em;line-height:1.3}
  .rh-z span{display:block;margin-top:0.35em;font-size:0.82em;opacity:0.8}
  /* ruch: kolejno wiadomość klienta, odpowiedź (najpierw „pisze…"), zasada */
  .rh.gra .rh-k,.rh.gra .rh-czas,.rh.gra .rh-z{opacity:0;transform:translateY(0.8em);transition:opacity .45s ease,transform .45s cubic-bezier(.2,.8,.2,1)}
  .rh.gra.s1 .kl,.rh.gra.s2 .rh-czas,.rh.gra.s2 .my,.rh.gra.s4 .rh-z{opacity:1;transform:none}
  .rh.gra .my .rh-tx,.rh.gra .my .rh-zal{display:none}
  .rh.gra.s2:not(.s3) .my .rh-pisze{display:flex}
  .rh.gra.s3 .my .rh-tx{display:block;animation:rh-wej .4s ease both}
  .rh.gra.s3 .my .rh-zal{display:flex;animation:rh-wej .4s ease .25s both}
  .rh.gra .rh-z{transform:scale(1.06) translateY(0.4em)}
  .rh.gra.s4 .rh-z{transform:none}
  @keyframes rh-wej{from{opacity:0;transform:translateY(0.4em)}}
  @container rh (max-width:459px){
    .rh-sc{display:block;font-size:clamp(11px,3.2cqi,14px);padding:0}
    .rh-foto{width:100%;aspect-ratio:1.2}
    .rh-foto img{object-position:50% 16%}
    .rh-foto figcaption{bottom:auto;top:1.1em;left:1.2em;text-align:left}
    .rh-foto::after{top:0;bottom:auto;background:linear-gradient(to bottom,rgba(7,20,13,0.6),rgba(7,20,13,0))}
    .rh-rozm{width:auto;margin:-5.5em 0.6em 0}
    .rh-k.my,.rh-czas,.rh-z{margin-left:1.4em}
  }

  /* =====================================================================
     WYBÓR ZESPOŁU (#miesiac) · przełącznik, list z podsumowaniem, różnice
     ===================================================================== */
  /* =====================================================================
     WYBÓR ZESPOŁU (#miesiac) · przełącznik, kartka miesiąca, różnice
     Przełącznik to dwa pola radio; :has() chowa wersję, której nie wybrano.
     Przeglądarka bez :has() pokazuje obie wersje jedna pod drugą.
     ===================================================================== */
  .mi{margin-top:clamp(72px,9vw,136px);scroll-margin-top:24px}
  .mi-sr{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
  .mi-wyb{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;min-width:0;margin:24px 0 0;padding:0;border:0}
  .mi-op{position:relative;display:grid;grid-template-columns:22px minmax(0,1fr) 42px;gap:3px 16px;align-items:center;padding:18px 18px 18px 22px;border-radius:20px;background:#ffffff;color:var(--t1);box-shadow:0 0 0 1px var(--linia2);cursor:pointer;transition:background .25s,box-shadow .25s,color .25s}
  .mi-op:hover{box-shadow:0 0 0 1.5px rgba(15,26,20,0.2)}
  .mi-op input{position:absolute;left:22px;top:50%;width:1px;height:1px;margin:0;opacity:0;pointer-events:none}
  .mi-kr{grid-column:1;grid-row:1 / 3;display:grid;place-items:center;width:22px;height:22px;border-radius:50%;box-shadow:inset 0 0 0 1.5px rgba(15,26,20,0.28);transition:box-shadow .25s}
  .mi-kr::after{content:"";width:10px;height:10px;border-radius:50%;background:var(--ziel);transform:scale(0);transition:transform .3s cubic-bezier(.3,1.6,.5,1)}
  .mi-op b{grid-column:2;grid-row:1;font-size:clamp(17px,1.45vw,20px);font-weight:700;letter-spacing:-0.022em;line-height:1.2}
  .mi-d{grid-column:2;grid-row:2;font-size:14px;line-height:1.45;color:var(--t2);text-wrap:pretty;transition:color .25s}
  .mi-ik{grid-column:3;grid-row:1 / 3;display:grid;place-items:center;width:42px;height:42px;border-radius:12px;background:var(--papier);color:var(--ziel-c);transition:background .25s,color .25s}
  .mi-ik svg{display:block;width:18px;height:18px;fill:currentColor}
  .mi-op:has(input:checked){background:var(--ink);color:#ffffff;box-shadow:0 18px 36px -24px rgba(7,20,13,0.7)}
  .mi-op:has(input:checked) .mi-d{color:rgba(255,255,255,0.66)}
  .mi-op:has(input:checked) .mi-kr{box-shadow:inset 0 0 0 1.5px var(--ziel)}
  .mi-op:has(input:checked) .mi-kr::after{transform:none}
  .mi-op:has(input:checked) .mi-ik{background:rgba(255,255,255,0.08);color:var(--ziel)}
  .mi-op:has(input:focus-visible){outline:2px solid var(--ziel);outline-offset:3px}
  /* Która wersja widać: dwa pozytywne :has(). Bez wsparcia obie reguły
     odpadają i obie wersje stoją jedna pod drugą. */
  .mi:has(#mi-it:checked) [data-v="bez"],.mi:has(#mi-bez:checked) [data-v="it"]{display:none !important}
  .mi-uk{display:grid;grid-template-columns:minmax(0,2.1fr) minmax(0,1fr);gap:clamp(22px,2.8vw,44px);align-items:start;margin-top:16px}

  /* ---- list: podsumowanie miesiąca od prowadzącego ---- */
  .ml{position:relative;min-width:0;margin:0}
  .ml::before{content:"";position:absolute;inset:14px -10px -14px 10px;border-radius:20px;background:#e6e4dc;transform:rotate(1.3deg)}
  .ml-l{position:relative;padding:clamp(22px,2.8vw,40px);border-radius:20px;background:#ffffff;color:var(--t1);box-shadow:0 0 0 1px rgba(15,26,20,0.05),0 46px 90px -50px rgba(15,26,20,0.5);animation:ml-wej .5s cubic-bezier(.2,.8,.2,1) both}
  @keyframes ml-wej{from{opacity:0;transform:translateY(10px)}}
  .ml-gl{display:flex;align-items:center;flex-wrap:wrap;gap:12px 14px;padding-bottom:18px;border-bottom:1px solid var(--linia)}
  .ml-gl img{flex-shrink:0;width:46px;height:46px;border-radius:50%;object-fit:cover;background:#dfe3e0}
  .ml-gl div{min-width:0}
  .ml-gl b{display:block;font-size:clamp(17px,1.5vw,20px);font-weight:700;letter-spacing:-0.02em}
  .ml-gl span{display:block;margin-top:2px;font-size:13.5px;color:var(--t3)}
  .ml-gl em{margin-left:auto;font-style:normal;font-size:12.5px;font-weight:600;color:var(--t3)}
  .ml-lb{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(14px,2vw,28px);margin-top:24px}
  .ml-lb div{padding-top:12px;border-top:2px solid var(--t1)}
  .ml-lb b{display:block;font-size:clamp(34px,3.6vw,52px);font-weight:750;letter-spacing:-0.05em;line-height:1}
  .ml-lb .z b{color:var(--ziel-c)}
  .ml-lb .z{border-top-color:var(--ziel)}
  .ml-lb span{display:block;margin-top:8px;font-size:14px;line-height:1.4;color:var(--t2);text-wrap:pretty}
  .ml-lb small{display:block;margin-top:3px;font-size:12.5px;color:var(--t3)}
  .ml-tr{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(20px,3vw,44px);margin-top:28px}
  .ml-tr h4,.ml-dol h4{margin:0 0 6px;font-size:13px;font-weight:700;color:var(--t3)}
  .ml-tr ul{margin:0;padding:0;list-style:none}
  .ml-tr li{display:flex;gap:10px;padding:11px 0;border-top:1px solid var(--linia2);font-size:14.5px;line-height:1.45;color:var(--t1)}
  .ml-tr li small{display:block;margin-top:2px;font-size:13px;color:var(--t3)}
  .ml-tr li > em{flex-shrink:0;display:inline-grid;place-items:center;min-width:28px;height:22px;padding:0 6px;border-radius:6px;background:rgba(0,205,119,0.14);font-style:normal;font-size:12.5px;font-weight:750;color:var(--ziel-c)}
  .ml-tr li > i{flex-shrink:0;width:7px;height:7px;margin-top:0.55em;border-radius:50%;background:var(--burs)}
  .ml-tr p.dop{margin:8px 0 0;font-size:13px;color:var(--t3)}
  .ml-dol{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(20px,3vw,44px);margin-top:24px;padding-top:20px;border-top:1px solid var(--linia)}
  .ml-dol p{margin:0;font-size:14.5px;line-height:1.55;color:var(--t1);text-wrap:pretty}
  .ml-nast{padding:16px 18px;border-radius:14px;background:var(--papier)}
  .ml-podp{display:block;margin-top:10px;font-size:13.5px;font-weight:650;color:var(--t2)}
  /* ---- co się różni ---- */
  .sp{min-width:0;margin:0}
  .sp-w{display:grid;align-content:start;gap:5px;padding:15px 0 16px;border-top:1px solid var(--linia)}
  .sp-w:first-child{padding-top:16px;border-top:1.5px solid var(--t1)}
  .sp-w dt{font-size:12.5px;font-weight:700;color:var(--t3)}
  .sp-w dd{margin:0;font-size:15px;line-height:1.55;color:var(--t1);text-wrap:pretty}
  .sp-av{display:flex;flex-wrap:wrap;margin:3px 0 9px}
  .sp-av > span + span{margin-left:-8px}
  .sp-cena dd b{display:block;font-size:clamp(26px,2.3vw,32px);font-weight:700;letter-spacing:-0.035em;line-height:1.1}
  .sp-cena dd small{display:block;margin-top:5px;font-size:13.5px;line-height:1.5;color:var(--t2)}

  /* ---- w obu wersjach ---- */
  .mi-ob{display:grid;grid-template-columns:minmax(0,1.6fr) repeat(4,minmax(0,2fr));gap:16px clamp(18px,2vw,32px);margin-top:clamp(28px,3vw,44px);padding-top:18px;border-top:1.5px solid var(--t1)}
  .mi-ob > span{display:flex;align-items:center;gap:9px;align-self:start;font-size:14px;font-weight:700;color:var(--t1)}
  .mi-ob > span svg{display:block;width:18px;height:18px;padding:3px;border-radius:50%;background:var(--ziel);fill:var(--ink)}
  .mi-ob ul{display:contents;margin:0;padding:0;list-style:none}
  .mi-ob li{min-width:0}
  .mi-ob b{display:block;font-size:15px;font-weight:700;letter-spacing:-0.012em;line-height:1.3}
  .mi-ob p{margin:4px 0 0;font-size:14px;line-height:1.55;color:var(--t2);text-wrap:pretty}

  @media (max-width:1180px){
    .mi-uk{grid-template-columns:minmax(0,1fr)}
    .sp{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:clamp(24px,4vw,48px)}
    .sp-w:nth-child(2){padding-top:16px;border-top:1.5px solid var(--t1)}
    .sp-cena{grid-column:1 / -1}
    .mi-ob{grid-template-columns:repeat(2,minmax(0,1fr))}
    .mi-ob > span{grid-column:1 / -1}
  }
  @media (max-width:700px){
    .mi-wyb{grid-template-columns:minmax(0,1fr)}
    .mi-op{grid-template-columns:22px minmax(0,1fr) 38px;gap:2px 12px;padding:15px 14px 15px 16px}
    .mi-ik{width:38px;height:38px}
    .sp{display:block}
    .sp-w:nth-child(2){padding-top:15px;border-top:1px solid var(--linia)}
    .mi-uk{gap:28px}
    .sp{order:-1}
    .mi-ob{grid-template-columns:minmax(0,1fr)}
  }
  /* na telefonie obrócone kartki pod spodem wychodziłyby poza ekran */
  @media (max-width:700px){
    .ml::before{inset:8px -6px -8px 6px;transform:none}
    .ml-tr,.ml-dol{grid-template-columns:minmax(0,1fr)}
    .ml-lb{gap:12px}
    .ml-lb b{font-size:32px}
    .ml-lb span{font-size:13px}
    .ml-gl{display:grid;grid-template-columns:46px minmax(0,1fr);gap:4px 14px}
    .ml-gl em{grid-column:2;margin-left:0}
  }

  /* =====================================================================
     DLACZEGO 1 · panel klienta i skan przeglądu (.sk-)
     ===================================================================== */
  .sk-uk{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:clamp(22px,3.4vw,52px);align-items:center;margin:0 clamp(2px,0.8vw,14px)}
  .sk-pan{position:relative;overflow:hidden;border-radius:16px;background:#ffffff;box-shadow:0 0 0 1px rgba(15,26,20,0.07),0 34px 64px -38px rgba(15,26,20,0.45)}
  .sk-top{display:flex;align-items:center;gap:18px;padding:12px 18px;border-bottom:1px solid var(--linia2);font-size:13px;color:var(--t3)}
  .sk-top > b{display:flex;align-items:center;gap:9px;font-size:13.5px;font-weight:700;color:var(--t1)}
  .sk-top > b i{display:block;width:20px;height:20px;border-radius:6px;background:var(--ziel)}
  .sk-top nav{display:flex;gap:16px}
  .sk-top nav span.on{font-weight:650;color:var(--t1);box-shadow:0 2px 0 var(--t1)}
  .sk-top img{margin-left:auto;width:24px;height:24px;border-radius:50%}
  .sk-tr{padding:18px 20px 20px}
  .sk-tr h5{margin:0;font-size:18px;font-weight:700;letter-spacing:-0.02em}
  .sk-tr > p{margin:3px 0 0;font-size:13px;color:var(--t3)}
  .sk-tab{margin-top:14px}
  .sk-r{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,0.9fr) auto auto;gap:14px;align-items:center;padding:11px 0;border-top:1px solid var(--linia2);font-size:14px;color:var(--t1)}
  .sk-r > span:first-child{font-weight:600}
  .sk-r .kl{color:var(--t2)}
  .sk-cel{position:relative;display:inline-flex;align-items:center;gap:6px;justify-self:start;border-radius:8px;transition:box-shadow .3s ease}
  .kl > .sk-cel{margin-left:-7px;padding:3px 7px}
  .sk-zal{padding:4px 9px;background:var(--papier);font-size:12.5px;font-weight:600;color:var(--t2)}
  .sk-zal svg{width:12px;height:12px;fill:var(--t3)}
  .sk-ok{display:inline-flex;align-items:center;gap:5px;font-size:12.5px;font-weight:650;color:var(--ziel-c)}
  .sk-ok svg{width:13px;height:13px;padding:2px;border-radius:50%;background:var(--ziel);fill:var(--ink)}
  .sk-st{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px 18px;margin-top:16px;padding-top:14px;border-top:1px solid var(--linia)}
  .sk-btn{padding:9px 16px;background:var(--ink);color:#ffffff;font-size:13.5px;font-weight:650}
  .sk-st > span{display:inline-flex;align-items:center;gap:7px;font-size:13px;color:var(--t2)}
  .sk-st > .sk-btn{color:#ffffff;font-size:13.5px}
  .sk-pin{position:absolute;top:-11px;right:-11px;z-index:2;display:grid;place-items:center;width:24px;height:24px;border-radius:50%;background:var(--c);color:#ffffff;font-size:12.5px;font-weight:800;box-shadow:0 0 0 3px #ffffff,0 6px 14px -4px rgba(0,0,0,0.35);transition:transform .35s cubic-bezier(.3,1.6,.5,1)}
  .sk-cel:has(.sk-pin){box-shadow:0 0 0 2px var(--c)}
  .sk-skan{position:absolute;left:0;right:0;top:0;z-index:3;height:2px;background:var(--ziel);box-shadow:0 0 16px 4px rgba(0,205,119,0.5);opacity:0;pointer-events:none}
  .sk-skan::before{content:"";position:absolute;left:0;right:0;bottom:2px;height:70px;background:linear-gradient(to top,rgba(0,205,119,0.14),rgba(0,205,119,0))}
  .sk-skan.on{opacity:1}
  .sk-ls{margin:0;padding:0;list-style:none}
  .sk-z{display:grid;grid-template-columns:28px minmax(0,1fr);gap:12px;padding:16px 0;border-top:1px solid var(--linia);transition:opacity .35s ease}
  .sk-z:first-child{border-top:1.5px solid var(--t1)}
  .sk-n{display:grid;place-items:center;width:26px;height:26px;border-radius:50%;background:var(--c);color:#ffffff;font-size:12.5px;font-weight:800}
  .sk-z b{display:block;font-size:15.5px;font-weight:700;letter-spacing:-0.01em;line-height:1.3}
  .sk-z p{margin:4px 0 0;font-size:14px;line-height:1.55;color:var(--t2);text-wrap:pretty}
  .sk-z p.sk-po{display:flex;gap:7px;color:var(--t1);font-weight:600;transition:opacity .4s ease}
  .sk-z p.sk-po svg{flex-shrink:0;width:15px;height:15px;margin-top:3px;padding:2px;border-radius:50%;background:var(--ziel);fill:var(--ink)}
  .sk.gra .sk-pin{transform:scale(0)}
  .sk.gra .sk-pin.on{transform:none}
  .sk.gra .sk-cel:has(.sk-pin:not(.on)){box-shadow:none}
  .sk.gra .sk-z{opacity:0.3}
  .sk.gra .sk-z.on{opacity:1}
  .sk.gra .sk-z .sk-po{opacity:0}
  .sk.gra.kon .sk-z .sk-po{opacity:1}
  .sk.gra.kon .sk-z:nth-child(2) .sk-po{transition-delay:.2s}
  .sk.gra.kon .sk-z:nth-child(3) .sk-po{transition-delay:.4s}
  @media (max-width:980px){ .sk-uk{grid-template-columns:minmax(0,1fr)} }
  @media (max-width:560px){
    .sk-top nav{display:none}
    .sk-tr{padding:16px 14px}
    .sk-r{grid-template-columns:minmax(0,1fr) auto;gap:6px 10px}
    .sk-r .kl{grid-column:1;grid-row:2;font-size:13px}
    .sk-r .sk-ok{grid-column:2;grid-row:1}
    .sk-r .sk-cel{grid-column:2;grid-row:2;justify-self:end}
  }

  /* =====================================================================
     DLACZEGO 2 · pół roku w sześciu słupkach (.pr-)
     Wysokość słupka = nowe wersje w miesiącu, kreskowana część = wróciły
     z uwagą. Procenty liczone w nagłówku pliku (bez dzielenia w calc()).
     ===================================================================== */
  .pr-uk{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:clamp(10px,1.8vw,28px);margin:0 clamp(2px,0.8vw,14px)}
  .pr-k{display:flex;flex-direction:column;min-width:0}
  .pr-sl{display:flex;flex-direction:column;justify-content:flex-end;height:clamp(190px,21vw,300px)}
  .pr-w{margin-bottom:8px;font-size:13px;color:var(--t2)}
  .pr-w b{font-size:clamp(17px,1.5vw,21px);font-weight:750;letter-spacing:-0.03em;color:var(--t1)}
  .pr-bar{display:flex;flex-direction:column;width:76%;height:var(--h);border-radius:12px 12px 5px 5px;overflow:hidden;transform-origin:50% 100%}
  .pr-ok{flex:1;background:var(--ziel)}
  .pr-uw{height:var(--u)}
  .pr-m{margin-top:14px;padding-top:12px;border-top:1.5px solid var(--t1)}
  .pr-m b{display:block;font-size:14.5px;font-weight:700}
  .pr-p{display:block;margin-top:3px;font-size:13.5px;font-weight:650;color:var(--burs-c)}
  .pr-k.ost .pr-p{font-size:clamp(17px,1.5vw,21px);letter-spacing:-0.02em}
  .pr-zs{display:block;margin-top:10px;font-size:12.5px;font-weight:700;color:var(--ziel-c)}
  .pr-zt{display:block;margin-top:3px;font-size:13px;line-height:1.45;color:var(--t2);text-wrap:pretty}
  .pr-leg{display:none;margin:16px 4px 0;font-size:12.5px;line-height:1.5;color:var(--t3)}
  .pr.gra .pr-bar{transform:scaleY(0)}
  .pr.gra.on .pr-bar{transform:none;transition:transform .8s cubic-bezier(.3,.8,.3,1);transition-delay:calc(0.2s + var(--r) * 0.14s)}
  @media (max-width:700px){
    .pr-uk{gap:8px}
    .pr-zt,.pr-zs,.pr-dl{display:none}
    .pr-leg{display:block}
    .pr-w{font-size:11.5px}
    .pr-w b{font-size:15px}
    .pr-m b{font-size:12.5px}
    .pr-p,.pr-k.ost .pr-p{font-size:12.5px}
  }

  /* =====================================================================
     NA START (#start) · raport z audytu jako kartka (.ra-)
     ===================================================================== */
  .st-uk{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:clamp(28px,4vw,72px);align-items:center;margin-top:clamp(40px,4.4vw,64px)}
  .st-t{padding-top:20px;border-top:1.5px solid var(--t1)}
  .st-t h3{margin:0;font-size:clamp(22px,2vw,28px);font-weight:700;letter-spacing:-0.03em;line-height:1.15}
  .st-t > p{margin:12px 0 0;max-width:520px;font-size:16px;line-height:1.62;color:var(--t2);text-wrap:pretty}
  .st-meta{display:flex;flex-wrap:wrap;gap:6px;margin-top:16px}
  .st-meta i{padding:5px 11px;border-radius:999px;background:var(--papier);font-style:normal;font-size:12.5px;font-weight:650;color:var(--t1)}
  .st-a{display:inline-flex;align-items:center;gap:10px;margin-top:24px;padding-bottom:4px;border-bottom:2px solid var(--ziel);font-size:16px;font-weight:700;color:var(--t1);transition:gap .2s}
  .st-a:hover{gap:14px}
  .st-a svg{display:block;width:16px;height:16px;fill:currentColor}
  .st-zero{margin-top:32px;padding-top:18px;border-top:1px solid var(--linia)}
  .st-zero b{display:block;font-size:15.5px;font-weight:700;letter-spacing:-0.01em}
  .st-zero p{margin:4px 0 0;max-width:520px;font-size:15px;line-height:1.6;color:var(--t2);text-wrap:pretty}
  .st-meta{display:block;margin-top:14px;font-size:14px;font-weight:600;color:var(--t2)}
  .ra{position:relative;margin:0}
  .ra::before{content:"";position:absolute;inset:16px -12px -14px 12px;border-radius:8px;background:#e6e4dc;transform:rotate(1.6deg)}
  .ra-k{position:relative;padding:clamp(24px,3vw,40px) clamp(22px,3vw,40px) clamp(22px,2.8vw,34px) clamp(36px,4.4vw,64px);border-radius:8px;background:#ffffff;box-shadow:0 0 0 1px rgba(15,26,20,0.05),0 46px 90px -50px rgba(15,26,20,0.5);transform:rotate(-0.5deg)}
  .ra-gl{padding-bottom:16px;border-bottom:1.5px solid var(--t1)}
  .ra-gl small{display:block;font-size:12.5px;font-weight:600;color:var(--t3)}
  .ra-gl h4{margin:4px 0 0;font-size:clamp(18px,1.7vw,22px);font-weight:700;letter-spacing:-0.02em;line-height:1.25}
  .ra-gl p{margin:6px 0 0;font-size:13.5px;color:var(--t2)}
  .ra-m1{position:relative;margin-top:16px}
  .ra-m1::before{content:"";position:absolute;left:calc(clamp(18px,2.6vw,40px) * -1);top:2px;bottom:6px;width:5px;border-radius:3px;background:var(--ziel)}
  .ra-et{margin:0 0 6px;font-size:12.5px;font-weight:700;color:var(--ziel-c)}
  .ra-g{margin-top:14px}
  .ra-m1 .ra-g:first-of-type{margin-top:4px}
  .ra-g h5{display:flex;align-items:center;gap:8px;margin:0 0 2px;font-size:13px;font-weight:700;color:var(--t2)}
  .ra-g h5 i{width:8px;height:8px;border-radius:50%}
  .ra-g.r h5 i{background:#c0492f}
  .ra-g.a h5 i{background:var(--burs)}
  .ra-g.n h5 i{background:rgba(15,26,20,0.25)}
  .ra-w{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:4px 16px;align-items:baseline;padding:10px 0;border-top:1px solid var(--linia2)}
  .ra-w b{font-size:15px;font-weight:600;line-height:1.35}
  .ra-w span{font-size:13px;color:var(--t3);white-space:nowrap}
  .ra-n .ra-w b{color:var(--t2);font-weight:500}
  @media (max-width:1000px){ .st-uk{grid-template-columns:minmax(0,1fr)} }
  @media (max-width:700px){
    .ra::before{inset:10px -6px -10px 6px;transform:none}
    .ra-k{transform:none}
  }
  @media (max-width:560px){
    .ra-w{grid-template-columns:minmax(0,1fr)}
    .ra-w span{white-space:normal}
  }

  @media (prefers-reduced-motion:reduce){
    .mi-op,.mi-kr,.mi-kr::after,.mi-ik,.mi-d{transition:none}
    .ml-l,.rh-pisze i{animation:none}
  }
</style>

<div class="v3">
<Styl />
<Anim />

<!-- ============ 1 · HERO ============
     Wariant „obok": tekst po lewej, po prawej człowiek, który czyta zmiany,
     i jedna wymiana z nim (opis w nagłówku pliku). -->
<Hero wariant="obok" lead={"Miesięczny abonament dla firm, które budują własne aplikacje z AI, z działem IT albo bez niego. Po każdej większej uwadze w Waszym repozytorium dochodzi nowa zasada, więc z miesiąca na miesiąc mniej zmian wraca do poprawki."} link={{ href: '#miesiac', t: 'Zobaczcie, jak wygląda miesiąc →' }}>
<Fragment slot="h1">Przegląd każdej zmiany <span>i&nbsp;pomoc tego samego dnia, kiedy utkniecie</span></Fragment>

<figure class="rh hero-wid" data-rh role="img" aria-label={RH_ARIA}>
<div class="rh-sc" aria-hidden="true">
<figure class="rh-foto">
<img src={PROW.foto} alt="" width="1200" height="2526" decoding="async">
<figcaption><b>{PROW.imie}</b><span>prowadzący po naszej stronie</span></figcaption>
</figure>
<div class="rh-rozm">
<div class="rh-k kl">
<p class="rh-kto"><img src={RH.kl.foto} alt="" width="96" height="96"><span><b>{RH.kl.kto}</b> · {RH.kl.dz}</span><time>{RH.kl.t}</time></p>
<p class="rh-tx">{RH.kl.tx}</p>
</div>
<p class="rh-czas">{RH.czas}</p>
<div class="rh-k my">
<p class="rh-kto"><img src={PROW.mini} alt="" width="278" height="280"><span><b>{PROW.krotko}</b> · Let’s automate</span><time>{RH.my.t}</time></p>
<span class="rh-pisze"><i></i><i></i><i></i></span>
<p class="rh-tx">{RH.my.tx}</p>
<div class="rh-zal"><svg viewBox="0 0 16 16" set:html={IK['paper-clip']}></svg>{RH.my.zal}</div>
</div>
<div class="rh-z">
<small>Zasada {ZASAD_RAZEM} · dopisana do Waszego repozytorium</small>
<b>{MIESIACE[5].z}</b>
<span>Od teraz AI pilnuje jej przy każdej zmianie.</span>
</div>
</div>
</div>
</figure>
</Hero>

<!-- ============ 2 · CZYM JEST + WYBÓR ZESPOŁU ============
     Przełącznik zmienia list z podsumowaniem miesiąca i to, co się różni;
     „W obu wersjach" stoi pod nimi i się nie zmienia. -->
<section id="czym-jest" class="v3-sek v3-papier">
<div class="v3-def">
<h2 class="v3-h2m">Czym jest bieżące wsparcie w&nbsp;guided codingu?</h2>
<div>
<p class="v3-def-duzy rv">Bieżące wsparcie w&nbsp;guided codingu to miesięczny abonament dla firmy, której ludzie budują oprogramowanie z&nbsp;AI: zasady wytwarzania zapisujemy w&nbsp;jej repozytorium i&nbsp;według nich przeglądamy zmiany. Klawiatura i&nbsp;decyzja, co trafia do ludzi, zostają u&nbsp;Was.</p>
</div>
</div>

<div id="miesiac" class="mi" data-mi>
<div class="ix-gl">
<h3>Jak wygląda miesiąc u&nbsp;Was</h3>
<p>Na koniec każdego miesiąca prowadzący pisze do Was podsumowanie i&nbsp;siadacie nad nim na godzinę. Zasady w&nbsp;repozytorium i&nbsp;pomoc, gdy coś się zatnie, są w&nbsp;obu wersjach.</p>
</div>

<fieldset class="mi-wyb">
<legend class="mi-sr">Wasz zespół</legend>
{OPCJE.map((o, i) => (
  <label class="mi-op"><input type="radio" name="mi-zespol" id={`mi-${o.v}`} value={o.v} checked={i === 0} data-mi-r><span class="mi-kr" aria-hidden="true"></span><b>{o.t}</b><span class="mi-d">{o.d}</span><span class="mi-ik" aria-hidden="true"><svg viewBox="0 0 16 16" set:html={IK[o.ik]}></svg></span></label>
))}
</fieldset>

<div class="mi-uk">
<figure class="ml">
{LISTY.map((l) => (
  <article class="ml-l" data-v={l.v}>
    <header class="ml-gl"><img src={l.mini} alt="" width="46" height="46" loading="lazy"><div><b>{l.tytul}</b><span>{l.od} {l.do}</span></div><em>{l.kiedy}</em></header>
    <div class="ml-lb">{l.liczby.map((x) => (<div class={x.z ? 'z' : ''}><b>{x.b}</b><span>{x.t}</span>{x.s && <small>{x.s}</small>}</div>))}</div>
    <div class="ml-tr">
      <div><h4>{l.l1.t}</h4><ul>{l.l1.p.map((x) => (<li><i></i><span>{x.t}<small>{x.s}</small></span></li>))}</ul><p class="dop">{l.l1.dop}</p></div>
      <div><h4>{l.l2.t}</h4><ul>{l.l2.z.map((z, i) => (<li>{l.l2.bezNr ? <i style="background:var(--ziel)"></i> : <em>{ZASAD_RAZEM - l.l2.z.length + i + 1}</em>}<span>{z}</span></li>))}</ul></div>
    </div>
    <div class="ml-dol">
      <div><h4>{l.spot.t}</h4><p>{l.spot.p}</p></div>
      <div class="ml-nast"><h4>{l.nast.t}</h4><p>{l.nast.p}</p><span class="ml-podp">{l.od}</span></div>
    </div>
  </article>
))}
</figure>

<dl class="sp">
{ROZNI.map((r) => (
  <div class={r.cena ? 'sp-w sp-cena' : 'sp-w'}>
    <dt>{r.k}</dt>
    {['bez', 'it'].map((v) => (
      <dd data-v={v}>
        {r.sklad && <span class="sp-av">{SKLAD[v].map((o) => (<TeamAvatar person={o} size={36} ring="#f4f3ee" />))}</span>}
        {r.cena ? (<><b>{r[v].b}</b><small>{r[v].d}</small></>) : r[v]}
      </dd>
    ))}
  </div>
))}
</dl>
