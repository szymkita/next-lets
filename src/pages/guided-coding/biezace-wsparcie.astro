<script>
  var redukcja = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var maIO = 'IntersectionObserver' in window;

  // ---- HERO: wiadomość, odpowiedź, zasada (pętla) ----
  // Bez JS i przy ograniczonym ruchu widać całą wymianę (stan końcowy).
  (function(){
    var f = document.querySelector('[data-rh]') as HTMLElement | null;
    if(!f || redukcja || !maIO) return;
    var ETAPY: [string, number][] = [['s1', 300], ['s2', 1500], ['s3', 2900], ['s4', 4300]];
    var KONIEC = 10500, timery: number[] = [], widac = false;
    var st = ['s1', 's2', 's3', 's4'];
    f.classList.add('gra');
    function czysc(){ timery.forEach(function(t){ clearTimeout(t); }); timery = []; }
    function graj(){
      czysc();
      st.forEach(function(s){ f!.classList.remove(s); });
      ETAPY.forEach(function(e){ timery.push(window.setTimeout(function(){ f!.classList.add(e[0]); }, e[1])); });
      timery.push(window.setTimeout(function(){
        st.forEach(function(s){ f!.classList.remove(s); });
        timery.push(window.setTimeout(function(){ if(widac) graj(); }, 800));
      }, KONIEC));
    }
    new IntersectionObserver(function(w){
      var teraz = w[0].isIntersecting;
      if(teraz && !widac){ widac = true; graj(); }
      else if(!teraz && widac){ widac = false; czysc(); }
    }, { threshold: 0.25 }).observe(f);
  })();

  // ---- DLACZEGO 1: skan przechodzi przez panel z góry na dół ----
  // Pinezka i znalezisko zapalają się w chwili, gdy skan mija ich miejsce;
  // na koniec pod każdym znaleziskiem pojawia się poprawka. Raz po wejściu
  // w kadr, potem z przycisku „jeszcze raz".
  (function(){
    var f = document.querySelector('[data-sk]') as HTMLElement | null;
    if(!f || redukcja || !maIO) return;
    var pan = f.querySelector('[data-sk-pan]') as HTMLElement;
    var skan = f.querySelector('[data-sk-skan]') as HTMLElement;
    var piny = Array.prototype.slice.call(f.querySelectorAll('[data-sk-pin]')) as HTMLElement[];
    var ls = Array.prototype.slice.call(f.querySelectorAll('[data-sk-z]')) as HTMLElement[];
    var znow = f.querySelector('[data-sk-znow]') as HTMLButtonElement;
    var T = 3400, timery: number[] = [];
    f.classList.add('gra');
    function graj(){
      timery.forEach(function(t){ clearTimeout(t); }); timery = [];
      f!.classList.remove('kon');
      piny.forEach(function(p){ p.classList.remove('on'); });
      ls.forEach(function(l){ l.classList.remove('on'); });
      var H = pan.offsetHeight, gora = pan.getBoundingClientRect().top;
      skan.style.transition = 'none';
      skan.style.transform = 'translateY(0)';
      void skan.offsetHeight;
      skan.classList.add('on');
      skan.style.transition = 'transform ' + T + 'ms linear, opacity .3s ease';
      skan.style.transform = 'translateY(' + H + 'px)';
      znow.disabled = true;
      piny.forEach(function(p, i){
        var y = p.getBoundingClientRect().top - gora + 12;
        timery.push(window.setTimeout(function(){ p.classList.add('on'); if(ls[i]) ls[i].classList.add('on'); }, Math.max(0, y / H * T)));
      });
      timery.push(window.setTimeout(function(){ skan.classList.remove('on'); f!.classList.add('kon'); znow.disabled = false; }, T + 150));
    }
    znow.addEventListener('click', graj);
    var io = new IntersectionObserver(function(w){ if(w[0].isIntersecting){ io.disconnect(); graj(); } }, { threshold: 0.4 });
    io.observe(f);
  })();
</script>
</LaBase>
