  .pz-sw i:nth-child(2){background:#febc2e}
  .pz-sw i:nth-child(3){background:#28c840}
  .pz-znak{display:grid;place-items:center;flex-shrink:0;width:26px;height:26px;border-radius:7px;background:#0f1a14;box-shadow:inset 0 1px 0 rgba(255,255,255,0.12)}
  .pz-znak svg{width:14px;height:14px;fill:#00cd77}
  .pz-bc{display:flex;align-items:center;gap:6px;min-width:0;font-size:13px;color:var(--t3)}
  .pz-bc .hi{width:14px;height:14px;color:var(--t4)}
  .pz-bc b{font-weight:600;color:var(--t1)}
  .pz-kto{display:flex;align-items:center;gap:8px;margin-left:auto;font-size:12.5px;color:var(--t3)}
  .pz-kto b{font-weight:550;color:var(--t1)}
  .pz-av{display:block;flex-shrink:0;width:24px;height:24px;border-radius:50%;object-fit:cover}
  .pz-st{display:inline-flex;align-items:center;gap:7px;height:28px;padding:0 11px 0 9px;border-radius:999px;font-size:12px;font-weight:600;transition:background .3s,color .3s,box-shadow .3s}
  .pz-st i{display:block;width:7px;height:7px;border-radius:50%;background:currentColor}
  .pz-st[data-st="nowa"]{background:rgba(9,9,11,0.05);color:var(--t2)}
  .pz-st[data-st="spr"]{background:rgba(16,185,129,0.1);color:#047857}
  .pz-st[data-st="spr"] i{animation:pz-puls 1s ease-in-out infinite}
  .pz-st[data-st="uw"]{background:rgba(245,158,11,0.12);color:#a15c07;box-shadow:inset 0 0 0 1px rgba(245,158,11,0.32)}
  @keyframes pz-puls{50%{opacity:0.25}}
  .pz-uk{display:grid;grid-template-columns:minmax(0,0.9fr) minmax(0,1.05fr) minmax(0,1.55fr)}
  .pz-k{min-width:0;padding:18px 20px 20px}
  .pz-k + .pz-k{border-left:1px solid var(--lin)}
  .pz-k h5{display:flex;align-items:center;gap:7px;margin:0 0 12px;font-size:11.5px;font-weight:600;color:var(--t3)}
  .pz-k h5 .hi{width:14px;height:14px;color:var(--t4)}
  /* kolumna A: zmiana */
  .pz-opis{margin:0;font-size:13px;line-height:1.5;color:var(--t2)}
  .pz-opis b{display:block;margin-bottom:3px;font-size:14px;font-weight:600;letter-spacing:-0.01em;color:var(--t1)}
  .pz-pol{margin-top:14px;padding:10px 12px;border-radius:10px;background:#f6f6f4;box-shadow:inset 0 0 0 1px var(--lin2)}
  .pz-pol span{display:flex;align-items:center;gap:6px;font-size:11px;font-weight:550;color:var(--t3)}
  .pz-pol span .hi{width:13px;height:13px}
  .pz-pol q{display:block;margin-top:5px;font-size:12.5px;line-height:1.45;color:var(--t1);quotes:"„" "”"}
  .pz-pl{margin:14px 0 0;padding:0;list-style:none}
  .pz-pl li{display:grid;grid-template-columns:minmax(0,1fr) auto 50px;gap:8px;align-items:center;height:30px;border-top:1px solid var(--lin2);font-family:var(--mono);font-size:11.5px;color:var(--t2)}
  .pz-pl em{font-style:normal;color:#047857}
  .pz-pl em s{text-decoration:none;color:#b42318;margin-left:4px}
  .pz-pl i{display:flex;gap:2px}
  .pz-pl i b{display:block;width:8px;height:8px;border-radius:2px;background:#10b981}
  .pz-pl i b.m{background:#e5484d}
  .pz-pl i b.n{background:#e4e4e7}
  /* kolumna B: sprawdzenie */
  .pz-zas{margin:0;padding:0;list-style:none}
  .pz-zas li{display:grid;grid-template-columns:18px minmax(0,1fr);gap:9px;align-items:start;padding:6px 0;font-size:12.5px;line-height:1.4;color:var(--t2)}
  .pz-zas li + li{border-top:1px solid var(--lin2)}
  .pz-i{display:grid;place-items:center;width:18px;height:18px;margin-top:-1px;border-radius:50%;background:#10b981;transition:background .25s,box-shadow .25s}
  .pz-i svg{width:12px;height:12px;fill:#ffffff;transition:opacity .2s,transform .3s cubic-bezier(.3,1.6,.5,1)}
  .pz-zas li.pz-reszta{color:var(--t3)}
  .pz-zn{display:grid;grid-template-columns:22px minmax(0,1fr);gap:9px;margin-top:12px;padding:11px 12px;border-radius:10px;background:rgba(245,158,11,0.09);box-shadow:inset 0 0 0 1px rgba(245,158,11,0.32);transition:opacity .4s ease,transform .5s cubic-bezier(.2,.8,.2,1)}
  .pz-zn-i{display:grid;place-items:center;width:22px;height:22px;border-radius:6px;background:#f59e0b;color:#ffffff}
  .pz-zn-i svg{width:13px;height:13px;fill:currentColor}
  .pz-zn b{display:block;font-size:12.5px;font-weight:600;color:#7c4a06}
  .pz-zn span{display:block;margin-top:2px;font-size:12px;line-height:1.4;color:#8a5a12}
  .pz-zn code{font-family:var(--mono);font-size:11px}
  /* kolumna C: uwaga */
  .pz-rev{display:flex;align-items:center;gap:10px;margin-bottom:12px}
  .pz-rev img{width:30px;height:30px;border-radius:50%;object-fit:cover;filter:grayscale(1);outline:1px solid rgba(0,0,0,0.06);outline-offset:-1px}
  .pz-rev b{display:block;font-size:13px;font-weight:600}
  .pz-rev em{display:block;font-style:normal;font-size:11.5px;color:var(--t3)}
  .pz-pisze{display:flex;gap:3px;margin-left:auto;padding:7px 9px;border-radius:999px;background:#f4f4f2;opacity:0;transition:opacity .25s}
  .pz-pisze i{width:5px;height:5px;border-radius:50%;background:var(--t4);animation:pz-kropka 1.1s ease-in-out infinite}
  .pz-pisze i:nth-child(2){animation-delay:.15s}
  .pz-pisze i:nth-child(3){animation-delay:.3s}
  .pz-pisze.on{opacity:1}
  @keyframes pz-kropka{0%,60%,100%{transform:none;opacity:0.5}30%{transform:translateY(-3px);opacity:1}}
  .pz-cz{margin:0}
  .pz-cz > div{display:grid;grid-template-columns:118px minmax(0,1fr);gap:12px;padding:8px 0;border-top:1px solid var(--lin2);transition:opacity .45s ease,transform .5s cubic-bezier(.2,.8,.2,1)}
  .pz-cz dt{font-size:12px;font-weight:600;color:var(--t1)}
  .pz-cz dd{margin:0;font-size:12.5px;line-height:1.5;color:var(--t2);text-wrap:pretty}
  .pz-cmd{margin-top:10px;padding:10px 12px;border-radius:10px;background:#0f1a14;color:#e7efe9;transition:opacity .45s ease,transform .5s cubic-bezier(.2,.8,.2,1)}
  .pz-cmd span{display:flex;align-items:center;gap:6px;font-size:11px;font-weight:550;color:rgba(255,255,255,0.55)}
  .pz-cmd span .hi{width:13px;height:13px;color:#00cd77}
  .pz-cmd code{display:block;margin-top:5px;font-family:var(--mono);font-size:11.5px;line-height:1.55;color:#e7efe9;white-space:normal}
  /* dół: nowa zasada i licznik miesiąca */
  .pz-dol{display:flex;align-items:center;justify-content:space-between;gap:12px 24px;min-height:64px;padding:12px 16px;border-top:1px solid var(--lin);background:#fafaf9}
  .pz-zasada{display:flex;align-items:center;gap:11px;min-width:0;padding:7px 14px 7px 7px;border-radius:12px;background:#ecfbf3;box-shadow:inset 0 0 0 1px rgba(16,185,129,0.3);transition:opacity .45s ease,transform .6s cubic-bezier(.2,.8,.2,1)}
  .pz-zi{display:grid;place-items:center;flex-shrink:0;width:30px;height:30px;border-radius:8px;background:#00cd77;color:#07140d}
  .pz-zi svg{width:15px;height:15px;fill:currentColor}
  .pz-zasada em{display:block;font-style:normal;font-size:11px;font-weight:550;color:#047857}
  .pz-zasada b{display:block;font-size:13.5px;font-weight:600;letter-spacing:-0.01em}
  .pz-licz{margin:0;font-size:12.5px;color:var(--t3);white-space:nowrap}
  .pz-licz b{font-weight:650;color:var(--t1);font-variant-numeric:tabular-nums}
  /* ruch: stany pośrednie tylko pod .ruch */
  .pz.ruch .pz-zas li:not(.ok) .pz-i{background:#ffffff;box-shadow:inset 0 0 0 1.5px #d4d4d8}
  .pz.ruch .pz-zas li:not(.ok) .pz-i svg{opacity:0;transform:scale(0.4)}
  .pz.ruch .pz-zn:not(.on),.pz.ruch .pz-cz > div:not(.on),.pz.ruch .pz-cmd:not(.on){opacity:0;transform:translateY(6px)}
  .pz.ruch .pz-zasada:not(.on){opacity:0;transform:translateY(10px)}
  .pz.ruch.wyg .pz-uk,.pz.ruch.wyg .pz-dol{opacity:0.35;transition:opacity .4s}
  @container (max-width:1000px){
    .pz-uk{grid-template-columns:minmax(0,1fr) minmax(0,1.35fr)}
    .pz-a{display:none}
    .pz-k + .pz-k{border-left:1px solid var(--lin)}
    .pz-b{border-left:0 !important}
  }
  @container (max-width:360px){ .pz-kto{display:none} }
  @container (max-width:640px){
    .pz-uk{grid-template-columns:minmax(0,1fr)}
    .pz-k + .pz-k{border-left:0 !important;border-top:1px solid var(--lin)}
    .pz-bc span,.pz-bc .hi,.pz-kto span,.pz-sw{display:none}
    .pz-bc b{min-width:0;overflow:hidden;text-overflow:ellipsis}
    .pz-cz > div{grid-template-columns:minmax(0,1fr);gap:2px}
    .pz-dol{flex-direction:column;align-items:flex-start}
    .pz-zas li:nth-child(n+4):not(.pz-reszta){display:none}
  }

  /* =====================================================================
     LUPA · blady kod, trzy miejsca, wiersz zmienia się na poprawiony
     Powiększenie to druga kopia kodu w kole: przesunięta o (R − K·x,
     R − K·y) i przeskalowana K razy, więc punkt (x, y) ląduje w środku.
     Bez ruchu (i bez JS): wiersze poprawione, lista z ptaszkami, bez lupy.
     Poniżej 760 px rysunek jest statyczny.
     ===================================================================== */
  .lu-uk{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,4.6fr);gap:clamp(20px,2.6vw,40px);align-items:start;margin:0 clamp(2px,0.8vw,14px)}
  .lu-ram{position:relative}
  .lu-sc{position:relative;overflow:hidden;border-radius:14px;background:#ffffff;box-shadow:0 0 0 1px rgba(15,26,20,0.07),0 24px 40px -28px rgba(15,26,20,0.45)}
  .lu-pas{display:flex;align-items:center;gap:8px;height:40px;padding:0 16px;border-bottom:1px solid #eef0ec;background:#fafaf8;font-family:var(--mono);font-size:11.5px;color:var(--t3);white-space:nowrap}
  .lu-pas svg{display:block;width:14px;height:14px;fill:currentColor}
  .lu-pas b{font-weight:500;color:var(--t1)}
  .lu-kod{padding:14px 0 18px;font-family:var(--mono);font-size:13.5px;line-height:25px;white-space:pre;counter-reset:l;color:#b4bcb7}
  .lu-l{position:relative;display:block;min-height:25px;padding:0 16px 0 52px;counter-increment:l}
  .lu-l::before{content:counter(l);position:absolute;left:0;width:34px;text-align:right;font-size:11px;color:#d3d8d4}
  .lu-m{position:relative;border-radius:3px;transition:background .3s}
  .lu-m::after{content:"";position:absolute;left:0;right:0;bottom:1px;height:2px;border-radius:1px;background:var(--mc,transparent);transition:background .3s}
  .lu-p{display:none}
  .lu-l.z .lu-o .lu-m{--mc:var(--ziel);background:rgba(0,205,119,0.12)}
  .lu-zoom{position:absolute;left:0;top:0;width:var(--scw,100%);background:#ffffff;transform-origin:0 0}
  .lu-zoom .lu-kod{color:#2b3530}
  .lu-zoom .k{color:#7c3aed}
  .lu-zoom .s{color:#0a7a52}
  .lu-zoom .lu-l::before{color:#a3aca6}
  .lu-lupa{display:none}
  /* lista znalezisk */
  .lu-ls{margin:0;padding:0;list-style:none;counter-reset:z}
  .lu-z{display:grid;grid-template-columns:30px minmax(0,1fr);gap:14px;padding:18px 0 18px 14px;border-top:1px solid var(--linia);border-left:2px solid transparent;transition:opacity .35s,border-color .35s}
  .lu-z:first-child{border-top:1.5px solid var(--t1)}
  .lu-n{display:grid;place-items:center;width:28px;height:28px;border-radius:50%;background:var(--ink);font-size:12px;font-weight:700;color:#ffffff;transition:background .3s}
  .lu-z b{display:block;font-size:16px;font-weight:700;letter-spacing:-0.015em;line-height:1.3}
  .lu-z p{margin:5px 0 0;font-size:14px;line-height:1.55;color:var(--t2);text-wrap:pretty}
  .lu-z .lu-po{display:flex;gap:8px;align-items:flex-start;margin-top:8px;font-weight:600;color:var(--ziel-c);transition:opacity .35s}
  .lu-po svg{flex-shrink:0;width:16px;height:16px;margin-top:2px;padding:2px;border-radius:50%;background:var(--ziel);fill:var(--ink)}
  .lu-z[data-s="ok"] .lu-n{background:var(--ziel);color:var(--ink)}
  /* w ruchu */
  .lu.ruch .lu-l.z:not(.pop) .lu-o{display:none}
  .lu.ruch .lu-l.z:not(.pop) .lu-p{display:inline}
  .lu.ruch .lu-l.z.jest:not(.pop) .lu-m{--mc:var(--zc);background:color-mix(in srgb,var(--zc) 14%,transparent)}
  .lu.ruch .lu-lupa{display:block;position:absolute;left:0;top:0;z-index:3;width:150px;height:150px;pointer-events:none;will-change:transform}
  .lu-kolo{position:absolute;inset:0;overflow:hidden;border-radius:50%;background:#ffffff;box-shadow:0 0 0 5px var(--ink),0 0 0 6.5px rgba(255,255,255,0.6),0 24px 40px -12px rgba(7,20,13,0.45)}
  .lu-kolo::after{content:"";position:absolute;inset:0;border-radius:50%;background:radial-gradient(circle at 32% 26%,rgba(255,255,255,0.55),rgba(255,255,255,0) 42%);pointer-events:none}
  .lu-uchwyt{position:absolute;left:118px;top:116px;width:15px;height:62px;border-radius:8px;background:var(--ink);transform:rotate(-45deg);transform-origin:50% 0;box-shadow:0 10px 20px -8px rgba(7,20,13,0.5)}
  .lu.ruch .lu-z[data-s=""]{opacity:0.42}
  .lu.ruch .lu-z:not([data-s="ok"]) .lu-po{opacity:0}
  .lu.ruch .lu-z[data-s="jest"]{border-left-color:var(--zc)}
  .lu.ruch .lu-z[data-s="jest"] .lu-n{background:var(--zc)}
  @media (max-width:1100px){ .lu-uk{grid-template-columns:minmax(0,1fr)} }
  @media (max-width:760px){
    .lu.ruch .lu-lupa{display:none}
    .lu-kod{font-size:11.5px;line-height:21px;white-space:pre-wrap;overflow-wrap:anywhere}
    .lu-l{padding:0 12px 0 36px;min-height:21px}
    .lu-l::before{width:24px;font-size:10px}
    .lu.ruch .lu-l.z .lu-o{display:inline !important}
    .lu.ruch .lu-l.z .lu-p{display:none !important}
    .lu.ruch .lu-l.z .lu-m{--mc:var(--ziel) !important;background:rgba(0,205,119,0.12) !important}
    .lu.ruch .lu-z{opacity:1 !important;border-left-color:transparent !important}
    .lu.ruch .lu-z .lu-po{opacity:1 !important}
    .lu.ruch .lu-z .lu-n{background:var(--ziel) !important;color:var(--ink)}
  }

  /* =====================================================================
     PÓŁ ROKU · wersja po wersji
     Jeden kwadrat = jedna nowa wersja, kreskowane wróciły z uwagami.
     Wszystkie wiersze w jednej siatce 55 kolumn, więc długość wiersza to
     liczba wersji. Przy miesiącu: ile z uwagami i ile zasad doszło.
     ===================================================================== */
  .ms-tab{margin:0 clamp(2px,0.8vw,14px)}
  .ms-w,.ms-n{display:grid;grid-template-columns:96px minmax(0,1fr) 112px minmax(0,300px);gap:10px 26px;align-items:center}
  .ms-n{padding-bottom:12px;font-size:12px;font-weight:650;color:var(--t3)}
  .ms-n span:nth-child(3){text-align:right}
  .ms-w{padding:13px 0;border-top:1px solid var(--linia)}
  .ms-m{font-size:13.5px;font-weight:650;color:var(--t1);white-space:nowrap}
  .ms-k{display:grid;grid-template-columns:repeat(var(--kol,55),minmax(0,1fr));gap:3px}
  .ms-k i{position:relative;display:block;aspect-ratio:1;border-radius:2px;background:#7fd9ad}
  .ms-k i.u{background:#fff4e3}
  .ms-k i.u::after{content:"";position:absolute;inset:0;border-radius:inherit;background:repeating-linear-gradient(135deg,rgba(214,134,30,0.7) 0 1.5px,rgba(214,134,30,0) 1.5px 4px),rgba(240,163,58,0.22);box-shadow:inset 0 0 0 1px rgba(214,134,30,0.55)}
  .ms-k i.ten{outline:2px solid var(--ink);outline-offset:1.5px;z-index:1}
  .ms-k i.ten em{position:absolute;left:50%;top:calc(100% + 7px);transform:translateX(-50%);padding:2px 7px;border-radius:999px;background:var(--ink);font-style:normal;font-size:10.5px;font-weight:650;color:#ffffff;white-space:nowrap}
  .ms-w.ost{padding-bottom:30px}
  .ms-u{text-align:right;font-size:13px;color:var(--t3);white-space:nowrap}
  .ms-u b{font-size:20px;font-weight:750;letter-spacing:-0.03em;color:var(--burs-c);font-variant-numeric:tabular-nums}
  .ms-u small{display:block;font-size:11.5px;color:var(--t3)}
  .ms-z{display:flex;align-items:center;gap:10px;min-width:0;font-size:13px;line-height:1.35;color:var(--t2)}
  .ms-z > i{display:grid;place-items:center;flex-shrink:0;min-width:34px;height:26px;padding:0 7px;border-radius:8px;background:var(--ink);font-style:normal;font-size:12px;font-weight:700;color:var(--ziel)}
  .ms-z em{font-style:normal;color:var(--t3);white-space:nowrap}
  .ms-suma{display:flex;align-items:center;gap:12px}
  .ms-suma span{font-size:13px;color:var(--t2)}
  .ms-suma b{font-size:clamp(22px,2vw,28px);font-weight:700;letter-spacing:-0.035em;line-height:1;color:var(--t1)}
  /* wejście w kadr: wiersz po wierszu, kwadraty od lewej, potem kreskowanie */
  .ms.gra .ms-k i{transform:scale(0)}
  .ms.gra.on .ms-k i{transform:none;transition:transform .32s cubic-bezier(.3,1.5,.5,1) calc(var(--r) * 0.42s + var(--j) * 11ms)}
  .ms.gra .ms-k i.u::after{opacity:0}
  .ms.gra.on .ms-k i.u::after{opacity:1;transition:opacity .35s ease calc(var(--r) * 0.42s + 0.55s)}
  .ms.gra .ms-k i.u{background:#7fd9ad}
  .ms.gra.on .ms-k i.u{background:#fff4e3;transition:transform .32s cubic-bezier(.3,1.5,.5,1) calc(var(--r) * 0.42s + var(--j) * 11ms),background .3s ease calc(var(--r) * 0.42s + 0.55s)}
  .ms.gra .ms-u,.ms.gra .ms-z,.ms.gra .ms-k i.ten em{opacity:0;translate:0 4px}
  .ms.gra.on .ms-u,.ms.gra.on .ms-z,.ms.gra.on .ms-k i.ten em{opacity:1;translate:0 0;transition:opacity .4s ease calc(var(--r) * 0.42s + 0.7s),translate .5s cubic-bezier(.2,.8,.2,1) calc(var(--r) * 0.42s + 0.7s)}
  @media (max-width:1180px){
    .ms-w,.ms-n{grid-template-columns:90px minmax(0,1fr) 104px}
    .ms-n span:nth-child(4){display:none}
    .ms-z{grid-column:2 / -1}
  }
  /* Węższe: nazwa miesiąca i wynik w jednym wierszu, kwadraty na całą
     szerokość pod spodem (nadal jeden wiersz na miesiąc), na telefonie
     w dwóch rzędach po 28. */
  @media (max-width:900px){
    .ms-n{display:none}
    .ms-w{grid-template-columns:minmax(0,1fr) auto;gap:8px 12px}
    .ms-k{grid-column:1 / -1;grid-row:2}
    .ms-z{grid-column:1 / -1}
    .ms-u{display:flex;align-items:baseline;gap:6px}
    .ms-u small{display:inline}
    .ms-w.ost{padding-bottom:13px}
    .ms-w.ost .ms-z{margin-top:20px}
  }
  @media (max-width:600px){ .ms-k{--kol:28} }

  /* =====================================================================
     WYBÓR ZESPOŁU (#miesiac) · przełącznik, kartka miesiąca, różnice
     Przełącznik to dwa pola radio; :has() chowa wersję, której nie wybrano.
     Przeglądarka bez :has() pokazuje obie wersje jedna pod drugą.
     ===================================================================== */
  .mi{margin-top:clamp(72px,9vw,136px);scroll-margin-top:24px}
  .mi-sr{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
  .mi-wyb{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;min-width:0;margin:24px 0 0;padding:0;border:0}
  .mi-op{position:relative;display:grid;grid-template-columns:22px minmax(0,1fr) 42px;gap:3px 16px;align-items:center;padding:18px 18px 18px 22px;border-radius:20px;background:#ffffff;color:var(--t1);box-shadow:0 0 0 1px var(--linia2);cursor:pointer;transition:background .25s,box-shadow .25s,color .25s}
  .mi-op:hover{box-shadow:0 0 0 1.5px rgba(15,26,20,0.2)}
  .mi-op input{position:absolute;left:22px;top:50%;width:1px;height:1px;margin:0;opacity:0;pointer-events:none}
  .mi-kr{grid-column:1;grid-row:1 / 3;display:grid;place-items:center;width:22px;height:22px;border-radius:50%;box-shadow:inset 0 0 0 1.5px rgba(15,26,20,0.28);transition:box-shadow .25s}
  .mi-kr::after{content:"";width:10px;height:10px;border-radius:50%;background:var(--ziel);transform:scale(0);transition:transform .3s cubic-bezier(.3,1.6,.5,1)}
  .mi-op b{grid-column:2;grid-row:1;font-size:clamp(17px,1.45vw,20px);font-weight:700;letter-spacing:-0.022em;line-height:1.2}
  .mi-d{grid-column:2;grid-row:2;font-size:14px;line-height:1.45;color:var(--t2);text-wrap:pretty;transition:color .25s}
  .mi-ik{grid-column:3;grid-row:1 / 3;display:grid;place-items:center;width:42px;height:42px;border-radius:12px;background:var(--papier);color:var(--ziel-c);transition:background .25s,color .25s}
  .mi-ik svg{display:block;width:18px;height:18px;fill:currentColor}
  .mi-op:has(input:checked){background:var(--ink);color:#ffffff;box-shadow:0 18px 36px -24px rgba(7,20,13,0.7)}
  .mi-op:has(input:checked) .mi-d{color:rgba(255,255,255,0.66)}
  .mi-op:has(input:checked) .mi-kr{box-shadow:inset 0 0 0 1.5px var(--ziel)}
  .mi-op:has(input:checked) .mi-kr::after{transform:none}
  .mi-op:has(input:checked) .mi-ik{background:rgba(255,255,255,0.08);color:var(--ziel)}
  .mi-op:has(input:focus-visible){outline:2px solid var(--ziel);outline-offset:3px}
  /* Która wersja widać: dwa pozytywne :has(). Bez wsparcia obie reguły
     odpadają i obie wersje stoją jedna pod drugą. */
  .mi:has(#mi-it:checked) [data-v="bez"],.mi:has(#mi-bez:checked) [data-v="it"]{display:none !important}
  .mi-uk{display:grid;grid-template-columns:minmax(0,2.1fr) minmax(0,1fr);gap:clamp(22px,2.8vw,44px);align-items:start;margin-top:16px}

  /* ---- kartka miesiąca ---- */
  .mk{--t1:#18181b;--t2:#52525b;--t3:#71717a;--t4:#a1a1aa;--lin:rgba(9,9,11,0.08);--lin2:rgba(9,9,11,0.05);
    min-width:0;margin:0;border-radius:20px;background:#ffffff;color:var(--t1);font-size:12.5px;line-height:1.45;letter-spacing:-0.004em;
    box-shadow:0 0 0 1px rgba(15,26,20,0.06),0 44px 80px -52px rgba(15,26,20,0.55)}
  @supports not selector(:has(*)){ .mk-v + .mk-v{border-top:6px solid var(--papier)} }
  .mk-gl{display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:12px 28px;padding:20px 22px 16px}
  .mk-gl h4{display:flex;align-items:center;gap:9px;margin:0;font-size:17px;font-weight:700;letter-spacing:-0.02em}
  .mk-gl h4 svg{display:block;width:16px;height:16px;fill:var(--t4)}
  .mk-gl h4 + p{margin:3px 0 0;font-size:13px;color:var(--t3)}
  .mk-licz{display:flex;flex-wrap:wrap;gap:6px 22px;margin:0}
  .mk-licz span{display:flex;flex-direction:column;gap:1px;font-size:11.5px;font-weight:550;color:var(--t3)}
  .mk-licz b{font-size:22px;font-weight:700;letter-spacing:-0.03em;line-height:1.1;color:var(--t1);font-variant-numeric:tabular-nums}
  .mk-licz .l-u b,.mk-licz .l-k b{color:#a15c07}
  .mk-licz .l-z b,.mk-licz .l-m b{color:#047857}
  .mc-kal{display:grid;grid-template-columns:52px repeat(5,minmax(0,1fr));gap:6px;padding:12px 14px 14px;border-top:1px solid var(--lin);border-radius:0 0 20px 20px;background:#f6f6f3}
  .mc-h{padding:0 4px 2px;font-size:11.5px;font-weight:600;color:var(--t3)}
  .mc-t{align-self:start;padding:12px 0 0 2px;font-size:11px;font-weight:600;color:var(--t4);white-space:nowrap}
  .mc-d{position:relative;min-width:0;min-height:98px;padding:9px 10px 10px;border-radius:10px;background:#ffffff;box-shadow:0 0 0 1px var(--lin2),0 1px 2px rgba(9,9,11,0.04)}
  .mc-d.pusty{background:rgba(255,255,255,0.5);box-shadow:0 0 0 1px var(--lin2)}
  .mc-d.pusty .mc-dg b{color:var(--t4)}
  .mc-d.ten{box-shadow:0 0 0 2px var(--ziel),0 10px 24px -14px rgba(0,205,119,0.6)}
  .mc-d::after{content:"";position:absolute;inset:0;border-radius:inherit;box-shadow:inset 0 0 0 2px var(--ziel);opacity:0;pointer-events:none}
  .mc-dg{display:flex;align-items:center;justify-content:space-between;gap:8px}
  .mc-dg b{font-size:12px;font-weight:650;color:var(--t1)}
  .mc-dg b span{font-weight:450;color:var(--t4)}
  .mc-ch{display:flex;gap:2px}
  .mc-ch i{display:block;width:8px;height:8px;border-radius:2px;background:#7fd9ad}
  .mc-ch i.u{background:repeating-linear-gradient(135deg,rgba(214,134,30,0.75) 0 1.2px,rgba(214,134,30,0) 1.2px 3px),#fff1dc;box-shadow:inset 0 0 0 1px rgba(214,134,30,0.6)}
  .mc-d ul{margin:7px 0 0;padding:0;list-style:none}
  .mc-d li{display:grid;grid-template-columns:14px minmax(0,1fr);gap:6px;align-items:start;padding:2px 0;font-size:11.5px;line-height:1.35;color:var(--t2)}
  .mc-d li svg{display:block;width:13px;height:13px;margin-top:1px;fill:var(--t4)}
  .mc-d li em{display:block;font-style:normal;font-size:10.5px;font-weight:450}
  .mc-d li.u{color:#7c4a06}
  .mc-d li.u svg{fill:#f59e0b}
  .mc-d li.u em{color:#a3772c}
  .mc-d li.z{color:#047857;font-weight:550}
  .mc-d li.z svg{fill:#10b981}
  .mc-d li.s{color:var(--t1);font-weight:550}
  .mc-d li.s svg{fill:#6b46c1}
  .mc-d li.m{color:#0a5c3e;font-weight:600}
  .mc-d li.m svg{fill:#0a7a52}
  .mc-d li.d{color:var(--t1);font-weight:600}
  .mc-d li.d svg{fill:var(--t1)}
  /* Dzień po dniu: obwódka błyska, chipy wersji i pozycje wchodzą po kolei.
     Pod .gra (JS i ruch dozwolony) stan startowy, pod .on wejście. Kartka
     wybrana przełącznikiem przechodzi z display:none, więc animacje
     zaczynają się od nowa. */
  @keyframes mk-wej{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:none}}
  @keyframes mk-chip{from{opacity:0;transform:scale(0.2)}to{opacity:1;transform:none}}
  @keyframes mk-dzis{0%{opacity:0}20%{opacity:1}100%{opacity:0}}
  .mk.gra .mc-d ul,.mk.gra .mc-ch i{opacity:0}
  .mk.gra.on .mc-d ul{animation:mk-wej .42s cubic-bezier(.2,.8,.2,1) both;animation-delay:calc(var(--i) * 85ms + 120ms)}
  .mk.gra.on .mc-ch i{animation:mk-chip .32s cubic-bezier(.3,1.5,.5,1) both;animation-delay:calc(var(--i) * 85ms + var(--k) * 24ms)}
  .mk.gra.on .mc-d::after{animation:mk-dzis .5s ease-out both;animation-delay:calc(var(--i) * 85ms)}

  /* ---- co się różni ---- */
  .sp{min-width:0;margin:0}
  .sp-w{display:grid;align-content:start;gap:5px;padding:15px 0 16px;border-top:1px solid var(--linia)}
  .sp-w:first-child{padding-top:16px;border-top:1.5px solid var(--t1)}
  .sp-w dt{font-size:12.5px;font-weight:700;color:var(--t3)}
  .sp-w dd{margin:0;font-size:15px;line-height:1.55;color:var(--t1);text-wrap:pretty}
  .sp-av{display:flex;flex-wrap:wrap;margin:3px 0 9px}
  .sp-av > span + span{margin-left:-8px}
  .sp-cena dd b{display:block;font-size:clamp(26px,2.3vw,32px);font-weight:700;letter-spacing:-0.035em;line-height:1.1}
  .sp-cena dd small{display:block;margin-top:5px;font-size:13.5px;line-height:1.5;color:var(--t2)}
  .mi.ruch .sp [data-v]{animation:mk-wej .45s cubic-bezier(.2,.8,.2,1) both}
  .mi.ruch .sp-w:nth-child(2) [data-v]{animation-delay:40ms}
  .mi.ruch .sp-w:nth-child(3) [data-v]{animation-delay:80ms}
  .mi.ruch .sp-w:nth-child(4) [data-v]{animation-delay:120ms}
  .mi.ruch .sp-w:nth-child(5) [data-v]{animation-delay:160ms}

  /* ---- w obu wersjach ---- */
  .mi-ob{display:grid;grid-template-columns:minmax(0,1.6fr) repeat(4,minmax(0,2fr));gap:16px clamp(18px,2vw,32px);margin-top:clamp(28px,3vw,44px);padding-top:18px;border-top:1.5px solid var(--t1)}
  .mi-ob > span{display:flex;align-items:center;gap:9px;align-self:start;font-size:14px;font-weight:700;color:var(--t1)}
  .mi-ob > span svg{display:block;width:18px;height:18px;padding:3px;border-radius:50%;background:var(--ziel);fill:var(--ink)}
  .mi-ob ul{display:contents;margin:0;padding:0;list-style:none}
  .mi-ob li{min-width:0}
  .mi-ob b{display:block;font-size:15px;font-weight:700;letter-spacing:-0.012em;line-height:1.3}
  .mi-ob p{margin:4px 0 0;font-size:14px;line-height:1.55;color:var(--t2);text-wrap:pretty}

  @media (max-width:1180px){
    .mi-uk{grid-template-columns:minmax(0,1fr)}
    .sp{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:clamp(24px,4vw,48px)}
    .sp-w:nth-child(2){padding-top:16px;border-top:1.5px solid var(--t1)}
    .sp-cena{grid-column:1 / -1}
    .mi-ob{grid-template-columns:repeat(2,minmax(0,1fr))}
    .mi-ob > span{grid-column:1 / -1}
  }
  @media (max-width:900px){
    .mc-kal{display:block;padding:10px}
    .mc-h{display:none}
    .mc-t{display:block;padding:14px 2px 6px}
    .mc-t.t1{padding-top:2px}
    .mc-d{display:grid;grid-template-columns:58px minmax(0,1fr);gap:0 10px;min-height:0;margin-bottom:5px;padding:9px 12px}
    .mc-dg{flex-direction:column;align-items:flex-start;justify-content:flex-start;gap:5px}
    .mc-d ul{margin:0}
    .mc-d.pusty{display:none}
    .mk-gl{padding:16px 16px 14px}
  }
  /* Telefon: zostają dni z uwagą, sesją, regułą albo podsumowaniem; dni
     z samymi wersjami i pytaniami liczą się tylko w nagłówku kartki. */
  @media (max-width:700px){
    .mc-d.drobny{display:none}
    .mc-d{grid-template-columns:52px minmax(0,1fr)}
  }
  @media (max-width:700px){
    .mi-wyb{grid-template-columns:minmax(0,1fr)}
    .mi-op{grid-template-columns:22px minmax(0,1fr) 38px;gap:2px 12px;padding:15px 14px 15px 16px}
    .mi-ik{width:38px;height:38px}
    .sp{display:block}
    .sp-w:nth-child(2){padding-top:15px;border-top:1px solid var(--linia)}
    .mi-uk{gap:28px}
    .sp{order:-1}
    .mi-ob{grid-template-columns:minmax(0,1fr)}
  }

  /* =====================================================================
     NA START (#start) · fragment raportu z audytu
     Statyczny: ruch raportu należy do strony audytu. Zielone pole obejmuje
     to, od czego zaczyna się pierwszy miesiąc abonamentu.
     ===================================================================== */
  .st-uk{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:clamp(28px,4vw,72px);align-items:center;margin-top:clamp(40px,4.4vw,64px)}
  .st-t{padding-top:20px;border-top:1.5px solid var(--t1)}
  .st-t h3{margin:0;font-size:clamp(22px,2vw,28px);font-weight:700;letter-spacing:-0.03em;line-height:1.15}
  .st-t > p{margin:12px 0 0;max-width:520px;font-size:16px;line-height:1.62;color:var(--t2);text-wrap:pretty}
  .st-meta{display:flex;flex-wrap:wrap;gap:6px;margin-top:16px}
  .st-meta i{padding:5px 11px;border-radius:999px;background:var(--papier);font-style:normal;font-size:12.5px;font-weight:650;color:var(--t1)}
  .st-a{display:inline-flex;align-items:center;gap:10px;margin-top:24px;padding-bottom:4px;border-bottom:2px solid var(--ziel);font-size:16px;font-weight:700;color:var(--t1);transition:gap .2s}
  .st-a:hover{gap:14px}
  .st-a svg{display:block;width:16px;height:16px;fill:currentColor}
  .st-zero{margin-top:32px;padding-top:18px;border-top:1px solid var(--linia)}
  .st-zero b{display:block;font-size:15.5px;font-weight:700;letter-spacing:-0.01em}
  .st-zero p{margin:4px 0 0;max-width:520px;font-size:15px;line-height:1.6;color:var(--t2);text-wrap:pretty}
  .st-kafel{padding:clamp(12px,2.2vw,32px);border-radius:28px;background:var(--papier)}
  .ar{--t1:#18181b;--t2:#52525b;--t3:#71717a;--t4:#a1a1aa;--lin:rgba(9,9,11,0.08);--lin2:rgba(9,9,11,0.05);
    border-radius:8px;background:#ffffff;color:var(--t1);font-size:12.5px;line-height:1.45;box-shadow:0 0 0 1px rgba(9,9,11,0.06),0 1px 2px rgba(9,9,11,0.06),0 28px 52px -28px rgba(9,9,11,0.35)}
  .ar-gl{display:flex;align-items:center;gap:10px;padding:18px 22px 14px;border-bottom:1px solid var(--lin)}
  .ar-gl i{display:grid;place-items:center;flex-shrink:0;width:28px;height:28px;border-radius:8px;background:#0f1a14}
  .ar-gl i svg{display:block;width:15px;height:15px;fill:#00cd77}
  .ar-gl strong{display:block;font-size:14px;font-weight:650;letter-spacing:-0.01em}
  .ar-gl em{display:block;font-style:normal;font-size:11.5px;color:var(--t3)}
  .ar-sum{display:flex;flex-wrap:wrap;gap:6px 16px;padding:11px 22px;border-bottom:1px solid var(--lin);background:#fafaf9;font-size:12.5px;color:var(--t2)}
  .ar-sum b{font-weight:650;color:var(--t1)}
  .ar-lista{padding:10px 14px 16px}
  .ar-m1{position:relative;margin:4px 0 6px;padding:2px 10px 6px 12px;border-radius:10px;background:rgba(0,205,119,0.07);box-shadow:inset 3px 0 0 var(--ziel)}
  .ar-m1-et{position:absolute;right:10px;top:12px;padding:3px 9px;border-radius:999px;background:var(--ziel);font-style:normal;font-size:11px;font-weight:700;color:var(--ink)}
  .ar-reszta{padding:0 10px 0 12px}
  .ar-gr{display:flex;align-items:center;gap:8px;padding:12px 0 6px;font-size:11.5px;font-weight:650;color:var(--t3)}
  .ar-gr i{display:block;width:8px;height:8px;border-radius:50%}
  .ar-gr.r i{background:#c0492f}
  .ar-gr.a i{background:#f0a33a}
  .ar-gr.n i{background:#c4c9c6}
  .ar-w{position:relative;display:grid;grid-template-columns:minmax(0,1fr) 112px 132px;gap:12px;align-items:center;padding:9px 0 9px 12px;border-top:1px solid var(--lin2)}
  .ar-w::before{content:"";position:absolute;left:0;top:9px;bottom:9px;width:3px;border-radius:2px;background:var(--sc)}
  .ar-w.r{--sc:#c0492f}
  .ar-w.a{--sc:#f0a33a}
  .ar-w.n{--sc:#c4c9c6}
  .ar-w b{font-size:13px;font-weight:600;letter-spacing:-0.01em}
  .ar-czas{font-size:12px;color:var(--t2);white-space:nowrap}
  .ar-kto{justify-self:start;padding:3px 9px;border-radius:999px;background:rgba(16,185,129,0.1);font-size:11.5px;font-weight:550;color:#047857;white-space:nowrap}
  .ar-kto.razem{background:rgba(107,70,193,0.09);color:#5b3a99}
  @media (max-width:1000px){ .st-uk{grid-template-columns:minmax(0,1fr)} }
  @media (max-width:640px){
    .ar-gl,.ar-sum{padding-left:16px;padding-right:16px}
    .ar-lista{padding:8px 8px 12px}
    .ar-w{grid-template-columns:minmax(0,1fr) auto;gap:4px 10px}
    .ar-w b{grid-column:1 / -1}
    .ar-m1-et{position:static;display:inline-block;margin:10px 0 2px}
  }

  @media (prefers-reduced-motion:reduce){
    .pz-st i,.pz-pisze i{animation:none}
    .mi-op,.mi-kr,.mi-kr::after,.mi-ik,.mi-d{transition:none}
  }
</style>

<div class="v3">
<Styl />
<Anim />

<!-- ============ 1 · HERO ============
     Przegląd jednej wersji jako dokument: to, co klient kupuje, w ruchu.
