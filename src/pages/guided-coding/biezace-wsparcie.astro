<GcFaq
  heading="Pytania, które padają przed decyzją"
  ctaLabel="Zadajcie nam swoje →"
  items={faq}
/>

<script>
  var redukcja = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var maIO = 'IntersectionObserver' in window;
  function czekaj(ms){ return new Promise(function(r){ setTimeout(r, ms); }); }
  function obserwuj(el, prog, cb){ var io = new IntersectionObserver(function(w){ cb(w[0].isIntersecting); }, { threshold: prog }); io.observe(el); return io; }

  // ---- Hero: przegląd wersji 50 (pętla) ----
  // Zasady odhaczają się po kolei, jedna rzecz idzie do człowieka,
  // uwaga pisze się w czterech częściach, wersja wraca z uwagą, na dole
  // dopisuje się zasada, a licznik uwag w miesiącu rośnie z 6 do 7.
  // Pętla stoi, kiedy rysunku nie widać.
  (function(){
    var fig = document.querySelector('[data-pz]');
    if(!fig || redukcja || !maIO) return;
    var zas = Array.prototype.slice.call(fig.querySelectorAll('[data-pz-zas]'));
    var cz = Array.prototype.slice.call(fig.querySelectorAll('[data-pz-cz]'));
    var zn = fig.querySelector('[data-pz-zn]'), cmd = fig.querySelector('[data-pz-cmd]'), zasada = fig.querySelector('[data-pz-zasada]');
    var pisze = fig.querySelector('[data-pz-pisze]'), st = fig.querySelector('[data-pz-st]'), stT = fig.querySelector('[data-pz-st-t]'), lu = fig.querySelector('[data-pz-lu]');
    var widoczny = false;
    obserwuj(fig, 0.2, function(v){ widoczny = v; });
    async function krok(ms){ await czekaj(ms); while(!widoczny) await czekaj(300); }
    function stan(s, t){ st.setAttribute('data-st', s); stT.textContent = t; }
    function zeruj(){
      zas.forEach(function(z){ z.classList.remove('ok'); });
      cz.forEach(function(c){ c.classList.remove('on'); });
      [zn, cmd, zasada, pisze].forEach(function(e){ e.classList.remove('on'); });
      stan('nowa', 'Nowa wersja'); lu.textContent = '6';
    }
    zeruj();
    fig.classList.add('ruch');
    (async function(){
      for(;;){
        await krok(1000);
        stan('spr', 'Sprawdzanie');
        for(var i = 0; i < zas.length; i++){ await krok(330); zas[i].classList.add('ok'); }
        await krok(500); zn.classList.add('on');
        await krok(900); pisze.classList.add('on');
        for(var j = 0; j < cz.length; j++){ await krok(j ? 1050 : 700); cz[j].classList.add('on'); }
        await krok(900); cmd.classList.add('on'); pisze.classList.remove('on');
        await krok(900); stan('uw', 'Wróciła z uwagą'); lu.textContent = '7';
        await krok(450); zasada.classList.add('on');
        await krok(6000);
        fig.classList.add('wyg'); await krok(450); zeruj(); fig.classList.remove('wyg');
      }
    })();
  })();

  // ---- Lupa nad kodem (pętla) ----
  // Lupa jedzie do każdego z trzech miejsc, miejsce zapala się na czerwono
  // albo bursztynowo, znalezisko po prawej się podświetla, po chwili wiersz
  // zmienia się na poprawiony i robi się zielony. Pozycje liczone z układu
  // strony, więc działa przy każdej szerokości powyżej 760 px.
  (function(){
    var fig = document.querySelector('[data-lu]');
    if(!fig || redukcja || !maIO) return;
    var sc = fig.querySelector('[data-lu-sc]'), lupa = fig.querySelector('[data-lu-lupa]'), zoom = fig.querySelector('[data-lu-zoom]');
    var lista = Array.prototype.slice.call(fig.querySelectorAll('[data-lu-z]'));
    var R = 75, K = 1.6, widoczny = false;
    function linie(i){ return Array.prototype.slice.call(fig.querySelectorAll('[data-lu-l="' + i + '"]')); }
    function znak(i){ var l = fig.querySelector('[data-lu-baza][data-lu-l="' + i + '"]'); return l.querySelector(l.classList.contains('pop') ? '.lu-o .lu-m' : '.lu-p .lu-m'); }
    function aktywna(){ return widoczny && getComputedStyle(lupa).display !== 'none'; }
    async function krok(ms){ await czekaj(ms); while(!aktywna()) await czekaj(300); }
    function szer(){ zoom.style.setProperty('--scw', sc.clientWidth + 'px'); }
    function ustaw(x, y, ms){
      var t = ms ? 'transform ' + ms + 'ms cubic-bezier(.45,0,.25,1)' : 'none';
      lupa.style.transition = t; zoom.style.transition = t;
      lupa.style.transform = 'translate(' + (x - R) + 'px,' + (y - R) + 'px)';
      zoom.style.transform = 'translate(' + (R - K * x) + 'px,' + (R - K * y) + 'px) scale(' + K + ')';
    }
    function srodek(el){ var a = el.getBoundingClientRect(), b = sc.getBoundingClientRect(); return { x: a.left - b.left + Math.min(a.width / 2, 120), y: a.top - b.top + a.height / 2 }; }
    function spoczynek(){ return { x: sc.clientWidth * 0.62, y: sc.clientHeight * 0.36 }; }
    function zeruj(){
      [0, 1, 2].forEach(function(i){ linie(i).forEach(function(l){ l.classList.remove('jest', 'pop'); }); });
      lista.forEach(function(z){ z.setAttribute('data-s', ''); });
    }
    obserwuj(fig, 0.3, function(v){ widoczny = v; });
    window.addEventListener('resize', szer);
    zeruj(); szer();
    fig.classList.add('ruch');
    var p0 = spoczynek(); ustaw(p0.x, p0.y, 0);
    (async function(){
      for(;;){
        await krok(900);
        for(var i = 0; i < 3; i++){
          szer();
          var p = srodek(znak(i)); ustaw(p.x, p.y, 950);
          await krok(1000);
          linie(i).forEach(function(l){ l.classList.add('jest'); });
          lista[i].setAttribute('data-s', 'jest');
          await krok(1900);
          linie(i).forEach(function(l){ l.classList.add('pop'); });
          lista[i].setAttribute('data-s', 'ok');
          p = srodek(znak(i)); ustaw(p.x, p.y, 400);
          await krok(1200);
        }
        var q = spoczynek(); ustaw(q.x, q.y, 1000);
        await krok(3200);
        zeruj();
      }
    })();
  })();

  // ---- Wybór zespołu: liczniki kartki i wejście wartości ----
  // Przełącznik działa bez JS (radio + :has()). Tu tylko ruch: liczniki
  // w nagłówku kartki liczą od zera razem z dniami, które wypełniają się
  // po kolei (CSS, opóźnienie 85 ms na dzień), przy wejściu w kadr i po
  // każdym przełączeniu. Bez ruchu w markupie stoją wartości końcowe.
  (function(){
    var mi = document.querySelector('[data-mi]');
    if(!mi || redukcja || !maIO) return;
    var mk = mi.querySelector('[data-mk]');
    var radia = Array.prototype.slice.call(mi.querySelectorAll('[data-mi-r]'));
    var timery = [];
    mi.classList.add('ruch');
    function wybrana(){ var r = radia.filter(function(x){ return x.checked; })[0]; return r ? r.value : 'bez'; }
    function zeruj(kartka){ kartka.querySelectorAll('[data-l]').forEach(function(b){ b.textContent = '0'; }); }
    function licz(){
      timery.forEach(clearTimeout); timery = [];
      var kartka = mk.querySelector('.mk-v[data-v="' + wybrana() + '"]');
      if(!kartka) return;
      var liczniki = Array.prototype.slice.call(kartka.querySelectorAll('[data-l]'));
      var suma = {};
      liczniki.forEach(function(b){ suma[b.getAttribute('data-l')] = 0; b.textContent = '0'; });
      kartka.querySelectorAll('.mc-d').forEach(function(d){
        var c = JSON.parse(d.getAttribute('data-c') || '{}');
        var i = +d.getAttribute('data-i') || 0;
        timery.push(setTimeout(function(){
          liczniki.forEach(function(b){ var l = b.getAttribute('data-l'); suma[l] += c[l] || 0; b.textContent = suma[l]; });
        }, 140 + i * 85));
      });
    }
    mk.querySelectorAll('.mk-v').forEach(zeruj);
    if(mk.classList.contains('on')) licz();
    else {
      var mo = new MutationObserver(function(){ if(mk.classList.contains('on')){ mo.disconnect(); licz(); } });
      mo.observe(mk, { attributes: true, attributeFilter: ['class'] });
    }
    radia.forEach(function(r){ r.addEventListener('change', function(){ if(mk.classList.contains('on')) licz(); }); });
  })();
</script>
