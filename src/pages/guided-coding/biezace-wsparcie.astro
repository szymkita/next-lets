  { g: 0, s: 'r', t: 'Klucze i hasła leżą w kodzie', czas: '2 godziny', kto: 'Wy, z instrukcją' },
  { g: 0, s: 'r', t: 'Nikt nie sprawdził powrotu z kopii', czas: 'pół dnia', kto: 'razem przy ekranie' },
  { g: 1, s: 'a', t: 'Eksport nie wytrzyma większego ruchu', czas: 'dzień', kto: 'Wy, z instrukcją' },
  { g: 1, s: 'a', t: 'Dane klientów nie mają terminu usunięcia', czas: 'decyzja i godzina', kto: 'Wy, z instrukcją' },
  { g: 2, s: 'n', t: 'Uruchomić projekt od zera umie jedna osoba', czas: 'dwa popołudnia', kto: 'razem przy ekranie' },
  { g: 2, s: 'n', t: 'Rachunek za usługi rośnie po eksperymentach', czas: 'godzina', kto: 'Wy, z instrukcją' },
];
const GRUPY = [
  { t: 'Najpierw · grozi awarią albo wyciekiem', s: 'r' },
  { t: 'Zaraz potem', s: 'a' },
  { t: 'Może poczekać', s: 'n' },
];

// ---- DLA KOGO ------------------------------------------------------------
// Sytuacje abonamentu: aplikacja rośnie co tydzień. Wejście (nikt jej nie
// oglądał) ma strona audytu, wybór formy — strona kolumny.
const DLA_KOGO = [
  { t: 'Aplikacja rośnie co tydzień, a nowe wersje sprawdza tylko ich autor',
    d: 'Narzędzie z kilku wieczorów stało się codzienną robotą działu i dalej dochodzą do niego funkcje. Przed każdą większą zmianą autor się waha, bo nie ma kogo zapytać.' },
  { t: 'Dział IT ma agentów od kilku miesięcy i oddaje im ułamek roboty',
    d: 'Pierwsze podejście wraca do przeróbki, więc agent dostaje coraz mniejsze kawałki. Licencje zostają na fakturze, tempo zostaje takie jak przed nimi.' },
  { t: 'Pomyłka w nowej wersji kosztuje już pieniądze',
    d: 'Przez aplikację idą faktury i dane osobowe klientów. Przy takiej stawce każda zmiana potrzebuje drugiej pary oczu, zanim trafi do ludzi.' },
];
const NIE_TERAZ = [
  'Budujecie prototyp albo narzędzie dla jednej osoby. Tu wystarczy budować szybko i nie oglądać się za siebie.',
  'Proces, który aplikacja ma obsłużyć, zmienia się co tydzień. Lepiej najpierw go poukładać, potem utrwalać w kodzie.',
  'Po Waszej stronie nie ma nikogo, kto decyduje, jak kroi się i odbiera zadania. Zasady wylądują wtedy w repozytorium i nic się nie zmieni.',
  'Chcecie nauczyć zespół w zamkniętym cyklu, z datą końca. Wtedy lepsze są <a href="/guided-coding/transfer-know-how" style="font-weight:700;color:#0a7a52">warsztaty dla zespołu</a>.',
];

// ---- FAQ (ze starych stron obu wersji, w formie „Wy") ---------------------
const faq = [
  { q: 'Za co płacimy w miesiącu, w którym nic się nie zepsuło?',
    a: 'Za to, że każda zmiana przeszła przez przegląd, i za to, że mieliście gdzie zapytać w środę o czternastej. Jeśli spokojnych miesięcy jest kilka pod rząd, sami proponujemy zejście na mniejszy zakres.' },
  { q: 'Nie mamy nikogo technicznego. Czy zrozumiemy, co do nas wraca?',
    a: 'Wiadomość, po której ktoś czuje się głupszy, jest źle napisaną wiadomością — to jedyne kryterium, po którym oceniamy własną robotę. Każda ma cztery części: co zobaczyliśmy, co proponujemy, ile to zajmie i czego nie ruszamy.' },
  { q: 'Mamy seniorów. Czego mielibyście ich nauczyć?',
    a: 'Tego, jak opisać zadanie, żeby agent zrobił je do końca, i co musi stać w repozytorium, żeby nie tłumaczyć mu kontekstu w każdej sesji. To osobna umiejętność, a seniorzy uczą się jej najszybciej, bo najlepiej widzą, czego zabrakło w opisie.' },
  { q: 'Czy w dziale IT będziecie czytać każdą zmianę i oceniać zespół?',
    a: 'Każdej zmiany nie czytamy. Sprawdzenia, które ustawiamy, siedzą w Waszym CI i należą do zespołu — są po to, żeby dało się oddać agentowi większy kawałek roboty bez czytania wszystkiego. Do nas trafiają zadania, które agentowi nie wyszły. W niczym, co piszemy, nie ma nazwisk.' },
  { q: 'Musicie mieć dostęp do wszystkiego?',
    a: 'Wystarczy podgląd do projektu i do miejsca, gdzie leży kod — w większości narzędzi to zaproszenie na adres e-mail, do cofnięcia jednym kliknięciem. Umowę o poufności podpisujemy przed pierwszym dostępem.' },
  { q: 'Poprawiacie sami czy tylko mówicie, co zrobić?',
    a: 'Mówimy, co i dlaczego zmienić, a przy trudniejszych rzeczach przechodzimy przez to razem przy jednym ekranie. Klawiatura zostaje u Waszych ludzi, więc po trzecim razie robią to bez nas. Budowy produktu nie przejmujemy.' },
  { q: 'Ile naszego czasu to zajmuje?',
    a: 'W zespole bez działu IT około czterech godzin w miesiącu: dwa spotkania po półtorej godziny i godzina podsumowania. W dziale IT około sześciu godzin na osobę, która bierze w tym udział: cotygodniowa sesja i godzina z leadami. Pytania na kanale zadajecie wtedy, kiedy się pojawią.' },
  { q: 'Czy dojdą jakieś koszty poza abonamentem?',
    a: 'Nie po naszej stronie — koszty narzędzi i tokenów, z których korzystamy, są w stawce miesięcznej. Osobno płacicie tylko za to, co i tak jest Wasze: subskrypcje Claude Code albo Codexa i rachunki za usługi, na których stoi aplikacja.' },
  { q: 'Co, jeśli zechcemy przestać?',
    a: 'Miesięczny okres wypowiedzenia. Zostaje u Was wszystko, razem ze spisanymi zasadami — jak „AI nie zmienia pieniędzy bez zgody człowieka”, dopisana po tym, jak agent wystawił korektę do faktury sam. Czyta je AI, w którym budujecie, więc działają dalej. Od dostawców narzędzi nie bierzemy prowizji.' },
];

const dane = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${kanon}#usluga`,
      name: 'Bieżące wsparcie w guided codingu',
      alternateName: ['Abonament guided coding', 'Przegląd zmian w aplikacji budowanej z AI', 'Wsparcie zespołu pracującego z agentami AI'],
      serviceType: 'Abonament wsparcia dla zespołu, który buduje oprogramowanie z AI',
      url: kanon,
      description: 'Miesięczny abonament dla firm, które budują własne aplikacje z AI, z działem IT albo bez niego: zasady wytwarzania zapisane w repozytorium klienta, przegląd zmian według tych zasad, kanał i wspólne sesje, kiedy zespół utknie, oraz godzina podsumowania raz w miesiącu. W zespole bez działu IT każdą nową wersję czyta prowadzący; w dziale IT sprawdzenia w CI należą do zespołu, a co tydzień odbywa się sesja na zadaniu z backlogu. Współpraca zaczyna się zwykle od audytu aplikacji.',
      provider: { '@id': new URL('/#organizacja', Astro.site).href },
      areaServed: { '@type': 'Country', name: 'Polska' },
      audience: { '@type': 'BusinessAudience', name: 'Firmy, które budują własne aplikacje z AI, z działem IT albo bez niego' },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${kanon}#okruszki`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Strona główna', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: 'Guided coding', item: new URL('/guided-coding', Astro.site).href },
        { '@type': 'ListItem', position: 3, name: 'Bieżące wsparcie', item: kanon },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${kanon}#faq`,
      mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
