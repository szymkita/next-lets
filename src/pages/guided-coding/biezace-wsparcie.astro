// Prosty podział na słowa kluczowe i napisy — tylko do kolorów w powiększeniu.
const tokeny = (s) => {
  const out = [];
  const re = /('[^']*'|\b(?:import|from|const|export|async|function|await|return)\b)/g;
  let i = 0, m;
  while ((m = re.exec(s))) {
    if (m.index > i) out.push({ c: '', t: s.slice(i, m.index) });
    out.push({ c: m[0][0] === "'" ? 's' : 'k', t: m[0] });
    i = m.index + m[0].length;
  }
  if (i < s.length) out.push({ c: '', t: s.slice(i) });
  return out;
};

