const kanon = new URL('/guided-coding/biezace-wsparcie', Astro.site).href;

const title = "Bieżące wsparcie w guided codingu — przegląd zmian i zasady, które zostają u Was | Let's automate";
const description = 'Abonament dla firm, które budują własne aplikacje z AI, z działem IT albo bez niego. Zmiany przechodzą przegląd według zasad zapisanych w Waszym repozytorium, a kiedy coś się zatnie, siadamy z Wami przy jednym ekranie.';

// Heroicons Micro (16 × 16, solid), których nie ma w ikony.ts — tylko na tej
