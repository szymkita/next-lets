// ---- OKNA NARZĘDZI KLIENTA (.wo-) --------------------------------------------
// Każde okno to HTML z danych. Tylko to, co widzi i rozumie biznes: kanał
// zespołu (Teams), lista zadań, opis zadania, lista z wartościami (dostępy,
// limity), poczta, czat z AI, rachunek za AI. Bez kodu, terminali i paneli
// programisty (Szymon o v5: „totalny AI slop”). Treść zawsze przez esc().
const esc = (s: string) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const sv = (n: string) => `<svg viewBox="0 0 16 16" aria-hidden="true">${ik(n)}</svg>`;
const KROPKI = '<span class="kr"><i></i><i></i><i></i></span>';
const gl = (ikona: string, b: string, s = '', kr = false) =>
  `<div class="wo-g">${kr ? KROPKI : ''}${ikona ? sv(ikona) : ''}<b>${esc(b)}</b>${s ? `<span>${esc(s)}</span>` : ''}</div>`;
function okno(a: any): string {
  switch (a.k) {
    case 'tm': // kanał zespołu (Teams)
      return `<div class="wo tm">${gl('users', a.kan, a.sub)}<div class="tm-l">${a.m.map((m: any) =>
        `<div class="tm-m${m.c ? ' ' + m.c : ''}"><p class="h"><b>${esc(m.o)}</b>${m.r ? `<span>${esc(m.r)}</span>` : ''}<time>${esc(m.t)}</time></p><p class="x">${esc(m.x)}</p></div>`).join('')}</div></div>`;
    case 'zd': // zadanie na liście zadań zespołu (hero)
      return `<div class="wo zd">${gl('list-bullet', 'Zadania zespołu', 'Panel zamówień', true)}<div class="zd-g"><b>${esc(a.t)}</b><p><span>Zgłosił: <i>${esc(a.zg)}</i></span><span>Robi: <i>${esc(a.robi)}</i></span></p></div><ol class="zd-l">${a.h.map((h: string[]) =>
        `<li class="${h[2] || ''}"><time>${esc(h[0])}</time><p>${esc(h[1])}</p></li>`).join('')}</ol>${a.kom ? `<div class="zd-k"><p class="h"><b>${esc(a.kom.o)}</b><span>${esc(a.kom.r)}</span><time>${esc(a.kom.t)}</time></p><p class="x">${esc(a.kom.x)}</p></div>` : ''}<p class="zd-st ${a.stc}">${sv(a.stc === 'ok' ? 'check-circle' : 'clock')}${esc(a.st)}</p></div>`;
    case 'md': // opis zadania, sprawdzenie (dokument zespołu)
      return `<div class="wo md">${gl('document-text', a.plik, a.sub, true)}<div class="md-in">${a.r.map((r: string[]) =>
        r[0] === 'h' ? `<p class="mh">${esc(r[1])}</p>`
        : r[0] === 'lab' ? `<p class="ml">${esc(r[1])}</p>`
        : r[0] === 'ch' ? `<p class="mc"><i>${sv('check')}</i>${esc(r[1])}</p>`
        : `<p class="mp">${esc(r[1])}</p>`).join('')}</div></div>`;
    case 'li': // lista z wartościami: dostępy, limity
      return `<div class="wo li">${gl(a.ik || 'list-bullet', a.tyt, a.sub, true)}<div class="li-l">${a.r.map((r: string[]) =>
        `<div class="li-w"><span>${esc(r[0])}</span><b class="${r[2] || ''}">${esc(r[1])}</b></div>`).join('')}</div>${a.st ? `<p class="li-st">${sv('check-circle')}${esc(a.st)}</p>` : ''}</div>`;
    case 'cz': // czat z AI w przeglądarce
      return `<div class="wo cz">${gl('sparkles', a.tyt, a.sub, true)}<div class="cz-l">${a.m.map((m: any) =>
        m.r === 'ja'
          ? `<div class="cz-ja"><p>${esc(m.x)}</p>${(m.l || []).map((l: string[]) => `<p class="cz-d ${l[1]}">${esc(l[0])}</p>`).join('')}</div>`
          : `<div class="cz-ai">${sv('sparkles')}<p>${esc(m.x)}</p></div>`).join('')}</div>${a.st ? `<p class="cz-st ${a.stc || ''}">${esc(a.st)}</p>` : ''}</div>`;
    case 'ml': // poczta (Outlook)
      return `<div class="wo ml">${gl('envelope', a.box, a.sub)}<div class="ml-l">${a.m.map((m: any) =>
        `<div class="ml-w${m.sel ? ' sel' : ''}"><p class="o"><b>${esc(m.o)}</b><time>${esc(m.t)}</time></p><p class="s">${m.fl ? '<i class="fl"></i>' : ''}${esc(m.s)}</p><p class="p">${esc(m.p)}</p></div>`).join('')}</div></div>`;
    case 'ko': // rachunek za AI
      return `<div class="wo ko">${gl('banknotes', a.tyt, a.sub, true)}<div class="ko-l">${a.r.map((r: any[]) =>
        `<div class="ko-w${r[3] ? ' ' + r[3] : ''}"><span>${esc(r[0])}</span><i style="--p:${r[2]}%"></i><b>${esc(r[1])}</b></div>`).join('')}</div>${a.st ? `<p class="ko-st">${esc(a.st)}</p>` : ''}</div>`;
  }
  return '';
};

