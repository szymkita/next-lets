// ---- HERO: zmiana zespołu po programie ----------------------------------
// Anna robi zmianę tydzień po ostatniej sesji. Lista sprawdzeń (zasada 2)
// przechodzi po pozostałych zasadach; przy każdej podświetla się to, czego
// dotyczy (cel), a w CLAUDE.md zapala się zasada o tym numerze.
// Podświetlanie składni: słowa kluczowe, napisy, komentarze.
const esc = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const KW = /\b(const|await|async|export|function|return|if|import|from|new|test|expect)\b/g;
const kod = (s) => {
  const ci = s.indexOf('//');
  const body = ci >= 0 ? s.slice(0, ci) : s;
  const kom = ci >= 0 ? s.slice(ci) : '';
  const re = /('[^']*'|"[^"]*")/g;
  let out = '', last = 0, m;
  while ((m = re.exec(body))) {
    out += esc(body.slice(last, m.index)).replace(KW, '<i class="k">$1</i>');
    out += `<i class="s">${esc(m[0])}</i>`;
    last = m.index + m[0].length;
  }
  out += esc(body.slice(last)).replace(KW, '<i class="k">$1</i>');
  if (kom) out += `<i class="c">${esc(kom)}</i>`;
  return out || ' ';
};
