    {h.s ? <em class="ses">{h.kto ? `sesja ${h.s} · ${h.kto}` : `na sesji ${h.s}`}</em> : h.zle ? <em class="zle">{h.zle}</em> : <em class="ok">{h.st} zasad</em>}
  </div>
))}
</div>
</div>

<!-- agenda -->
<div class="co-widok" role="tabpanel" id="widok-2" aria-labelledby="zak-2" data-widok hidden>
<div class="co-ag-gl"><b>Program dla firmy produkcyjnej · 40 osób, aplikacja do zamówień</b><span>po przeglądzie 23–27.02 · {SESJI} sesji · 4 osoby przy ekranie</span></div>
<div class="co-ag ng"><span>Nr</span><span>Temat sesji</span><span>Skąd się wziął</span><span>Co zostaje w aplikacji</span></div>
{AGENDA.map((x) => (
  <div class="co-ag">
    <i>{x.n}</i>
    <b>{x.t}{x.w && <><br><small>wychodzi u każdego</small></>}</b>
    <span data-l="Skąd">{x.skad}</span>
    <span class="z" data-l="Zostaje">{x.zostaje}</span>
  </div>
))}
</div>

<!-- nagrania -->
<div class="co-widok" role="tabpanel" id="widok-3" aria-labelledby="zak-3" data-widok hidden>
{NAGRANIA.map((x) => (
  <div class="co-nw">
    <i><svg class="hi" viewBox="0 0 16 16" set:html={ik('play-circle')}></svg></i>
    <div><b>Sesja {x.n} · {x.t}</b><span class="co-roz">{x.r.map(([t, o]) => (<span><em>{t}</em>{o}</span>))}</span></div>
    <span><img src={OS[x.a].f} alt="" width="20" height="20" loading="lazy">{OS[x.a].n} przy klawiaturze</span>
    <time>{x.d}</time>
  </div>
))}
</div>
</div>

<div class="v3-jw-dol">
<div>
{ZAKLADKI.map((z, i) => (<p class="v3-jw-p" data-podpis hidden={i !== 0}><b>{z.t}</b>{z.p}</p>))}
</div>
</div>
</section>

<!-- ============ 5 · PRZYKŁADY ============
     PRZYKŁADOWE zespoły — do podmiany na potwierdzone. Miara: czas jednej
     zmiany. Pierwsza karta to firma z hero, sceny i cyklu tygodni. -->
<Dowody tytul="Sześć zespołów i&nbsp;czas jednej zmiany" sub="Od opisu zadania do wypuszczenia, razem z czekaniem na osobę, która jako jedyna umiała to sprawdzić. Przed programem i miesiąc po nim." przyklady={PRZYKLADY} miara="Czas jednej zmiany" link={{ href: '#cykl', t: 'Jak wyglądało siedem tygodni w pierwszym z nich ↓' }}>
<Cytat cytat="Let’s automate wziął pełną odpowiedzialność za projekt i dowiózł go do końca. To dlatego powierzyliśmy im kolejny, znacznie większy." logo="/uploads/klienci/nars.svg" logoAlt="NARS Polska" imie="Jakub Ciołkowski" rola="Członek Zarządu, NARS Polska" />
<CtaPasek tytul="Na pierwszej rozmowie ustalamy, od czego zacząć: od przeglądu kodu czy od jednej sesji na Waszej sprawie." />
</Dowody>

<!-- ============ 6 · METODA ============ -->
<Metoda tytul="Uczymy metody, na której sami budujemy" sub="Typowe szkolenie z AI ma program gotowy, zanim ktokolwiek zobaczy Waszą aplikację. Nasz powstaje z przeglądu kodu, a zasady spisujemy według WiseStacka, na którym budujemy własne projekty." wiersze={METODA} typowy="Typowe szkolenie<br>z AI" liczba="200+ wdrożeń" />

<!-- ============ 7 · CYKL TYGODNI ============
     Zamiast wdrożenia w czasie: od przeglądu (wejście, jedna kolumna) przez
     siedem sesji do pracy po programie. -->
<section id="cykl" class="v3-sek">
<div class="v8-gl">
<h2 class="v3-h2">Od przeglądu do sesji, którą prowadzi Wasza osoba</h2>
<p class="v3-sub">Co tydzień dwugodzinna sesja na sprawie z tego tygodnia. Między sesjami zespół pracuje sam według zasad, które już stoją w repozytorium, a na pytania odpowiadamy w ciągu dnia roboczego.</p>
</div>

<div class="cy" data-anim data-gra data-znow-cel>
<div class="ts4-gl"><b>Aplikacja do zamówień, luty–kwiecień</b><span><i class="cy-wz" aria-hidden="true"><i class="on"></i><i class="on"></i><i class="on"></i><i></i><i></i><i></i><i></i></i>zasady, które obowiązywały przy zmianie<button type="button" class="ts4-znow" data-znow aria-label="Pokaż siedem tygodni jeszcze raz"><svg viewBox="0 0 16 16" set:html={ik('arrow-path')} aria-hidden="true"></svg></button></span></div>
<div class="cy-wrap" tabindex="0" role="region" aria-label="Tablica tygodni programu, przewijana w poziomie na węższych ekranach">
<div class="cy-sc" role="img" aria-label="Tablica dziewięciu kolumn. Przegląd kodu i rozmowy z zespołem pod koniec lutego, po nim agenda z siedmioma sesjami; dwie rzeczy naprawiamy sami. Potem siedem tygodni, w każdym jedna dwugodzinna sesja z osobą zespołu przy klawiaturze i jedna nowa zasada w CLAUDE.md. Między sesjami zespół robi sam od jednej do trzech zmian; przy każdej zapala się tyle zasad, ile już obowiązywało. W trzecim tygodniu lista sprawdzeń zatrzymała zmianę bez warunków odbioru, poprawioną następnego dnia. Siódmą sesję prowadziła Anna. Po programie zespół robi zmiany sam i każda przechodzi przez siedem zasad.">
{CYKL.map((x, i) => (
  <div class="cy-k" style={`--i:${i}`} aria-hidden="true">
    <div class="cy-h" style="--j:0"><b>{x.h}</b><span>{x.d}</span></div>
    {x.ses.p ? (
      <div class="cy-s p" style="--j:1"><em>przegląd</em><b>{x.ses.t}</b><span class="cy-kto"><span class="o"><i><svg viewBox="0 0 40 41" set:html={SYGNET}></svg></i>Let’s automate</span></span></div>
    ) : x.ses.po ? (
      <div class="cy-s po" style="--j:1"><b>Bez sesji</b><span class="cy-kto">zespół pracuje sam</span></div>
    ) : (
      <div class={`cy-s${x.ses.prow ? ' prow' : ''}`} style="--j:1"><em>Sesja {x.ses.n}<small>2 h</small></em><b>{x.ses.t}</b><span class="cy-kto"><span class="o"><img src={OS[x.ses.a].f} alt="" width="18" height="18" loading="lazy">{x.ses.prow ? `${OS[x.ses.a].n} prowadzi` : OS[x.ses.a].n}</span><span class="o my"><i><svg viewBox="0 0 40 41" set:html={SYGNET}></svg></i>{x.ses.prow ? 'notujemy' : 'my obok'}</span></span></div>
    )}
    <div class="cy-cs" style="--j:2">
    {x.c.map((c) => c.q ? (
      <div class="cy-c q"><svg viewBox="0 0 16 16" set:html={ik('chat-bubble-left')}></svg><span>pytanie: {c.t}<small>odpowiedź tego samego dnia</small></span></div>
    ) : c.la ? (
      <div class="cy-c la"><i><svg viewBox="0 0 40 41" set:html={SYGNET}></svg></i><span>{c.t}</span></div>
    ) : (
      <div class={`cy-c${c.st ? ' st' : ''}`}><img src={OS[c.a].f} alt="" width="18" height="18" loading="lazy"><span>{c.t}{c.st && <small>{c.st}</small>}</span><span class="cy-pk">{Array.from({ length: 7 }, (_, j) => (<i class={j < x.k ? 'on' : ''}></i>))}</span></div>
    ))}
    </div>
    {x.z ? (
      <div class={`cy-z ${x.ses.p ? 'nic' : 'kon'}`} style="--j:3">{x.ses.p ? x.z : <b>{x.z}</b>}</div>
    ) : (
      <div class="cy-z" style="--j:3">+ <b>{x.ses.n}</b> · {ZASADY[x.ses.n - 1].k}</div>
    )}
  </div>
))}
<span class="cy-glow" aria-hidden="true"></span>
</div>
</div>
</div>
</section>

<!-- ============ 8 · DLA KOGO ============
     Podział po celu (chcecie umieć to sami), nie po typie zespołu.
     „Kiedy to nie ma sensu" — jedyne miejsce, które odsyła. -->
<DlaKogo tytul="Dla jakich zespołów to jest" sub="Z działem IT albo bez niego. Cel jest ten sam: umieć to samemu." warunki={DLA_KOGO} nie={NIE_TERAZ} />

<!-- ============ 9 · KONTAKT ============ -->
<Kontakt tytul="Zacznijmy od Waszego kodu" lead="Wystarczą dwa zdania: co to za aplikacja i kto ją buduje. Odpowiemy w jeden dzień roboczy z propozycją terminu rozmowy." zrodlo="Warsztaty dla zespołu" pytanie="Co zbudowaliście?" podpowiedz="Np. aplikacja do zamówień zbudowana w Lovable, buduje ją dwoje ludzi z operacji…" />

</div>

<GcFaq
  heading="Pytania, które padają przed decyzją"
  ctaLabel="Zadajcie nam swoje →"
  items={faq}
/>

<script>
  var redukcja = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- Hero: lista sprawdzeń przechodzi po zasadach (pętla) ----
  // Markup trzyma stan końcowy. start() chowa treść zmiany i gasi zasady,
  // potem: opis z warunkami → linie zmiany → test → lista sprawdzeń wiersz
  // po wierszu (podświetla to, czego dotyczy, i zapala zasadę o tym
  // numerze) → zasada 2 i wypuszczenie. Pętla stoi poza kadrem.
  (function(){
    var fig = document.querySelector('[data-zz]');
    if(!fig || redukcja || !('IntersectionObserver' in window)) return;
    var $$ = function(q){ return Array.prototype.slice.call(fig.querySelectorAll(q)); };
    var zasady = {}; $$('[data-zr]').forEach(function(li){ zasady[li.getAttribute('data-zr')] = li; });
    var bloki = $$('[data-zb]'), war = $$('[data-zw]'), linie = $$('[data-zl]'), spr = $$('[data-zs]');
    var log = $$('[data-zlog]');
    var r2 = fig.querySelector('[data-zr2]'), st = fig.querySelector('[data-zst]'), dol = fig.querySelector('[data-zdol]');
    var stT = st.querySelector('span'), stIk = st.querySelector('svg');
    var IK_ST = stIk.innerHTML;
    var IK_KR = '<path fill-rule="evenodd" d="M13.836 2.477a.75.75 0 0 1 .75.75v3.182a.75.75 0 0 1-.75.75h-3.182a.75.75 0 0 1 0-1.5h1.37l-.84-.841a4.5 4.5 0 0 0-7.08.932.75.75 0 0 1-1.3-.75 6 6 0 0 1 9.44-1.242l.842.84V3.227a.75.75 0 0 1 .75-.75Zm-.911 7.5A.75.75 0 0 1 13.199 11a6 6 0 0 1-9.44 1.241l-.84-.84v1.371a.75.75 0 0 1-1.5 0V9.591a.75.75 0 0 1 .75-.75H5.35a.75.75 0 0 1 0 1.5H3.98l.841.841a4.5 4.5 0 0 0 7.08-.932.75.75 0 0 1 1.025-.273Z" clip-rule="evenodd"/>';
    var widoczny = false;
    function czekaj(ms){ return new Promise(function(r){ setTimeout(r, ms); }); }
    async function gdyWidoczny(){ while(!widoczny || document.hidden) await czekaj(300); }
    async function krok(ms){ await czekaj(ms); await gdyWidoczny(); }
    function cel(k, on){ if(!k) return; $$('[data-cel="' + k + '"]').forEach(function(e){ if(e.hasAttribute('data-zs')) return; e.classList.toggle('cel', on); }); }
    function zapal(n){
      var li = zasady[n]; if(!li) return;
      li.classList.add('on', 'bl');
      setTimeout(function(){ li.classList.remove('bl'); }, 900);
    }
    function start(){
      Object.keys(zasady).forEach(function(k){ zasady[k].classList.remove('on', 'bl'); });
      bloki.forEach(function(b){ b.classList.add('ukr'); });
      war.forEach(function(w){ w.classList.add('ukr'); });
      linie.forEach(function(l){ l.classList.add('ukr'); });
      spr.forEach(function(s){
        s.classList.remove('bieg'); s.classList.add('czeka');
        var r = s.querySelector('.zz-r:not(.nic)'); if(r) r.classList.add('ukr');
        if(s.dataset.licz){ s.querySelector('[data-v]').textContent = '0 z ' + s.dataset.licz; }
      });
      r2.classList.add('ukr');
      log.forEach(function(l){ l.classList.add('ukr'); });
      dol.classList.add('ukr');
      st.classList.add('toku'); stIk.innerHTML = IK_KR; stT.textContent = 'w toku';
      $$('.cel').forEach(function(e){ e.classList.remove('cel'); });
    }
    async function petla(){
      for(;;){
        await gdyWidoczny();
        fig.classList.add('znika');
        await czekaj(500);
        start();
        fig.classList.remove('znika');
        await krok(700);
        // opis zadania
        bloki[0].classList.remove('ukr');
        log[0].classList.remove('ukr');
        for(var i = 0; i < war.length; i++){ await krok(280); war[i].classList.remove('ukr'); }
        await krok(500);
        // zmiana w kodzie
        bloki[1].classList.remove('ukr');
        var l1 = linie.filter(function(l){ return bloki[1].contains(l); });
        for(i = 0; i < l1.length; i++){ await krok(170); l1[i].classList.remove('ukr'); }
        await krok(400);
        // test
        bloki[2].classList.remove('ukr');
        var l2 = linie.filter(function(l){ return bloki[2].contains(l); });
        for(i = 0; i < l2.length; i++){ await krok(170); l2[i].classList.remove('ukr'); }
        await krok(250);
        log[1].classList.remove('ukr');
        await krok(600);
        stT.textContent = 'sprawdzanie';
        // lista sprawdzeń
        for(i = 0; i < spr.length; i++){
          var s = spr[i], k = s.dataset.cel, n = s.dataset.r;
          s.classList.remove('czeka'); s.classList.add('bieg');
          cel(k, true);
          if(s.dataset.licz){
            var v = s.querySelector('[data-v]'), max = +s.dataset.licz;
            for(var c = 1; c <= max; c += 3){ v.textContent = Math.min(c, max) + ' z ' + max; await czekaj(45); }
            v.textContent = max + ' z ' + max;
          }
          await krok(520);
          s.classList.remove('bieg');
          var r = s.querySelector('.zz-r:not(.nic)'); if(r) r.classList.remove('ukr');
          if(n && n !== '0') zapal(n);
          await krok(320);
          cel(k, false);
          if(i === spr.length - 1) log[2].classList.remove('ukr');
        }
        await krok(250);
        r2.classList.remove('ukr'); zapal('2');
        log[3].classList.remove('ukr');
        await krok(700);
        st.classList.remove('toku'); stIk.innerHTML = IK_ST; stT.textContent = 'u klientów';
        dol.classList.remove('ukr');
        await krok(6500);
      }
    }
    new IntersectionObserver(function(w){ widoczny = w[0].isIntersecting; }, { threshold: 0.25 }).observe(fig);
    petla();
  })();

  // ---- „Jeszcze raz" w rysunkach odsłanianych raz (mapa, sesja, cykl) ----
  // Gasi przejścia (.bez), zdejmuje .on, przelicza układ i zakłada .on
  // z powrotem — cała sekwencja odgrywa się od początku.
  (function(){
    document.querySelectorAll('[data-znow]').forEach(function(b){
      var fig = b.closest('[data-znow-cel]');
      if(!fig) return;
      b.addEventListener('click', function(){
        fig.classList.add('bez'); fig.classList.remove('on');
        void fig.offsetWidth;
        fig.classList.remove('bez');
        requestAnimationFrame(function(){ fig.classList.add('on'); });
      });
    });
  })();

  // ---- Zakładki „Co zostaje" ----
  (function(){
    var zak = Array.prototype.slice.call(document.querySelectorAll('[data-zak]'));
    if(!zak.length) return;
    var widoki = document.querySelectorAll('[data-widok]');
    var podpisy = document.querySelectorAll('[data-podpis]');
    var okruch = document.querySelector('[data-okruch]');
    var PLIKI = ['CLAUDE.md', 'historia zmian', 'agenda.pdf', 'nagrania'];
    function pokaz(i, fokus){
      zak.forEach(function(b, j){ b.setAttribute('aria-selected', i === j ? 'true' : 'false'); b.tabIndex = i === j ? 0 : -1; });
      widoki.forEach(function(w, j){ w.hidden = i !== j; });
      podpisy.forEach(function(p, j){ p.hidden = i !== j; });
      if(okruch) okruch.textContent = PLIKI[i];
      if(fokus) zak[i].focus();
    }
    zak.forEach(function(b, i){
      b.addEventListener('click', function(){ pokaz(i); });
      b.addEventListener('keydown', function(e){
        if(e.key === 'ArrowRight'){ e.preventDefault(); pokaz((i + 1) % zak.length, true); }
        if(e.key === 'ArrowLeft'){ e.preventDefault(); pokaz((i - 1 + zak.length) % zak.length, true); }
      });
    });
  })();
</script>
</LaBase>
