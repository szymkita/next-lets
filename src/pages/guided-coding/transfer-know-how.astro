---
// DRZWI C — /guided-coding/transfer-know-how
//
// KIERUNEK (Szymon, 31.08): odbiorcą są OBIE grupy, a podział wobec dwóch
// pozostałych drzwi idzie po CELU, nie po typie zespołu. Kształt usługi:
// „one są budowane pod klienta, indywidualnie projektujemy szkolenie".
//
// TEZA (wyprowadzona z tego zdania): kategoria sprzedaje program, ten sam
// u każdego. Nasz nie istnieje, dopóki nie przeczytamy Waszego kodu —
// powstaje z tego, co w nim znaleźliśmy, i prowadzimy go na Waszej
// aplikacji, więc po każdej sesji coś w niej jest naprawione.
//
// JEDNA MIARA PRZEZ CAŁĄ STRONĘ: skąd wziął się każdy temat.
// 9 znalezisk z przeglądu → 2 naprawiamy sami → 7 sesji, z czego
// 2 wychodzą u każdego i 5 tylko z Waszego kodu. Te same liczby wracają
// w hero, w ciemnym pasie i w FAQ. Zmiana którejkolwiek wymaga przeliczenia
// pozostałych.
//
// CZEGO NIE POWTARZAM Z RODZEŃSTWA (osobny słownik wizualny):
// · /guided-coding — krzywa tempa, dwa pasy zbiegające się, tabela vs
// · /bez-zespolu-it-v2 — lupa nad przewijającym się kodem, kalendarz
//   dwudziestu dni, karty przewijane w poziomie, pary słupków na ciemnym
// · /dla-zespolow-v2 — drabina sześciu poziomów z paskami i licznikiem
//   „2 z 6", bramka przed merge’em jako karta sprawdzeń
// · /szkolenia-ai — jednostki do policzenia (ludzie w kreskach, minuty)
// Tutaj: LISTA, KTÓRA SIĘ PRZESTAWIA (znaleziska układają się w program)
// plus agenda z uzasadnieniem jako artefakt na ciemnym pasie. Zgodnie
// z lekcją z /systemy-dla-klientow: jedna animacja z prawdziwym ruchem
// i jeden artefakt, nie dwa rysunki tego samego gatunku.
//
// DO POTWIERDZENIA PRZED PUBLIKACJĄ:
// · wszystkie liczby w nawiasach kwadratowych są hipotezą (długość sesji,
//   liczba sesji, liczba osób, czas przeglądu, kadencja odpowiedzi);
// · ceny nie ma świadomie — jak na pozostałych podstronach poza /strategia-ai;
// · agenda w ciemnym pasie jest złożona z rzeczy, które widzimy najczęściej;
//   mówi o tym nota pod nią. Przed publikacją sprawdzić, czy nie przypomina
//   kodu ani sytuacji konkretnego klienta;
// · zdanie „ostatnią sesję prowadzi Wasza osoba" to zobowiązanie umowne.
import LaBase from '../../layouts/LaBase.astro';
import GcFaq from '../../components/GcFaq.astro';
import GcCta from '../../components/GcCta.astro';

const title = "Transfer know-how — program szkoleniowy pod Waszą aplikację | Let's automate";
const description = 'Program powstaje po przeglądzie Waszego kodu i prowadzimy go na Waszej aplikacji. Po każdej sesji zostaje w niej zmiana, a zasady zostają w Waszym repozytorium.';


// ---- HERO: PRZEGLĄD PRZESTAWIA SIĘ W PROGRAM ---------------------------
// Dziewięć znalezisk stoi w kolejności, w jakiej wyszły z przeglądu.
// Potem lista się przestawia: siedem wierszy układa się w kolejność sesji
// i dostaje numery, dwa zjeżdżają pod kreskę.
//
// UCZCIWOŚĆ RYSUNKU: dwa tematy wychodzą u KAŻDEGO klienta i są tak
// podpisane. Strona, na której wszystko jest wyjątkowe, czyta się jak
// materiał sprzedażowy.
const ZNALEZISKA = [
  { t: 'klucz do API w kodzie',      poz: 2, sesja: 3 },
  { t: 'każdy prosi model inaczej',  poz: 0, sesja: 1, wszedzie: true },
  { t: 'trzy wersje jednej funkcji', poz: 7, sami: true },
  { t: 'projekt odpali tylko autor', poz: 3, sesja: 4 },
  { t: 'zmiany idą prosto do ludzi', poz: 1, sesja: 2, wszedzie: true },
  { t: 'kopia nigdy nie odtworzona', poz: 8, sami: true },
  { t: 'brak testu na płatnościach', poz: 4, sesja: 5 },
  { t: 'dane klientów w arkuszu',    poz: 5, sesja: 6 },
  { t: 'rachunek rośnie po próbach', poz: 6, sesja: 7 },
];
const SESJI = ZNALEZISKA.filter((z) => z.sesja).length;          // 7
const WSZEDZIE = ZNALEZISKA.filter((z) => z.wszedzie).length;    // 2
const Z_KODU = SESJI - WSZEDZIE;                                 // 5

// Czasy pętli. Cztery akty: przegląd się odsłania, wiersze są podnoszone
// i odkładane na swoje miejsca, program materializuje się jako blok,
// na koniec lista schodzi od dołu i pętla zaczyna się od nowa.
// Wszystko liczy się z tablicy RUCH — po zmianie liczby wierszy albo
// odstępu animacja przelicza się sama.
//
// NIC NIE ZDRADZA POINTY Z GÓRY: dopóki program się nie złoży, wszystkie
// dziewięć wierszy wygląda tak samo. Kropka przy wierszu zamienia się
// w numer sesji dopiero w trzecim akcie, a dwa odrzucone bledną razem
// z pojawieniem się kreski.
const CYKL = 16.3;
const RUCH = {
  we: 0.55, weOdstep: 0.16, weTrwa: 0.5,    // akt 1 — znaleziska wchodzą
  st: 3.1, odstep: 0.22, trwa: 0.75,         // akt 2 — wiersze idą na miejsca
  num: 5.95, numOdstep: 0.09,                // akt 3 — numery sesji
  tag: 6.45, tagOdstep: 0.07,                //         znaczniki
  blok: 5.8, kres: 5.95, blak: 6.15,         //         blok programu, kreska, zblaknięcie
  wy: 15.0, wyOdstep: 0.05, wyTrwa: 0.4,     // akt 4 — lista schodzi od dołu
  snap: 15.85,
};
const pc = (t) => `${((t / CYKL) * 100).toFixed(2)}%`;

// Czasy pojedynczego wiersza: wejście liczone z kolejności przeglądu,
// reszta z pozycji docelowej — dzięki temu program układa się od góry,
// a schodzi od dołu.
const czasy = (z, i) => {
  const we0 = RUCH.we + i * RUCH.weOdstep;
  const t0 = RUCH.st + z.poz * RUCH.odstep;
  const wy0 = RUCH.wy + (ZNALEZISKA.length - 1 - z.poz) * RUCH.wyOdstep;
  return { we0, we1: we0 + RUCH.weTrwa, t0, t1: t0 + RUCH.trwa, wy0, wy1: wy0 + RUCH.wyTrwa,
           n0: RUCH.num + z.poz * RUCH.numOdstep, g0: RUCH.tag + z.poz * RUCH.tagOdstep };
};
const CZASY = ZNALEZISKA.map(czasy);
const WY0 = Math.min(...CZASY.map((c) => c.wy0));
const WY1 = Math.max(...CZASY.map((c) => c.wy1));

const PLASKO = 'transform:none;box-shadow:0 0 0 rgba(18,38,28,0);background:rgba(255,255,255,0)';
const PODNIESIONY = 'transform:scale(1.014);box-shadow:0 18px 36px -20px rgba(18,38,28,0.55);background:rgba(255,255,255,1)';

const klatkiHero = [
  // Przejazd wiersza na swoje miejsce — jedyna rzecz na zewnętrznym pudełku,
  // żeby wjazd z lewej i podniesienie mogły działać na wewnętrznym.
  ...ZNALEZISKA.map((z, i) => {
    const c = CZASY[i];
    return `@keyframes tk-w${i}{0%,${pc(c.t0)}{transform:translateY(0)}${pc(c.t1)},${pc(RUCH.snap)}{transform:translateY(calc(var(--d) * var(--rh)))}${pc(RUCH.snap + 0.05)},100%{transform:translateY(0)}}`;
  }),
  // Wejście, podniesienie przy przeprowadzce, odłożenie, zejście.
  ...ZNALEZISKA.map((z, i) => {
    const c = CZASY[i];
    return `@keyframes tk-in${i}{`
      + `0%,${pc(c.we0)}{opacity:0;transform:translateX(-16px);box-shadow:0 0 0 rgba(18,38,28,0);background:rgba(255,255,255,0)}`
      + `${pc(c.we1)},${pc(c.t0 - 0.12)}{opacity:1;${PLASKO}}`
      + `${pc(c.t0)},${pc(c.t1)}{opacity:1;${PODNIESIONY}}`
      + `${pc(c.t1 + 0.3)},${pc(c.wy0)}{opacity:1;${PLASKO}}`
      + `${pc(c.wy1)},${pc(RUCH.snap)}{opacity:0;transform:translateX(12px);box-shadow:0 0 0 rgba(18,38,28,0);background:rgba(255,255,255,0)}`
      + `${pc(RUCH.snap + 0.05)},100%{opacity:0;transform:translateX(-16px);box-shadow:0 0 0 rgba(18,38,28,0);background:rgba(255,255,255,0)}}`;
  }),
  // Numer sesji wskakuje z lekkim przestrzeleniem, kropka gaśnie pod nim.
  ...ZNALEZISKA.filter((z) => z.sesja).map((z) => {
    const c = CZASY[ZNALEZISKA.indexOf(z)];
    return `@keyframes tk-n${z.sesja}{0%,${pc(c.n0)}{opacity:0;transform:scale(.45)}${pc(c.n0 + 0.3)}{opacity:1;transform:scale(1.14)}${pc(c.n0 + 0.46)},100%{opacity:1;transform:scale(1)}}`
      + `@keyframes tk-d${z.sesja}{0%,${pc(c.n0)}{opacity:1}${pc(c.n0 + 0.2)},100%{opacity:0}}`;
  }),
  // Znaczniki dojeżdżają z prawej, w kolejności sesji.
  ...ZNALEZISKA.map((z, i) => {
    const c = CZASY[i];
    return `@keyframes tk-g${i}{0%,${pc(c.g0)}{opacity:0;transform:translateX(10px)}${pc(c.g0 + 0.42)},100%{opacity:1;transform:translateX(0)}}`;
  }),
  `@keyframes tk-blok{0%,${pc(RUCH.blok)}{opacity:0}${pc(RUCH.blok + 0.55)},${pc(WY0)}{opacity:1}${pc(WY1)},100%{opacity:0}}`,
  `@keyframes tk-rail{0%,${pc(RUCH.blok)}{transform:scaleY(0)}${pc(RUCH.blok + 0.7)},${pc(WY0)}{transform:scaleY(1)}${pc(WY1)},100%{transform:scaleY(0)}}`,
  `@keyframes tk-kres{0%,${pc(RUCH.kres)}{opacity:0;transform:scaleX(0)}${pc(RUCH.kres + 0.55)},${pc(WY0)}{opacity:1;transform:scaleX(1)}${pc(WY1)},100%{opacity:0;transform:scaleX(1)}}`,
  `@keyframes tk-blak{0%,${pc(RUCH.blak)}{color:#16211a}${pc(RUCH.blak + 0.45)},100%{color:#95a196}}`,
  `@keyframes tk-tyt-a{0%,${pc(RUCH.st)}{opacity:1;transform:translateY(0)}${pc(RUCH.st + 0.42)},100%{opacity:0;transform:translateY(-7px)}}`,
  `@keyframes tk-tyt-b{0%,${pc(RUCH.st + 0.2)}{opacity:0;transform:translateY(7px)}${pc(RUCH.st + 0.62)},${pc(WY0)}{opacity:1;transform:translateY(0)}${pc(WY1)},100%{opacity:0;transform:translateY(0)}}`,
].join('\n');


