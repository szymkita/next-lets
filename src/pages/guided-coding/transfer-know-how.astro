<script>
  // Zachowania tej strony: przełącznik w hero i stany opowieści „Siedem
  // sesji” (na telefonie panele pod tekstem sesji). Reszta (rząd sytuacji,
  // definicja, opinie, wejścia rysunków) jest w LuSkrypty i Anim.
  var redukcjaWz = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var maWz = 'IntersectionObserver' in window;

  // ---- HERO: „Przed programem / Po programie” ----
  // Start: przed. Gdy hero jest w kadrze, po 3,8 s przechodzi raz na „po”,
  // chyba że ktoś już kliknął. Przy ograniczonym ruchu od razu „po”.
  (function(){
    var fig = document.querySelector('[data-wz-hs]') as HTMLElement | null;
    if(!fig) return;
    var f = fig;
    var przyc = Array.prototype.slice.call(f.querySelectorAll('[data-wz-hs-t]')) as HTMLButtonElement[];
    var klik = false;
    function ustaw(s: string){
      f.dataset.stan = s;
      przyc.forEach(function(b){ b.setAttribute('aria-pressed', b.dataset.wzHsT === s ? 'true' : 'false'); });
    }
    przyc.forEach(function(b){ b.addEventListener('click', function(){ klik = true; ustaw(b.dataset.wzHsT || 'po'); }); });
    if(redukcjaWz){ ustaw('po'); return; }
    if(!maWz) return;
    var t: number | undefined;
    var io = new IntersectionObserver(function(e){
      if(e[0].isIntersecting && !klik && t === undefined){
        t = window.setTimeout(function(){ if(!klik) ustaw('po'); io.disconnect(); }, 3800);
      }
    }, { threshold: 0.4 });
    io.observe(f);
  })();

  // ---- SIEDEM SESJI: krok w środku ekranu ustawia panel i zakładkę ----
  // Na telefonie (do 900 px) przyklejony rysunek zasłaniałby tekst, więc
  // skrypt przenosi panel każdej sesji pod jej tekst (wzór .sh-z-mob
  // z /lets-shift) i oddaje go z powrotem po powrocie do szerokiego okna.
  (function(){
    var wiz = document.querySelector('[data-wz-z]') as HTMLElement | null;
    if(!wiz) return;
    var w = wiz;
    var sek = w.closest('section') as HTMLElement;
    var st = w.querySelector('.wz-z-st') as HTMLElement;
    var kroki = Array.prototype.slice.call(document.querySelectorAll('[data-wz-k]')) as HTMLElement[];
    var panele = Array.prototype.slice.call(w.querySelectorAll('[data-wz-z-s]')) as HTMLElement[];
    var mq = window.matchMedia('(max-width:900px)');
    function uklad(){
      sek.classList.toggle('wz-z-mob', mq.matches);
      panele.forEach(function(p, i){
        if(mq.matches){ var k = kroki[i]; if(k && k.nextElementSibling !== p) k.after(p); }
        else if(p.parentElement !== st){ st.appendChild(p); }
      });
    }
    if(mq.addEventListener) mq.addEventListener('change', uklad);
    uklad();
    if(!maWz) return;
    var biez = -1;
    function ustaw(k: number){
      if(k === biez) return;
      biez = k;
      w.dataset.krok = String(k);
      kroki.forEach(function(x, j){ x.classList.toggle('on', j === k); });
    }
    var io = new IntersectionObserver(function(e){
      e.forEach(function(x){ if(x.isIntersecting) ustaw(Number((x.target as HTMLElement).dataset.wzK)); });
    }, { rootMargin: '-45% 0px -45% 0px' });
    kroki.forEach(function(k){ io.observe(k); });
  })();
</script>
