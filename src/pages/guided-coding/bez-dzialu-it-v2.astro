// ---- MIESIĄC DZIEŃ PO DNIU ---------------------------------------------
// Kafelki jak w wykresie aktywności: intensywność koloru mówi, ile się
// danego dnia działo, a dymek pokazuje co dokładnie. Dzięki temu nie
// potrzeba legendy — treść siedzi w każdym dniu z osobna.
const DNI = [
  { w: 2, q: 1 },            { w: 3, p: 1 },            { w: 1, q: 2 },            { w: 4, q: 1 },            { w: 2 },
  { w: 3, q: 1 },            { w: 2, p: 1, q: 1 },      { w: 3, s: 1 },            { w: 1, q: 1 },            { w: 4, p: 1 },
  { w: 2, q: 2 },            { w: 3 },                  { w: 2, q: 1 },            { w: 4, s: 1 },            { w: 1, p: 1, q: 1 },
  { w: 3, q: 1 },            { w: 2 },                  { w: 4, p: 1, q: 2 },      { w: 2, q: 1 },            { w: 3, d: 1 },
];
const DNI_TYG = ['pn', 'wt', 'śr', 'cz', 'pt'];

// polska odmiana bez kombinowania: 1 / 2–4 / 5+
const odm = (n, jeden, kilka, wiele) => (n === 1 ? jeden : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? kilka : wiele);
const opisDnia = (x) => {
  const l = [`${x.w} ${odm(x.w, 'nowa wersja przejrzana', 'nowe wersje przejrzane', 'nowych wersji przejrzanych')}`];
  if (x.p) l.push('poprawka po naszej stronie');
  if (x.q) l.push(`${x.q} ${odm(x.q, 'pytanie na czacie', 'pytania na czacie', 'pytań na czacie')}`);
  if (x.s) l.push('wspólne spotkanie · 90 minut');
  if (x.d) l.push('podsumowanie miesiąca · godzina');
  return l;
};
const MIESIAC = DNI.map((x, i) => ({
  ...x,
  i,
  tydzien: Math.floor(i / 5) + 1,
  dzien: DNI_TYG[i % 5],
  poziom: Math.min(4, x.w + (x.p ? 1 : 0)),
  opis: opisDnia(x),
}));


// ---- WISESTACK (ciemny pas) --------------------------------------------
// TEZA RYSUNKU: samo budowanie trwa tyle samo. Znika czekanie.
// WSZYSTKIE LICZBY DO PODMIANY — dni robocze, mediana z wdrożeń.
const ETAPY = [
  { k: 'budowa', o: 'budujesz', kolor: 'b' },
  { k: 'czekanie', o: 'czekanie na sprawdzenie', kolor: 'c' },
  { k: 'poprawki', o: 'poprawki po fakcie', kolor: 'p' },
];
const DROGI = [
  { t: 'Bez metody', budowa: 1.5, czekanie: 3.0, poprawki: 1.0 },
  { t: 'Z WiseStackiem', budowa: 1.5, czekanie: 0.4, poprawki: 0.4, my: true },
];
const DR_MAX = Math.max(...DROGI.map((d) => d.budowa + d.czekanie + d.poprawki));
const suma = (d) => d.budowa + d.czekanie + d.poprawki;
const dni = (v) => `${v.toFixed(1).replace('.', ',')} dnia`;


// ---- KTO PO NASZEJ STRONIE ---------------------------------------------
// Twarze biorę z rejestru zespołu (src/data/zespol.js), bo abstrakcyjne
// kafle nic nie mówią, a stockowych zdjęć nie używamy.
const os = (n) => zespol.find((x) => x.name === n);
const PROWADZACY = ['Krzysztof Radej', 'Michał Langowski', 'Michał Kita', 'Kamil Olejek', 'Marcel Bilski'].map(os);

const DOKLADANE = [
  { t: 'Analityk biznesowy', d: 'gdy z aplikacji zaczynają wychodzić raporty', kto: os('Damian Trzciński') },
  { t: 'Zastępstwo', d: 'na urlop albo odejście Twojej osoby', kto: os('Łukasz Filip') },
  { t: 'Trudniejsze elementy', d: 'płatności, migracje, ciężkie integracje', kto: os('Krzysztof Radej') },
  { t: 'Kierownik projektu', d: 'gdy budujesz dwa produkty naraz', kto: os('Aleksander Żaboklicki') },
  { t: 'Projektant', d: 'gdy narzędzie zaczynają widzieć klienci', kto: os('Dawid Kita') },
];


// ---- CO DZIEJE SIĘ PO DIAGNOZIE ----------------------------------------
// Poprawka 5. Wcześniej stały tu dwa konkurencyjne wejścia, każde
// z własnym przyciskiem („Umów przegląd", „Umów rozmowę o celach"),
// i żadne nie było ofertą, po którą klient przyszedł ze strony głównej.
// Teraz obie drogi zaczynają się od tej samej bezpłatnej diagnozy.
const WEJSCIE = [
  {
    e: 'Kiedy coś już działa',
    t: 'Masz już coś zbudowane',
    d: 'Pięć dni, w których przechodzimy to, co powstało. Wychodzisz z listą podzieloną po tym, kto co wykona.',
    kroki: ['Pięć dni przeglądu', 'Pierwszy miesiąc prowadzenia idzie po liście'],
    m: 'przegląd · 5 dni',
  },
  {
    e: 'Kiedy zaczynasz od zera',
    t: 'Jeszcze nie ma czego oglądać',
    d: 'Dwa dni na cele i dobór narzędzi. Tu mamy wpływ na wybory, których później nie da się zmienić tanio.',
    kroki: ['Dwa dni na cele i narzędzia', 'Pierwszy miesiąc zaczyna się od budowy'],
    m: 'ustalenia · 2 dni',
  },
];


// ---- CO MASZ DO WYBORU --------------------------------------------------
// Zyski tej usługi widać dopiero obok tego, co klient rozważa naprawdę.
// Kwoty rynkowe zapisane wprost — w oryginale stały w nawiasach
// kwadratowych i tak trafiły na produkcję.
const ALTERNATYWY = [
  {
    t: 'Programista na etacie',
    d: 'Jedna osoba, która zna tylko Twój projekt — i idzie na urlop w lipcu.',
    koszt: '15–25 tys. zł / mies.',
    kto: 'Twoja, jeśli go znajdziesz',
    kiedy: 'za 2–4 miesiące rekrutacji',
  },
  {
    t: 'Software house',
    d: 'Gotowy produkt i rachunek za każdą kolejną zmianę.',
    koszt: 'wycena za projekt',
    kto: 'przechodzi do nich',
    kiedy: 'po ustaleniu zakresu',
  },
  {
    t: 'Nic',
    d: 'Działa do dnia, w którym coś się wysypie albo autor odejdzie.',
    koszt: '0 zł do pierwszej awarii',
    kto: 'u Ciebie',
    kiedy: '—',
  },
  {
    t: 'Prowadzenie z nami',
    d: 'Code review każdej zmiany, poprawki po naszej stronie i ludzie, którzy z miesiąca na miesiąc umieją więcej.',
    koszt: 'od 2900 zł / mies.',
    kto: 'zostaje u Ciebie',
    kiedy: 'od pierwszego tygodnia',
    my: true,
  },
];


// ---- FAQ ----------------------------------------------------------------
// Poprawka 7: z dziesięciu pytań zostaje siedem. Wypadły te, na które
// odpowiada już treść strony („kiedy coś jest ważne" — krok 02,
// „umiecie w Claude Code" — hero i krok 01) oraz trzecie o dostępach,
// które dublowało odpowiedź o wypowiedzeniu.
const faq = [
  {
    q: 'Za co płacę w miesiącu, w którym nic się nie zepsuło?',
    a: 'Za to, że każda nowa wersja przeszła przez code review, i za to, że miałeś gdzie zapytać w środę o czternastej. Jeśli spokojnych miesięcy jest kilka pod rząd, sami proponujemy zejście na mniejszy zakres.',
  },
  {
    q: 'Nie mam nikogo technicznego. Czy zrozumiem, co do mnie wraca?',
    a: 'Wiadomość, po której ktoś czuje się głupszy, jest źle napisaną wiadomością — to jedyne kryterium, po którym oceniamy własną robotę. Każda ma cztery części: co zobaczyliśmy, co proponujemy, ile to zajmie i czego nie ruszamy.',
  },
  {
    q: 'Musicie mieć dostęp do wszystkiego?',
    a: 'Nie. Wystarczy podgląd do projektu i do miejsca, gdzie leży kod — w większości narzędzi to zaproszenie na adres e-mail, do cofnięcia jednym kliknięciem. Umowę o poufności podpisujemy przed pierwszym dostępem.',
  },
  {
    q: 'Poprawiacie sami czy tylko mówicie, co zrobić?',
    a: 'Jedno i drugie. Drobne poprawki robimy u siebie od ręki, a to, co będziesz spotykać co tydzień, zostawiamy z instrukcją — po trzecim razie zrobisz to bez nas. Budowy produktu nie przejmujemy.',
  },
  {
    q: 'Ile mojego czasu to zajmuje?',
    a: 'Około czterech godzin w miesiącu: dwa spotkania, godzina podsumowania i drobne pytania po drodze.',
  },
  {
    q: 'Czy dojdą jakieś koszty poza abonamentem?',
    a: 'Nie po naszej stronie — narzędzia, licencje i tokeny są w stawce miesięcznej. Osobno płacisz tylko za to, co i tak jest Twoje: subskrypcję Claude Code i rachunki za usługi, na których stoi aplikacja.',
  },
  {
    q: 'Co, jeśli chcę przestać?',
    a: 'Miesięczny okres wypowiedzenia. Zostaje u Ciebie wszystko: kod, dostępy i spisane zasady — jak „AI nie zmienia pieniędzy bez zgody człowieka”, dopisana po tym, jak agent wystawił korektę do faktury sam. Czyta je AI, w którym budujesz, więc działają dalej. Od dostawców narzędzi nie bierzemy prowizji.',
  },
];

// Poprawka 7b: schema FAQPage. Sześć podstron pionu „Wdrażamy AI" ją ma,
// żadna ze stron Guided Codingu nie miała.
const dane = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${kanon}#usluga`,
      name: 'Guided coding dla zespołu bez działu IT',
      serviceType: 'Stała opieka nad aplikacją budowaną z AI',
      url: kanon,
      description: 'Abonamentowe prowadzenie zespołu, który buduje aplikacje w Claude Code bez działu IT: code review każdej zmiany, poprawki po stronie studia, wspólne sesje przy jednym ekranie i zasady dopisywane do repozytorium klienta.',
      provider: { '@id': new URL('/#organizacja', Astro.site).href },
      areaServed: { '@type': 'Country', name: 'Polska' },
      audience: { '@type': 'BusinessAudience', name: 'Firmy bez własnego działu IT' },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${kanon}#okruszki`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Strona główna', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: 'Guided Coding', item: new URL('/guided-coding', Astro.site).href },
        { '@type': 'ListItem', position: 3, name: 'Dla zespołów nietechnicznych', item: kanon },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${kanon}#faq`,
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---
<LaBase title={title} description={description} ctaHref="#kontakt" ctaLabel="Bezpłatna diagnoza">
<script type="application/ld+json" is:inline set:html={JSON.stringify(dane)} slot="head"></script>
<style is:global slot="head">
  /* ================= panel klienta (hero) ==============================
     Poprawka 2: ten sam gatunek rysunku co w hero strony głównej —
     aplikacja klienta w ramce przeglądarki, dwie karty unoszące się obok
     i prawy pasek z rachunkiem miesiąca. Rysunek niesie proporcję
     55 wersji na 4 poprawki, której nie ma w tekście obok. */
  .ap-box{position:relative;width:calc(var(--w) * var(--s, 1));height:calc(var(--h) * var(--s, 1))}
  .ap-ram{position:absolute;left:0;top:0;width:var(--w);height:var(--h);transform:scale(var(--s, 1));transform-origin:top left}
  .ap-okno{position:absolute;inset:0;border-radius:16px;overflow:hidden;background:#ffffff;border:1px solid rgba(20,33,26,0.1);box-shadow:0 -20px 80px -30px rgba(12,28,20,0.25),0 30px 90px -30px rgba(12,28,20,0.4)}
  .ap-glow{position:absolute;left:50%;top:-34px;transform:translateX(-50%);width:88%;height:280px;background:radial-gradient(closest-side,rgba(0,205,119,0.3),rgba(0,205,119,0) 72%);filter:blur(46px);pointer-events:none}
  .ap-pasek{display:flex;align-items:center;gap:14px;padding:11px 18px;background:#fbfcfa;border-bottom:1px solid #eef1ec}
  .ap-kropki{display:flex;gap:6px;flex-shrink:0}
  .ap-kropki span{width:10px;height:10px;border-radius:50%;background:#e3e7e0}
  .ap-url{margin:0 auto;background:#f1f4ee;border-radius:7px;padding:5px 18px;font-family:ui-monospace,Menlo,monospace;font-size:11.5px;color:#7d8a80}
  .ap-ja{display:flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:50%;background:#dcefe2;color:#0a7a52;font-size:10.5px;font-weight:800;flex-shrink:0}
  .ap-cialo{display:grid;grid-template-columns:1fr 186px}
  .ap-glowna{padding:18px 20px 0}
  .ap-tyt{display:flex;align-items:baseline;justify-content:space-between;gap:12px}
  .ap-tyt b{font-size:15px;font-weight:750;letter-spacing:-0.015em;color:#16211a}
  .ap-tyt span{font-family:ui-monospace,Menlo,monospace;font-size:10.5px;color:#a3ada4}
  .ap-tab{margin-top:14px;display:flex;flex-direction:column}
  .ap-tab-h,.ap-w{display:grid;grid-template-columns:minmax(0,1fr) 84px 84px;gap:10px;align-items:center}
  .ap-tab-h{padding-bottom:8px;border-bottom:1px solid #eef1ec;font-family:ui-monospace,Menlo,monospace;font-size:9.5px;letter-spacing:0.11em;text-transform:uppercase;color:#a3ada4}
  .ap-w{padding:9px 0;border-bottom:1px solid #f3f6f1;font-size:12.5px;color:#33413a}
  .ap-w b{display:block;font-family:ui-monospace,Menlo,monospace;font-size:11px;font-weight:600;color:#16211a}
  .ap-w i{display:block;font-style:normal;font-size:11.5px;color:#8b968d;margin-top:2px}
  .ap-w em{font-style:normal;font-family:ui-monospace,Menlo,monospace;font-size:11.5px;color:#33413a}
  .ap-s{justify-self:start;padding:3px 9px;border-radius:20px;font-size:10.5px;font-weight:650;white-space:nowrap}
  .ap-s.o{background:#e6f7ec;color:#0a7a52}
  .ap-s.w{background:#eef2f6;color:#4a5a6b}
  .ap-s.d{background:#fbf1dc;color:#8f6c1c}
  .ap-boczny{border-left:1px solid #eef1ec;background:#fbfcfa;padding:18px 16px}
  .ap-n{font-family:ui-monospace,Menlo,monospace;font-size:9.5px;letter-spacing:0.11em;text-transform:uppercase;color:#8b968d}
  .ap-l{margin-top:14px}
  .ap-l + .ap-l{margin-top:16px;padding-top:16px;border-top:1px solid #eef1ec}
  .ap-l b{display:block;font-size:26px;line-height:1;font-weight:800;letter-spacing:-0.03em;color:#16211a}
  .ap-l.akc b{color:#0a7a52}
  .ap-l span{display:block;margin-top:5px;font-size:11.5px;line-height:1.4;color:#8b968d}
  .ap-karta{position:absolute;z-index:3;display:flex;align-items:center;gap:11px;background:#ffffff;border:1px solid #eef1ec;border-radius:12px;padding:12px 17px;box-shadow:0 18px 44px -16px rgba(12,28,20,0.3);text-align:left;animation:ap-plyw 7s ease-in-out infinite}
  .ap-karta.gora{left:-34px;top:74px}
  .ap-karta.dol{right:-30px;bottom:52px;animation-delay:1.4s}
  .ap-karta i{display:flex;align-items:center;justify-content:center;width:24px;height:24px;border-radius:50%;font-style:normal;font-size:13px;font-weight:800;flex-shrink:0}
  .ap-karta.gora i{background:#e6f7ec;color:#0a7a52}
  .ap-karta.dol i{background:#f9efd8;color:#8f6c1c}
  .ap-karta > span{display:block}
  .ap-karta > span > b{display:block;font-size:13.5px;font-weight:650;color:#16211a}
  .ap-karta > span > span{display:block;margin-top:2px;font-size:11.5px;color:#8b968d}
  @keyframes ap-plyw{0%,100%{transform:translateY(0)}50%{transform:translateY(-9px)}}
  @media (max-width:1240px){ .ap-box{--s:0.86} }
  @media (max-width:900px){ .ap-box{--s:1} }
  @media (max-width:660px){ .ap-box{--s:0.6} }
  @media (max-width:420px){ .ap-box{--s:0.5} }
  @media (prefers-reduced-motion:reduce){ .ap-karta{animation:none} }

  /* ================= pas dowodu ========================================
     Poprawka 3: 1:1 ze strony głównej. Logotypy jadą w pętli i chowają
     się pod napisem po lewej. */
  .tr{position:relative;z-index:2;display:flex;align-items:center;gap:36px;padding:30px max(clamp(20px,5vw,56px),calc((100% - 1440px) / 2));border-top:1px solid #eef1ec;border-bottom:1px solid #eef1ec;background:#ffffff}
  .tr-n{position:relative;z-index:2;background:#ffffff;padding-right:12px;flex-shrink:0;max-width:210px;font-size:14px;line-height:1.45;color:#4c5850}
  .tr-n strong{color:#16211a;font-weight:700}
  .tr-o{overflow:hidden;position:relative;z-index:1;margin-left:-76px;flex:1;filter:grayscale(1);opacity:0.55}
  .tr-t{display:flex;align-items:center;gap:56px;width:max-content;animation:tr-jazda 30s linear infinite}
  .tr-o:hover .tr-t{animation-play-state:paused}
  .tr-t img{width:114px;height:28px;object-fit:contain}
  @keyframes tr-jazda{from{transform:translateX(0)}to{transform:translateX(calc(-50% - 28px))}}
  @media (prefers-reduced-motion:reduce){ .tr-t{animation:none} }
  @media (max-width:820px){
    .tr{flex-wrap:wrap;justify-content:center;text-align:center;gap:18px}
    .tr-n{max-width:none;padding-right:0}
    .tr-o{margin-left:0;overflow:hidden;width:100%;flex:none}
  }

  /* ================= głos klienta ======================================
     Poprawka 3b: jedna twarz i jeden cytat przed sekcją definicyjną.
     Ten sam moduł stoi na /rozwiazania-ai. */
  .gk{display:grid;grid-template-columns:auto minmax(0,1fr);gap:clamp(20px,3vw,34px);align-items:start;max-width:960px;margin:0 auto;padding:clamp(34px,4vw,52px) clamp(28px,3.4vw,44px);border:1px solid #e7ece4;border-radius:22px;background:#ffffff}
  .gk-c{display:block;font-size:58px;line-height:0.6;font-weight:800;color:#cfe3d5;user-select:none}
  .gk blockquote{margin:0;font-size:clamp(19px,2.4vw,27px);line-height:1.36;letter-spacing:-0.02em;font-weight:650;color:#16211a;text-wrap:pretty}
  .gk figcaption{display:flex;align-items:center;gap:12px;margin-top:clamp(20px,2.4vw,26px)}
  .gk figcaption img{width:42px;height:42px;border-radius:50%;object-fit:cover;flex-shrink:0}
  .gk figcaption > span > b{display:block;font-size:14.5px;font-weight:700;color:#16211a}
  .gk figcaption > span > span{display:block;margin-top:1px;font-size:13px;color:#7c877e}
  @media (max-width:620px){ .gk{grid-template-columns:1fr;gap:10px} .gk-c{font-size:44px} }

  /* ================= lupa nad kodem ====================================
     Bez ramki i bez tła: kod jest wygaszony maską u góry i u dołu.
     Poza lupą jest blady, pod lupą ostry. Lupa wędruje po torze liczonym
     w nagłówku pliku i zatrzymuje się na trzech podkreśleniach. */
  .lu-box{position:relative;width:calc(var(--w) * var(--s, 1));height:calc(var(--h) * var(--s, 1))}
  .lu-ram{position:absolute;left:0;top:0;width:var(--w);height:var(--h);transform:scale(var(--s, 1));transform-origin:top left}
  .lu-plot{position:absolute;inset:0;overflow:hidden;-webkit-mask-image:linear-gradient(to bottom,transparent 0,#000 13%,#000 76%,transparent 100%);mask-image:linear-gradient(to bottom,transparent 0,#000 13%,#000 76%,transparent 100%)}
  .lu-strum{position:absolute;left:0;top:var(--gora);width:100%}
  .lu-l{position:relative;display:block;white-space:pre;font-family:ui-monospace,Menlo,monospace;font-size:var(--fs);line-height:var(--wiersz);height:var(--wiersz);color:#c6d1c5;padding-left:var(--lewo)}
  .lu-w{position:absolute;left:var(--lewo);top:0;white-space:pre}
  .lu-m{position:relative;display:inline-block}
  .lu-m u{position:absolute;left:-3px;right:-3px;top:-1px;bottom:-1px;border-radius:4px;background:rgba(0,0,0,0)}
  .lu-m i{position:absolute;left:-2px;right:-2px;bottom:-3px;height:2.5px;border-radius:2px;opacity:0}
  .lu-m em{position:relative;font-style:normal}
  .lu-lupa{position:absolute;left:0;top:0;width:calc(var(--r) * 2);height:calc(var(--r) * 2)}
  .lu-kolo{position:absolute;inset:0;border-radius:50%;overflow:hidden;background:#ffffff;box-shadow:0 22px 44px -20px rgba(18,38,28,0.45), 0 0 0 1.5px #16211a, inset 0 0 0 5px rgba(255,255,255,0.92)}
  .lu-zoom{position:absolute;left:0;top:0;width:var(--w);height:var(--h);transform-origin:0 0}
  .lu-zoom .lu-l{color:#16211a}
  .lu-blysk{position:absolute;inset:0;border-radius:50%;pointer-events:none;background:radial-gradient(120% 120% at 30% 22%, rgba(255,255,255,0.6), rgba(255,255,255,0) 46%), radial-gradient(90% 90% at 76% 84%, rgba(22,33,26,0.09), rgba(255,255,255,0) 55%)}
  .lu-uchwyt{position:absolute;left:calc(var(--r) * 1.66);top:calc(var(--r) * 1.66);width:58px;height:10px;border-radius:6px;background:#16211a;transform:rotate(42deg);transform-origin:0 50%}
  @media (max-width:1240px){ .lu-box{--s:0.88} }
  @media (max-width:900px){ .lu-box{--s:1} }
  @media (max-width:660px){ .lu-box{--s:0.62} }
  @media (max-width:420px){ .lu-box{--s:0.54} }
  @media (prefers-reduced-motion:reduce){
    /* Bez ruchu: lupa stoi na drugim podkreśleniu, wszystkie na zielono. */
    .lu-strum{animation:none !important;transform:translateY(var(--stop))}
    .lu-lupa{animation:none !important;left:var(--sl);top:var(--st)}
    .lu-zoom{animation:none !important;transform:var(--sk)}
    .lu-m i{animation:none !important;opacity:1;background:#00CD77}
    .lu-m u{animation:none !important;background:rgba(0,205,119,0.14)}
    .lu-w.p{animation:none !important;opacity:0}
    .lu-w.o{animation:none !important;opacity:1}
  }

  /* ================= przepływ: Ty → my → ludzie ========================
     Każdy przystanek siedzi w swojej kolumnie, więc kropka stoi dokładnie
     nad swoim podpisem. Odstęp siatki jest stałą (--g), bo z niej liczą
     się klatki jadącej kropki. */
  .fl{--g:34px;position:relative;margin-top:clamp(52px,6vw,84px)}
  .fl-t{position:absolute;left:6px;right:6px;top:5px;height:2px;background:#e2e9e0;border-radius:2px;overflow:hidden}
  .fl-f{position:absolute;left:0;top:0;bottom:0;width:0;background:linear-gradient(90deg,rgba(0,205,119,0.35),var(--la-accent,#00CD77));border-radius:2px}
