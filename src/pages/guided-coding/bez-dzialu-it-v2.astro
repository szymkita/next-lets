// zanim przeczyta zdanie. Tutaj jest ten sam gatunek rysunku: aplikacja,
// którą klient zbudował, plus prawy pasek z rachunkiem miesiąca.
//
// Rysunek niesie liczbę, której nie ma w tekście obok: 55 nowych wersji
// na 4 nasze poprawki. To jest proporcja, po której widać, że opieka
// robi się rzadsza — teza całej strony, pokazana zamiast wypowiedzianej.
const PANEL = {
