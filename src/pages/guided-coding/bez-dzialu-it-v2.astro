  poprawek: 4,
  zasad: 3,
};

const ZAMOWIENIA = [
  { nr: 'ZAM/09/412', kto: 'Sevium', kwota: '18 240 zł', stan: 'w realizacji', s: 'w' },
  { nr: 'ZAM/09/411', kto: 'ODO 24', kwota: '4 900 zł', stan: 'do wysyłki', s: 'd' },
  { nr: 'ZAM/09/410', kto: 'X3D', kwota: '31 600 zł', stan: 'opłacone', s: 'o' },
