<script>
  // ---- Co znajdujemy: krok w środku ekranu ustawia parę paneli ----
  // Jak „Jedna sprawa” na /lets-shift. Na telefonie (do 900 px) panele
  // stoją przy swoim kroku, pod jego tekstem; na szerokim ekranie wracają
  // do przyklejonego rysunku.
  (function(){
    var sek = document.querySelector('.a5-z') as HTMLElement | null;
    var wiz = document.querySelector('[data-a5z]') as HTMLElement | null;
    if(!sek || !wiz) return;
    var st = wiz.querySelector('.a5z-st') as HTMLElement;
    var kroki = Array.prototype.slice.call(sek.querySelectorAll('[data-a5z-k]')) as HTMLElement[];
    var panele = Array.prototype.slice.call(st.querySelectorAll('.a5z-s')) as HTMLElement[];
    var mq = window.matchMedia('(max-width:900px)');
    function ustaw(k: number){
      wiz!.dataset.krok = String(k);
      kroki.forEach(function(x, j){ x.classList.toggle('on', j === k); });
    }
    if('IntersectionObserver' in window){
      var io = new IntersectionObserver(function(w){
        w.forEach(function(e){ if(e.isIntersecting) ustaw(Number((e.target as HTMLElement).dataset.a5zK)); });
      }, { rootMargin: '-45% 0px -45% 0px' });
      kroki.forEach(function(k){ io.observe(k); });
    }
    function uloz(){
      sek!.classList.toggle('a5z-mob', mq.matches);
      panele.forEach(function(el, i){
        var krok = kroki[i];
        var tekst = krok.firstElementChild as HTMLElement;
        if(mq.matches){
          krok.after(el);
          var cta = tekst.querySelector('.u6-mc');
          if(cta) el.after(cta);
        } else {
          var c2 = el.nextElementSibling;
          st.appendChild(el);
          if(c2 && c2.classList.contains('u6-mc')) tekst.appendChild(c2);
        }
      });
    }
    uloz();
    mq.addEventListener('change', uloz);
  })();
</script>
</LaBase>
