};

// polska odmiana: 1 / 2–4 / 5+
const odm = (n, jeden, kilka, wiele) => (n === 1 ? jeden : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? kilka : wiele);
const godzin = (h) => `${h} ${odm(h, 'godzina', 'godziny', 'godzin')}`;

// =====================================================================
// RAPORT PANELU ZAMÓWIEŃ · siedem pozycji (PRZYKŁADOWE)
// n = miejsce w raporcie, g = grupa, dz = dzień znalezienia (0 = pn),
// h = czas poprawki w godzinach (do sum i do macierzy), kto: w = Wy,
// z instrukcją; r = razem przy ekranie; rw = razem, potem Wy.
// notka = jak rzecz stoi w notatkach z danego dnia; k = krótka nazwa
// (macierz na wąskim ekranie); dy/lab = położenie w macierzy.
// =====================================================================
const POZ = [
  { n: 1, g: 0, dz: 1, h: 1, czas: 'godzina', kto: 'w', k: 'dziennik', mx: 'Dane w dzienniku',
    t: 'Dane klientów trafiają do dziennika zdarzeń', d: 'NIP-y i telefony leżą w logach, których nikt nie czyści.',
    notka: 'NIP-y i telefony lecą do dziennika zdarzeń' },
  { n: 2, g: 0, dz: 0, h: 2, czas: '2 godziny', kto: 'w', k: 'hasło', mx: 'Hasło w kodzie',
    t: 'Hasło do poczty wpisane w kod', d: 'Kto zobaczy kod, wyśle maile w imieniu firmy.',
    notka: 'hasło do poczty wprost w kodzie' },
  { n: 3, g: 0, dz: 2, h: 4, czas: 'pół dnia', kto: 'r', k: 'kopia', mx: 'Powrót z kopii',
    t: 'Nikt nie sprawdził powrotu z kopii', d: 'Kopia powstaje co noc. Nie wiadomo, czy da się z niej wrócić.',
    notka: 'kopia co noc, nikt z niej nie wracał' },
  { n: 4, g: 1, dz: 1, h: 8, czas: 'dzień', kto: 'w', k: 'eksport', mx: 'Eksport', dy: 12, lab: 'g',
    t: 'Eksport stanie przy większym ruchu', d: 'Dziś 3 000 zamówień. Przy 40 000 panel stanie dla wszystkich.',
    notka: 'eksport bierze wszystkie zamówienia naraz' },
  { n: 5, g: 1, dz: 3, h: 12, czas: 'półtora dnia', kto: 'rw', k: 'testy', mx: 'Test zamówienia', dy: -8,
    t: 'Ścieżka zamówienia nie ma żadnego testu', d: 'Błąd w zamówieniu zgłosi dopiero klient.',
    notka: 'zero testów na ścieżce zamówienia' },
  { n: 6, g: 2, dz: 4, h: 1, czas: 'godzina', kto: 'w', k: 'usługi', mx: 'Usługi po próbach',
    t: 'Płatne usługi zostały po próbach', d: 'Dwie usługi z nieudanych prób dalej są na rachunku.',
    notka: 'dwie usługi po próbach dalej płatne' },
  { n: 7, g: 2, dz: 0, h: 8, czas: 'dwa popołudnia', kto: 'r', k: 'autor', mx: 'Uruchamia tylko autor',
    t: 'Projekt od zera uruchamia tylko autor', d: 'Bez niego nikt nie postawi aplikacji na nowo.',
    notka: 'projekt od zera stawia tylko autor' },
];
const KTO = { w: 'Wy, z instrukcją', r: 'razem przy ekranie', rw: 'razem, potem Wy' };
const GRUPY = [
  { t: 'Najpierw, w tym tygodniu', s: 'Wyciek albo utrata danych klientów' },
  { t: 'W pierwszym miesiącu', s: 'Staje praca działu albo zamówienia' },
  { t: 'Może poczekać', s: 'Kosztuje albo spowalnia' },
].map((g, i) => ({ ...g, i, h: POZ.filter((x) => x.g === i).reduce((a, x) => a + x.h, 0), poz: POZ.filter((x) => x.g === i) }));
const SAMI = POZ.filter((x) => x.kto === 'w');                    // 1, 2, 4, 6
const RAZEM = POZ.filter((x) => x.kto !== 'w');                   // 3, 5, 7
const NAJPIERW_H = GRUPY[0].h;                                    // 7
const DNI = [
  { dz: 'pn', data: '5.10' },
  { dz: 'wt', data: '6.10' },
  { dz: 'śr', data: '7.10' },
  { dz: 'cz', data: '8.10' },
  { dz: 'pt', data: '9.10' },
];
// Kolejność notatek w ciągu dnia: pierwszego dnia najpierw uruchomienie projektu.
const NOTATKI = [[7, 2], [4, 1], [3], [5], [6]].map((dzien) => dzien.map((n) => POZ.find((x) => x.n === n)));
const PROWADZACY = { foto: '/team/marcel-bilski.png', imie: 'Marcel Bilski' };
const AU_ARIA = `Raport z pięciodniowego audytu panelu zamówień, który zbudował dział operacji. Po lewej notatki z kolejnych dni, w kolejności znalezienia, po prawej raport, w którym te same rzeczy stoją w kolejności poprawek. ${GRUPY.map((g) => `${g.t}: ${g.poz.map((x) => `${x.n}. ${x.t.toLowerCase()}, ${x.czas}, ${KTO[x.kto]}`).join('; ')}`).join('. ')}. ${SAMI.length} z ${POZ.length} poprawek zespół zrobi sam, z instrukcją. Audyt prowadził ${PROWADZACY.imie}.`;

// =====================================================================
// DLACZEGO 1 · wydruk eksport.ts z uwagami
// Kod PRZYKŁADOWY. Zaznaczone miejsca: wiersz 7 (poz. 2), klamra 12–15
// (poz. 4), wiersz 17 (poz. 1) — numery liczą się z tablicy (wiersz()).
// Wiersze są szerokie na swoją treść, więc klamra stoi tuż za wierszem 12.
// t = sekunda, w której pojawia się znak.
// =====================================================================
const KOD = [
  { s: "import { baza } from '../baza';" },
  { s: "import { wyslij } from '../poczta';" },
  { s: "import { doCSV } from '../pliki';" },
  { s: '' },
  { s: 'const POCZTA = {' },
  { s: "  login: 'zamowienia'," },
  { a: '  haslo: ', m: "'Wiosna2026!'", b: ',', z: 2 },
  { s: '};' },
  { s: '' },
  { s: '// eksport zamówień dla księgowości' },
  { s: 'export async function eksport(od: Date) {' },
  { s: '  const lista = await baza.zamowienie.findMany({', kl: 4, z: 4 },
  { s: '    where: { utworzone: { gte: od } },' },
  { s: '    include: { klient: true },' },
  { s: '  });' },
  { s: '' },
  { a: "  console.log('eksport', ", m: 'lista', b: ');', z: 1 },
  { s: '' },
  { s: "  const plik = doCSV(lista, ['nr', 'nip', 'kwota']);" },
  { s: "  await wyslij(POCZTA, 'ksiegowosc@firma.pl', plik);" },
  { s: '  return lista.length;' },
  { s: '}' },
];
const WK_T = { 2: 0.4, 4: 1.9, 1: 3.4 };
const wiersz = (z) => KOD.findIndex((w) => w.z === z);       // indeks od zera
const WK_UWAGI = [
  { z: 2, t: 'Hasło do poczty zapisane w kodzie. Kto zobaczy kod, wyśle maile w imieniu firmy.' },
  { z: 4, t: 'Bierze wszystkie zamówienia naraz. Przy 3 000 działa, przy 40 000 panel stanie.' },
  { z: 1, t: 'Cała lista z NIP-ami i telefonami klientów ląduje w dzienniku zdarzeń.' },
].map((u) => ({ ...u, l: wiersz(u.z) }));
const W1 = wiersz(1) + 1;                                       // wiersz z pozycją 1 (strona raportu)
const WK_POZA = [
  { n: 3, t: 'nikt nie próbował wrócić z kopii' },
  { n: 5, t: 'ścieżka zamówienia bez testu' },
  { n: 6, t: 'płatne usługi po próbach' },
  { n: 7, t: 'od zera uruchamia tylko autor' },
].map((x, i) => ({ ...x, g: POZ.find((p) => p.n === x.n).g, t0: 5 + i * 0.18 }));
const W_KODZIE = POZ.length - WK_POZA.length;                     // 3
// Prosty podział na słowa kluczowe, napisy i komentarze — tylko do kolorów.
const tokeny = (s) => {
  const out = [];
  const re = /(\/\/.*$|'[^']*'|\b(?:import|from|const|export|async|function|await|return|true)\b)/g;
  let i = 0, m;
  while ((m = re.exec(s))) {
    if (m.index > i) out.push({ c: '', t: s.slice(i, m.index) });
    out.push({ c: m[0][0] === "'" ? 's' : m[0][0] === '/' ? 'c' : 'k', t: m[0] });
    i = m.index + m[0].length;
  }
  if (i < s.length) out.push({ c: '', t: s.slice(i) });
  return out;
};
const WK_ARIA = `Wydruk pliku eksport.ts z uwagami czerwonym długopisem. W wierszu ${wiersz(2) + 1} hasło do poczty wpisane wprost w kod: pozycja 2 raportu. Klamra przy wierszach ${wiersz(4) + 1}–${wiersz(4) + 4}: zapytanie pobiera wszystkie zamówienia naraz, pozycja 4. W wierszu ${W1} cała lista zamówień z danymi klientów trafia do dziennika zdarzeń, pozycja 1. Pod kodem cztery pozycje, których w tym pliku nie widać: ${WK_POZA.map((x) => `${x.n}, ${x.t}`).join('; ')}.`;

// =====================================================================
// DLACZEGO 2 · macierz kolejności
// x = czas poprawki na skali logarytmicznej (godzina → dwa dni), pasy =
// skutek (te same trzy grupy co w raporcie). Długopis obchodzi pozycje
// w kolejności raportu: jedna pozycja na sekundę.
// =====================================================================
const MX_X = (h) => +(6 + (Math.log2(h) / 4) * 88).toFixed(2);
const MX_OS = [['godzina', 1], ['2 godziny', 2], ['pół dnia', 4], ['dzień', 8], ['dwa dni', 16]].map(([t, h]) => ({ t, x: MX_X(h) }));
const MX_KR = { 'godzina': 'godz.', '2 godziny': '2 godz.', 'pół dnia': 'pół dnia', 'dzień': 'dzień', 'dwa dni': '2 dni' };
const MX_YB = ['16.667%', '50%', '83.333%'];
const MX_P = POZ.map((x, k) => ({
  ...x,
  x: MX_X(x.h),
  yb: MX_YB[x.g],
  dy: x.dy || 0,
  lw: x.lab === 'g',                  // podpis nad punktem
  t0: +(0.7 + k * 1.0).toFixed(2),    // sekunda, w której długopis dochodzi do punktu
}));
const MX_T = 8.6;
const mxk = (t) => `${((t / MX_T) * 100).toFixed(2)}%`;
const mxPoz = (p) => `left:${p.x}%;top:calc(${p.yb} + var(--off) + ${p.dy}px)`;
const MX_KLATKI = (() => {
  const f = [`0%{opacity:0;${mxPoz(MX_P[0])}}`, `${mxk(MX_P[0].t0 - 0.35)}{opacity:0;${mxPoz(MX_P[0])};transform:scale(1.5)}`];
  MX_P.forEach((p) => {
    f.push(`${mxk(p.t0)}{opacity:1;${mxPoz(p)};transform:none;animation-timing-function:linear}`);
    f.push(`${mxk(p.t0 + 0.38)}{opacity:1;${mxPoz(p)};transform:none;animation-timing-function:cubic-bezier(.55,0,.3,1)}`);
  });
  const o = MX_P[MX_P.length - 1];
  f.push(`${mxk(o.t0 + 0.9)}{opacity:0;${mxPoz(o)};transform:scale(1.4)}`, `100%{opacity:0;${mxPoz(o)}}`);
  return `@keyframes mx-pen{${f.join('')}}\n.mx.gra.on .mx-pen{animation:mx-pen ${MX_T}s both}`;
})();
// Podpis grupy pojawia się, gdy długopis skończy jej ostatnią pozycję.
const MX_G = GRUPY.map((g) => ({ ...g, t0: +(MX_P.filter((p) => p.g === g.i).slice(-1)[0].t0 + 0.4).toFixed(2) }));
const MX_ARIA = `Siedem pozycji raportu według skutku i czasu poprawki. ${MX_G.map((g) => `${g.s}, w raporcie „${g.t.toLowerCase()}”: ${g.poz.map((x) => `${x.n}. ${x.mx.toLowerCase()}, ${x.czas}`).join('; ')}`).join('. ')}. Najpierw idą pozycje z górnego pasa i w nim od najkrótszej poprawki; usługi po próbach poprawia się w godzinę, a stoją na szóstym miejscu.`;

// =====================================================================
// SCENA · trzy strony raportu (PRZYKŁADOWE liczby w „Co przejrzeliśmy")
