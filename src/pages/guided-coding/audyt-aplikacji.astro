const faq = [
  { q: 'Czy na koniec zaproponujecie nam duży projekt?',
    a: 'Raport kończy się listą poprawek, w której najwięcej jest takich do zrobienia samodzielnie, z instrukcją. Jeśli przy czymś naszym zdaniem warto pomóc, powiemy to i uzasadnimy. Wycenę dostaniecie tylko wtedy, gdy o nią poprosicie.' },
