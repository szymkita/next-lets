<script>
  var redukcja = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var maIO = 'IntersectionObserver' in window;
  function czekaj(ms){ return new Promise(function(r){ setTimeout(r, ms); }); }
  function obserwuj(el, prog, cb){ var io = new IntersectionObserver(function(w){ cb(w[0].isIntersecting); }, { threshold: prog }); io.observe(el); return io; }

  // ---- Hero: notatki z pięciu dni układają się w raport (pętla) ----
  // Dzień po dniu pojawiają się notatki; każda przelatuje na swoje miejsce
  // w raporcie (przesunięcie i skala liczone z położenia notatki — FLIP),
  // potem dostaje numer. Na końcu grupy dostają sumy, a raport podpis.
  // Gdy notatnik jest schowany (wąski ekran), pozycje tylko się pojawiają.
  // Pętla stoi, kiedy rysunku nie widać.
  (function(){
    var fig = document.querySelector('[data-au]');
    if(!fig || redukcja || !maIO) return;
    var dni = Array.prototype.slice.call(fig.querySelectorAll('[data-au-dz]'));
    var notki = Array.prototype.slice.call(fig.querySelectorAll('[data-au-n]'));
    var sloty = {};
    Array.prototype.forEach.call(fig.querySelectorAll('[data-au-slot]'), function(s){ sloty[s.getAttribute('data-au-slot')] = s; });
    var notatnik = fig.querySelector('[data-au-not]');
    var st = fig.querySelector('[data-au-st]'), stT = fig.querySelector('[data-au-st-t]');
    var widoczny = false;
    obserwuj(fig, 0.2, function(v){ widoczny = v; });
    async function krok(ms){ await czekaj(ms); while(!widoczny) await czekaj(300); }
    function stan(s, t){ st.setAttribute('data-s', s); stT.textContent = t; }
    function zeruj(){
      dni.forEach(function(d){ d.classList.remove('on'); });
      notki.forEach(function(n){ n.classList.remove('on', 'num'); });
      Object.keys(sloty).forEach(function(k){ var p = sloty[k].firstElementChild; sloty[k].classList.remove('on'); p.classList.remove('leci'); p.style.transition = ''; p.style.transform = ''; });
      fig.classList.remove('kon');
      stan('tok', 'Dzień 1 z 5');
    }
    function lec(n){
      var s = sloty[n.getAttribute('data-au-n')], p = s.firstElementChild;
      if(getComputedStyle(notatnik).display === 'none'){ s.classList.add('on'); return; }
      var a = n.getBoundingClientRect(), b = p.getBoundingClientRect();
      var k = Math.min(1, a.width / b.width);
      p.style.transition = 'none';
      p.style.transformOrigin = '0 0';
      p.style.transform = 'translate(' + (a.left - b.left) + 'px,' + (a.top - b.top) + 'px) scale(' + k + ')';
      p.classList.add('leci');
      s.classList.add('on');
      void p.offsetWidth;
      p.style.transition = 'transform .8s cubic-bezier(.6,0,.2,1)';
      p.style.transform = '';
      setTimeout(function(){ p.classList.remove('leci'); }, 820);
    }
    zeruj();
    fig.classList.add('ruch');
    (async function(){
      for(;;){
        await krok(900);
        for(var d = 0; d < dni.length; d++){
          dni[d].classList.add('on');
          stan('tok', 'Dzień ' + (d + 1) + ' z 5');
          var dzis = notki.filter(function(n){ return +n.getAttribute('data-au-d') === d; });
          await krok(450);
          for(var j = 0; j < dzis.length; j++){
            dzis[j].classList.add('on');
            await krok(650);
            lec(dzis[j]);
            await krok(850);
            dzis[j].classList.add('num');
          }
          await krok(300);
        }
        await krok(400);
        fig.classList.add('kon');
        stan('ok', 'Gotowy · pt 9.10');
        await krok(6500);
        fig.classList.add('wyg'); await krok(480); zeruj(); fig.classList.remove('wyg');
      }
    })();
  })();

  // ---- „Jeszcze raz" w rysunkach odsłanianych raz (wydruk, macierz) ----
  // Gasi przejścia (.bez), zdejmuje .on i zakłada je z powrotem.
  (function(){
    document.querySelectorAll('[data-znow]').forEach(function(b){
      var fig = b.closest('[data-znow-cel]');
      if(!fig) return;
      b.addEventListener('click', function(){
        fig.classList.add('bez'); fig.classList.remove('on');
        void fig.offsetWidth;
        fig.classList.remove('bez');
        requestAnimationFrame(function(){ requestAnimationFrame(function(){ fig.classList.add('on'); }); });
      });
    });
  })();

  // ---- Zakładki „Raport, z którym zostajecie" ----
  (function(){
    var zak = Array.prototype.slice.call(document.querySelectorAll('[data-zak]'));
    if(!zak.length) return;
    var widoki = document.querySelectorAll('[data-widok]');
    var podpisy = document.querySelectorAll('[data-podpis]');
    function pokaz(i, fokus){
      zak.forEach(function(b, j){ b.setAttribute('aria-selected', i === j ? 'true' : 'false'); b.tabIndex = i === j ? 0 : -1; });
      widoki.forEach(function(v, j){ v.hidden = i !== j; });
      podpisy.forEach(function(p, j){ p.hidden = i !== j; });
      if(fokus) zak[i].focus();
    }
    zak.forEach(function(b, i){
      b.addEventListener('click', function(){ pokaz(i); });
      b.addEventListener('keydown', function(e){
        if(e.key === 'ArrowRight'){ e.preventDefault(); pokaz((i + 1) % zak.length, true); }
        if(e.key === 'ArrowLeft'){ e.preventDefault(); pokaz((i - 1 + zak.length) % zak.length, true); }
      });
    });
  })();
</script>
</LaBase>
