const title = "Audyt aplikacji zbudowanej z AI — co grozi awarią i co poprawić najpierw | Let's automate";
const description = 'Audyt aplikacji zbudowanej w Claude Code albo w Codexie: kod, dane klientów, dostępy, kopie i rachunki. Raport ustawia poprawki w kolejności i przy każdej mówi, ile zajmie i kto ją zrobi.';

// Heroicons Micro (16 × 16, solid), których nie ma w ikony.ts — tylko tutaj.
const IK = {
  ...HI,
  'document-check': '<path fill-rule="evenodd" d="M4 2a1.5 1.5 0 0 0-1.5 1.5v9A1.5 1.5 0 0 0 4 14h8a1.5 1.5 0 0 0 1.5-1.5V6.621a1.5 1.5 0 0 0-.44-1.06L9.94 2.439A1.5 1.5 0 0 0 8.878 2H4Zm6.713 4.16a.75.75 0 0 1 .127 1.053l-2.75 3.5a.75.75 0 0 1-1.078.106l-1.75-1.5a.75.75 0 1 1 .976-1.138l1.156.99L9.66 6.287a.75.75 0 0 1 1.053-.127Z" clip-rule="evenodd"/>',
