const dane = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${kanon}#usluga`,
      name: 'Audyt aplikacji zbudowanej z AI',
      alternateName: ['Audyt aplikacji', 'Przegląd aplikacji zbudowanej w Claude Code', 'Audyt kodu tworzonego z AI'],
      serviceType: 'Audyt aplikacji i kodu tworzonego z AI',
      url: kanon,
      description: 'Audyt aplikacji to przegląd aplikacji zbudowanej z AI (Claude Code, Codex), zakończony raportem z kolejnością poprawek: najpierw to, co grozi awarią albo wyciekiem danych klientów. Przy każdej pozycji raport podaje czas poprawki i to, kto ją wykona. W zespole bez działu IT audyt trwa pięć dni, w dziale IT pracującym z agentami dwa tygodnie.',
      provider: { '@id': new URL('/#organizacja', Astro.site).href },
      areaServed: { '@type': 'Country', name: 'Polska' },
      audience: { '@type': 'BusinessAudience', name: 'Firmy, które budują własne aplikacje z AI' },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${kanon}#okruszki`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Strona główna', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: 'Guided coding', item: new URL('/guided-coding', Astro.site).href },
        { '@type': 'ListItem', position: 3, name: 'Audyt aplikacji', item: kanon },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${kanon}#faq`,
      mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
---
<LaBase topbar={false} title={title} description={description} ctaLabel="Umów rozmowę" nav="uslugi">
<script type="application/ld+json" is:inline set:html={JSON.stringify(dane)} slot="head"></script>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap" slot="head">
<style is:global slot="head">
  /* Style rysunków tej usługi. Wspólny wygląd: src/components/usluga/Styl.astro.
     Każdy rysunek ma stan końcowy w markupie; stany pośrednie chowają się
     tylko pod .ruch (hero, skrypt) albo .gra (Anim). */
  .v3{--g0:#c0492f;--g1:#5d6b62;--g2:#b3bab5;--pen:#c43d2a}
  .v3 .gk0{--gc:var(--g0)}
  .v3 .gk1{--gc:var(--g1)}
  .v3 .gk2{--gc:var(--g2)}
  /* numer pozycji w kółku w kolorze grupy (wszędzie ten sam) */
  .v3 .nr{display:inline-grid;place-items:center;flex-shrink:0;width:20px;height:20px;border-radius:50%;background:var(--gc);font-style:normal;font-size:10.5px;font-weight:700;line-height:1;color:#ffffff;font-variant-numeric:tabular-nums}
  .v3 .gk2 .nr,.v3 .nr.gk2{color:var(--t1)}

  /* =====================================================================
     HERO · notatnik z pięciu dni i raport na kartce
     Notatki stoją w kolejności znalezienia, raport w kolejności poprawek.
     Ruch (.ruch): dzień po dniu pojawiają się notatki, każda przelatuje na
     swoje miejsce w raporcie, na końcu grupy dostają sumy.
     ===================================================================== */
  .au{--t1:#18181b;--t2:#52525b;--t3:#71717a;--t4:#a1a1aa;--lin:rgba(9,9,11,0.08);--lin2:rgba(9,9,11,0.055);
    position:relative;margin:0;container-type:inline-size;font-size:12.5px;line-height:1.42;color:var(--t1);letter-spacing:-0.003em;-webkit-font-smoothing:antialiased}
  .au .hi{display:block;flex-shrink:0;width:16px;height:16px;fill:currentColor}
  .au-uk{display:grid;grid-template-columns:158px minmax(0,1fr);gap:18px;align-items:start;transition:opacity .45s}
  /* notatnik */
  .au-not{position:relative;margin-top:34px;padding:30px 12px 12px 14px;border-radius:3px 3px 6px 6px;background:#fffdf6;
    box-shadow:0 0 0 1px rgba(70,56,20,0.08),0 2px 3px rgba(70,56,20,0.05),0 22px 34px -20px rgba(50,40,12,0.38);transform:rotate(-1.6deg);transform-origin:100% 0}
  .au-not::before{content:"";position:absolute;left:11px;right:11px;top:10px;height:10px;background:radial-gradient(circle,#2c3530 2.3px,rgba(44,53,48,0) 2.8px) 0 0/12px 10px repeat-x}
  .au-not-gl b{display:block;font-size:12px;font-weight:700;letter-spacing:-0.01em}
  .au-not-gl span{display:block;font-size:11px;color:var(--t3)}
  .au-dz{margin-top:9px}
  .au-dz-n{display:block;padding-bottom:3px;border-bottom:1px solid rgba(70,56,20,0.13);font-size:11px;font-weight:650;color:var(--t2);transition:opacity .3s}
  .au-dz-n em{font-style:normal;font-weight:500;color:var(--t3)}
  .au-dz ul{margin:0;padding:0;list-style:none}
  .au-dz li{display:grid;grid-template-columns:minmax(0,1fr) 16px;gap:6px;align-items:start;padding:5px 0 4px;font-size:11.5px;line-height:1.32;color:#3d3c35;transition:opacity .35s,transform .4s}
  .au-dz li + li{border-top:1px dashed rgba(70,56,20,0.14)}
  .au-dz li .nr{width:16px;height:16px;font-size:9.5px;transition:opacity .3s,transform .4s cubic-bezier(.3,1.6,.5,1)}
  /* raport: kartka z drugą pod spodem */
  .au-rap{position:relative;z-index:1;min-width:0;container-type:inline-size}
  .au-rap::before{content:"";position:absolute;inset:0;z-index:-1;border-radius:6px;background:#fbfbf8;box-shadow:0 0 0 1px rgba(9,9,11,0.06),0 14px 30px -18px rgba(15,26,20,0.3);transform:translate(8px,9px) rotate(1.3deg)}
  .au-kartka{position:relative;padding:16px 18px 14px;border-radius:6px;background:#ffffff;box-shadow:0 0 0 1px rgba(9,9,11,0.06),0 1px 2px rgba(9,9,11,0.05),0 34px 64px -34px rgba(15,26,20,0.45)}
  .au-gl{display:flex;align-items:center;gap:10px;padding-bottom:12px;border-bottom:1px solid var(--lin)}
  .au-zn{display:grid;place-items:center;flex-shrink:0;width:28px;height:28px;border-radius:8px;background:#0f1a14}
  .au-zn svg{display:block;width:14px;height:14px;fill:#00cd77}
  .au-gl > span:nth-child(2){min-width:0}
  .au-gl strong{display:block;font-size:14px;font-weight:700;letter-spacing:-0.015em}
  .au-gl em{display:block;font-style:normal;font-size:11.5px;color:var(--t3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .au-st{display:inline-flex;align-items:center;gap:6px;flex-shrink:0;margin-left:auto;height:24px;padding:0 10px 0 8px;border-radius:999px;background:rgba(16,185,129,0.1);color:#047857;font-size:11px;font-weight:650;white-space:nowrap;transition:background .3s,color .3s}
  .au-st i{display:block;width:6px;height:6px;border-radius:50%;background:currentColor}
  .au-st[data-s="tok"]{background:rgba(9,9,11,0.05);color:var(--t2)}
  .au-st[data-s="tok"] i{animation:au-puls 1s ease-in-out infinite}
  @keyframes au-puls{50%{opacity:0.25}}
  .au-gr{margin-top:9px}
  .au-gr-gl{display:flex;align-items:center;gap:7px;padding:4px 0 6px;font-size:11.5px;font-weight:650;color:var(--t2)}
  .au-gr-gl > i{display:block;width:8px;height:8px;border-radius:50%;background:var(--gc)}
  .au-gr-gl > span{margin-left:auto;font-weight:500;color:var(--t3);white-space:nowrap;transition:opacity .4s}
  .au-slot{position:relative;border-top:1px solid var(--lin2)}
  .au-poz{position:relative;display:grid;grid-template-columns:20px minmax(0,1fr) auto;gap:12px;align-items:center;padding:7px 0 7px 1px;border-radius:6px;background:#ffffff;transition:opacity .3s}
  .au-pr{display:flex;flex-direction:column;align-items:flex-end;gap:4px}
  .au-poz b{display:block;font-size:12.5px;font-weight:600;letter-spacing:-0.01em;line-height:1.3}
  .au-poz p{margin:1px 0 0;font-size:11.5px;line-height:1.35;color:var(--t2)}
  .au-czas{font-size:11.5px;color:var(--t2);white-space:nowrap}
  .au-kto{padding:3px 8px;border-radius:999px;background:rgba(16,185,129,0.1);color:#047857;font-size:11px;font-weight:600;white-space:nowrap}
  .au-kto.r,.au-kto.rw{background:rgba(15,26,20,0.06);color:#3b4740}
  .au-dol{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px 16px;margin-top:9px;padding-top:11px;border-top:1px solid var(--lin);font-size:11.5px;color:var(--t2);transition:opacity .4s}
  .au-dol b{font-weight:650;color:var(--t1)}
  .au-pod{display:flex;align-items:center;gap:8px}
  .au-pod img{display:block;width:24px;height:24px;border-radius:50%;object-fit:cover;filter:grayscale(1);outline:1px solid rgba(0,0,0,0.06);outline-offset:-1px}
  /* stany pośrednie — tylko w ruchu */
  .au.ruch .au-dz:not(.on) .au-dz-n{opacity:0.35}
  .au.ruch .au-dz li:not(.on){opacity:0;transform:translateY(5px)}
  .au.ruch .au-dz li:not(.num) .nr{opacity:0;transform:scale(0.3)}
  .au.ruch .au-slot:not(.on) .au-poz{opacity:0}
  .au.ruch .au-slot:not(.on)::before{content:"";position:absolute;inset:5px 0;border-radius:6px;border:1px dashed rgba(9,9,11,0.13)}
  .au.ruch .au-slot:not(.on)::after{content:attr(data-au-slot);position:absolute;left:1px;top:50%;display:grid;place-items:center;width:20px;height:20px;margin-top:-10px;border-radius:50%;box-shadow:inset 0 0 0 1px rgba(9,9,11,0.18);font-size:10.5px;font-weight:650;color:var(--t4)}
  .au.ruch:not(.kon) .au-gr-gl > span,.au.ruch:not(.kon) .au-dol{opacity:0}
  .au.ruch.wyg .au-uk{opacity:0.3}
  .au-poz.leci{z-index:5;box-shadow:0 16px 30px -12px rgba(15,26,20,0.4),0 0 0 1px rgba(9,9,11,0.06)}
  /* węższe: notatnik znika (raport pojawia się wtedy bez lotu) */
  @container (max-width:560px){
    .au-uk{grid-template-columns:minmax(0,1fr)}
    .au-not{display:none}
  }
  @container (max-width:470px){
    .au-kartka{padding:14px 14px 12px}
    .au-poz{grid-template-columns:20px minmax(0,1fr);row-gap:5px;align-items:start}
    .au-poz p{display:none}
    .au-pr{grid-column:2;flex-direction:row;align-items:center;gap:8px}
    .au-st{display:none}
  }

  /* =====================================================================
     DLACZEGO 1 · wydruk eksport.ts z uwagami czerwonym długopisem
     Kółka i klamra odsłaniają się jak pociągnięcie długopisem (clip-path),
     potem numer i uwaga na marginesie. Raz, przy wejściu w kadr.
     ===================================================================== */
  .wk-ark{position:relative;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,310px);max-width:1120px;margin:0 auto;border-radius:6px;background:#ffffff;
    box-shadow:0 0 0 1px rgba(15,26,20,0.06),0 2px 4px rgba(15,26,20,0.04),0 34px 56px -36px rgba(15,26,20,0.45)}
  .wk-gl{grid-column:1 / -1;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:6px 16px;padding:13px 22px;border-bottom:1px solid rgba(15,26,20,0.08);font-family:var(--mono);font-size:11.5px;color:var(--t3)}
  .wk-gl b{font-weight:600;color:var(--t1)}
  .wk{--lh:26px}
  .wk-kod{min-width:0;padding:14px 0 18px;overflow-x:auto;font-family:var(--mono);font-size:13px;line-height:var(--lh);color:#29332e;scrollbar-width:thin}
  .wk-l{position:relative;display:block;width:max-content;min-height:var(--lh);padding:0 50px 0 54px;white-space:pre}
  .wk-l::before{content:attr(data-n);position:absolute;left:0;width:36px;text-align:right;font-size:11px;color:#b2b9b4}
  .wk-kod .k{color:#7c3aed}
  .wk-kod .s{color:#0a7a52}
  .wk-kod .c{color:#97a19b}
  .wk-m{position:relative;display:inline-block}
  .wk-o{position:absolute;left:-9px;right:-9px;top:-2px;bottom:-2px;border:2px solid var(--pen);border-radius:48% 52% 46% 54% / 60% 50% 56% 44%;transform:rotate(-1.4deg);pointer-events:none}
  .wk-kl{position:absolute;right:22px;top:4px;width:12px;height:calc(4 * var(--lh) - 8px);border:2px solid var(--pen);border-left:0;border-radius:0 10px 10px 0;pointer-events:none}
  .wk-b{position:absolute;display:grid;place-items:center;width:19px;height:19px;border-radius:50%;background:var(--pen);font-family:'Schibsted Grotesk',system-ui,sans-serif;font-size:11px;font-weight:700;line-height:1;color:#ffffff;pointer-events:none}
  .wk-m .wk-b{top:-13px;right:-22px}
  .wk-kl .wk-b{top:50%;right:-24px;margin-top:-10px}
  .wk-mar{position:relative;min-width:0;border-left:1px solid rgba(196,61,42,0.2)}
  .wk-u{position:absolute;left:20px;right:22px;top:calc(14px + var(--l) * var(--lh));display:grid;grid-template-columns:19px minmax(0,1fr);gap:10px;font-size:13.5px;line-height:1.45;color:#8f2f20;text-wrap:pretty}
  .wk-u .wk-b{position:static;margin-top:1px}
  .wk-poza{grid-column:1 / -1;display:flex;flex-wrap:wrap;align-items:center;gap:8px 8px;padding:14px 22px 16px;border-top:1px solid rgba(15,26,20,0.08);font-size:12.5px;color:var(--t2)}
  .wk-poza > b{margin-right:6px;font-size:13px;font-weight:650;color:var(--t1)}
  .wk-c{display:inline-flex;align-items:center;gap:7px;padding:4px 11px 4px 4px;border-radius:999px;background:var(--papier);color:var(--t1)}
  /* ruch: znak długopisu, potem numer, potem uwaga */
  .wk.gra .wk-o,.wk.gra .wk-kl{clip-path:inset(0 100% 0 0)}
  .wk.gra .wk-kl{clip-path:inset(0 0 100% 0)}
  .wk.gra .wk-m .wk-b,.wk.gra .wk-kl .wk-b,.wk.gra .wk-u,.wk.gra .wk-c{opacity:0}
  .wk.gra .wk-u{transform:translateX(-6px)}
  .wk.gra .wk-c{transform:translateY(5px)}
  .wk.gra.on .wk-o,.wk.gra.on .wk-kl{clip-path:inset(0 0 0 0);transition:clip-path .6s cubic-bezier(.5,0,.3,1) calc(var(--t) * 1s)}
  .wk.gra.on .wk-m .wk-b,.wk.gra.on .wk-kl .wk-b{opacity:1;transition:opacity .3s calc(var(--t) * 1s + .5s)}
  .wk.gra.on .wk-u{opacity:1;transform:none;transition:opacity .45s calc(var(--t) * 1s + .7s),transform .5s calc(var(--t) * 1s + .7s)}
  .wk.gra.on .wk-c{opacity:1;transform:none;transition:opacity .4s calc(var(--t) * 1s),transform .45s calc(var(--t) * 1s)}
  .wk.bez *,.mx.bez *{transition:none !important;animation:none !important}
  @media (max-width:820px){
    .wk-ark{grid-template-columns:minmax(0,1fr)}
    .wk-mar{display:grid;gap:12px;padding:16px 18px 6px;border-left:0;border-top:1px dashed rgba(196,61,42,0.3)}
    .wk-u{position:static}
    .wk-gl{padding:12px 16px}
    .wk-poza{padding:14px 16px}
  }
  @media (max-width:560px){
    .wk{--lh:22px}
    .wk-kod{font-size:11px}
    .wk-l{padding-left:38px}
    .wk-l::before{width:26px;font-size:10px}
    .wk-m .wk-b{right:-20px;top:-12px}
  }

  /* =====================================================================
     DLACZEGO 2 · macierz kolejności
     Jedna warstwa punktów nad trzema pasami (left/top w %), więc długopis
     może iść przez wszystkie pasy jedną animacją. Pasy = grupy raportu.
     ===================================================================== */
  .mx-sc{--off:0px;--bh:clamp(100px,9vw,120px);position:relative;display:grid;grid-template-columns:minmax(0,200px) minmax(0,1fr) minmax(0,220px);grid-template-rows:repeat(3,var(--bh)) auto;margin:0 clamp(2px,0.8vw,14px)}
  .mx-pas{grid-column:1 / -1;border-top:1px dashed rgba(15,26,20,0.16)}
  .mx-pas.gk0{border-top:0;border-radius:16px 16px 0 0;background:rgba(192,73,47,0.075)}
  .mx-pas.gk1{background:rgba(15,26,20,0.03)}
  .mx-y{grid-column:1;align-self:center;padding:0 18px;font-size:14.5px;font-weight:650;line-height:1.3;letter-spacing:-0.01em;text-wrap:balance}
  .mx-g{grid-column:3;align-self:center;padding:0 18px;text-align:right}
  .mx-g b{display:block;font-size:14px;font-weight:700;letter-spacing:-0.01em;line-height:1.3}
  .mx-g b i{display:inline-block;width:9px;height:9px;margin-right:7px;border-radius:50%;background:var(--gc);vertical-align:1px}
  .mx-g span{display:block;margin-top:2px;font-size:13px;color:var(--t2)}
  .mx-pl{grid-column:2;grid-row:1 / 4;position:relative;z-index:1}
  .mx-tk{position:absolute;top:0;bottom:0;left:var(--x);border-left:1px dashed rgba(15,26,20,0.13)}
  .mx-p{position:absolute;left:var(--x);top:calc(var(--yb) + var(--off) + var(--dy));z-index:2;width:0;height:0}
  .mx-p .nr{position:absolute;left:-16px;top:-16px;width:32px;height:32px;font-size:13.5px;box-shadow:0 0 0 3px var(--papier);transition:background .35s,color .35s,box-shadow .35s,transform .35s cubic-bezier(.3,1.6,.5,1)}
  .mx-p em{position:absolute;left:0;top:22px;transform:translateX(-50%);width:max-content;max-width:120px;font-style:normal;font-size:12.5px;font-weight:600;line-height:1.25;text-align:center;color:var(--t1)}
  .mx-p.lw em{top:auto;bottom:22px}
  .mx-p em .kr{display:none}
  .mx-os{grid-column:2;grid-row:4;position:relative;height:42px}
  .mx-os span{position:absolute;left:var(--x);top:12px;transform:translateX(-50%);font-size:12.5px;color:var(--t2);white-space:nowrap}
  .mx-os span .kr{display:none}
  .mx-os-t{grid-column:1;grid-row:4;align-self:start;padding:12px 18px 0;font-size:12.5px;font-weight:650;color:var(--t3)}
  .mx-pen{position:absolute;z-index:3;width:48px;height:48px;margin:-24px 0 0 -24px;border:2px solid var(--pen);border-radius:50%;opacity:0;pointer-events:none;
    left:var(--x0);top:var(--y0);box-shadow:0 0 0 4px rgba(196,61,42,0.1)}
  /* ruch: punkty szare bez numeru, długopis nadaje numery po kolei */
  .mx.gra .mx-p .nr{background:#ffffff;color:transparent;box-shadow:0 0 0 3px var(--papier),inset 0 0 0 2px #c8cec9;transform:scale(0.82)}
  .mx.gra .mx-g{opacity:0}
  .mx.gra.on .mx-p .nr{background:var(--gc);color:#ffffff;box-shadow:0 0 0 3px var(--papier);transform:none;transition-delay:calc(var(--t) * 1s)}
  .mx.gra.on .mx-p.gk2 .nr{color:var(--t1)}
  .mx.gra.on .mx-g{opacity:1;transition:opacity .45s calc(var(--t) * 1s)}
  @media (max-width:860px){
    .mx-sc{--off:14px;--bh:150px;grid-template-columns:minmax(0,1fr);grid-template-rows:repeat(3,var(--bh)) auto}
    .mx-y,.mx-g{grid-column:1;align-self:start}
    .mx-y{padding:14px 16px 0;font-size:13px;font-weight:600;color:var(--t2)}
    .mx-g{justify-self:start;padding:34px 16px 0;text-align:left}
    .mx-g b{font-size:13px}
    .mx-g span{display:none}
    .mx-pl{grid-column:1;margin:0 16px}
    .mx-os{grid-column:1;margin:0 16px}
    .mx-os-t{display:none}
    .mx-p em{max-width:84px;font-size:11.5px}
    .mx-p.lw em{transform:translateX(-82%)}
    .mx-p em .dl{display:none}
    .mx-p em .kr{display:inline}
    .mx-os span{font-size:11.5px}
    .mx-os span .dl{display:none}
    .mx-os span .kr{display:inline}
  }

  /* =====================================================================
     SCENA · trzy strony raportu na stosie kartek
     ===================================================================== */
  .sr-pan{margin-top:clamp(28px,3vw,44px)}
  .sr-stos{position:relative;max-width:1140px;margin:0 auto}
  .sr-stos::before,.sr-stos::after{content:"";position:absolute;inset:0;border-radius:8px;background:#e8e7e1;box-shadow:0 30px 60px -40px rgba(0,0,0,0.8)}
  .sr-stos::before{transform:translate(14px,14px) rotate(0.8deg);background:#d9d8d1}
  .sr-stos::after{transform:translate(7px,7px) rotate(0.35deg)}
  .sr-str{--t1:#18181b;--t2:#52525b;--t3:#71717a;--t4:#a1a1aa;--lin:rgba(9,9,11,0.08);--lin2:rgba(9,9,11,0.05);
    position:relative;z-index:1;padding:clamp(20px,3vw,48px) clamp(18px,3.4vw,58px) clamp(18px,2.4vw,32px);border-radius:8px;background:#ffffff;color:var(--t1);
    box-shadow:0 0 0 1px rgba(255,255,255,0.12),0 60px 120px -50px rgba(0,0,0,0.9),0 20px 40px -24px rgba(0,0,0,0.6)}
  .sr-str .hi{display:block;flex-shrink:0;width:16px;height:16px;fill:currentColor}
  .sr-gl{display:flex;align-items:center;gap:10px;padding-bottom:14px;border-bottom:1px solid var(--lin);font-size:12.5px;color:var(--t3)}
  .sr-gl i{display:grid;place-items:center;flex-shrink:0;width:26px;height:26px;border-radius:7px;background:#0f1a14}
  .sr-gl i svg{display:block;width:13px;height:13px;fill:#00cd77}
  .sr-gl b{font-weight:650;color:var(--t1)}
  .sr-gl > span:last-child{margin-left:auto;white-space:nowrap}
  .sr-kick{display:block;font-size:12.5px;font-weight:650;color:var(--ziel-c)}
  .sr-str h3{margin:8px 0 0;font-size:clamp(22px,2.3vw,32px);font-weight:700;letter-spacing:-0.03em;line-height:1.12;text-wrap:balance}
  .sr-str p{margin:12px 0 0;font-size:15px;line-height:1.65;color:var(--t2);text-wrap:pretty}
  .sr-str p b{color:var(--t1);font-weight:650}
  /* strona 1: werdykt i spis */
  .sr-p0{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:clamp(28px,4.4vw,72px);margin-top:clamp(22px,2.6vw,34px)}
  .sr-pod{display:flex;align-items:center;gap:11px;margin-top:24px;padding-top:16px;border-top:1px solid var(--lin)}
  .sr-pod img{display:block;width:38px;height:38px;border-radius:50%;object-fit:cover;filter:grayscale(1)}
  .sr-pod b{display:block;font-size:14px;font-weight:650}
  .sr-pod span span{display:block;font-size:12.5px;color:var(--t3)}
  .sr-spis h4{margin:0;font-size:12.5px;font-weight:650;color:var(--t3)}
  .sr-sg{display:flex;align-items:center;gap:7px;margin-top:16px;font-size:12.5px;font-weight:650;color:var(--t2)}
  .sr-sg i{display:block;width:8px;height:8px;border-radius:50%;background:var(--gc)}
  .sr-sw{display:flex;align-items:baseline;gap:9px;padding:8px 0;border-bottom:1px solid var(--lin2);font-size:14px;line-height:1.35}
  .sr-sw .nr{align-self:center}
  .sr-sw > span{min-width:0}
  .sr-sw > .sr-ld{flex:1;min-width:14px;border-bottom:1.5px dotted rgba(9,9,11,0.22);transform:translateY(-4px)}
  .sr-sw > em{font-style:normal;font-size:12.5px;color:var(--t3);white-space:nowrap}
  /* strona 2: co przejrzeliśmy */
  .sr-tab{margin-top:clamp(18px,2.2vw,28px)}
  .sr-tn,.sr-tw{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1.6fr) minmax(0,0.9fr);gap:18px;align-items:center}
  .sr-tn{padding:0 0 10px;font-size:12px;font-weight:650;color:var(--t3)}
  .sr-tw{padding:11px 0;border-top:1px solid var(--lin2);font-size:14px}
  .sr-tw > b{font-weight:600}
  .sr-tw > span{color:var(--t2)}
  .sr-ref{display:flex;flex-wrap:wrap;align-items:center;gap:4px}
  .sr-ref small{margin-right:2px;font-size:12px;color:var(--t3)}
  .sr-ok{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:600;color:#047857}
  .sr-ok svg{display:block;width:16px;height:16px;padding:2px;border-radius:50%;background:rgba(16,185,129,0.14);fill:currentColor}
  /* strona 3: pozycja 1 */
  .sr-p1-gl{display:flex;align-items:center;flex-wrap:wrap;gap:8px 12px;margin-top:clamp(20px,2.4vw,30px)}
  .sr-p1-gl > span{display:inline-flex;align-items:center;gap:7px;font-size:12.5px;font-weight:650;color:var(--t2)}
  .sr-meta{display:flex;flex-wrap:wrap;gap:6px;margin-top:14px}
  .sr-meta > span{display:inline-flex;align-items:center;gap:6px;padding:5px 11px;border-radius:999px;background:#f4f4f2;font-size:12.5px;font-weight:550;color:var(--t2)}
  .sr-meta > span.w{background:rgba(16,185,129,0.1);color:#047857}
  .sr-meta .hi{width:13px;height:13px}
  .sr-meta em{font-style:normal}
  .sr-meta code{font-family:var(--mono);font-size:11.5px}
  .sr-p1{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:clamp(24px,3.6vw,56px);margin-top:clamp(20px,2.4vw,30px)}
  .sr-cz{margin:0}
  .sr-cz > div{display:grid;grid-template-columns:150px minmax(0,1fr);gap:16px;padding:13px 0;border-top:1px solid var(--lin2)}
  .sr-cz > div:first-child{border-top:1.5px solid var(--t1)}
  .sr-cz dt{font-size:13.5px;font-weight:650}
  .sr-cz dd{margin:0;font-size:14.5px;line-height:1.6;color:var(--t2);text-wrap:pretty}
  .sr-box{padding:14px 16px;border-radius:12px;background:#f6f6f3}
  .sr-box + .sr-box{margin-top:10px}
  .sr-box > span{display:flex;align-items:center;gap:7px;font-size:12px;font-weight:650;color:var(--t3)}
  .sr-box > span .hi{width:14px;height:14px}
  .sr-box > p{margin:6px 0 0;font-size:14px;line-height:1.55;color:var(--t1)}
  .sr-box.cmd{background:#0f1a14}
