  },
];


// ---- CZYM JEST: TRZY KROKI ---------------------------------------------
const KROKI = [
  {
    t: 'Ustawiamy zasady i sposób pracy',
    d: 'Reguły z ponad dwustu wdrożeń lądują w Twoim repozytorium. Czyta je AI, w którym budujecie, więc pisze od razu inaczej.',
  },
  {
    t: 'Oglądamy każdą nową wersję',
    d: 'Narzędzie sprawdza ją tymi zasadami, a człowiek patrzy na to, co ono podniesie.',
  },
  {
    t: 'Zwracamy uwagę i pokazujemy jak',
    d: 'Kiedy coś jest źle, mówimy co i dlaczego. Przy trudniejszych rzeczach przechodzimy przez to razem przy jednym ekranie.',
  },
];


// ---- CO JESZCZE ROBIMY W MIESIĄCU ---------------------------------------
// Świadomie czasownikami, nie nazwami — inaczej czytelnik gubi, co jest
// usługą, a co jej elementem.
const ROBIMY = [
  {
    t: 'Zwracamy uwagę na to, co jest źle',
    d: 'Przy drobnych wystarczy zdanie w komentarzu. Przy większych pokazujemy, jak zrobić to inaczej, i zostawiamy zasadę.',
  },
  {
    t: 'Siadamy z Tobą, kiedy coś się zacina',
    d: 'Dwa spotkania po półtorej godziny w miesiącu, przy jednym ekranie. Klawiaturę trzyma Twoja osoba.',
  },
  {
    t: 'Odpowiadamy na pytania w trakcie pracy',
    d: 'Kanał na czacie, na którym pytasz o wszystko, także o podstawy. Nikt tych pytań nie liczy.',
  },
  {
    t: 'Raz w miesiącu siadamy do podsumowania',
    d: 'Godzina: co powstało, na co zwróciliśmy uwagę i dlaczego, co doszło do Twoich zasad.',
  },
];


// ---- MIESIĄC DZIEŃ PO DNIU ---------------------------------------------
// Kafelki jak w wykresie aktywności: intensywność koloru mówi, ile się
// danego dnia działo, a dymek pokazuje co dokładnie. Dzięki temu nie
// potrzeba legendy — treść siedzi w każdym dniu z osobna.
const DNI = [
  { w: 2, q: 1 },            { w: 3, p: 1 },            { w: 2, q: 2 },            { w: 4, p: 1, q: 1 },      { w: 3 },
  { w: 3, q: 1 },            { w: 2, p: 1, q: 1 },      { w: 3, s: 1 },            { w: 2, q: 1 },            { w: 4, p: 1 },
  { w: 2, q: 2 },            { w: 3 },                  { w: 2, p: 1, q: 1 },      { w: 4, s: 1 },            { w: 2, q: 1 },
  { w: 3, p: 1, q: 1 },      { w: 2 },                  { w: 4, p: 1, q: 2 },      { w: 2, q: 1 },            { w: 3, d: 1 },
];
const DNI_TYG = ['pn', 'wt', 'śr', 'cz', 'pt'];

// polska odmiana bez kombinowania: 1 / 2–4 / 5+
const odm = (n, jeden, kilka, wiele) => (n === 1 ? jeden : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? kilka : wiele);
const opisDnia = (x) => {
  const l = [`${x.w} ${odm(x.w, 'nowa wersja', 'nowe wersje', 'nowych wersji')} od Twojego zespołu`];
  if (x.p) l.push('jedna dostała uwagę i zasadę');
  if (x.q) l.push(`${x.q} ${odm(x.q, 'pytanie', 'pytania', 'pytań')} na czacie, odpowiedź tego dnia`);
  if (x.s) l.push('półtorej godziny przy jednym ekranie');
  if (x.d) l.push('godzina podsumowania miesiąca');
  return l;
};
// Rachunek miesiąca liczony z tablicy DNI, nie wpisany ręcznie —
// dopisanie dnia przelicza pasek pod siatką samo.
const MC = DNI.reduce(
  (a, x) => ({ w: a.w + x.w, p: a.p + (x.p || 0), q: a.q + (x.q || 0), s: a.s + (x.s || 0), d: a.d + (x.d || 0) }),
  { w: 0, p: 0, q: 0, s: 0, d: 0 }
);

const MIESIAC = DNI.map((x, i) => ({
  ...x,
  i,
  tydzien: Math.floor(i / 5) + 1,
  dzien: DNI_TYG[i % 5],
  poziom: Math.min(4, x.w + (x.p ? 1 : 0)),
  opis: opisDnia(x),
}));


// ---- WISESTACK (ciemny pas) --------------------------------------------
// Czwarte podejście. Trzy poprzednie były źle postawione (korekta
// Szymona, 07.09): mierzyły czas dostawy i liczbę błędów, czyli
// porównywały nas z klasycznym developmentem. Czytelnik tej strony
// buduje z AI i JUŻ jest szybki — takie porównanie nic mu nie mówi.
//
// WŁAŚCIWE PORÓWNANIE stoi na /wisestack: ten sam stack z AI, ale bez
// ustalonych zasad, kontra WiseStack. Rozbite na trzy fazy widać, gdzie
// naprawdę leży różnica — pisanie kodu jest prawie takie samo, bo to
// właśnie AI już załatwiło. Ogon po napisaniu kodu jest sześć razy
// dłuższy: sprawdzanie, poprawki i doprowadzenie do stanu, w którym
// da się to rozwijać.
//
// Liczby wprost z /wisestack (tablice FAZY i MODELE), w tygodniach.
// Jeden wspólny pasek ukrywał to, co najważniejsze: skrócenie pisania
// kodu z dwóch tygodni do jednego ginęło obok dwunastotygodniowego
// ogona i wyglądało na „bez zmian" (uwaga Szymona, 07.09). Dlatego
// każda faza dostaje własną parę słupków i własną skalę — wtedy widać,
// że skraca się KAŻDA, a poprawki najmocniej.
const FAZY = [
  { t: 'Zanim powstanie kod', o: 'język domeny, kolejność funkcji, kryterium „gotowe”', bez: 4, ws: 2 },
  { t: 'Pisanie kodu', o: 'schemat i typy są gotowe, więc model nie zgaduje', bez: 2, ws: 1 },
  { t: 'Poprawki i wdrożenie', o: 'to, co wraca ze sprawdzania, zanim da się z tego korzystać', bez: 12, ws: 2 },
];
const SUMA_BEZ = FAZY.reduce((a, f) => a + f.bez, 0);
const SUMA_WS = FAZY.reduce((a, f) => a + f.ws, 0);
const ile = (n) => `${n} ${n === 1 ? 'tydzień' : n >= 2 && n <= 4 ? 'tygodnie' : 'tygodni'}`;


// ---- KTO PO NASZEJ STRONIE ---------------------------------------------
// Twarze biorę z rejestru zespołu (src/data/zespol.js), bo abstrakcyjne
// kafle nic nie mówią, a stockowych zdjęć nie używamy.
const os = (n) => zespol.find((x) => x.name === n);
const PROWADZACY = ['Krzysztof Radej', 'Michał Langowski', 'Michał Kita', 'Kamil Olejek', 'Marcel Bilski'].map(os);

const DOKLADANE = [
  { t: 'Analityk biznesowy', d: 'gdy z aplikacji zaczynają wychodzić raporty', kto: os('Damian Trzciński') },
  { t: 'Zastępstwo', d: 'na urlop albo odejście Twojej osoby', kto: os('Łukasz Filip') },
  { t: 'Trudniejsze elementy', d: 'płatności, migracje, ciężkie integracje', kto: os('Krzysztof Radej') },
  { t: 'Kierownik projektu', d: 'gdy budujesz dwa produkty naraz', kto: os('Aleksander Żaboklicki') },
  { t: 'Projektant', d: 'gdy narzędzie zaczynają widzieć klienci', kto: os('Dawid Kita') },
];


// ---- CO DZIEJE SIĘ PO DIAGNOZIE ----------------------------------------
// Poprawka 5. Wcześniej stały tu dwa konkurencyjne wejścia, każde
// z własnym przyciskiem („Umów przegląd", „Umów rozmowę o celach"),
// i żadne nie było ofertą, po którą klient przyszedł ze strony głównej.
// Teraz obie drogi zaczynają się od tej samej bezpłatnej diagnozy.
const WEJSCIE = [
  {
    e: 'Kiedy coś już działa',
    t: 'Masz już coś zbudowane',
    d: 'Pięć dni, w których przechodzimy to, co powstało. Wychodzisz z listą podzieloną po tym, kto co wykona.',
    kroki: ['Pięć dni przeglądu', 'Pierwszy zakres ustalamy po tej liście'],
  },
  {
    e: 'Kiedy zaczynasz od zera',
    t: 'Jeszcze nie ma czego oglądać',
    d: 'Dwa dni na cele i dobór narzędzi. Tu mamy wpływ na wybory, których później nie da się zmienić tanio.',
    kroki: ['Dwa dni na cele i narzędzia', 'Zaczynasz budować, my ustawiamy zasady'],
  },
];


// ---- CO MASZ DO WYBORU --------------------------------------------------
// Zyski tej usługi widać dopiero obok tego, co klient rozważa naprawdę.
// Kwoty rynkowe zapisane wprost — w oryginale stały w nawiasach
// kwadratowych i tak trafiły na produkcję.
const ALTERNATYWY = [
  {
    t: 'Programista na etacie',
    d: 'Jedna osoba, która zna tylko Twój projekt — i idzie na urlop w lipcu.',
    koszt: '15–25 tys. zł / mies.',
    kto: 'Twoja, jeśli go znajdziesz',
    kiedy: 'za 2–4 miesiące rekrutacji',
  },
  {
    t: 'Software house',
    d: 'Gotowy produkt i rachunek za każdą kolejną zmianę.',
    koszt: 'wycena za projekt',
    kto: 'przechodzi do nich',
    kiedy: 'po ustaleniu zakresu',
  },
  {
    t: 'Nic',
    d: 'Działa do dnia, w którym coś się wysypie albo autor odejdzie.',
    koszt: '0 zł do pierwszej awarii',
    kto: 'u Ciebie',
    kiedy: '—',
  },
  {
    t: 'Prowadzenie z nami',
    d: 'Zasady w repozytorium, przegląd każdej wersji i ludzie, którzy z miesiąca na miesiąc umieją więcej.',
    koszt: 'od 2900 zł / mies. albo wycena projektu',
    kto: 'zostaje u Ciebie',
    kiedy: 'od pierwszego tygodnia',
    my: true,
  },
];


// ---- FAQ ----------------------------------------------------------------
// Poprawka 7: z dziesięciu pytań zostaje siedem. Wypadły te, na które
// odpowiada już treść strony („kiedy coś jest ważne" — krok 02,
// „umiecie w Claude Code" — hero i krok 01) oraz trzecie o dostępach,
// które dublowało odpowiedź o wypowiedzeniu.
const faq = [
  {
    q: 'Za co płacę w miesiącu, w którym nic się nie zepsuło?',
    a: 'Za to, że ktoś obejrzał każdą nową wersję, i za to, że miałeś gdzie zapytać w środę o czternastej. Jeśli spokojnych miesięcy jest kilka pod rząd, sami proponujemy zejście na mniejszy zakres.',
  },
  {
    q: 'Nie mam nikogo technicznego. Czy zrozumiem, co do mnie wraca?',
    a: 'Wiadomość, po której ktoś czuje się głupszy, jest źle napisaną wiadomością — to jedyne kryterium, po którym oceniamy własną robotę. Każda ma cztery części: co zobaczyliśmy, co proponujemy, ile to zajmie i czego nie ruszamy.',
  },
  {
    q: 'Musicie mieć dostęp do wszystkiego?',
    a: 'Nie. Wystarczy podgląd do projektu i do miejsca, gdzie leży kod — w większości narzędzi to zaproszenie na adres e-mail, do cofnięcia jednym kliknięciem. Umowę o poufności podpisujemy przed pierwszym dostępem.',
  },
  {
    q: 'Poprawiacie sami czy tylko mówicie, co zrobić?',
    a: 'Mówimy, co i dlaczego zmienić, a przy trudniejszych rzeczach przechodzimy przez to razem przy jednym ekranie. Klawiatura zostaje u Twoich ludzi, więc po trzecim razie robią to bez nas. Budowy produktu nie przejmujemy.',
  },
  {
    q: 'Ile mojego czasu to zajmuje?',
    a: 'Około czterech godzin w miesiącu: dwa spotkania, godzina podsumowania i drobne pytania po drodze.',
  },
  {
    q: 'Czy dojdą jakieś koszty poza abonamentem?',
    a: 'Nie po naszej stronie — narzędzia, licencje i tokeny są w stawce miesięcznej. Osobno płacisz tylko za to, co i tak jest Twoje: subskrypcję Claude Code i rachunki za usługi, na których stoi aplikacja.',
  },
  {
    q: 'Co, jeśli chcę przestać?',
    a: 'Miesięczny okres wypowiedzenia. Zostaje u Ciebie wszystko: kod, dostępy i spisane zasady — jak „AI nie zmienia pieniędzy bez zgody człowieka”, dopisana po tym, jak agent wystawił korektę do faktury sam. Czyta je AI, w którym budujesz, więc działają dalej. Od dostawców narzędzi nie bierzemy prowizji.',
  },
];

// Poprawka 7b: schema FAQPage. Sześć podstron pionu „Wdrażamy AI" ją ma,
// żadna ze stron Guided Codingu nie miała.
const dane = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${kanon}#usluga`,
      name: 'Guided coding dla zespołu bez działu IT',
      serviceType: 'Stała opieka nad aplikacją budowaną z AI',
      url: kanon,
      description: 'Abonamentowe prowadzenie zespołu, który buduje aplikacje z AI bez działu IT: zasady wytwarzania zapisane w repozytorium klienta, przegląd każdej nowej wersji, wspólne sesje przy jednym ekranie i transfer know-how do zespołu.',
      provider: { '@id': new URL('/#organizacja', Astro.site).href },
      areaServed: { '@type': 'Country', name: 'Polska' },
      audience: { '@type': 'BusinessAudience', name: 'Firmy bez własnego działu IT' },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${kanon}#okruszki`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Strona główna', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: 'Guided Coding', item: new URL('/guided-coding', Astro.site).href },
        { '@type': 'ListItem', position: 3, name: 'Dla zespołów nietechnicznych', item: kanon },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${kanon}#faq`,
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
