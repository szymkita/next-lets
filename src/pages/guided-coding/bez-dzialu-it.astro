  .ap-btn{flex-shrink:0;background:#0e2b1d;color:#ffffff;border-radius:8px;padding:7px 13px;font-size:11.5px;font-weight:700;white-space:nowrap;animation:ku-wcisk var(--c) linear infinite}
  .ap-kafle{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-top:13px}
