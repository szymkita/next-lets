  /* kursor i klik */
  .ap-kursor{position:absolute;z-index:4;width:22px;height:22px;pointer-events:none;animation:ku-lot var(--c) cubic-bezier(.5,0,.2,1) infinite;filter:drop-shadow(0 3px 6px rgba(12,28,20,0.35))}
  .ap-kursor svg{display:block;width:100%;height:100%}
  .ap-kursor::after{content:'';position:absolute;left:-11px;top:-11px;width:44px;height:44px;border-radius:50%;background:rgba(0,205,119,0.5);animation:ku-klik var(--c) ease-out infinite}

  .ap-skan{position:absolute;left:0;right:0;top:0;height:130px;z-index:2;pointer-events:none;background:linear-gradient(180deg,rgba(0,205,119,0) 0%,rgba(0,205,119,0.10) 52%,rgba(0,205,119,0.42) 93%,rgba(0,205,119,0) 100%);animation:ap-skan 2.4s cubic-bezier(.4,0,.25,1) .45s both}
  @keyframes ap-skan{0%{transform:translateY(-140px);opacity:0}10%{opacity:1}86%{opacity:1}100%{transform:translateY(460px);opacity:0}}

  .ap-karta{position:absolute;z-index:5;display:flex;align-items:center;gap:12px;background:rgba(255,255,255,0.97);backdrop-filter:blur(6px);border:1px solid #e8ede7;border-radius:14px;padding:13px 18px;box-shadow:0 22px 52px -20px rgba(12,28,20,0.34);text-align:left;animation:ap-wej .6s cubic-bezier(.2,.7,.3,1) both, ap-plyw 9s ease-in-out infinite;animation-delay:2.5s, 3.1s}
  .ap-karta.gora{left:-30px;top:96px}
  .ap-karta.dol{right:-26px;bottom:40px;animation-delay:2.9s, 5.6s}
  @keyframes ap-wej{from{opacity:0;transform:translateY(12px) scale(.965)}to{opacity:1;transform:none}}
  @keyframes ap-plyw{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}
  .ap-karta > span{display:block}
  .ap-karta > span > b{display:block;font-size:13.5px;font-weight:650;color:#16211a}
  .ap-karta > span > span{display:block;margin-top:2px;font-size:11.5px;color:#8b968d}
  .ap-karta i{display:flex;align-items:center;justify-content:center;width:24px;height:24px;border-radius:50%;font-style:normal;font-size:13px;font-weight:800;flex-shrink:0}
  .ap-karta.gora i{background:#e6f7ec;color:#0a7a52}
  .ap-karta.dol i{background:#f9efd8;color:#8f6c1c}

  @media (max-width:1400px){ .ap-box{--s:0.9} }
  @media (max-width:1180px){ .ap-box{--s:0.78} }
  @media (max-width:900px){ .ap-box{--s:0.92} }
  @media (max-width:760px){ .ap-box{--s:0.68} }
  @media (max-width:520px){ .ap-box{--s:0.5} }
  @media (prefers-reduced-motion:reduce){
    .ap-skan{display:none}
    .ap-kursor{display:none}
    .ap-btn,.ap-w.nowy{animation:none}
    .ap-w.nowy{opacity:1;max-height:64px}
    .ap-karta{animation:none;opacity:1;transform:none}
  }

  /* ================= pas dowodu ========================================
     Poprawka 3: 1:1 ze strony głównej. Logotypy jadą w pętli i chowają
     się pod napisem po lewej. */
  .tr{position:relative;z-index:2;display:flex;align-items:center;gap:36px;padding:30px max(clamp(20px,5vw,56px),calc((100% - 1440px) / 2));border-top:1px solid #eef1ec;border-bottom:1px solid #eef1ec;background:#ffffff}
  .tr-n{position:relative;z-index:2;background:#ffffff;padding-right:12px;flex-shrink:0;max-width:210px;font-size:14px;line-height:1.45;color:#4c5850}
  .tr-n strong{color:#16211a;font-weight:700}
  .tr-o{overflow:hidden;position:relative;z-index:1;margin-left:-76px;flex:1;filter:grayscale(1);opacity:0.55}
  .tr-t{display:flex;align-items:center;gap:56px;width:max-content;animation:tr-jazda 30s linear infinite}
  .tr-o:hover .tr-t{animation-play-state:paused}
  .tr-t img{width:114px;height:28px;object-fit:contain}
  @keyframes tr-jazda{from{transform:translateX(0)}to{transform:translateX(calc(-50% - 28px))}}
  @media (prefers-reduced-motion:reduce){ .tr-t{animation:none} }
  @media (max-width:820px){
    .tr{flex-wrap:wrap;justify-content:center;text-align:center;gap:18px}
    .tr-n{max-width:none;padding-right:0}
    .tr-o{margin-left:0;overflow:hidden;width:100%;flex:none}
  }


  /* ================= lupa nad kodem ====================================
     Bez ramki i bez tła: kod jest wygaszony maską u góry i u dołu.
     Poza lupą jest blady, pod lupą ostry. Lupa wędruje po torze liczonym
     w nagłówku pliku i zatrzymuje się na trzech podkreśleniach. */
  .lu-box{position:relative;width:calc(var(--w) * var(--s, 1));height:calc(var(--h) * var(--s, 1))}
  .lu-ram{position:absolute;left:0;top:0;width:var(--w);height:var(--h);transform:scale(var(--s, 1));transform-origin:top left}
  .lu-plot{position:absolute;inset:0;overflow:hidden;-webkit-mask-image:linear-gradient(to bottom,transparent 0,#000 13%,#000 76%,transparent 100%);mask-image:linear-gradient(to bottom,transparent 0,#000 13%,#000 76%,transparent 100%)}
  .lu-strum{position:absolute;left:0;top:var(--gora);width:100%}
  .lu-l{position:relative;display:block;white-space:pre;font-family:ui-monospace,Menlo,monospace;font-size:var(--fs);line-height:var(--wiersz);height:var(--wiersz);color:#c6d1c5;padding-left:var(--lewo)}
  .lu-w{position:absolute;left:var(--lewo);top:0;white-space:pre}
  .lu-m{position:relative;display:inline-block}
  .lu-m u{position:absolute;left:-3px;right:-3px;top:-1px;bottom:-1px;border-radius:4px;background:rgba(0,0,0,0)}
  .lu-m i{position:absolute;left:-2px;right:-2px;bottom:-3px;height:2.5px;border-radius:2px;opacity:0}
  .lu-m em{position:relative;font-style:normal}
  .lu-lupa{position:absolute;left:0;top:0;width:calc(var(--r) * 2);height:calc(var(--r) * 2)}
  .lu-kolo{position:absolute;inset:0;border-radius:50%;overflow:hidden;background:#ffffff;box-shadow:0 22px 44px -20px rgba(18,38,28,0.45), 0 0 0 1.5px #16211a, inset 0 0 0 5px rgba(255,255,255,0.92)}
  .lu-zoom{position:absolute;left:0;top:0;width:var(--w);height:var(--h);transform-origin:0 0}
  .lu-zoom .lu-l{color:#16211a}
  .lu-blysk{position:absolute;inset:0;border-radius:50%;pointer-events:none;background:radial-gradient(120% 120% at 30% 22%, rgba(255,255,255,0.6), rgba(255,255,255,0) 46%), radial-gradient(90% 90% at 76% 84%, rgba(22,33,26,0.09), rgba(255,255,255,0) 55%)}
  .lu-uchwyt{position:absolute;left:calc(var(--r) * 1.66);top:calc(var(--r) * 1.66);width:58px;height:10px;border-radius:6px;background:#16211a;transform:rotate(42deg);transform-origin:0 50%}
  @media (max-width:1240px){ .lu-box{--s:0.88} }
  @media (max-width:900px){ .lu-box{--s:1} }
  @media (max-width:660px){ .lu-box{--s:0.62} }
  @media (max-width:420px){ .lu-box{--s:0.54} }
  /* 600px makiety razy 0.54 to wciąż 324px — na 320px ekranie wychodziło
     poza kadr sekcji. */
  @media (max-width:380px){ .lu-box{--s:0.44} }
  @media (prefers-reduced-motion:reduce){
    /* Bez ruchu: lupa stoi na drugim podkreśleniu, wszystkie na zielono. */
    .lu-strum{animation:none !important;transform:translateY(var(--stop))}
    .lu-lupa{animation:none !important;left:var(--sl);top:var(--st)}
    .lu-zoom{animation:none !important;transform:var(--sk)}
    .lu-m i{animation:none !important;opacity:1;background:#00CD77}
    .lu-m u{animation:none !important;background:rgba(0,205,119,0.14)}
    .lu-w.p{animation:none !important;opacity:0}
    .lu-w.o{animation:none !important;opacity:1}
  }

  /* ================= przepływ: Ty → my → ludzie ========================
     Każdy przystanek siedzi w swojej kolumnie, więc kropka stoi dokładnie
     nad swoim podpisem. Odstęp siatki jest stałą (--g), bo z niej liczą
     się klatki jadącej kropki. */
  .fl{--g:34px;position:relative;margin-top:clamp(52px,6vw,84px)}
  .fl-t{position:absolute;left:6px;right:6px;top:5px;height:2px;background:#e2e9e0;border-radius:2px;overflow:hidden}
  .fl-f{position:absolute;left:0;top:0;bottom:0;width:0;background:linear-gradient(90deg,rgba(0,205,119,0.35),var(--la-accent,#00CD77));border-radius:2px}
  .fl-k{position:absolute;top:-1px;width:14px;height:14px;border-radius:50%;background:var(--la-accent,#00CD77);box-shadow:0 0 0 4px rgba(0,205,119,0.16);z-index:1}
  .fl-o{position:relative;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--g)}
  .fl-o > div{position:relative;padding-top:34px}
  .fl-s{position:absolute;left:0;top:-2px;width:12px;height:12px;border-radius:50%;background:#ffffff;border:2px solid #c3d2c5}
  .fl-o > div:nth-child(2) .fl-s{border-color:#0a7a52}
  .fl-p{position:absolute;left:50%;top:50%;width:22px;height:22px;margin:-11px 0 0 -11px;border-radius:50%;border:1.5px solid rgba(10,122,82,0.45);opacity:0;pointer-events:none}
  .fl-o b{display:block;font-size:clamp(16px,1.85vw,18.5px);font-weight:750;letter-spacing:-0.015em;line-height:1.3;color:#16211a;text-wrap:balance}
  .fl-o span{display:block;margin-top:8px;font-size:14.5px;line-height:1.58;color:#4c5850;text-wrap:pretty}
  @media (max-width:760px){
    .fl-o{grid-template-columns:1fr;gap:24px}
    .fl-t,.fl-k{display:none}
  }

  /* ================= dla kogo ==========================================
     Trzy sytuacje obok siebie, bez linii — żeby nie była to kolejna
     tabelka. */
  .dk{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(26px,4vw,60px);margin-top:clamp(30px,3.6vw,44px)}
  .dk-i{display:block;font-family:ui-monospace,Menlo,monospace;font-size:10.5px;letter-spacing:0.13em;color:#a3ada4;font-style:normal}
  .wr-t{margin:12px 0 0;font-size:clamp(17.5px,2vw,20.5px);font-weight:750;letter-spacing:-0.016em;line-height:1.3;color:#16211a;text-wrap:balance}
  .wr-d{margin:10px 0 0;font-size:15px;line-height:1.6;color:#4c5850;text-wrap:pretty}
  @media (max-width:860px){ .dk{grid-template-columns:1fr;gap:26px} }

  /* ================= problemy: kolumny w pasie przewijanym =============
     Bez pudełek, ramek i cieni — kolumny rozdzielone włosową kreską, jak
     w gazecie. Ciężar niesie typografia. */
  .pk{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(348px,1fr);gap:0;margin-top:clamp(32px,4vw,48px);overflow-x:auto;overscroll-behavior-x:contain;scroll-snap-type:x mandatory;scrollbar-width:thin;scrollbar-color:#d4ded4 transparent;padding-bottom:18px}
  .pk::-webkit-scrollbar{height:5px}
  .pk::-webkit-scrollbar-track{background:transparent}
  .pk::-webkit-scrollbar-thumb{background:#dbe4da;border-radius:3px}
  .pk-k{scroll-snap-align:start;display:flex;flex-direction:column;padding:2px clamp(28px,3vw,44px) 4px;border-left:1px solid #e2e9e0}
  .pk-k:first-child{border-left:0;padding-left:0}
  .pk-c{display:block;font-size:46px;line-height:0.62;font-weight:800;color:#cfe3d5;user-select:none}
  .pk-t{margin:14px 0 0;min-height:calc(2 * 1.24em);display:flex;align-items:flex-end;max-width:17ch;font-size:clamp(19px,2.1vw,22px);font-weight:750;letter-spacing:-0.022em;line-height:1.24;color:#16211a;text-wrap:balance}
  .pk-r{width:34px;height:2px;margin:20px 0 0;background:#16211a;border-radius:2px}
  .pk-d{margin:16px 0 0;min-height:calc(3 * 1.62em);max-width:34ch;font-size:14.5px;line-height:1.62;color:#4c5850;text-wrap:pretty}
  .pk-s{display:flex;align-items:center;gap:12px;margin-top:2px;font-family:ui-monospace,Menlo,monospace;font-size:10.5px;letter-spacing:0.12em;text-transform:uppercase;color:#a3ada4}
  .pk-s i{flex:1;height:1px;background:#e4ebe2}
  @media (max-width:620px){ .pk{grid-auto-columns:minmax(262px,1fr)} .pk-k{padding-left:24px;padding-right:24px} }

  /* ================= miesiąc dzień po dniu ==============================
     Kafelki jak w wykresie aktywności: im ciemniejszy, tym więcej się
     działo. Dymek pokazuje, co dokładnie — dzięki temu nie ma legendy. */
  .mk{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(0,0.92fr);gap:clamp(36px,6vw,88px);align-items:center;margin-top:clamp(32px,4vw,50px)}
  .mk-s{display:grid;grid-template-columns:30px repeat(5,minmax(0,1fr));gap:clamp(7px,1vw,10px)}
  .mk-h{font-family:ui-monospace,Menlo,monospace;font-size:10.5px;letter-spacing:0.1em;color:#a3ada4;text-align:center;padding-bottom:2px}
  .mk-t{font-family:ui-monospace,Menlo,monospace;font-size:11px;color:#b9c4ba;display:flex;align-items:center;justify-content:center}
  .mk-d{position:relative;height:clamp(58px,6vw,74px);border-radius:11px;border:1px solid transparent;background:#e9efe8;cursor:default;transition:transform .16s ease}
  .mk-d:hover{transform:translateY(-2px)}
  .mk-d.p1{background:#dcecdf}
  .mk-d.p2{background:#b8dfc6}
  .mk-d.p3{background:#6fcb9b}
  .mk-d.p4{background:#1fa968}
  .mk-d.sp{background:var(--la-accent,#00CD77);box-shadow:inset 0 0 0 2px #ffffff,0 0 0 2px #0a7a52}
  .mk-d.pd{background:#16211a;box-shadow:inset 0 0 0 2px #ffffff,0 0 0 2px #16211a}
  .mk-nr{position:absolute;left:8px;top:7px;font-family:ui-monospace,Menlo,monospace;font-size:9.5px;color:rgba(22,33,26,0.4)}
  .mk-d.p3 .mk-nr,.mk-d.p4 .mk-nr{color:rgba(255,255,255,0.75)}
  .mk-d.sp .mk-nr,.mk-d.pd .mk-nr{color:rgba(255,255,255,0.85)}
  .mk-y{position:absolute;left:50%;bottom:calc(100% + 10px);transform:translateX(-50%) translateY(4px);width:230px;padding:12px 14px;border-radius:12px;background:#16211a;color:#ffffff;opacity:0;visibility:hidden;transition:opacity .16s ease,transform .16s ease;z-index:5;pointer-events:none;box-shadow:0 20px 40px -22px rgba(18,38,28,0.6)}
  .mk-y::after{content:'';position:absolute;left:50%;top:100%;margin-left:-6px;border:6px solid transparent;border-top-color:#16211a}
  .mk-y b{display:block;font-family:ui-monospace,Menlo,monospace;font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.5);margin-bottom:7px}
  .mk-y u{display:block;text-decoration:none;font-size:13.5px;line-height:1.45;color:rgba(255,255,255,0.9)}
  .mk-y u + u{margin-top:4px}
  .mk-d:hover .mk-y,.mk-d:focus-visible .mk-y{opacity:1;visibility:visible;transform:translateX(-50%) translateY(0)}
  .mk-d:first-of-type .mk-y{left:0;transform:translateX(0) translateY(4px)}
  .mk-d:first-of-type:hover .mk-y{transform:translateX(0) translateY(0)}
  .mk-d:first-of-type .mk-y::after{left:24px}
  .mk-p{margin:0;padding:0;list-style:none}
  .mk-p li{padding:clamp(15px,1.8vw,19px) 0;border-top:1px solid #e2e9e0}
  .mk-p li:first-child{border-top:0;padding-top:0}
  .mk-p b{display:block;font-size:clamp(16px,1.85vw,18px);font-weight:750;letter-spacing:-0.015em;color:#16211a;text-wrap:balance}
  .mk-p p{margin:7px 0 0;max-width:52ch;font-size:14.5px;line-height:1.58;color:#4c5850;text-wrap:pretty}
  @media (max-width:960px){ .mk{grid-template-columns:1fr;gap:36px} }
  /* Dymek ma 230px i wisi nad kafelkiem szerokim na 57px — na telefonie
     wychodził 175px poza kadr, a bez myszy i tak się nie pokazuje. Treść dnia
     niesie aria-label i lista pod kalendarzem. */
  @media (max-width:760px){ .mk-y{display:none} }

  /* ================= trzy fazy projektu (ciemny pas) ==================
     Każda faza ma własną parę słupków i własną skalę, bo w jednym
     wspólnym pasku skrócenie z dwóch tygodni do jednego było
     niewidoczne obok dwunastotygodniowego ogona.
     Nad wykresem suma całości, żeby od razu było widać, o czym mowa. */
  .fz-sum{display:flex;align-items:baseline;flex-wrap:wrap;gap:10px 18px;margin-top:clamp(30px,3.6vw,42px);padding-bottom:clamp(26px,3vw,34px);border-bottom:1px solid rgba(255,255,255,0.14)}
  .fz-sum b{font-size:clamp(30px,4.6vw,50px);line-height:1;letter-spacing:-0.04em;font-weight:800;color:rgba(255,255,255,0.42)}
  .fz-sum b.my{color:var(--la-accent,#00CD77)}
  .fz-sum i{font-style:normal;font-size:clamp(20px,2.6vw,28px);color:rgba(255,255,255,0.3)}
  .fz-sum span{font-size:14px;color:rgba(255,255,255,0.45)}
  .fz{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(24px,4vw,56px);margin-top:clamp(28px,3.4vw,40px)}
  .fz-k{min-width:0}
  .fz-t{margin:0;font-size:clamp(15.5px,1.8vw,17.5px);font-weight:750;letter-spacing:-0.015em;line-height:1.3;color:#ffffff;text-wrap:balance}
  .fz-o{display:block;margin-top:7px;min-height:calc(2 * 1.5em);font-size:13px;line-height:1.5;color:rgba(255,255,255,0.45);text-wrap:pretty}
  .fz-p{margin-top:clamp(16px,2vw,20px)}
  .fz-r{display:grid;grid-template-columns:66px minmax(0,1fr);gap:11px;align-items:center}
  .fz-r + .fz-r{margin-top:9px}
  .fz-r b{font-family:ui-monospace,Menlo,monospace;font-size:9.5px;letter-spacing:0.07em;text-transform:uppercase;color:rgba(255,255,255,0.34);font-weight:500}
  .fz-s{position:relative;display:flex;align-items:center;height:30px}
  .fz-s i{display:block;height:100%;width:0;min-width:26px;border-radius:6px;background:rgba(255,255,255,0.2);transition:width 1s cubic-bezier(.22,.85,.3,1);transition-delay:var(--d)}
  .fz-r.my .fz-s i{background:linear-gradient(90deg,#00CD77,#0a7a52)}
  .rv.in .fz-s i{width:var(--w)}
  .fz-s em{position:absolute;left:calc(var(--w) + 12px);font-style:normal;font-family:ui-monospace,Menlo,monospace;font-size:12.5px;font-weight:700;color:rgba(255,255,255,0.5);white-space:nowrap;opacity:0;transition:opacity .5s ease;transition-delay:calc(var(--d) + .55s)}
  .fz-r.my .fz-s em{color:#ffffff}
  .rv.in .fz-s em{opacity:1}
  .fz-z{display:block;margin-top:11px;font-family:ui-monospace,Menlo,monospace;font-size:12px;letter-spacing:0.04em;color:var(--la-accent,#00CD77)}
  .dw-cta{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:20px 32px;margin-top:clamp(34px,4vw,50px);padding:clamp(22px,2.6vw,30px) clamp(24px,2.8vw,34px);border:1px solid rgba(255,255,255,0.18);border-radius:18px;background:rgba(255,255,255,0.04)}
  .dw-cta p{margin:0;max-width:640px;font-size:clamp(16px,1.9vw,19px);line-height:1.5;color:#ffffff;text-wrap:pretty}
  .btn-jasny{display:inline-flex;align-items:center;gap:9px;flex-shrink:0;background:var(--la-accent,#00CD77);color:#0b1a11;padding:15px 26px;border-radius:11px;font-weight:700;font-size:15.5px;transition:background .2s}
  .btn-jasny:hover{background:#ffffff}
  @media (max-width:860px){ .fz{grid-template-columns:1fr;gap:30px} .fz-o{min-height:0} }
  @media (prefers-reduced-motion:reduce){ .fz-s i,.fz-s em{transition:none} }

  /* ================= skład: dwa wiersze i pięć kolumn ================== */
  .os-s{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(20px,3vw,44px);margin-top:clamp(24px,2.8vw,32px)}
  .os-i{display:grid;grid-template-columns:auto minmax(0,1fr);gap:16px;align-items:center}
  .os-a{display:flex;align-items:center}
  .os-a > *{margin-left:-11px}
  .os-a > *:first-child{margin-left:0}
  /* znak autorskiego narzędzia: ciemny kwadrat obok okrągłych twarzy —
     kontrast kształtu sam mówi, że to nie człowiek */
  .os-z{flex-shrink:0;display:block;width:48px;height:48px;border-radius:13px;background:#0e2b1d;box-shadow:0 10px 22px -14px rgba(14,43,29,0.7)}
  .os-t{display:block;font-size:clamp(16.5px,1.9vw,19px);font-weight:750;letter-spacing:-0.015em;color:#16211a}
  .os-d{display:block;margin-top:5px;max-width:38ch;font-size:14.5px;line-height:1.5;color:#4c5850;text-wrap:pretty}
