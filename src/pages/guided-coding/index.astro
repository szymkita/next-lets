  .km-pisze{display:flex;gap:4px;padding:12px 13px;border-radius:12px 12px 12px 4px;background:#f2f3ef}
  .km-pisze i{display:block;width:6px;height:6px;border-radius:50%;background:#9aa49e;animation:km-kropka 1.2s ease-in-out infinite}
  .km-pisze i:nth-child(2){animation-delay:.15s}
  .km-pisze i:nth-child(3){animation-delay:.3s}
  @keyframes km-kropka{0%,60%,100%{opacity:.35;transform:none}30%{opacity:1;transform:translateY(-2px)}}
  .km-ses{display:flex;align-items:center;gap:9px;padding:10px 12px;border-radius:12px;background:var(--ink);color:#ffffff;font-size:12.5px;font-weight:600}
  .km-ses svg{display:block;flex-shrink:0;width:14px;height:14px;fill:var(--ziel)}
  .km-zas{border-radius:10px;overflow:hidden;box-shadow:0 0 0 1px rgba(15,26,20,0.08)}
  .km-zas span{display:flex;align-items:center;gap:6px;padding:5px 10px;background:#fafaf8;border-bottom:1px solid #eef0ec;font-family:var(--mono);font-size:10.5px;color:var(--t3)}
  .km-zas span svg{display:block;width:11px;height:11px;fill:currentColor}
  .km-zas code{display:block;padding:9px 10px;background:#effaf4;box-shadow:inset 2px 0 0 var(--ziel);font-family:var(--mono);font-size:11.5px;line-height:1.5;color:var(--t1)}
  .km-st{display:flex;align-items:baseline;flex-wrap:wrap;gap:4px 10px;margin-top:16px;padding-top:14px;border-top:1px solid var(--linia2)}
  .km-st b{font-size:clamp(20px,1.9vw,26px);font-weight:700;letter-spacing:-0.035em;line-height:1.1}
  .km-st span{font-size:13px;line-height:1.4;color:var(--t2)}
  .km-k:not(.my) .km-st b{color:var(--burs-c)}
  .km-k.my .km-st b{color:var(--ziel-c)}
  .km.gra .km-t > *,.km.gra .km-st{opacity:0;transform:translateY(6px)}
  .km.gra.on .km-t > *,.km.gra.on .km-st{opacity:1;transform:none;transition:opacity .35s ease calc(.3s + var(--i) * .55s),transform .45s cubic-bezier(.2,.8,.2,1) calc(.3s + var(--i) * .55s)}
  @media (prefers-reduced-motion:reduce){ .km-pisze i{animation:none;opacity:.7} }
  @media (max-width:900px){ .km-g{grid-template-columns:minmax(0,1fr)} }
  @media (max-width:420px){ .km-k{padding:16px 14px 16px} .km-m{max-width:100%} }

  /* =====================================================================
     PRZYKŁADY · co widzimy prawie zawsze (karty w przewijanym rzędzie)
     Rząd i karta biorą klasy .dw-sc / .dw4-k ze Styl; środek własny:
