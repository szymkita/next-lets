    .pw-n{grid-row:1;padding-top:1px}
    .pw-s{grid-column:2;padding-top:4px;font-size:11px}
    .pw-zs{grid-template-columns:minmax(0,1fr)}
    .pw-zs span{grid-row:auto;grid-column:auto !important}
    .pw-zs span::before{display:none}
  }

  /* =====================================================================
     DLACZEGO 2 · ta sama korekta faktury w dwóch rozmowach
     Wiadomości wchodzą po kolei w obu kolumnach naraz; lewa trwa dłużej
     i kończy się kolejną odpowiedzią modelu w toku.
     ===================================================================== */
  .km-g{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(12px,1.4vw,20px);margin:0 clamp(2px,0.8vw,14px)}
  .km-k{display:flex;flex-direction:column;min-width:0;padding:20px 20px 18px;border-radius:18px;background:#ffffff;box-shadow:0 0 0 1px rgba(15,26,20,0.06)}
