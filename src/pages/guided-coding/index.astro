<script is:inline>
(function () {
  var el = document.querySelectorAll('[data-skala]');
  function skaluj() {
    el.forEach(function (e) {
      var w = +e.getAttribute('data-skala');
      var p = e.parentElement.clientWidth;
      e.style.zoom = p && p < w ? (p / w).toFixed(4) : '';
    });
  }
  skaluj();
  window.addEventListener('resize', skaluj);
})();
</script>

