---
// HUB /guided-coding — spec v2 (zastępuje v1)
//
// ZMIANA KIERUNKU: ze strachu na rzemiosło.
// v1 stała na rachunku za ryzyko, wycieku danych i zegarze CRA. To ustawiało
// nas jako tego, kto znalazł problem — czyli tego, kto chce sprzedać
// rozwiązanie. FAQ „nie będziemy nic wciskać" było plastrem na ranę, którą
// strona sama zadawała kilka sekcji wyżej.
//
// v2 stoi na jednym zdaniu, prawdziwym dla obu segmentów i niebędącym groźbą:
//   „Pierwsza wersja powstaje w weekend. Dziesiąta zmiana zajmuje miesiąc."
//
// WYPADŁO CAŁKOWICIE: rachunek za ryzyko, wszystkie wzmianki o CRA
// i regulacjach, statystyki 97/30/75, „Pytanie brzmi: które" w hero,
// kolumna „to zbudujcie z nami" w macierzy (publiczny upsell w miejscu,
// które miało budować zaufanie), nazwa „Score gotowości produkcyjnej".
import LaBase from '../../layouts/LaBase.astro';
import GcFaq from '../../components/GcFaq.astro';
import GcCta from '../../components/GcCta.astro';

const title = "Guided Coding — wsparcie dla firm, które budują software same | Let's automate";
const description = 'Pierwsza wersja powstaje w weekend, dziesiąta zmiana zajmuje miesiąc. Uczymy, jak utrzymać tempo — standardy, przegląd i opieka nad kodem tworzonym z AI. Nie zabieramy Wam klawiatury.';

// Sekcja 2 · Rozpoznanie — MOMENTY, nie zagrożenia.
// Żadna pozycja nie może się czytać jako „zrobiliście coś źle".
const rozpoznanie = [
  { kat: 'TEMPO', ico: 'gauge', h: 'Pierwsza wersja w weekend, dziesiąta zmiana w miesiąc', d: 'Na początku wszystko szło błyskawicznie. Dziś każda poprawka wymaga ostrożności i trwa dłużej niż poprzednia.' },
  { kat: 'ZAUFANIE', ico: 'shield', h: 'Boicie się ruszać to, co działa', d: 'Jest jedna część systemu, której nikt nie chce dotykać. Wszyscy ją omijają i wszyscy wiedzą która.' },
  { kat: 'PRZEKAZANIE', ico: 'handoff', h: 'Druga osoba nie umie tego odpalić', d: 'Uruchomienie projektu od zera wie tylko autor. Nikt tego nie spisał, bo nigdy nie było na to czasu.' },
  { kat: 'POWTARZALNOŚĆ', ico: 'repeat', h: 'Za każdym razem trochę inaczej', d: 'Każdy pracuje z AI po swojemu. Efekt jest nierówny, więc każdą zmianę trzeba czytać od początku.' },
  { kat: 'POMIAR', ico: 'chart', h: 'Nie wiecie, czy idzie lepiej', d: 'Wrażenie mówi, że tak. Ale nie ma liczby, do której dałoby się wrócić za kwartał.' },
  { kat: 'GRANICE', ico: 'compass', h: 'Nie wiecie, gdzie kończą się możliwości', d: 'Do którego momentu można iść samodzielnie, a kiedy warto zawołać kogoś — nie ma na to intuicji.' },
];

// Sekcja 7 · Co zwykle znajdujemy — bez liczb, dopóki nie ma statystyki.
// Obserwacje, nie zagrożenia. Każda kończy się skalą roboty, nie skalą szkody.
const obserwacje = [
  { os: 'DOSTĘPY', d: 'Klucze i hasła leżą w kodzie, bo na starcie tak było najszybciej. Przeniesienie ich w bezpieczne miejsce to zwykle dwie godziny roboty.' },
  { os: 'DANE', d: 'Aplikacja zbiera dane klientów, ale nikt nie ustalił, jak długo je trzyma i kto ma do nich dostęp. To decyzja, nie poprawka w kodzie.' },
  { os: 'PRZEKAZANIE', d: 'Uruchomić projekt od zera potrafi jedna osoba. Zwykle ta sama, która ma najwięcej innej roboty.' },
  { os: 'POWRÓT', d: 'Kopia zapasowa istnieje. Nikt nigdy nie sprawdził, czy da się z niej wrócić.' },
  { os: 'KOSZTY', d: 'Rachunek rośnie z każdym eksperymentem, bo po nieudanych nikt nie sprząta.' },
];

// Sekcja 8 · FAQ huba — tylko pytania O WYBÓR ŚCIEŻKI.
// Szczegółowe zostają na podstronach, żeby się nie dublowały.
const faq = [
  {
    q: 'Czy na koniec zaproponujecie nam duży projekt?',
    a: 'Przegląd kończy się listą rzeczy do zrobienia, w której najszersza część to „zróbcie sami" — z instrukcjami. Jeśli przy czymś naszym zdaniem warto pomóc, powiemy to i uzasadnimy. Wycenę dostaniecie tylko wtedy, gdy o nią poprosicie.',
  },
  {
    q: 'Jesteśmy pomiędzy tymi dwiema ścieżkami. Co wtedy?',
    a: 'Napiszcie w dwóch zdaniach, co macie. Odpowiemy, która ścieżka ma sens — także wtedy, gdy odpowiedź brzmi „na razie żadna".',
  },
  {
    q: 'Przejmujecie nasz kod?',
    a: 'Nie. Kod zostaje Wasz, w Waszym repozytorium. Wychodzicie z własnym sposobem pracy, nie z zależnością od nas.',
  },
  {
    q: 'To szkolenie?',
    a: 'Nie. Ze szkolenia wychodzi się z notatkami. Stąd wychodzicie z rzeczą: spisanymi zasadami, regułami dla narzędzi AI i definicją tego, co u Was znaczy „gotowe".',
  },
];
---
<LaBase title={title} description={description} ogImage="/og/hub.png" ctaHref="#rozwidlenie" ctaLabel="Zobacz ścieżki">
<style is:global slot="head">
  /* ---------- krzywa tempa w hero ---------- */
  .tempo-card{max-width:1000px;margin:clamp(36px,5vw,56px) auto 0;background:#ffffff;border:1px solid #e7ece4;border-radius:22px;padding:clamp(22px,3vw,32px);box-shadow:0 34px 74px -44px rgba(18,38,28,0.3)}
  .tempo-svg .t-line{stroke-dasharray:1;stroke-dashoffset:1;transition:stroke-dashoffset 1.6s ease .2s}
  .tempo-card.in .t-line{stroke-dashoffset:0}
  .tempo-svg .t-mark{opacity:0;transition:opacity .5s ease 1.4s}
  .tempo-card.in .t-mark{opacity:1}
  @media (prefers-reduced-motion:reduce){ .tempo-svg .t-line,.tempo-svg .t-mark{transition:none} }

  /* ---------- rozwidlenie: dwa różne światy, nie dwa warianty ---------- */
  .fork{display:flex;flex-direction:column;border-radius:22px;padding:clamp(28px,3.4vw,42px);transition:transform .3s cubic-bezier(.4,0,.2,1),box-shadow .3s,border-color .3s}
  .fork-a{background:#ffffff;border:1px solid #e7ece4;box-shadow:0 24px 50px -34px rgba(18,38,28,0.16)}
  .fork-a:hover{transform:translateY(-5px);border-color:var(--la-accent,#00CD77);box-shadow:0 34px 70px -34px rgba(18,38,28,0.28)}
  .fork-b{background:#0e2b1d;background-image:radial-gradient(520px 320px at 100% 0%, rgba(0,205,119,0.2), transparent 62%);border:1px solid #0e2b1d;box-shadow:0 24px 50px -30px rgba(14,43,29,0.5)}
  .fork-b:hover{transform:translateY(-5px);box-shadow:0 34px 70px -30px rgba(14,43,29,0.62)}
  .fork [aria-hidden="true"].arr{display:inline-block;transition:transform .18s}
  .fork:hover [aria-hidden="true"].arr{transform:translateX(4px)}
  @media (prefers-reduced-motion:reduce){ .fork{transition:none} .fork:hover{transform:none} }

  /* ---------- dwie ścieżki (sekcja 4) ---------- */
  .lanes .lane-path{stroke-dasharray:1;stroke-dashoffset:1;transition:stroke-dashoffset 1.6s ease .1s}
  .lanes.in .lane-path{stroke-dashoffset:0}
  .lanes .lane-dash{opacity:0;transition:opacity 1.1s ease .25s}
  .lanes.in .lane-dash{opacity:1}
  .lanes .lane-node{opacity:0;transform:translateY(6px);transition:opacity .5s ease,transform .5s ease}
  .lanes.in .lane-node{opacity:1;transform:none}
  @media (prefers-reduced-motion:reduce){ .lanes .lane-path,.lanes .lane-dash,.lanes .lane-node{transition:none} }

  /* ---------- kontra vibe / guided ---------- */
  .vs-row{display:grid;grid-template-columns:132px 1fr 1fr;gap:0;border-top:1px solid #e7ece4}
  .vs-row>*{padding:20px 22px}
  .vs-lab{font-family:ui-monospace,Menlo,monospace;font-size:11.5px;letter-spacing:0.1em;text-transform:uppercase;color:#808b83;display:flex;align-items:center}
  .vs-a{color:#8b968d;font-size:15px;line-height:1.5;border-left:1px solid #e7ece4}
  .vs-b{color:#16211a;font-size:15px;line-height:1.5;font-weight:650;border-left:1px solid #e7ece4;background:#ffffff}

  @media (max-width:900px){
    .lanes-chart{height:300px !important}
    .vs-row{grid-template-columns:1fr}
    .vs-row>*{padding:14px 18px}
    .vs-a,.vs-b{border-left:0}
    .vs-lab{padding-bottom:0}
  }
  /* Wykres skaluje się z viewBoxa 1000px: przy 350px kontenera podpisy z 14
     jednostek schodzą do ~5px. Na telefonie idą w górę, żeby wróciły do
     czytelnego rozmiaru. */
  @media (max-width:760px){
    .tempo-svg text{font-size:30px}
    .tempo-svg text[font-size="13.5"]{font-size:27px}
    /* Podpisy osi Y stoją przy lewej krawędzi rysunku (text-anchor:end),
       więc po powiększeniu wychodziły poza kadr — na telefonie zaczynają się
       w miejscu osi i idą w prawo, w wolne pole. */
    .tempo-svg .ax-y{text-anchor:start;font-size:26px}
  }
  @media (max-width:600px){
    .fork-meta{flex-direction:column !important;align-items:flex-start !important;gap:10px !important}
    .lanes-chart{height:250px !important}
    .segc{grid-template-columns:1fr !important}
    /* Etykiety punktów stoją w jednej linii (white-space:nowrap) i są
       wyśrodkowane na punkcie — najdłuższa wyjeżdżała 26px poza kadr.
       Na telefonie łamią się na dwie linie i mieszczą w wykresie. */
    .lane-node span:last-child{white-space:normal !important;max-width:132px;line-height:1.3;text-align:center}
  }
</style>

<!-- ============ S1 · HERO ============ -->
<section style="position:relative;overflow:hidden;background:radial-gradient(900px 520px at 82% -6%, rgba(0,205,119,0.14), transparent 62%), #ffffff;padding:clamp(28px,4vw,56px) max(clamp(20px,5vw,56px),calc((100% - 1440px) / 2)) clamp(56px,7vw,88px)">
<div style="display:flex;flex-direction:column;align-items:center;text-align:center">
<div class="eyebrow" style="color:#0a7a52;font-weight:650">Guided Coding</div>
<h1 style="margin:clamp(18px,2.6vw,28px) 0 0;font-size:clamp(29px,5vw,58px);line-height:1.06;letter-spacing:-0.035em;font-weight:800;color:#16211a;text-wrap:balance;max-width:960px">Budujecie sami. Zróbcie to tak, żeby nie zwolniło.</h1>
<p style="margin:26px 0 0;max-width:720px;font-size:clamp(17px,2.2vw,20px);line-height:1.5;color:#16211a;font-weight:650;text-wrap:pretty">Pierwsza wersja powstaje w weekend. Dziesiąta zmiana zajmuje miesiąc — i nikt nie wie dlaczego.</p>
<p style="margin:16px 0 0;max-width:760px;font-size:clamp(16px,2.1vw,18.5px);line-height:1.6;color:#33413a;text-wrap:pretty">To nie jest wina AI ani Waszych ludzi. Start stał się darmowy, a utrzymanie tempa to zupełnie inna umiejętność, której nikt nie dostał razem z narzędziem. Tej właśnie uczymy — i nie zabieramy Wam przy tym klawiatury.</p>
<div class="hero-actions" style="display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:16px 22px;margin-top:34px">
<a href="#rozwidlenie" class="btn-dark" style="display:inline-flex;align-items:center;gap:10px;background:#16211a;color:#ffffff;padding:18px 32px;border-radius:12px;font-weight:650;font-size:16.5px;box-shadow:0 14px 30px -14px rgba(16,33,26,0.45)">Zobacz, która ścieżka jest Wasza <span aria-hidden="true">→</span></a>
<a href="#metoda" class="btn-ghost" style="display:inline-flex;align-items:center;gap:8px;font-size:16.5px;font-weight:700;color:#16211a;background:rgba(255,255,255,0.6);backdrop-filter:blur(4px);padding:18px 26px;border-radius:12px;border:1px solid rgba(22,33,26,0.16)">Jak pracujemy →</a>
</div>
</div>

<!-- Wizual: krzywa tempa. Nie panel ze score'em ryzyka — to była groźba. -->
<div class="tempo-card">
<div style="display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:12px 24px">
<div style="font-family:ui-monospace,Menlo,monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#808b83">Tempo wprowadzania zmian</div>
<div style="display:flex;flex-wrap:wrap;gap:10px 22px">
<span style="display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:650;color:#16211a"><span style="display:block;width:22px;height:3px;border-radius:2px;background:var(--la-accent,#00CD77)"></span>z szynami</span>
<span style="display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:650;color:#8b968d"><span style="display:block;width:22px;height:3px;border-radius:2px;background:repeating-linear-gradient(90deg,#b9a08f 0 6px,transparent 6px 10px)"></span>bez szyn</span>
</div>
</div>
<svg class="tempo-svg" viewBox="0 0 1000 320" style="display:block;width:100%;height:auto;margin-top:14px" role="img" aria-label="Wykres: bez spisanych zasad tempo wprowadzania zmian spada z każdą kolejną zmianą; z szynami utrzymuje się na stałym poziomie.">
<defs>
<linearGradient id="gc-tempo-fill" x1="0" y1="0" x2="0" y2="1">
<stop offset="0" stop-color="#00CD77" stop-opacity="0.14"></stop>
<stop offset="1" stop-color="#00CD77" stop-opacity="0"></stop>
</linearGradient>
</defs>
<line x1="92" y1="70" x2="980" y2="70" stroke="#eef1ec" stroke-width="1" stroke-dasharray="3 7"></line>
<line x1="92" y1="150" x2="980" y2="150" stroke="#eef1ec" stroke-width="1" stroke-dasharray="3 7"></line>
<line x1="92" y1="230" x2="980" y2="230" stroke="#eef1ec" stroke-width="1" stroke-dasharray="3 7"></line>
<line x1="92" y1="272" x2="980" y2="272" stroke="#e3e7e0" stroke-width="1.5"></line>
<line x1="92" y1="44" x2="92" y2="272" stroke="#e3e7e0" stroke-width="1.5"></line>
<text class="ax-y" x="80" y="62" text-anchor="end" font-size="14" fill="#b6bfb6" font-family="ui-monospace,Menlo,monospace">szybko</text>
<text class="ax-y" x="80" y="248" text-anchor="end" font-size="14" fill="#b6bfb6" font-family="ui-monospace,Menlo,monospace">wolno</text>

<path class="t-line" d="M110,66 C200,70 250,88 320,112 C400,140 450,190 540,214 C650,242 760,250 970,254" fill="none" stroke="#c2a894" stroke-width="3" stroke-linecap="round" stroke-dasharray="1" pathLength="1"></path>
<path d="M110,96 C240,99 340,101 470,103 C640,106 800,108 970,110 L970,272 L110,272 Z" fill="url(#gc-tempo-fill)" opacity="0.9"></path>
<path class="t-line" d="M110,96 C240,99 340,101 470,103 C640,106 800,108 970,110" fill="none" stroke="#00CD77" stroke-width="3.6" stroke-linecap="round" stroke-dasharray="1" pathLength="1"></path>

<g class="t-mark">
<line x1="540" y1="86" x2="540" y2="272" stroke="#d8dfd6" stroke-width="1" stroke-dasharray="4 5"></line>
<circle cx="540" cy="214" r="6" fill="#ffffff" stroke="#c2a894" stroke-width="3"></circle>
<circle cx="540" cy="104" r="6" fill="#ffffff" stroke="#00CD77" stroke-width="3"></circle>
<text x="556" y="166" font-size="14.5" font-weight="650" fill="#16211a" font-family="'Schibsted Grotesk',system-ui,sans-serif">ta różnica</text>
</g>
<text x="960" y="238" text-anchor="end" font-size="14.5" font-weight="650" fill="#a08a76" font-family="'Schibsted Grotesk',system-ui,sans-serif">bez szyn</text>
<text x="960" y="90" text-anchor="end" font-size="14.5" font-weight="700" fill="#0a7a52" font-family="'Schibsted Grotesk',system-ui,sans-serif">z szynami</text>

<text x="110" y="296" text-anchor="middle" font-size="13.5" fill="#8b968d" font-family="ui-monospace,Menlo,monospace">1.</text>
<text x="325" y="296" text-anchor="middle" font-size="13.5" fill="#8b968d" font-family="ui-monospace,Menlo,monospace">5.</text>
<text x="540" y="296" text-anchor="middle" font-size="13.5" fill="#8b968d" font-family="ui-monospace,Menlo,monospace">10.</text>
<text x="988" y="296" text-anchor="end" font-size="13.5" fill="#8b968d" font-family="ui-monospace,Menlo,monospace">20. zmiana</text>
</svg>
</div>
<p style="margin:20px auto 0;max-width:700px;text-align:center;font-size:15.5px;line-height:1.6;color:#4c5850;text-wrap:pretty">Nie chodzi o to, żeby zacząć szybciej. Chodzi o to, żeby dziesiąta zmiana szła tak samo sprawnie jak pierwsza.</p>
</section>

<!-- ============ TRUST ============ -->
<div style="display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:12px 28px;padding:26px max(clamp(20px,5vw,56px),calc((100% - 1440px) / 2));border-top:1px solid #eef1ec;border-bottom:1px solid #eef1ec;background:#ffffff;font-size:14px;color:#4c5850">
<span><strong style="color:#16211a;font-weight:700">200+ wdrożeń</strong> tą samą metodą, której uczymy</span>
<span style="color:#dfe4dd">·</span>
<span><strong style="color:#16211a;font-weight:700">140+ firm</strong> zmienia z nami sposób działania</span>
<span style="color:#dfe4dd">·</span>
<span style="display:inline-flex;align-items:center;gap:9px">Zaplecze grupy doradczej <img src="/uploads/wisegroup_logo_v2.webp" alt="Wise Group" style="height:14px;width:auto;display:block;opacity:0.7"></span>
</div>

<!-- ============ S2 · ROZPOZNANIE ============ -->
<section id="rozpoznanie" class="sec-pad">
<div class="sec-head">
<h2 class="h-sec" style="margin:0;max-width:420px;text-wrap:pretty">Znajome?</h2>
<p class="sub" style="margin:0 0 6px;max-width:520px">Żadna z tych rzeczy nie znaczy, że zrobiliście coś źle. Znaczy tylko, że projekt wszedł w etap, w którym potrzeba innych narzędzi niż na starcie.</p>
</div>
<div class="grid3" style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:22px;margin-top:56px">
{rozpoznanie.map((r) => (
  <div class="lift rv" style="background:#ffffff;border:1px solid #e7ece4;border-radius:18px;padding:28px 26px 26px;box-shadow:0 24px 50px -34px rgba(18,38,28,0.14)">
    <span style="display:flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:11px;background:#e9f2ea;color:#0a7a52">
      {r.ico === 'gauge' && <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 18a9 9 0 1 1 17 0"/><path d="M12 14l4-3.5"/></svg>}
      {r.ico === 'shield' && <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 4.5-3.2 7.9-8 9-4.8-1.1-8-4.5-8-9V6l8-3z"/></svg>}
      {r.ico === 'handoff' && <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h11"/><path d="M12 8l4 4-4 4"/><path d="M20 4v16"/></svg>}
      {r.ico === 'repeat' && <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10a6 6 0 0 1 6-6h9"/><path d="M16 1l3 3-3 3"/><path d="M20 14a6 6 0 0 1-6 6H5"/><path d="M8 23l-3-3 3-3"/></svg>}
      {r.ico === 'chart' && <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="M7 15l4-5 3 3 5-7"/></svg>}
      {r.ico === 'compass' && <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-2 5-5 2 2-5 5-2z"/></svg>}
    </span>
    <div style="margin-top:20px;font-family:ui-monospace,Menlo,monospace;font-size:11px;letter-spacing:0.1em;color:#808b83">{r.kat}</div>
    <div style="margin-top:8px;font-size:19px;font-weight:750;line-height:1.25;letter-spacing:-0.01em;color:#16211a">{r.h}</div>
    <p style="margin:9px 0 0;font-size:14.5px;line-height:1.6;color:#4c5850">{r.d}</p>
  </div>
))}
</div>
</section>

<!-- ============ S3 · ROZWIDLENIE (sekcja główna huba) ============ -->
<!-- Awansuje zaraz za rozpoznanie. Reszta strony ma tylko doprowadzić
     czytelnika do właściwych drzwi. Karty muszą się czytać jako DWA RÓŻNE
     ŚWIATY, nie dwa warianty tego samego — stąd światło kontra ciemność. -->
