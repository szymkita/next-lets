  .zn-zas span svg{display:block;width:11px;height:11px;fill:currentColor}
  .zn-zas code{display:block;padding:9px 10px;background:#effaf4;box-shadow:inset 2px 0 0 var(--ziel);font-family:var(--mono);font-size:11.5px;line-height:1.5;color:var(--t1)}
