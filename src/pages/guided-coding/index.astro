---
<LaBase topbar={false} title={title} description={description} ctaHref="#kontakt" ctaLabel="Umów rozmowę" nav="uslugi">
<script type="application/ld+json" is:inline set:html={JSON.stringify(dane)} slot="head"></script>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap" slot="head">
<style is:global slot="head">
  /* Style tej usługi. Wspólny wygląd: src/components/usluga/Styl.astro. */

  /* =====================================================================
     HERO · historia zmian w repozytorium i plik zasad
     Lewa kolumna: zmiany z dziś i z wczoraj, każda ze stanem sprawdzenia.
     Dwa górne wiersze grają: eksport dostaje uwagę w czterech częściach,
     przychodzi poprawka, a w prawej kolumnie dopisuje się zasada 19.
     W markupie stan końcowy (bez JS, przy ograniczonym ruchu). Wiersze
     zwijają się przez grid-template-rows 0fr/1fr.
     ===================================================================== */
  .hz{--a1:#18181b;--a2:#52525b;--a3:#71717a;--a4:#a1a1aa;--al:rgba(9,9,11,0.08);--al2:rgba(9,9,11,0.05);--zl:#047857;--zlt:rgba(16,185,129,0.1);--bu:#a15c07;--but:rgba(245,158,11,0.13);
    position:relative;margin:0;font-size:12.5px;line-height:1.4;color:var(--a1);letter-spacing:-0.004em;-webkit-font-smoothing:antialiased}
  .hz .hi{display:block;flex-shrink:0;width:14px;height:14px;fill:currentColor}
  .hz-okno{position:relative;overflow:hidden;border-radius:12px;background:#ffffff;
    box-shadow:0 0 0 1px rgba(255,255,255,0.14),0 0 0 1.5px rgba(0,0,0,0.3),0 50px 100px -40px rgba(0,0,0,0.9),0 18px 36px -20px rgba(0,0,0,0.55)}
  .hz-tyt{display:flex;align-items:center;gap:12px;height:40px;padding:0 14px;background:#f7f7f6;border-bottom:1px solid var(--al)}
  .hz-sw{display:flex;gap:7px;flex-shrink:0}
  .hz-sw i{display:block;width:11px;height:11px;border-radius:50%;background:#ff5f57;box-shadow:inset 0 0 0 0.5px rgba(0,0,0,0.18)}
  .hz-sw i:nth-child(2){background:#febc2e}
  .hz-sw i:nth-child(3){background:#28c840}
  .hz-repo{display:flex;align-items:center;gap:7px;min-width:0;margin-left:8px;font-size:12.5px;color:var(--a3);white-space:nowrap;overflow:hidden}
  .hz-repo b{font-weight:600;color:var(--a1)}
  .hz-gal{flex-shrink:0;display:inline-flex;align-items:center;height:22px;padding:0 8px;border-radius:6px;background:#ffffff;box-shadow:0 0 0 1px var(--al);font-family:var(--mono);font-size:11px;color:var(--a2)}
  .hz-ludzie{display:flex;margin-left:auto;padding-left:6px}
  .hz-ludzie img{display:block;width:24px;height:24px;margin-left:-6px;border-radius:50%;object-fit:cover;box-shadow:0 0 0 2px #f7f7f6}
  .hz-ludzie img.my{margin-left:6px;box-shadow:0 0 0 2px #f7f7f6,0 0 0 3.5px #10b981}
  .hz-uk{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);height:470px;transition:opacity .45s ease}
  .hz.znika .hz-uk{opacity:0}
  .hz-lista{min-width:0;overflow:hidden;padding:16px 22px 0}
  .hz-gl{display:flex;align-items:baseline;gap:10px;padding-bottom:4px}
  .hz-gl b{font-size:15px;font-weight:600;letter-spacing:-0.015em}
  .hz-gl span{font-size:12px;color:var(--a4)}
  .hz-dz{padding:12px 0 2px;font-size:11px;font-weight:550;color:var(--a4)}
  .hz-w,.hz-kw,.hz-z{display:grid;grid-template-rows:1fr;transition:grid-template-rows .55s cubic-bezier(.2,.8,.2,1),opacity .35s ease}
  .hz-w > div,.hz-kw > div,.hz-z > div{min-height:0;overflow:hidden}
  .hz-w.ukr,.hz-kw.ukr,.hz-z.ukr{grid-template-rows:0fr;opacity:0}
  .hz.bez-tr *{transition:none !important}
  .hz-r{display:grid;grid-template-columns:28px minmax(0,1fr) auto;gap:12px;align-items:center;padding:10px 0;border-bottom:1px solid var(--al2)}
  .hz-r > img{width:28px;height:28px;border-radius:50%;object-fit:cover;outline:1px solid rgba(0,0,0,0.06);outline-offset:-1px}
  .hz-r > span{min-width:0}
  .hz-r b{display:block;font-size:13px;font-weight:550;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .hz-r small{display:block;margin-top:1px;font-size:11.5px;color:var(--a4);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .hz-st{display:inline-flex;align-items:center;height:24px;padding:0 9px 0 7px;border-radius:999px;font-size:11.5px;font-weight:550;white-space:nowrap;color:var(--zl);background:var(--zlt);transition:background .3s,color .3s}
  .hz-st > span{display:none;align-items:center;gap:5px}
  .hz-st .hi{width:13px;height:13px}
  .hz-st[data-s="spr"]{color:var(--a2);background:rgba(9,9,11,0.05)}
  .hz-st[data-s="uw"]{color:var(--bu);background:var(--but)}
  .hz-st[data-s="spr"] > .s-spr,.hz-st[data-s="uw"] > .s-uw,.hz-st[data-s="ok"] > .s-ok,.hz-st[data-s="pop"] > .s-pop{display:inline-flex}
  .hz-st .s-spr .hi{animation:hz-krec 1.1s linear infinite}
  @keyframes hz-krec{to{transform:rotate(360deg)}}
  /* uwaga prowadzącego: otwarta (cztery części) i zamknięta (jedna linia) */
  .hz-ko{margin:2px 0 12px 40px;padding:12px 14px;border-radius:10px;background:#fffbf3;box-shadow:inset 0 0 0 1px rgba(245,158,11,0.32)}
  .hz-ko-gl{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--a3);white-space:nowrap}
  .hz-ko-gl img{width:22px;height:22px;border-radius:50%;object-fit:cover}
  .hz-ko-gl b{font-weight:600;color:var(--a1)}
  .hz-ko dl{display:grid;grid-template-columns:118px minmax(0,1fr);gap:5px 12px;margin:10px 0 0}
  .hz-ko dt{font-size:11.5px;font-weight:550;color:var(--a3)}
  .hz-ko dd{margin:0;font-size:12.5px;line-height:1.4;color:var(--a1)}
  .hz-kz{display:flex;align-items:center;gap:7px;margin:0 0 4px 40px;padding:7px 0 6px;font-size:12px;color:var(--a3);white-space:nowrap}
  .hz-kz img{width:18px;height:18px;border-radius:50%;object-fit:cover;flex-shrink:0}
  .hz-kz span{min-width:0;overflow:hidden;text-overflow:ellipsis}
  .hz-kz em{margin-left:auto;padding-left:8px;font-style:normal;font-weight:550;color:var(--zl)}
  /* plik zasad */
  .hz-zas{display:flex;flex-direction:column;min-width:0;overflow:hidden;border-left:1px solid var(--al);background:#fcfcfb}
  .hz-plik{display:flex;align-items:center;gap:7px;height:46px;flex-shrink:0;padding:0 18px;border-bottom:1px solid var(--al);font-size:12.5px;color:var(--a3);white-space:nowrap}
  .hz-plik b{font-weight:600;color:var(--a1)}
  .hz-plik em{margin-left:auto;font-style:normal;font-size:11.5px;color:var(--a4)}
  .hz-km{padding:12px 18px 2px;font-family:var(--mono);font-size:11px;color:var(--a4)}
  .hz-zl{margin:0;padding:4px 10px 0;list-style:none}
  .hz-zr{display:grid;grid-template-columns:22px minmax(0,1fr);gap:8px;padding:9px 8px;border-radius:8px;transition:background .5s,box-shadow .5s}
  .hz-zr > i{font-style:normal;font-family:var(--mono);font-size:11px;line-height:18px;color:var(--a4)}
  .hz-zr > span{min-width:0}
  .hz-zr b{display:block;font-size:12.5px;line-height:18px;font-weight:550}
  .hz-zr small{display:block;margin-top:2px;font-size:11px;color:var(--a4);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .hz-zr small em{font-style:normal;font-weight:600;color:var(--zl)}
  .hz-z.nowa .hz-zr{background:rgba(16,185,129,0.08);box-shadow:inset 2px 0 0 #10b981}
  .hz-z.nowa .hz-zr > i{color:var(--zl);font-weight:600}
  .hz-z.ukr b{clip-path:inset(0 100% 0 0)}
  .hz-z.nowa b{clip-path:inset(0 0 0 0);transition:clip-path 1.2s steps(30,end) .5s}
  @media (max-width:900px){
    .hz-uk{grid-template-columns:minmax(0,1fr);height:auto}
    .hz-lista{height:400px}
    .hz-zas{border-left:0;border-top:1px solid var(--al)}
    .hz-zl > li:nth-child(-n+3){display:none}
    .hz-zl{padding-bottom:10px}
  }
  @media (max-width:600px){
    .hz-gal,.hz-ludzie{display:none}
    .hz-lista{padding:12px 14px 0;height:440px}
    .hz-r{grid-template-columns:24px minmax(0,1fr);gap:4px 10px}
    .hz-r > img{width:24px;height:24px}
    .hz-r .hz-st{grid-column:2;justify-self:start}
    .hz-ko{margin-left:0}
    .hz-ko dl{grid-template-columns:minmax(0,1fr);gap:1px}
    .hz-ko dd{margin-bottom:6px}
    .hz-kz{margin-left:0}
    .hz-plik em{display:none}
    .hz-plik,.hz-km{padding-left:14px;padding-right:14px}
  }

  /* =====================================================================
     FORMY · audyt na start, potem abonament albo cykl warsztatów
     Audyt na całą szerokość: opis, czas i link po lewej, raport po
     prawej. Pod nim rozwidlenie: linia od ikony audytu schodzi prosto do
     karty wsparcia, w połowie odchodzi od niej gałąź do karty warsztatów.
     Dwie karty obok siebie, wsparcie (usługa docelowa) szersze, wszystkie
     w jednym kolorze. W karcie pasek zasad: ikona formy i kropka na każdą
     zasadę. Pasek wsparcia nie ma końca (gaśnie przy krawędzi karty),
     pasek warsztatów kończy kreska — cykl z datą końca. Kropki: najpierw
     audyt, potem obie drogi naraz (data-gra); bez JS i przy ograniczonym
     ruchu stan końcowy. Do 1100 px karty jedna pod drugą, między dwiema
     drogami „albo".
     ===================================================================== */
  .rw{--px:clamp(22px,2.3vw,34px);--gap:clamp(30px,3.2vw,48px);--kr:rgba(15,26,20,0.22);margin-top:clamp(72px,9vw,136px);scroll-margin-top:90px}
  .dr-k{position:relative;display:flex;flex-direction:column;min-width:0;padding:clamp(24px,2.4vw,32px) var(--px) clamp(26px,2.6vw,34px);border-radius:26px;background:#ffffff;box-shadow:0 0 0 1px rgba(15,26,20,0.06),0 30px 60px -44px rgba(7,20,13,0.35)}
  .dr-start{margin-top:clamp(28px,3.4vw,44px)}
  .dr-g{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:var(--gap);margin:0;padding:0;list-style:none}
  /* pasek zasad */
  .dr-tor{position:relative;display:flex;align-items:center;gap:12px;height:30px;margin:0 calc(var(--px) * -1);padding:0 var(--px)}
  .dr-tor::before{content:"";position:absolute;left:var(--px);right:var(--px);top:50%;height:2px;margin-top:-1px;background:rgba(15,26,20,0.16)}
  .dr-k.wsparcie .dr-tor::before{right:0;background:linear-gradient(90deg,rgba(15,26,20,0.16) 70%,rgba(15,26,20,0))}
  .dr-k.warsztaty .dr-tor::after{content:"";position:absolute;top:50%;right:var(--px);width:2px;height:16px;margin-top:-8px;border-radius:1px;background:var(--t1)}
  .dr-nr{position:relative;flex-shrink:0;display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--ink);color:var(--ziel)}
  .dr-nr svg{display:block;width:14px;height:14px;fill:currentColor}
  .dr-zs{position:relative;display:flex;align-items:center;gap:clamp(4px,0.45vw,7px)}
  .dr-zs i{display:block;flex-shrink:0;width:10px;height:10px;border-radius:50%;background:var(--ziel);box-shadow:0 0 0 3px #ffffff}
  .dr-kto{display:flex;align-items:center;gap:9px;margin:12px 0 0;font-size:12.5px;line-height:1.35;color:var(--t3)}
  .dr-kto img{flex-shrink:0;width:24px;height:24px;border-radius:50%;object-fit:cover}
  .dr-kto img.my{box-shadow:0 0 0 2px #ffffff,0 0 0 3.5px var(--ziel)}
  .dr-kto b{font-weight:700;color:var(--t1)}
  /* rozwidlenie między audytem a dwiema drogami */
  .dr-roz{position:relative;display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);column-gap:var(--gap);height:clamp(64px,6vw,84px)}
  .dr-roz > span{position:relative;display:block}
  .dr-roz > span:first-child::before{content:"";position:absolute;left:calc(var(--px) + 14px);top:0;bottom:0;width:2px;background:var(--kr)}
  .dr-roz > span:first-child::after{content:"";position:absolute;left:calc(var(--px) + 15px);right:calc(var(--gap) * -1);top:50%;height:2px;margin-top:-1px;background:var(--kr)}
  .dr-roz > span:last-child::before{content:"";position:absolute;left:0;top:50%;bottom:0;width:calc(var(--px) + 16px);margin-top:-1px;border-top:2px solid var(--kr);border-right:2px solid var(--kr);border-top-right-radius:14px}
  .dr-roz i{position:absolute;left:calc(var(--px) + 11px);bottom:3px;width:8px;height:8px;border-right:2px solid rgba(15,26,20,0.42);border-bottom:2px solid rgba(15,26,20,0.42);transform:rotate(45deg)}
  .dr-roz em{position:absolute;z-index:1;left:calc(var(--px) + 34px);top:50%;transform:translateY(-50%);padding:0 12px;background:var(--papier);font-style:normal;font-size:13px;font-weight:700;color:var(--t2);white-space:nowrap}
  /* treść karty */
  .dr-e{display:block;margin-top:clamp(28px,2.8vw,38px);font-size:13px;font-weight:700;color:var(--ziel-c)}
  .dr-k h4{margin:8px 0 0;font-size:clamp(25px,2.2vw,32px);line-height:1.08;letter-spacing:-0.035em;font-weight:700;text-wrap:balance}
  .dr-d{margin:12px 0 0;font-size:15px;line-height:1.6;color:var(--t2);text-wrap:pretty}
  .dr-art{margin:22px 0 28px}
  /* audyt: raport */
  .dr-rap{border-radius:14px;background:#fbfbf9;box-shadow:inset 0 0 0 1px rgba(15,26,20,0.08);overflow:hidden}
  .dr-rap-gl{display:flex;align-items:center;gap:8px;padding:10px 14px;border-bottom:1px solid rgba(15,26,20,0.07);font-size:12.5px;white-space:nowrap}
  .dr-rap-gl svg{display:block;flex-shrink:0;width:14px;height:14px;fill:var(--t3)}
  .dr-rap-gl b{font-weight:700}
  .dr-rap-gl span{min-width:0;margin-left:auto;color:var(--t3);overflow:hidden;text-overflow:ellipsis}
  .dr-rap-g{display:flex;align-items:center;gap:7px;padding:12px 14px 3px;font-size:11.5px;font-weight:700;color:var(--t3)}
  .dr-rap-g.n{color:var(--burs-c)}
  .dr-rap-g.n i{display:block;flex-shrink:0;width:8px;height:8px;border-radius:2px;background:var(--burs)}
  .dr-rap-w{margin:0 14px;padding:8px 0 9px;border-bottom:1px solid rgba(15,26,20,0.06)}
  .dr-rap-w b{display:block;font-size:13.5px;line-height:1.35;font-weight:650}
  .dr-rap-w span{display:flex;align-items:center;gap:6px;margin-top:3px;font-size:12px;line-height:1.35;color:var(--t3)}
  .dr-rap-w span svg{display:block;flex-shrink:0;width:12px;height:12px;fill:currentColor}
  .dr-rap-p{margin:0;padding:2px 14px 13px;font-size:13px;line-height:1.5;color:var(--t2)}
  /* wsparcie: dwie kadencje */
  .dr-kad-gl{display:block;padding-top:2px;font-size:12.5px;font-weight:700;color:var(--t3)}
  .dr-kad{margin:8px 0 0;padding:0;list-style:none}
  .dr-kad li{display:grid;grid-template-columns:30px minmax(0,1fr);gap:3px 12px;padding:15px 0 16px;border-top:1px solid rgba(15,26,20,0.08)}
  .dr-kad li > i{grid-row:span 2;display:grid;place-items:center;width:30px;height:30px;border-radius:9px;background:#e6f8ef;color:var(--ziel-c)}
  .dr-kad li > i svg{display:block;width:14px;height:14px;fill:currentColor}
  .dr-kad b{font-size:15.5px;font-weight:700;color:var(--t1)}
  .dr-kad span{font-size:15px;line-height:1.55;color:var(--t2)}
  /* warsztaty: zasada dopisana przez zespół */
  .dr-zas{border-radius:12px;overflow:hidden;box-shadow:0 0 0 1px rgba(15,26,20,0.08)}
  .dr-zas > span{display:flex;align-items:center;gap:6px;padding:7px 12px;background:#fafaf8;border-bottom:1px solid #eef0ec;font-family:var(--mono);font-size:11px;color:var(--t3);white-space:nowrap;overflow:hidden}
  .dr-zas > span svg{display:block;flex-shrink:0;width:12px;height:12px;fill:currentColor}
  .dr-zas code{display:block;padding:10px 12px;background:#effaf4;box-shadow:inset 2px 0 0 var(--ziel);font-family:var(--mono);font-size:12px;line-height:1.55;color:var(--t1)}
  .dr-zas code i{font-style:normal;color:var(--ziel-c)}
  .dr-zas p{display:flex;align-items:center;gap:8px;margin:0;padding:9px 12px;background:#ffffff;font-size:12.5px;line-height:1.4;color:var(--t2)}
  .dr-zas p img{flex-shrink:0;width:22px;height:22px;border-radius:50%;object-fit:cover}
  /* czas, stawka, link */
  .dr-war{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);gap:16px;margin-top:auto;padding-top:16px;border-top:1.5px solid var(--t1)}
  .dr-war span{display:block;font-size:12.5px;color:var(--t3)}
  .dr-war b{display:block;margin-top:3px;font-size:16px;font-weight:700;letter-spacing:-0.015em;line-height:1.3}
  .dr-war small{display:block;margin-top:3px;font-size:12.5px;line-height:1.4;color:var(--t2)}
  .dr-a{display:inline-flex;align-items:center;gap:14px;align-self:flex-start;justify-self:start;margin-top:24px;font-size:16px;font-weight:700;color:var(--t1)}
  .dr-a i{display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:var(--ink);color:var(--ziel);transition:transform .25s}
  .dr-a svg{display:block;width:15px;height:15px;fill:currentColor}
  .dr-a:hover i{transform:translateX(3px)}
  /* ruch: kropki po kolei (--i to numer w całej kolejności: audyt 0–4,
     obie drogi od 5 naraz), twarz z pierwszą kropką. Karty jedna pod
     drugą wchodzą osobno, więc liczą od swojej (--j). */
  .dr-gora.gra .dr-zs i{opacity:0;transform:scale(.3)}
  .dr-gora.gra.on .dr-zs i{opacity:1;transform:none;transition:opacity .25s ease calc(.3s + var(--i) * .09s),transform .4s cubic-bezier(.3,1.6,.5,1) calc(.3s + var(--i) * .09s)}
  .dr-gora.gra .dr-kto{opacity:0;transform:translateY(4px)}
  .dr-gora.gra.on .dr-kto{opacity:1;transform:none;transition:opacity .4s ease calc(.25s + var(--i) * .09s),transform .4s ease calc(.25s + var(--i) * .09s)}
  /* audyt szeroki: opis, czas i link po lewej, raport po prawej */
  @media (min-width:720px){
    .dr-start .dr-gora{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);grid-template-rows:auto auto auto 1fr auto;grid-template-areas:"tor tor" "kto kto" "tekst art" "war art" "a art";column-gap:clamp(28px,4.4vw,64px)}
    .dr-start .dr-tor{grid-area:tor}
    .dr-start .dr-kto{grid-area:kto}
    .dr-start .dr-tekst{grid-area:tekst}
    .dr-start .dr-art{grid-area:art;margin:clamp(28px,2.8vw,38px) 0 0}
    .dr-start .dr-war{grid-area:war;align-self:end;margin-top:28px}
    .dr-start .dr-a{grid-area:a}
  }
  /* na szerokim ekranie wiersze dwóch kart (czas i stawka, link) stoją na
     tej samej wysokości: góra karty, czas ze stawką i link to trzy
     wiersze wspólnej siatki */
  @media (min-width:1101px){
    .dr-g{grid-template-rows:repeat(3,auto);row-gap:0}
    .dr-g .dr-k{display:grid;grid-row:span 3;grid-template-rows:subgrid}
    .dr-g .dr-war{align-self:start;margin-top:0}
  }
  @media (max-width:1100px){
    .dr-g{grid-template-columns:minmax(0,1fr);--gap:28px}
    .rw{--gap:28px}
    .dr-roz{grid-template-columns:minmax(0,1fr);height:44px}
    .dr-roz > span:last-child,.dr-roz > span:first-child::after{display:none}
    .dr-g > .dr-k + .dr-k::before{content:"albo";position:absolute;left:var(--px);top:calc(var(--gap) * -1);height:var(--gap);display:flex;align-items:center;font-size:13px;font-weight:700;color:var(--t3)}
    .dr-g .dr-d,.dr-g .dr-art,.dr-g .dr-war{max-width:620px}
    .dr-gora.gra.on .dr-zs i{transition-delay:calc(.3s + var(--j) * .09s)}
    .dr-gora.gra.on .dr-kto{transition-delay:.25s}
  }
  /* tablet: karta szeroka, więc rysunek obok opisu, czas pod opisem,
     stawka pod rysunkiem */
  @media (min-width:720px) and (max-width:1100px){
    .dr-g .dr-gora{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);column-gap:clamp(28px,4vw,48px)}
    .dr-g .dr-tor,.dr-g .dr-kto{grid-column:1 / -1}
    .dr-g .dr-art{margin-top:clamp(28px,2.8vw,38px)}
    .dr-g .dr-tekst{padding-bottom:28px}
    .dr-g .dr-d,.dr-g .dr-art,.dr-g .dr-war{max-width:none}
    .dr-g .dr-war{grid-template-columns:minmax(0,1fr) minmax(0,1fr);column-gap:clamp(28px,4vw,48px)}
  }
  @media (max-width:420px){
    .dr-zs{gap:3px}
    .dr-zs i{width:9px;height:9px;box-shadow:0 0 0 2px #ffffff}
    .dr-tor{gap:9px}
    .dr-war{grid-template-columns:minmax(0,1fr);gap:10px}
    .dr-roz em{font-size:12.5px;padding:0 8px}
  }

  /* =====================================================================
     DLACZEGO 1 · dziesięć zmian w dwóch wariantach
     Zmiany wchodzą po kolei, każda ze swoim stanem; w wariancie „a"
     te same błędy wracają, w „b" każdy staje się zasadą pod spodem.
     Liczniki to stos cyfr: każda kolejna przykrywa poprzednią.
     ===================================================================== */
  .pw-wyk{display:grid;gap:clamp(30px,3.4vw,44px);margin:0 clamp(2px,0.8vw,14px)}
  .pw-r{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px 24px;align-items:end}
  .pw-et{grid-column:1;grid-row:1}
  .pw-licz{grid-column:2;grid-row:1}
  .pw-r > div:nth-child(2){grid-column:1 / -1;grid-row:2}
  .pw-et b{display:block;font-size:15px;font-weight:700;letter-spacing:-0.01em;line-height:1.3}
  .pw-et span{display:block;margin-top:3px;font-size:13px;line-height:1.45;color:var(--t3)}
  .pw-ch{display:grid;grid-template-columns:repeat(10,minmax(0,1fr));gap:6px;margin:0;padding:0;list-style:none}
  .pw-ch li{display:flex;flex-direction:column;min-width:0;min-height:100px;padding:9px;border-radius:10px;background:#ffffff;box-shadow:0 0 0 1px rgba(15,26,20,0.07);transition:background .3s ease,box-shadow .3s ease}
  .pw-n{font-family:var(--mono);font-size:10px;color:var(--t3)}
  .pw-ch b{display:block;margin-top:4px;font-size:12px;line-height:1.3;font-weight:650;color:var(--t1)}
  .pw-s{display:flex;align-items:flex-start;gap:4px;margin-top:auto;padding-top:8px;font-style:normal;font-size:11px;line-height:1.25;font-weight:650;color:var(--ziel-c)}
  .pw-s svg{display:block;flex-shrink:0;width:11px;height:11px;margin-top:1px;fill:currentColor}
  .pw-ch li.uw{background:#fff7ea;box-shadow:inset 0 0 0 1.5px rgba(214,134,30,0.6)}
  .pw-ch li.uw .pw-s{color:var(--burs-c)}
  .pw-ch li.zas{box-shadow:inset 0 0 0 1.5px rgba(0,205,119,0.6)}
  .pw-licz{position:relative;width:118px;height:40px}
  .pw-licz span{position:absolute;inset:0;display:flex;align-items:baseline;justify-content:flex-end;gap:7px;background:var(--papier)}
  .pw-licz b{font-size:clamp(30px,2.8vw,40px);font-weight:700;letter-spacing:-0.045em;line-height:1}
  .pw-licz small{font-size:13px;font-weight:600;color:var(--t3)}
  .pw-r.a .pw-licz b{color:var(--burs-c)}
  .pw-zs{display:grid;grid-template-columns:repeat(10,minmax(0,1fr));gap:6px;margin-top:10px}
  .pw-zs span{position:relative;grid-row:1;display:flex;gap:6px;padding:8px 10px;border-radius:9px;background:var(--ink);color:#ffffff;font-size:11.5px;line-height:1.35;font-weight:600}
  .pw-zs span::before{content:"";position:absolute;left:18px;top:-10px;width:1.5px;height:10px;background:var(--ink)}
  .pw-zs span i{font-style:normal;font-family:var(--mono);color:var(--ziel)}
  .pw.gra .pw-ch li.uw,.pw.gra .pw-ch li.zas{background:#ffffff;box-shadow:0 0 0 1px rgba(15,26,20,0.07)}
  .pw.gra .pw-s{opacity:0;transform:translateY(4px)}
  .pw.gra .pw-licz span + span{opacity:0}
  .pw.gra .pw-zs span{opacity:0;transform:translateY(-6px)}
  .pw.gra.on .pw-ch li.uw{background:#fff7ea;box-shadow:inset 0 0 0 1.5px rgba(214,134,30,0.6);transition-delay:calc(.4s + var(--i) * .42s)}
  .pw.gra.on .pw-ch li.zas{box-shadow:inset 0 0 0 1.5px rgba(0,205,119,0.6);transition-delay:calc(.4s + var(--i) * .42s)}
  .pw.gra.on .pw-s{opacity:1;transform:none;transition:opacity .3s ease calc(.4s + var(--i) * .42s),transform .4s ease calc(.4s + var(--i) * .42s)}
  .pw.gra.on .pw-licz span + span{opacity:1;transition:opacity .2s ease calc(.45s + var(--i) * .42s)}
  .pw.gra.on .pw-zs span{opacity:1;transform:none;transition:opacity .35s ease calc(.8s + var(--i) * .42s),transform .45s ease calc(.8s + var(--i) * .42s)}
  @media (max-width:1180px){
    .pw-ch{grid-template-columns:repeat(5,minmax(0,1fr))}
    .pw-zs{grid-template-columns:repeat(2,minmax(0,1fr))}
    .pw-zs span{grid-row:auto;grid-column:auto !important}
    .pw-zs span::before{display:none}
  }
  @media (max-width:760px){
    .pw-ch{grid-template-columns:repeat(2,minmax(0,1fr))}
    .pw-ch li{display:grid;grid-template-columns:22px minmax(0,1fr);column-gap:6px;min-height:0;padding:8px 10px}
