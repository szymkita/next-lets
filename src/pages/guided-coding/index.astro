---
// BUDUJECIE SAMI Z AI — hub trzeciej drogi, /guided-coding. Od 29.10.2026
// na produkcji (Szymon: „podmień”; dawna robocza /guided-coding-v5).
// Poprzednia produkcyjna: src/robocze/guided-coding-old2.astro; wersje
// v2–v4 w src/robocze (opis układu w v4). Nazwa pasa w megamenu dalej nie
// jest linkiem, jak w pozostałych dwóch pasach (docs/huby-koncepcja.md §9).
//
// RUNDA v5 (29.10.2026)
// Szymon o v4: „Czemu w analizie aplikacji jest Excel? Dlaczego to tam jest
// Excel, a nie jakiś gotowy system? Przecież to nie ma sensu.” i „Usuń też
// tego typu rzeczy, jak podgląd zmiany Adama. Przecież to jest totalny AI
// slop.” Do podstron: „powinno być bardzo szybko wiedzieć, po co, co ja z tego
// będę miał”; wsparcie: „że jesteśmy, prowadzimy was… doradzamy biznesowo
// i technicznie”; warsztaty: „100% kodu pisze u nas AI… wykorzystujecie być
// może tylko kilka procent tego, co jest możliwe”.
//   · h1 i lead mówią, po co ta droga: aplikacja zespołu ma rosnąć razem
//     z firmą i za rok dalej działać, bez zależności od jednej osoby;
//   · hero: logi z zakreślonymi NIP-ami zostają jako jedyny ekran
//     techniczny; Slack — zamiast polecenia do wklejenia rada Marcela przy
//     decyzji o Wrocławiu (jeden panel z oddziałami czy kopia), decyzja Anny;
//     terminal Claude Code → zaproszenie na sesję warsztatów (Adam przy
//     klawiaturze, Anna obok);
//   · analiza: Excel → sam panel zamówień z uwagami analizy na ekranie
//     (dane klientów w logach przy eksporcie, eksport stanie przy ~40 000,
//     panel zna tylko Poznań) i pierwsza strona raportu („można rozwijać
//     dalej, nie trzeba przepisywać”);
//   · wsparcie: podgląd zmiany na GitHubie → plan panelu na kwartał po
//     comiesięcznej rozmowie: przy każdej pozycji rada Marcela (techniczna
//     i biznesowa, także „nie budować, kupić gotowe”) i decyzja Anny;
//   · warsztaty: plik CLAUDE.md → jedno zadanie (rabat dla stałych klientów)
//     przed programem i po nim: kto, kiedy, ile dni; pod tym, jak pracujemy
//     u siebie (100% kodu pisze AI);
//   · akapity usług przepisane: po co i co firma z tego ma; ceny tylko
//     w tabelach faktów (jak /produkty).
//
// DO POTWIERDZENIA:
//   · ceny i czasy analizy (stała CENY): techniczna około 2 tygodni, od 12 000 zł
//     netto; techniczna i biznesowa około miesiąca, 12 000–20 000 zł netto —
//     zakresy na siebie zachodzą (może „do 12 000”);
//   · h1 „Pomagamy, żeby aplikacja Waszego zespołu rosła razem z firmą” i lead;
//   · „u nas 100% kodu pisze AI” (Szymon, 29.10.2026) w akapicie warsztatów
//     i pod obiektem warsztatów;
//   · 9 dni → 2 dni w obiekcie warsztatów: ta sama liczba co „aplikacja do
//     zamówień” w sześciu zespołach na podstronie warsztatów (twardy wynik);
//   · rady w planie wsparcia (np. aplikacja kurierska gotowa zamiast własnej)
//     są poglądowe, jak cała historia hurtowni;
//   · wsparcie: „około 4 godzin Waszego czasu w miesiącu”, wypowiedzenie
//     miesięczne (z podstrony wsparcia).
import LaBase from '../../layouts/LaBase.astro';
import Styl from '../../components/usluga/Styl.astro';
import Anim from '../../components/usluga/Anim.astro';
import Hero from '../../components/usluga/Hero.astro';
import Kontakt from '../../components/usluga/Kontakt.astro';
import { HI } from '../../components/usluga/ikony';

const kanon = new URL('/guided-coding', Astro.site).href;
const title = "Budujecie sami z AI — analiza aplikacji, bieżące wsparcie i warsztaty dla zespołu | Let's automate";
const description = 'Dla firm, w których zespół sam zbudował aplikację z AI w Claude Code albo w Codexie: analiza aplikacji, bieżące wsparcie z doradztwem technicznym i biznesowym oraz warsztaty, po których zespół pracuje z AI tak jak my.';

// Ceny i czasy w jednym miejscu (Szymon, 29.10.2026). Zob. DO POTWIERDZENIA.
const CENY = {
  techCzas: 'około 2 tygodni',
  techCena: 'od 12 000 zł netto',
  pelnaCzas: 'około miesiąca',
  pelnaCena: '12 000–20 000 zł netto',
  wsparcie: 'od 2900 zł miesięcznie',
};

const ANALIZA = [
  ['Dla kogo', 'firma, w której dział pracuje na aplikacji zbudowanej w Claude Code albo w Codexie, zanim aplikacja urośnie'],
  ['Czas', `analiza techniczna ${CENY.techCzas}, techniczna i biznesowa ${CENY.pelnaCzas}`],
  ['Cena', `<b>${CENY.techCena}</b> za techniczną, <b>${CENY.pelnaCena}</b> za techniczną i biznesową; stała kwota w ofercie po pierwszej rozmowie`],
  ['Co zostaje u Was', 'raport z rekomendacjami: co poprawić najpierw, co może poczekać i kto to zrobi; większość poprawek zespół robi sam, z instrukcją'],
];
const WSPARCIE = [
  ['Dla kogo', 'firma, w której jedna albo dwie osoby rozwijają aplikację i chcą mieć kogo zapytać, zanim podejmą większą decyzję'],
  ['Czas', 'abonament miesięczny, po Waszej stronie około 4 godzin w miesiącu; wypowiedzenie z miesięcznym terminem'],
  ['Cena', `<b>${CENY.wsparcie}</b> w zespole bez działu IT; dla działu IT stawka w ofercie po pierwszej rozmowie`],
  ['Co zostaje u Was', 'plan rozwoju aplikacji i zasady, których AI pilnuje przy każdej zmianie, także po wypowiedzeniu'],
];
const WARSZTATY = [
  ['Dla kogo', 'zespół, w którym aplikację rozwija kilka osób, albo dział IT, który od kilku miesięcy pracuje z AI'],
  ['Czas', 'sesje po dwie godziny co tydzień na Waszych sprawach; liczbę sesji ustalamy po analizie technicznej'],
  ['Cena', 'stała kwota za cały program w ofercie po analizie technicznej, którą wyceniamy osobno'],
  ['Co zostaje u Was', 'sposób pracy spisany w zasadach, które AI czyta przy każdej zmianie, i ludzie, którzy prowadzą zmianę od opisu do wdrożenia bez nas'],
];

const ARR = HI['arrow-right'];
const OSOBA = HI['user'];


// Analiza: lista zamówień w panelu (październik, oddział Poznań)
const ZAM = [
  ['ZAM-3398', 'Instal-Bud sp. z o.o.', 'Tomasz K.', '4 180,50', '6%', 'W realizacji'],
  ['ZAM-3397', 'Termo-Serwis s.c.', 'Karolina M.', '12 640,00', '8%', 'Wysłane'],
  ['ZAM-3396', 'Hydro-Tech', 'Tomasz K.', '2 980,00', '5%', 'Wysłane'],
  ['ZAM-3395', 'Aqua-Dom', 'Paweł R.', '7 815,20', '6%', 'Zafakturowane'],
  ['ZAM-3394', 'Wod-Kan Leszno', 'Karolina M.', '940,00', '—', 'Zafakturowane'],
];

// Wsparcie: plan panelu na kwartał po comiesięcznej rozmowie
const PLAN = [
  ['Wrocław w panelu', 'Jeden panel z wyborem oddziału. Osobna kopia dla Wrocławia to dwa cenniki i każda poprawka robiona dwa razy.', 'Tak, start 17.11, po inwentaryzacji'],
  ['Ceny i rabaty z Subiekta', 'Zrobić przed Wrocławiem. Inaczej różnice w rabatach, które dziś wyrównujecie ręcznie, przyjdą z dwóch oddziałów.', 'Tak, robi Adam w listopadzie'],
  ['Aplikacja dla kierowców', 'Nie budować. Firma kurierska ma gotową, wystarczy, że panel będzie pobierał od niej statusy.', 'Najpierw rozmowa z magazynem'],
  ['Logowanie przez Google', 'Może poczekać, dziś niczego nie blokuje.', 'Styczeń'],
];

// Warsztaty: jedno zadanie przed programem i po nim
const PRZED = [
  ['pon', 'Tomasz zgłasza na kanale, że klient pyta o rabat dla stałych klientów'],
  ['wt–pt', 'zadanie czeka, bo Anna ma urlop, a tylko ona zmienia panel'],
  ['pon', 'Anna prosi AI o zmianę, działa dopiero trzecie podejście'],
  ['wt', 'zmiana idzie do klientów tego samego dnia, nikt jej nie sprawdza'],
  ['czw', 'klient pisze, że na fakturze nie ma rabatu'],
];
const PO = [
  ['pon 9:40', 'Adam opisuje zadanie według wzoru, który zespół spisał na warsztatach'],
  ['pon 11:05', 'AI robi zmianę według zasad zespołu i dopisuje test'],
  ['wt 13:50', 'Michał sprawdza zmianę na kopii danych'],
  ['śr 14:20', 'rabat działa u klientów, także na fakturze'],
];

const dane = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage', '@id': `${kanon}#strona`, url: kanon, name: 'Budujecie sami z AI',
      description,
      mainEntity: { '@type': 'ItemList', itemListElement: [
        ['Analiza aplikacji', '/guided-coding/audyt-aplikacji'], ['Bieżące wsparcie', '/guided-coding/biezace-wsparcie'],
        ['Warsztaty dla zespołu', '/guided-coding/transfer-know-how'],
      ].map(([n, u], i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'Service', name: n, url: new URL(u, Astro.site).href, provider: { '@type': 'Organization', name: "Let's automate" } } })) },
    },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Strona główna', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Budujecie sami z AI', item: kanon },
    ] },
  ],
};
---
<LaBase topbar={false} title={title} description={description} ctaLabel="Umów rozmowę" nav="uslugi">
<script type="application/ld+json" is:inline set:html={JSON.stringify(dane)} slot="head"></script>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=Inter:wght@400;500;600;700&display=swap" slot="head">

<style is:global slot="head">
  /* Style tej strony. Wspólny wygląd: src/components/usluga/Styl.astro.
     Układ usług jak na /produkty (.pr…), obiekty z przedrostkiem gk- (hero)
     i go- (sekcje). */
  .gh{--app:"Inter",system-ui,-apple-system,"Segoe UI",sans-serif;--olowek:'Caveat',cursive;--dlug:#cf3a2a}

  /* ---- usługa: tekst i obiekt w dwóch kolumnach (jak /produkty) ---- */
  #analiza{padding-top:clamp(40px,5vw,80px)}
  .pr{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:clamp(36px,5vw,96px);align-items:center}
  .pr.odwr{grid-template-columns:minmax(0,7fr) minmax(0,5fr)}
  .pr.odwr .pr-w{order:-1}
  .pr-lok{display:flex;align-items:center;gap:16px}
  .pr-zn{display:grid;place-items:center;flex-shrink:0;width:56px;height:56px;border-radius:16px;background:var(--ink);color:var(--ziel)}
  .pr-zn svg{display:block;width:26px;height:26px}
  .pr-n{margin:0;font-size:clamp(34px,3.6vw,52px);font-weight:700;letter-spacing:-0.045em;line-height:1;color:var(--t1)}
  .pr-k{margin:8px 0 0;font-size:15px;font-weight:650;color:var(--ziel-c)}
  .pr-def{margin:clamp(22px,2.4vw,30px) 0 0;font-size:clamp(17px,1.4vw,20px);line-height:1.55;letter-spacing:-0.01em;color:var(--t1);text-wrap:pretty}
  .pr-sp{margin:clamp(22px,2.4vw,30px) 0 0;border-top:1px solid var(--linia)}
  .pr-sp div{display:grid;grid-template-columns:128px minmax(0,1fr);gap:14px;padding:12px 0;border-bottom:1px solid var(--linia2)}
  .pr-sp dt{font-size:13.5px;font-weight:650;line-height:1.5;color:var(--t3)}
  .pr-sp dd{margin:0;font-size:15px;line-height:1.5;color:var(--t1);text-wrap:pretty}
  .pr-sp dd b{font-weight:700}
  .pr-ak{display:flex;flex-wrap:wrap;align-items:center;gap:14px 26px;margin-top:clamp(26px,2.8vw,36px)}
  #kontakt.v4-kt{background:#ffffff}
  .pr-pod{margin:16px 0 0;font-size:14.5px;line-height:1.5;color:var(--t2);text-wrap:pretty}
  .pr-pod b{color:var(--t1);font-weight:650}
  @media (max-width:980px){
    .pr,.pr.odwr{grid-template-columns:minmax(0,1fr)}
    .pr.odwr .pr-w{order:0}
  }
  @media (max-width:480px){ .pr-sp div{grid-template-columns:minmax(0,1fr);gap:2px} }

  /* skalowanie obiektów do kolumny: wzór w stałej szerokości, zoom ze skryptu */
  .sk-ram{width:100%}
  [data-skala]{transform-origin:0 0}

  /* =====================================================================
     HERO · trzy obiekty ze świata klienta, każdy prowadzi do usługi
     Scena 640 × 560 (wzór), podpisy na kreskach jak na /produkty.
     ===================================================================== */
  .gh .v4-hero-in.obok > .hero-wid{align-self:center}
  .gk{width:640px;height:560px;position:relative;font-family:var(--app)}
  .gk-el{position:absolute;display:block;color:inherit;transition:transform .35s cubic-bezier(.2,.8,.2,1)}
  .gk-el:hover{transform:translateY(-5px)}
  .gk-el:focus-visible{outline:none}
  .gk-log{left:0;top:46px;width:452px;z-index:1}
  .gk-sl{right:0;top:262px;width:318px;z-index:2}
  .gk-kl{left:0;top:398px;width:336px;z-index:3}
  .gk-et{position:absolute;left:20px;bottom:calc(100% + 14px);display:block;padding-left:13px;font-family:'Schibsted Grotesk',system-ui,sans-serif;font-size:13px;line-height:1.35;color:rgba(255,255,255,0.58);white-space:nowrap;text-align:left}
  .gk-et b{display:block;font-size:15px;font-weight:700;letter-spacing:-0.015em;color:#ffffff}
  .gk-et::before{content:"";position:absolute;left:0;top:5px;bottom:-14px;width:1px;background:linear-gradient(180deg,rgba(255,255,255,0.2),rgba(255,255,255,0.55))}
  .gk-et::after{content:"";position:absolute;left:-3px;bottom:-17px;width:7px;height:7px;border-radius:50%;background:#ffffff;box-shadow:0 0 0 3px rgba(255,255,255,0.14)}
  .gk-el:hover .gk-et::before,.gk-el:focus-visible .gk-et::before{background:var(--ziel)}
  .gk-el:hover .gk-et::after,.gk-el:focus-visible .gk-et::after{background:var(--ziel);box-shadow:0 0 0 3px rgba(0,205,119,0.25)}
  .gk-el:focus-visible .gk-et b{text-decoration:underline;text-underline-offset:4px}
  .gk-sl .gk-et{left:auto;right:20px;padding:0 13px 0 0;text-align:right}
  .gk-sl .gk-et::before{left:auto;right:0}
  .gk-sl .gk-et::after{left:auto;right:-3px}
  .gk-okno{display:block;border-radius:10px;overflow:hidden;background:#ffffff;box-shadow:0 0 0 1px rgba(0,0,0,0.06),0 30px 50px -22px rgba(0,0,0,0.6),0 8px 18px -10px rgba(0,0,0,0.35)}

  /* logi funkcji */
  .gk-log .gk-pas{display:flex;align-items:center;gap:8px;height:32px;padding:0 12px;border-bottom:1px solid #eceeed;font-size:11px;color:#6b7470}
  .gk-log .gk-pas b{color:#16201b;font-weight:600}
  .gk-log .gk-pas i{font-style:normal;color:#b6bcb9}
  .gk-log .gk-pas .zyw{margin-left:auto;display:flex;align-items:center;gap:5px;color:#4b5550}
  .gk-log .gk-pas .zyw::before{content:"";width:6px;height:6px;border-radius:50%;background:#1aa564}
  .gk-filtr{display:flex;white-space:nowrap;align-items:center;gap:8px;padding:7px 12px;border-bottom:1px solid #eceeed;font-size:10.5px;color:#6b7470}
  .gk-filtr span{display:flex;align-items:center;gap:6px;flex:1;height:22px;padding:0 8px;border-radius:5px;box-shadow:inset 0 0 0 1px #e1e4e2;color:#16201b;font-family:var(--mono)}
  .gk-filtr svg{width:11px;height:11px;color:#8a928e}
  .gk-wiersze{display:block;padding:5px 0 2px;font-family:var(--mono);font-size:10px;line-height:1.55;color:#38413c}
  .gk-w{display:grid;grid-template-columns:52px 30px minmax(0,1fr);gap:8px;padding:3px 12px}
  .gk-w .cz{color:#8a928e}
  .gk-w .sc{color:#5b6560}
  .gk-w.przyg{opacity:.5}
  .gk-w.zaz{background:#fff6f4}
  .gk-w .js > span{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .gk-w .js > span:has(.gk-zak){overflow:visible}
  .gk-zak{position:relative;white-space:nowrap}
  .gk-zak svg{position:absolute;left:-7px;top:-5px;width:calc(100% + 14px);height:calc(100% + 10px);overflow:visible;pointer-events:none}
  .gk-not{display:block;padding:0 18px 10px;font-family:var(--olowek);font-size:17px;line-height:1.05;color:var(--dlug);transform:rotate(-1.5deg);transform-origin:100% 50%;text-align:right}
  .gk-not b{display:inline-grid;place-items:center;width:18px;height:18px;margin-right:4px;border:1.5px solid var(--dlug);border-radius:50%;font-family:'Schibsted Grotesk',sans-serif;font-size:10.5px;font-weight:700;vertical-align:2px}

  /* Slack */
  .gk-sl .gk-pas{display:flex;align-items:center;gap:6px;height:34px;padding:0 13px;border-bottom:1px solid #eceeed;font-size:12px;font-weight:700;color:#1d1c1d}
  .gk-sl .gk-pas span{font-weight:400;color:#7b7a7c;margin-left:4px;font-size:11px}
  .sl-m{display:grid;grid-template-columns:28px minmax(0,1fr);gap:9px;padding:9px 13px 4px}
  .sl-a{width:28px;height:28px;border-radius:6px;overflow:hidden;background:#e9ecea;color:#8b938f;display:grid;place-items:center}
  .sl-a img{display:block;width:100%;height:100%;object-fit:cover}
  .sl-a svg{width:15px;height:15px}
  .sl-k{font-size:11.5px;line-height:1.45;color:#1d1c1d}
  .sl-k .hd{display:flex;align-items:baseline;gap:6px;margin-bottom:1px}
  .sl-k .hd b{font-weight:700}
  .sl-k .hd span{font-size:10px;color:#7b7a7c}
  .sl-k .hd em{font-style:normal;font-size:9.5px;color:#4b5550;padding:0 4px;border-radius:3px;box-shadow:inset 0 0 0 1px #d9dcda}
  .sl-k p{margin:0}
  .sl-kod{display:block;margin:5px 0 3px;padding:6px 8px;border-radius:5px;background:#f6f6f6;box-shadow:inset 0 0 0 1px #e6e6e6;font-family:var(--mono);font-size:9.6px;line-height:1.5;color:#2e3532}
  .sl-wat{display:flex;align-items:center;gap:6px;margin:4px 0 10px 50px;font-size:10.5px;font-weight:600;color:#1264a3}
  .sl-k p + p{margin-top:4px}

  /* zaproszenie na sesję warsztatów */
  .kl{display:grid;grid-template-columns:4px minmax(0,1fr)}
  .kl::before{content:"";background:#0a8a55}
  .kl-in{padding:11px 14px 12px}
  .kl-d{display:block;font-size:10.5px;color:#6b7470}
  .kl-d b{color:#0a8a55;font-weight:600}
  .kl-t{display:block;margin-top:3px;font-size:13px;font-weight:700;letter-spacing:-0.01em;line-height:1.3;color:#16201b}
  .kl-r{display:grid;grid-template-columns:96px minmax(0,1fr);gap:8px;margin-top:6px;font-size:10.8px;line-height:1.4;color:#38413c}
  .kl-r:first-of-type{margin-top:9px;padding-top:8px;border-top:1px solid #eceeed}
  .kl-r span:first-child{color:#8a928e}
  .kl-r b{font-weight:600;color:#16201b}
  .kl-not{display:block;padding:0 14px 9px;font-family:var(--olowek);font-size:16px;line-height:1;color:var(--dlug);text-align:right;transform:rotate(-1.5deg)}

  @media (max-width:1060px) and (min-width:761px){ .gh .hero-wid .sk-ram{display:flex;justify-content:center} }
  /* legenda na telefonie */
  .gk-leg{display:none}
  .gk-leg a{display:flex;align-items:center;gap:8px;font-size:14px;font-weight:700;color:#ffffff}
  .gk-leg a::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--ziel)}
  @media (max-width:760px){
    .gk-et{display:none}
    .gk-leg{display:flex;flex-wrap:wrap;gap:8px 20px;margin-top:20px}
  }
  @media (prefers-reduced-motion:reduce){ .gk-el{transition:none} }

  /* =====================================================================
     OBIEKTY USŁUG (wzór 680 px, skalowany do kolumny)
     ===================================================================== */
  .go{position:relative;font-family:var(--app);color:#1b2420}
  .go-okno{border-radius:10px;overflow:hidden;background:#ffffff;box-shadow:0 0 0 1px rgba(15,26,20,0.08),0 40px 70px -40px rgba(7,20,13,0.45),0 10px 24px -14px rgba(7,20,13,0.2)}
