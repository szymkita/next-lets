<script>
  var redukcja = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- Hero: jedna zmiana od wysłania do nowej zasady (pętla) ----
  // Markup trzyma stan końcowy. Skrypt cofa do startu i odgrywa: zmiana
  // wchodzi, zasady ją sprawdzają, uwaga prowadzącego się rozwija,
  // przychodzi poprawka, uwaga się zamyka, w pliku dopisuje się zasada 19.
  // Przy ograniczonym ruchu i bez IntersectionObservera nic się nie dzieje.
  (function(){
    var fig = document.querySelector('[data-hz]');
    if(!fig || redukcja || !('IntersectionObserver' in window)) return;
    var exp = fig.querySelector('[data-hz-exp]'), fix = fig.querySelector('[data-hz-fix]');
    var stExp = exp.querySelector('[data-hz-st]'), stFix = fix.querySelector('[data-hz-st]');
    var ko = fig.querySelector('[data-hz-ko]'), kz = fig.querySelector('[data-hz-kz]');
    var reg = fig.querySelector('[data-hz-reg]');
    var widoczny = false;
    function czekaj(ms){ return new Promise(function(r){ setTimeout(r, ms); }); }
    async function gdyWidoczny(){ while(!widoczny) await czekaj(300); }
    function start(){
      fig.classList.add('bez-tr');
      fix.classList.add('ukr'); exp.classList.add('ukr');
      stExp.setAttribute('data-s', 'spr'); stFix.setAttribute('data-s', 'spr');
      ko.classList.add('ukr'); kz.classList.add('ukr');
      reg.classList.add('ukr'); reg.classList.remove('nowa');
      void fig.offsetWidth;
      fig.classList.remove('bez-tr');
    }
    async function petla(){
      for(;;){
        await gdyWidoczny();
        start();
        fig.classList.remove('znika');
        await czekaj(900);  exp.classList.remove('ukr');
        await czekaj(1800); stExp.setAttribute('data-s', 'uw');
        await czekaj(600);  ko.classList.remove('ukr');
        await czekaj(3600); fix.classList.remove('ukr');
        await czekaj(1600); stFix.setAttribute('data-s', 'ok'); stExp.setAttribute('data-s', 'pop'); ko.classList.add('ukr'); kz.classList.remove('ukr');
        await czekaj(900);  reg.classList.remove('ukr'); reg.classList.add('nowa');
        await czekaj(5600); fig.classList.add('znika');
        await czekaj(500);
      }
    }
    new IntersectionObserver(function(w){ widoczny = w[0].isIntersecting; }, { threshold: 0.2 }).observe(fig);
    start();
    petla();
  })();

  // ---- Rząd kart „co widzimy": strzałki przewijają o jedną kartę ----
  (function(){
    var sc = document.querySelector('[data-zn-sc]');
    if(!sc) return;
    var wstecz = document.querySelector('[data-zn-wstecz]');
    var dalej = document.querySelector('[data-zn-dalej]');
    function krok(){ var k = sc.querySelector('.dw4-k'); return k ? k.getBoundingClientRect().width + parseFloat(getComputedStyle(sc).columnGap || 0) : 320; }
    function stan(){
      var max = sc.scrollWidth - sc.clientWidth - 2;
      if(wstecz) wstecz.disabled = sc.scrollLeft <= 2;
      if(dalej) dalej.disabled = sc.scrollLeft >= max;
    }
    function jedz(kier){ sc.scrollBy({ left: kier * krok(), behavior: redukcja ? 'auto' : 'smooth' }); }
    if(wstecz) wstecz.addEventListener('click', function(){ jedz(-1); });
    if(dalej) dalej.addEventListener('click', function(){ jedz(1); });
    sc.addEventListener('scroll', stan, { passive: true });
    window.addEventListener('resize', stan);
    stan();
  })();
</script>
</LaBase>
