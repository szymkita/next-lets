<script>
  var redukcja = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  (function(){
    var els = document.querySelectorAll('[data-anim]');
    if(!els.length) return;
    if(redukcja || !('IntersectionObserver' in window)){
      els.forEach(function(el){ el.classList.add('on'); });
      return;
    }
    var io = new IntersectionObserver(function(w){
      w.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('on'); io.unobserve(e.target); } });
    }, { threshold: 0.22 });
    els.forEach(function(el){ io.observe(el); });
  })();

  (function(){
    var els = document.querySelectorAll('.cnt');
    if(!els.length) return;
    function pisz(el, v, dec){
      var znak = v < 0 ? '−' : '';
      var abs = Math.abs(v);
      el.textContent = znak + (dec ? abs.toFixed(dec).replace('.', ',') : Math.round(abs).toString());
    }
    function licz(el){
      var cel = parseFloat(el.dataset.n), dec = parseInt(el.dataset.dec || '0', 10), start = 0;
      if(redukcja){ pisz(el, cel, dec); return; }
      function krok(teraz){
        if(!start) start = teraz;
        var p = Math.min(1, (teraz - start) / 1000);
        pisz(el, cel * (1 - Math.pow(1 - p, 3)), dec);
        if(p < 1) requestAnimationFrame(krok);
      }
      requestAnimationFrame(krok);
    }
    if(!('IntersectionObserver' in window)){ els.forEach(licz); return; }
    var io = new IntersectionObserver(function(w){
      w.forEach(function(e){ if(e.isIntersecting){ licz(e.target); io.unobserve(e.target); } });
    }, { threshold: 0.5 });
    els.forEach(function(el){ io.observe(el); });
  })();

  // ---- Macierz: podpis reaguje na bąbel ----
  (function(){
    var cap = document.getElementById('mx-cap');
    if(!cap) return;
    var domyslny = cap.innerHTML;
    document.querySelectorAll('.mx-g').forEach(function(g){
      function pokaz(){
        cap.innerHTML = '<strong style="color:#16211a;font-weight:700">' + g.dataset.t + '</strong> — ' + g.dataset.o + ' · ' + g.dataset.s;
      }
      g.addEventListener('mouseenter', pokaz);
      g.addEventListener('mouseleave', function(){ cap.innerHTML = domyslny; });
    });
  })();

  // ---- Przełącznik działów ----
  (function(){
    var taby = document.querySelectorAll('.dz-tab');
    if(!taby.length) return;
    function wybierz(klucz){
      taby.forEach(function(t){ t.setAttribute('aria-selected', t.dataset.dzial === klucz ? 'true' : 'false'); });
      document.querySelectorAll('.dz-panel').forEach(function(p){
        p.setAttribute('data-open', p.dataset.panel === klucz ? 'true' : 'false');
      });
    }
    taby.forEach(function(t){
      t.addEventListener('click', function(){ wybierz(t.dataset.dzial); });
      t.addEventListener('mouseenter', function(){ wybierz(t.dataset.dzial); });
    });
  })();

  // ---- Arkusz: suwaki przeliczają kolumnę ----
  (function(){
    var box = document.getElementById('ark');
    if(!box) return;
    var slStawka = document.getElementById('sl-stawka');
    var slFaktur = document.getElementById('sl-faktur');
    var MINUTY = 6.5, WYJATKI = 0.12, NAKLAD = 68000;
    function spacja(n){ return Math.round(n).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ' '); }
    function przelicz(){
      var stawka = parseInt(slStawka.value, 10), faktur = parseInt(slFaktur.value, 10);
      var dzis = faktur * MINUTY / 60, po = dzis * WYJATKI, odz = dzis - po;
      var rok = odz * stawka * 12, zwrot = rok / NAKLAD;
      var prog = Math.max(1, Math.ceil(NAKLAD / (rok / 12)));
      document.getElementById('v-stawka').textContent = stawka + ' zł';
      document.getElementById('v-faktur').textContent = spacja(faktur);
      document.getElementById('o-stawka').textContent = stawka + ' zł';
      document.getElementById('o-faktur').textContent = spacja(faktur);
      document.getElementById('o-dzis').textContent = Math.round(dzis) + ' h / mies.';
      document.getElementById('o-po').textContent = Math.round(po) + ' h / mies.';
      document.getElementById('o-odz').textContent = Math.round(odz) + ' h / mies.';
      document.getElementById('o-rok').textContent = spacja(Math.round(rok / 100) * 100) + ' zł';
      document.getElementById('o-zwrot').textContent = zwrot.toFixed(1).replace('.', ',') + '×';
      document.getElementById('o-prog').textContent = prog + '.';
    }
    slStawka.addEventListener('input', przelicz);
    slFaktur.addEventListener('input', przelicz);
    przelicz();
  })();
</script>
