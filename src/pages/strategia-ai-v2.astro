  { q: 'Ile czasu zajmie to naszemu zespołowi?', a: 'Około ośmiu i pół godziny łącznie po Waszej stronie: godzina na dostępy, cztery godziny warsztatu i rozmów w pierwszym tygodniu, godzina na potwierdzenie założeń, dwie godziny przy uruchomieniu i półtorej na omówienie. Rozmowy z osobami wykonującymi pracę umawiamy pojedynczo, żeby nie zatrzymywać całego działu.' },
  { q: 'Co dzieje się na tych bezpłatnych trzydziestu minutach?', a: 'Pytamy o trzy rzeczy: jakie procesy są dziś na stole, ile spraw przez nie przechodzi miesięcznie i w jakich systemach leżą dane. Na tej podstawie mówimy, czy przegląd ma u Was sens, i jeśli nie ma — mówimy to od razu. Nie ma prezentacji ani nagrywania.' },
  { q: 'Mamy już listę pomysłów od zespołu. Czy to nie to samo?', a: 'Lista pomysłów mówi, co ludzi uwiera. Kolejność mówi, ile każda pozycja kosztuje i ile wraca, więc zwykle wygląda inaczej niż lista wyjściowa. Waszą listę bierzemy na wejściu i przepuszczamy przez sześć kryteriów oraz arkusz — część pozycji spada, część awansuje, a jedna albo dwie dochodzą z rozmów z ludźmi przy procesie.' },
];
---
<LaBase noindex title={title} description={description} ctaHref="#rozmowa" ctaLabel="Umów 30 minut" nav="uslugi">
<style is:global slot="head">
  /* ---------- podkreślenie w H1 ---------- */
  .h1-mark{position:relative;display:inline-block}
  .h1-mark svg{position:absolute;left:-1.5%;bottom:-0.15em;width:103%;height:0.34em;overflow:visible;pointer-events:none}
  .h1-mark path{fill:none;stroke:rgba(0,205,119,.92);stroke-width:6;vector-effect:non-scaling-stroke;stroke-linecap:round;stroke-dasharray:1;stroke-dashoffset:1;animation:h1draw 1s .5s cubic-bezier(.5,0,.2,1) forwards}
  @keyframes h1draw{to{stroke-dashoffset:0}}

  /* ---------- macierz ---------- */
  .mx{width:100%;height:auto;display:block;overflow:visible}
  .mx-ax{stroke:#cfdacd;stroke-width:1.2;stroke-dasharray:1;stroke-dashoffset:1;transition:stroke-dashoffset .9s cubic-bezier(.4,0,.2,1)}
  .mx-grid{stroke:#eef2ec;stroke-width:1;opacity:0;transition:opacity .5s .3s}
  .mx-band{opacity:0;transition:opacity .6s .5s}
  .mx-lead{fill:none;stroke:#0a7a52;stroke-width:1.3;stroke-dasharray:3 5;opacity:0;transition:opacity .5s .9s}
  .mx-node{transform-box:fill-box;transform-origin:center;transform:scale(.2);opacity:0;transition:transform .55s cubic-bezier(.34,1.5,.5,1),opacity .3s;transition-delay:calc(var(--i)*80ms + .35s)}
  .mx-lbl{opacity:0;transition:opacity .4s;transition-delay:calc(var(--i)*80ms + .6s)}
  .mx-hit{cursor:pointer}
  .mx.on .mx-ax{stroke-dashoffset:0}
  .mx.on .mx-grid,.mx.on .mx-band,.mx.on .mx-lead,.mx.on .mx-lbl{opacity:1}
  .mx.on .mx-node{transform:scale(1);opacity:1}
  .mx.on .mx-g:hover .mx-node{transform:scale(1.14)}
  .mx-cap{min-height:38px}

  /* ---------- siatka stu pilotaży ---------- */
  .wf{display:grid;grid-template-columns:repeat(20,1fr);gap:5px}
  .wf i{display:block;aspect-ratio:1;border-radius:2px;background:#ccd8ca;opacity:0;transform:translateY(6px);transition:opacity .34s,transform .34s;transition-delay:calc(var(--i)*10ms)}
  .wf.on i{opacity:1;transform:none}
  .wf i.hit{background:var(--la-accent,#00CD77)}
  .wf.on i.hit{transition-delay:calc(1.2s + var(--j)*90ms);box-shadow:0 0 0 3px rgba(0,205,119,.22)}
  .bar{height:9px;border-radius:5px;background:#e2e9e0;overflow:hidden}
  .bar span{display:block;height:100%;width:0;border-radius:5px;background:linear-gradient(90deg,#0a7a52,#00CD77);transition:width 1.1s cubic-bezier(.4,0,.2,1) .25s}
  .on .bar span{width:var(--w)}

  /* ---------- przełącznik działów ---------- */
  .dz-tab{appearance:none;border:0;background:none;font-family:inherit;cursor:pointer;display:block;width:100%;text-align:left;padding:15px 0 15px 20px;border-left:2px solid #e2e9e0;color:#7c877e;transition:color .2s,border-color .2s,padding-left .25s}
  .dz-tab strong{display:block;font-size:clamp(19px,2.2vw,24px);font-weight:750;letter-spacing:-0.018em;line-height:1.15;color:inherit}
  .dz-tab span{display:block;margin-top:4px;font-size:13px;line-height:1.45;opacity:0;max-height:0;overflow:hidden;transition:opacity .25s,max-height .3s}
  .dz-tab:hover{color:#16211a}
  .dz-tab[aria-selected="true"]{color:#16211a;border-left-color:var(--la-accent,#00CD77);padding-left:26px}
  .dz-tab[aria-selected="true"] span{opacity:1;max-height:60px;color:#7c877e}
  .dz-panel{display:none}
  .dz-panel[data-open="true"]{display:block;animation:dzin .4s cubic-bezier(.4,0,.2,1)}
  @keyframes dzin{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
  .dz-item{display:grid;grid-template-columns:30px 1fr;gap:16px;align-items:start;padding:20px 0;border-top:1px solid #e7ece4}
  .dz-item:first-child{border-top:0;padding-top:4px}
  .dz-num{font-family:ui-monospace,Menlo,monospace;font-size:12px;font-weight:700;color:#0a7a52;padding-top:3px}

  /* ---------- arkusz z suwakami ---------- */
  .sl{-webkit-appearance:none;appearance:none;width:100%;height:3px;border-radius:3px;background:#dde5db;outline:none;margin:0}
  .sl::-webkit-slider-thumb{-webkit-appearance:none;width:19px;height:19px;border-radius:50%;background:#0a7a52;border:3px solid #fff;box-shadow:0 3px 10px -2px rgba(10,122,82,.55);cursor:pointer;transition:transform .15s}
  .sl::-webkit-slider-thumb:hover{transform:scale(1.12)}
  .sl::-moz-range-thumb{width:15px;height:15px;border-radius:50%;background:#0a7a52;border:3px solid #fff;cursor:pointer}
  .ark-in{display:grid;grid-template-columns:1fr auto 200px;gap:16px;align-items:baseline;padding:10px 0;border-top:1px solid #edf0ea}
  .ark-out{display:flex;align-items:baseline;justify-content:space-between;gap:18px;padding:9px 0;border-top:1px solid #edf0ea}
  .ark-live{background:#eaf6ee;box-shadow:0 0 0 3px #eaf6ee;border-radius:2px}

  /* ---------- sito ---------- */
  .sito{width:100%;height:auto;display:block}
  .st-wall{stroke:#aebcac;stroke-width:1.5;fill:none}
  .st-gate{stroke:#ccd8ca;stroke-width:1;stroke-dasharray:2 4}
  .st-num{fill:#8e9c8d;font-family:ui-monospace,Menlo,monospace;font-size:10px}
  .st-dot{transform:translate(0,0);transition:transform 1.5s cubic-bezier(.42,0,.3,1),opacity .5s;transition-delay:calc(var(--i)*90ms)}
  .st-dot circle{transition:fill .4s;transition-delay:calc(var(--i)*90ms + 1.1s)}
  .sito.on .st-dot{transform:translate(var(--dx),var(--dy))}
  .sito.on .st-dot.odpada{opacity:.3;transition-delay:calc(var(--i)*90ms),calc(var(--i)*90ms + .9s)}
  .sito.on .st-dot.wchodzi circle{fill:var(--la-accent,#00CD77)}
  .sito.on .st-dot.odbija circle{fill:#a3391f}
  .st-out{opacity:0;transition:opacity .5s 2.2s}
  .sito.on .st-out{opacity:1}

  /* ---------- narzędzia ---------- */
  .nrz{display:grid;grid-template-columns:repeat(6,1fr);gap:14px}
  .nrz-t{background:#ffffff;border:1px solid #e7ece4;border-radius:14px;padding:22px 18px;transition:transform .25s,box-shadow .25s,border-color .25s}
  .nrz-t:hover{transform:translateY(-3px);border-color:var(--la-accent,#00CD77);box-shadow:0 20px 40px -26px rgba(18,38,28,.28)}
  .nrz-n{display:block;font-size:17px;font-weight:750;letter-spacing:-0.02em;color:#16211a}
  .nrz-d{display:block;margin-top:2px;font-family:ui-monospace,Menlo,monospace;font-size:10.5px;letter-spacing:0.06em;color:#9aa69b}
  .nrz-r{display:block;margin-top:12px;font-size:13px;line-height:1.5;color:#4c5850}

  /* ---------- bezpieczeństwo ---------- */
  .bez{width:100%;height:auto;display:block}
  .bez-box{opacity:0;transform:translateY(8px);transition:opacity .5s,transform .5s;transition-delay:calc(var(--i)*140ms)}
  .bez.on .bez-box{opacity:1;transform:none}
  .bez-flow{stroke-dasharray:1;stroke-dashoffset:1;transition:stroke-dashoffset .8s ease .5s}
  .bez.on .bez-flow{stroke-dashoffset:0}
  .bez-pkt{opacity:0;transition:transform 1.6s cubic-bezier(.4,0,.4,1) 1s,opacity .3s 1s}
  .bez.on .bez-pkt{opacity:1;transform:translateX(238px)}

  /* ---------- pasek tygodni ---------- */
  .gt{display:flex;gap:7px;align-items:flex-end}
  .gt-seg{display:flex;flex-direction:column;gap:9px;min-width:0}
  .gt-bar{display:block;height:11px;border-radius:6px;background:var(--la-accent,#00CD77);opacity:var(--o);transform:scaleX(0);transform-origin:left;transition:transform .65s cubic-bezier(.4,0,.2,1);transition-delay:calc(var(--i)*130ms)}
  .gt.on .gt-bar{transform:none}
  .gt-lab{font-family:ui-monospace,Menlo,monospace;font-size:10.5px;letter-spacing:0.1em;color:#8b968d;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .gt-h{font-size:14px;font-weight:750;color:#16211a;letter-spacing:-0.01em}
  .czas-bar{display:block;height:6px;border-radius:3px;background:#e7ece4;overflow:hidden;width:88px}
  .czas-bar span{display:block;height:100%;width:0;border-radius:3px;background:#0a7a52;transition:width .8s cubic-bezier(.4,0,.2,1) .2s}
  .etp-row.on .czas-bar span{width:var(--w)}

  /* ---------- wiersze ---------- */
  .hero-split > *,.s2-grid > *,.kry-grid > *,.cena-grid > *,.grid2 > *,.dz-grid > *,.rozm-grid > *{min-width:0}
  .mx,.sito,.bez{max-width:100%}
  .pow-row{display:grid;grid-template-columns:56px 320px 1fr;gap:clamp(20px,3vw,44px);align-items:start;padding:clamp(22px,2.6vw,30px) 4px;border-top:1px solid #e7ece4}
  .pow-row:last-child{border-bottom:1px solid #e7ece4}
  .syt-row{display:grid;grid-template-columns:1fr 1.35fr;gap:clamp(16px,3vw,44px);align-items:baseline;padding:26px 0;border-top:1px solid #e7ece4}
  .syt-row:last-of-type{border-bottom:1px solid #e7ece4}
  .zos-row{display:grid;grid-template-columns:44px 300px 1fr;gap:clamp(18px,3vw,40px);align-items:baseline;padding:22px 4px;border-top:1px solid #e7ece4}
  .zos-row:last-child{border-bottom:1px solid #e7ece4}
  .kry-row{display:grid;grid-template-columns:26px 1fr;gap:clamp(12px,2vw,20px);align-items:baseline;padding:17px 0;border-top:1px solid #e7ece4}
  .kry-row:last-of-type{border-bottom:1px solid #e7ece4}
  .etp-row{display:grid;grid-template-columns:132px 1fr 130px;gap:clamp(18px,3vw,40px);align-items:start;padding:clamp(20px,2.4vw,28px) 0;border-top:1px solid #e2e9e0}
  .etp-row:last-of-type{border-bottom:1px solid #e2e9e0}
  .dow-row{display:grid;grid-template-columns:150px 190px 1fr;gap:clamp(16px,3vw,40px);align-items:baseline;padding:clamp(20px,2.4vw,28px) 0;border-top:1px solid rgba(255,255,255,0.14)}
  .dow-row:last-of-type{border-bottom:1px solid rgba(255,255,255,0.14)}
  .dal-row{display:grid;grid-template-columns:1fr 300px;gap:clamp(18px,3vw,40px);align-items:baseline;padding:26px 0;border-top:1px solid #e7ece4}
  .dal-row:last-of-type{border-bottom:1px solid #e7ece4}
  .kol-row{display:grid;grid-template-columns:24px 1fr auto;gap:12px;align-items:baseline;padding:9px 0;border-top:1px solid #f0f3ee}
  .mit-row{display:grid;grid-template-columns:340px 1fr;gap:clamp(20px,4vw,56px);align-items:start;padding:clamp(22px,2.6vw,30px) 0;border-top:1px solid #e7ece4}
  .mit-row:last-of-type{border-bottom:1px solid #e7ece4}

  @media (max-width:1180px){
    .kry-grid{grid-template-columns:1fr !important;gap:clamp(32px,5vw,48px) !important}
    .nrz{grid-template-columns:repeat(3,1fr)}
  }
  @media (max-width:1100px){
    .pow-row{grid-template-columns:44px 1fr;gap:14px}
    .pow-row > p{grid-column:2}
    .zos-row{grid-template-columns:36px 1fr;gap:12px}
    .zos-row > p{grid-column:2}
  }
  @media (max-width:900px){
    .hero-split{grid-template-columns:1fr !important;gap:36px !important}
    .syt-row,.dal-row,.mit-row{grid-template-columns:1fr !important;gap:10px !important}
    .etp-row{grid-template-columns:1fr !important;gap:6px !important}
    .etp-czas{justify-self:start !important}
    .dow-row{grid-template-columns:1fr !important;gap:6px !important}
    .ark-in{grid-template-columns:1fr auto !important}
    .ark-zrodlo{grid-column:1 / -1;padding-top:2px}
    .cena-grid,.dz-grid,.rozm-grid{grid-template-columns:1fr !important;gap:28px !important}
    .wciete{margin-left:0 !important}
    .zbd-row{grid-template-columns:1fr !important;gap:6px !important}
    .nrz{grid-template-columns:repeat(2,1fr)}
    .wf{gap:4px}
    .gt{display:none}
    .rozm-foto{display:none !important}
  }
  @media (prefers-reduced-motion:reduce){
    .h1-mark path{animation:none;stroke-dashoffset:0}
    .mx-ax,.mx-grid,.mx-band,.mx-lead,.mx-node,.mx-lbl,.wf i,.bar span,.st-dot,.st-dot circle,.st-out,.gt-bar,.czas-bar span,.bez-box,.bez-flow,.bez-pkt{transition:none !important}
    .dz-panel[data-open="true"]{animation:none}
  }
</style>

<!-- ============ 1 · HERO ============ -->
<section style="position:relative;overflow:hidden;background:radial-gradient(880px 520px at 88% -6%, rgba(0,205,119,0.13), transparent 62%), #ffffff;padding:clamp(28px,4vw,52px) max(clamp(20px,5vw,56px),calc((100% - 1440px) / 2)) clamp(36px,4vw,52px)">
<div style="display:flex;align-items:center;gap:8px;font-size:13.5px;color:#8b968d">
<a href="/#oferta" class="lnk-green" style="color:#0a7a52;font-weight:650">Wdrażamy AI</a>
<span aria-hidden="true">/</span><span>Strategia transformacji AI</span>
</div>

<div class="hero-split" style="display:grid;grid-template-columns:1fr 540px;gap:clamp(40px,5vw,72px);align-items:center;margin-top:clamp(26px,3vw,40px)">
<div>
<h1 style="margin:0;font-size:clamp(30px,4.8vw,55px);line-height:1.05;letter-spacing:-0.034em;font-weight:800;color:#16211a;text-wrap:balance">Strategia transformacji AI kończy się procesem, który <span class="h1-mark">już działa<svg viewBox="0 0 300 12" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M3,8.4 C62,2.6 118,11.4 178,5.4 C230,1.4 266,9.6 297,4.2"/></svg></span>.</h1>
<p style="margin:26px 0 0;max-width:600px;font-size:clamp(16px,2.1vw,19px);line-height:1.6;color:#33413a;text-wrap:pretty">Trzy tygodnie na Waszych procesach i Waszych danych. Zostaje z tego kolejność wdrożeń z kwotą przy każdej pozycji oraz arkusz, w którym da się sprawdzić każde wyliczenie. Pierwszą pozycję z listy uruchamiamy jeszcze w trakcie projektu.</p>
<div class="hero-actions" style="display:flex;align-items:center;flex-wrap:wrap;gap:16px 22px;margin-top:34px">
<a href="#rozmowa" class="btn-dark" style="display:inline-flex;align-items:center;gap:10px;background:#16211a;color:#ffffff;padding:18px 32px;border-radius:12px;font-weight:650;font-size:16.5px;box-shadow:0 14px 30px -14px rgba(16,33,26,0.45)">Umów 30 minut <span aria-hidden="true">→</span></a>
<a href="#arkusz" class="btn-ghost" style="display:inline-flex;align-items:center;gap:8px;font-size:16.5px;font-weight:700;color:#16211a;background:rgba(255,255,255,0.6);padding:18px 26px;border-radius:12px;border:1px solid rgba(22,33,26,0.16)">Policzcie na suwakach →</a>
</div>
<p style="margin:22px 0 0;font-size:14.5px;color:#7c877e">Rozmowa bez zobowiązań &nbsp;·&nbsp; przegląd trwa 3 tygodnie &nbsp;·&nbsp; stała cena [29 000] zł netto &nbsp;·&nbsp; 8,5 godziny po Waszej stronie</p>
</div>

<div style="background:#ffffff;border-radius:18px;padding:clamp(20px,2.4vw,26px);box-shadow:0 40px 90px -46px rgba(18,38,28,0.42), 0 2px 10px -4px rgba(18,38,28,0.08)">
<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:14px">
<div>
<div style="font-size:15.5px;font-weight:750;color:#16211a">Osiem procesów, jedna kolejność</div>
<div style="margin-top:3px;font-size:12px;color:#8b968d">producent mebli, 140 osób · wynik po trzech tygodniach</div>
</div>
<span style="flex-shrink:0;background:#f1f4ee;color:#7c877e;font-family:ui-monospace,Menlo,monospace;font-size:10.5px;letter-spacing:0.1em;font-weight:650;padding:5px 9px;border-radius:6px">PRZYKŁAD</span>
</div>

<svg class="mx" data-anim viewBox="0 0 480 292" role="img" aria-label="Macierz procesów: roczny zwrot wobec gotowości danych">
  <rect class="mx-band" x="297" y="14" width="169" height="133" rx="8" fill="rgba(0,205,119,0.09)"></rect>
  <text class="mx-band" x="308" y="32" font-family="ui-monospace,Menlo,monospace" font-size="9.5" letter-spacing="0.08em" fill="#0a7a52">ZACZYNAMY TU</text>
  <line class="mx-grid" x1="44" y1="147" x2="466" y2="147"></line>
  <line class="mx-grid" x1="255" y1="14" x2="255" y2="256"></line>
  <line class="mx-ax" pathLength="1" x1="44" y1="256" x2="466" y2="256"></line>
  <line class="mx-ax" pathLength="1" x1="44" y1="256" x2="44" y2="14"></line>
  <path class="mx-lead" d="M390,77 L331,123 L276,164"></path>
  <text x="466" y="276" text-anchor="end" font-size="10.5" fill="#9aa69b">gotowość danych i procesu →</text>
  <text x="30" y="140" text-anchor="middle" font-size="10.5" fill="#9aa69b" transform="rotate(-90 30 140)">roczny zwrot →</text>
  {punkty.map((p, i) => {
    const cx = 44 + p.x * 4.22;
    const cy = 256 - p.y * 2.42;
    const styl = p.typ === 'pierwsza'
      ? 'fill:#00CD77;stroke:#0a7a52;stroke-width:1.5'
      : p.typ === 'wchodzi'
        ? 'fill:#bfe9d3;stroke:#0a7a52;stroke-width:1.3'
        : p.typ === 'odpada'
          ? 'fill:#fdf1ec;stroke:#a3391f;stroke-width:1.6;stroke-dasharray:3 3'
          : 'fill:#dbe4d9;stroke:#bccbba;stroke-width:1';
    return (
      <g class="mx-g" data-t={p.t} data-o={p.o} data-s={p.s} style={`--i:${i}`}>
        <circle class="mx-node" cx={cx} cy={cy} r={p.r} style={styl}></circle>
        {p.id && !p.bezId && <text class="mx-lbl" x={cx} y={cy + 4} text-anchor="middle" font-family="ui-monospace,Menlo,monospace" font-size="10.5" font-weight="700" fill={p.typ === 'pierwsza' ? '#0b2b1c' : '#0a7a52'}>{p.id}</text>}
        {p.typ === 'odpada' && <line class="mx-lbl" x1={cx - 6} y1={cy + 6} x2={cx + 6} y2={cy - 6} stroke="#a3391f" stroke-width="1.8" stroke-linecap="round"></line>}
        <circle class="mx-hit" cx={cx} cy={cy} r={p.r + 8} fill="transparent"></circle>
      </g>
    );
  })}
</svg>

<div class="mx-cap" id="mx-cap" style="margin-top:2px;padding:10px 12px;background:#f6f9f5;border-radius:10px;font-size:12.5px;line-height:1.45;color:#4c5850">
<strong style="color:#16211a;font-weight:700">Bąbel to proces.</strong> Wielkość odpowiada godzinom odzyskanym miesięcznie, kolor — decyzji z dokumentu.
</div>

<div style="margin-top:14px">
{kolejnosc.map((k) => (
  <div class="kol-row">
    <span style={`font-family:ui-monospace,Menlo,monospace;font-size:12px;font-weight:700;color:${k.tag ? '#c0a99f' : '#0a7a52'}`}>{k.n}</span>
    <span style={`font-size:14px;font-weight:700;line-height:1.3;color:${k.tag ? '#8b968d' : '#16211a'}`}>{k.t}{k.tag && <span style="margin-left:8px;font-size:10.5px;font-weight:750;color:#a3391f;background:#fbeee9;padding:2.5px 7px;border-radius:5px;white-space:nowrap">{k.tag}</span>}</span>
    <span style="text-align:right;white-space:nowrap">
      {k.z && <span style="font-size:16px;font-weight:800;letter-spacing:-0.02em;color:#16211a">{k.z}</span>}
      <span style="display:block;font-family:ui-monospace,Menlo,monospace;font-size:10.5px;color:#8b968d">{k.s}</span>
    </span>
  </div>
))}
</div>
</div>
