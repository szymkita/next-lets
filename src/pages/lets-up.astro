  .u4s-pt{grid-column:4 / 6;grid-row:3;margin-top:22px}
  .u4s-luk{position:relative;display:block;height:30px;margin:0 25%;border:1.5px solid var(--ziel-c);border-top:0;border-radius:0 0 18px 18px}
  .u4s-luk::before{content:"";position:absolute;left:-6.5px;top:-3px;border-left:5.5px solid transparent;border-right:5.5px solid transparent;border-bottom:9px solid var(--ziel-c)}
