// ---- KOSZTY: wykres „nożyce” z przykładu (indeks względem stycznia) ---------
const VB_W = 1000, VB_H = 400, V_MIN = 0.97, V_MAX = 1.56;
const px = (i: number) => (i / (MIESIACE.length - 1)) * VB_W;
const py = (v: number) => VB_H - ((v - V_MIN) / (V_MAX - V_MIN)) * VB_H;
const P_ZL = MIESIACE.map(([, z], i) => [px(i), py(z / Z0)] as [number, number]);
const gladka = (p: [number, number][]) => {
  let d = `M${f1(p[0][0])} ${f1(p[0][1])}`;
  for (let i = 0; i < p.length - 1; i++) {
    const p0 = p[i - 1] || p[i], p1 = p[i], p2 = p[i + 1], p3 = p[i + 2] || p2;
    d += ` C${f1(p1[0] + (p2[0] - p0[0]) / 6)} ${f1(p1[1] + (p2[1] - p0[1]) / 6)} ${f1(p2[0] - (p3[0] - p1[0]) / 6)} ${f1(p2[1] - (p3[1] - p1[1]) / 6)} ${f1(p2[0])} ${f1(p2[1])}`;
  }
  return d;
};
const schodki = (arr: number[]) => {
  const pts: [number, number][] = [[px(0), py(arr[0] / OSOB)]];
  for (let i = 1; i < arr.length; i++) {
    if (arr[i] !== arr[i - 1]) { pts.push([px(i), py(arr[i - 1] / OSOB)], [px(i), py(arr[i] / OSOB)]); }
  }
  pts.push([px(arr.length - 1), py(arr[arr.length - 1] / OSOB)]);
  return pts;
};
const linia = (pts: [number, number][]) => 'M' + pts.map(([x, y]) => `${f1(x)} ${f1(y)}`).join(' L');
const PK_DZIS = schodki(L_DZIS), PK_PO = schodki(L_PO);
