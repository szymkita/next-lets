  .u3h-pod{margin-top:2px !important;font-size:12px !important;color:#4b504d !important}

  /* =====================================================================
     v5 · tła: od „Czym jest” papier ciągnie się pod planszą opowieści
     i kartami programu, chowa się pod planszą „System…”, pod nią biel.
     ===================================================================== */
  #zlecenie{background:var(--papier)}
  #system{background:linear-gradient(to bottom,var(--papier) 0,var(--papier) 50%,#ffffff 50%,#ffffff 100%)}

  /* =====================================================================
     v5 · BRZMI ZNAJOMO? osiem sytuacji w przesuwanym rzędzie (.u5s-)
     ===================================================================== */
  #sytuacje{padding-left:0;padding-right:0}
  #sytuacje > :not(.u5s-tor){margin-left:var(--pad);margin-right:var(--pad)}
  .u5s-tor.u3s-g{display:flex;gap:clamp(24px,2.6vw,44px);margin-top:clamp(48px,5vw,72px);padding:4px var(--pad) 10px;overflow-x:auto;overscroll-behavior-x:contain;
    scroll-snap-type:x mandatory;scroll-padding-inline:var(--pad);scrollbar-width:none}
  .u5s-tor::-webkit-scrollbar{display:none}
  .u5s-tor:focus-visible{outline:2px solid var(--ziel);outline-offset:-2px}
  .u5s-tor .u3s-k{flex:0 0 clamp(270px,22.5vw,330px);scroll-snap-align:start}
  .u5s-lk{font-size:13.5px;font-weight:600;color:var(--t3);font-variant-numeric:tabular-nums}
  @media (max-width:600px){ .u5s-tor .u3s-k{flex-basis:82%} .u3s-dym{min-height:96px} }

  /* =====================================================================
     v5 · GDZIE ZNIKA CZAS: ta sama forma, spokojniej — bez karty wokół
     rysunku, płaskie paski, siatka godzin pod taśmą, legenda bez kolorów
     ===================================================================== */
  .u4z-kar{padding:0;border-radius:0;background:none;box-shadow:none}
  .u4z-tor::before{content:"";position:absolute;left:0;right:0;top:-10px;bottom:24px;pointer-events:none;
    background:repeating-linear-gradient(to right,rgba(255,255,255,0.09) 0 1px,transparent 1px 14.2857%)}
  .u4z-tas{position:relative}
  .u4z-gr .cz{background:#00CD77;box-shadow:none}
  .u4z-gr .ai{background:repeating-linear-gradient(135deg,#f0a33a 0 2px,rgba(240,163,58,0.25) 2px 6px);box-shadow:none}
  .u4z-gr > i:first-child{border-radius:4px 0 0 4px}
  .u4z-gr > i:last-child{border-radius:0 4px 4px 0}
  .u4z-gr > i:only-child{border-radius:4px}
  .u4z-wiz[data-krok="1"] .u4z-gr .ai{filter:none}
  .u4z-wiz[data-krok="1"] .u4z-gr .cz{opacity:0.22}
  .u4z-leg{grid-template-columns:repeat(2,minmax(0,1fr));gap:0 36px}
  .u4z-leg li,.u4z-leg li.am{color:rgba(255,255,255,0.78)}
  .u4z-leg li i,.u4z-leg li.am i{width:10px;height:10px;border-radius:2px;background:linear-gradient(90deg,#00CD77 50%,#f0a33a 50%)}
  .u4z-wl{border-radius:12px}
  .u4z-g1 p b{font-size:16px}

  /* =====================================================================
     v5 · SCHODY: klamra pod stopniami 2–5 zamiast pigułek (.u5s-kl)
     ===================================================================== */
  .u5s-kl{grid-column:2 / 6;grid-row:3;position:relative;margin-top:26px;height:14px;border:1.5px solid var(--t2);border-top:0;border-radius:0 0 8px 8px}
  .u5s-kl span{position:absolute;left:50%;top:100%;transform:translate(-50%,-50%);padding:0 14px;background:var(--papier);font-size:14px;font-weight:650;color:var(--t1);white-space:nowrap}
  .u4s-op small{display:block;margin-top:8px;font-size:13.5px;line-height:1.45;color:var(--ziel-c);font-weight:600}
  .u4s{padding-bottom:20px}
  @media (max-width:1000px){
    .u5s-kl{order:6;height:auto;margin:6px 0 0;padding:12px 0 0 14px;border:0;border-left:2px solid var(--ziel-c);border-radius:0}
    .u5s-kl span{position:static;transform:none;padding:0;background:none;white-space:normal}
  }

  /* =====================================================================
     v6 · HERO: twarz osoby, która prowadzi pierwszą rozmowę
     ===================================================================== */
  .u6-tw{display:flex;align-items:center;gap:12px;margin:22px 0 0;font-size:14px;line-height:1.4;color:var(--t2)}
  .u6-tw img{flex:none;width:40px;height:40px;border-radius:50%;object-fit:cover;object-position:50% 18%;box-shadow:0 0 0 2px #ffffff,0 0 0 3.5px rgba(0,205,119,0.55)}
  .u6-tw b{font-weight:650;color:var(--t1)}

  /* =====================================================================
     v6 · GDZIE ZNIKA CZAS: rysunek niżej, stany 0–4 opowiadają usługę.
     Paski: cz = praca zespołu, sy = przejmują połączone narzędzia,
     ai = przygotowuje AI. W kroku 0 wszystko zielone; w krokach 1 i 2
     część się podświetla, po 0,8 s znika.
     ===================================================================== */
  .u6z .u4z-wiz{top:clamp(116px,calc(50vh - 255px),220px)}
  .u6z .u4z-k{min-height:68vh}
  .u6z .u4z-gr{flex-grow:var(--d)}
  .u6z .u4z-gr i{transition:flex-grow .9s cubic-bezier(.6,0,.2,1),opacity .35s}
  .u6z .u4z-gr .sy,.u6z .u4z-gr .ai{background:#00CD77}
  .u6z .u4z-wiz[data-krok="1"] .u4z-gr .sy{background:repeating-linear-gradient(135deg,#f4f7f5 0 2px,rgba(244,247,245,0.28) 2px 6px);flex-grow:0;transition:flex-grow .9s cubic-bezier(.6,0,.2,1) .8s}
  .u6z .u4z-wiz[data-krok="1"] .u4z-gr{flex-grow:var(--d1);transition:flex-grow .9s cubic-bezier(.6,0,.2,1) .8s}
  .u6z .u4z-wiz[data-krok="1"] .u4z-tas{width:calc(var(--tot1) / 420 * 100%);transition:width .9s cubic-bezier(.6,0,.2,1) .8s}
  .u6z .u4z-wiz[data-krok="2"] .u4z-gr .ai{background:repeating-linear-gradient(135deg,#f0a33a 0 2px,rgba(240,163,58,0.25) 2px 6px);flex-grow:0;transition:flex-grow .9s cubic-bezier(.6,0,.2,1) .8s}
  .u6z .u4z-wiz[data-krok="2"] .u4z-gr{flex-grow:var(--p);transition:flex-grow .9s cubic-bezier(.6,0,.2,1) .8s}
  .u6z .u4z-wiz[data-krok="2"] .u4z-tas{width:calc(var(--tot2) / 420 * 100%);transition:width .9s cubic-bezier(.6,0,.2,1) .8s}
  .u6z .u4z-wiz[data-krok="2"] .u4z-gr .sy,
  .u6z .u4z-wiz[data-krok="3"] .u4z-gr .sy,.u6z .u4z-wiz[data-krok="3"] .u4z-gr .ai,
  .u6z .u4z-wiz[data-krok="4"] .u4z-gr .sy,.u6z .u4z-wiz[data-krok="4"] .u4z-gr .ai{flex-grow:0}
  .u6z .u4z-wiz[data-krok="3"] .u4z-gr,.u6z .u4z-wiz[data-krok="4"] .u4z-gr{flex-grow:var(--p)}
  .u6z .u4z-wiz[data-krok="3"] .u4z-tas,.u6z .u4z-wiz[data-krok="4"] .u4z-tas{width:calc(var(--tot2) / 420 * 100%)}
  .u6z .u4z-wiz[data-krok="1"] .u4z-gr .cz,.u6z .u4z-wiz[data-krok="1"] .u4z-gr .ai,
  .u6z .u4z-wiz[data-krok="2"] .u4z-gr .cz{opacity:0.45}
  .u6z .u4z-wiz[data-krok="2"] .u4z-czas{color:var(--ziel)}
  /* klucz kolorów pod skalą */
  .u6z-kl{display:flex;flex-wrap:wrap;gap:6px 22px;margin:2px 0 0;padding:0;list-style:none;font-size:12.5px;color:rgba(255,255,255,0.6);transition:opacity .35s}
  .u6z-kl li{display:flex;align-items:center;gap:8px;transition:opacity .35s,color .35s}
  .u6z-kl i{width:18px;height:9px;border-radius:2px;background:#00CD77}
  .u6z-kl .sy i{background:repeating-linear-gradient(135deg,#f4f7f5 0 2px,rgba(244,247,245,0.28) 2px 6px)}
  .u6z-kl .ai i{background:repeating-linear-gradient(135deg,#f0a33a 0 2px,rgba(240,163,58,0.25) 2px 6px)}
  .u6z-kl .sy,.u6z-kl .ai{opacity:0.4}
  .u6z .u4z-wiz[data-krok="1"] .u6z-kl .sy,.u6z .u4z-wiz[data-krok="2"] .u6z-kl .ai{opacity:1;color:#ffffff}
  .u6z .u4z-wiz[data-krok="4"] .u6z-kl{opacity:0.1}
  /* legenda: minuty przed i po każdym kroku */
  .u6z .u4z-leg{margin-top:14px}
  .u6z .u4z-leg li i{background:#00CD77}
  .u6z .u4z-leg .v1,.u6z .u4z-leg .v2{display:none}
  .u6z .u4z-wiz[data-krok="1"] .u4z-leg .v0{display:none}
  .u6z .u4z-wiz[data-krok="1"] .u4z-leg .v1{display:inline}
  .u6z .u4z-wiz[data-krok="2"] .u4z-leg .v0,.u6z .u4z-wiz[data-krok="2"] .u4z-leg .v1,
  .u6z .u4z-wiz[data-krok="3"] .u4z-leg .v0,.u6z .u4z-wiz[data-krok="3"] .u4z-leg .v1,
  .u6z .u4z-wiz[data-krok="4"] .u4z-leg .v0,.u6z .u4z-wiz[data-krok="4"] .u4z-leg .v1{display:none}
  .u6z .u4z-wiz[data-krok="2"] .u4z-leg .v2,.u6z .u4z-wiz[data-krok="3"] .u4z-leg .v2,.u6z .u4z-wiz[data-krok="4"] .u4z-leg .v2{display:inline}
  .u6z .u4z-wiz[data-krok="1"] .u4z-leg li,.u6z .u4z-wiz[data-krok="2"] .u4z-leg li{opacity:0.38}
  .u6z .u4z-wiz[data-krok="1"] .u4z-leg li.sy,.u6z .u4z-wiz[data-krok="2"] .u4z-leg li.ai{opacity:1}
  .u6z .u4z-wiz[data-krok="1"] .u4z-leg li.sy i{background:repeating-linear-gradient(135deg,#f4f7f5 0 1.5px,rgba(244,247,245,0.3) 1.5px 4px)}
  .u6z .u4z-wiz[data-krok="2"] .u4z-leg li.ai i{background:repeating-linear-gradient(135deg,#f0a33a 0 1.5px,rgba(240,163,58,0.3) 1.5px 4px)}
  /* kolejka do właściciela: krok 3, dziś i po spisaniu zasad */
  .u6z .u4z-wiz[data-krok="2"] .u4z-wl{opacity:0;transform:translateY(8px)}
  .u6z .u4z-wl > div{min-width:0}
  .u6z .u4z-wl .t1,.u6z .u4z-wiz[data-krok="3"] .u4z-wl .t1{display:block;font-size:13.5px;color:rgba(255,255,255,0.62)}
  .u6z .u4z-wl .t2,.u6z .u4z-wiz[data-krok="3"] .u4z-wl .t2{display:block;margin-top:4px;opacity:0;transition:opacity .4s .7s}
  .u6z .u4z-wiz[data-krok="3"] .u4z-wl .t2{opacity:1}
  .u6z .u4z-wl .t2 b{color:var(--ziel)}
  /* małe wezwanie na końcu opowieści */
  .u6-mc{display:inline-flex;align-items:center;gap:14px;margin-top:28px;padding:9px 22px 9px 9px;border-radius:999px;background:rgba(255,255,255,0.06);box-shadow:inset 0 0 0 1px rgba(255,255,255,0.14);color:#ffffff;text-decoration:none;transition:background .2s,box-shadow .2s}
  .u6-mc img{flex:none;width:50px;height:50px;border-radius:50%;object-fit:cover;object-position:50% 18%;box-shadow:0 0 0 2px rgba(0,205,119,0.6)}
  .u6-mc > span{display:flex;flex-direction:column;gap:2px;font-size:14px;line-height:1.35;color:var(--ziel)}
  .u6-mc b{font-size:15.5px;font-weight:700;color:#ffffff}
  .u6-mc:hover{background:rgba(0,205,119,0.14);box-shadow:inset 0 0 0 1px rgba(0,205,119,0.5)}
  .u6-mc:focus-visible{outline:2px solid var(--ziel);outline-offset:3px}
  @media (prefers-reduced-motion:reduce){
    .u6z .u4z-wiz .u4z-gr,.u6z .u4z-wiz .u4z-gr i,.u6z .u4z-wiz .u4z-tas,.u6z .u4z-wl .t2{transition:none !important}
  }
  @media (max-width:900px){
    .u6z .u4z-wiz{top:84px}
    .u6z-kl{gap:4px 12px;font-size:11px}
    .u6z .u4z-k,.u6z .u4z-k:first-child{min-height:70vh}
    .u6-mc{padding-right:16px}
    .u6-mc img{width:42px;height:42px}
  }

  /* =====================================================================
     v6 · KARTA 2 · mapa procesu: tablica w kropki, cztery tory, węzły
     w procentach jednej siatki (kolumna 23,5%, wiersz 16,4%)
     ===================================================================== */
  .u6m{inset:22px 5%;border-radius:16px;background:radial-gradient(rgba(15,26,20,0.12) 1px,transparent 1.4px) 0 0/18px 18px,#ffffff;
    box-shadow:0 30px 60px -34px rgba(15,26,20,0.4),0 0 0 1px rgba(15,26,20,0.05)}
  .u6m > *{position:absolute}
  .u6m-tory{left:3%;right:3%;top:3%;height:10%;display:grid;grid-template-columns:repeat(4,minmax(0,1fr))}
  .u6m-tory span{display:flex;align-items:center;justify-content:center;gap:8px;min-width:0;font-size:12.5px;font-weight:650;color:var(--t2);white-space:nowrap}
  .u6m-tory img,.u6m-tory .agf,.u6m-tory i{flex:none;width:22px;height:22px;border-radius:50%;object-fit:cover}
  .u6m-tory i{display:grid;place-items:center;background:var(--papier)}
  .u6m-tory i svg{width:12px;height:12px;fill:var(--t2)}
  .u6m-l{left:0;top:0;width:100%;height:100%;overflow:visible}
  .u6m-l path{fill:none;stroke:rgba(15,26,20,0.5);stroke-width:1.5;vector-effect:non-scaling-stroke}
  .u6m-l path.sep{stroke:rgba(15,26,20,0.13);stroke-dasharray:4 5}
  .u6m-g{width:0;height:0;border:4.5px solid transparent}
  .u6m-g.p{border-left:7px solid rgba(15,26,20,0.55);border-right:0;transform:translate(-100%,-50%)}
  .u6m-g.d{border-top:7px solid rgba(15,26,20,0.55);border-bottom:0;transform:translate(-50%,-100%)}
  .u6m-n{left:calc(4.5% + var(--c) * 23.5%);top:calc(17% + var(--r) * 16.4%);width:20.5%;height:12.5%;display:flex;flex-direction:column;justify-content:center;padding:0 10px 0 14px;border-radius:9px;overflow:hidden;
    background:#ffffff;box-shadow:0 0 0 1px rgba(15,26,20,0.14),0 6px 14px -8px rgba(15,26,20,0.25)}
  .u6m-n::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--b,#c9d1cc)}
  .u6m-n b{font-size:13px;font-weight:650;line-height:1.2;color:var(--t1);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .u6m-n small{margin-top:2px;font-size:11.5px;line-height:1.25;color:var(--t3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .u6m-n.kl{--b:#9aa5a0}
  .u6m-n.ai{--b:#f0a33a}
  .u6m-n.cz{--b:#00CD77}
  .u6m-n.ok{--b:#00CD77;background:#e8f8ef}
  .u6m-n.wl{--b:#14130f}
  .u6m-d{left:calc(4.5% + var(--c) * 23.5% + 3.5%);top:calc(17% + var(--r) * 16.4% - 0.6%);width:13.5%;height:13.7%;display:grid;place-items:center;background:rgba(15,26,20,0.55);clip-path:polygon(50% 0,100% 50%,50% 100%,0 50%)}
  .u6m-d::before{content:"";position:absolute;inset:1.5px;background:#fff6e6;clip-path:polygon(50% 0,100% 50%,50% 100%,0 50%)}
  .u6m-d span{position:relative;font-size:11.5px;font-weight:650;line-height:1.15;text-align:center;color:var(--t1)}
  .u6m-e{transform:translate(-50%,-50%);font-size:11px;font-weight:700;color:var(--ziel-c)}
  .u6m-e.nie{color:var(--burs-c)}
  @media (max-width:600px){
    .u6m{inset:14px 3%}
    .u6m-tory b{display:none}
    .u6m-n{padding:0 5px 0 8px}
    .u6m-n b{font-size:10px;white-space:normal;line-height:1.15}
    .u6m-n small{display:none}
    .u6m-d span{font-size:8.5px}
  }

  /* =====================================================================
     v6 · KARTA 3 · narzędzia, które firma już ma, wokół systemu zleceń
     ===================================================================== */
  .u6n{inset:0}
  .u6n > *{position:absolute}
  .u6n-l{left:0;top:0;width:100%;height:100%}
  .u6n-l path{fill:none;stroke:rgba(10,122,82,0.5);stroke-width:1.5;stroke-dasharray:3 4;vector-effect:non-scaling-stroke}
  .u6n-c{left:40%;width:20%;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;align-items:center;gap:3px;padding:18px 10px 16px;border-radius:18px;background:#0e2b1d;color:#ffffff;text-align:center;box-shadow:0 30px 60px -30px rgba(15,26,20,0.55)}
  .u6n-c .tw{display:flex;margin-bottom:10px}
  .u6n-c .tw .agf{width:30px;height:30px;margin-left:-8px;border-radius:50%;background:#0e2b1d;box-shadow:0 0 0 2.5px #0e2b1d}
  .u6n-c .tw .agf:first-child{margin-left:0}
  .u6n-c b{font-size:15px;font-weight:700;letter-spacing:-0.01em}
  .u6n-c small{font-size:12px;line-height:1.3;color:rgba(255,255,255,0.65)}
  .u6n-t{top:calc(12% + var(--r) * 29%);height:18%;width:28%;display:flex;align-items:center;gap:12px;padding:0 14px;border-radius:14px;background:#ffffff;box-shadow:0 0 0 1px rgba(15,26,20,0.06),0 14px 30px -20px rgba(15,26,20,0.4)}
  .u6n-t.l{left:5%}
  .u6n-t.p{right:5%}
  .u6n-t .lg{flex:none;display:grid;place-items:center;width:40px;height:40px;border-radius:11px;background:#ffffff;box-shadow:0 0 0 1px rgba(15,26,20,0.08)}
  .u6n-t .lg img{width:24px;height:24px;object-fit:contain}
  .u6n-t .lg svg{width:20px;height:20px;fill:#1a73e8}
  .u6n-t .tx{display:flex;flex-direction:column;gap:2px;min-width:0}
  .u6n-t b{font-size:14px;font-weight:650;color:var(--t1);white-space:nowrap}
  .u6n-t small{font-size:12px;line-height:1.3;color:var(--t3)}
  @media (max-width:700px){
    .u6n{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;align-content:center;padding:16px}
    .u6n > *{position:static}
    .u6n-l{display:none}
    .u6n-c{grid-column:1 / -1;order:-1;width:auto;transform:none;flex-direction:row;justify-content:center;gap:10px;padding:12px}
    .u6n-c .tw{margin:0}
    .u6n-c small{display:none}
    .u6n-t{width:auto;height:auto;padding:10px;gap:8px}
    .u6n-t .lg{width:32px;height:32px}
    .u6n-t .lg img{width:20px;height:20px}
    .u6n-t b{font-size:12.5px;white-space:normal}
    .u6n-t small{display:none}
  }

  /* =====================================================================
     v6 · KARTA 4 · zespół: ściąga przyklejona taśmą, karteczki z pytaniami
     i osiem twarzy. Bez okna aplikacji.
     ===================================================================== */
  .u6t-k{left:6%;top:30px;width:52%;bottom:-30px;padding:26px 26px 0;border-radius:6px;background:#ffffff;transform:rotate(-1.6deg);box-shadow:0 30px 60px -32px rgba(15,26,20,0.45),0 0 0 1px rgba(15,26,20,0.05)}
  .u6t-k .tasma{position:absolute;left:50%;top:-11px;width:88px;height:22px;transform:translateX(-50%) rotate(2deg);background:rgba(236,214,160,0.8);box-shadow:0 1px 2px rgba(0,0,0,0.08)}
  .u6t-k header{padding-bottom:12px;border-bottom:1.5px solid var(--t1)}
  .u6t-k header b{display:block;font-size:17px;font-weight:750;letter-spacing:-0.02em}
  .u6t-k header span{display:block;margin-top:3px;font-size:12px;color:var(--t3)}
  .u6t-k ol{margin:12px 0 0;padding:0;list-style:none;counter-reset:s}
  .u6t-k li{counter-increment:s;display:grid;grid-template-columns:22px minmax(0,1fr);gap:10px;padding:9px 0;border-top:1px solid var(--linia2);font-size:13.5px;line-height:1.4;color:var(--t1)}
