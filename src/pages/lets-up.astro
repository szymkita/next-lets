// ---- pomocnicze -------------------------------------------------------------
const odm = (n: number, a: string, b: string, c: string) => {
  if (n === 1) return a;
  const d = n % 10, s = n % 100;
  return d >= 2 && d <= 4 && (s < 12 || s > 14) ? b : c;
};
const hm = (m: number) => {
  const h = Math.floor(m / 60), r = m % 60;
  if (!h) return `${r} min`;
  return r ? `${h} h ${String(r).padStart(2, '0')} min` : `${h} h`;
};
const f1 = (n: number) => n.toFixed(1);
const NB = ' ';

// ---- PRZYKŁAD: firma spedycyjna, 14 osób (PRZYKŁADOWE) ----------------------
const FIRMA = 'Firma spedycyjna';
const OSOB = 14;
const PRZY_ZLEC = 11;     // 8 spedytorów i 3 osoby w obsłudze i dokumentach
const GODZ = 130;         // godziny na zlecenia na osobę w miesiącu
// Jedno zlecenie: minuty pracy zespołu dziś (d). sys = co znika, gdy
// narzędzia są połączone (przepisywanie, dokumenty z danych zlecenia,
// statusy), ai = co przygotowuje AI, po = co zostaje przy ludziach. Nazwy
// czynności ogólne, żeby odnalazła się w nich firma z innej branży.
const ZLEC = [
  { t: 'Zapytanie i wycena dla klienta', d: 46, sys: 4, ai: 28 },
  { t: 'Dobór podwykonawcy i negocjacje', d: 88, sys: 0, ai: 52 },
  { t: 'Przepisywanie danych między narzędziami', d: 31, sys: 31, ai: 0 },
  { t: 'Dokumenty do zlecenia', d: 37, sys: 30, ai: 0 },
  { t: 'Pytania klienta o status', d: 34, sys: 18, ai: 12 },
  { t: 'Pilnowanie realizacji i wyjątki', d: 57, sys: 8, ai: 5 },
  { t: 'Szukanie dokumentów do faktury', d: 23, sys: 12, ai: 8 },
  { t: 'Rozliczenia z klientem i podwykonawcą', d: 68, sys: 6, ai: 16 },
].map((z) => ({ ...z, po: z.d - z.sys - z.ai }));
const MIN_DZIS = ZLEC.reduce((a, z) => a + z.d, 0);      // 384
const MIN_SYS = ZLEC.reduce((a, z) => a + z.sys, 0);     // 109
const MIN_AI = ZLEC.reduce((a, z) => a + z.ai, 0);       // 121
const MIN_1 = MIN_DZIS - MIN_SYS;                        // 275 po połączeniu narzędzi
const MIN_PO = ZLEC.reduce((a, z) => a + z.po, 0);       // 154
const MIN_A = 352, MIN_B = 304;
const SLOWNIE = ['zero', 'jedną', 'dwie', 'trzy', 'cztery', 'pięć', 'sześć', 'siedem', 'osiem'];

const MIESIACE: [string, number][] = [
  ['sty', 210], ['lut', 236], ['mar', 254], ['kwi', 268], ['maj', 280], ['cze', 290],
  ['lip', 298], ['sie', 304], ['wrz', 310], ['paź', 315], ['lis', 320], ['gru', 320],
];
const Z0 = MIESIACE[0][1];
const CEL = 320;
const naOsobe = (min: number) => (GODZ * 60) / min;
const potrzeba = (z: number, min: number) => Math.ceil(z / naOsobe(min) - 1e-9);
const ludzie = (min: number) => MIESIACE.map(([, z]) => OSOB + Math.max(0, potrzeba(z, min) - PRZY_ZLEC));
const L_DZIS = ludzie(MIN_DZIS);     // 14 → 19
const L_PO = ludzie(MIN_PO);         // 14 przez cały rok
const NOWI_DZIS = L_DZIS[L_DZIS.length - 1] - OSOB;   // 5
const NOWI_PO = L_PO[L_PO.length - 1] - OSOB;         // 0
const CAP_DZIS = Math.floor(PRZY_ZLEC * naOsobe(MIN_DZIS));  // 223 zlecenia, które obsłuży zespół
const CAP_PO = Math.floor(PRZY_ZLEC * naOsobe(MIN_PO));      // 557
const ZL_PROC = Math.round((CEL / Z0 - 1) * 100);                              // 52

