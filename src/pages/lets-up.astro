  .u4s-op span svg{flex-shrink:0;width:15px;height:15px;margin-top:1px;fill:var(--ziel-c)}
  .u4s-wyj{grid-column:2;grid-row:3;position:relative;margin:22px clamp(14px,1.6vw,24px) 0 0;padding:14px 16px 14px 44px;border-radius:14px;background:#ffffff;box-shadow:0 0 0 1px rgba(15,26,20,0.06);font-size:13.5px;line-height:1.5;color:var(--t2)}
