.bk .ark{
pointer-events:auto;position:absolute;left:10px;right:10px;bottom:calc(10px + env(safe-area-inset-bottom));border-radius:20px;background:#fff;box-shadow:0 20px 60px -20px rgba(0,0,0,.6);transform:translateY(calc(100% + 30px));visibility:hidden;transition:transform .45s cubic-bezier(.2,.8,.2,1),visibility 0s .45s}
.bk .pas.otw .ark{
transform:none;visibility:visible;transition:transform .45s cubic-bezier(.2,.8,.2,1)}
.bk .ark-g{
display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px 18px 0;font-size:17px;letter-spacing:-.015em}
.bk .ark-x{
border:0;background:var(--papier);border-radius:50%;width:32px;height:32px;display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0}
.bk .ark-x svg{
width:14px;height:14px;fill:none;stroke:var(--t1);stroke-width:2;stroke-linecap:round}
@media (min-width:1000px){
.bk .hero-f{
left:auto;right:0;top:0;width:52%;height:100%}
.bk .hero-pl::after{
background:linear-gradient(90deg,var(--ink) 40%,rgba(7,20,13,.6) 52%,rgba(7,20,13,0) 70%)}
.bk .hero-t{
max-width:640px;margin:auto 0;padding:0 var(--pad) 40px}
.bk .st{
display:grid;grid-template-columns:minmax(0,4fr) minmax(0,8fr);grid-template-rows:1fr auto;column-gap:56px;padding:48px var(--pad) 110px}
.bk .op{
grid-column:1;grid-row:1;align-self:center}
.bk .op-zd{
