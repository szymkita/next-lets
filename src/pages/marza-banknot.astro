.bk .por{
padding:clamp(64px,11vw,140px) 0 clamp(56px,9vw,110px);background:var(--papier)}
.bk .pod-m{
display:flex;align-items:center;gap:12px;margin:0 0 16px;font-size:15px;font-weight:650;color:var(--t1)}
.bk .pod-m::before{
content:"";width:22px;height:2px;background:var(--ziel)}
.bk .h2{
margin:0;font-size:clamp(34px,8.6vw,68px);line-height:1.02;letter-spacing:-.046em;font-weight:700;text-wrap:balance}
