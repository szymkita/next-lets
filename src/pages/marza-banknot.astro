.bk .dalej{
display:inline-flex;align-items:center;gap:9px;font-size:15px;font-weight:650;text-decoration:none;color:rgba(255,255,255,.8)}
.bk .dalej i{
width:8px;height:8px;border-right:2px solid currentColor;border-bottom:2px solid currentColor;transform:translateY(-2px) rotate(45deg)}
.bk .scena{
position:relative;height:calc(var(--h) * 1vh);height:calc(var(--h) * 1svh);background:#0a130e}
.bk .scena::before{
content:"";position:absolute;inset:0;background:radial-gradient(120% 70% at 18% 0%,rgba(255,236,200,.08),rgba(0,0,0,0) 55%),radial-gradient(90% 60% at 80% 100%,rgba(0,205,119,.06),rgba(0,0,0,0) 60%);pointer-events:none}
.bk .st{
position:sticky;top:0;height:100vh;height:100svh;display:flex;flex-direction:column;gap:10px;padding:18px var(--pad) calc(86px + env(safe-area-inset-bottom));max-width:1240px;margin:0 auto;color:#fff;overflow:hidden}
