margin:8px 0 0;font-size:16px;line-height:1.45;color:rgba(255,255,255,.72);text-wrap:pretty}
.bk .stol{
position:relative;flex:1;min-height:0}
.bk .stol .bn-o{
position:absolute;left:50%;top:50%;width:var(--L,300px);transform:translate(-50%,-50%) rotate(var(--rot,-84deg))}
.bk .bn{
display:block;width:100%;height:auto;overflow:visible;filter:drop-shadow(0 14px 18px rgba(0,0,0,.55)) drop-shadow(0 2px 3px rgba(0,0,0,.4))}
.bk .dol{
flex-shrink:0}
.bk .lz{
display:flex;align-items:baseline;justify-content:space-between;gap:12px}
