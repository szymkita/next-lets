color:#fff}
.bk .kon-kto a{
font-weight:700;color:#fff;white-space:nowrap}
.bk .fakty{
max-width:1440px;margin:20px auto 0;padding:0 var(--pad);display:flex;flex-wrap:wrap;gap:8px 22px;font-size:14px;color:var(--t2)}
.bk .fakty b{
color:var(--t1)}
.bk .kz{
display:block;border-radius:18px;background:#fff;color:var(--t1);padding:18px}
.bk .kz-l{
display:block;font-size:14px;font-weight:650;margin-bottom:8px}
.bk .kz-i{
