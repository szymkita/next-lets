.bk .bn-k figcaption small{
font-size:12.5px;color:rgba(255,255,255,.5)}
.bk .por-t{
max-width:640px;margin:clamp(24px,4vw,40px) 0 0;font-size:clamp(16px,4.2vw,18px);line-height:1.6;color:var(--t2);text-wrap:pretty}
.bk .przyk{
