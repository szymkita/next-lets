<script is:inline>
/* MARŻA · BANKNOT — ugryzienia banknotu przewijane palcem i jedno pole kontaktu.
   Banknot to obraz w SVG z dwiema maskami: zewnętrzna wycina obraz, wewnętrzna (mniejsza, z włóknami)
   wycina jasny rdzeń papieru, więc na brzegu ugryzienia widać postrzępiony papier. */
(()=>{
const SNAP=!!window.__snap, RM=matchMedia('(prefers-reduced-motion: reduce)').matches;
const $=(s,r=document)=>r.querySelector(s), $$=(s,r=document)=>[...r.querySelectorAll(s)];
const cl=(v,a=0,b=1)=>Math.min(b,Math.max(a,v)), ss=v=>{v=cl(v);return v*v*(3-2*v);};
const zl=v=>v.toFixed(2).replace('.',',')+' zł';
const NS='http://www.w3.org/2000/svg';

/* ugryzienia: koła [cx, cy, r] w układzie 1000×467, kwota, okno w scenie */
const UG=[
  {k:[[995,-15,150],[880,-50,105]], zl:14.40, od:.05, do:.13},
  {k:[[1050,250,165],[1020,460,125]], zl:11.20, od:.19, do:.27},
  {k:[[780,545,150],[650,535,105]], zl:9.60, od:.33, do:.41},
  {k:[[700,-72,150],[560,-42,105]], zl:8.80, od:.47, do:.55},
  {k:[[1000,233,330]], zl:7.20, od:.61, do:.69},
  {k:[[650,233,230],[620,-170,260],[560,640,260],[430,625,170]], zl:13.84, od:.74, do:.83},
];
const SKUB=[{k:[[990,12,52],[948,-10,32]], zl:5, od:0, do:0}];
const PROGI=[0,.16,.30,.44,.58,.715,.87];

/* poszarpany brzeg: ząbki co ~36 jednostek + szum; wewnętrzny brzeg z włóknami */
let ziarno=7; const los=()=>{ziarno=(ziarno*16807)%2147483647;return (ziarno-1)/2147483646;};
function ksztalt(r){
  const n=Math.max(64,Math.round(r/1.6)), k=Math.max(6,Math.round(2*Math.PI*r/36));
  const f=[los()*6.28,los()*6.28,los()*6.28], out=[], inn=[];
  for(let i=0;i<n;i++){
    const t=i/n*Math.PI*2;
    const sz=1+.055*Math.sin(3*t+f[0])+.03*Math.sin(7*t+f[1])+.02*Math.sin(13*t+f[2])+.012*Math.sin(31*t+f[0])+(los()-.5)*Math.min(.05,7/r);
    const z=1-.03*Math.pow(Math.sin(k*t/2),2);
    const ro=sz*z; out.push([t,ro*1.0]);
    let ri=ro*(1-Math.min(.028,9/r))-(los()<.3?(.006+los()*.016)*Math.min(1,60/r*2):0);
    inn.push([t,ri]);
  }
  return {out,inn};
}
UG.concat(SKUB).forEach(u=>u.ks=u.k.map(([,,r])=>ksztalt(r)));
const sciezka=(cx,cy,r,pts)=>{ if(r<.5) return ''; let d=''; pts.forEach(([t,f],i)=>{ d+=(i?'L':'M')+(cx+Math.cos(t)*r*f).toFixed(1)+' '+(cy+Math.sin(t)*r*f).toFixed(1); }); return d+'Z'; };
function rysuj(bn,stan){ /* stan: lista [ugryzienie, skala 0..1] */
  let dO='', dI='';
  stan.forEach(([u,t])=>{ if(t<=0) return; const n=u.k.length, sp=n>2?.5:.8, kr=n>1?(1-sp)/(n-1):0;
    u.k.forEach(([cx,cy,r],j)=>{ const s=ss((t-j*kr)/sp); const R=r*s; dO+=sciezka(cx,cy,R,u.ks[j].out); dI+=sciezka(cx,cy,R,u.ks[j].inn); }); });
  bn.o.setAttribute('d',dO||'M0 0Z'); bn.i.setAttribute('d',dI||'M0 0Z');
}
const banknoty={}; $$('[data-bn]').forEach(el=>{ banknoty[el.dataset.bn]={el,o:$('[data-out]',el),i:$('[data-in]',el)}; });
if(banknoty.strzep) rysuj(banknoty.strzep,UG.map(u=>[u,1]));
if(banknoty.system) rysuj(banknoty.system,SKUB.map(u=>[u,1]));

/* scena */
const sc=$('#zjada'), stol=$('.stol',sc), oz=$$('.oz',sc), sy=$$('.sy',sc), nEl=$('[data-n]',sc), kw=$('[data-kw]',sc), zost=$('[data-zost]',sc), pasZ=$('#pasZ');
const KW=['−14,40 zł','−11,20 zł','−9,60 zł','−8,80 zł','−7,20 zł','−13,84 zł','34,96 zł'];
let cur=-1,tgt=0,krok=-1,raf=0;
function uklad(){
  const r=stol.getBoundingClientRect(), R=1000/467, pion=innerWidth<1000&&r.height>r.width*1.1;
  const L=pion?Math.min(r.height*.94, r.width/(1/R+.11)):Math.min(r.width*.96, r.height*R*.86);
  const bo=banknoty.glowny.el; bo.style.setProperty('--L',L.toFixed(0)+'px'); bo.style.setProperty('--rot',pion?'84deg':'-4deg');
}
function ustaw(p){
  rysuj(banknoty.glowny,UG.map(u=>[u,cl((p-u.od)/(u.do-u.od))]));
  let z=100; UG.forEach(u=>z-=u.zl*ss((p-u.od)/(u.do-u.od)));
  const t=zl(Math.max(0,z)); zost.textContent=t; if(pasZ) pasZ.textContent=t;
  let k=0; PROGI.forEach((q,i)=>{ if(p>=q) k=i; });
  if(k!==krok){ krok=k; oz.forEach((e,i)=>e.classList.toggle('on',i===k)); sy.forEach((e,i)=>e.classList.toggle('on',i===k)); nEl.textContent=k<6?(k+1)+'/6':'koniec'; kw.textContent=KW[k]; kw.style.color=k===6?'#fff':''; }
}
function cel(){ const r=sc.getBoundingClientRect(); tgt=cl(-r.top/Math.max(1,r.height-innerHeight)); }
function klatka(){ raf=0; const n=(SNAP||RM||cur<0)?tgt:cur+(tgt-cur)*.16; const kon=Math.abs(tgt-n)<.0004; cur=kon?tgt:n; ustaw(cur); if(!kon) raf=requestAnimationFrame(klatka); }
const ruch=()=>{ cel(); if(!raf) raf=requestAnimationFrame(klatka); };
addEventListener('scroll',ruch,{passive:true}); addEventListener('resize',()=>{uklad();ruch();});
uklad(); cel(); cur=tgt; ustaw(cur);
})();

/* ───── kontakt: arkusz z paska i formularz na dole, jedna treść ─────
   POST /api/kontakt jak formularz strony (Zgody.astro dokłada Lead dla Mety). */
(()=>{
const $=(s,r=document)=>r.querySelector(s), $$=(s,r=document)=>[...r.querySelectorAll(s)];
const stat=(e,p)=>{try{window.laStat&&window.laStat(e,p||{});}catch(x){}};
const pas=$('#pas'), hero=$('#hero'), kon=$('#kontakt'), formy=$$('.kz');
const MAIL=/^[^\s@]+@[^\s@]+\.[a-zA-Z]{2,}$/;
let otw=false, wysylam=false, wyslane=false;
function widac(){ const vh=innerHeight, h=hero.getBoundingClientRect(), k=kon.getBoundingClientRect(); const on=!wyslane&&h.bottom<vh*.4&&k.top>vh*.85; pas.classList.toggle('on',on); if(!on&&otw&&k.top<vh*.85) zamknij(); }
addEventListener('scroll',widac,{passive:true}); addEventListener('resize',widac); widac();
function otworz(skad){ otw=true; pas.classList.add('otw'); stat('banknot_otworz',{skad}); setTimeout(()=>{try{$('.kz-i',$('.ark')).focus({preventScroll:true});}catch(x){}},320); }
function zamknij(){ otw=false; pas.classList.remove('otw'); }
$$('[data-otworz]').forEach(b=>b.addEventListener('click',()=>otworz(b.dataset.otworz)));
$$('[data-zamknij]',pas).forEach(b=>b.addEventListener('click',zamknij));
addEventListener('keydown',e=>{ if(e.key==='Escape'&&otw) zamknij(); });
$$('[data-tel]').forEach(el=>el.addEventListener('click',()=>stat('tel_klik',{skad:el.dataset.tel})));
function rozpoznaj(v){
  if(v.includes('@')) return MAIL.test(v)?{email:v,telefon:''}:{blad:'adres chyba niepełny?'};
  const c=v.replace(/\D/g,''); if(c.length<9) return {blad:v?'za mało cyfr?':'tu wpisz numer albo mail'};
  return {email:'',telefon:(c.length===9?'+48 ':'+')+c.replace(/^00/,'')};
}
formy.forEach(f=>{
  const i=$('.kz-i',f), z=$('input[name=zgoda]',f);
  i.addEventListener('input',()=>{ const mail=i.value.includes('@'); formy.forEach(g=>{ if(g!==f) $('.kz-i',g).value=i.value; $('.kz-err',g).textContent=''; $('.kz-wt',g).textContent=mail?'Napiszcie do mnie':'Zadzwońcie do mnie'; }); });
  z.addEventListener('change',()=>formy.forEach(g=>{ $('input[name=zgoda]',g).checked=z.checked; $('.kz-z',g).classList.remove('err'); }));
  f.addEventListener('submit',e=>{ e.preventDefault(); wyslij(f); });
});
function wyslij(f){
  if(wysylam||wyslane) return;
  const i=$('.kz-i',f), err=$('.kz-err',f), z=$('input[name=zgoda]',f), btn=$('.btn',f), bt=$('.kz-wt',f);
  const r=rozpoznaj(i.value.trim());
  if(r.blad){ err.textContent=r.blad; i.focus(); return; }
  if(!z.checked){ $('.kz-z',f).classList.add('err'); err.textContent='zaznacz zgodę poniżej'; return; }
  wysylam=true; btn.disabled=true; const napis=bt.textContent; bt.textContent='Wysyłam…';
  const miejsce=f.dataset.k; let ref=''; try{ref=localStorage.getItem('referrer')||'';}catch(x){}
  fetch('/api/kontakt',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},
    body:JSON.stringify({email:r.email,telefon:r.telefon,
      wiadomosc:'Landing '+location.pathname+' ('+miejsce+'): proszę o '+(r.telefon?'telefon':'maila')+', chcę zobaczyć, co zjada marżę u nas.',
      firma_www:f.elements.kontrola.value||'',zrodlo:'Marża · banknot · '+location.pathname+' · '+miejsce,referrer:ref})})
  .then(o=>{ if(!o.ok) return o.json().catch(()=>({})).then(j=>{throw new Error(j.blad||'blad');});
    wyslane=true;
    try{window.dataLayer=window.dataLayer||[];window.dataLayer.push({event:'formularz_wyslany',zrodlo:'Marża · banknot'});}catch(x){}
    stat('banknot_wyslane',{miejsce,kanal:r.telefon?'telefon':'email'});
    formy.forEach(g=>{ g.classList.add('wyslane'); $('.kz-ok span',g).textContent=r.telefon?'Dzięki! Piotr zadzwoni w jeden dzień roboczy.':'Dzięki! Piotr odpisze w jeden dzień roboczy.'; $('.kz-ok',g).hidden=false; });
    setTimeout(()=>{ zamknij(); widac(); },2200); })
  .catch(x=>{ wysylam=false; btn.disabled=false; bt.textContent=r.email?'Napiszcie do mnie':'Zadzwońcie do mnie';
    err.textContent=x&&x.message==='brak-konfiguracji'?'nie działa, zadzwoń: 571 399 932':'nie doszło, spróbuj jeszcze raz';
    stat('banknot_blad',{powod:String(x&&x.message||'blad').slice(0,30)}); });
}
})();

