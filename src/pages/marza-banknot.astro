.bk .kz-err{
display:block;min-height:18px;margin-top:5px;font-size:13px;color:#c0392b}
.bk .kz-z{
display:flex;align-items:flex-start;gap:9px;margin:4px 0 14px;font-size:12.5px;line-height:1.4;color:var(--t2);cursor:pointer}
.bk .kz-z input{
position:absolute;opacity:0;pointer-events:none}
.bk .kz-box{
flex-shrink:0;width:18px;height:18px;border-radius:5px;box-shadow:inset 0 0 0 1.5px #a8b0aa;background:#fff;position:relative}
.bk .kz-z input:checked + .kz-box{
background:var(--ziel-c);box-shadow:none}
.bk .kz-z input:checked + .kz-box::after{
content:"";position:absolute;left:6px;top:2.5px;width:5px;height:9px;border:solid #fff;border-width:0 2px 2px 0;transform:rotate(45deg)}
