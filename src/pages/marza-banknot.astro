---
// MARŻA · BANKNOT — /marza-banknot. Landing pod reklamę Meta „Marża” k32 (wygryziony banknot,
// „Wiemy, co zjada Twoją marżę.”). Szymon 21.11.2026: „ale przecież to nie tylko zamówienia… zrób najpierw
// landing”. 100 zł marży z zamówienia za 800 zł zjadane przez pięć obszarów (oferta, zamówienie, telefony,
// faktura, pomyłka), liczby te same co na /marza (88,64 zł obsługi, zostaje 11,36 zł; z systemem 9,52 / 90,48).
// Źródło: ~/filmy/lets-meta-marza/landing-banknot (build.py generuje ten plik — zmiany rób tam).
// noindex, bez nawigacji, zgłoszenia ze źródłem „Marża · banknot · <miejsce>”.
import LaBase from '../layouts/LaBase.astro';
const title = "Wiemy, co zjada Twoją marżę | Let's automate";
const description = "Ze 100 zł marży na zamówieniu za 800 zł zostaje 11,36 zł. Zobacz, co ją zjada, i jak zostaje 90,48 zł. Pokażemy to u Ciebie, za darmo.";
---
<LaBase topbar={false} title={title} description={description} ctaHref="#kontakt" nav={null} naglowek={false} noindex={true} ogImage="/marza-banknot/og.jpg">
<style is:global>
@font-face{
font-family:"BkMono";font-style:normal;font-weight:400 700;font-display:swap;src:url(/fonts/jetbrains-mono-v24-normal-400-700-latin-ext.woff2) format("woff2");unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}
@font-face{
font-family:"BkMono";font-style:normal;font-weight:400 700;font-display:swap;src:url(/fonts/jetbrains-mono-v24-normal-400-700-latin.woff2) format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
.bk{

  --ink:#07140d; --ink2:#0d2118; --papier:#f4f3ee;
  --t1:#0f1a14; --t2:#46524b; --t3:#7b867f;
  --ziel:#00CD77; --ziel-c:#0a7a52; --burs:#f0a33a; --burs-j:#ffc879;
  --f:"Schibsted Grotesk",system-ui,-apple-system,sans-serif;
  --f-m:"BkMono","JetBrains Mono",ui-monospace,Menlo,monospace;
  --pad:clamp(16px,5vw,56px); --ram:clamp(6px,.9vw,14px);}
.bk{
margin:0;background:#fff;color:var(--t1);font-family:var(--f);-webkit-font-smoothing:antialiased;overflow-x:clip}
.bk *{
box-sizing:border-box}
.bk a{
color:inherit}
.bk .w{
max-width:1240px;margin:0 auto;padding:0 var(--pad)}
.bk button{
font:inherit}
.bk .btn{
display:inline-flex;align-items:center;gap:14px;border:0;cursor:pointer;background:var(--ziel);color:var(--ink);font-weight:700;font-size:16px;letter-spacing:-.01em;padding:9px 9px 9px 22px;border-radius:999px;white-space:nowrap;transition:background .2s,transform .15s}
.bk .btn span{
display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:50%;background:var(--ink);color:var(--ziel);font-size:15px;transition:transform .25s}
.bk .btn:hover{
background:#25dd8b}
.bk .btn:hover span{
transform:translateX(3px)}
.bk .btn:active{
transform:scale(.98)}
.bk .btn[disabled]{
opacity:.6;cursor:default}
.bk .hero{
padding:var(--ram) var(--ram) 0}
.bk .hero-pl{
position:relative;max-width:1440px;margin:0 auto;border-radius:clamp(20px,2.2vw,32px);background:var(--ink);color:#fff;overflow:hidden;min-height:calc(100svh - var(--ram));display:flex;flex-direction:column}
.bk .hero-f{
position:absolute;left:-12%;top:-7%;width:142%;max-width:none;height:auto}
.bk .hero-pl::after{
content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(7,20,13,.55) 0,rgba(7,20,13,0) 18%,rgba(7,20,13,0) 34%,rgba(7,20,13,.92) 56%,var(--ink) 66%);pointer-events:none}
