.bk .op-zd{
position:relative;height:calc(1.1em * 1 + 10px + 3 * 1.45 * 16px);font-size:clamp(26px,7.4vw,34px)}
.bk .oz{
position:absolute;inset:0 0 auto;opacity:0;transform:translateY(8px);transition:opacity .35s ease,transform .45s cubic-bezier(.2,.8,.2,1)}
