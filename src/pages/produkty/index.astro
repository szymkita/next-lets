---
<LaBase topbar={false} title={title} description={description} ctaLabel="Umów rozmowę" nav={null}>
<script type="application/ld+json" is:inline set:html={JSON.stringify(dane)} slot="head"></script>

<style is:global slot="head">
  /* Style tej strony. Wspólny wygląd: src/components/usluga/Styl.astro. */

  /* =====================================================================
     PRODUKT · tekst i obraz w dwóch kolumnach
     Appto: tekst → film. Wingman: makieta → tekst (odwrócone), żeby dwa
     produkty nie stały jak dwa równe kafle. Obraz to prawdziwy materiał
     produktu, bez ramki-kafla dookoła.
     ===================================================================== */
  /* Appto stoi na bieli zaraz pod logotypami, więc bez pełnego odstępu sekcji */
  #appto{padding-top:clamp(32px,4vw,64px)}
  .pr{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:clamp(36px,5vw,96px);align-items:center}
  .pr.odwr{grid-template-columns:minmax(0,7fr) minmax(0,5fr)}
  .pr.odwr .pr-w{order:-1}
  .pr-lok{display:flex;align-items:center;gap:16px}
  .pr-zn{display:grid;place-items:center;flex-shrink:0;width:56px;height:56px;border-radius:16px;background:var(--ink);color:var(--ziel)}
  .pr-zn svg{display:block;width:30px;height:auto}
  .pr-zn svg.ik{width:26px;height:26px}
  .pr-logo{display:block;width:auto;height:clamp(38px,3.4vw,50px)}
  .pr-lok.appto .pr-k{margin-top:12px}
  .pr-n{margin:0;font-size:clamp(34px,3.6vw,52px);font-weight:700;letter-spacing:-0.045em;line-height:1;color:var(--t1)}
  .pr-k{margin:6px 0 0;font-size:15px;font-weight:650;color:var(--ziel-c)}
  .pr-def{margin:clamp(22px,2.4vw,30px) 0 0;font-size:clamp(17px,1.4vw,20px);line-height:1.55;letter-spacing:-0.01em;color:var(--t1);text-wrap:pretty}
  .pr-sp{margin:clamp(22px,2.4vw,30px) 0 0;border-top:1px solid var(--linia)}
  .pr-sp div{display:grid;grid-template-columns:104px minmax(0,1fr);gap:14px;padding:12px 0;border-bottom:1px solid var(--linia2)}
  .pr-sp dt{font-size:13.5px;font-weight:650;line-height:1.5;color:var(--t3)}
  .pr-sp dd{margin:0;font-size:15px;line-height:1.5;color:var(--t1);text-wrap:pretty}
  .pr-ak{display:flex;flex-wrap:wrap;align-items:center;gap:14px 26px;margin-top:clamp(26px,2.8vw,36px)}
  .pr-lnk{font-size:16px;font-weight:650;color:var(--t1);padding:8px 2px;border-bottom:1px solid rgba(15,26,20,0.25);transition:border-color .2s}
  .pr-lnk:hover{border-color:var(--ziel-c)}
  @media (max-width:980px){
    .pr,.pr.odwr{grid-template-columns:minmax(0,1fr)}
    .pr.odwr .pr-w{order:0}
  }
  @media (max-width:480px){ .pr-sp div{grid-template-columns:minmax(0,1fr);gap:2px} }
  /* na telefonie oferta to sam czat (portret) — węższy, żeby nie zajął ekranu */

  /* ---- film „Poznaj appto": podgląd, odtwarzacz po kliknięciu ---- */

  /* ---- hero: trzy aplikacje przy pracy ----
     Prawdziwe okno Appto (zrzut z appto.ai), na nim pasek Wingmana z kartą
     odpowiedzi, z prawej telefon klienta z ofertą z Ofert AI (żywy
     komponent OfertaNordis w układzie na telefon). Każdy element prowadzi
     do swojej sekcji; podpis jest etykietą przy elemencie. Kompozycja wisi
     na dolnej krawędzi planszy, jak okna w hero podstron. */
  .hk-scena{position:relative;aspect-ratio:1328 / 690}
  .hk-el{position:absolute;display:block;color:inherit;transition:transform .35s cubic-bezier(.2,.8,.2,1)}
  .hk-el img{display:block;width:100%;height:auto}
  .hk-appto{left:17%;top:0;width:60%}
  .hk-appto img{filter:drop-shadow(0 24px 34px rgba(7,20,13,0.3)) drop-shadow(0 4px 10px rgba(7,20,13,0.15))}
  .hk-wm{left:15%;top:54%;width:43%;z-index:2}
  .hk-wm img{filter:drop-shadow(0 22px 26px rgba(7,20,13,0.28)) drop-shadow(0 4px 8px rgba(7,20,13,0.18))}
  .hk-tel{right:3%;top:9%;width:250px;z-index:3}
  .hk-el:hover,.hk:has([data-cel="appto"]:hover) .hk-appto,.hk:has([data-cel="wm"]:hover) .hk-wm,.hk:has([data-cel="tel"]:hover) .hk-tel{transform:translateY(-6px)}
  /* Podpis przy elemencie: sam tekst na planszy, od niego cienka linia
     w dół do krawędzi elementu, zakończona punktem. Podpis Wingmana stoi
     w ciemnym pasie po lewej od okna Appto, więc jest węższy. */
  .hk-et{position:absolute;left:22px;bottom:calc(100% + 16px);display:block;padding-left:14px;font-size:13.5px;line-height:1.4;color:rgba(255,255,255,0.58);white-space:nowrap;text-align:left}
  .hk-et span{display:block}
  .hk-et b{display:block;font-size:15.5px;font-weight:700;letter-spacing:-0.015em;color:#ffffff}
  .hk-et::before{content:"";position:absolute;left:0;top:5px;bottom:-16px;width:1px;background:linear-gradient(180deg,rgba(255,255,255,0.2),rgba(255,255,255,0.55))}
  .hk-et::after{content:"";position:absolute;left:-3px;bottom:-19px;width:7px;height:7px;border-radius:50%;background:#ffffff;box-shadow:0 0 0 3px rgba(255,255,255,0.14)}
  .hk-el:hover .hk-et::before,.hk-el:focus-visible .hk-et::before{background:var(--ziel)}
  .hk-el:hover .hk-et::after,.hk-el:focus-visible .hk-et::after{background:var(--ziel);box-shadow:0 0 0 3px rgba(0,205,119,0.25)}
  .hk-el:focus-visible .hk-et b{text-decoration:underline;text-underline-offset:4px}
  /* Wingman: podpis z lewej strony paska, linia pozioma do jego krawędzi */
  .hk-wm .hk-et{left:auto;right:calc(100% + 20px);bottom:auto;top:4px;width:calc(15 / 43 * 100% - 24px);padding:0;text-align:right;white-space:normal;text-wrap:balance}
  .hk-wm .hk-et::before{left:auto;right:-20px;top:11px;bottom:auto;width:16px;height:1px;background:linear-gradient(90deg,rgba(255,255,255,0.2),rgba(255,255,255,0.55))}
  .hk-wm .hk-et::after{left:auto;right:-23.5px;top:8px;bottom:auto}
  .hk-tel .hk-et{left:26px}
  /* na telefonie zamiast podpisów przy elementach: rząd nazw pod sceną */
  .hk-leg{display:none}
  .hk-leg a{display:flex;align-items:center;gap:12px;color:var(--t2);transition:color .2s}
  .hk-leg svg{flex:none;width:22px;height:22px;color:var(--t1)}
  .hk-leg svg.appto{width:24px;height:auto}
  .hk-leg span{font-size:14.5px;line-height:1.35}
  .hk-leg b{display:block;font-size:15px;font-weight:700;letter-spacing:-0.01em;color:var(--t1)}
  .hk-leg a:hover b{color:var(--ziel-c)}
  .hk-leg a:focus-visible{outline:2px solid var(--ziel);outline-offset:4px;border-radius:6px}
  .hk-el:focus-visible{outline:none}
  /* telefon */
  .hk-tel-ramka{display:block;aspect-ratio:9 / 19;padding:9px;border-radius:40px;background:linear-gradient(160deg,#2b302d,#0e100f 40%);box-shadow:inset 0 0 0 1.5px rgba(255,255,255,0.1),0 50px 80px -30px rgba(0,0,0,0.75),0 18px 30px -18px rgba(0,0,0,0.5)}
  .hk-tel-ekran{position:relative;display:block;height:100%;overflow:hidden;border-radius:31px;background:#fffdfb}
  .hk-tel-ekran::before{content:"";position:absolute;z-index:4;top:9px;left:50%;width:76px;height:21px;margin-left:-38px;border-radius:12px;background:#0b0c0b}
  .hk-tel-doc{display:block;width:390px;zoom:0.595;container-type:inline-size;pointer-events:none}
  .hk-tel-doc .od-hero{padding-top:52px}
  .hk-tel-pasek{position:absolute;z-index:3;left:10px;right:10px;bottom:10px;display:flex;gap:5px;padding:5px;border-radius:999px;background:rgba(255,255,255,0.92);box-shadow:0 0 0 1px rgba(27,20,15,0.08),0 12px 24px -12px rgba(80,30,5,0.5)}
  .hk-tel-pasek i{flex:1;display:grid;place-items:center;height:27px;border-radius:999px;font-style:normal;font-size:10.5px;font-weight:650;color:#1b140f;box-shadow:inset 0 0 0 1px rgba(27,20,15,0.14);white-space:nowrap}
  .hk-tel-pasek i:first-child{background:linear-gradient(100deg,#e2531f,#f2672a 55%,#f58a2e);color:#ffffff;box-shadow:none}
  @media (max-width:1180px){
    .hk-tel{width:200px}
    .hk-scena{margin-top:30px}
    .hk-wm .hk-et span{display:none}
    .hk-tel-doc{zoom:0.466}
    .hk-tel-ramka{border-radius:32px;padding:8px}
    .hk-tel-ekran{border-radius:25px}
  }
  @media (max-width:760px){
    .hk{margin-top:36px}
    .hk-scena{aspect-ratio:358 / 330}
    .hk-et{display:none}
    .hk-leg{display:flex;flex-wrap:wrap;justify-content:flex-start;gap:10px 22px;margin-top:22px}
    .hk-leg a{gap:8px}
    .hk-leg span{font-size:0}
    .hk-leg b{font-size:14px}
    .hk-leg svg{width:18px;height:18px}
    .hk-leg svg.appto{width:20px}
    .hk-appto{left:0;width:100%}
    .hk-wm{top:52%;width:78%}
    .hk-tel{right:0;top:20%;width:118px}
    .hk-tel-doc{zoom:0.262}
    .hk-tel-ramka{border-radius:20px;padding:5px}
    .hk-tel-ekran{border-radius:16px}
    .hk-tel-ekran::before{top:5px;width:34px;height:10px;margin-left:-17px}
    .hk-tel-pasek{left:5px;right:5px;bottom:5px;padding:3px}
    .hk-tel-pasek i{height:15px;font-size:6px}
  }

  /* =====================================================================
     GRANICA · kiedy gotowy produkt nie wystarczy
     Tekst po lewej, po prawej trzy usługi w wierszach na linii.
     ===================================================================== */
  .gr{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:clamp(32px,5vw,104px);align-items:start}
  .gr-t .v3-sub{margin-top:clamp(20px,2vw,28px)}
  .gr-t .v3-sub + .v3-sub{margin-top:14px}
  .gr-et{margin:0 0 14px;font-size:14px;font-weight:650;color:var(--t2)}
  .gr-lista{border-top:1.5px solid var(--t1)}
  .gr-lista a{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:4px 24px;padding:clamp(20px,2vw,26px) 0;border-bottom:1px solid var(--linia)}
  .gr-lista b{font-size:clamp(20px,1.9vw,26px);font-weight:700;letter-spacing:-0.03em;line-height:1.15;color:var(--t1)}
  .gr-lista span{grid-column:1;font-size:15px;line-height:1.5;color:var(--t2)}
  .gr-lista i{grid-row:1 / 3;grid-column:2;display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:var(--ink);color:var(--ziel);transition:transform .25s}
  .gr-lista i svg{width:16px;height:16px}
  .gr-lista a:hover b{color:var(--ziel-c)}
  .gr-lista a:hover i{transform:translateX(4px)}
  @media (max-width:980px){ .gr{grid-template-columns:minmax(0,1fr)} }
</style>

