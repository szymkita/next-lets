---
// APPTO — /produkty/appto-new (propozycja, czwarta wersja 16.10.2026, noindex)
// Obecna /produkty/appto (w menu) i appto-v2 zostają bez zmian, dopóki Szymon
// nie powie „podmień". Koncepcja i historia wersji: docs/appto-new-koncepcja.md.
//
// KIERUNEK (uwaga Szymona z 16.10.2026): „Uprość tę stronę, usuń informacje
// o wydaniach, usuń też kwestię związaną z ofertą dla klienta i mailem do
// klienta, który się rozmyślił. Skup się na tym, że poza appką to jest też
// nasza metoda wdrożenia, i na razie tyle." Stąd: film w hero, czym jest
// Appto, metoda wdrożenia (dziesięć kroków i trzy sposoby jej przejścia),
// dla kogo, kontakt, FAQ. Tabela porównania z wersji 3 zeszła razem z resztą.
//
// SKĄD FAKTY (repo ApptoAI/landing-page = źródło appto.ai, stan z 13.10.2026):
//   · metoda: src/data/home.ts — dziesięć kroków (method), trzy ścieżki
//     wdrożenia (rollout: Samodzielnie, Z opiekunem, Kohortowo) i ich opisy;
//     „Metoda wdrożenia — sposób, żeby ruszyło w całej firmie";
//   · geneza: /pl/czym-jest-appto;
//   · konto bez rozmowy z nami, 10 000 kredytów na start, 10–500 osób, dane w UE.
//
// DO POTWIERDZENIA PRZED PUBLIKACJĄ:
//   · opiekun „z ponad 100 wdrożeń" (appto.ai) a „140+ firm" (serwis) —
//     strona bez liczby;
//   · kohorta: sześć tygodni (strona główna appto.ai) czy osiem (strona
//     programu) — strona bez liczby;
//   · Szymon w zielonym pasie, Piotr Wojciuk w kontakcie.
import LaBase from '../../layouts/LaBase.astro';
import GcFaq from '../../components/GcFaq.astro';
import Styl from '../../components/usluga/Styl.astro';
import Anim from '../../components/usluga/Anim.astro';
import Hero from '../../components/usluga/Hero.astro';
import Pas from '../../components/usluga/Pas.astro';
import DlaKogo from '../../components/usluga/DlaKogo.astro';
import Kontakt from '../../components/usluga/Kontakt.astro';

const kanon = new URL('/produkty/appto', Astro.site).href;
const KONTO = 'https://chat.appto.ai/sign-up';
// Film „Poznaj appto" (kanał appto na YouTube, 1:59, 16:9, publikacja 25.08.2026).
const YT_ID = 'uSPPN1-unaI';
const YT_URL = `https://youtu.be/${YT_ID}`;

const title = "Appto — platforma AI i metoda jej wdrożenia | Let's automate";
const description = 'Appto to platforma AI dla całej firmy, zbudowana w Let’s automate. Dostajecie ją razem z naszą metodą wdrożenia: od audytu procesów po adopcję w całej firmie, samodzielnie, z opiekunem albo w grupie firm.';

// ---- METODA: dziesięć kroków z appto.ai (home.ts → method) --------------------
const KROKI = [
  'Audyt procesów',
  'Wybór zastosowań',
  'Konfiguracja asystentów',
  'Baza wiedzy firmy',
  'Podłączenie narzędzi',
  'Szkolenie zespołów',
  'Pilotaż w dziale',
  'Wdrożenie w firmie',
  'Pomiar i wyniki',
  'Adopcja i rozwój',
];

// ---- TRZY SPOSOBY (home.ts → rollout, opisy w formie „Wy") -------------------
const DROGI = [
  {
    t: 'Samodzielnie',
    d: 'Zakładacie zespół, wybieracie gotowych asystentów i podłączacie swoje narzędzia, a metoda prowadzi Was krok po kroku.',
    l: { h: KONTO, t: 'Załóż konto na appto.ai ↗', zew: true },
  },
  {
    t: 'Z opiekunem',
    d: 'Wdrażamy Appto razem z Wami. Opiekun z Let’s automate projektuje wszystko pod Wasze procesy: od diagnozy, przez pilotaż, po adopcję w całej firmie.',
    l: { h: '#kontakt', t: 'Umów rozmowę →' },
    gl: true,
  },
  {
    t: 'W grupie firm',
    d: 'Prowadzony program z cotygodniowymi warsztatami na żywo. Przechodzicie metodę razem z innymi firmami, taniej niż we wdrożeniu jeden na jeden.',
    l: { h: '#kontakt', t: 'Zapytaj o najbliższą grupę →' },
  },
];

// ---- DLA KOGO -----------------------------------------------------------------
const DLA_KOGO = [
  { t: 'AI już jest, ale każdy używa go po swojemu', d: 'Prywatne konta, różne narzędzia, pliki wklejane do czatu. Od tego stanu metoda zaczyna, od audytu procesów.' },
  { t: 'Zespół od 10 do 500 osób', d: 'Poniżej często wystarczą gotowe narzędzia. Powyżej robimy wdrożenia z większym wsparciem.' },
  { t: 'Macie własne procedury i wiedzę', d: 'Cenniki, umowy, standardy odpowiedzi, ustalenia z wątków. Appto zaczyna się opłacać, kiedy jest co wnieść do bazy wiedzy firmy.' },
];
const NIE_TERAZ = [
  'Zespół ma kilka osób i jeden proces. Wtedy zwykle wystarczy gotowe narzędzie AI.',
  'Firma ma już Copilota albo ChatGPT w planie firmowym i chce je dobrze wdrożyć. Tym zajmuje się <a href="/wdrozenie-ai" style="font-weight:700;color:#0a7a52">wdrożenie AI w firmie</a>.',
];

// ---- FAQ ----------------------------------------------------------------------
const faq = [
  { q: 'Po co powstało Appto?', a: 'W naszych wdrożeniach AI wracał ten sam obraz: każdy pracownik miał własny czat, własne pliki i własny sposób pracy, a firmowe dane trafiały na prywatne konta. Appto zbudowaliśmy, żeby wiedza firmy i sposób pracy z AI były wspólne dla całego zespołu i pod kontrolą firmy.' },
  { q: 'Na czym polega metoda wdrożenia?', a: 'To dziesięć kroków, które przechodzimy w każdej firmie: audyt procesów, wybór zastosowań, konfiguracja asystentów, baza wiedzy firmy, podłączenie narzędzi, szkolenie zespołów, pilotaż w dziale, wdrożenie w całej firmie, pomiar wyników oraz adopcja i rozwój. Możecie przejść ją sami, z naszym opiekunem albo w grupie firm.' },
  { q: 'Czym Appto różni się od ChatGPT czy Copilota?', a: 'Modele są te same. Różni się to, czyj kontekst jest w grze: ChatGPT pamięta w obrębie konta jednej osoby, Copilot bierze kontekst z jej plików, a Appto ma kontekst całej firmy i daje go każdemu w granicach uprawnień. Do tego dochodzi metoda, która prowadzi zespół przez wdrożenie.' },
  { q: 'Czy możemy zacząć sami?', a: 'Tak. Konto zakłada się na appto.ai bez karty i bez rozmowy z nami, a na start jest 10 000 kredytów. Metoda prowadzi przez kolejne kroki także wtedy, gdy wdrażacie się samodzielnie.' },
  { q: 'Ile to kosztuje?', a: 'Opłata za dostęp do Appto jest jedna dla zespołu, niezależna od liczby osób, a do tego płaci się kredytami za pracę, którą Appto wykona. Wdrożenie z opiekunem i program w grupie firm wyceniamy osobno, po rozmowie o tym, od czego zaczynacie.' },
  { q: 'Gdzie są nasze dane?', a: 'Na serwerach w Unii Europejskiej, w osobnej przestrzeni firmy. Modele nie uczą się na Waszych danych, a dane osobowe z plików są maskowane, zanim trafią do modelu.' },
];

const dane = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      '@id': `${kanon}#aplikacja`,
      name: 'Appto',
      alternateName: ['appto', 'appto.ai'],
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      url: kanon,
      sameAs: ['https://appto.ai'],
      description: 'Platforma AI dla całej firmy, zbudowana w Let’s automate, wdrażana według metody od audytu procesów po adopcję w całej firmie.',
      publisher: { '@id': new URL('/#organizacja', Astro.site).href },
    },
    {
      '@type': 'VideoObject',
      name: 'Poznaj appto',
      description: 'Dwuminutowy film o platformie Appto.',
      thumbnailUrl: `https://i.ytimg.com/vi/${YT_ID}/maxresdefault.jpg`,
      embedUrl: `https://www.youtube-nocookie.com/embed/${YT_ID}`,
      contentUrl: YT_URL,
      duration: 'PT1M59S',
      uploadDate: '2026-08-25',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${kanon}#okruszki`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Strona główna', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: 'Produkty', item: new URL('/produkty', Astro.site).href },
        { '@type': 'ListItem', position: 3, name: 'Appto', item: kanon },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${kanon}#faq`,
      mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })),
    },
  ],
};
---
<LaBase noindex topbar={false} title={title} description={description} ctaHref="#kontakt" ctaLabel="Umów rozmowę" nav={null}>
<script type="application/ld+json" is:inline set:html={JSON.stringify(dane)} slot="head"></script>

<style is:global slot="head">
  /* Style tej strony. Wspólny wygląd: src/components/usluga/Styl.astro. */

  /* ---- hero: film „Poznaj appto" (YouTube) ----
     Podgląd z miniaturą; odtwarzacz (youtube-nocookie) ładuje się dopiero po
     kliknięciu. Bez JS link prowadzi do filmu na YouTube. */
  .yt{position:relative;display:block;width:100%;aspect-ratio:16 / 9;border-radius:clamp(10px,1.2vw,18px);overflow:hidden;background:#0b0f0c;cursor:pointer;
    box-shadow:0 0 0 1px rgba(255,255,255,0.14),0 0 0 1.5px rgba(0,0,0,0.3),0 50px 100px -40px rgba(0,0,0,0.9),0 18px 36px -20px rgba(0,0,0,0.55)}
  .yt img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.2,.8,.2,1)}
  .yt::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(7,20,13,0) 55%,rgba(7,20,13,0.55) 100%);pointer-events:none}
  .yt-play{position:absolute;z-index:1;left:50%;top:50%;display:flex;align-items:center;gap:14px;transform:translate(-50%,-50%);padding:10px 26px 10px 10px;border-radius:999px;background:var(--ziel);color:var(--ink);font-size:16px;font-weight:700;letter-spacing:-0.01em;white-space:nowrap;box-shadow:0 20px 40px -16px rgba(0,0,0,0.6);transition:transform .25s ease,background .2s}
  .yt-play i{display:grid;place-items:center;width:46px;height:46px;border-radius:50%;background:var(--ink);color:var(--ziel)}
  .yt-play svg{width:18px;height:18px;margin-left:3px;fill:currentColor}
  .yt-meta{position:absolute;z-index:1;left:clamp(16px,2vw,28px);bottom:clamp(14px,1.8vw,24px);font-size:14px;font-weight:600;color:rgba(255,255,255,0.85)}
  .yt:hover img{transform:scale(1.02)}
  .yt:hover .yt-play{transform:translate(-50%,-50%) scale(1.04);background:#25dd8b}
  .yt:focus-visible{outline:2px solid var(--ziel);outline-offset:4px}
  .yt iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
  .yt.gra::after,.yt.gra .yt-play,.yt.gra .yt-meta{display:none}
  @media (max-width:560px){ .yt-play{padding:8px 18px 8px 8px;font-size:14px} .yt-play i{width:38px;height:38px} .yt-meta{display:none} }

  /* ---- czym jest: geneza pod definicją ---- */
  .gn{display:grid;grid-template-columns:minmax(0,3.6fr) minmax(0,8.4fr);gap:clamp(24px,4vw,64px);margin-top:clamp(40px,4.4vw,64px)}
  .gn-t{grid-column:2;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(20px,3vw,48px)}
  .gn-t div{padding-top:16px;border-top:1.5px solid var(--t1)}
  .gn-t b{display:block;font-size:17px;font-weight:700;letter-spacing:-0.015em}
  .gn-t p{margin:8px 0 0;font-size:15.5px;line-height:1.62;color:var(--t2);text-wrap:pretty}
  @media (max-width:900px){ .gn{grid-template-columns:minmax(0,1fr)} .gn-t{grid-column:1} }
  @media (max-width:640px){ .gn-t{grid-template-columns:minmax(0,1fr)} }

  /* =====================================================================
     METODA · dziesięć kroków na jednej linii
     Linia zapala się od lewej, kroki za nią. Na wąskim ekranie pionowo.
     ===================================================================== */
  .mk{position:relative;display:grid;grid-template-columns:repeat(10,minmax(0,1fr));margin:clamp(8px,1vw,14px) clamp(2px,0.8vw,14px) 0;padding:0;list-style:none}
  .mk::before,.mk::after{content:"";position:absolute;left:5%;right:5%;top:19px;height:2px;border-radius:1px}
  .mk::before{background:rgba(15,26,20,0.12)}
  .mk::after{background:var(--ziel);transform-origin:0 50%}
  .mk-k{position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;gap:14px;padding:0 6px;text-align:center}
  .mk-k > i{display:grid;place-items:center;width:40px;height:40px;border-radius:50%;background:#ffffff;box-shadow:0 0 0 2px var(--ziel),0 0 0 7px var(--papier);font-style:normal;font-size:13px;font-weight:700;color:var(--ziel-c)}
  .mk-k > b{font-size:14.5px;font-weight:650;letter-spacing:-0.01em;line-height:1.3;color:var(--t1);text-wrap:balance}
  .mk.gra::after{transform:scaleX(0)}
  .mk.gra .mk-k{opacity:0;translate:0 8px}
  .mk.gra.on::after{transform:none;transition:transform 2.2s cubic-bezier(.4,0,.2,1) .2s}
  .mk.gra.on .mk-k{opacity:1;translate:0 0;transition:opacity .4s ease calc(0.2s + var(--j) * 0.22s),translate .5s cubic-bezier(.2,.8,.2,1) calc(0.2s + var(--j) * 0.22s)}
  @media (max-width:1100px){
    .mk{grid-template-columns:repeat(5,minmax(0,1fr));row-gap:34px}
    .mk::before,.mk::after{display:none}
  }
  @media (max-width:640px){
    .mk{grid-template-columns:minmax(0,1fr);row-gap:0}
    .mk-k{flex-direction:row;gap:16px;padding:9px 0;text-align:left}
    .mk-k > i{flex-shrink:0;width:34px;height:34px;font-size:12px}
  }

  /* =====================================================================
     TRZY SPOSOBY · środkowy (z opiekunem) szerszy
     ===================================================================== */
  .dr{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.3fr) minmax(0,1fr);gap:clamp(14px,1.6vw,22px);margin-top:clamp(28px,3vw,40px)}
  .dr-k{display:flex;flex-direction:column;padding:clamp(22px,2.4vw,30px);border-radius:22px;background:var(--papier)}
  .dr-k > span{font-size:12.5px;font-weight:700;color:var(--ziel-c)}
  .dr-k h4{margin:8px 0 0;font-size:clamp(20px,1.8vw,24px);font-weight:700;letter-spacing:-0.025em;line-height:1.15}
  .dr-k p{margin:12px 0 0;font-size:15.5px;line-height:1.6;color:var(--t2);text-wrap:pretty}
  .dr-k a{align-self:flex-start;margin-top:auto;padding:22px 0 2px;font-size:15px;font-weight:650;color:var(--t1);border-bottom:1px solid rgba(15,26,20,0.25);transition:border-color .2s}
  .dr-k a:hover{border-color:var(--ziel-c)}
  @media (max-width:900px){ .dr{grid-template-columns:minmax(0,1fr)} }
</style>

<div class="v3">
<Styl />
<Anim />

<!-- ============ 1 · HERO ============ -->
<Hero lead="Appto to platforma AI dla całej firmy, zbudowana w Let’s automate. Dostajecie ją razem z naszą metodą wdrożenia: od audytu procesów po adopcję w całej firmie." cta={{ href: '#kontakt', t: 'Umów rozmowę' }} link={{ href: '#metoda', t: 'Jak wygląda metoda →' }}>
<Fragment slot="h1">Platforma AI dla całej firmy <span>razem z metodą wdrożenia</span></Fragment>
<div class="hero-wid">
<a class="yt" href={YT_URL} target="_blank" rel="noopener" data-yt={YT_ID} aria-label="Odtwórz film „Poznaj appto” (2 minuty)">
<img src={`https://i.ytimg.com/vi/${YT_ID}/maxresdefault.jpg`} alt="" width="1280" height="720" loading="eager" decoding="async">
<span class="yt-play"><i><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 2.4v11.2a.8.8 0 0 0 1.2.7l9.2-5.6a.8.8 0 0 0 0-1.4L4.7 1.7a.8.8 0 0 0-1.2.7Z"/></svg></i>Poznaj appto w 2 minuty</span>
<span class="yt-meta">Film z kanału appto · YouTube</span>
</a>
</div>
</Hero>

<!-- ============ 2 · CZYM JEST ============ -->
<section id="czym-jest" class="v3-sek v3-papier">
<div class="v3-def">
<h2 class="v3-h2m">Czym jest Appto?</h2>
<div>
<p class="v3-def-duzy rv">Appto to platforma AI dla całej firmy, w której zespół pracuje z AI znającym dokumenty, procedury i ustalenia organizacji. Wdrażamy ją według własnej metody, która prowadzi firmę od audytu procesów do pracy z AI na co dzień.</p>
</div>
</div>
<div class="gn">
<div class="gn-t">
<div class="rv"><b>Powstało z naszych wdrożeń</b><p>W firmach, w których wdrażaliśmy AI, wracał ten sam obraz: każdy pracownik miał własny czat, własne pliki i własny sposób pracy, a firmowe dane trafiały na prywatne konta. Appto zbudowaliśmy, żeby to zamknąć w jednym miejscu.</p></div>
<div class="rv"><b>Pracujemy na nim sami</b><p>Appto rozwijamy w Let’s automate i używamy go na co dzień. Metodę, według której je wdrażamy, poprawiamy po każdej firmie.</p></div>
</div>
</div>
</section>

<!-- ============ 2b · ZIELONY PAS ============ -->
<Pas tekst="Na Appto pracujemy sami, więc pokaz robimy na naszych prawdziwych zadaniach" foto="/szymon-kita.jpg" fotoW={870} fotoH={1210} alt="Szymon Kita, założyciel Let's automate" imie="Szymon Kita" rola="Założyciel" cta="Umów pokaz" />

<!-- ============ 3 · METODA ============
     Teza: samo konto niczego nie zmienia, do Appto dokładamy metodę.
     Blok 1: dziesięć kroków z appto.ai. Blok 2: trzy sposoby przejścia. -->
<section id="metoda" class="v3-sek">
<h2 class="v3-h2m">Dlaczego Appto to także metoda</h2>
<p class="v3-teza rv"><span>Samo konto w narzędziu AI niczego w firmie nie zmienia.</span> Do Appto dokładamy metodę, która prowadzi zespół od audytu procesów do pracy z AI na co dzień</p>

<div class="dl-blok">
<div class="dl-gl"><h3>Dziesięć kroków, te same w każdej firmie</h3><p>Zaczynamy od audytu procesów i wyboru zastosowań, bo od nich zależy, jakich asystentów i jakiej wiedzy firma potrzebuje. Pilotaż idzie w jednym dziale, a dopiero potem w całej firmie. Na końcu mierzymy wyniki i pilnujemy, żeby zespół został przy nowym sposobie pracy.</p></div>
<figure class="dl-kafel">
<div class="ts4-gl"><b>Metoda wdrożenia Appto</b></div>
<ol class="mk" data-anim data-gra aria-label="Dziesięć kroków metody wdrożenia Appto">
{KROKI.map((k, j) => (<li class="mk-k" style={`--j:${j}`}><i aria-hidden="true">{String(j + 1).padStart(2, '0')}</i><b>{k}</b></li>))}
</ol>
</figure>
</div>

<div class="dl-blok">
<div class="dl-gl"><h3>Trzy sposoby, żeby przejść metodę</h3><p>Metoda jest ta sama, różni się to, ile robicie sami. Zaczynacie od tej drogi, która pasuje do Waszego zespołu, i możecie ją zmienić po drodze.</p></div>
<div class="dr">
{DROGI.map((d, i) => (<article class="dr-k rv"><span>{String(i + 1).padStart(2, '0')}</span><h4>{d.t}</h4><p>{d.d}</p><a href={d.l.h} target={d.l.zew ? '_blank' : undefined} rel={d.l.zew ? 'noopener' : undefined}>{d.l.t}</a></article>))}
</div>
</div>
</section>

<!-- ============ 4 · DLA KOGO ============ -->
<DlaKogo tytul="Dla kogo jest Appto" sub="Najczęściej firmy, w których AI już jest, ale każdy korzysta z niego inaczej." warunki={DLA_KOGO} nie={NIE_TERAZ} />

<!-- ============ 5 · KONTAKT ============ -->
<Kontakt tytul="Porozmawiajmy o wdrożeniu Appto" lead="Napiszcie, ile osób ma pracować z Appto i od którego działu chcecie zacząć. Odpowiemy w jeden dzień roboczy." zrodlo="Appto" pytanie="Od którego działu chcecie zacząć?" podpowiedz="Np. obsługa klienta, 25 osób…" osoba={{ foto: '/piotr-wojciuk.jpg', w: 1002, h: 1100, imie: 'Piotr Wojciuk', rola: 'New Business Lead' }} />
</div>

<GcFaq heading="Pytania przed decyzją" ctaLabel="Zadajcie nam swoje →" items={faq} />

<script>
  // ---- Hero: film ładuje się dopiero po kliknięciu ----
  (function(){
    var a = document.querySelector('[data-yt]');
    if(!a) return;
    a.addEventListener('click', function(e){
      if(e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      var f = document.createElement('iframe');
      f.src = 'https://www.youtube-nocookie.com/embed/' + a.dataset.yt + '?autoplay=1&rel=0&modestbranding=1';
