const HERO_ARIA = 'Pulpit Maca w trakcie spotkania Anny Kowal z Michałem Rudnikiem z Nordisu. Nad oknem spotkania wisi pasek Wingmana z przyciskami Odpowiedź, Follow-up i Fact-check, polem pytania i czasem nagrania. Karta pod paskiem pokazuje kolejno zapis rozmowy, odpowiedź na pytanie klienta o koszt serwisu z kontekstu asystenta, plan rozmowy z odhaczonymi punktami i sprawdzenie twierdzenia o 30% niższych rachunkach, którego nie da się potwierdzić.';
---
<LaBase noindex topbar={false} title={title} description={description} ctaHref="#kontakt" ctaLabel="Zamów licencje" nav={null}>
