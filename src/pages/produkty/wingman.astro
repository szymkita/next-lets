<script>
  var redukcja = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- HERO: pętla rozmowy nad paskiem Wingmana ----
  // Markup trzyma stan końcowy (Fact-check). przebieg() cofa do 17:52.
  // Karta zmienia wysokość płynnie przy każdej zmianie trybu i treści.
  (function(){
    var fig = document.querySelector('[data-wh]');
    if(!fig || redukcja || !('IntersectionObserver' in window)) return;
    var T0 = 1072, bieg = 0, widoczny = false, gra = false;
    var karta = fig.querySelector('.wk');
    var linie = [].slice.call(fig.querySelectorAll('[data-wh-w]'));
    var tryby = [].slice.call(fig.querySelectorAll('[data-wh-tryb]'));
    var naglowki = [].slice.call(fig.querySelectorAll('[data-wh-gl]'));
    var ikony = [].slice.call(fig.querySelectorAll('[data-wh-ik]'));
    var przyciski = [].slice.call(fig.querySelectorAll('[data-wh-b]'));
    var kafle = [].slice.call(fig.querySelectorAll('[data-wh-mow]'));
    var czas = fig.querySelector('[data-wh-czas]');
    var teraz = T0;
    function fmt(s){ s = Math.round(s); return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0'); }
    function mowi(k){ kafle.forEach(function(x){ x.classList.toggle('mowi', x.dataset.whMow === k); }); }
    function ustawCzas(s){
      teraz = s; czas.textContent = fmt(s);
      linie.forEach(function(l){
        if(+l.dataset.t <= s && l.classList.contains('ukr')){ l.classList.remove('ukr'); mowi(l.dataset.k); }
      });
    }
    function plynnie(zmiana){
      var h0 = karta.offsetHeight; zmiana(); var h1 = karta.offsetHeight;
      if(h0 && h0 !== h1) karta.animate([{ height: h0 + 'px' }, { height: h1 + 'px' }], { duration: 360, easing: 'cubic-bezier(.2,.8,.2,1)' });
    }
    function tryb(n){
      plynnie(function(){
        tryby.forEach(function(t){ t.classList.toggle('on', t.dataset.whTryb === n); });
        naglowki.forEach(function(g){ g.classList.toggle('on', g.dataset.whGl === n); });
        ikony.forEach(function(k){ k.classList.toggle('on', k.dataset.whIk === n); });
      });
      var t = tryby.filter(function(x){ return x.dataset.whTryb === n; })[0];
      t.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 320, easing: 'ease' });
    }
    function czekaj(ms, nr){ return new Promise(function(r){ setTimeout(function(){ r(nr === bieg); }, ms); }); }
    function dociagnij(cel, ms, nr){
      var od = teraz, t0 = performance.now();
      return new Promise(function(r){
        (function klatka(){
          if(nr !== bieg) return r(false);
          var p = Math.min(1, (performance.now() - t0) / ms);
          ustawCzas(od + (cel - od) * p);
          if(p < 1) requestAnimationFrame(klatka); else r(true);
        })();
      });
    }
    function wcisnij(b){ var p = przyciski.filter(function(x){ return x.dataset.whB === b; })[0]; p.classList.add('wcis'); setTimeout(function(){ p.classList.remove('wcis'); }, 420); }
    function laduj(n, ms, nr){
      var t = tryby.filter(function(x){ return x.dataset.whTryb === n; })[0];
      var lad = t.querySelector('[data-wh-lad]'), tr = t.querySelector('[data-wh-tresc]');
      lad.hidden = false; tr.hidden = true; tryb(n);
      return czekaj(ms, nr).then(function(ok){
        if(ok){
          plynnie(function(){ lad.hidden = true; tr.hidden = false; });
          tr.animate([{ opacity: 0, transform: 'translateY(6px)' }, { opacity: 1, transform: 'none' }], { duration: 450, easing: 'cubic-bezier(.2,.8,.2,1)' });
        }
        return ok;
      });
    }
    function reset(){
      linie.forEach(function(l){ l.classList.toggle('ukr', +l.dataset.t > T0); });
      fig.querySelectorAll('[data-wh-lad]').forEach(function(x){ x.hidden = true; });
      fig.querySelectorAll('[data-wh-tresc]').forEach(function(x){ x.hidden = false; });
      ustawCzas(T0); tryb('zap'); mowi(null);
    }
    async function przebieg(){
      var nr = ++bieg; reset();
      if(!await czekaj(1400, nr)) return;
      if(!await dociagnij(1090, 1500, nr)) return;
      if(!await czekaj(900, nr)) return; wcisnij('odp');
      if(!await czekaj(250, nr)) return;
      if(!await laduj('odp', 900, nr)) return;
      if(!await dociagnij(1111, 3600, nr)) return;
      tryb('zap');
      if(!await czekaj(1600, nr)) return;
      tryb('plan'); mowi(null);
      if(!await czekaj(2600, nr)) return;
      tryb('zap');
      if(!await dociagnij(1248, 1000, nr)) return;
      if(!await dociagnij(1265, 1300, nr)) return;
      if(!await czekaj(1500, nr)) return;
      if(!await dociagnij(1660, 1600, nr)) return;
      if(!await czekaj(1300, nr)) return; wcisnij('fc');
      if(!await czekaj(250, nr)) return;
      if(!await laduj('fc', 1500, nr)) return;
      mowi(null);
      if(!await dociagnij(1690, 6500, nr)) return;
      if(widoczny) przebieg(); else gra = false;
    }
    new IntersectionObserver(function(w){
      widoczny = w[0].isIntersecting;
      if(widoczny && !gra){ gra = true; przebieg(); }
    }, { threshold: 0.25 }).observe(fig);
  })();

  // ---- „Jeszcze raz" w kaflach z ruchem jednorazowym ----
  document.querySelectorAll('[data-znow]').forEach(function(b){
    b.addEventListener('click', function(){
      var f = b.closest('[data-anim]');
      f.classList.add('bez'); f.classList.remove('on');
      void f.offsetWidth;
      f.classList.remove('bez');
      requestAnimationFrame(function(){ f.classList.add('on'); });
    });
  });

  // ---- Zakładki widoków ----
  (function(){
    var zak = [].slice.call(document.querySelectorAll('[data-zak]'));
    if(!zak.length) return;
    var widoki = document.querySelectorAll('[data-widok]');
    var podpisy = document.querySelectorAll('[data-podpis]');
    function pokaz(i, fokus){
      zak.forEach(function(b, j){ b.setAttribute('aria-selected', i === j ? 'true' : 'false'); b.tabIndex = i === j ? 0 : -1; });
      widoki.forEach(function(w, j){ w.hidden = i !== j; });
      podpisy.forEach(function(p, j){ p.hidden = i !== j; });
      if(fokus) zak[i].focus();
    }
    zak.forEach(function(b, i){
      b.addEventListener('click', function(){ pokaz(i); });
      b.addEventListener('keydown', function(e){
        if(e.key === 'ArrowRight'){ e.preventDefault(); pokaz((i + 1) % zak.length, true); }
        if(e.key === 'ArrowLeft'){ e.preventDefault(); pokaz((i - 1 + zak.length) % zak.length, true); }
      });
    });
  })();
</script>
</LaBase>
