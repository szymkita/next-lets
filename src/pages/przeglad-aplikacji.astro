---
// PRZEGLĄD APLIKACJI — /przeglad-aplikacji. Landing pod płatne reklamy Meta (Let's Automate, usługa Guided Coding).
// Oferta: płatny przegląd aplikacji, którą firma zbudowała z AI (Claude Code, Codex, Cursor, Lovable), w cenie
// listopadowej. Cel: zgłoszenie aplikacji do przeglądu (mierzymy zgłoszenia, nie wejścia).
// Dla kogo (Szymon, 22.11.2026): właściciel albo prezes firmy 20–200 osób, w której ktoś nietechniczny zbudował
// z AI narzędzie, na którym pracuje dział; kierownik IT albo dyrektor operacyjny, który odpowiada za aplikacje
// budowane w działach; firma, która chce wpuścić do aplikacji klientów albo partnerów. Przychodzi z reklamy na
// telefonie, zimny. Hero mówi o firmie i zespole (odsiewa hobbystów), cena widać od pierwszego ekranu.
// Dwie osie w słowach Szymona: „sprawdzimy, czy jest bezpieczna” i „żebyś się nie musiał cofać za jakiś czas
// z jej rozwojem”. Wartość ceny: odpowiedź, czy rozwijać, poprawić, czy przepisać, i kolejność poprawek.
// Bez obietnic tempa i terminów wykonania (Szymon 22.11: „kto nam za to zapłaci”).
//
// Historia: panel zamówień przykładowej hurtowni instalacyjnej Instalvo z Poznania (panel.instalvo.pl), ten sam
// przykład co na /guided-coding/audyt-aplikacji (Anna, Adam, eksport dla biura, Wrocław). Znaleziska, liczby
// i teksty raportu wzięte z sekcji „Co znajdujemy pod spodem” i „Po co analiza” strony audytu.
// Sceny: 1 hero · 2 historia (panel rośnie marzec → dziś, potem przegląd odsłania 4 rzeczy pod spodem) ·
// 3 rozwój (za pół roku / za rok / za dwa lata, bez przeglądu i po nim) · 4 kiedy zgłosić · 5 co dostajecie
// (raport z werdyktem) · 6 dowód (kim jesteśmy, NARS) · 7 zielony pas · 8 cena + zlecenie przeglądu · 9 FAQ.
// Źródła i kopie wersji: ~/filmy/gc-przeglad-kampania/landing/ (v1, v2…). noindex, poza menu i sitemapą.
//
// DO POTWIERDZENIA PRZEZ SZYMONA
//   · PROMO niżej: 4 900 zł netto = przegląd techniczny (dziś „analiza techniczna od 12 000 zł”),
//     liczy się zgłoszenie do 30.11.2026 23:59, przegląd może ruszyć później;
//   · nazwa i domena Instalvo / panel.instalvo.pl (domena wolna w NASK 22.11, sprawdź w Google);
//   · moduł „Cennik i rabaty” w panelu i liczby w makiecie (KPI, osoby) są poglądowe;
//   · prowadzi Piotr Wojciuk (pierwszy kontakt), przegląd prowadzi inżynier, raport podpisuje Marcel Bilski;
//   · zdania „najgroźniejsze zwykle poprawia się w kilka godzin” i „raport omawiamy razem”.

// ===== jedna stała do zmiany: cena, cena odniesienia, koniec promocji =====
const PROMO = {
  cena: '4 900 zł',             // netto
  zwykle: 'od 12 000 zł',       // netto, cena analizy technicznej z /guided-coding/audyt-aplikacji
  koniecISO: '2026-11-30T23:59:59+01:00',
  koniecTxt: '30 listopada',
  koniecKr: '30.11',
};
const ZRODLO = 'Przegląd aplikacji · listopad';

import LaBase from '../layouts/LaBase.astro';
import GcFaq from '../components/GcFaq.astro';
import Styl from '../components/usluga/Styl.astro';
import Anim from '../components/usluga/Anim.astro';
import Cytat from '../components/usluga/Cytat.astro';
import Pas from '../components/usluga/Pas.astro';
import Panel from '../components/przeglad/Panel.astro';
import { HI } from '../components/usluga/ikony';

const title = "Przegląd aplikacji zbudowanej z AI | Let's automate";
const description = `Wasza firma pracuje na aplikacji zbudowanej z AI? Sprawdzimy, czy jest bezpieczna i czy da się ją rozwijać bez cofania się. Do ${PROMO.koniecTxt} przegląd za ${PROMO.cena} netto.`;

// historia: teksty u góry (k = podpis, h = zdanie) i na dole (b) dla kolejnych kroków
const HIST = [
  { k: 'Marzec', h: 'Anna z działu operacji buduje w Claude Code panel zamówień.', b: 'Po kilku tygodniach handlowcy przestają wpisywać zamówienia do Excela.' },
  { k: 'Czerwiec', h: 'Na panelu pracuje cały dział handlowy.', b: 'Dochodzą klienci, handlowcy i rabaty. Panel działa, więc nikt nie pyta, co jest w środku.' },
  { k: 'Wrzesień', h: 'Przez panel przechodzi 3 400 zamówień miesięcznie.', b: 'Do tego eksport dla biura rachunkowego. Zamówienia z Excela już nie wrócą.' },
  { k: 'Dziś', h: 'W przyszłym kwartale ma na nim pracować Wrocław.', b: 'A jak panel działa w środku, wie tylko Anna. Nikt techniczny tam nie zajrzał.' },
  { k: 'Przegląd · 1 z 4', h: 'Dane klientów trafiają do logów.', b: 'Przy każdym eksporcie NIP-y i telefony klientów lądują w zapisie zdarzeń. Widzi je pięć osób, w tym dwie spoza firmy.' },
  { k: 'Przegląd · 2 z 4', h: 'Do kodu ma dostęp pięć osób. Dwie już przy nim nie pracują.', b: 'W kodzie leży hasło do skrzynki zamowienia@, więc każda z nich może wysłać maila w imieniu firmy.' },
  { k: 'Przegląd · 3 z 4', h: 'Kopia bazy robi się co noc. Nikt nigdy z niej nie wracał.', b: 'Nie wiadomo, czy po awarii w piątek handlowcy zobaczyliby w poniedziałek swoje zamówienia.' },
  { k: 'Przegląd · 4 z 4', h: 'Za próby z wiosny firma wciąż płaci.', b: 'Trzy projekty, których nikt nie otwierał od kwietnia, razem około 200 zł miesięcznie.' },
  { k: 'Po przeglądzie', h: 'Żadnej z tych rzeczy nie widać w panelu.', b: 'Najgroźniejsze zwykle poprawia się w kilka godzin. Trzeba je tylko najpierw znaleźć.' },
];
const ROZW = [
  { k: 'Za pół roku · bez przeglądu', h: 'Wrocław dostaje kopię panelu.', b: 'Najprostsze wyjście. Tylko że od tej pory każdą poprawkę trzeba robić dwa razy.' },
  { k: 'Za pół roku · po przeglądzie', h: 'Wrocław pracuje w tym samym panelu co Poznań.', b: 'Przegląd mówi, co zmienić przedtem, żeby drugi oddział nie dostał osobnej kopii.', ok: true },
  { k: 'Za rok · bez przeglądu', h: 'Roczne zestawienie dla biura staje.', b: 'Eksport bierze wszystkie zamówienia naraz. Przy 41 208 wierszach kończy się błędem, a biuro czeka z zamknięciem roku.' },
  { k: 'Za rok · po przeglądzie', h: 'Eksport idzie porcjami i trwa dwie minuty.', b: 'Miejsca, które nie udźwigną wzrostu, poprawiacie, zanim zatrzymają pracę działu.', ok: true },
  { k: 'Za dwa lata · bez przeglądu', h: 'Panel ma przejąć ktoś, kto go nie budował.', b: 'Projekt od zera umie uruchomić tylko Anna. Bez niej nowa osoba zaczyna od zgadywania.' },
  { k: 'Za dwa lata · po przeglądzie', h: 'Nowa osoba przejmuje panel bez czekania na autorkę.', b: 'Instrukcje i zasady z przeglądu zostają w projekcie, a AI czyta je przy każdej zmianie.', ok: true },
  { k: 'Dlatego teraz', h: 'Przegląd daje kolejność, według której rozwijacie tę samą aplikację.', b: 'Zamiast za rok budować ją od nowa.', ok: true },
];
const MOMENTY = [
  { t: 'Przed rozbudową.', d: 'Nowe moduły, więcej ludzi, drugi oddział.' },
  { t: 'Przed wpuszczeniem klientów.', d: 'Portal albo panel zamówień dla klientów i partnerów.' },
  { t: 'Gdy zna ją jedna osoba.', d: 'Autor zmienia dział, idzie na urlop albo odchodzi z firmy.' },
  { t: 'Przed kolejnymi pieniędzmi.', d: 'Zanim zdecydujecie, czy w nią dalej inwestować.' },
];
const POZ = [
  ['Dane klientów trafiają do logów', 'godzina'],
  ['Hasło do poczty w kodzie i w historii', '2 godziny'],
  ['Nikt nie sprawdził powrotu z kopii', 'pół dnia'],
  ['Eksport stanie przy większym ruchu', 'dzień'],
  ['Ścieżka zamówienia nie ma testu', 'półtora dnia'],
  ['Płatne usługi zostały po próbach', 'godzina'],
  ['Projekt od zera uruchamia tylko autorka', 'dwa popołudnia'],
];
const DOSTAJECIE = [
  { t: 'Inżynier, który sam buduje z AI', d: 'Przegląd prowadzi ktoś, kto na co dzień pracuje w tych samych narzędziach co Wasz zespół. Sprawdzamy między innymi bezpieczeństwo, wydajność i architekturę.' },
  { t: 'Raport dla osoby, która decyduje', d: 'Pierwsze strony mówią, w jakim stanie jest aplikacja i co poprawić najpierw. Dalej pozycje dla osoby, która poprawia, napisane tak, że nie musi programować.' },
  { t: 'Omówienie i poprawki', d: 'Raport omawiamy razem. Większość poprawek zrobicie sami, z instrukcją i poleceniem do wklejenia w Claude Code. Trudniejsze robimy razem przy jednym ekranie.' },
  { t: 'Kod i decyzje zostają Wasze', d: 'Umowę o poufności podpisujemy przed pierwszym dostępem. Wystarczy zaproszenie do projektu, do cofnięcia jednym kliknięciem.' },
];
const faq = [
  { q: 'Aplikacja jest za logowaniem albo działa tylko na komputerze osoby, która ją zbudowała. Da się?',
    a: 'Tak. Wystarczy dostęp do kodu, czyli zaproszenie do miejsca, gdzie leży projekt, do cofnięcia jednym kliknięciem. Jeśli kod jest na razie tylko u autora, umawiamy spotkanie, na którym pokażecie nam aplikację, i tam ustalamy resztę.' },
  { q: 'Nie mamy działu IT ani programisty. Czy to dla nas?',
    a: 'Tak. Raport piszemy dla osoby, która nie programuje. Większość poprawek zrobicie sami, z instrukcją i poleceniem do wklejenia w Claude Code. Trudniejsze, jak próbne odtworzenie kopii, robimy razem przy jednym ekranie.' },
  { q: 'Chcemy wpuścić do aplikacji klientów albo partnerów. Kiedy przegląd?',
    a: 'Przed pierwszą osobą z zewnątrz. Wtedy dane klientów, dostępy i hasła są sprawdzone, zanim zaloguje się ktoś spoza firmy, a poprawki są najprostsze.' },
  { q: `Co obejmuje cena ${PROMO.cena} netto?`,
    a: `Przegląd techniczny aplikacji: sprawdzamy między innymi bezpieczeństwo, wydajność i architekturę. Do tego raport dla osoby, która decyduje, i jego omówienie. Cena dotyczy zgłoszeń do ${PROMO.koniecTxt}; zwykle taki przegląd kosztuje ${PROMO.zwykle} netto.` },
  { q: 'Musicie mieć dostęp do wszystkiego?',
    a: 'Nie. Wystarczy podgląd do projektu i do miejsca, gdzie leży kod. Umowę o poufności podpisujemy przed pierwszym dostępem. Kod, dostępy i decyzje zostają Wasze, a wycenę dalszej pracy dostaniecie tylko wtedy, gdy o nią poprosicie.' },
];
const LOGA = [['sports-med.svg', 'Sports-Med', 308], ['nars.svg', 'NARS', 235], ['sevium.svg', 'Sevium', 206], ['odo-24.svg', 'ODO 24', 158], ['x3d.svg', 'X3D', 143]];
const CURSOR = '<svg viewBox="-2 -2 42 60" aria-hidden="true"><path d="M0 0 L0 56 L14 43 L38 40 Z" fill="#0f1a14" stroke="#ffffff" stroke-width="3.5" stroke-linejoin="round"/></svg>';
---
<LaBase topbar={false} title={title} description={description} ctaHref="#zgloszenie" ctaLabel="Zgłoś aplikację" nav="uslugi" noindex={true}>
<Styl />
<Anim />
<style is:global>
/* ===== PRZEGLĄD APLIKACJI (prefiksy pa-, pn-, zn-, zl-) ===== */
.pa{--pen:#c8402c;--miedz:#e0793b;--petrol:#0b3d47;overflow-x:clip}
.pa *{box-sizing:border-box}
.pa-w{max-width:1440px;margin:0 auto}
.pa-k{display:flex;align-items:center;gap:10px;margin:0;font-size:13.5px;font-weight:650;letter-spacing:-.003em;color:var(--ziel-c);transition:color .5s}
.pa-k::before{content:"";flex:none;width:20px;height:2px;background:currentColor}
.pa-h2{margin:0;font-size:clamp(32px,4.6vw,64px);line-height:1.02;letter-spacing:-.046em;font-weight:700;color:var(--t1);text-wrap:balance}
.pa-h2 span{color:var(--t3)}
.pa-h2.jasny{color:#fff}
.pa-h2.jasny span{color:rgba(255,255,255,.5)}
.pa .v3-btn{cursor:pointer;border:0;font-family:inherit;text-decoration:none}

/* ---------- PANEL Instalvo ---------- */
.pn{position:relative;display:flex;flex-direction:column;overflow:hidden;border-radius:12px;background:#fff;color:#1c2427;font-family:"Inter",system-ui,-apple-system,"Segoe UI",sans-serif;font-size:12.5px;line-height:1.35;letter-spacing:-.006em;-webkit-font-smoothing:antialiased;
  box-shadow:0 0 0 1px rgba(15,26,20,.08),0 2px 4px rgba(15,26,20,.05),0 40px 70px -40px rgba(15,26,20,.55);transition:transform .7s cubic-bezier(.2,.8,.2,1),opacity .5s}
.pn svg{display:block;flex:none}
.pn-ch{flex:none;display:flex;align-items:center;gap:10px;height:34px;padding:0 12px;background:#f5f6f7;border-bottom:1px solid #e8ebed}
.pn-kr{display:flex;gap:5px}
.pn-kr i{width:9px;height:9px;border-radius:50%;background:#dfe3e6}
.pn-url{display:flex;align-items:center;gap:6px;margin:0 auto;padding:4px 14px;border-radius:7px;background:#eaedef;font-size:11.5px;color:#2b3438;white-space:nowrap}
.pn-url svg{width:11px;height:11px;color:#5f6b71}
.pn-url span{color:#8a949a}
.pn-app{flex:1;min-height:0;display:grid;grid-template-columns:48px minmax(0,1fr)}
.pn-bok{display:flex;flex-direction:column;gap:3px;padding:10px 7px;background:var(--petrol);color:rgba(255,255,255,.72)}
.pn-zn{display:flex;align-items:center;gap:9px;margin:0 0 10px;padding:0 1px;font-weight:700;font-size:13.5px;color:#fff;letter-spacing:-.02em}
.pn-zn i{display:grid;place-items:center;flex:none;width:32px;height:32px;border-radius:9px;background:var(--miedz)}
.pn-zn i svg{width:19px;height:19px}
.pn-zn span{display:none}
.pn-zn small{display:block;font-size:10.5px;font-weight:500;color:rgba(255,255,255,.55);letter-spacing:0}
.pn-bok a{position:relative;display:flex;align-items:center;gap:9px;height:32px;padding:0 9px;border-radius:8px;font-size:12.5px;white-space:nowrap;color:inherit;text-decoration:none}
.pn-bok a svg{width:15px;height:15px;fill:currentColor}
.pn-bok a span{display:none}
.pn-bok a.on{background:rgba(255,255,255,.13);color:#fff}
.pn-bok a b{position:absolute;right:2px;top:2px;min-width:15px;height:15px;padding:0 4px;border-radius:8px;background:var(--miedz);color:#fff;font-size:9.5px;font-weight:700;line-height:15px;text-align:center}
.pn-gl{min-width:0;display:flex;flex-direction:column}
.pn-top{flex:none;display:flex;align-items:center;gap:8px;height:46px;padding:0 10px 0 12px;border-bottom:1px solid #eef0f2}
.pn-szuk{display:none}
.pn-oddz{display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 10px;border-radius:8px;border:1px solid #e1e5e8;font-size:11.5px;font-weight:600;white-space:nowrap}
.pn-oddz i{width:7px;height:7px;border-radius:50%;background:#10b981}
.pn-wro{display:inline-flex;align-items:center;gap:6px;max-width:0;overflow:hidden;opacity:0;font-style:normal;transition:max-width .6s,opacity .4s,margin .6s}
.pn-wro::before{content:"";width:1px;height:14px;background:#e1e5e8}
.pn-av{display:flex;align-items:center;margin-left:auto}
.pn-av i{display:grid;place-items:center;width:25px;height:25px;margin-left:-7px;border-radius:50%;background:var(--c);color:#fff;font-style:normal;font-size:9.5px;font-weight:700;box-shadow:0 0 0 2px #fff}
.pn-av b{margin-left:5px;font-size:11px;font-weight:600;color:#5f6b71}
.pn-gear{display:grid;place-items:center;width:28px;height:28px;border-radius:8px;border:1px solid #e1e5e8;color:#4a555b}
.pn-gear svg{width:14px;height:14px;fill:currentColor}
.pn-h{flex:none;display:flex;align-items:flex-end;justify-content:space-between;gap:8px;padding:13px 12px 10px}
.pn-h h4{margin:0;font-size:16px;font-weight:650;letter-spacing:-.02em}
.pn-h small{display:block;margin-top:2px;font-size:11px;color:#6b767c;white-space:nowrap}
.pn-akc{display:flex;gap:6px}
.pn-b{display:inline-flex;align-items:center;gap:5px;height:28px;padding:0 9px;border-radius:7px;border:1px solid #dde2e5;font-size:11.5px;font-weight:600;white-space:nowrap}
.pn-b svg{width:12px;height:12px;fill:currentColor}
.pn-b.g{border-color:var(--petrol);background:var(--petrol);color:#fff}
.pn-dl{display:none}
.pn-kpi{flex:none;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));margin:0 12px 10px;border:1px solid #eceff1;border-radius:10px}
.pn-kpi > div{min-width:0;padding:8px 10px}
.pn-kpi > div + div{border-left:1px solid #eceff1}
.pn-kpi small{display:block;font-size:10.5px;color:#6b767c;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pn-kpi b{display:block;margin-top:2px;font-size:16.5px;font-weight:650;letter-spacing:-.02em;font-variant-numeric:tabular-nums;white-space:nowrap}
.pn-k3,.pn-wyk{display:none!important}
.pn-t{flex:1;min-height:0}
.pn-tr{display:grid;grid-template-columns:74px minmax(0,1fr) auto;align-items:center;gap:10px;height:35px;padding:0 12px;border-top:1px solid #f0f2f4;font-size:12px;white-space:nowrap}
.pn-th{height:28px;border-top:0;font-size:10.5px;font-weight:550;color:#6b767c}
.pn-tr > span{min-width:0;overflow:hidden;text-overflow:ellipsis}
.pn-nr{font-variant-numeric:tabular-nums;color:#4a555b}
.pn-tr .n{text-align:right;font-variant-numeric:tabular-nums;font-weight:550}
.pn-st-k{display:none}
.pn-st-k em{display:inline-flex;align-items:center;gap:5px;padding:2px 8px;border-radius:999px;background:var(--b);color:var(--c);font-style:normal;font-size:11px;font-weight:600}
.pn-st-k em::before{content:"";width:5px;height:5px;border-radius:50%;background:currentColor}
.pn-hn{display:none;align-items:center;gap:7px}
.pn-hn i{display:grid;place-items:center;flex:none;width:20px;height:20px;border-radius:50%;background:var(--c);color:#fff;font-style:normal;font-size:8.5px;font-weight:700}
.pn-h > div:first-child{min-width:0}
.pn-h small{overflow:hidden;text-overflow:ellipsis}
@media (max-width:400px){
  .pn-top{gap:6px;padding:0 8px 0 10px}
  .pn-av i{width:23px;height:23px}
  .pn-av i:nth-child(n+5){display:none}
  .pn.wro .pn-av i:nth-child(n+4){display:none}
  .pn-oddz{padding:0 8px;gap:5px}
  .pn-h{padding:12px 10px 9px}
  .pn-b{padding:0 7px;font-size:11px}
  .pn-kpi{margin:0 10px 10px}
  .pn-tr{grid-template-columns:75px minmax(0,1fr) auto;padding:0 10px;gap:7px}
}
@media (min-width:560px){
  .pn-tr{grid-template-columns:76px minmax(0,1fr) auto 104px}
  .pn-st-k{display:block}
  .pn-th .pn-st-k{display:block}
}
@media (min-width:1000px){
  .pn-app{grid-template-columns:176px minmax(0,1fr)}
  .pn-bok{padding:12px 10px}
  .pn-zn span,.pn-bok a span{display:block}
  .pn-bok a b{position:static;margin-left:auto}
  .pn-szuk{display:flex;align-items:center;gap:7px;flex:1;max-width:280px;height:30px;padding:0 10px;border-radius:8px;background:#f2f4f5;font-size:11.5px;color:#8a949a;white-space:nowrap;overflow:hidden}
  .pn-szuk svg{width:13px;height:13px;fill:currentColor}
  .pn-dl{display:inline}
  .pn-hn.pn-dl{display:flex}
  .pn-th .pn-dl{display:block}
  .pn-h{padding:16px 16px 12px}
  .pn-h h4{font-size:18px}
  .pn-kpi{grid-template-columns:repeat(3,minmax(0,1fr)) minmax(0,1.3fr);margin:0 16px 12px}
  .pn-k3{display:block!important}
  .pn-wyk{display:block!important;width:100%;height:100%;padding:10px 12px;border-left:1px solid #eceff1}
  .pn-tr{grid-template-columns:80px minmax(0,1.25fr) minmax(0,.9fr) 104px 116px;padding:0 16px}
}
@media (min-width:1000px) and (max-width:1499px){
  .pn-hn{font-size:0;gap:0}
  .pn-hn i{font-size:8.5px}
}
/* panel w historii: elementy pojawiają się miesiąc po miesiącu */
.rosnie [data-g]{transition:opacity .45s ease,transform .45s ease}
.rosnie [data-g]:not(.on){opacity:0;transform:translateY(5px)}
.pn.wro .pn-wro{max-width:120px;opacity:1}

/* ---------- znacznik przeglądu (ramka + kursor) ---------- */
.pa-mk{position:absolute;z-index:2;left:0;top:0;width:var(--w,80px);height:var(--h,30px);transform:translate(var(--x,0),var(--y,0));border:2px solid var(--ziel);border-radius:9px;box-shadow:0 0 0 4px rgba(0,205,119,.22);pointer-events:none;opacity:0;
  transition:transform .65s cubic-bezier(.2,.8,.2,1),width .65s cubic-bezier(.2,.8,.2,1),height .65s cubic-bezier(.2,.8,.2,1),opacity .35s}
.pa-mk.on{opacity:1}
.pa-mk-c{position:absolute;left:calc(100% - 14px);top:calc(100% - 10px);display:flex;align-items:flex-start;gap:3px}
.pa-mk-c svg{width:17px;height:24px;filter:drop-shadow(0 2px 3px rgba(0,0,0,.3))}
.pa-mk-c span{display:flex;align-items:center;gap:6px;margin-top:17px;padding:3px 9px 3px 3px;border-radius:999px;background:var(--ziel);color:var(--ink);font-family:"Schibsted Grotesk",system-ui,sans-serif;font-size:11.5px;font-weight:700;white-space:nowrap;box-shadow:0 6px 14px -6px rgba(0,0,0,.4)}
.pa-mk-c img{width:20px;height:20px;border-radius:50%;object-fit:cover}
.pa-mk.lewo .pa-mk-c{left:auto;right:calc(100% - 14px);flex-direction:row-reverse}
.pa-mk.lewo .pa-mk-c svg{transform:scaleX(-1)}
.pa-mk.lewo .pa-mk-c span{padding:3px 3px 3px 9px;flex-direction:row-reverse}
.pa-nr{position:absolute;z-index:4;left:0;top:0;display:grid;place-items:center;width:22px;height:22px;border-radius:50%;background:var(--pen);color:#fff;font-family:"Inter",system-ui,sans-serif;font-size:11px;font-weight:700;box-shadow:0 0 0 4px rgba(200,64,44,.22);transform:translate(var(--x,0),var(--y,0)) scale(.4);opacity:0;transition:opacity .35s,transform .45s cubic-bezier(.3,1.5,.5,1)}
.pa-nr.on{opacity:1;transform:translate(var(--x,0),var(--y,0)) scale(1)}

/* ---------- HERO ---------- */
.pa-h{padding:0 var(--ram)}
.pa-h-in{position:relative;overflow:hidden;display:grid;grid-template-columns:minmax(0,1fr);gap:26px;padding:clamp(30px,4.6vw,72px) var(--pin) 0;border-radius:clamp(20px,2.2vw,32px);
  background:radial-gradient(700px 520px at 85% 90%,rgba(0,205,119,.15),rgba(0,205,119,0) 66%),var(--papier)}
.pa-h1{margin:0;font-size:clamp(35px,9.6vw,44px);line-height:1.03;letter-spacing:-.05em;font-weight:700;color:var(--t1);text-wrap:balance}
.pa-h1 span{display:block;margin-top:.12em;color:var(--ziel-c)}
.pa-lead{margin:16px 0 0;max-width:560px;font-size:clamp(16px,4.2vw,19px);line-height:1.55;color:var(--t2);text-wrap:pretty}
.pa-cena{display:flex;flex-wrap:wrap;align-items:baseline;gap:2px 12px;margin:22px 0 0}
.pa-cena-k{flex-basis:100%;font-size:14px;font-weight:650;color:var(--t1)}
.pa-cena-k em{font-style:normal;color:var(--ziel-c)}
.pa-cena b{font-size:clamp(30px,8vw,40px);line-height:1.05;letter-spacing:-.04em;font-weight:700;color:var(--t1);font-variant-numeric:tabular-nums}
.pa-cena b small{font-size:.48em;letter-spacing:-.01em;font-weight:650;color:var(--t2)}
.pa-cena s{font-size:15px;color:var(--t3);text-decoration-thickness:1.5px}
.pa-h-ak{display:flex;flex-wrap:wrap;align-items:center;gap:12px 20px;margin-top:20px}
.pa-h-od{font-size:13.5px;color:var(--t2)}
.pa-h-od b{color:var(--t1);font-variant-numeric:tabular-nums}
.pa-h-sc{position:relative;height:300px;margin:0 calc(-1 * var(--pin) + 10px)}
.pa-h-sc .pn{position:absolute;left:0;right:0;top:0;height:620px;border-radius:12px 12px 0 0}
@media (min-width:1000px){
  .pa-h-in{grid-template-columns:minmax(0,5.3fr) minmax(0,6.7fr);gap:clamp(28px,3.6vw,64px);min-height:min(calc(100svh - 100px),780px)}
  .pa-h-t{align-self:center;padding-bottom:clamp(40px,4.6vw,72px)}
  .pa-h1{font-size:clamp(44px,3.9vw,64px)}
  .pa-lead{font-size:19px}
  .pa-h-sc{align-self:end;height:clamp(440px,40vw,640px);margin:0 calc(-1 * var(--pin) + 24px) 0 0}
  .pa-h-sc .pn{height:760px}
}

/* ---------- LOGOTYPY ---------- */
.pa-loga{padding:clamp(28px,4vw,52px) var(--pad) 0}
.pa-loga-t{display:flex;align-items:center;gap:12px;margin:0 0 10px;font-size:14px;color:var(--t2)}
.pa-loga-t::before{content:"";width:22px;height:2px;background:var(--ziel)}
.pa-loga-t b{color:var(--t1)}
.pa-loga-m{overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent 0,#000 8%,#000 92%,transparent 100%);mask-image:linear-gradient(90deg,transparent 0,#000 8%,#000 92%,transparent 100%)}
.pa-loga ul{list-style:none;margin:0;padding:0;display:flex;gap:clamp(18px,3vw,48px);width:max-content;animation:pa-loga 30s linear infinite}
@keyframes pa-loga{to{transform:translateX(calc(-50% - clamp(9px,1.5vw,24px)))}}
.pa-loga li{flex:0 0 auto;width:clamp(130px,13vw,190px);height:clamp(60px,6vw,80px);display:flex;align-items:center;justify-content:center}
.pa-loga img{display:block;height:clamp(50px,5.4vw,66px);width:auto;max-width:86%;filter:grayscale(1);opacity:.7;mix-blend-mode:multiply}

/* ---------- SCENY przewijane ---------- */
.pa-sc{position:relative;height:calc(var(--h) * 1vh);height:calc(var(--h) * 1svh);margin:clamp(28px,4vw,56px) var(--ram) 0}
.pa-st{position:sticky;top:0;height:100vh;height:100svh;display:flex;flex-direction:column;gap:12px;padding:78px var(--pin) calc(86px + env(safe-area-inset-bottom));overflow:hidden;border-radius:clamp(20px,2.2vw,32px);background:var(--papier);transition:background-color .7s ease}
.pa-sc.ciemna .pa-st{background:var(--ink)}
.pa-tz{position:relative;flex:none;height:124px}
.pa-tz > div,.pa-bz > p{position:absolute;inset:0 0 auto;opacity:0;transform:translateY(10px);transition:opacity .35s ease,transform .45s cubic-bezier(.2,.8,.2,1)}
.pa-tz > div.on,.pa-bz > p.on{opacity:1;transform:none}
.pa-tz h2{margin:9px 0 0;font-size:clamp(23px,6.3vw,30px);line-height:1.08;letter-spacing:-.035em;font-weight:700;color:var(--t1);text-wrap:balance;transition:color .5s}
.pa-bz{position:relative;flex:none;height:66px}
.pa-bz > p{margin:0;font-size:15px;line-height:1.45;color:var(--t2);text-wrap:pretty;transition:opacity .35s ease,transform .45s cubic-bezier(.2,.8,.2,1),color .5s}
.pa-sc.ciemna .pa-tz h2{color:#fff}
.pa-sc.ciemna .pa-k{color:var(--ziel)}
.pa-sc.ciemna .pa-bz > p{color:rgba(255,255,255,.74)}
.pa-k.zle{color:var(--pen)}
.pa-sg{position:relative;flex:1;min-height:0}
.pa-sg > .pn{position:absolute;inset:0}
.pa-pkt{display:flex;gap:5px;margin-left:auto}
.pa-pkt i{width:6px;height:6px;border-radius:50%;background:currentColor;opacity:.25;transition:opacity .3s}
@media (min-width:1000px){
  .pa-st{display:grid;grid-template-columns:minmax(0,4.1fr) minmax(0,7.9fr);grid-template-rows:minmax(0,1fr) auto;column-gap:clamp(32px,4vw,72px);row-gap:0;padding:112px var(--pin) 104px}
  .pa-tz{grid-column:1;grid-row:1;align-self:center;height:250px}
  .pa-tz h2{margin-top:14px;font-size:clamp(34px,3vw,46px);line-height:1.05}
  .pa-bz{grid-column:1;grid-row:2;height:120px}
  .pa-bz > p{font-size:18px;line-height:1.55}
  .pa-sg{grid-column:2;grid-row:1 / 3}
}

/* ---------- ZNALEZISKA (karty spod panelu) ---------- */
.pa-zn{position:absolute;z-index:3;left:-6px;right:-6px;bottom:-4px;border-radius:11px;font-family:"Inter",system-ui,sans-serif;font-size:12px;line-height:1.4;letter-spacing:-.005em;opacity:0;transform:translateY(26px) scale(.98);pointer-events:none;
  transition:opacity .4s ease,transform .55s cubic-bezier(.2,.8,.2,1);box-shadow:0 0 0 1px rgba(15,26,20,.1),0 30px 60px -20px rgba(0,0,0,.6)}
.pa-zn.on{opacity:1;transform:none}
.zn-w{background:#fff;color:#1c2427}
.zn-d{background:#0d1012;color:#cfd6dc;box-shadow:0 0 0 1px rgba(255,255,255,.12),0 30px 60px -20px rgba(0,0,0,.8)}
.zn-g{display:flex;align-items:center;gap:8px;padding:9px 12px;border-bottom:1px solid #eceff1;font-size:11.5px;color:#5f6b71;white-space:nowrap}
.zn-g b{font-weight:650;color:#1c2427}
.zn-g span:last-child{margin-left:auto;color:#8a949a}
.zn-d .zn-g{border-color:#22272b;color:#8b949c}
.zn-d .zn-g b{color:#eef2f5}
.zn-lg{padding:6px 0 4px;font-family:"JetBrains Mono",ui-monospace,Menlo,monospace;font-size:10.8px;line-height:1.6}
.zn-lg p{display:grid;grid-template-columns:72px minmax(0,1fr);gap:8px;margin:0;padding:5px 12px}
.zn-lg p + p{border-top:1px solid #1b1f23}
.zn-lg time{color:#6c7680;white-space:nowrap}
.zn-lg span{color:#e4e9ed;overflow-wrap:anywhere}
.zn-pen{position:relative;display:inline-block;white-space:nowrap}
.zn-pen::after{content:"";position:absolute;inset:-3px -5px;border:1.7px solid var(--pen);border-radius:50%;transform:rotate(-2.5deg)}
.zn-d .zn-pen::after{border-color:#ff7a62}
.zn-pn{margin:0;padding:4px 12px 11px;font-family:"Caveat",cursive;font-weight:600;font-size:21px;line-height:1.05;color:var(--pen);transform:rotate(-1.5deg);transform-origin:left}
.zn-d .zn-pn{color:#ff8a72}
.zn-r{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1px 10px;align-items:center;margin:0 12px;padding:6px 0;border-top:1px solid #f0f2f4}
.zn-g + .zn-r{border-top:0}
.zn-r b{font-weight:600;font-size:12px}
.zn-r small{grid-column:1;font-size:10.8px;color:#6b767c}
.zn-r > span{grid-row:1 / 3;grid-column:2;font-size:11px;color:#6b767c;white-space:nowrap;font-variant-numeric:tabular-nums}
.zn-r.x b{color:#9a3412}
.zn-r.x > span{color:#b42318}
.zn-r.sk b,.zn-r.sk > span{text-decoration:line-through;text-decoration-color:var(--pen);text-decoration-thickness:1.6px}
.zn-r.ok > span{color:#047857;font-weight:600}
.zn-suma{display:flex;justify-content:space-between;margin:0 12px;padding:7px 0 2px;border-top:1.5px solid #1c2427;font-weight:650;font-variant-numeric:tabular-nums}
@media (max-width:999px) and (max-height:760px){
  .pa-st{padding-top:74px;gap:9px}
  .pa-tz{height:96px}
  .pa-tz h2{margin-top:6px;font-size:21.5px}
  .pa-bz{height:62px}
  .pa-bz > p{font-size:14px;line-height:1.42}
  .zn-lg p + p,.zn-r.kr,.zn-pn.kr{display:none}
  .zn-r small{display:none}
  .zn-r{padding:5px 0}
  .zn-pn{font-size:19px;padding-bottom:8px}
}
@media (min-width:1000px){
  .pa-zn{left:auto;right:-18px;bottom:28px;width:min(470px,62%)}
  .zn-lg{font-size:11.5px}
  .zn-pn{font-size:24px}
}

/* ---------- ROZWÓJ: kopia, eksport, przekazanie ---------- */
.pa-rz .pn{z-index:2}
.pa-kopia{position:absolute;inset:0;z-index:1;display:flex;flex-direction:column;overflow:hidden;border-radius:12px;background:#fff;font-family:"Inter",system-ui,sans-serif;font-size:12px;opacity:0;
  box-shadow:0 0 0 1px rgba(15,26,20,.1),0 30px 60px -30px rgba(15,26,20,.5);transform:scale(.9);transition:transform .7s cubic-bezier(.2,.8,.2,1),opacity .5s}
.pa-kopia .pn-ch{background:#f5f6f7}
.pa-kopia .kp-h{padding:12px 12px 8px;font-size:15px;font-weight:650}
.pa-kopia .kp-h small{display:block;margin-top:2px;font-size:11px;font-weight:400;color:#6b767c}
.pa-kopia .pn-tr{grid-template-columns:74px minmax(0,1fr) auto}
.pa-kopia .zn-pn{position:absolute;right:10px;top:40px;padding:0;font-size:23px;text-align:right;transform:rotate(-4deg)}
.pa-rz[data-k="0"] .pn{transform:translate(-3%,7%) scale(.9)}
.pa-rz[data-k="0"] .pa-kopia{opacity:1;transform:translate(4%,-5%) scale(.9)}
.pa-ov{position:absolute;z-index:5;left:0;right:0;top:50%;margin:0 auto;width:min(420px,calc(100% - 8px));border-radius:12px;background:#fff;color:#1c2427;font-family:"Inter",system-ui,sans-serif;font-size:12px;line-height:1.4;opacity:0;transform:translateY(-40%) scale(.96);pointer-events:none;
  box-shadow:0 0 0 1px rgba(15,26,20,.1),0 40px 80px -24px rgba(15,26,20,.6);transition:opacity .4s,transform .55s cubic-bezier(.2,.8,.2,1)}
.pa-ov.on{opacity:1;transform:translateY(-50%)}
.pa-ov-tlo{position:absolute;inset:0;z-index:4;border-radius:12px;background:rgba(11,61,71,.28);opacity:0;transition:opacity .4s;pointer-events:none}
.pa-ov-tlo.on{opacity:1}
.ek-in{padding:14px 16px 16px}
.ek-in h5{margin:0;font-size:14.5px;font-weight:650;letter-spacing:-.015em}
.ek-in > small{display:block;margin-top:2px;font-size:11.5px;color:#6b767c}
.ek-bar{position:relative;height:10px;margin:14px 0 8px;border-radius:5px;background:#eef1f3;overflow:hidden}
.ek-bar i{position:absolute;left:0;top:0;bottom:0;width:0;border-radius:5px;transition:width 1.4s cubic-bezier(.3,.7,.3,1) .2s}
.ek-st{position:relative;height:38px}
.ek-st p{position:absolute;inset:0;display:flex;align-items:flex-start;gap:8px;margin:0;font-size:12px;opacity:0;transition:opacity .35s}
.ek-st p svg{flex:none;width:15px;height:15px;margin-top:1px}
.pa-rz[data-k="2"] .ek-bar i{width:63%;background:#d9483b}
.pa-rz[data-k="3"] .ek-bar i{width:100%;background:#10a46c}
.pa-rz[data-k="2"] .ek-st .zle,.pa-rz[data-k="3"] .ek-st .ok{opacity:1}
.ek-st .zle{color:#b42318}
.ek-st .ok{color:#047857}
.ek-m{display:flex;justify-content:space-between;font-size:11px;color:#6b767c;font-variant-numeric:tabular-nums}
.pz-l{margin:0;padding:6px 16px 12px;list-style:none}
.pz-l li{position:relative;display:grid;grid-template-columns:18px minmax(0,1fr);gap:9px;align-items:center;padding:8px 0;border-top:1px solid #f0f2f4;font-size:12.3px}
.pz-l li:first-child{border-top:0}
.pz-l li i{display:grid;place-items:center;width:18px;height:18px;border-radius:5px;box-shadow:inset 0 0 0 1.5px #c9d0d4;transition:background .35s,box-shadow .35s}
.pz-l li i svg{width:12px;height:12px;opacity:0;transition:opacity .3s}
.pz-l li span{color:#9aa3a8;transition:color .35s}
.pa-rz[data-k="5"] .pz-l li i{background:#10a46c;box-shadow:none}
.pa-rz[data-k="5"] .pz-l li i svg{opacity:1}
.pa-rz[data-k="5"] .pz-l li span{color:#1c2427}
.pa-rz[data-k="5"] .pz-l li:nth-child(2) i{transition-delay:.12s}
.pa-rz[data-k="5"] .pz-l li:nth-child(3) i{transition-delay:.24s}
.pa-rz[data-k="5"] .pz-l li:nth-child(4) i{transition-delay:.36s}
.pz-pn{position:absolute;left:18px;bottom:22px;margin:0;font-family:"Caveat",cursive;font-weight:600;font-size:22px;line-height:1;color:var(--pen);transform:rotate(-5deg);transition:opacity .35s}
.pa-rz[data-k="5"] .pz-pn{opacity:0}
.pz-kto{transition:opacity .35s}
.pa-rz[data-k="4"] .pz-kto{opacity:0}
.pz-kto{display:flex;align-items:center;gap:9px;margin:0 16px 14px;padding:9px 10px;border-radius:8px;background:#f5f7f8;font-size:11.5px;color:#4a555b}
.pz-kto i{display:grid;place-items:center;flex:none;width:24px;height:24px;border-radius:50%;background:#64748b;color:#fff;font-style:normal;font-size:9px;font-weight:700}

/* ---------- KIEDY ---------- */
.pa-kd{padding:clamp(80px,10vw,150px) var(--pad) 0}
.pa-kd-l{list-style:none;margin:clamp(28px,4vw,56px) 0 0;padding:0;display:grid;grid-template-columns:minmax(0,1fr);border-top:1px solid var(--linia)}
.pa-kd-l li{display:grid;grid-template-columns:34px minmax(0,1fr);gap:4px 12px;padding:18px 0;border-bottom:1px solid var(--linia)}
.pa-kd-l li > i{grid-row:1 / 3;font-style:normal;font-size:13px;font-weight:700;color:var(--ziel-c);font-variant-numeric:tabular-nums;padding-top:5px}
.pa-kd-l b{font-size:clamp(20px,2vw,26px);line-height:1.15;letter-spacing:-.03em;font-weight:700}
.pa-kd-l span{font-size:15.5px;line-height:1.5;color:var(--t2)}
.pa-kd-p{margin:22px 0 0;max-width:640px;font-size:15.5px;line-height:1.55;color:var(--t2)}
@media (min-width:1000px){
  .pa-kd-g{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:clamp(32px,5vw,96px);align-items:end}
  .pa-kd-l{grid-template-columns:repeat(2,minmax(0,1fr));column-gap:clamp(32px,4vw,72px);border-top:0}
  .pa-kd-l li{border-top:1px solid var(--linia);border-bottom:0}
  .pa-kd-p{margin:0}
}

/* ---------- CO DOSTAJECIE: raport ---------- */
.pa-cd{padding:clamp(80px,10vw,150px) var(--pad) 0}
.pa-cd-g{display:grid;gap:36px}
.pa-cd .v3-sub{margin-top:18px}
.pa-rap{position:relative;margin:0 -4px}
.rp-s{position:relative;padding:20px 18px 18px;border-radius:4px;background:#fffefa;font-family:"Inter",system-ui,sans-serif;color:#1c2427;font-size:12.3px;line-height:1.45;transform:rotate(-.8deg);
  box-shadow:0 0 0 1px rgba(15,26,20,.07),0 2px 3px rgba(15,26,20,.05),0 40px 60px -34px rgba(15,26,20,.5)}
.rp-gl{display:flex;justify-content:space-between;gap:10px;padding-bottom:10px;border-bottom:1px solid #e9ecee;font-size:10.8px;color:#6b767c;white-space:nowrap}
.rp-gl b{color:#1c2427;font-weight:650}
.rp-s h4{margin:14px 0 0;font-size:17px;line-height:1.22;letter-spacing:-.025em;font-weight:700;text-wrap:balance}
.rp-s > p{margin:8px 0 0;color:#3d474c;text-wrap:pretty}
.rp-wer{display:flex;flex-wrap:wrap;align-items:center;gap:6px 16px;margin:14px 0 4px;padding:10px 0;border-top:1px dashed #e1e5e8;border-bottom:1px dashed #e1e5e8;font-size:12px;color:#8a949a}
.rp-wer small{flex-basis:100%;font-size:10.5px;font-weight:600;color:#6b767c}
.rp-wer span{position:relative}
.rp-wer span.ja{color:#1c2427;font-weight:650}
.rp-wer span.ja::after{content:"";position:absolute;inset:-5px -9px;border:1.8px solid var(--pen);border-radius:50%;transform:rotate(-3deg)}
.rp-l{margin:12px 0 0;padding:0;list-style:none;counter-reset:rp}
.rp-l li{display:grid;grid-template-columns:20px minmax(0,1fr) auto;gap:8px;align-items:center;padding:6px 0;border-top:1px solid #f0f2f4;font-size:12px}
.rp-l li::before{counter-increment:rp;content:counter(rp);display:grid;place-items:center;width:18px;height:18px;border-radius:50%;background:#e9edef;color:#3d474c;font-size:9.5px;font-weight:700}
.rp-l li:nth-child(-n+3)::before{background:var(--pen);color:#fff}
.rp-l li small{font-size:11px;color:#6b767c;white-space:nowrap}
.rp-pod{display:flex;align-items:center;gap:9px;margin-top:14px;padding:12px 0 26px;border-top:1px solid #e9ecee;font-size:11.5px;color:#6b767c}
.rp-pod img{width:28px;height:28px;border-radius:50%;object-fit:cover}
