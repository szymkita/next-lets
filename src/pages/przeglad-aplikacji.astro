<script is:inline>
/* PRZEGLĄD APLIKACJI — sceny przewijane palcem, odliczanie i zlecenie przeglądu.
   Wszystkie elementy są w kodzie od początku; przewijanie zmienia tylko klasę „on”, położenie i tekst. */
(()=>{
const $=(s,r=document)=>r.querySelector(s), $$=(s,r=document)=>[...r.querySelectorAll(s)];
const cl=(v,a=0,b=1)=>Math.min(b,Math.max(a,v));
const stat=(e,p)=>{try{window.laStat&&window.laStat(e,p||{});}catch(x){}};
const RM=matchMedia('(prefers-reduced-motion: reduce)').matches;

/* ----- znacznik przeglądu: ramka nad elementem panelu ----- */
function naCel(mk,cel,pud,pad,maxH){
  if(!mk||!cel||!pud) return; const a=cel.getBoundingClientRect(), b=pud.getBoundingClientRect(); pad=pad||4; const hh=maxH?Math.min(a.height,maxH):a.height;
  mk.style.setProperty('--x',(a.left-b.left-pad).toFixed(1)+'px'); mk.style.setProperty('--y',(a.top-b.top-pad).toFixed(1)+'px');
  mk.style.setProperty('--w',(a.width+2*pad).toFixed(1)+'px'); mk.style.setProperty('--h',(hh+2*pad).toFixed(1)+'px');
}
function naNr(nr,cel,pud){ const a=cel.getBoundingClientRect(), b=pud.getBoundingClientRect(); nr.style.setProperty('--x',(a.right-b.left-14).toFixed(1)+'px'); nr.style.setProperty('--y',(a.top-b.top-10).toFixed(1)+'px'); }
const hero=$('#hero'), hmk=$('[data-mk="hero"]');
function heroMk(){ const sc=$('.pa-h-sc'); naCel(hmk,$('[data-cel="eksport"]',sc),sc,5); hmk.classList.add('on'); }

/* ----- liczby w panelu ----- */
const KPI=[[214,186412,9],[1873,702118,31],[3412,1284906,47],[3468,1306251,52]];
const fmt=n=>String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g,' ');
function liczby(pn,poz){ $$('[data-licz]',pn).forEach(el=>{ const i=+el.dataset.licz, z=+(el.dataset.v||KPI[3][i]), d=KPI[poz][i], suf=i===1?' zł':''; el.dataset.v=d;
  if(RM||z===d){ el.textContent=fmt(d)+suf; return; } const t0=performance.now(); const kr=t=>{ const p=cl((t-t0)/700), e=1-Math.pow(1-p,3); el.textContent=fmt(z+(d-z)*e)+suf; if(p<1) requestAnimationFrame(kr); }; requestAnimationFrame(kr); }); }

/* ----- sceny ----- */
const zakres=s=>{ const m=String(s).match(/^(\d+)(?:-(\d+)|(\+))?$/); if(!m) return [0,-1]; const a=+m[1]; return [a,m[3]?99:(m[2]!==undefined?+m[2]:a)]; };
const sceny=$$('[data-scena]').map(el=>({el,n:+el.dataset.scena,k:-1,w:$$('[data-w]',el).map(e=>({e,z:zakres(e.dataset.w)}))}));
const hs=$('#historia'), hsSg=$('.pa-sg',hs), hsPn=$('.pn',hs), hsMk=$('[data-mk="hs"]',hs), hsNr=$$('[data-nr]',hs);
const rz=$('#rozwoj'), rzPn=$('.pn',rz);
const CELE=['eksport','av','tabela','gear'];
function historia(k){
  const poz=Math.min(k,3), gr={m:[0,1,2,2][poz],r:[0,1,1,1][poz],a:[0,1,2,2][poz]};
  $$('[data-g]',hsPn).forEach(e=>{ const g=e.dataset.g, t=g[0], v=+g.slice(1); e.classList.toggle('on',v<=gr[t]); });
  liczby(hsPn,poz);
  hsPn.classList.toggle('wro',k===3);
  hs.classList.toggle('ciemna',k>=4);
  const f=k-4;
  if(f>=0&&f<4){ naCel(hsMk,$(`[data-cel="${CELE[f]}"]`,hsPn),hsSg,f===2?2:5,f===2?112:0); hsMk.classList.add('lewo'); hsMk.classList.add('on'); } else hsMk.classList.remove('on');
  hsNr.forEach(nr=>{ naNr(nr,$(`[data-cel="${nr.dataset.nr}"]`,hsPn),hsSg); nr.classList.toggle('on',k===8); });
}
function ustaw(s,k){
  s.k=k; s.el.dataset.k=k; s.w.forEach(({e,z})=>e.classList.toggle('on',k>=z[0]&&k<=z[1]));
  if(s.el===hs) historia(k); if(s.el===rz) rzPn.classList.toggle('wro',k>=1);
}
let raf=0;
function klatka(){ raf=0; const vh=innerHeight; sceny.forEach(s=>{ const r=s.el.getBoundingClientRect(); const p=cl(-r.top/Math.max(1,r.height-vh)); const k=Math.min(s.n-1,Math.floor(p*s.n*0.999+0.0001)); if(k!==s.k) ustaw(s,k); }); pasek(); }
const ruch=()=>{ if(!raf) raf=requestAnimationFrame(klatka); };
addEventListener('scroll',ruch,{passive:true});
addEventListener('resize',()=>{ heroMk(); sceny.forEach(s=>{ const k=s.k; s.k=-1; ustaw(s,k<0?0:k); }); ruch(); });
document.fonts&&document.fonts.ready.then(()=>{ heroMk(); sceny.forEach(s=>{ if(s.k>=0){ const k=s.k; ustaw(s,k); } }); });

/* ----- odliczanie do końca ceny listopadowej ----- */
const KON=new Date($('[data-koniec]').dataset.koniec).getTime();
const odD=$('[data-od-duzy]'), odK=$('[data-od-krotko]'), odP=$('[data-od-pas]');
const dni=n=>n===1?'1 dzień':n+' dni';
function odlicz(){
  const r=KON-Date.now();
  if(r<=0){ if(odD) odD.innerHTML='<span>Cena listopadowa się skończyła. Zadzwońcie, podamy aktualną.</span>'; if(odK) odK.textContent=''; if(odP) odP.textContent='cena listopadowa minęła'; return false; }
  const d=Math.floor(r/864e5), h=Math.floor(r/36e5)%24, m=Math.floor(r/6e4)%60, s=Math.floor(r/1e3)%60, z=v=>String(v).padStart(2,'0');
  const u=(k,v)=>{ const el=$(`[data-od="${k}"]`); if(el) el.firstChild.nodeValue=v; };
  u('d',d); u('h',z(h)); u('m',z(m)); u('s',z(s));
  if(odK) odK.innerHTML=d>=1?`Cena listopadowa jeszcze przez <b>${dni(d)}</b>`:`Cena listopadowa jeszcze przez <b>${h} godz. ${z(m)} min</b>`;
  if(odP) odP.textContent=d>=1?`jeszcze ${dni(d)}`:`ostatni dzień`;
  return true;
}
if(odlicz()) setInterval(odlicz,1000);

/* ----- pigułka na dole: po hero, schowana przy zleceniu ----- */
const pas=$('#pas'), zg=$('#zgloszenie');
let wyslane=false;
function pasek(){ const vh=innerHeight, h=hero.getBoundingClientRect(), z=zg.getBoundingClientRect(); const on=!wyslane&&h.bottom<vh*.35&&(z.top>vh*.9||z.bottom<vh*.2); pas.classList.toggle('on',on); pas.setAttribute('aria-hidden',on?'false':'true'); $$('a',pas).forEach(a=>a.tabIndex=on?0:-1); }
let skad='zlecenie';
$$('[data-skad]').forEach(a=>a.addEventListener('click',e=>{ skad=a.dataset.skad; stat('przeglad_cta',{skad}); e.preventDefault(); const f=$('#zlecenie'); const y=f.getBoundingClientRect().top+scrollY-(innerWidth<1000?72:96); scrollTo({top:y,behavior:RM?'auto':'smooth'}); setTimeout(()=>{try{$('#zl-app').focus({preventScroll:true});}catch(x){}},RM?0:700); }));
$$('[data-tel]').forEach(a=>a.addEventListener('click',()=>stat('tel_klik',{skad:a.dataset.tel})));

/* ----- zlecenie przeglądu: POST /api/kontakt (Zgody.astro dokłada Lead dla Mety) ----- */
const f=$('#zlecenie'), wej=$('#zl-kontakt'), err=$('#zl-err'), wt=$('.zl-wt',f), btn=$('button[type=submit]',f), zg0=$('input[name=zgoda]',f);
const MAIL=/^[^\s@]+@[^\s@]+\.[a-zA-Z]{2,}$/;
const dzis=new Date(), dd=String(dzis.getDate()).padStart(2,'0'), mm=String(dzis.getMonth()+1).padStart(2,'0');
$('[data-zl-data]').textContent=`${dd}.${mm}.${dzis.getFullYear()}`; $('[data-zl-pc]').textContent=`${dd}.${mm}.${dzis.getFullYear()} · Let's automate`;
$('[data-zl-nr]').textContent=`PA/${mm}/${String(dzis.getFullYear()).slice(2)}/${String((dzis.getHours()*60+dzis.getMinutes())%997).padStart(3,'0')}`;
const mailem=v=>/[a-ząćęłńóśźż@]/i.test(v);
wej.addEventListener('input',()=>{ err.textContent=''; wt.textContent=mailem(wej.value)?'Napiszcie do mnie':'Zadzwońcie do mnie'; });
zg0.addEventListener('change',()=>$('.zl-z',f).classList.remove('err'));
function rozpoznaj(v){
  if(v.includes('@')) return MAIL.test(v)?{email:v,telefon:''}:{blad:'adres chyba niepełny?'};
  const c=v.replace(/\D/g,''); if(c.length<9) return {blad:v?'za mało cyfr?':'tu wpisz numer albo e-mail'};
  return {email:'',telefon:(c.length===9?'+48 ':'+')+c.replace(/^00/,'')};
}
let wysylam=false;
f.addEventListener('submit',e=>{ e.preventDefault(); if(wysylam||wyslane) return;
  const r=rozpoznaj(wej.value.trim());
  if(r.blad){ err.textContent=r.blad; wej.focus(); return; }
  if(!zg0.checked){ $('.zl-z',f).classList.add('err'); err.textContent='zaznacz zgodę poniżej'; return; }
  const v=n=>{ const el=f.querySelector(`input[name="${n}"]:checked`); return el?el.value:''; };
  const app=f.elements.aplikacja.value.trim(), os=v('osoby'), dos=v('dostep'), nz=v('narzedzie');
  const wiad=['Zlecenie przeglądu aplikacji (landing '+location.pathname+').', app?'Aplikacja: '+app+'.':'', os?'Pracuje na niej: '+os+' osób.':'', dos?'Dostęp: '+dos+'.':'', nz?'Zbudowana w: '+nz+'.':'', 'Proszę o '+(r.telefon?'telefon':'maila')+'.'].filter(Boolean).join(' ');
  wysylam=true; btn.disabled=true; wt.textContent='Wysyłam…';
  let ref=''; try{ref=localStorage.getItem('referrer')||'';}catch(x){}
  fetch('/api/kontakt',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},
    body:JSON.stringify({email:r.email,telefon:r.telefon,wiadomosc:wiad,firma_www:f.elements.kontrola.value||'',zrodlo:'Przegląd aplikacji · listopad · '+skad+' · '+location.pathname,referrer:ref})})
  .then(o=>{ if(!o.ok) return o.json().catch(()=>({})).then(j=>{throw new Error(j.blad||'blad');});
    wyslane=true; err.textContent=''; pasek();
    try{window.dataLayer=window.dataLayer||[];window.dataLayer.push({event:'formularz_wyslany',zrodlo:'Przegląd aplikacji · listopad'});}catch(x){}
    stat('przeglad_wyslane',{skad,kanal:r.telefon?'telefon':'email',osoby:os,narzedzie:nz});
    $('.zl-ok',f).textContent=r.telefon?'Dziękujemy. Piotr Wojciuk zadzwoni, żeby ustalić dostęp do aplikacji i termin przeglądu.':'Dziękujemy. Piotr Wojciuk odpisze, żeby ustalić dostęp do aplikacji i termin przeglądu.';
    f.classList.add('przyjete'); })
  .catch(x=>{ wysylam=false; btn.disabled=false; wt.textContent=r.email?'Napiszcie do mnie':'Zadzwońcie do mnie';
    err.textContent=x&&x.message==='brak-konfiguracji'?'nie działa, zadzwoń: 571 399 932':'nie doszło, spróbuj jeszcze raz';
