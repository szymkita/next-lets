  .prot-sign{display:grid;grid-template-columns:1fr 1fr;gap:26px;margin-top:26px;padding-top:20px;border-top:1.5px dashed #d8dcd4}
  .prot-line{border-bottom:1px solid #c9d0c6;height:26px}
  .prot-cap{margin-top:6px;font-size:10.5px;letter-spacing:0.06em;color:#8b968d}
  .prot-stamp{display:inline-flex;align-items:center;gap:8px;transform:rotate(-4deg);border:2px solid rgba(10,122,82,0.5);color:#0a7a52;border-radius:8px;padding:7px 13px;font-size:11px;letter-spacing:0.12em;font-weight:700}

  /* ---------- kiedy nie my ---------- */
  .nie-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:clamp(36px,4vw,48px)}
  .nie-card{background:#fbf7f4;border:1px solid rgba(163,57,31,0.18);border-radius:16px;padding:24px 24px 22px}
  .nie-t{display:flex;gap:11px;align-items:flex-start;font-size:16.5px;font-weight:750;letter-spacing:-0.012em;color:#16211a;line-height:1.3}
  .nie-ico{flex-shrink:0;margin-top:2px;color:var(--la-risk,#a3391f)}

  /* ---------- responsywność ---------- */
