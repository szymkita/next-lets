---
// STRONA „DLACZEGO MY" — /dlaczego-my
//
// KOMU TO SIĘ WYŚWIETLA
// Człowiek, który wie już, co robimy, i zbiera argumenty przed decyzją.
// Ma na biurku 2–4 oferty i pytanie, którego nie zada wprost:
// „czym oni się różnią od tamtych i co się stanie, jak to pójdzie źle".
//
// KLUCZOWA DECYZJA
// Sekcja „dlaczego my" na stronie głównej to cztery zalety. Rozciągnięcie
// jej do całej strony dałoby dziesięć zalet i zero wiarygodności — bo
// każdy konkurent napisze u siebie to samo zdanie.
// Ta strona stoi więc na czymś, czego konkurencja nie skopiuje:
//   1. nazywa alternatywy z imienia i mówi, kiedy tamci są lepsi,
//   2. pokazuje własny zgrzyt w tym samym miejscu, co cudze,
//   3. kończy się listą sytuacji, w których odsyłamy klienta gdzie indziej.
// Każdy blok da się sprawdzić przed podpisaniem umowy — to jest obietnica
// całej strony i dlatego hero jest metryczką firmy, a nie makietą produktu.
//
// CZEGO TU NIE MA I DLACZEGO
// — Historii firmy na osi czasu. Kupujący nie kupuje naszej przeszłości.
// — Wartości („rzetelność, partnerstwo"). Nieweryfikowalne, więc puste.
// — Galerii zdjęć zespołu. Do czasu prawdziwej sesji zdjęciowej lepiej
//   wygląda uczciwy skład ról niż stockowe twarze (patrz TeamAvatar).
//
// LICZBY
// 140+ firm, 200+ wdrożeń, 30+ ekspertów — za stroną główną.
// Wszystko, czego nie mam u źródła, jest oznaczone [do uzupełnienia],
// zgodnie z konwencją z pozostałych podstron.

import LaBase from '../layouts/LaBase.astro';
import GcFaq from '../components/GcFaq.astro';
import GcCta from '../components/GcCta.astro';
import TeamAvatar from '../components/TeamAvatar.astro';
import { zespol } from '../data/zespol.js';

const title = "Dlaczego my — czym różni się Let's automate | Let's automate";
const description =
  'Skład studia, zasady rozliczeń, lista rzeczy przekazywanych na koniec projektu i sytuacje, w których odsyłamy do kogoś innego. Wszystko sprawdzalne przed podpisaniem umowy.';

// ── Metryczka firmy (hero, prawa kolumna) ────────────────────────────────
// Świadomie sucha tabela zamiast makiety produktu: pierwsze, co ta strona
// robi, to podanie faktów do weryfikacji.
const metryczka = [
  { k: 'Spółka', v: "Let's automate sp. z o.o.", m: 'NIP 5252908405' },
  { k: 'Grupa', v: 'Wise Group', m: 'Sellwise · HireWise · AdWise' },
  { k: 'Zespół', v: '30+ osób', m: 'w jednym studiu, bez podwykonawców' },
  { k: 'Zrealizowane', v: '200+ wdrożeń', m: 'dla ponad 140 firm' },
  { k: 'Własny produkt', v: 'appto.ai', m: 'budowany tą samą metodą' },
  { k: 'Rozliczenie', v: 'stała cena za etap', m: 'bez roboczogodzin' },
  { k: 'Siedziba', v: 'Warszawa', m: 'Nowy Świat 33/13' },
];

// ── Sekcja 1 · Krajobraz alternatyw ──────────────────────────────────────
// Najważniejszy blok strony. Każdy profil dostaje uczciwe „najlepszy wybór,
// gdy" — łącznie z nami, którzy dostajemy własny zgrzyt w tym samym polu.
// To jedyna konstrukcja, której konkurencja nie przepisze, bo nie może
// sobie pozwolić na napisanie u siebie „tu wygrywa ktoś inny".
const alternatywy = [
  {
    n: 'Software house',
    gdy: 'Zakres jest spisany i domknięty, a brakuje rąk do jego wykonania.',
    zgrzyt:
      'Specyfikację przygotowuje klient, więc pytanie, czy ten proces w ogóle powinien tak wyglądać, zostaje bez właściciela. Kod powstaje zgodnie z zamówieniem, także wtedy, gdy zamówienie było błędem.',
  },
  {
    n: 'Agencja od AI · integrator no-code',
    gdy: 'Chodzi o jeden scenariusz na już, w budżecie kilku tysięcy złotych.',
    zgrzyt:
      'Po roku scenariuszy jest czternaście, każdy żyje osobno i nikt nie umie powiedzieć, co się stanie, gdy jeden przestanie działać w piątek wieczorem.',
  },
  {
    n: 'Duże doradztwo',
    gdy: 'Zarząd potrzebuje strategii sygnowanej marką, którą rada nadzorcza zna z rynku.',
    zgrzyt:
      'Dokument kończy się w miejscu, w którym zaczyna się wdrożenie. Kod pisze potem inna firma, na podstawie slajdów, których autorzy już nie odbierają telefonu.',
  },
  {
    n: 'Wewnętrzny dział IT',
    gdy: 'Zespół ma wolne moce, a pierwsza automatyzacja działa u Was w produkcji od kilku miesięcy.',
    zgrzyt:
      'Backlog utrzymaniowy zjada każdą nową inicjatywę. Projekt transformacyjny przegrywa z awarią w systemie, który działa od ośmiu lat — i słusznie, bo awaria jest pilniejsza.',
  },
];

// ── Sekcja 2 · Skład projektowy ──────────────────────────────────────────
// TeamAvatar bez zdjęć renderuje inicjały — to celowe. Rola i zakres
// odpowiedzialności są prawdziwe, twarze pojawią się po sesji zdjęciowej.
const sklad = [
  {
    p: { name: 'Partner prowadzący' },
    kiedy: 'od pierwszej rozmowy',
    d: 'Odpowiada za wynik i za budżet. Rozmowę handlową i projekt prowadzi ta sama osoba, więc obietnice ze sprzedaży nie giną po drodze.',
  },
  {
    p: { name: 'Analityk procesu' },
    kiedy: 'diagnoza',
    d: 'Spisuje, jak proces działa dzisiaj, przy biurkach osób, które go wykonują. Schemat z prezentacji zarządu zwykle różni się od tego, co widać na miejscu.',
  },
  {
    p: { name: 'Lead developer' },
    kiedy: 'budowa',
    d: 'Projektuje rozwiązanie i pisze najtrudniejsze fragmenty. Ta sama osoba odbiera telefon, gdy pół roku później coś zacznie się zachowywać dziwnie.',
  },
  {
    p: { name: 'QA' },
    kiedy: 'budowa i wydanie',
    d: 'Sprawdza system na Waszych danych przed każdym wydaniem. Ma prawo wstrzymać wydanie i z tego prawa korzysta.',
  },
  {
    p: { name: 'Opiekun wdrożenia' },
    kiedy: 'po starcie',
    d: 'Prowadzi system po uruchomieniu i co miesiąc pokazuje metryki procesu: ile przeszło automatycznie, ile trafiło do ludzi.',
  },
];

// ── Sekcja 3 · Wise Group ────────────────────────────────────────────────
const grupa = [
  { n: 'Sellwise', d: 'doradztwo sprzedażowe', s: false },
  { n: 'HireWise', d: 'rekrutacja i zespoły', s: false },
  { n: 'AdWise', d: 'marketing B2B', s: false },
  { n: "Let's automate", d: 'transformacja AI', s: true },
];

// Konkretne sytuacje projektowe zamiast ogólnika „mamy zaplecze".
const zaplecze = [
  {
    t: 'Proces sprzedaży opisuje ktoś, kto go przebudowywał',
    d: 'Zanim zautomatyzujemy ofertowanie, ktoś sprawdza, czy ten sposób ofertowania ma sens. W większości projektów zmienia się najpierw proces, a dopiero potem powstaje system.',
  },
  {
    t: 'Po wdrożeniu zmieniają się role w zespole',
    d: 'Część pracy znika, a część stanowisk wygląda inaczej niż w dniu podpisania umowy. HireWise pracuje przy tym na co dzień, więc rozmowa o nowych rolach nie zaczyna się od zera.',
  },
  {
    t: 'Zarząd dostaje argument w swoim języku',
    d: 'Materiał na radę nadzorczą pisze ktoś, kto pisze takie materiały zawodowo. Wdrożenia AI zatrzymują się w firmach najczęściej na etapie obrony budżetu.',
  },
];

// ── Sekcja 4 · Zasady ────────────────────────────────────────────────────
const zasady = [
  {
    n: '01',
    t: 'Stała cena za etap',
    d: 'Cena kolejnego etapu jest ustalona przed jego zamówieniem. Rozliczeń godzinowych nie prowadzimy w żadnym projekcie.',
  },
  {
    n: '02',
    t: 'Działająca wersja co tydzień',
    d: 'Raz w tygodniu pokazujemy system na Waszych danych. Status po e-mailu zastępuje demo tylko w tygodniach świątecznych.',
  },
  {
    n: '03',
    t: 'Repozytorium i konta na Waszej firmie',
    d: 'Zakładamy je pierwszego dnia projektu, na Wasze dane. Dostęp można nam odebrać jednym kliknięciem, w dowolnym momencie.',
  },
  {
    n: '04',
    t: 'Skład znany przed umową',
    d: 'Nazwiska osób prowadzących projekt podajemy przed podpisaniem umowy. Zmianę w składzie zgłaszamy z wyprzedzeniem.',
  },
  {
    n: '05',
    t: 'NDA przed pierwszymi danymi',
    d: 'Umowę o poufności podpisujemy zanim zobaczymy cokolwiek z Waszych systemów, także na etapie bezpłatnej diagnozy.',
  },
  {
    n: '06',
    t: 'Eskalacja idzie do partnera',
    d: 'Za projekt odpowiada jedna osoba i to jej numer macie w telefonie. Zgłoszenie trafia do kogoś, kto zna projekt od pierwszego dnia.',
  },
];

// ── Sekcja 4b · Drabinka etapów ──────────────────────────────────────────
// Wizualne potwierdzenie zasady 01: widać, że cena jest ustalana etapami.
const etapy = [
  { n: '01', t: 'Diagnoza', d: 'Koszt status quo w godzinach i złotówkach, mapa wdrożeń wg zwrotu.', h: 26 },
  { n: '02', t: 'Pilot', d: 'Jeden proces do produkcji. Tu weryfikujecie nas na prawdziwej pracy.', h: 48 },
  { n: '03', t: 'Wdrożenie', d: 'Kolejne procesy w kolejności z mapy, etap po etapie.', h: 76 },
  { n: '04', t: 'Opieka i rozwój', d: 'Utrzymanie, metryki procesu i kolejne usprawnienia.', h: 100 },
];

// ── Sekcja 5 · Protokół przekazania ──────────────────────────────────────
// Nawiązanie do „rachunku za status quo" ze strony głównej: ten sam
// papierowy motyw, odwrócone znaczenie. Tam kartka pokazywała, ile kosztuje
// nicnierobienie, tutaj — co zostaje po zakończeniu współpracy.
const protokol = [
  { t: 'Repozytorium z pełną historią', d: 'na Waszej organizacji, z dostępami dla Waszych ludzi' },
  { t: 'Dokumentacja procesu i decyzji', d: 'zapis decyzji projektowych wraz z uzasadnieniem' },
  { t: 'Konta i licencje', d: 'założone na Waszą firmę, opłacane z Waszej karty' },
  { t: 'Runbook awaryjny', d: 'co zrobić, gdy proces stanie o drugiej w nocy' },
  { t: 'Nagrania szkoleń', d: 'dla osób, które dołączą do zespołu za rok' },
  { t: 'Panel metryk procesu', d: 'ile przeszło automatycznie, ile trafiło do ludzi' },
  { t: 'Definicja gotowości produkcyjnej', d: 'warunki, jakie musi spełnić kolejna zmiana' },
];

// ── Sekcja 7 · Kiedy nie my ──────────────────────────────────────────────
// Blok, który sprzedaje najwięcej, bo jako jedyny na stronie nie sprzedaje.
const nieMy = [
  {
    t: 'Potrzebna jest jedna prosta automatyzacja',
    d: 'Przy budżecie kilku tysięcy złotych i jednym scenariuszu integrator no-code zrobi to szybciej i taniej. Podajemy nazwiska, jeśli poprosicie.',
  },
  {
    t: 'Decyduje najniższa stawka godzinowa',
    d: 'Pracujemy na stałej cenie za etap. W licytacji stawką zawsze znajdzie się ktoś, kto zejdzie niżej, i takiej licytacji nie wygrywamy.',
  },
  {
    t: 'Proces zmieni się w ciągu kwartału',
    d: 'Automatyzacja procesu, który za chwilę przestanie obowiązywać, to koszt bez zwrotu. Wracamy do rozmowy po zmianie.',
  },
  {
    t: 'Po Waszej stronie nikt nie odpowiada za wynik',
    d: 'Wdrożenie bez właściciela wewnątrz firmy zatrzymuje się na etapie pilota. Widzieliśmy to kilka razy i nie chcemy tego powtarzać za Wasze pieniądze.',
  },
];

// ── FAQ ──────────────────────────────────────────────────────────────────
// Pierwsze pytanie otwarte domyślnie (GcFaq) — celowo najtwardsze.
const faq = [
  {
    q: 'Czym różnicie się od software house’u?',
    a: 'Zakresem odpowiedzialności. Software house dostaje specyfikację i buduje to, co w niej jest — pytanie, czy proces powinien tak wyglądać, zostaje po Waszej stronie. My zaczynamy etap wcześniej: analityk siada przy biurkach ludzi, którzy proces wykonują, i dopiero z tego powstaje zakres. W praktyce w pierwszym tygodniu najczęściej wypada część rzeczy, które były w pierwotnym zamówieniu, i to jest tania zmiana. Ta sama zmiana po trzech miesiącach budowy jest droga.',
  },
  {
    q: 'Czy nie taniej zbudować to wewnętrznie?',
    a: 'Czasem tak i mówimy to wprost. Jeśli macie zespół z wolnymi mocami i pierwszą automatyzację, która działa w produkcji od kilku miesięcy, kolejne procesy zwykle opłaca się robić u siebie. Rachunek zmienia się, kiedy zespół ma pełny backlog utrzymaniowy — wtedy projekt transformacyjny przegrywa z każdą awarią, a przez rok nie powstaje nic. W takiej sytuacji koszt zewnętrznego studia jest niższy niż koszt roku bez zmian.',
  },
  {
    q: 'Co się stanie, jeśli przestaniecie istnieć?',
    a: 'System działa dalej. Repozytorium, konta i licencje są od pierwszego dnia na Waszej firmie, dokumentacja i runbook leżą w tym samym repozytorium, a stack dobieramy tak, żeby utrzymanie mógł przejąć dowolny zespół z rynku. Na koniec projektu podpisujemy protokół przekazania z listą tego, co dostajecie — jest wyżej na tej stronie. Bez tej listy nie zamykamy projektu.',
  },
  {
    q: 'Ile to kosztuje?',
    a: 'Diagnoza jest bezpłatna i kończy się liczbą: kosztem status quo w godzinach i złotówkach. Każdy kolejny etap ma stałą cenę, ustaloną przed jego rozpoczęciem, więc w dowolnym momencie znacie koszt następnego kroku i możecie się zatrzymać. Rozliczeń godzinowych nie prowadzimy — przy nich ryzyko przekroczenia budżetu przechodzi na klienta, a to my mamy wpływ na tempo, więc ryzyko zostaje u nas.',
  },
  {
    q: 'Za rok modele będą lepsze. Czy to nie zestarzeje się w pół roku?',
    a: 'Model jest w takim systemie wymienialnym elementem. Wartość zostaje w tym, co jest wokół niego: w opisanym procesie, w integracjach z Waszymi systemami, w danych doprowadzonych do stanu używalności i w regułach, kiedy decyzję podejmuje człowiek. Ta warstwa nie starzeje się razem z modelem, a podmiana modelu na nowszy jest u nas zmianą konfiguracji, nie przepisywaniem systemu.',
  },
  {
    q: 'Kto ma prawa do kodu i do danych?',
    a: 'Wy, od pierwszego dnia. Kod powstaje w repozytorium na Waszej organizacji, a prawa majątkowe przechodzą na Was wraz z odbiorem etapu. Waszych danych nie używamy do trenowania modeli. Umowę o poufności podpisujemy przed pierwszym spojrzeniem na Wasze systemy, także w trakcie bezpłatnej diagnozy.',
  },
];
---
<LaBase
  title={title}
  description={description}
  ogImage="/og/hub.png"
  nav="dlaczego-my"
  ctaHref="#kontakt"
  ctaLabel="Umów bezpłatną diagnozę"
>
<style is:global slot="head">
  /* ---------- metryczka firmy (hero) ---------- */
  .mtx{width:100%;border-collapse:collapse}
  .mtx td{padding:11px 0;border-top:1px solid rgba(255,255,255,0.1);vertical-align:baseline}
  .mtx tr:first-child td{border-top:0}
  .mtx .k{font-family:ui-monospace,Menlo,monospace;font-size:10px;letter-spacing:0.12em;text-transform:uppercase;color:rgba(255,255,255,0.45);white-space:nowrap;padding-right:18px}
  .mtx .v{font-size:14.5px;font-weight:700;color:#ffffff;line-height:1.3}
  .mtx .m{display:block;margin-top:2px;font-size:12px;font-weight:400;color:rgba(255,255,255,0.55)}

  /* ---------- krajobraz alternatyw ---------- */
  .alt-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:clamp(40px,5vw,56px)}
  .alt{display:flex;flex-direction:column;background:rgba(255,255,255,0.045);border:1px solid rgba(255,255,255,0.12);border-radius:16px;padding:24px 22px 22px;transition:background .25s,border-color .25s}
  .alt:hover{background:rgba(255,255,255,0.07);border-color:rgba(255,255,255,0.22)}
  .alt-n{font-size:17px;font-weight:750;letter-spacing:-0.012em;color:#ffffff;line-height:1.25;min-height:2.5em}
  .alt-lab{margin-top:18px;font-family:ui-monospace,Menlo,monospace;font-size:9.5px;letter-spacing:0.13em;text-transform:uppercase;color:var(--la-accent,#00CD77)}
  .alt-lab-w{color:#e0a389}
  .alt-txt{margin:7px 0 0;font-size:13.5px;line-height:1.55;color:rgba(255,255,255,0.68);text-wrap:pretty}
  .alt-us{grid-column:1/-1;margin-top:16px;background:linear-gradient(118deg,rgba(0,205,119,0.22),rgba(0,205,119,0.05) 58%),rgba(255,255,255,0.03);border:1px solid rgba(0,205,119,0.55);border-radius:18px;padding:clamp(26px,3vw,34px);box-shadow:0 0 0 4px rgba(0,205,119,0.07),0 34px 70px -40px rgba(0,205,119,0.45)}
  .alt-us-grid{display:grid;grid-template-columns:280px 1fr 1fr;gap:clamp(20px,3vw,44px)}
  .alt-chip{display:inline-flex;align-items:center;gap:7px;background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.16);border-radius:8px;padding:5px 10px;font-size:12px;font-weight:600;color:rgba(255,255,255,0.86)}

  /* ---------- skład projektowy ---------- */
  .cast{border-top:1px solid #e7ece4}
  .cast-row{display:grid;grid-template-columns:36px 1fr 190px;gap:clamp(14px,2vw,26px);align-items:baseline;padding:22px 4px;border-bottom:1px solid #e7ece4}
  .cast-when{font-family:ui-monospace,Menlo,monospace;font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:#8b968d;justify-self:end;text-align:right;white-space:nowrap}

  /* ---------- pełny skład studia ---------- */
  .roster{display:grid;grid-template-columns:repeat(6,1fr);gap:clamp(22px,2.6vw,32px) clamp(12px,1.6vw,20px);margin-top:clamp(28px,3vw,38px)}
  .roster-p{display:flex;flex-direction:column;align-items:center;text-align:center}
  .roster-p>span{transition:transform .25s cubic-bezier(.4,0,.2,1),box-shadow .25s}
  .roster-p:hover>span{transform:translateY(-3px);box-shadow:0 0 0 3px rgba(0,205,119,0.4)}
  .roster-n{margin-top:12px;font-size:13.5px;font-weight:750;letter-spacing:-0.008em;line-height:1.25;color:#16211a}
  .roster-r{margin-top:3px;font-size:11.5px;line-height:1.35;color:#8b968d;text-wrap:pretty}
  @media (prefers-reduced-motion:reduce){ .roster-p>span{transition:none} .roster-p:hover>span{transform:none} }

  /* ---------- Wise Group ---------- */
  .wg{margin-top:clamp(36px,4.5vw,52px)}
  .wg-stem{position:relative;height:30px}
  .wg-stem::after{content:'';position:absolute;left:50%;top:0;bottom:0;width:1.5px;background:#c9d4c9}
  .wg-brace{height:24px;border-top:1.5px solid #c9d4c9;border-left:1.5px solid #c9d4c9;border-right:1.5px solid #c9d4c9;border-radius:16px 16px 0 0}
  .wg-tiles{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
  .wg-tile{background:#ffffff;border:1px solid #e2e9df;border-radius:14px;padding:20px 18px;text-align:center;transition:border-color .25s,transform .25s}
  .wg-tile:hover{border-color:#c9d4c9;transform:translateY(-2px)}
  .wg-tile.is-us{background:#0e2b1d;border-color:#0e2b1d;box-shadow:0 22px 46px -26px rgba(18,38,28,0.55)}
  .wg-name{font-size:16.5px;font-weight:800;letter-spacing:-0.015em;color:#16211a}
  .wg-tile.is-us .wg-name{color:#ffffff}
  .wg-dom{margin-top:4px;font-size:12.5px;color:#7c877e}
  .wg-tile.is-us .wg-dom{color:rgba(255,255,255,0.6)}
  .wg-badge{display:inline-block;margin-top:11px;background:var(--la-accent,#00CD77);color:#0b1a11;font-family:ui-monospace,Menlo,monospace;font-size:9.5px;letter-spacing:0.11em;font-weight:700;padding:3px 8px;border-radius:6px}

  /* ---------- zasady + drabinka etapów ---------- */
  .zas-row{display:grid;grid-template-columns:auto 1fr;gap:18px;align-items:baseline;padding:17px 0;border-top:1px solid #eef1ec}
