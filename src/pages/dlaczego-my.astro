---

<LaBase
  title={title}
  description={description}
  nav="dlaczego-my"
  ctaHref="#kontakt"
  ctaLabel="Umów diagnozę"
>

<style is:global slot="head">
  /* ============================================================ HERO ==== */
  .on-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(300px,430px);gap:clamp(40px,6vw,88px);align-items:center}
  .on-h1{margin:0;max-width:16ch;font-size:clamp(38px,6.2vw,76px);line-height:0.98;letter-spacing:-0.042em;font-weight:800;color:#16211a;text-wrap:balance}
  .on-lead{margin:clamp(24px,3vw,32px) 0 0;max-width:600px;font-size:clamp(17px,2.05vw,20px);line-height:1.55;color:#33413a;text-wrap:pretty}
  .on-lead b{font-weight:750;color:#16211a}

  .on-foto{position:relative}
  .on-foto img{display:block;width:100%;height:auto;aspect-ratio:4/5;object-fit:cover;object-position:50% 14%;border-radius:20px}
  .on-slowo{margin:clamp(18px,2.2vw,24px) 0 0;padding-left:clamp(16px,1.8vw,20px);border-left:2px solid var(--la-accent,#00CD77)}
  .on-slowo p{margin:0;font-size:15.5px;line-height:1.6;color:#243329;text-wrap:pretty}
  .on-kto{display:block;margin-top:12px;font-size:13px;color:#8b968d}
  .on-kto b{display:block;font-size:14px;font-weight:750;color:#16211a}
  @media (max-width:900px){
    .on-hero{grid-template-columns:1fr;gap:36px}
    .on-foto{max-width:420px}
  }

  /* ======================================================== SŁYSZYMY ==== */
  /* Sekcja rozpoznania. Nagłówek po lewej, cudze zdania po prawej —
     jedyne miejsce na stronie z takim podziałem. */
  .sl{display:grid;grid-template-columns:minmax(0,0.78fr) minmax(0,1.22fr);gap:clamp(32px,5vw,80px);align-items:start}
  .sl-znak{display:block;font-size:clamp(56px,7vw,96px);line-height:0.6;font-weight:800;color:var(--la-accent,#00CD77)}
  .sl-w{padding:clamp(20px,2.4vw,28px) 0;border-top:1px solid #dfe7dd}
  .sl-w:first-of-type{border-top:none;padding-top:0}
  .sl-w p{margin:0;font-size:clamp(19px,2.35vw,27px);line-height:1.36;letter-spacing:-0.022em;font-weight:600;color:#16211a;text-wrap:pretty}
  .sl-koniec{margin:clamp(26px,3vw,34px) 0 0;padding-top:clamp(22px,2.6vw,28px);border-top:1px solid #dfe7dd;font-size:16.5px;line-height:1.6;color:#4c5850;text-wrap:pretty}
  @media (max-width:900px){ .sl{grid-template-columns:1fr;gap:30px} }

  /* ============================================================= KIM ==== */
  /* Fakt o nas na marginesie drobnym drukiem, skutek u klienta w dużym
     stopniu pisma. Układ jest tu treścią: strona o nas, pisana o kliencie. */
  .kim{display:grid;grid-template-columns:minmax(0,0.72fr) minmax(0,1fr);gap:clamp(20px,3.4vw,56px);align-items:baseline;padding:clamp(26px,3.4vw,40px) 0;border-top:1px solid #e2e9e0}
  .kim:last-of-type{border-bottom:1px solid #e2e9e0}
  .kim-f{font-size:15.5px;line-height:1.62;color:#5f6d64;text-wrap:pretty}
  .kim-l{display:block;width:fit-content;margin-top:11px;font-size:14px;font-weight:700;color:#0a7a52}
  .kim-l [aria-hidden="true"]{display:inline-block;transition:transform .18s}
  .kim-l:hover [aria-hidden="true"]{transform:translateX(4px)}
  .kim-k{margin:0;font-size:clamp(21px,2.85vw,34px);line-height:1.16;letter-spacing:-0.028em;font-weight:750;color:#16211a;text-wrap:balance}
  @media (max-width:820px){
    .kim{grid-template-columns:1fr;gap:12px}
    .kim-k{order:-1}
  }

  /* ================================================== KTO STOI ZA ==== */
  /* Tekst po lewej, po prawej pionowe spoty na zdjęcia biegnące przez całą
     wysokość pasa. Sekcja nie ma paddingu pionowego (stąd „przez całą
     wysokość"), ale poziomo trzyma ten sam kontener 1440 px co reszta strony. */
  .kt{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.3fr);gap:clamp(28px,4vw,60px);align-items:center;padding:0 max(clamp(20px,5vw,56px),calc((100% - 1440px) / 2))}
  .kt-tresc{padding:clamp(56px,7vw,88px) 0}
  .kt-h{margin:0;max-width:15ch;font-size:clamp(31px,4.6vw,54px);line-height:1.02;letter-spacing:-0.03em;font-weight:800;color:#ffffff;text-wrap:balance}
  .kt-p{margin:clamp(18px,2.2vw,26px) 0 0;max-width:40ch;font-size:clamp(16.5px,1.95vw,19px);line-height:1.6;color:rgba(255,255,255,0.74);text-wrap:pretty}
  .kt-p b{font-weight:700;color:#ffffff}
  .kt-p + .kt-p{margin-top:clamp(14px,1.6vw,18px)}

  .kt-spoty{align-self:stretch;display:grid;grid-template-columns:repeat(var(--spoty,3),minmax(0,1fr));gap:6px;min-height:clamp(360px,34vw,470px)}
  .kt-s:first-child{border-radius:14px 0 0 14px}
  .kt-s:last-child{border-radius:0 14px 14px 0}
  .kt-s{position:relative;overflow:hidden;margin:0;background:#16342a}
  .kt-s img{display:block;width:100%;height:100%;object-fit:cover;object-position:50% 18%;filter:grayscale(1) contrast(1.06)}
  .kt-brak{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:0 14px;box-shadow:inset 0 0 0 1px rgba(255,255,255,0.09);font-family:ui-monospace,Menlo,monospace;font-size:10px;letter-spacing:0.14em;text-transform:uppercase;line-height:1.6;text-align:center;color:rgba(255,255,255,0.26)}
  .kt-pod{position:absolute;left:0;right:0;bottom:0;padding:clamp(96px,13vw,150px) clamp(12px,1.4vw,18px) clamp(14px,1.6vw,18px);background:linear-gradient(180deg,transparent,rgba(13,40,27,0.62) 34%,rgba(13,40,27,0.95) 74%)}
  .kt-pod b{display:block;font-size:clamp(13px,1.4vw,15px);font-weight:750;line-height:1.2;color:#ffffff;text-wrap:pretty}
  .kt-pod span{display:block;min-height:2.6em;margin-top:4px;font-size:11.5px;line-height:1.3;color:rgba(255,255,255,0.58);text-wrap:pretty}
  /* Ponizej 760 px cztery kolumny scinaja podpisy. Dwie kolumny plus sztywna
     proporcja 1:2,2 — wezsza niz najwezszy plik (Bilski 0,475), wiec kadr
     dalej przycina szerokosc i twarze zostaja na tej samej wysokosci. */
  @media (max-width:760px){
    .kt-spoty{grid-template-columns:repeat(2,minmax(0,1fr));align-self:start;min-height:0}
    .kt-s{aspect-ratio:1 / 2.2}
    .kt-s:first-child{border-radius:14px 0 0 0}
    .kt-s:last-child{border-radius:0 0 14px 0}
    .kt-s:nth-child(2){border-radius:0 14px 0 0}
    .kt-s:nth-child(3){border-radius:0 0 0 14px}
    .kt-pod span{min-height:0}
  }
  @media (max-width:1200px){
    .kt{grid-template-columns:1fr;gap:0}
    .kt-tresc{padding:clamp(56px,8vw,84px) 0 clamp(34px,4.4vw,44px)}
    .kt-p{max-width:56ch}
    .kt-spoty{min-height:clamp(280px,38vw,400px)}
  }

  /* ========================================================= OPINIE ==== */
  /* Klamra z sekcją #slyszymy: ten sam gatunek (cudze zdanie), odwrócone
     znaczenie i dopiero tu metryczka pod cytatem. Nierówna waga cytatów
     jest celowa — dwa równe kafle zrobiłyby ścianę opinii. */
  .op{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:clamp(30px,4.4vw,68px);align-items:start;margin-top:clamp(30px,3.8vw,46px)}
  .op-c{margin:0;font-size:clamp(20px,2.5vw,31px);line-height:1.24;letter-spacing:-0.024em;font-weight:700;color:#16211a;text-wrap:pretty}
  .op-m .op-c{font-size:clamp(16px,1.85vw,17.5px);line-height:1.6;letter-spacing:0;font-weight:500;color:#33413a}
  .op-kto{display:block;margin-top:clamp(18px,2.2vw,26px);padding-left:14px;border-left:2px solid var(--la-accent,#00CD77);font-size:13px;line-height:1.45;color:#8b968d}
  .op-kto b{display:block;font-size:14.5px;font-weight:750;color:#16211a}
  .op-m .op-kto{margin-top:16px}

  .op-pas{display:flex;align-items:center;flex-wrap:wrap;gap:20px clamp(26px,3.4vw,48px);margin-top:clamp(38px,4.6vw,58px);padding-top:clamp(26px,3vw,34px);border-top:1px solid #dfe7dd}
  .op-pas-t{flex-shrink:0;max-width:200px;font-size:14px;line-height:1.45;color:#4c5850}
  .op-pas-t b{font-weight:700;color:#16211a}
  .op-znaki{flex:1;display:flex;align-items:center;flex-wrap:wrap;justify-content:space-between;gap:18px clamp(24px,3vw,40px);max-width:900px}
  .op-znaki img{filter:grayscale(1);opacity:0.55;mix-blend-mode:multiply}
  .op-znaki img{display:block;width:104px;height:26px;object-fit:contain}
  @media (max-width:860px){
    .op{grid-template-columns:1fr;gap:34px}
    .op-znaki{flex:1 1 100%;min-width:0;max-width:none;justify-content:flex-start;gap:16px 26px}
    .op-znaki img{width:88px;height:22px}
  }
</style>

