<LuSkrypty />

<script>
  var redukcja = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var ma = 'IntersectionObserver' in window;

  // ---- Hero: odpowiedzi w notatniku dopisywane po kolei ----
  // Bez JS i przy ograniczonym ruchu odpowiedzi stoją od razu.
  (function(){
    var bl = document.querySelector('[data-dm7-bl]') as HTMLElement | null;
    if(!bl || redukcja || !ma) return;
    bl.classList.add('js');
    var io = new IntersectionObserver(function(w){
      if(!w[0].isIntersecting) return;
      io.disconnect();
      setTimeout(function(){ bl!.classList.add('on'); }, 350);
    }, { threshold: 0.35 });
    io.observe(bl);
  })();

  // ---- WiseStack: bramki zaliczają się po kolei ----
  // Bez JS i przy ograniczonym ruchu pięć bramek stoi zaliczonych.
  (function(){
    var pr = document.querySelector('[data-dm7-pr]') as HTMLElement | null;
    if(!pr || redukcja || !ma) return;
    pr.classList.add('js');
    var io = new IntersectionObserver(function(w){
      if(!w[0].isIntersecting) return;
      io.disconnect();
      setTimeout(function(){ pr!.classList.add('on'); }, 300);
    }, { threshold: 0.5 });
    io.observe(pr);
  })();

  // ---- Plan projektu idzie za krokiem opowieści ----
  // LuSkrypty ustawia data-krok na [data-u4z]; plan bierze go stamtąd.
  (function(){
    var wiz = document.querySelector('[data-u4z]') as HTMLElement | null;
    var st = document.querySelector('[data-dm7-st]') as HTMLElement | null;
    if(!wiz || !st) return;
    new MutationObserver(function(){ st!.dataset.krok = wiz!.dataset.krok || '0'; }).observe(wiz, { attributes: true, attributeFilter: ['data-krok'] });
  })();
</script>
