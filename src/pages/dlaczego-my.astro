  .prot{background:#ffffff;border-radius:6px;padding:clamp(26px,4vw,40px) clamp(22px,4vw,40px) 30px;box-shadow:0 30px 70px -32px rgba(15,30,22,0.35);transform:rotate(0.9deg);font-family:ui-monospace,Menlo,monospace}
