  {
   "klasa": "section_czym_sie_kier",
   "formularz": false,
   "bloki": [
    {
     "t": "p",
     "html": "Wartości Let’s"
    },
    {
     "t": "h",
     "n": 3,
     "html": "Czym się kierujemy?"
    },
    {
     "t": "p",
     "html": "Robimy rzeczy prosto, skutecznie i po swojemu. Nasze wartości to codzienne decyzje, które pomagają firmom działać lepiej, a nam czerpać satysfakcję z tego, co robimy."
    },
    {
     "t": "grupa",
     "rodzaj": "karty",
     "items": [
      [
       {
        "t": "p",
        "html": "Działamy na już, nie na później"
       },
       {
        "t": "p",
        "html": "Nie odkładamy niczego na później. Reagujemy szybko i sprawnie, aby dostarczać efekty tu i teraz."
       }
      ],
      [
       {
        "t": "p",
        "html": "Zawsze transparentnie"
       },
       {
        "t": "p",
        "html": "Zarówno w zespole, jak i z klientami, komunikacja musi być szczera, konkretna i zrozumiała."
       }
      ],
      [
       {
        "t": "p",
        "html": "Szukamy prostoty w chaosie"
       },
       {
        "t": "p",
        "html": "Automatyzacja nie musi być skomplikowana. Tworzymy rozwiązania, które są intuicyjne i skuteczne."
       }
      ],
      [
       {
        "t": "p",
        "html": "Nie pytamy „czy”, tylko „jak”"
       },
       {
        "t": "p",
        "html": "Dla nas każde wyzwanie ma rozwiązanie. Zamiast szukać wymówek, szukamy sposobów."
       }
      ],
      [
       {
        "t": "p",
        "html": "Efektywność = nasza obsesja"
       },
