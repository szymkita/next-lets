   "bloki": [
    {
     "t": "p",
     "html": "MAMY JASNY CEL"
    },
    {
     "t": "h",
     "n": 2,
     "html": "Automatyzujemy strategiczne procesy"
    },
    {
     "t": "p",
     "html": "Uważamy, że firmy zbyt dużo uwagi poświęcają optymalizacji pomocniczych procesów, a zbyt mało mówi się o automatyzacji obszarów kluczowych i strategicznych dla istnienia biznesu."
    },
    {
     "t": "p",
     "html": "Automatyzujemy procesy, które robią różnicę"
    },
    {
     "t": "p",
     "html": "Automatyzujemy systemowo, nie punktowo"
    },
    {
     "t": "p",
     "html": "Skupiamy się na zapewnianiu przewagi"
    },
    {
     "t": "p",
     "html": "Wprowadzamy mądrzejszą pracę do firm"
    }
   ]
