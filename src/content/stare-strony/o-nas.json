   "bloki": [
    {
     "t": "p",
     "html": "Po co jesteśmy?"
    },
    {
     "t": "h",
     "n": 2,
     "html": "Usuwamy bariery, które spowalniają firmy"
    },
    {
     "t": "p",
     "html": "Pomagamy zespołom działać bez błędów, chaosu i zbędnych kosztów. Projektujemy technologię, która realnie wspiera codzienną pracę – nie przeszkadza. Dzięki temu firmy mogą rosnąć szybciej, pracować mądrzej i wykorzystać swój potencjał."
    },
    {
     "t": "p",
     "html": "Skalujemy biznes, nie chaos"
    },
    {
     "t": "p",
     "html": "Mniej błędów, więcej kontroli"
    },
    {
     "t": "p",
     "html": "Efekty, nie obietnice"
    }
   ]
  },
  {
   "klasa": "section_przygotowanie",
