---
import Nawigacja from '../components/Nawigacja.astro';
import Stopka from '../components/Stopka.astro';
// Wspólne rusztowanie podstron Guided Coding: head, style bazowe, nawigacja,
// stopka i skrypty (sticky header + akordeon FAQ).
// Design 1:1 ze stroną główną — te same tokeny, ta sama nawigacja.
//
// UWAGA: nawigacja i stopka są tu wydzielone tylko dla nowych podstron.
// index.astro i darmowa-konsultacja.astro nadal trzymają własne kopie.
const {
  title,
  description,
  ctaHref = '#kontakt',
  ctaLabel = 'Sprawdź gotowość',
  ogImage = '/og/hub.png',
  // Podświetlenie pozycji w nawigacji: 'uslugi' | 'dlaczego-my' | null.
  nav = 'uslugi',
  // Warianty robocze trzymamy poza indeksem wyszukiwarek.
  noindex = false,
} = Astro.props;

// Dane firmy jadą w każdej podstronie: wyszukiwarki i modele językowe
// biorą stąd nazwę, adres i przynależność do grupy.
const firma = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': new URL('/#organizacja', Astro.site).href,
  name: "Let's automate",
  legalName: "Let's automate sp. z o.o.",
  url: new URL('/', Astro.site).href,
  logo: new URL('/uploads/logo-2.svg', Astro.site).href,
  description: 'Studio transformacji AI. Projektuje i buduje systemy, na których firmy działają po nowemu.',
  vatID: 'PL5252908405',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'ul. Nowy Świat 33/13',
    postalCode: '00-029',
    addressLocality: 'Warszawa',
    addressCountry: 'PL',
  },
  email: 'hello@letsautomate.pl',
  telephone: '+48571399932',
  parentOrganization: { '@type': 'Organization', name: 'Wise Group' },
  areaServed: { '@type': 'Country', name: 'Polska' },
};

const ogUrl = new URL(ogImage, Astro.site).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
---
<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
{noindex && <meta name="robots" content="noindex, nofollow">}
<meta name="theme-color" content="#0e2b1d">
<link rel="icon" href="/uploads/logo-2.svg">
<link rel="canonical" href={pageUrl}>
<meta property="og:type" content="website">
<meta property="og:locale" content="pl_PL">
<meta property="og:site_name" content="Let's automate">
<meta property="og:url" content={pageUrl}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={ogUrl}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogUrl}>
<meta property="og:image:alt" content={title}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
<link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
<style is:global>
  :root{--la-accent:#00CD77;--la-risk:#a3391f}
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;background:#ffffff;overflow-x:clip;font-family:'Schibsted Grotesk',system-ui,sans-serif;-webkit-font-smoothing:antialiased}
  a{color:inherit;text-decoration:none}
  [hidden]{display:none !important}
  ::selection{background:rgba(0,205,119,0.25)}
  input::placeholder,textarea::placeholder{color:#808b83}
  .page{width:100%;margin:0 auto;background:#ffffff;color:#16211a}

  /* ---------- hover / focus ---------- */
  .nav-lnk{padding:7px 11px;border-radius:9px;transition:color .15s,background .15s}
  .nav-lnk:hover{color:#0a7a52 !important;background:rgba(10,122,82,0.07)}
  .btn-dark{transition:background .2s,color .2s}
  .btn-dark:hover{background:#0a7a52 !important;color:#fff !important}
  .btn-ghost{transition:color .15s,background .15s,border-color .15s}
  .btn-ghost:hover{color:#0a7a52 !important;background:#fff !important;border-color:rgba(10,122,82,0.4) !important}
  .btn-accent{transition:background .2s}
  .btn-accent:hover{background:#00b96c !important;color:#0b1a11 !important}
  .btn-cta{transition:background .2s,box-shadow .2s}
  .btn-cta:hover{background:#0c6a49 !important;box-shadow:0 14px 30px -14px rgba(10,122,82,0.6)}
  .lnk-green{transition:color .15s}
  .lnk-green:hover{color:#16211a !important}
  .foot-lnk{transition:color .15s}
  .foot-lnk:hover{color:#fff !important}
  .row-lnk{transition:color .15s}
  .row-lnk:hover{color:#0a7a52 !important}
  .row-lnk [aria-hidden="true"]{display:inline-block;transition:transform .18s}
  .row-lnk:hover [aria-hidden="true"]{transform:translateX(4px)}
  .inp{background:#f6f9f5 !important;border-color:#e4ebe2 !important;border-radius:11px !important;padding:14px 16px !important;transition:border-color .15s,background .15s,box-shadow .15s}
  .inp:focus{border-color:#0a7a52 !important;background:#ffffff !important;box-shadow:0 0 0 3px rgba(10,122,82,0.1)}
  .phone-field{transition:border-color .15s,box-shadow .15s,background .15s}
  .phone-field:focus-within{border-color:#0a7a52 !important;background:#ffffff !important;box-shadow:0 0 0 3px rgba(10,122,82,0.1)}
  @keyframes la-pulse{0%,100%{opacity:1}50%{opacity:.4}}

  /* ---------- sticky header + mega menu ---------- */
  .site-header{position:sticky;top:0;z-index:60;padding:0 clamp(16px,4vw,40px);transition:padding-top .35s cubic-bezier(.4,0,.2,1)}
  .site-header.scrolled{padding-top:12px}
  .nav-pill{display:flex;align-items:center;justify-content:space-between;gap:20px;max-width:1440px;margin:0 auto;padding:16px 14px 16px 8px;background:transparent;border:1px solid transparent;border-radius:18px;box-shadow:none;transition:max-width .4s cubic-bezier(.4,0,.2,1),padding .35s cubic-bezier(.4,0,.2,1),background .3s,border-color .3s,box-shadow .3s}
  .site-header.scrolled .nav-pill{max-width:1180px;padding:8px 12px 8px 22px;background:rgba(255,255,255,0.78);backdrop-filter:blur(18px) saturate(1.5);-webkit-backdrop-filter:blur(18px) saturate(1.5);border-color:rgba(255,255,255,0.6);box-shadow:0 16px 46px -18px rgba(18,38,28,0.34)}
  .nav-item{display:flex;align-items:center}
  .mega-wrap{position:absolute;top:calc(100% - 20px);left:50%;transform:translateX(-50%) translateY(6px);width:min(940px,calc(100vw - 40px));padding-top:34px;opacity:0;visibility:hidden;pointer-events:none;transition:opacity .18s ease,transform .18s ease}
  .nav-item:hover .mega-wrap,.nav-item:focus-within .mega-wrap{opacity:1;visibility:visible;transform:translateX(-50%) translateY(0);pointer-events:auto}
  .nav-caret{transition:transform .2s}
  .nav-item:hover .nav-caret,.nav-item:focus-within .nav-caret{transform:rotate(180deg)}
  .mega-eyebrow{font-weight:700;font-size:11px;letter-spacing:0.07em;text-transform:uppercase;color:#808b83;padding:0 11px;margin-bottom:6px}
  .mega-item{display:block;padding:9px 11px;border-radius:11px;transition:background .15s}
  .mega-item:hover{background:#f4f8f2}
  .mega-t{display:block;font-size:14.5px;font-weight:650;color:#16211a;transition:color .15s}
  .mega-item:hover .mega-t{color:#0a7a52}
  .mega-d{display:block;margin-top:2px;font-size:12.5px;line-height:1.4;color:#8b968d}
  .mega-feat{display:flex;flex-direction:column;justify-content:center;background:radial-gradient(120% 120% at 100% 0%, rgba(0,205,119,0.16), transparent 55%), #0e2b1d;border-radius:14px;padding:24px 22px;color:#ffffff;transition:transform .2s,box-shadow .2s}
  .mega-feat:hover{transform:translateY(-2px);box-shadow:0 22px 44px -22px rgba(0,0,0,0.5)}
  .nav-here{color:#0a7a52 !important;background:rgba(10,122,82,0.09)}
  /* ---- Megamenu usług: triaż po sytuacji klienta ---- */
  .usl-grid{display:grid;grid-template-columns:1fr 1fr 1fr;grid-template-rows:auto auto auto;gap:0 6px}
  .usl-lane{display:grid;grid-template-rows:subgrid;grid-row:span 3;padding:15px 14px 11px;border-radius:14px;transition:background .2s}
  .usl-top{align-self:start}
  .usl-head{display:block;font-size:24px;font-weight:800;line-height:1.06;letter-spacing:-0.032em;text-wrap:balance;color:#16211a;transition:color .18s}
  .usl-head:hover{color:#0a7a52}
  .usl-sub{display:block;margin-top:9px;font-size:12.5px;line-height:1.45;color:#8b968d}
  .usl-rule{display:block;width:26px;height:2px;margin:16px 0 15px;border-radius:2px;background:var(--la-accent,#00CD77);transition:width .28s cubic-bezier(.4,0,.2,1)}
  .usl-lane:hover .usl-rule{width:78px}
  .usl-list .mega-item{padding:7px 9px;margin-left:-9px;border-radius:10px}
  .usl-list .mega-item:hover{background:#eef5ec}
  .usl-list .mega-t{font-size:14px;font-weight:650}
  .usl-list .mega-d{font-size:12px;color:#96a098}
  @media (prefers-reduced-motion:reduce){ .usl-rule{transition:none} }
  @media (max-width:900px){ .mega-wrap{display:none !important} }

  /* ---------- skala nagłówków ---------- */
  .h-sec{font-size:clamp(30px,4.6vw,52px);line-height:1.05;letter-spacing:-0.028em;font-weight:800}
  .h-mod{font-size:clamp(24px,3.2vw,34px);line-height:1.1;letter-spacing:-0.02em;font-weight:800}
  .sub{font-size:17px;line-height:1.6;color:#4c5850;text-wrap:pretty}
  .sec-head{display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:24px 56px}
  .eyebrow{font-weight:700;font-size:11.5px;letter-spacing:0.08em;text-transform:uppercase;color:#808b83}
  .sec-pad{padding:clamp(72px,10vw,120px) max(clamp(20px,5vw,56px),calc((100% - 1440px) / 2));scroll-margin-top:16px}

  /* ---------- karty ---------- */
  .lift{transition:transform .3s cubic-bezier(.4,0,.2,1),box-shadow .3s,border-color .3s}
  .lift:hover{transform:translateY(-4px);border-color:var(--la-accent,#00CD77);box-shadow:0 26px 54px -32px rgba(18,38,28,0.22)}
  @media (prefers-reduced-motion:reduce){ .lift{transition:none} .lift:hover{transform:none} }

  /* ---------- FAQ (akordeon) ---------- */
  .faq-item{border-top:1px solid #e7ece4}
  .faq-item:last-child{border-bottom:1px solid #e7ece4}
  .faq-q{appearance:none;width:100%;background:none;border:none;font-family:inherit;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:20px;text-align:left;padding:24px 4px;font-size:clamp(17px,2vw,20px);font-weight:700;letter-spacing:-0.01em;color:#16211a;transition:color .15s}
  .faq-q:hover{color:#0a7a52}
  .faq-ico{flex-shrink:0;display:flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:50%;background:#e9f2ea;color:#0a7a52;transition:transform .35s cubic-bezier(0.4,0,0.2,1),background .2s}
  .faq-item.open .faq-ico{transform:rotate(180deg);background:var(--la-accent,#00CD77);color:#0b1a11}
  .faq-a{overflow:hidden;max-height:0;transition:max-height .4s cubic-bezier(0.4,0,0.2,1)}
  .faq-item.open .faq-a{max-height:420px}
  .faq-a-inner{padding:0 4px 26px;max-width:680px;font-size:15.5px;line-height:1.65;color:#4c5850;text-wrap:pretty}
  @media (prefers-reduced-motion:reduce){ .faq-a,.faq-ico{transition:none} }

  /* ---------- reveal na scroll ---------- */
  .rv{opacity:0;transform:translateY(16px);transition:opacity .55s ease,transform .55s cubic-bezier(0.4,0,0.2,1)}
  .rv.in{opacity:1;transform:none}
  @media (prefers-reduced-motion:reduce){ .rv{opacity:1;transform:none;transition:none} }

  /* ---------- responsywność wspólna ---------- */
  @media (max-width:1024px){
    /* minmax(0,1fr), nie samo 1fr: `1fr` nie schodzi poniżej najszerszej
       nierozbijalnej treści w kolumnie i przy 320px rozpychało sekcję poza
       kadr. Zero jako minimum każe kolumnie zmieścić się w ekranie. */
    .faq-grid{grid-template-columns:minmax(0,1fr) !important;gap:clamp(32px,5vw,48px) !important}
    .s2-grid{grid-template-columns:minmax(0,1fr) !important;gap:clamp(32px,5vw,48px) !important}
    .s9-grid{grid-template-columns:minmax(0,1fr) !important}
    .grid4{grid-template-columns:1fr 1fr !important}
    .grid3{grid-template-columns:1fr 1fr !important}
  }
  @media (max-width:900px){
    .nav-menu{display:none !important}
    .grid2,.grid3,.split{grid-template-columns:minmax(0,1fr) !important;gap:40px !important}
    .foot-grid{grid-template-columns:1fr 1fr !important;gap:40px !important}
    /* Chrome wlicza `text-wrap:pretty` do minimalnej szerokości bloku: akapit
       .sub liczy się wtedy jak 483px, kolumna gridu nie schodzi poniżej tej
       wartości i wypycha sekcję poza kadr (widać było na /inspiracje).
       Na wąskim ekranie ładniejsze łamanie nie jest tego warte. */
    .sub{text-wrap:wrap}
    /* Palec potrzebuje więcej niż wysokość linijki tekstu: linki-odnośniki
       dostają zapas w pionie bez zmiany odstępów (ujemny margines go znosi). */
    .lnk-green,.row-lnk{padding-block:10px;margin-block:-10px}
  }
  @media (max-width:600px){
    .grid4,.grid2,.foot-grid{grid-template-columns:1fr !important}
    .hero-actions{flex-direction:column !important;align-items:stretch !important;width:100%}
    .hero-actions a{justify-content:center !important}
    .stat-row{flex-wrap:wrap !important;gap:24px 32px !important}
    .cta-card{grid-template-columns:1fr !important}
    .cta-portrait{display:none !important}
  }

  /* iOS Safari powiększa całą stronę, gdy kursor wchodzi w pole z krojem
     mniejszym niż 16px — po wyjściu z pola układ zostaje przesunięty.
     Na telefonie pola dostają więc równe 16px. */
  @media (max-width:900px){
    input,select,textarea{font-size:16px !important}
  }

  /* nawigacja przeniesiona ze strony głównej (31.08.2026) */
  .nav-cta-sizer{visibility:hidden;pointer-events:none}
  .nav-cta-live{position:absolute;left:0;right:0;top:0;bottom:0;display:inline-flex;align-items:center;justify-content:center;white-space:nowrap}
  .nav-cta-caret{display:inline-block;width:2px;height:1.05em;margin-left:1px;background:currentColor;vertical-align:-0.14em;animation:cta-blink 1s steps(1) infinite}
</style>
<script type="application/ld+json" is:inline set:html={JSON.stringify(firma)}></script>
<slot name="head" />
</head>
<body>

<div class="page">

<Nawigacja ctaHref={ctaHref} />

<slot />

<Stopka />

</div>

<script>
  // ---- Sticky header: cień/obramowanie po scrollu ----
  

  // ---- FAQ — akordeon (jeden otwarty naraz) ----
  (function(){
    var items = document.querySelectorAll('.faq-item');
    if(!items.length) return;
    items.forEach(function(item){
      var btn = item.querySelector('.faq-q');
      if(!btn) return;
      btn.addEventListener('click', function(){
        var willOpen = !item.classList.contains('open');
        items.forEach(function(other){
          other.classList.remove('open');
          var b = other.querySelector('.faq-q');
          if(b) b.setAttribute('aria-expanded', 'false');
        });
        if(willOpen){
          item.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  })();

  // ---- Reveal na scroll (.rv) ----
  (function(){
    var els = document.querySelectorAll('.rv');
    if(!els.length) return;
    if(!('IntersectionObserver' in window)){
      els.forEach(function(el){ el.classList.add('in'); });
      return;
    }
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { threshold: 0.16 });
    els.forEach(function(el){ io.observe(el); });
  })();
</script>

</body>
</html>
