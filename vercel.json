{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/baza-wiedzy",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/baza-wiedzy/:slug",
      "destination": "/post/:slug",
      "permanent": true
    },
    {
      "source": "/blog-categories/wszystko",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/guided-coding/bez-dzialu-it",
      "destination": "/guided-coding/biezace-wsparcie",
      "permanent": true
    },
    {
      "source": "/guided-coding/dla-zespolow",
      "destination": "/guided-coding/biezace-wsparcie",
      "permanent": true
    },
    {
      "source": "/produkty/appto",
      "destination": "/produkty#appto",
      "permanent": false
    },
    {
      "source": "/produkty/wingman",
      "destination": "/produkty#wingman",
      "permanent": false
    }
  ]
}
