{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/post/:slug",
      "destination": "/baza-wiedzy/:slug",
      "permanent": true
    },
    { "source": "/blog", "destination": "/baza-wiedzy", "permanent": true },
    { "source": "/blog-categories/:slug", "destination": "/baza-wiedzy", "permanent": true }
  ]
}
