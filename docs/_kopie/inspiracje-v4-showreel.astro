---
// INSPIRACJE — /inspiracje  (wersja 4: showreel aplikacji + to, co aplikacją nie jest)
//
// TRZY POPRZEDNIE WERSJE W docs/_kopie/:
//   v1 katalog   — histogram wag i 64 wiersze z filtrami
//                  → „to jest do zrzucenia całkowicie, to ma być wizualne"
//   v2 galeria   — dziesięć interfejsów, każdy w osobnej sekcji
//                  → „tu nie ma żadnej wartości, żadnej inspiracji"
//   v3 przemiany — 28 delt „przed → po" bez ani jednego ekranu
//                  → „powinna być oparta o ekrany aplikacji, które rozwiązują
//                     jakieś zadania, przede wszystkim w pierwszej kolejności"
//
// CO Z NICH ZOSTAŁO:
//   z v2 — ekrany rysowane w HTML (klient chce zobaczyć oprogramowanie)
//   z v3 — zadanie i liczba przy każdej rzeczy (bez tego ekran jest ozdobą)
//   Wersja czwarta łączy jedno z drugim: SHOWREEL, w którym każdy ekran ma
//   przypisane zadanie, które rozwiązuje, i liczbę mówiącą o ile jest lepiej.
//
// UKŁAD (kolejność podyktowana wprost przez Szymona):
//   1. showreel aplikacji — NAJPIERW, zajmuje pierwszy ekran
//   2. rok w jednej firmie — ciemny pas, dowód że rzeczy się kumulują
//   3. „Nie wszystko jest aplikacją" — predykcje, odczyt, głos, obraz, pilnowanie
//   4. czego nie budujemy · FAQ · kontakt
//
// SHOWREEL — mechanika:
//   Lista po lewej działa jak playlista: pozycja aktywna ma pasek postępu,
//   po 5,4 s wchodzi następna. Kliknięcie zatrzymuje obieg i pokazuje wybraną.
//   Sterowane skryptem, nie klatkami CSS, bo lista musi być klikalna.
//   Przy prefers-reduced-motion obiegu nie ma — stoi pierwszy ekran, klikanie
//   dalej działa.
//
// ===================================================================
// !! DO PODMIANY PRZED PUBLIKACJĄ !!
// Wszystkie liczby (pola `a`, `b` w APLIKACJE i UMIEJETNOSCI oraz tablica
// SCHODY) są ROBOCZE. Szymon zdecydował, że mają pochodzić z prawdziwych,
// zanonimizowanych wdrożeń — branża i wielkość firmy, bez nazw.
// Dane na ekranach (nazwy firm, kwoty, numery, nazwiska) są przykładowe
// i tak jest napisane na stronie.
// ===================================================================
import LaBase from '../layouts/LaBase.astro';
import GcFaq from '../components/GcFaq.astro';
import GcCta from '../components/GcCta.astro';

const kanon = new URL('/inspiracje', Astro.site).href;

// ---- SHOWREEL: osiem aplikacji, osiem różnych ekranów -------------------
// `zadanie` to zdanie o tym, co znika z dnia pracy. `a → b` to miara.
const APLIKACJE = [
  { k: 'zlecenia', n: '01', t: 'Rejestr zleceń', z: 'Stan sprawy przestaje być składany z pięciu narzędzi i tablicy na ścianie.', a: '10 dni', b: '1 dzień', c: 'zanim ktoś zauważy, że sprawa stoi' },
  { k: 'oferta', n: '02', t: 'Generator ofert', z: 'Oferta składa się z cennika, w jednym wzorze, z rabatem w limicie.', a: '3 dni', b: '25 minut', c: 'od zapytania do wysłanej oferty' },
  { k: 'portal', n: '03', t: 'Portal klienta', z: 'Klient sam sprawdza etap sprawy, bez logowania i bez telefonu.', a: '855 pytań', b: '224', c: 'telefonów o status w miesiącu' },
  { k: 'planer', n: '04', t: 'Planer obłożenia', z: 'Kolizja sprzętu wychodzi przy układaniu planu, na dwa tygodnie przed robotą.', a: '6 kolizji', b: '0', c: 'w miesiącu' },
  { k: 'koszty', n: '05', t: 'Obieg akceptacji kosztów', z: 'Zgoda przestaje wisieć w mailu, a przy każdej stoi limit i ślad decyzji.', a: '5 dni', b: '4 godziny', c: 'od wniosku do księgowania' },
  { k: 'grafik', n: '06', t: 'Grafik zmian', z: 'Dziura w obsadzie pokazuje się w chwili, w której powstaje.', a: 'w piątek', b: 'od razu', c: 'widać brak osoby z uprawnieniem' },
  { k: 'reklamacje', n: '07', t: 'Rejestr reklamacji', z: 'Termin ustawowy odlicza się sam przy każdej sprawie i przypomina zawczasu.', a: '4 dni', b: '1 dzień', c: 'do decyzji w sprawie' },
  { k: 'kokpit', n: '08', t: 'Kokpit zarządu', z: 'Liczba na zarząd liczy się sama, z jednej definicji dla całej firmy.', a: 'rok', b: '1 dzień', c: 'zanim widać, który klient zarabia' },
];
const REEL_MS = 5400;

// ---- CIEMNY PAS: rok w jednej firmie ------------------------------------
const SCHODY = [
  { m: 'miesiąc 1', t: 'Pilnowanie ofert, które ucichły', d: 'Tydzień roboty. Pierwsza rzecz, po której ktokolwiek uwierzył, że to działa.', v: '3 dni' },
  { m: 'miesiąc 3', t: 'Rejestr ofert z historią ustaleń', d: 'Koniec z szukaniem w czyjejś skrzynce, co ustalono z klientem.', v: '2 dni' },
  { m: 'miesiąc 6', t: 'Wycena z rysunku technicznego', d: 'Rzecz, dla której cała reszta była rozbiegiem.', v: '6 godzin' },
  { m: 'miesiąc 8', t: 'Portal ze statusem sprawy', d: 'Klient przestał dzwonić z pytaniem, na jakim to etapie.', v: '25 minut' },
  { m: 'miesiąc 11', t: 'Rentowność zlecenia', d: 'Dopiero teraz było z czego ją policzyć.', v: '25 minut', nota: 'bez zmiany — ta rzecz mierzy się czym innym' },
];

// ---- NIE WSZYSTKO JEST APLIKACJĄ ----------------------------------------
// Sześć rzeczy, które nie mają własnego ekranu: siedzą w cudzych systemach
// albo chodzą w tle. Przy każdej trzy konkretne przykłady z miarą.
const UMIEJETNOSCI = [
  {
    k: 'czyta', t: 'Czyta dokumenty',
    d: 'Wszędzie tam, gdzie ktoś przepisuje dane z pliku do systemu.',
    p: [
      { t: 'Faktura kosztowa z poczty do systemu', a: '3 dni', b: '2 godziny' },
      { t: 'Wycena z rysunku i specyfikacji', a: '3 dni', b: '25 minut' },
      { t: 'Wymagania z dokumentacji przetargowej', a: '1 dzień', b: '15 minut' },
      { t: 'Kary i terminy z czterystu umów', a: 'nikt nie czytał', b: '3 dni' },
    ],
  },
  {
    k: 'przewiduje', t: 'Przewiduje',
    d: 'Model liczy szansę z Waszej historii, zamiast czekać, aż wyjdzie w raporcie.',
    p: [
      { t: 'Który klient zapłaci po terminie', a: '41 dni', b: '29 dni' },
      { t: 'Prognoza z lejka zamiast sumy deklaracji', a: '±40%', b: '±12%' },
      { t: 'Które zapytania warto wyceniać', a: '410 wycen', b: '180 wycen' },
      { t: 'Które zlecenie zejdzie pod kreskę', a: 'po zamknięciu', b: 'w trakcie' },
    ],
  },
  {
    k: 'slucha', t: 'Słucha i mówi',
    d: 'Rozmowa przestaje być rzeczą, którą trzeba potem przepisać.',
    p: [
      { t: 'Notatka ze spotkania trafia do systemu sama', a: '2 h tygodniowo', b: '0' },
      { t: 'Agent głosowy odbiera telefon po godzinach', a: '9 nagrań', b: '0' },
      { t: 'Podsumowanie rozmowy serwisowej w karcie klienta', a: 'jedno zdanie', b: 'komplet' },
    ],
  },
  {
    k: 'patrzy', t: 'Patrzy',
    d: 'Zdjęcie albo obraz z kamery zamiast formularza i obchodu.',
    p: [
      { t: 'Przestój na linii wykryty z obrazu kamery', a: 'następny dzień', b: '4 minuty' },
      { t: 'Dokument przewozowy ze zdjęcia telefonem', a: 'następny dzień', b: '2 minuty' },
      { t: 'Reklamacja ze zdjęciem uszkodzenia', a: '4 dni', b: '1 dzień' },
    ],
  },
  {
    k: 'pilnuje', t: 'Pilnuje',
    d: 'Rzeczy, o których zapomina się dokładnie wtedy, kiedy kosztuje to najwięcej.',
    p: [
      { t: 'Oferta, która ucichła, wraca do handlowca', a: '0 odzyskanych', b: '1 z 6 wraca' },
      { t: 'Umowa przedłużająca się bez decyzji', a: '11 sztuk', b: '0' },
      { t: 'Wygasające uprawnienie na zmianie', a: 'przy kontroli', b: '30 dni wcześniej' },
      { t: 'Sprawa bez ruchu od tygodnia', a: 'przy telefonie', b: 'codziennie rano' },
    ],
  },
  {
    k: 'odpowiada', t: 'Odpowiada z Waszych dokumentów',
    d: 'Asystent, który zna Wasze procedury i pokazuje, skąd wziął odpowiedź.',
    p: [
      { t: 'Pytanie o procedurę zamiast pytania do kolegi', a: '20 minut', b: '15 sekund' },
      { t: 'Odpowiedzi do formularza przetargowego', a: '2 dni', b: '2 godziny' },
      { t: 'Co druga strona zmieniła w umowie', a: '2 godziny', b: '5 minut' },
    ],
  },
];

const ILE = APLIKACJE.length + UMIEJETNOSCI.reduce((s, u) => s + u.p.length, 0);

const GRANICE = [
  { t: 'Czatu, który odpowiada na wszystko', d: 'Odpowiada również wtedy, kiedy nie wie. Koszt jednej złej odpowiedzi przy cenie albo terminie bywa większy niż oszczędność na stu dobrych.' },
  { t: 'Przepisania ERP-a od zera', d: 'To projekt na dwa lata, który zwykle kończy się w połowie. Taniej wychodzi zbudować obok to, czego ERP nie umie, i zostawić w nim księgowość.' },
  { t: 'Agenta, który sam pisze do klientów', d: 'Bez akceptacji człowieka pierwsza pomyłka kosztuje więcej niż rok zaoszczędzonego czasu. Projekt odpowiedzi tak, wysyłka po zatwierdzeniu.' },
  { t: 'Aplikacji zamiast decyzji', d: 'Kiedy w firmie nie ustalono, kto zatwierdza rabat, system tego nie rozstrzygnie. Wtedy zaczynamy od reguły, a narzędzie przychodzi po niej.' },
];

const title = "Inspiracje: aplikacje, które budujemy — showreel | Let's automate";
const description = `Osiem aplikacji firmowych pokazanych ekran po ekranie, z zadaniem, które rozwiązują, i liczbą przy każdym. Pod spodem ${ILE - APLIKACJE.length} rzeczy, które aplikacją nie są: odczyt dokumentów, prognozy, agent głosowy, obraz z kamery.`;

const dane = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'CollectionPage', '@id': `${kanon}#strona`, url: kanon, name: 'Inspiracje — aplikacje i rozwiązania AI, które budujemy', description, about: { '@id': new URL('/#organizacja', Astro.site).href } },
    {
      '@type': 'ItemList', '@id': `${kanon}#aplikacje`, name: 'Aplikacje firmowe, które budujemy', numberOfItems: APLIKACJE.length,
      itemListElement: APLIKACJE.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.t, description: `${p.z} Efekt: ${p.a} → ${p.b} ${p.c}.` })),
    },
    {
      '@type': 'BreadcrumbList', '@id': `${kanon}#okruszki`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Strona główna', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: 'Inspiracje', item: kanon },
      ],
    },
  ],
};

const faq = [
  { q: 'Czy te ekrany są z prawdziwych wdrożeń?', a: 'Kształt tak, dane nie. Ekrany rysujemy od zera pod tę stronę, a nazwy firm, kwoty i numery są przykładowe — prawdziwych zrzutów nie publikujemy, bo idą razem z danymi klientów. Na rozmowie pokazujemy działające wdrożenia po podpisaniu NDA.' },
  { q: 'Czy dostaniemy dokładnie taką aplikację?', a: 'Nie. Każda z nich powstała pod inny proces i Wasza też będzie inna — te same są elementy, z których się składa: rejestr, formularz, kolejka zatwierdzeń, powiadomienie, widok dla klienta. Dlatego druga i trzecia rzecz w tym samym miejscu kosztują wyraźnie mniej niż pierwsza.' },
  { q: 'Skąd biorą się liczby przy ekranach?', a: 'Z naszych wdrożeń, mierzone przed przebudową i po niej na tej samej sprawie. Firmy opisujemy branżą i wielkością, bez nazw, bo taki jest warunek większości umów. U Was mogą wyjść inne — dlatego stan wyjściowy mierzymy przed budową i zapisujemy próg w umowie. Bez pomiaru „przed" żadna z tych liczb nic nie znaczy.' },
  { q: 'Ile trwa zbudowanie takiej aplikacji?', a: 'Od trzech tygodni do trzech miesięcy, zależnie od tego, ile systemów trzeba dotknąć i ile przypadków szczególnych ma Wasz proces. Zaczynamy od jednej rzeczy, uruchamiamy ją na produkcji i dopiero potem bierzemy następną. Ciemny pas wyżej pokazuje, jak wyglądał taki rok w jednej firmie.' },
  { q: 'Czy do wszystkiego potrzebny jest model AI?', a: 'Nie. Aplikacje z showreelu to w większości zwykłe oprogramowanie: rejestry, obiegi, kokpity. Model dokładamy tam, gdzie wąskim gardłem jest czytanie albo słuchanie — i to są rzeczy z sekcji pod spodem. Jedno i drugie budujemy tak samo często.' },
  { q: 'Ile to kosztuje?', a: 'Cena idzie za wielkością rzeczy i za liczbą wyjątków w Waszym procesie. Największy wpływ mają trzy sprawy: ile systemów trzeba dotknąć, ile przypadków szczególnych obsługujecie i czy dane są już w jednym miejscu. Widełki podajemy po pierwszej rozmowie, na której przechodzimy jedną pozycję do końca. Nie mamy prowizji od żadnego dostawcy, więc wybór narzędzia nie zmienia naszego przychodu.' },
  { q: 'Nie mamy działu IT', a: 'To nie wyklucza niczego z tej strony. Wymaga natomiast osoby po Waszej stronie, która zna proces i ma prawo rozstrzygnąć wątpliwość — to zwykle kierownik działu. Dostępy do systemów ustawiamy z Waszym dostawcą IT. Firmom bez własnego działu IT poświęcona jest osobna strona: <a href="/guided-coding/bez-dzialu-it" style="font-weight:700;color:#0a7a52">budowanie aplikacji bez działu IT</a>.' },
  { q: 'Czyja jest ta aplikacja po odbiorze?', a: 'Wasza. Repozytorium, klucze i dostępy są Wasze od pierwszego dnia, więc utrzymanie może przejąć Wasz zespół albo inny dostawca. Kiedy utrzymujemy my, umowa jest osobna od budowy i wypowiadalna z miesięcznym terminem. Jeśli chcecie budować sami, tym zajmuje się <a href="/guided-coding" style="font-weight:700;color:#0a7a52">Guided Coding</a> — kod pisze Wasz zespół, my pilnujemy jakości.' },
];
dane['@graph'].push({
  '@type': 'FAQPage', '@id': `${kanon}#faq`,
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })),
});
---
<LaBase title={title} description={description} ctaHref="#kontakt" ctaLabel="Umów rozmowę" nav="inspiracje">
<script type="application/ld+json" is:inline set:html={JSON.stringify(dane)} slot="head"></script>
<style is:global slot="head">
  /* =====================================================================
     PRYMITYWY INTERFEJSU — wszystkie osiem ekranów jest z tych samych klocków,
     dzięki czemu showreel wygląda jak jedno oprogramowanie.
     ===================================================================== */
  .win{width:100%;min-width:0;background:#ffffff;border-radius:clamp(10px,1vw,14px);overflow:hidden;box-shadow:0 40px 70px -38px rgba(11,35,23,0.55),0 8px 20px -12px rgba(11,35,23,0.18),0 0 0 1px rgba(18,38,28,0.055)}
  .win-bar{display:flex;align-items:center;gap:9px;padding:9px 13px;background:#fbfcfa;border-bottom:1px solid #eef1ec}
  .win-bar i{width:7px;height:7px;border-radius:50%;background:#e0e5de;flex-shrink:0}
  .win-bar b{margin:0 auto;font-family:ui-monospace,Menlo,monospace;font-size:9.5px;font-weight:400;letter-spacing:0.04em;color:#a6b1a7;padding-right:30px}
  .win-body{display:grid;grid-template-columns:132px minmax(0,1fr)}
  .win-body.solo{grid-template-columns:minmax(0,1fr)}
  .pad{padding:clamp(13px,1.6vw,20px);min-width:0}

  .sb{padding:14px 9px;background:#fafcf9;border-right:1px solid #f0f3ee}
  .sb-h{padding:0 8px 11px;font-size:11px;font-weight:750;color:#16211a;display:flex;align-items:center;gap:7px}
  .sb-h span{display:flex;align-items:center;justify-content:center;width:17px;height:17px;border-radius:5px;background:#0e2b1d;color:#fff;font-size:9px;font-weight:800}
  .sb-i{display:flex;align-items:center;gap:8px;padding:7px 8px;border-radius:7px;font-size:11.5px;color:#8b968d;white-space:nowrap;overflow:hidden}
  .sb-i.on{background:#eef6f0;color:#0a7a52}
  .sb-i i{width:5px;height:5px;border-radius:50%;background:currentColor;opacity:.5;flex-shrink:0}

  .gh{display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-bottom:12px}
  .gh b{font-size:13.5px;font-weight:750;letter-spacing:-0.015em;color:#16211a}
  .tb{width:100%;font-size:11.5px}
  .tb-h{display:grid;gap:0 12px;padding:0 0 8px;font-family:ui-monospace,Menlo,monospace;font-size:9px;letter-spacing:0.09em;color:#b3beb4;border-bottom:1px solid #eef1ec}
  .tb-r{display:grid;gap:0 12px;padding:9px 0;border-bottom:1px solid #f4f7f2;align-items:center}
  .tb-r:last-child{border-bottom:0}
  .tb-r.hi{background:linear-gradient(90deg,rgba(0,205,119,0.09),rgba(0,205,119,0))}
  .mono{font-family:ui-monospace,Menlo,monospace;font-size:10.5px;color:#8b968d}
  .tr{color:#33413a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .tr b{font-weight:650;color:#16211a}
  .st{display:inline-flex;align-items:center;gap:6px;font-size:10.5px;color:#5e6b62;white-space:nowrap}
  .st i{width:6px;height:6px;border-radius:50%;background:#d5dcd3;flex-shrink:0}
  .st.ok i{background:var(--la-accent,#00CD77)}
  .st.cz i{background:#e0a854}
  .pill{display:inline-flex;align-items:center;gap:5px;padding:3px 9px;border-radius:20px;font-size:10px;font-weight:650;background:#eef6f0;color:#0a7a52;white-space:nowrap}
  .pill.am{background:#fdf3e4;color:#b07524}
  .kf{padding:12px 13px;border-radius:9px;background:#fafcf9;box-shadow:inset 0 0 0 1px #eff3ed}
  .kf-l{font-size:10px;color:#a6b1a7}
  .kf-v{margin-top:3px;font-size:clamp(19px,2vw,26px);font-weight:800;letter-spacing:-0.03em;line-height:1;color:#16211a}
  .kf-d{margin-top:5px;font-size:10px;font-weight:700;color:#0a7a52}
  .kf-d.am{color:#b07524}
  .slup{display:flex;align-items:flex-end;gap:4px;height:48px;margin-top:10px}
  .slup i{flex:1;border-radius:2px 2px 0 0;background:#dceadf}
  .slup i.on{background:var(--la-accent,#00CD77)}
  .doc{padding:13px 14px;border-radius:8px;background:#ffffff;box-shadow:0 14px 28px -20px rgba(11,35,23,0.45),0 0 0 1px #eef1ec}
  .doc-h{display:flex;align-items:baseline;justify-content:space-between;gap:10px;padding-bottom:9px;border-bottom:1px solid #f0f3ee}
  .doc-h b{font-size:11.5px;font-weight:750;color:#16211a}
  .doc-h span{font-family:ui-monospace,Menlo,monospace;font-size:9.5px;color:#b3beb4}
  .lin{display:block;height:4px;border-radius:3px;background:#eef1ec;margin-bottom:6px}
  .lin.mark{background:#cdeddd}
  .bt{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:7px;font-size:11px;font-weight:650}
  .bt.pri{background:#16211a;color:#fff}
  .bt.sec{background:#f2f5f0;color:#7c877e}
  .bt.acc{background:var(--la-accent,#00CD77);color:#0b1a11}
  .fon{width:clamp(176px,15vw,206px);flex-shrink:0;border-radius:26px;padding:8px;background:#12211a;box-shadow:0 40px 70px -34px rgba(11,35,23,0.7),0 0 0 1px rgba(255,255,255,0.09) inset}
  .fon-e{border-radius:20px;background:#fff;overflow:hidden}
  .fon-t{display:flex;align-items:center;justify-content:space-between;padding:9px 12px 7px;font-family:ui-monospace,Menlo,monospace;font-size:8.5px;color:#b3beb4}
  .fon-b{padding:4px 12px 15px}
  .tor{display:flex;align-items:flex-start}
  .krk{flex:1;display:flex;flex-direction:column;align-items:center;gap:7px;position:relative}
  .krk::before{content:"";position:absolute;top:5px;left:-50%;width:100%;height:2px;background:#e9eee6}
