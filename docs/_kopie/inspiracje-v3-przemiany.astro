const N = PRZEMIANY.length;
const FLAGOWE = PRZEMIANY.filter((p) => p.firma);
const wgObszaru = (k) => PRZEMIANY.filter((p) => p.o === k);

// Pasek proporcji: udział „po" w „dziś", policzony z minut.
const udzial = (m) => (m && m[0] && m[1] ? Math.max(0.35, (m[1] / m[0]) * 100) : null);
const procent = (m) => {
  if (!m || !m[0] || !m[1]) return null;
  const u = (m[1] / m[0]) * 100;
  return u < 1 ? u.toFixed(1).replace('.', ',') : Math.round(u);
};

// ---- HERO: trzy flagowe przemiany w pętli -------------------------------
const HE = FLAGOWE.slice(0, 3);
const HE_JEDEN = 5.2;
const HE_C = HE_JEDEN * HE.length;
const pc = (s) => `${((s / HE_C) * 100).toFixed(2)}%`;
const klatkiHero = [
  `@keyframes he-in{0%{opacity:0;transform:translateY(12px)}${pc(0.55)}{opacity:1;transform:none}${pc(HE_JEDEN - 0.2)}{opacity:1;transform:none}${pc(HE_JEDEN + 0.35)}{opacity:0;transform:translateY(-10px)}100%{opacity:0;transform:translateY(12px)}}`,
  `@keyframes he-po{0%,${pc(0.85)}{opacity:0;transform:translateY(10px) scale(.94)}${pc(1.35)}{opacity:1;transform:none}${pc(HE_JEDEN - 0.2)}{opacity:1;transform:none}${pc(HE_JEDEN + 0.35)}{opacity:0;transform:translateY(-8px)}100%{opacity:0;transform:translateY(10px) scale(.94)}}`,
  `@keyframes he-kreska{0%,${pc(0.75)}{transform:scaleX(0)}${pc(1.3)}{transform:scaleX(1)}${pc(HE_JEDEN - 0.2)}{transform:scaleX(1)}${pc(HE_JEDEN + 0.3)}{transform:scaleX(0)}100%{transform:scaleX(0)}}`,
  `@keyframes he-kropki{0%{background:#d5dcd3}${pc(0.4)}{background:var(--la-accent,#00CD77)}${pc(HE_JEDEN)}{background:var(--la-accent,#00CD77)}${pc(HE_JEDEN + 0.4)}{background:#d5dcd3}100%{background:#d5dcd3}}`,
].join('\n');

