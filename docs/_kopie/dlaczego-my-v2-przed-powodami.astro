---
<LaBase noindex topbar={false} title={title} description={description} ctaHref="#kontakt" ctaLabel="Umów rozmowę" nav="dlaczego-my">
<script type="application/ld+json" is:inline set:html={JSON.stringify(dane)} slot="head"></script>

<style is:global slot="head">
  /* ===================================================== HERO · PORTRET ====
     Piotr na ciemnej planszy: jego zdjęcie ma ciemne tło z zielonym neonem
     sygnetu, więc wtapia się w planszę. Karta z jego zdaniem nachodzi na
     lewą krawędź portretu. */
  .dm2-hw{position:relative;justify-self:end;width:min(100%,520px)}
  .dm2-hw-foto{position:relative;margin:0;border-radius:22px;overflow:hidden;
    box-shadow:0 0 0 1px rgba(255,255,255,0.07),0 70px 120px -60px rgba(0,0,0,0.9)}
  .dm2-hw-foto img{display:block;width:100%;height:auto;aspect-ratio:10/11;object-fit:cover;object-position:50% 24%}
  .dm2-hw-k{position:absolute;left:clamp(-150px,-8vw,-48px);bottom:clamp(30px,3.4vw,52px);width:min(340px,74%);margin:0;padding:22px 24px 20px;border-radius:18px;
    background:var(--papier);color:var(--t1);box-shadow:0 36px 70px -26px rgba(0,0,0,0.75)}
  .dm2-hw-k p{margin:0;font-size:16px;line-height:1.55;font-weight:500;letter-spacing:-0.005em;color:var(--t1);text-wrap:pretty}
  .dm2-hw-k p > span{font-weight:700;color:var(--ziel-c)}
  .dm2-hw-kto{display:block;margin-top:16px;padding-top:14px;border-top:1px solid var(--linia);font-size:12.5px;color:var(--t2)}
  .dm2-hw-kto b{display:block;font-size:14px;font-weight:700;color:var(--t1)}
  @media (max-width:1060px){
    .dm2-hw{justify-self:start;width:min(100%,460px);margin-left:clamp(0px,9vw,96px) !important}
  }
  @media (max-width:640px){
    .dm2-hw{margin-left:0 !important}
    .dm2-hw-k{position:relative;left:auto;bottom:auto;width:auto;margin:-64px 14px 0}
  }

  /* ============================================ INDEKS ZDAŃ (sekcja 2) ====
     Klasy indeksu z Styl.astro; tu tylko mniejszy stopień (zdania są
     dłuższe niż nazwy procesów) i karta usługi w trzeciej kolumnie. */
  .dm2-ix .ix-t{font-size:clamp(21px,2.45vw,36px);line-height:1.14;letter-spacing:-0.032em;text-wrap:balance}
  .dm2-ix .ix-w summary{padding:clamp(20px,2.2vw,30px) 0}
  .dm2-ix-pr{position:relative;padding-right:52px !important}
  .dm2-ix-pr small{font-size:13.5px;line-height:1.45;color:var(--t2)}
  .dm2-ix-pr > i{position:absolute;right:16px;top:50%;display:grid;place-items:center;width:28px;height:28px;margin-top:-14px;border-radius:50%;background:var(--ink);color:var(--ziel);transition:transform .2s}
  .dm2-ix-pr > i svg{width:13px;height:13px;fill:currentColor}
  .dm2-ix-pr:hover > i{transform:translateX(3px)}

  /* ============================================ KIM JESTEŚMY (sekcja 4) ====
     Fakt o nas drobniej po lewej, skutek u klienta dużym stopniem po
     prawej — układ z v5, w typografii nowych podstron. */
  .v3 #kim{padding-top:clamp(56px,7vw,96px)}
  .dm2-km{margin-top:clamp(64px,7vw,104px)}
  .dm2-km-w{display:grid;grid-template-columns:minmax(0,4fr) minmax(0,8fr);gap:14px clamp(32px,5vw,96px);align-items:start;padding:clamp(26px,3vw,40px) 0;border-top:1px solid var(--linia)}
  .dm2-km-w:first-child{border-top:1.5px solid var(--t1)}
  .dm2-km-f p{margin:0;max-width:420px;font-size:15px;line-height:1.62;color:var(--t2);text-wrap:pretty}
  .dm2-km-f img{display:block;width:auto;margin:0 0 16px}
  .dm2-km-f img.wg{height:17px}
  .dm2-km-f img.ap{height:24px}
  .dm2-km-f img.oai{height:46px;border-radius:9px;mix-blend-mode:multiply}
  .dm2-km-l{display:inline-flex;align-items:center;gap:6px;margin-top:12px;padding-bottom:2px;font-size:14px;font-weight:650;color:var(--ziel-c);border-bottom:1px solid rgba(10,122,82,0.35);transition:border-color .15s}
  .dm2-km-l:hover{border-color:var(--ziel-c)}
  .dm2-lnk{font-weight:650;color:var(--ziel-c);border-bottom:1px solid rgba(10,122,82,0.35);transition:border-color .15s}
  .dm2-lnk:hover{border-color:var(--ziel-c)}
  .dm2-km-k{margin:0;max-width:880px;font-size:clamp(22px,2.4vw,35px);line-height:1.16;letter-spacing:-0.033em;font-weight:650;color:var(--t1);text-wrap:balance}
  @media (max-width:900px){
    .dm2-km-w{grid-template-columns:minmax(0,1fr)}
    .dm2-km-k{order:-1}
  }

  /* ---- Blok 4a · karta projektu z dwunastoma decyzjami ----
     Kartka (dokument), nie okno aplikacji. Lewa kolumna: decyzje
     rozstrzygnięte w WiseStacku, ptaszki zapalają się po kolei. Prawa: to,
     co ustalamy z klientem — bursztyn, bo czeka na warsztat. */
  .dm2-ws-kart{max-width:1120px;margin:0 auto;padding:clamp(22px,2.6vw,36px) clamp(20px,2.8vw,40px) clamp(24px,2.8vw,36px);border-radius:16px;background:#fdfcf8;
    box-shadow:0 0 0 1px rgba(15,26,20,0.06),0 40px 70px -44px rgba(15,26,20,0.45)}
  .dm2-ws-gl{display:flex;justify-content:space-between;align-items:baseline;gap:12px 24px;flex-wrap:wrap;padding-bottom:14px;border-bottom:1.5px solid var(--t1)}
  .dm2-ws-gl b{font-size:clamp(17px,1.5vw,21px);font-weight:700;letter-spacing:-0.02em}
  .dm2-ws-gl span{font-family:var(--mono);font-size:12px;color:var(--t3)}
  .dm2-ws-sz{display:grid;grid-template-columns:minmax(0,7.4fr) minmax(0,4.6fr);gap:clamp(24px,3.4vw,56px);margin-top:clamp(20px,2.2vw,28px)}
  .dm2-ws-sz h4{display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin:0 0 6px;font-size:13.5px;font-weight:700;color:var(--t1)}
  .dm2-ws-sz h4 em{font-style:normal;font-family:var(--mono);font-size:12px;font-weight:500;color:var(--t3)}
  .dm2-ws-f{display:grid;grid-template-columns:minmax(0,1fr);margin-top:14px}
  .dm2-ws-f > span{font-size:12px;font-weight:600;color:var(--t3);padding-bottom:4px}
  .dm2-ws ul{margin:0;padding:0;list-style:none}
  .dm2-ws-l ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:24px}
  .dm2-ws li{display:flex;align-items:flex-start;gap:10px;padding:8px 0;border-top:1px solid var(--linia2);font-size:13.5px;line-height:1.4;color:var(--t1)}
  .dm2-ws-l li > i{flex-shrink:0;display:grid;place-items:center;width:16px;height:16px;margin-top:1px;border-radius:50%;background:var(--ziel)}
  .dm2-ws-l li > i svg{width:10px;height:10px;fill:var(--ink)}
  .dm2-ws-p{padding-left:clamp(20px,2.6vw,40px);border-left:1px solid var(--linia)}
  .dm2-ws-p ul{margin-top:14px}
  .dm2-ws-p li{flex-wrap:wrap;padding:11px 0}
  .dm2-ws-p li > i{flex-shrink:0;width:16px;height:16px;margin-top:1px;border-radius:4px}
  .dm2-ws-p li > span{flex:1;min-width:0}
  .dm2-ws-p li small{display:block;margin-top:2px;font-size:12px;color:var(--burs-c)}
  .dm2-ws-p > p{margin:18px 0 0;font-size:13px;line-height:1.55;color:var(--t2)}
  @media (max-width:860px){
    .dm2-ws-sz{grid-template-columns:minmax(0,1fr)}
    .dm2-ws-p{padding:22px 0 0;border-left:0;border-top:1.5px solid var(--t1)}
  }
  @media (max-width:560px){ .dm2-ws-l ul{grid-template-columns:minmax(0,1fr)} }
  /* wejście w kadr: ptaszki po kolei, potem pozycje do ustalenia */
  .dm2-ws.gra .dm2-ws-l li{color:var(--t3)}
  .dm2-ws.gra .dm2-ws-l li > i{transform:scale(0)}
  .dm2-ws.gra.on .dm2-ws-l li{color:var(--t1);transition:color .3s calc(var(--i) * 75ms + 0.25s)}
  .dm2-ws.gra.on .dm2-ws-l li > i{transform:none;transition:transform .35s cubic-bezier(.3,1.6,.5,1) calc(var(--i) * 75ms + 0.25s)}
  .dm2-ws.gra .dm2-ws-p li{opacity:0;transform:translateY(6px)}
  .dm2-ws.gra.on .dm2-ws-p li{opacity:1;transform:none;transition:opacity .4s calc(1.3s + var(--j) * 0.12s),transform .4s calc(1.3s + var(--j) * 0.12s)}

  /* ---- Blok 4b · konta w projekcie, w trakcie i po zakończeniu ----
     Stan bez klasy = po zakończeniu (to widać bez JS i przy ograniczonym
     ruchu). .wt = w trakcie współpracy. Przełącznik pokazuje się dopiero
     z JS (.js). Po wejściu w kadr rysunek sam przechodzi z „w trakcie"
     do „po zakończeniu": znika tylko prawa kolumna. */
  .dm2-tg{display:none;gap:3px;padding:4px;border-radius:999px;background:#ffffff;box-shadow:0 0 0 1px rgba(15,26,20,0.08)}
  .dm2-kn.js .dm2-tg{display:inline-flex}
  .dm2-tg button{appearance:none;border:0;background:transparent;font:inherit;font-size:13.5px;font-weight:650;color:var(--t2);padding:8px 14px;border-radius:999px;cursor:pointer;transition:background .2s,color .2s}
  .dm2-tg button:hover{color:var(--t1)}
  .dm2-tg button[aria-pressed="true"]{background:var(--ink);color:#ffffff}
  .dm2-tg button:focus-visible{outline:2px solid var(--ziel);outline-offset:2px}
  .dm2-kn-tab{max-width:1120px;margin:0 auto;border-radius:16px;background:#ffffff;box-shadow:0 0 0 1px rgba(15,26,20,0.06),0 40px 70px -44px rgba(15,26,20,0.45);overflow:hidden}
  .dm2-kn-w{display:grid;grid-template-columns:minmax(0,4.4fr) minmax(0,3.6fr) minmax(0,4fr);align-items:center;gap:16px;padding:14px clamp(18px,2.4vw,32px);border-top:1px solid var(--linia2)}
  .dm2-kn-w.n{padding-top:16px;padding-bottom:12px;border-top:0;background:#fbfaf6;font-size:12.5px;font-weight:650;color:var(--t3)}
  .dm2-kn-z{display:flex;align-items:center;gap:12px;min-width:0}
  .dm2-kn-z > i{flex-shrink:0;display:grid;place-items:center;width:34px;height:34px;border-radius:10px;background:var(--papier);color:var(--t1)}
  .dm2-kn-z > i svg{width:15px;height:15px;fill:currentColor}
  .dm2-kn-z b{display:block;font-size:14.5px;font-weight:650;letter-spacing:-0.01em}
  .dm2-kn-z small{display:block;margin-top:1px;font-family:var(--mono);font-size:11.5px;color:var(--t3)}
  .dm2-kn-o{display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:14px;color:var(--t1)}
  .dm2-kn-o > i{flex-shrink:0;display:grid;place-items:center;width:16px;height:16px;border-radius:50%;background:var(--ziel)}
  .dm2-kn-o > i svg{width:10px;height:10px;fill:var(--ink)}
  .dm2-kn-d{display:flex;align-items:center;gap:12px;min-width:0}
  .dm2-kn-os{position:relative;display:flex;flex-shrink:0}
  .dm2-kn-os img{width:28px;height:28px;border-radius:50%;object-fit:cover;box-shadow:0 0 0 2px #ffffff;transition:filter .35s calc(var(--i) * 0.14s),opacity .35s calc(var(--i) * 0.14s)}
  .dm2-kn-os img + img{margin-left:-8px}
  .dm2-kn-os::after{content:"";position:absolute;left:-4px;right:-4px;top:50%;height:1.5px;margin-top:-0.75px;background:var(--t2);transform-origin:0 50%;transition:transform .35s calc(var(--i) * 0.14s + 0.1s)}
  .dm2-kn-r{display:grid;font-size:13.5px;white-space:nowrap}
  .dm2-kn-r > *{grid-area:1 / 1;transition:opacity .3s calc(var(--i) * 0.14s + 0.1s)}
  .dm2-kn-r span{color:var(--t1)}
  .dm2-kn-r s{color:var(--t3);text-decoration:none}
  /* stan „po zakończeniu" (domyślny) */
  .dm2-kn-os img{filter:grayscale(1);opacity:0.4}
  .dm2-kn-r span{opacity:0}
  /* stan „w trakcie" */
  .dm2-kn.wt .dm2-kn-os img{filter:none;opacity:1}
  .dm2-kn.wt .dm2-kn-os::after{transform:scaleX(0)}
  .dm2-kn.wt .dm2-kn-r span{opacity:1}
  .dm2-kn.wt .dm2-kn-r s{opacity:0}
  .dm2-kn-st{max-width:1120px;margin:18px auto 0;display:grid;padding:0 4px;font-size:14.5px;line-height:1.5;color:var(--t2)}
  .dm2-kn-st > span{grid-area:1 / 1;transition:opacity .3s}
  .dm2-kn-st b{color:var(--t1);font-weight:650}
  .dm2-kn-st .wt{opacity:0}
  .dm2-kn.wt .dm2-kn-st .wt{opacity:1}
  .dm2-kn.wt .dm2-kn-st .po{opacity:0}
  @media (max-width:760px){
    .dm2-kn-w{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:10px 14px}
    .dm2-kn-w.n{display:none}
    .dm2-kn-z{grid-column:1 / -1}
    .dm2-kn-o{font-size:13px}
  }
  @media (max-width:560px){ .dm2-tg button{padding:7px 11px;font-size:12.5px} }
  @media (prefers-reduced-motion:reduce){
    .dm2-kn *,.dm2-kn *::after{transition:none !important}
  }

  /* ========================================== KTO STOI ZA (sekcja 5) ====
     Spoty z v5 na ciemnej scenie nowych podstron. Sekcja bez paddingu
     pionowego — spoty biegną przez całą wysokość pasa; poziomo ten sam
     kontener co reszta strony. */
  .dm2-lz{display:grid;grid-template-columns:minmax(0,0.95fr) minmax(0,1.45fr);gap:clamp(28px,4vw,72px);align-items:center;padding:0 var(--pad);scroll-margin-top:16px}
  .dm2-lz-t{padding:clamp(80px,9vw,136px) 0}
  .dm2-lz-t .v3-sub{max-width:44ch}
  .dm2-lz-t .v3-h2 + .v3-sub{margin-top:clamp(22px,2.6vw,34px)}
  .dm2-lz-t .v3-sub + .v3-sub{margin-top:14px}
  .dm2-lz-t b{font-weight:650;color:#ffffff}
  .dm2-sp{align-self:stretch;display:grid;grid-template-columns:repeat(var(--spoty,4),minmax(0,1fr));gap:6px;min-height:clamp(380px,36vw,520px)}
  .dm2-sp-s{position:relative;overflow:hidden;margin:0;background:#12261b}
  .dm2-sp-s:first-child{border-radius:16px 0 0 16px}
  .dm2-sp-s:last-child{border-radius:0 16px 16px 0}
  .dm2-sp-s img{display:block;width:100%;height:100%;object-fit:cover;object-position:50% 18%;filter:grayscale(1) contrast(1.06)}
  .dm2-sp-pod{position:absolute;left:0;right:0;bottom:0;padding:clamp(96px,13vw,150px) clamp(12px,1.4vw,18px) clamp(16px,1.8vw,22px);background:linear-gradient(180deg,rgba(7,20,13,0),rgba(7,20,13,0.62) 34%,rgba(7,20,13,0.95) 74%)}
  .dm2-sp-pod b{display:block;font-size:clamp(13px,1.3vw,15.5px);font-weight:700;line-height:1.2;color:#ffffff;text-wrap:pretty}
  .dm2-sp-pod span{display:block;min-height:2.6em;margin-top:4px;font-size:12px;line-height:1.3;color:rgba(255,255,255,0.6);text-wrap:pretty}
  /* Poniżej 760 px dwie kolumny i sztywna proporcja 1:2,2 — węższa niż
     najwęższy plik (Bilski 0,475), więc kadr dalej przycina szerokość
     i twarze zostają na tej samej wysokości. */
  @media (max-width:1200px){
    .dm2-lz{grid-template-columns:minmax(0,1fr);gap:0}
    .dm2-lz-t{padding:clamp(72px,9vw,104px) 0 clamp(34px,4.4vw,48px)}
    .dm2-lz-t .v3-sub{max-width:60ch}
    .dm2-sp{min-height:clamp(300px,40vw,440px)}
  }
  @media (max-width:760px){
    .dm2-sp{grid-template-columns:repeat(2,minmax(0,1fr));min-height:0}
    .dm2-sp-s{aspect-ratio:1 / 2.2}
    .dm2-sp-s:first-child{border-radius:16px 0 0 0}
    .dm2-sp-s:nth-child(2){border-radius:0 16px 0 0}
    .dm2-sp-s:nth-child(3){border-radius:0 0 0 16px}
    .dm2-sp-s:last-child{border-radius:0 0 16px 0}
    .dm2-sp-pod span{min-height:0}
  }

  /* ============================================ LICZBY I CYTATY (6) ====
     Karty na wspólnym rzędzie przykładów (.dw-sc, .dw4-k). Miara nie jest
     „przed / po" w jednej skali, więc w środku duża liczba i dwa zdania;
     bursztyn przy „Przed", zieleń przy „Po" — jak na całej stronie. */
  .dm2-dws .dw4-k{flex:1 0 clamp(272px,22vw,320px);padding:24px 24px 22px}
  .dm2-dw-l{margin:20px 0 0;font-size:clamp(46px,4.2vw,62px);font-weight:700;letter-spacing:-0.05em;line-height:0.95;color:var(--t1)}
  .dm2-dw-l span{color:var(--ziel-c)}
  .dw4-k .dm2-dw-t{margin:10px 0 0;font-size:15px;font-weight:650;letter-spacing:-0.01em;line-height:1.3;color:var(--t2)}
  .dm2-dw-pp{margin-top:auto;padding-top:22px}
  .dm2-dw-pp p{margin:0;padding:12px 0 0;border-top:1px solid var(--linia);font-size:14px;line-height:1.55;color:var(--t2);text-wrap:pretty}
  .dm2-dw-pp p + p{margin-top:12px;color:var(--t1)}
  .dm2-dw-pp b{display:flex;align-items:center;gap:8px;margin-bottom:4px;font-size:12.5px;font-weight:650;color:var(--t3)}
  .dm2-dw-pp b i{display:block;width:12px;height:12px;border-radius:3px}
  .dm2-dw-pp p + p b{color:var(--ziel-c)}
  .dm2-dw-pp p + p b i{background:var(--ziel)}
  /* klamra z sekcją 2: podpis nad cytatem, pod nim dwa mniejsze */
  .dm2-op{margin-top:clamp(80px,9vw,136px)}
  #dowody .dm2-op .v3-cyt{margin-top:clamp(24px,2.8vw,38px) !important}
  .dm2-op-m{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px clamp(32px,4vw,72px);margin-top:clamp(48px,5vw,76px)}
  .dm2-op-m figure{margin:0;padding-top:22px;border-top:1px solid var(--linia)}
  .dm2-op-m blockquote{margin:0;max-width:560px;font-size:clamp(17px,1.5vw,20px);line-height:1.45;letter-spacing:-0.012em;font-weight:500;color:var(--t1);text-wrap:pretty}
  .dm2-op-m figcaption{margin-top:18px;padding-left:14px;border-left:2px solid var(--ziel);font-size:13.5px;line-height:1.45;color:var(--t2)}
  .dm2-op-m figcaption b{display:block;font-size:14.5px;font-weight:700;color:var(--t1)}
  @media (max-width:760px){ .dm2-op-m{grid-template-columns:minmax(0,1fr)} }

  /* ========================================= PIERWSZA ROZMOWA (7) ====
     Trzy odpowiedzi obok siebie — kafle, bo służą porównaniu. Wszystkie
     w jednym kolorze; pierwsza szersza, bo to odpowiedź, po którą klient
     przychodzi. Przykład na dole każdej karty, w tincie papieru. */
  .dm2-od{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr) minmax(0,1fr);gap:clamp(12px,1.2vw,16px);margin-top:clamp(48px,5vw,80px)}
  .dm2-od-k{display:flex;flex-direction:column;padding:clamp(24px,2.4vw,34px);border-radius:24px;background:#ffffff;box-shadow:0 0 0 1px rgba(15,26,20,0.05),0 30px 60px -48px rgba(15,26,20,0.4)}
  .dm2-od-gl{display:flex;align-items:center;justify-content:space-between}
  .dm2-od-ik{display:grid;place-items:center;width:42px;height:42px;border-radius:50%;background:var(--ink);color:var(--ziel)}
  .dm2-od-ik svg{width:19px;height:19px;fill:currentColor}
  .dm2-od-n{font-family:var(--mono);font-size:12px;color:var(--t3)}
  .dm2-od-k h3{margin:clamp(26px,3vw,40px) 0 0;font-size:clamp(22px,2vw,29px);font-weight:700;letter-spacing:-0.032em;line-height:1.1;text-wrap:balance}
  .dm2-od-k > p{margin:12px 0 0;max-width:460px;font-size:15.5px;line-height:1.6;color:var(--t2);text-wrap:pretty}
  .dm2-od-pr{margin-top:auto;padding-top:clamp(24px,2.6vw,34px)}
  .dm2-od-pr > div{padding:16px 18px;border-radius:14px;background:var(--papier)}
