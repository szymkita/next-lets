      <p class="ef-t">{e.t}</p>
      <div class="ef-s">
        <div class="ef-c przed"><span class="ef-v">{e.pT}</span><span class="ef-b" style={`--h:${((e.p / skala) * 100).toFixed(0)}%`}></span><span class="ef-l">przed</span></div>
        <div class="ef-c po"><span class="ef-v">{e.poT}</span><span class="ef-b" style={`--h:${((e.po / skala) * 100).toFixed(0)}%`}></span><span class="ef-l">dziś</span></div>
      </div>
    </div>
  );
})}
</div>
<p style="margin:clamp(20px,2.4vw,28px) 0 0"><span class="pogl-j">Dane poglądowe · okno pomiaru przed i po zamykamy u siebie</span></p>
</section>

