---
// WISESTACK — /wisestack · WERSJA 2 (07.09.2026)
//
// v1 (kopia: docs/_kopie/wisestack-v1-czas-do-sygnalu.astro) stała na czasie
// powrotu sygnału o błędzie i na dobieraniu następnego kroku. Uwaga Szymona:
// „skupiasz się na jakimś kolejnym kroku, a ma wybrzmiewać, że to jest gotowy
// zestaw naszych wyborów, które już podjęliśmy (…) mówimy o jakichś błędach,
// a z tego ma wyjść manifest, żeby wszyscy tego chcieli".
//
// TRZY ZMIANY KIERUNKU:
//   1. GOTOWY ZESTAW, nie metoda podejmowania decyzji. Wybory są podjęte.
//      Zniknęła sekcja „dobieramy następny krok" i cała warstwa o ryzyku.
//   2. CAŁA DROGA, nie samo pisanie. Poukładanie procesu przed kodem i to,
//      co dzieje się po wdrożeniu — kod jest najkrótszym odcinkiem.
//   3. MANIFEST, nie whitepaper o granicach. Zniknęła sekcja „czego ta metoda
//      nie obiecuje" i język błędów. Hero mówi „Poznajcie WiseStack".
//
// WYKRESY (sześć, wszystkie na danych PRZYKŁADOWYCH — patrz blok niżej):
//   A. tempo dostarczania przez rok: no-code / klasyczny development / WiseStack
//   B. gdzie jest praca w projekcie — i co obejmują same narzędzia AI
//   C. koszt kolejnej zmiany w trzech modelach pracy
//   D. udział AI w kodzie: 100%, z punktami decyzji człowieka na osi
//   E. trzy miary naszego własnego tempa, przed i po
//   F. macierz porównawcza trzech modeli
//
// UWAGA O NAWIGACJI: hero jest jasne, a ciemny jest dopiero panel z wykresem.
// Nagłówek serwisu ma linki w kolorze #2c3a30 wpisane inline — na ciemnym tle
// zniknęłyby, a przy scrollu pigułka robi się biała i musiałyby wrócić.
//
// DANE PRZYKŁADOWE — DO PODMIANY PRZED PUBLIKACJĄ:
// · TEMPO, KOSZT, EFEKTY, PODZIAL i wszystkie liczby w pasku statystyk.
//   Każdy wykres ma widoczny podpis „dane poglądowe"; po pomiarze zdejmujemy
//   podpisy i podmieniamy tablice w tym nagłówku.
// · „100% kodu pisze AI" — deklaracja Szymona, nie pomiar. Jeśli ma zostać,
//   warto mieć jedno zdanie o tym, jak to liczymy.
// · „200+ wdrożeń" — liczba używana już na /guided-coding.
// · /og/wisestack.png — strona dziedziczy /og/hub.png.
import LaBase from '../layouts/LaBase.astro';
import GcFaq from '../components/GcFaq.astro';
import GcCta from '../components/GcCta.astro';

const kanon = new URL('/wisestack', Astro.site).href;

const title = "WiseStack — tak budujemy oprogramowanie z AI | Let's automate";
const description = 'Cały kod pisze AI, wszystkie decyzje podejmuje człowiek. WiseStack to zestaw wyborów, które podjęliśmy raz i stosujemy w każdym projekcie — od poukładania procesu, przez kod, po wdrożenie i utrzymanie.';

// ============================================================================
// PASEK STATYSTYK (hero)
// ============================================================================
const STATY = [
  { l: '100%', o: 'kodu w projekcie pisze AI' },
  { l: '5×', o: 'krócej niż przy klasycznym wytwarzaniu' },
  { l: '5 tyg.', o: 'od startu do wdrożenia u użytkowników' },
  { l: '200+', o: 'wdrożeń, na których to powstało' },
];

// ============================================================================
// CZTERY MODELE PRACY — jedna tablica zasila hero i wykres faz.
//
// Kluczowa poprawka po uwadze Szymona: nie porównujemy się do „klasycznego
// developmentu” w ogóle, tylko przede wszystkim do zespołu, który siedzi na
// tym samym stosie i używa AI, ale bez ustalonych zasad. Ten model musi być
// w każdym porównaniu, bo to z nim klient nas realnie zestawia.
//
// Trzy fazy: [zanim powstanie kod, pisanie kodu, po napisaniu kodu] w tygodniach.
// Samo AI skraca WYŁĄCZNIE środkowy odcinek (8 → 2 tygodnie), więc projekt
// schodzi z 24 do 18 tygodni. Reszta drogi bierze się z zasad.
// ============================================================================
const FAZY = [
  { t: 'Zanim powstanie kod', kolor: '#8b968d' },
  { t: 'Pisanie kodu', kolor: '#00CD77' },
  { t: 'Po napisaniu kodu', kolor: '#c9d4ca' },
];
const MODELE = [
  { t: 'Klasyczny development', d: 'bez AI', faz: [4, 8, 12], kolor: '#c3cec4' },
  { t: 'Ten sam stack z AI', d: 'bez ustalonych zasad', faz: [4, 2, 12], kolor: '#8b968d' },
  { t: 'No-code', d: 'z sufitem platformy', faz: [2, 3, 4], kolor: '#e0a94f' },
  { t: 'WiseStack', faz: [2, 1, 2], kolor: 'linear-gradient(90deg,#00CD77,#0a7a52)', nasz: true },
];
const suma = (m) => m.faz.reduce((a, b) => a + b, 0);
const CZAS_MAX = Math.max(...MODELE.map(suma));

// ============================================================================
// WYKRES C · KOSZT KOLEJNEJ ZMIANY (godziny)
// ============================================================================
const KOSZT = {
  osie: ['1. zmiana', '5. zmiana', '20. zmiana', '50. zmiana'],
  max: 72,
  serie: [
    { t: 'Klasyczny development', kolor: '#c3cec4', d: [12, 13, 15, 18] },
    { t: 'Ten sam stack z AI', kolor: '#8b968d', d: [4, 6, 12, 21] },
    { t: 'No-code', kolor: '#e0a94f', d: [2, 7, 32, 70] },
    { t: 'WiseStack', kolor: '#00CD77', d: [2, 2, 3, 4] },
  ],
};

// ============================================================================
// WYKRES D · UDZIAŁ AI W KODZIE (ciemny pas)
// Pasek to jedna funkcjonalność: dwadzieścia odcinków pracy, wszystkie zielone.
// Nad nim punkty, w których rozstrzyga człowiek.
// ============================================================================
const DECYZJE = [
  { p: 6, t: 'Co budujemy' },
  { p: 22, t: 'Jak to ma działać' },
  { p: 41, t: 'Które przypadki są ważne' },
  { p: 60, t: 'Czy to jest to' },
  { p: 78, t: 'Co wchodzi na produkcję' },
  { p: 93, t: 'Co dalej' },
];
const ROBOTA = [
  'Rozumienie problemu i celu biznesowego',
  'Kolejność, w jakiej powstają funkcje',
  'Kryterium, po którym poznajemy, że jest gotowe',
  'Ocena, czy rezultat odpowiada potrzebie',
  'Zgoda na wejście zmiany do ludzi',
];

// ============================================================================
// WYKRES E · NASZE TEMPO, PRZED I PO
// Trzecia miara rośnie celowo: więcej czasu idzie dziś na poukładanie.
// ============================================================================
const EFEKTY = [
  { t: 'Czas realizacji całego wdrożenia', p: 24, po: 5, pT: '24 tyg.', poT: '5 tyg.' },
  { t: 'Czas wprowadzenia zmiany zgłoszonej przez klienta', p: 9, po: 1, pT: '9 dni', poT: '1 dzień' },
  { t: 'Udział czasu na poukładanie procesu', p: 17, po: 40, pT: '17%', poT: '40%' },
];

// ============================================================================
// WYKRES F · MACIERZ CZTERECH MODELI
// ============================================================================
const KOLUMNY = ['Klasyczny development', 'Ten sam stack z AI', 'No-code', 'WiseStack'];
const MACIERZ = [
  { w: 'Pierwsza działająca wersja', k: ['tygodnie', 'dni', 'dni', 'dni'] },
  { w: 'Dwudziesta zmiana', k: ['tak samo drogo', 'coraz drożej', 'coraz drożej', 'tak samo tanio'] },
  { w: 'Sufit możliwości', k: ['brak', 'brak', 'to, co przewidziała platforma', 'brak'] },
  { w: 'Powtarzalność między osobami', k: ['zależy od zespołu', 'każdy pracuje po swojemu', 'wymuszona przez platformę', 'spisana i wymuszona'] },
  { w: 'Czyj jest kod', k: ['Wasz', 'Wasz', 'platformy', 'Wasz'] },
  { w: 'Kto to poprowadzi za dwa lata', k: ['zespół, który to pisał', 'autor tamtych sesji', 'dostawca platformy', 'każdy, kto zna zasady'] },
];

// ============================================================================
// MANIFEST — cztery zdania, na których stoi cała strona
// ============================================================================
const MANIFEST = [
  { n: '01', t: 'Cały kod pisze AI', d: 'Od pierwszej linijki do wdrożenia. Nie zostawiamy sobie pracy tylko dlatego, że kiedyś tak się ją robiło.' },
  { n: '02', t: 'Wszystkie decyzje podejmuje człowiek', d: 'Co powstaje, dla kogo, w jakiej kolejności i kiedy to jest gotowe. Model wykonuje, kierunek nadaje zespół.' },
  { n: '03', t: 'Wybory są już podjęte', d: 'Stos technologiczny, konwencje, sposób weryfikacji i sposób zapisu wiedzy. Projekt zaczyna się od Waszego problemu.' },
  { n: '04', t: 'Obejmuje całą drogę', d: 'Poukładanie procesu przed kodem i wszystko, co dzieje się po wdrożeniu. Samo pisanie jest najkrótszym odcinkiem.' },
];

// ============================================================================
// ZESTAW WYBORÓW — to jest „gotowość" tej metody, pokazana wprost
// ============================================================================
const WYBORY = [
  {
    faza: 'Zanim powstanie kod',
    p: [
      { t: 'Język domeny spisany przed pierwszym ekranem', d: 'Jedna nazwa na jedną rzecz, u Was i u nas.' },
      { t: 'Decyzje zapisane razem z powodem', d: 'Wracamy do nich zamiast rozstrzygać drugi raz.' },
      { t: 'Kryterium „gotowe” ustalone z góry', d: 'Zdanie, po którym widać, że funkcja jest skończona.' },
      { t: 'Prototyp tam, gdzie rozstrzyga szybciej niż rozmowa', d: 'Działająca forma zamiast kolejnego spotkania.' },
    ],
  },
  {
    faza: 'Kiedy powstaje kod',
    p: [
      { t: 'Next.js i Convex jako jeden stos', d: 'Schemat, typy, funkcje serwera i logi w jednym miejscu.' },
      { t: 'Typy generowane ze schematu danych', d: 'Kontrakt między częściami aplikacji jest wymuszony.' },
      { t: 'Reguły projektu czytane przez modele', d: 'Nowa sesja zna konwencje bez tłumaczenia od zera.' },
      { t: 'Każda gałąź z własnym działającym adresem', d: 'Zmianę widać jako klikalną wersję systemu.' },
    ],
  },
  {
    faza: 'Po napisaniu kodu',
    p: [
      { t: 'Osobna ocena produktu i osobna wykonania', d: 'Dwa pytania z osobnymi kryteriami.' },
      { t: 'Testy postawione na granicach procesu', d: 'Pilnują przebiegu całej sprawy w systemie.' },
      { t: 'Monitoring z imiennym właścicielem', d: 'Wiadomo, do kogo idzie sygnał i w jakim czasie.' },
      { t: 'Repozytorium i klucze Wasze od pierwszego dnia', d: 'Wyjście z współpracy nie wymaga migracji.' },
    ],
  },
];

const faq = [
  {
    q: 'Naprawdę cały kod pisze AI?',
    a: 'Tak — od pierwszej linijki do wdrożenia. Człowiek prowadzi pracę, czyta rezultat i decyduje, co wchodzi na produkcję. Wartość WiseStacku leży w tym, co ustawiamy wokół modelu: schemacie danych, typach, regułach projektu, sposobie sprawdzania i zapisie decyzji. Dopiero to sprawia, że model pracuje na aktualnym stanie systemu.',
  },
  {
    q: 'Czym to się różni od no-code?',
    a: 'Sufitem i własnością. Platformy no-code są szybkie do pierwszej wersji i świetnie sprawdzają się w prostych przepływach, ale kończą się tam, gdzie kończy się wyobraźnia ich twórców — a aplikacja zostaje u dostawcy. U nas powstaje zwykły kod w Waszym repozytorium, więc kolejna zmiana kosztuje tyle samo co pierwsza, a integracja z Waszym ERP-em jest kwestią decyzji.',
  },
  {
    q: 'Czy WiseStack to produkt, który kupujemy?',
    a: 'To sposób, w jaki realizujemy projekty — dostajecie go razem z każdą aplikacją, którą dla Was budujemy. Jeśli chcecie pracować tak samo u siebie, służy do tego osobna usługa: <a href="/guided-coding" style="font-weight:700;color:#0a7a52">Guided Coding</a>, czyli przeniesienie tych zasad i konfiguracji do Waszego zespołu.',
  },
  {
    q: 'Skąd te liczby na wykresach?',
    a: 'Wykresy na tej stronie mają dane poglądowe i są tak podpisane. Mierzymy u siebie okno przed i po, w tych samych miarach, które proponujemy klientom; kiedy się domknie, podmienimy je na wyniki razem ze sposobem liczenia.',
  },
  {
    q: 'Co z poufnością naszego kodu?',
    a: 'Pracujemy na narzędziach w konfiguracji, która wyłącza wykorzystanie treści do trenowania modeli, a przy projektach objętych NDA zakres ustalamy przed pierwszym commitem. Jeśli u Was obowiązuje ostrzejsza zasada — własna infrastruktura albo model po Waszej stronie — to jest decyzja projektowa i zapada na starcie.',
  },
];

const dane = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      '@id': `${kanon}#artykul`,
      headline: 'WiseStack — tak budujemy oprogramowanie z AI',
      description,
      url: kanon,
      inLanguage: 'pl-PL',
      author: { '@id': new URL('/#organizacja', Astro.site).href },
      publisher: { '@id': new URL('/#organizacja', Astro.site).href },
      about: ['Wytwarzanie oprogramowania z AI', 'Porównanie z no-code', 'Stos technologiczny'],
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${kanon}#okruszki`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Strona główna', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: 'WiseStack', item: kanon },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${kanon}#faq`,
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
      })),
    },
  ],
};
---
<LaBase title={title} description={description} ctaHref="#kontakt" ctaLabel="Umów rozmowę" nav="dlaczego-my">
<script type="application/ld+json" is:inline set:html={JSON.stringify(dane)} slot="head"></script>
<style is:global slot="head">
  /* ================= HERO ================= */
  .mega{font-size:clamp(44px,8.4vw,104px);line-height:0.94;letter-spacing:-0.045em;font-weight:800;color:#16211a;text-wrap:balance}
  .lead{font-size:clamp(17px,2.3vw,22px);line-height:1.5;color:#33413a;text-wrap:pretty}
  .lead b{font-weight:750;color:#16211a}

  /* ---- wykres czasu (hero) ----
     Bez ramki, bez cienia, bez tła: ma być częścią sekcji, nie kartą
     wstawioną w stronę. Wcześniejsza wersja wyglądała jak widżet, o którym
     nie wiadomo, skąd się wziął. */
  .pogl{font-family:ui-monospace,Menlo,monospace;font-size:10.5px;letter-spacing:0.1em;text-transform:uppercase;color:#a9b3aa;white-space:nowrap}
  .pogl-j{font-family:ui-monospace,Menlo,monospace;font-size:10.5px;line-height:1.5;letter-spacing:0.1em;text-transform:uppercase;color:#a9b3aa}
  .cz{max-width:1000px;margin:clamp(40px,5.2vw,68px) auto 0;text-align:left}
  .cz-tyt{margin:0 0 clamp(18px,2.2vw,26px);text-align:center;font-family:ui-monospace,Menlo,monospace;font-size:11.5px;letter-spacing:0.14em;text-transform:uppercase;color:#96a098}
  .cz-w{display:grid;grid-template-columns:238px minmax(0,1fr) 116px;gap:clamp(14px,2.2vw,28px);align-items:center;padding:clamp(7px,1vw,11px) 0}
  .cz-e{font-size:14.5px;font-weight:650;line-height:1.25;color:#4c5850;text-align:right}
  .cz-w.nasz .cz-e{font-size:16px;font-weight:800;color:#16211a}
  .cz-d{display:block;margin-top:3px;font-size:11.5px;font-weight:500;line-height:1.3;color:#a9b3aa}
  .cz-tor{height:clamp(26px,3vw,34px);border-radius:10px;background:rgba(22,33,26,0.055)}
  .cz-b{display:block;height:100%;width:0;border-radius:10px;transition:width 1.1s cubic-bezier(.4,0,.2,1)}
  .cz-w.nasz .cz-b{box-shadow:0 10px 26px -12px rgba(0,205,119,0.7)}
  .cz.on .cz-b{width:var(--w)}
  .cz-v{font-size:clamp(16px,1.9vw,20px);font-weight:750;letter-spacing:-0.022em;line-height:1.1;color:#8b968d;white-space:nowrap}
  .cz-w.nasz .cz-v{font-size:clamp(21px,2.6vw,28px);font-weight:800;color:#0a7a52}
  @media (max-width:760px){
    .cz-w{grid-template-columns:minmax(0,1fr) auto;gap:6px 14px;padding:9px 0}
    .cz-e{grid-column:1 / -1;text-align:left}
    .cz-v{font-size:16px}
    .cz-w.nasz .cz-v{font-size:19px}
  }
  @media (prefers-reduced-motion:reduce){ .cz-b{transition:none;width:var(--w)} }

  /* ---- wykres faz: te same cztery modele, rozbite na trzy odcinki ---- */
  .fz{margin-top:clamp(30px,3.6vw,44px)}
  .fz-w{display:grid;grid-template-columns:220px minmax(0,1fr) 104px;gap:clamp(12px,2vw,24px);align-items:center;padding:clamp(8px,1vw,12px) 0}
  .fz-e{font-size:14px;font-weight:650;line-height:1.25;color:#4c5850}
  .fz-w.nasz .fz-e{font-weight:800;color:#16211a}
  .fz-d{display:block;margin-top:2px;font-size:11.5px;font-weight:500;color:#a9b3aa}
  .fz-pas{display:flex;gap:3px;height:clamp(26px,3vw,34px)}
  .fz-s{display:flex;align-items:center;justify-content:center;height:100%;width:0;border-radius:7px;font-size:11.5px;font-weight:700;color:#ffffff;overflow:hidden;transition:width 1.1s cubic-bezier(.4,0,.2,1)}
  .fz.on .fz-s{width:var(--w)}
  .fz-v{font-size:clamp(15px,1.8vw,18px);font-weight:750;letter-spacing:-0.02em;color:#8b968d;white-space:nowrap}
  .fz-w.nasz .fz-v{font-weight:800;color:#0a7a52}
  .fz-leg{display:flex;flex-wrap:wrap;gap:10px 26px;margin-top:18px;padding-top:16px;border-top:1px solid #dde7db}
  .fz-leg span{display:inline-flex;align-items:center;gap:9px;font-size:13.5px;color:#4c5850}
  .fz-leg i{display:block;width:12px;height:12px;border-radius:4px;flex-shrink:0}
  .fz-pointa{margin:clamp(24px,3vw,34px) 0 0;max-width:820px;font-size:clamp(18px,2.2vw,24px);line-height:1.3;letter-spacing:-0.02em;font-weight:750;color:#16211a;text-wrap:pretty}
  @media (max-width:760px){
    .fz-w{grid-template-columns:minmax(0,1fr) auto;gap:5px 12px}
    .fz-e{grid-column:1 / -1}
    .fz-s{font-size:0}
  }
  @media (prefers-reduced-motion:reduce){ .fz-s{transition:none;width:var(--w)} }

  /* ---- pasek statystyk ---- */
  .staty{display:grid;grid-template-columns:repeat(4,1fr);gap:clamp(18px,2.6vw,40px);max-width:1000px;margin:clamp(34px,4vw,52px) auto 0;padding-top:clamp(26px,3vw,34px);border-top:1px solid #e2e9e0;text-align:left}
  .staty b{display:block;font-size:clamp(28px,4.2vw,44px);font-weight:800;letter-spacing:-0.038em;line-height:1;color:#0a7a52}
  .staty span{display:block;margin-top:9px;font-size:13.5px;line-height:1.4;color:#4c5850;text-wrap:pretty}
  @media (max-width:760px){ .staty{grid-template-columns:1fr 1fr;gap:24px} }

  /* ================= MANIFEST ================= */
  .mf{display:grid;grid-template-columns:78px minmax(0,1.05fr) minmax(0,1fr);gap:clamp(16px,3vw,48px);align-items:baseline;padding:clamp(26px,3.4vw,40px) 0;border-top:1px solid #e2e9e0}
  .mf:last-of-type{border-bottom:1px solid #e2e9e0}
  .mf-n{font-family:ui-monospace,Menlo,monospace;font-size:13px;letter-spacing:0.06em;color:#b3bcb3}
  .mf-t{margin:0;font-size:clamp(24px,3.4vw,40px);line-height:1.06;letter-spacing:-0.032em;font-weight:800;color:#16211a;text-wrap:balance}
  .mf-d{margin:0;font-size:15.5px;line-height:1.62;color:#4c5850;text-wrap:pretty}
  @media (max-width:860px){
    .mf{grid-template-columns:52px minmax(0,1fr);gap:8px 16px;padding:24px 0}
    .mf-d{grid-column:2}
  }

  /* ================= WYKRES C · koszt kolejnej zmiany ================= */
  .kz{display:grid;grid-template-columns:repeat(4,1fr);gap:clamp(14px,3vw,44px);align-items:end;height:clamp(200px,23vw,270px);padding-top:14px}
  .kz-g{display:flex;align-items:flex-end;justify-content:center;gap:clamp(4px,0.8vw,9px);height:100%}
