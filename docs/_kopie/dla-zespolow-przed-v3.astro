// DRZWI B — WERSJA 2 · /guided-coding/dla-zespolow-v2
// Wariant do porównania. Oryginał zostaje bez zmian pod /dla-zespolow.
//
// KIERUNEK (Szymon, 31.08): „skup się na wyciąganiu z AI więcej, mniejszej
// liczbie błędów, szybszych iteracjach, przyspieszeniu pracy — bardziej
// technicznie". Czytelnik to CTO, head of engineering albo tech lead,
// który ma agenty w zespole od kilku miesięcy i nie wie, co z nich wyszło.
//
// TO SAMO CO NA DRZWIACH A: usługa jest abonamentowa, wejście zajmuje jedną
// sekcję, ceny nie podajemy, nazwy części usługi są czasownikami.
//
// CZEGO NIE POWTARZAM ZE STRONY BEZ ZESPOŁU IT (inny słownik wizualny):
// lupa nad przewijającym się kodem, pas dwudziestu dni miesiąca, karty
// przewijane w poziomie, przepływ z jadącą kropką, pary słupków na ciemnym
// pasie. Tutaj: rozkład czasu życia PR-a w hero i bramka przed merge'em
// jako artefakt na ciemnym pasie.
//
// DO POTWIERDZENIA PRZED PUBLIKACJĄ:
// · wszystkie liczby stoją w nawiasach kwadratowych albo są opisane jako
//   przykład — łącznie z rozkładem w hero i metrykami pod bramką;
// · spójność z /guided-coding/dla-zespolow, który obiecuje publikację
//   wyników po domknięciu okna sześciu miesięcy pomiaru;
// · kadencja (dwa spotkania w miesiącu, przegląd metryk raz w miesiącu,
//   odpowiedź tego samego dnia roboczego) to zobowiązanie umowne.
import LaBase from '../../layouts/LaBase.astro';
import GcFaq from '../../components/GcFaq.astro';
import GcCta from '../../components/GcCta.astro';
import TeamAvatar from '../../components/TeamAvatar.astro';
import { zespol } from '../../data/zespol.js';

const kanon = new URL('/guided-coding/dla-zespolow', Astro.site).href;

const title = "Prowadzenie zespołu technicznego — AI w całym cyklu wytwarzania | Let's automate";
const description = 'Większość zespołów używa AI wyłącznie do pisania kodu. Ustawiamy zasady, sprawdzanie i pomiar, żeby weszło w cały cykl: od specyfikacji, przez testy i review, po utrzymanie.';


// ---- KOKPIT PRZEPŁYWU (hero) -------------------------------------------
// Hero pokazuje WYNIK, nie metodę: kokpit, na który patrzy lead, kiedy
// przepływ jest już zmierzony. Diagram cyklu wytwarzania zszedł niżej,
// do sekcji definicyjnej — tam odpowiada na „jak to działa", a nie na
// „co z tego mam".
//
// MIARA PRZEZ CAŁĄ STRONĘ: udział zmian, które wracają z produkcji.
// Kokpit w hero, wykres sześciu miesięcy i sekcja problemów liczą to
// samo. Kokpit pokazuje szósty miesiąc: 96 PR-ów, 3 wracające.
const MIESIACE = [
  { pr: 42, wraca: 9 },
  { pr: 51, wraca: 8 },
  { pr: 63, wraca: 6 },
  { pr: 71, wraca: 5 },
  { pr: 84, wraca: 4 },
  { pr: 96, wraca: 3 },
];
const M6 = MIESIACE[5];
const cfr = (m) => Math.round((m.wraca / m.pr) * 100);

const KOKPIT = [
  { l: '4,2 h', o: 'mediana życia PR-a', t: '−61%' },
  { l: `${cfr(M6)}%`, o: 'zmian wraca z produkcji', t: '−18 pkt' },
  { l: '210', o: 'mediana rozmiaru zmiany', t: 'limit 400' },
];
const KOLEJKA = [
  { t: 'Rozbicie modułu rozliczeń', kto: 'KR', linie: '318', s: 'człowiek', k: 'c' },
  { t: 'Evals dla klasyfikatora zgłoszeń', kto: 'ML', linie: '96', s: 'bramka ok', k: 'o' },
  { t: 'Migracja schematu zamówień', kto: 'AS', linie: '412', s: 'limit', k: 'u' },
  { t: 'Cache listy produktów', kto: 'MK', linie: '74', s: 'bramka ok', k: 'o' },
];
const MENU = ['Przepływ', 'Kolejka review', 'Reguły', 'Metryki'];

// Kursor podjeżdża do pierwszego PR-a i klika — panel ma wyglądać żywo.
const KU = { c: 9, klik: 3.4 };
const kp = (t) => `${((t / KU.c) * 100).toFixed(2)}%`;
const klatkiKursora = [
  `@keyframes ku-lot{0%{left:36%;top:80%;opacity:0}${kp(0.5)}{left:36%;top:80%;opacity:1}${kp(KU.klik - 0.15)}{left:46%;top:268px;opacity:1}${kp(KU.c - 0.6)}{left:46%;top:268px;opacity:1}100%{left:46%;top:268px;opacity:0}}`,
  `@keyframes ku-klik{0%,${kp(KU.klik)}{opacity:0;transform:scale(.2)}${kp(KU.klik + 0.05)}{opacity:.5;transform:scale(.3)}${kp(KU.klik + 0.6)}{opacity:0;transform:scale(1.9)}100%{opacity:0;transform:scale(.2)}}`,
  `@keyframes ku-wiersz{0%,${kp(KU.klik)}{background:transparent}${kp(KU.klik + 0.12)}{background:#eef5ef}${kp(KU.c - 0.5)}{background:#eef5ef}100%{background:transparent}}`,
].join('\n');

// ---- CYKL WYTWARZANIA (sekcja definicyjna) -------------------------------------------
// Teza strony: AI zmienia sposób wytwarzania oprogramowania, a zmiana
// sięga dużo dalej niż pisanie kodu. Rysunek pokazuje to wprost — na
// starcie świeci tylko „kod", potem światło rozchodzi się na oba końce
// cyklu, od specyfikacji po utrzymanie.
//
// Kolejność zapalania idzie od środka na zewnątrz, więc widać rozchodzenie
// się zmiany, a nie kolejny pasek do wypełnienia.
const CYKL = [
  { t: 'specyfikacja', rzad: 3 },
  { t: 'projekt', rzad: 2 },
  { t: 'kod', rzad: 0 },
  { t: 'testy', rzad: 1 },
  { t: 'review', rzad: 2 },
  { t: 'utrzymanie', rzad: 4 },
];
// RUCH: kamera, nie zapalanie. Na starcie kadr stoi na jednym etapie —
// „kod" wypełnia całą scenę, bo tam dziś siedzi AI. Potem kadr odjeżdża
// i dopiero wtedy widać, że ten etap jest kawałkiem większego cyklu.
// To jest dokładnie zdanie z nagłówka, pokazane ruchem: zmiana sięga dalej,
// niż widać z miejsca, w którym stoicie.
const CY = { c: 13, blisko: 2.4, odjazd: 1.9, trzyma: 5.4, zoom: 2.2 };
const cp = (t) => `${((t / CY.c) * 100).toFixed(2)}%`;
const CY_RDZEN = CYKL.findIndex((x) => x.rzad === 0);
const CY_ORIG = `${(((CY_RDZEN + 0.5) / CYKL.length) * 100).toFixed(2)}%`;
const CY_KONIEC = CY.blisko + CY.odjazd;

const klatkiCyklu = [
  `@keyframes cy-kadr{0%,${cp(CY.blisko)}{transform:scale(${CY.zoom})}${cp(CY_KONIEC)}{transform:scale(1)}${cp(CY_KONIEC + CY.trzyma)}{transform:scale(1)}${cp(CY_KONIEC + CY.trzyma + 0.9)}{transform:scale(${CY.zoom})}100%{transform:scale(${CY.zoom})}}`,
  `@keyframes cy-reszta{0%,${cp(CY.blisko + 0.5)}{opacity:0}${cp(CY_KONIEC + 0.25)}{opacity:1}${cp(CY_KONIEC + CY.trzyma)}{opacity:1}${cp(CY_KONIEC + CY.trzyma + 0.5)}{opacity:0}100%{opacity:0}}`,
  `@keyframes cy-linia{0%,${cp(CY.blisko + 0.4)}{opacity:0}${cp(CY_KONIEC + 0.25)}{opacity:1}${cp(CY_KONIEC + CY.trzyma)}{opacity:1}${cp(CY_KONIEC + CY.trzyma + 0.5)}{opacity:0}100%{opacity:0}}`,
  `@keyframes cy-a{0%,${cp(CY.blisko + 0.2)}{opacity:1}${cp(CY.blisko + 0.6)}{opacity:0}${cp(CY_KONIEC + CY.trzyma + 0.6)}{opacity:0}${cp(CY_KONIEC + CY.trzyma + 0.9)}{opacity:1}100%{opacity:1}}`,
  `@keyframes cy-b{0%,${cp(CY_KONIEC - 0.2)}{opacity:0}${cp(CY_KONIEC + 0.3)}{opacity:1}${cp(CY_KONIEC + CY.trzyma)}{opacity:1}${cp(CY_KONIEC + CY.trzyma + 0.4)}{opacity:0}100%{opacity:0}}`,
].join('\n');


