  { n: '02', t: 'Kokpit', d: 'Liczba policzona z jednego źródła, ta sama dla wszystkich działów.' },
  { n: '03', t: 'Odczyt dokumentu', d: 'Model wyciąga pola z faktury, umowy albo listu przewozowego.' },
  { n: '04', t: 'Odpowiedź ze źródłem', d: 'Zdanie z Waszych dokumentów razem ze wskazaniem miejsca.' },
  { n: '05', t: 'Kolejka zatwierdzeń', d: 'Prośba, limit, decyzja i ślad, kto ją podjął i kiedy.' },
  { n: '06', t: 'Widok dla klienta', d: 'Ten sam stan sprawy, pokazany na zewnątrz firmy.' },
];

// ---- CZEGO NIE BUDUJEMY -------------------------------------------------
const GRANICE = [
  {
    t: 'Czatu na stronie, który odpowiada na wszystko',
    d: 'Odpowiada również wtedy, kiedy nie wie. Koszt jednej złej odpowiedzi przy cenie albo terminie bywa większy niż oszczędność na stu dobrych.',
  },
  {
    t: 'Przepisania ERP-a od zera',
    d: 'To projekt na dwa lata, który zwykle kończy się w połowie. Taniej wychodzi zbudować obok to, czego ERP nie umie, i zostawić w nim księgowość.',
  },
  {
    t: 'Agenta, który sam pisze do klientów',
    d: 'Bez akceptacji człowieka pierwsza pomyłka kosztuje więcej niż rok zaoszczędzonego czasu. Projekt odpowiedzi tak, wysyłka po zatwierdzeniu.',
  },
  {
    t: 'Aplikacji zamiast decyzji',
    d: 'Kiedy w firmie nie ustalono, kto zatwierdza rabat, system tego nie rozstrzygnie. Wtedy zaczynamy od reguły, a narzędzie przychodzi po niej.',
  },
];

const PYTANIA_STARTOWE = [
  { t: 'Które przepisywanie zdarza się najczęściej?', d: 'Częstotliwość waży więcej niż czas jednego przebiegu.' },
  { t: 'Co kosztuje najwięcej, kiedy ktoś się pomyli?', d: 'Tam zwrot jest natychmiastowy i łatwy do pokazania.' },
  { t: 'Kto po Waszej stronie to poprowadzi?', d: 'Pozycja bez właściciela nie wchodzi na produkcję.' },
];

// ---- META I DANE STRUKTURALNE ------------------------------------------
const title = "Inspiracje: co da się zbudować z aplikacji i AI w firmie | Let's automate";
const description = `Katalog ${N} pomysłów na aplikacje wewnętrzne, agentów AI, automatyzacje i raporty — z ośmiu obszarów firmy. Przy każdym stoi ta sama miara: ile tygodni do pierwszego uruchomienia.`;

const dane = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${kanon}#strona`,
      url: kanon,
      name: 'Inspiracje — co da się zbudować z aplikacji i AI',
      description,
      isPartOf: { '@id': new URL('/', Astro.site).href },
      about: { '@id': new URL('/#organizacja', Astro.site).href },
    },
    {
      '@type': 'ItemList',
      '@id': `${kanon}#katalog`,
      name: 'Katalog pomysłów na aplikacje wewnętrzne i rozwiązania AI',
      numberOfItems: N,
      itemListOrder: 'https://schema.org/ItemListOrderAscending',
      itemListElement: POMYSLY.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: p.t,
        description: `${p.d}. Obszar: ${p.on}. Rodzaj: ${RODZ[p.r].t}. Czas do pierwszego uruchomienia: około ${p.w} ${odm(p.w, ['tygodnia', 'tygodni', 'tygodni'])}.`,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${kanon}#okruszki`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Strona główna', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: 'Inspiracje', item: kanon },
      ],
    },
  ],
};

const faq = [
  {
    q: 'Skąd bierze się liczba tygodni przy każdej pozycji?',
    a: 'To czas od decyzji do pierwszego uruchomienia na produkcji, wzięty z naszych wdrożeń podobnych rzeczy. Obejmuje także czekanie na Was — na dostępy, na przykładowe dokumenty i na rozstrzygnięcie, kto zatwierdza. Przy wycenie liczba jest policzona dla Waszego przypadku i wchodzi do umowy razem z zakresem. Pozycje z tego katalogu mieszczą się między jednym tygodniem a dziesięcioma; wszystko dłuższe nazywamy projektem i mówimy o tym wprost.',
  },
  {
    q: 'Czy do wszystkiego potrzebny jest model AI?',
    a: `Nie. Z ${N} pozycji ${ILE_AI} opiera się na modelu językowym — to te, w których trzeba coś przeczytać ze zdania albo z dokumentu. Reszta to zwykłe aplikacje, połączenia między systemami i raporty. Model dokładamy tam, gdzie czytanie tekstu jest wąskim gardłem procesu.`,
  },
  {
    q: 'Da się połączyć kilka pozycji w jedną aplikację?',
    a: 'Tak i zwykle tak to wygląda. Pozycje z jednego obszaru dzielą te same elementy — rejestr, formularz, kolejkę zatwierdzeń — więc druga i trzecia rzecz w tym samym miejscu kosztują wyraźnie mniej niż pierwsza. Ostrzegamy przed odwrotną kolejnością: pięć pozycji ruszonych naraz kończy się tym, że żadna nie wchodzi na produkcję.',
  },
  {
    q: 'Ile to kosztuje?',
    a: 'Cena idzie za wagą i za liczbą wyjątków. Największy wpływ mają trzy rzeczy: ile systemów trzeba dotknąć, ile przypadków szczególnych ma Wasz proces i czy dane są już w jednym miejscu. Widełki podajemy po pierwszej rozmowie, na której przechodzimy jedną pozycję do końca. Nie mamy prowizji od żadnego dostawcy, więc wybór narzędzia nie zmienia naszego przychodu.',
  },
  {
    q: 'Mamy pomysł, którego nie ma w katalogu',
    a: 'Tak zaczyna się większość wdrożeń. Katalog pokazuje kształty rzeczy, które budujemy najczęściej — prawie każda pozycja składa się z sześciu elementów opisanych wyżej, za każdym razem w innej kombinacji. Napiszcie, na czym schodzi czas u Was, a odpowiemy, z czego to się składa i ile waży.',
  },
  {
    q: 'Nie mamy działu IT. To wyklucza połowę katalogu?',
    a: 'Nie. Wymaga natomiast osoby po Waszej stronie, która zna proces i ma prawo rozstrzygnąć wątpliwość — to zwykle kierownik działu. Dostępy do systemów ustawiamy z Waszym dostawcą IT. Firmom bez własnego działu IT poświęcona jest osobna strona: <a href="/guided-coding/bez-dzialu-it" style="font-weight:700;color:#0a7a52">budowanie aplikacji bez działu IT</a>.',
  },
  {
    q: 'Kto to utrzyma za rok?',
    a: 'Repozytorium, klucze i dostępy są Wasze od pierwszego dnia, więc utrzymanie może przejąć Wasz zespół albo inny dostawca. Kiedy utrzymujemy my, umowa jest osobna od budowy i wypowiadalna z miesięcznym terminem. Jeśli chcecie budować sami, tym zajmuje się <a href="/guided-coding" style="font-weight:700;color:#0a7a52">Guided Coding</a> — kod pisze Wasz zespół, my pilnujemy jakości.',
  },
  {
    q: 'Jest ich kilkanaście i nie wiadomo, od której zacząć',
    a: 'Pierwsza rozmowa zwykle to rozstrzyga: bierzemy Waszą listę i szeregujemy ją po tym, jak często coś się zdarza i ile kosztuje jedna pomyłka. Kiedy lista jest długa, a różnice między pozycjami niejasne, właściwą usługą jest <a href="/strategia-ai" style="font-weight:700;color:#0a7a52">strategia transformacji AI</a> — dokument z kolejnością i policzonym zwrotem.',
  },
];
dane['@graph'].push({
  '@type': 'FAQPage',
  '@id': `${kanon}#faq`,
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
  })),
});
---
<LaBase title={title} description={description} ctaHref="#kontakt" ctaLabel="Umów rozmowę" nav="inspiracje">
<script type="application/ld+json" is:inline set:html={JSON.stringify(dane)} slot="head"></script>
<style is:global slot="head">
  /* ================= HERO — rozkład wagi katalogu =================
     Jeden klocek = jedna pozycja z katalogu, ustawiona nad swoją liczbą
     tygodni. Rysunek jest zarazem spisem treści: najazd kursorem nazywa
     pozycję po imieniu, kliknięcie filtruje katalog do jej obszaru.
     Świadome odstępstwo od reszty serwisu: hero wypełnia się raz i zostaje,
     bo to przyrząd, a nie pętla. */
  .hg-wrap{--sq:clamp(9px,1.05vw,14px);max-width:760px}
  .hg{display:flex;align-items:flex-end;gap:7px;min-height:calc(var(--hgn) * (var(--sq) + 3px))}
  .hg-col{flex:1;display:flex;flex-direction:column-reverse;gap:3px;cursor:pointer}
  .hg-sq{display:block;height:var(--sq);border-radius:2px;background:#dde8d8;opacity:0;transform-origin:bottom;transition:background .16s,transform .16s}
  .hg-sq.on{background:var(--la-accent,#00CD77) !important;transform:scaleX(1.06)}
  .hg-os{display:flex;gap:7px;margin-top:11px}
  .hg-os span{flex:1;text-align:center;font-family:ui-monospace,Menlo,monospace;font-size:11px;color:#a3aea4}
  .hg-klamra{position:relative;height:26px;margin-top:2px}
  .hg-klamra i{position:absolute;left:0;top:0;width:calc(30% - 5px);height:7px;border-left:1px solid #b6c6b4;border-right:1px solid #b6c6b4;border-bottom:1px solid #b6c6b4;border-radius:0 0 3px 3px;opacity:0}
  .hg-klamra b{position:absolute;left:0;top:11px;width:calc(30% - 5px);text-align:center;font-size:12px;font-weight:650;color:#0a7a52;opacity:0}
  .hg-jedn{margin:16px 0 0;font-size:12.5px;color:#a3aea4}
  .hg-pod{display:block;margin-top:9px;min-height:46px;font-size:15px;line-height:1.45;color:#4c5850;text-wrap:pretty}
  .hg-pod b{display:block;font-size:16.5px;font-weight:750;letter-spacing:-0.014em;color:#16211a}
  .hg-pod em{font-style:normal;color:#8b968d}
  .hg-pod .hg-hint{color:#a3aea4}
  @media (max-width:900px){ .hg-wrap{--sq:clamp(8px,2.2vw,13px);max-width:none} }
  @media (max-width:560px){ .hg{gap:4px} .hg-os{gap:4px} .hg-os span{font-size:9.5px} .hg-klamra i,.hg-klamra b{width:calc(30% - 3px)} }
  @media (prefers-reduced-motion:reduce){
    .hg-sq{animation:none !important;opacity:1;transform:none}
    .hg-sq.masa{background:#a9dbc2}
    .hg-klamra i,.hg-klamra b{animation:none !important;opacity:1}
  }

  /* ================= teza ================= */
  .tz{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:clamp(28px,5vw,80px);align-items:start;margin-top:clamp(46px,6vw,78px);padding-top:clamp(34px,4vw,48px);border-top:1px solid #e7ece4}
  .tz-duze{margin:0;font-size:clamp(21px,2.7vw,31px);line-height:1.28;letter-spacing:-0.022em;font-weight:750;color:#16211a;text-wrap:pretty}
  .tz-duze span{color:#8b968d}
  .tz-r{display:grid;grid-template-columns:auto minmax(0,1fr);gap:9px 14px;padding:11px 0;border-top:1px solid #eef2ec;align-items:baseline}
  .tz-r:first-of-type{border-top:0;padding-top:0}
  .tz-r b{font-size:14px;font-weight:750;color:#16211a;white-space:nowrap}
  .tz-r span{font-size:13.5px;line-height:1.5;color:#8b968d}
  .tz-r i{font-style:normal;font-family:ui-monospace,Menlo,monospace;font-size:11.5px;color:#a3aea4}
  @media (max-width:860px){ .tz{grid-template-columns:1fr;gap:32px} }

  /* ================= obszary =================
     Osiem wierszy na liniach, nie osiem równych kafli: numer pozycji, nazwa
     w dużym stopniu, stan zastany obok, waga najlżejszej i najcięższej rzeczy
     w obszarze po prawej. Kliknięcie ustawia filtr w katalogu. */
  .ob{margin-top:clamp(28px,3.6vw,42px)}
  .ob-r{position:relative;display:grid;grid-template-columns:minmax(0,0.72fr) minmax(0,1.16fr) 140px;gap:clamp(14px,2.6vw,44px);align-items:center;padding:clamp(17px,2.1vw,25px) 0;border-top:1px solid #dde7db;transition:background .18s}
  .ob-r:last-of-type{border-bottom:1px solid #dde7db}
  .ob-r:hover{background:rgba(10,122,82,0.045)}
  .ob-t{display:flex;align-items:baseline;gap:12px;margin:0;font-size:clamp(19px,2.5vw,27px);font-weight:800;letter-spacing:-0.026em;line-height:1.1;color:#16211a;text-wrap:balance}
  .ob-t a{transition:color .16s}
  .ob-t a::after{content:"";position:absolute;inset:0}
  .ob-r:hover .ob-t a{color:#0a7a52}
  .ob-n{flex-shrink:0;font-family:ui-monospace,Menlo,monospace;font-size:12px;font-weight:400;letter-spacing:0;color:#b6c6b4}
  .ob-d{margin:0;font-size:14.5px;line-height:1.55;color:#6d7a71;text-wrap:pretty}
  .ob-w{display:flex;flex-direction:column;align-items:flex-end;gap:3px;text-align:right}
  .ob-w1{display:flex;align-items:baseline;gap:6px;font-size:14px;color:#8b968d}
  .ob-w1 em{font-style:normal;font-size:clamp(24px,2.8vw,32px);font-weight:800;letter-spacing:-0.03em;line-height:1;color:#16211a}
  .ob-w2{font-size:11.5px;line-height:1.3;color:#a3aea4;white-space:nowrap}
  @media (max-width:1000px){
    .ob-r{grid-template-columns:minmax(0,1fr) 124px}
    .ob-d{grid-column:1;grid-row:2}
    .ob-w{grid-column:2;grid-row:1/3;justify-content:center}
  }
  @media (max-width:520px){ .ob-r{gap:8px 14px} .ob-d{font-size:13.5px} .ob-w2{font-size:10.5px} }

  /* ================= katalog =================
     Indeks, nie ściana kafli: dwie kolumny wierszy na liniach, zgrupowane
     obszarami. Pasek wagi przy każdej pozycji jest w tej samej skali,
     co kolumny w hero — to ta sama miara widziana drugi raz. */
  .kt-bar{position:sticky;top:74px;z-index:20;background:#ffffff;padding:15px 0 13px;margin-bottom:6px;border-bottom:1px solid #e7ece4}
  .kt-bar.stuck{padding:9px 0 8px;box-shadow:0 16px 26px -24px rgba(18,38,28,0.5)}
  .kt-gora{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px 28px}
  .kt-szuk{display:flex;align-items:center;gap:9px;flex:1;min-width:220px;max-width:420px;padding-bottom:7px;border-bottom:1.5px solid #16211a}
  .kt-szuk input{flex:1;min-width:0;border:0;background:transparent;outline:none;font-family:inherit;font-size:clamp(16px,1.9vw,19px);font-weight:650;letter-spacing:-0.015em;color:#16211a}
  .kt-szuk input::-webkit-search-cancel-button{-webkit-appearance:none}
  .kt-licz{font-size:14px;color:#8b968d;white-space:nowrap}
  .kt-licz b{font-family:ui-monospace,Menlo,monospace;font-size:15px;color:#16211a}
  .kt-linie{margin-top:12px;display:flex;flex-direction:column;gap:5px}
  .kt-bar.stuck .kt-linie{margin-top:8px}
  .kt-l{display:grid;grid-template-columns:64px minmax(0,1fr);gap:4px 14px;align-items:baseline}
  .kt-lab{font-size:11.5px;color:#a3aea4}
  .kt-opts{display:flex;flex-wrap:wrap;gap:2px 4px}
  .kt-opt{position:relative;appearance:none;border:0;background:none;font-family:inherit;font-size:13.5px;color:#6d7a71;padding:3px 8px;border-radius:7px;cursor:pointer;transition:color .14s,background .14s,box-shadow .14s}
  .kt-opt:hover{color:#0a7a52;background:rgba(10,122,82,0.07)}
  .kt-opt.on{color:#16211a;font-weight:700}
  .kt-opt.on::after{content:"";position:absolute;left:8px;right:8px;bottom:0;height:2px;border-radius:2px;background:var(--la-accent,#00CD77)}
  .kt-route{margin:11px 0 0;font-size:13.5px;color:#6d7a71}
  .kt-route a{font-weight:700;color:#0a7a52}
  .kt-grp{margin-top:clamp(30px,3.4vw,46px)}
  .kt-grp[hidden]{display:none !important}
  .kt-ghead{display:flex;align-items:baseline;justify-content:space-between;gap:16px;padding-bottom:9px;border-bottom:2px solid #16211a}
  .kt-ghead h3{margin:0;font-size:clamp(18px,2.1vw,23px);font-weight:800;letter-spacing:-0.024em;color:#16211a}
  .kt-ghead span{font-family:ui-monospace,Menlo,monospace;font-size:11.5px;color:#8b968d;white-space:nowrap}
  .kt-lista{display:grid;grid-template-columns:1fr 1fr;gap:0 clamp(26px,4vw,64px)}
  .kt-it{display:grid;grid-template-columns:minmax(0,1fr) 96px;gap:3px 16px;padding:13px 0;border-top:1px solid #ebf0e8;align-items:baseline}
  .kt-it[hidden]{display:none !important}
  .kt-t{grid-column:1;font-size:15.5px;font-weight:700;letter-spacing:-0.013em;line-height:1.3;color:#16211a;text-wrap:balance}
  .kt-d{grid-column:1;font-size:12.5px;line-height:1.45;color:#8b968d;text-wrap:pretty}
  .kt-meta{grid-column:2;grid-row:1/3;display:flex;flex-direction:column;align-items:flex-end;gap:6px;padding-top:2px}
  .kt-r{font-size:11.5px;line-height:1;color:#a3aea4;white-space:nowrap}
  .kt-para{display:flex;align-items:center;gap:8px}
  .kt-w{display:block;width:44px;height:3px;border-radius:2px;background:#e9eee6;overflow:hidden}
  .kt-w i{display:block;height:100%;border-radius:2px;background:#7fd0ab}
  .kt-wn{font-family:ui-monospace,Menlo,monospace;font-size:11px;color:#8b968d;white-space:nowrap}
  .kt-pusto{margin:36px 0 0;font-size:17px;color:#4c5850}
  .kt-pusto a{font-weight:700;color:#0a7a52}
  .kt-nota{margin:clamp(30px,3.4vw,44px) 0 0;font-size:13.5px;line-height:1.6;color:#a3aea4;max-width:720px;text-wrap:pretty}
  @media (max-width:900px){ .kt-lista{grid-template-columns:1fr} .kt-bar{top:12px} }
  @media (max-width:560px){ .kt-l{grid-template-columns:1fr;gap:1px} .kt-opt{padding:3px 7px;font-size:13px} }

  /* ================= trzy poziomy (ciemny pas) =================
     Zagnieżdżenie: ramka poziomu trzeciego zawiera drugą, druga pierwszą.
     Rysunek niesie zdanie, którego nie ma w tekście — wyższy poziom stoi
     na poprzednim, więc wejście na niego nie zaczyna od pustej strony. */
  .pz{display:grid;grid-template-columns:minmax(0,1.12fr) minmax(280px,0.88fr);gap:clamp(30px,5vw,74px);align-items:start;margin-top:clamp(30px,3.6vw,46px)}
  .pz-ramka{position:relative;padding:clamp(15px,1.7vw,21px);border:1px solid rgba(255,255,255,0.2);border-radius:16px}
  .pz-ramka.p2{border-color:rgba(255,255,255,0.3)}
  .pz-ramka.p1{border-color:var(--la-accent,#00CD77);background:rgba(0,205,119,0.09)}
  .pz-g{display:flex;align-items:baseline;justify-content:space-between;gap:14px;flex-wrap:wrap}
  .pz-t{margin:0;font-size:clamp(16px,1.9vw,20px);font-weight:750;letter-spacing:-0.018em;color:#ffffff}
  .pz-t em{font-style:normal;font-family:ui-monospace,Menlo,monospace;font-size:11.5px;font-weight:400;letter-spacing:0.06em;color:rgba(255,255,255,0.4);margin-right:9px}
  .pz-w{font-family:ui-monospace,Menlo,monospace;font-size:12px;color:rgba(255,255,255,0.5);white-space:nowrap}
  .pz-ramka.p1 .pz-w{color:var(--la-accent,#00CD77)}
  .pz-d{margin:9px 0 0;font-size:14px;line-height:1.55;color:rgba(255,255,255,0.72);text-wrap:pretty}
  .pz-ramka.p1 .pz-d{color:rgba(255,255,255,0.85)}
  .pz-in{margin-top:clamp(14px,1.6vw,19px)}
  .pz-k{margin-top:clamp(22px,2.6vw,32px)}
  .pz-kr{padding:14px 0;border-top:1px solid rgba(255,255,255,0.14)}
  .pz-kr:first-of-type{border-top:0;padding-top:0}
  .pz-kr b{display:block;font-family:ui-monospace,Menlo,monospace;font-size:11px;letter-spacing:0.1em;color:rgba(255,255,255,0.4)}
