<style is:inline set:html={klatkiHero}></style>

<script>
  // ---- HERO: obchód po katalogu ----------------------------------------
  // Rysunek wypełnia się raz i zostaje. Po wypełnieniu co 2,4 s zapala się
  // inna pozycja i jej nazwa staje w podpisie — to jest cały mechanizm
  // inspiracji na tej stronie. Najazd kursorem przejmuje obchód, zejście
  // z rysunku go wznawia, kliknięcie otwiera obszar pozycji w katalogu.
  (function(){
    var hg = document.getElementById('hg');
    var tyt = document.getElementById('hgt');
    var met = document.getElementById('hgm');
    if(!hg || !tyt || !met) return;
    var sq = [].slice.call(hg.querySelectorAll('.hg-sq'));
    if(!sq.length) return;
    var bezRuchu = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var akt = null, zegar = null, i = 0;
    var n = sq.length;
    // Krok 23 jest względnie pierwszy z 64, więc obchód odwiedza każdą
    // pozycję dokładnie raz i skacze między obszarami zamiast iść działami.
    var KROK = 23;

    function pokaz(el){
      if(akt === el) return;
      if(akt) akt.classList.remove('on');
      akt = el;
      el.classList.add('on');
      tyt.textContent = el.getAttribute('data-t');
      met.classList.remove('hg-hint');
      met.textContent = el.getAttribute('data-o') + ' · ' + el.getAttribute('data-r') + ' · ' + el.getAttribute('data-w');
    }
    function krok(){ pokaz(sq[(i * KROK) % n]); i++; }
    function start(){ if(bezRuchu || zegar) return; zegar = setInterval(krok, 2400); }
    function stop(){ if(zegar){ clearInterval(zegar); zegar = null; } }

    sq.forEach(function(el){
      el.addEventListener('mouseenter', function(){ stop(); pokaz(el); });
      el.addEventListener('click', function(){
        var b = document.querySelector('.kt-opts[data-grp="o"] .kt-opt[data-v="' + el.getAttribute('data-ok') + '"]');
        if(b) b.click();
        var sek = document.getElementById('katalog');
        if(sek) sek.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
    hg.addEventListener('mouseleave', start);

    if(!bezRuchu){
      setTimeout(function(){ krok(); start(); }, parseInt(hg.getAttribute('data-po'), 10) || 5000);
    }
  })();

  // ---- KATALOG: filtry i wyszukiwarka ----------------------------------
  (function(){
    var pole = document.getElementById('ktq');
    var licznik = document.getElementById('ktn');
    var pusto = document.getElementById('ktpusto');
    var trasa = document.getElementById('ktroute');
    var poz = [].slice.call(document.querySelectorAll('.kt-it'));
    var grupy = [].slice.call(document.querySelectorAll('.kt-grp'));
    if(!poz.length) return;

    var stan = { o: '', r: '', w: '', q: '' };

    function odm(n, a, b, c){
      var d = n % 10, s = n % 100;
      if(n === 1) return a;
      if(d >= 2 && d <= 4 && !(s >= 12 && s <= 14)) return b;
      return c;
    }
    function bezOgonkow(s){
      return s.toLowerCase().replace(/ł/g, 'l').normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    }
    function pasuje(el){
      if(stan.o && el.getAttribute('data-o') !== stan.o) return false;
      if(stan.r && el.getAttribute('data-r') !== stan.r) return false;
      if(stan.w){
        var w = parseInt(el.getAttribute('data-w'), 10);
        var z = stan.w.split('-');
        if(w < +z[0] || w > +z[1]) return false;
      }
      if(stan.q && el.getAttribute('data-s').indexOf(stan.q) < 0) return false;
      return true;
    }
    function odswiez(){
      var suma = 0;
      poz.forEach(function(el){
        var ok = pasuje(el);
        el.hidden = !ok;
        if(ok) suma++;
      });
      grupy.forEach(function(g){
        var widoczne = [].slice.call(g.querySelectorAll('.kt-it')).filter(function(el){ return !el.hidden; }).length;
        g.hidden = widoczne === 0;
        var c = g.querySelector('.kt-gcount');
        if(c) c.textContent = widoczne + ' ' + odm(widoczne, 'pozycja', 'pozycje', 'pozycji');
      });
      licznik.textContent = suma;
      pusto.hidden = suma > 0;
    }

    document.querySelectorAll('.kt-opts').forEach(function(grp){
      var klucz = grp.getAttribute('data-grp');
      grp.querySelectorAll('.kt-opt').forEach(function(b){
        b.addEventListener('click', function(){
          grp.querySelectorAll('.kt-opt').forEach(function(x){ x.classList.remove('on'); });
          b.classList.add('on');
          stan[klucz] = b.getAttribute('data-v');
          if(klucz === 'r'){
            var h = b.getAttribute('data-h');
            if(h){
              trasa.innerHTML = 'Pozycje tego rodzaju budujemy jako <a href="' + h + '">' + b.getAttribute('data-ht') + '</a> →';
              trasa.hidden = false;
            } else {
              trasa.hidden = true;
            }
          }
          odswiez();
        });
      });
    });

    if(pole){
      pole.addEventListener('input', function(){
        stan.q = bezOgonkow(pole.value.trim());
        odswiez();
      });
    }

    // Wiersze obszarów nad katalogiem ustawiają filtr i przewijają do listy.
    document.querySelectorAll('[data-goto]').forEach(function(b){
      b.addEventListener('click', function(e){
        e.preventDefault();
        var cel = document.querySelector('.kt-opts[data-grp="o"] .kt-opt[data-v="' + b.getAttribute('data-goto') + '"]');
        if(cel) cel.click();
        var sek = document.getElementById('katalog');
        if(sek) sek.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    // Pasek filtrów chudnie, kiedy przyklei się pod nawigacją.
    var wartownik = document.getElementById('kt-sentinel');
    var pasek = document.getElementById('ktbar');
    if(wartownik && pasek && 'IntersectionObserver' in window){
      new IntersectionObserver(function(w){
        pasek.classList.toggle('stuck', !w[0].isIntersecting);
      }, { rootMargin: '-86px 0px 0px 0px' }).observe(wartownik);
    }
  })();
</script>

