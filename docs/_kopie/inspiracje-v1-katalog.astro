// Płaska lista z indeksem — indeks jest identyfikatorem klocka w hero.
const POMYSLY = KATALOG.flatMap((g) => g.p.map((x) => ({ ...x, ok: g.k, on: g.t })));
POMYSLY.forEach((p, i) => {
  p.i = i;
  p.szukaj = bezOgonkow(`${p.t} ${p.d} ${p.on} ${RODZ[p.r].t}`);
});

const N = POMYSLY.length;
const MAX_W = Math.max(...POMYSLY.map((p) => p.w));
const PROG = 3;                                    // granica „szybkich" pozycji
const SZYBKIE = POMYSLY.filter((p) => p.w <= PROG).length;
KATALOG.forEach((g) => { g.szybkie = g.p.filter((x) => x.w <= PROG).length; });
const ILE_AI = POMYSLY.filter((p) => p.r === 'agent').length;
const KOLUMNY = Array.from({ length: MAX_W }, (_, i) => POMYSLY.filter((p) => p.w === i + 1));
const NAJWYZSZA = Math.max(...KOLUMNY.map((c) => c.length));

// ---- HERO: wypełnianie klocków -----------------------------------------
// Kolumny wchodzą od lewej, klocek po klocku. Wszystkie opóźnienia liczone
// z danych: zmiana wagi jednej pozycji przestawia rysunek i czas jego wejścia.
const HG_START = 0.35;      // pierwszy klocek
const HG_KOL = 0.3;         // odstęp między kolumnami
const HG_KLO = 0.045;       // odstęp między klockami w kolumnie
const HG_KONIEC = HG_START + (MAX_W - 1) * HG_KOL + (KOLUMNY[MAX_W - 1].length - 1) * HG_KLO + 0.5;
const HG_MASA = HG_KONIEC + 0.35;   // podświetlenie pierwszych trzech kolumn
const HG_KLAMRA = HG_MASA + 0.2;    // klamra z liczbą pod nimi

