const kanon = new URL('/inspiracje', Astro.site).href;

// Odmiana liczebnika — używana wszędzie, gdzie liczba jest liczona z danych,
// żeby zmiana katalogu nie zostawiła w tekście błędu gramatycznego.
const odm = (n, [a, b, c]) => {
  const d = n % 10;
  const s = n % 100;
  if (n === 1) return a;
  if (d >= 2 && d <= 4 && !(s >= 12 && s <= 14)) return b;
  return c;
};

// Tekst do wyszukiwarki: bez ogonków i bez wielkich liter, żeby „faktury"
// znajdowało „Faktury kosztowe", a „grafik" — „Grafik zmian".
const bezOgonkow = (s) =>
  s.toLowerCase().replace(/ł/g, 'l').normalize('NFD').replace(/[\u0300-\u036f]/g, '');

