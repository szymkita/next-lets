  .kl-i.szer{grid-column:span 2}
  .kl-ui{background:#ffffff;border-radius:13px;box-shadow:0 20px 40px -30px rgba(18,38,28,0.4),0 0 0 1px rgba(18,38,28,0.055);padding:15px 16px;flex:1;min-height:132px;display:flex;flex-direction:column;justify-content:center}
  .kl-p{display:flex;align-items:baseline;gap:10px;margin:13px 0 0}
  .kl-n{font-family:ui-monospace,Menlo,monospace;font-size:11px;color:#b6c6b4;flex-shrink:0}
  .kl-p b{font-size:15.5px;font-weight:750;letter-spacing:-0.014em;color:#16211a}
  .kl-p span{display:block;margin-top:3px;font-size:13px;line-height:1.5;color:#7c877e;text-wrap:pretty}
  /* rejestr */
  .u-tab{display:grid;grid-template-columns:56px minmax(0,1fr) 78px;gap:0 12px;font-size:12px}
  .u-th{padding:0 0 7px;font-family:ui-monospace,Menlo,monospace;font-size:9.5px;letter-spacing:0.08em;color:#b0bbb1;border-bottom:1px solid #eef2ec}
  .u-td{padding:9px 0;border-bottom:1px solid #f2f5f0;color:#4c5850;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .u-td.mono{font-family:ui-monospace,Menlo,monospace;font-size:11px;color:#8b968d}
  .u-st{display:inline-flex;align-items:center;gap:6px;font-size:11.5px;color:#4c5850}
  .u-st i{width:6px;height:6px;border-radius:50%;background:#d5dcd3;flex-shrink:0}
  .u-st.ok i{background:var(--la-accent,#00CD77)}
  .u-st.cz i{background:#e0a854}
  .u-row-hi .u-td{background:#f4faf6}
  /* kokpit */
  .u-kok{display:flex;align-items:flex-end;justify-content:space-between;gap:16px}
  .u-duza{font-size:38px;font-weight:800;letter-spacing:-0.035em;line-height:1;color:#16211a}
  .u-kap{margin-top:5px;font-size:11.5px;color:#8b968d}
  .u-delta{font-size:12px;font-weight:700;color:#0a7a52}
  .u-slup{display:flex;align-items:flex-end;gap:4px;height:44px}
  .u-slup i{width:7px;border-radius:2px;background:#dfe9dc}
  .u-slup i:last-child{background:var(--la-accent,#00CD77)}
  /* odczyt dokumentu */
  .u-doc{display:grid;grid-template-columns:58px minmax(0,1fr);gap:14px;align-items:center}
  .u-kartka{padding:9px 8px;border-radius:5px;background:#f6f9f5;box-shadow:inset 0 0 0 1px #e7ece4}
  .u-kartka i{display:block;height:3px;border-radius:2px;background:#dde6da;margin-bottom:5px}
  .u-kartka i:nth-child(1){width:70%}
  .u-kartka i:nth-child(3){width:88%}
  .u-kartka i:nth-child(4){width:52%}
  .u-kartka i:last-child{margin-bottom:0;width:76%}
  .u-pole{display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid #f2f5f0;font-size:12px}
  .u-pole:last-child{border-bottom:0}
  .u-pole span{color:#a3aea4;width:76px;font-size:11px;flex-shrink:0}
  .u-pole b{font-weight:650;color:#16211a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .u-pole svg{margin-left:auto;flex-shrink:0}
  /* odpowiedź ze źródłem */
  .u-q{font-size:12.5px;font-weight:650;color:#16211a}
  .u-a{margin:8px 0 0;font-size:12.5px;line-height:1.5;color:#4c5850}
  .u-zr{display:inline-flex;align-items:center;gap:7px;margin-top:10px;padding:5px 9px;border-radius:7px;background:#eef6f0;font-size:11px;color:#0a7a52}
  /* kolejka zatwierdzeń */
  .u-wn{font-size:12.5px;color:#4c5850}
  .u-wn b{display:block;font-size:14px;font-weight:750;color:#16211a;margin-bottom:3px}
  .u-lim{display:flex;align-items:center;gap:8px;margin:11px 0 12px;font-size:11px;color:#8b968d}
  .u-lim span{flex:1;height:4px;border-radius:2px;background:#eef2ec;overflow:hidden}
  .u-lim span i{display:block;width:72%;height:100%;background:#e0a854;border-radius:2px}
  .u-btn{display:flex;gap:7px}
  .u-btn i{font-style:normal;font-size:11.5px;font-weight:650;padding:6px 12px;border-radius:7px}
  .u-btn i:first-child{background:#16211a;color:#fff}
  .u-btn i:last-child{background:#f2f5f0;color:#7c877e}
  /* widok dla klienta */
  .u-tor{display:flex;align-items:center;gap:0;margin:6px 0 0}
  .u-krok{flex:1;display:flex;flex-direction:column;align-items:center;gap:8px;position:relative}
  .u-krok:before{content:"";position:absolute;top:6px;left:-50%;width:100%;height:2px;background:#e9eee6}
  .u-krok:first-child:before{display:none}
  .u-krok.done:before,.u-krok.teraz:before{background:var(--la-accent,#00CD77)}
  .u-kropka{position:relative;width:13px;height:13px;border-radius:50%;background:#e9eee6}
  .u-krok.done .u-kropka{background:var(--la-accent,#00CD77)}
  .u-krok.teraz .u-kropka{background:#ffffff;box-shadow:0 0 0 3px var(--la-accent,#00CD77)}
  .u-krok b{font-size:11px;font-weight:650;color:#4c5850;text-align:center;line-height:1.3}
  .u-krok.pusty b{color:#b0bbb1;font-weight:500}
  @media (max-width:900px){ .kl{grid-template-columns:repeat(2,minmax(0,1fr))} .kl-i.szer{grid-column:span 2} }
  @media (max-width:600px){ .kl{grid-template-columns:1fr} .kl-i.szer{grid-column:span 1} }

  /* ================= granice + start ================= */
  .gr{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:0 clamp(28px,4vw,64px);margin-top:clamp(26px,3vw,38px)}
  .gr-i{padding:clamp(18px,2.2vw,26px) 0;border-top:1px solid #e2e9e0}
  .gr-i h3{margin:0;font-size:clamp(16px,1.9vw,19px);font-weight:750;letter-spacing:-0.016em;line-height:1.3;color:#16211a;text-wrap:balance}
  .gr-i p{margin:8px 0 0;font-size:14.5px;line-height:1.6;color:#4c5850;text-wrap:pretty}
  .st{margin:clamp(40px,5vw,64px) 0 0 clamp(0px,5vw,86px);padding-left:clamp(18px,2vw,26px);border-left:2px solid var(--la-accent,#00CD77);max-width:820px}
  .st h3{margin:0;font-size:clamp(17px,2vw,21px);font-weight:750;letter-spacing:-0.018em;color:#16211a}
  .st-r{display:grid;grid-template-columns:minmax(0,0.92fr) minmax(0,1fr);gap:6px clamp(18px,2.6vw,40px);padding:13px 0;border-top:1px solid #e7ece4;align-items:baseline}
  .st-r:first-of-type{margin-top:16px}
  .st-r b{font-size:15px;font-weight:700;letter-spacing:-0.012em;color:#16211a;text-wrap:balance}
  .st-r span{font-size:13.5px;line-height:1.5;color:#8b968d;text-wrap:pretty}
  @media (max-width:820px){ .gr{grid-template-columns:1fr} .st-r{grid-template-columns:1fr;gap:3px} }

  @media (max-width:900px){
    .ins-hero-split{grid-template-columns:1fr !important;gap:clamp(28px,5vw,44px) !important}
  }
</style>

<!-- ============ 1 · HERO ============
     Nagłówek pełną szerokością, pod nim podział na zdanie wprowadzające
     i rysunek — inny szkielet niż hero-split z sześciu podstron usługowych.
     Rysunek to rozkład wagi całego katalogu: jeden klocek jest jedną pozycją,
     stoi nad swoją liczbą tygodni i zna swoją nazwę. -->
<div aria-hidden="true" style="position:absolute;left:0;right:0;top:0;height:1120px;background:radial-gradient(1000px 620px at 78% 0%, rgba(0,205,119,0.14), transparent 62%);pointer-events:none"></div>
<section style="position:relative;overflow:hidden;padding:clamp(26px,3.6vw,48px) max(clamp(20px,5vw,56px),calc((100% - 1440px) / 2)) clamp(52px,6vw,78px)">
<h1 style="margin:0;max-width:1080px;font-size:clamp(31px,5.3vw,62px);line-height:1.03;letter-spacing:-0.035em;font-weight:800;color:#16211a;text-wrap:balance">Aplikacje i rozwiązania AI, które da się zbudować w Waszej firmie</h1>

<div class="ins-hero-split" style="display:grid;grid-template-columns:minmax(0,0.72fr) minmax(0,1.15fr);gap:clamp(30px,5vw,80px);align-items:center;margin-top:clamp(30px,4vw,52px)">
<div>
<p style="margin:0;max-width:520px;font-size:clamp(16px,2.05vw,19px);line-height:1.6;color:#33413a;text-wrap:pretty">Katalog {N} {odm(N, ['pozycji', 'pozycji', 'pozycji'])} z ośmiu obszarów firmy. Przy każdej stoi ta sama miara — ile tygodni mija do pierwszego uruchomienia na produkcji. {SZYBKIE} z nich mieści się w trzech tygodniach albo krócej.</p>
<div class="hero-actions" style="display:flex;align-items:center;flex-wrap:wrap;gap:14px 18px;margin-top:clamp(24px,3vw,34px)">
<a href="#katalog" class="btn-dark" style="display:inline-flex;align-items:center;gap:10px;background:#16211a;color:#ffffff;padding:17px 30px;border-radius:12px;font-weight:650;font-size:16.5px;box-shadow:0 14px 30px -14px rgba(16,33,26,0.45)">Otwórz katalog <span aria-hidden="true">→</span></a>
<a href="#kontakt" class="btn-ghost" style="display:inline-flex;align-items:center;gap:8px;font-size:16.5px;font-weight:700;color:#16211a;background:rgba(255,255,255,0.6);padding:17px 24px;border-radius:12px;border:1px solid rgba(22,33,26,0.16)">Umów rozmowę</a>
</div>
</div>

<div class="hg-wrap" style={`--hgn:${NAJWYZSZA}`}>
<div class="hg" id="hg" data-po={String(Math.round((HG_KLAMRA + 0.7) * 1000))} role="img" aria-label={`Rozkład ${N} pozycji katalogu według czasu do pierwszego uruchomienia. Najwięcej pozycji, bo ${KOLUMNY[2].length}, przypada na trzy tygodnie. ${SZYBKIE} z ${N} mieści się w trzech tygodniach albo krócej, a najdłuższa pozycja zajmuje ${MAX_W} tygodni.`}>
{KOLUMNY.map((kol, i) => (
  <span class="hg-col">
  {kol.map((p, j) => (
    <span
      class={p.w <= PROG ? 'hg-sq masa' : 'hg-sq'}
      data-i={String(p.i)}
      data-t={p.t}
      data-o={p.on}
      data-ok={p.ok}
      data-r={RODZ[p.r].m}
      data-w={`${p.w} ${odm(p.w, ['tydzień', 'tygodnie', 'tygodni'])}`}
      style={`animation:hg-in .5s cubic-bezier(.34,1.4,.5,1) ${(HG_START + i * HG_KOL + j * HG_KLO).toFixed(2)}s both${p.w <= PROG ? `,hg-masa .45s linear ${HG_MASA.toFixed(2)}s forwards` : ''}`}
    ></span>
  ))}
  </span>
))}
</div>
<div class="hg-os" aria-hidden="true">
{KOLUMNY.map((_, i) => <span>{i + 1}</span>)}
</div>
<div class="hg-klamra" aria-hidden="true">
<i style={`width:calc(${((PROG / MAX_W) * 100).toFixed(2)}% - 5px);animation:hg-klamra .5s ease ${HG_KLAMRA.toFixed(2)}s forwards`}></i>
<b style={`width:calc(${((PROG / MAX_W) * 100).toFixed(2)}% - 5px);animation:hg-klamra .5s ease ${(HG_KLAMRA + 0.12).toFixed(2)}s forwards`}>{SZYBKIE} z {N}</b>
</div>
<p class="hg-jedn">tygodnie do pierwszego uruchomienia</p>
<p class="hg-pod" id="hgpod"><b id="hgt">Jeden klocek to jedna pozycja z katalogu</b><em id="hgm" class="hg-hint">Nazwa pojawia się po najechaniu kursorem. Kliknięcie otwiera jej obszar w katalogu.</em></p>
</div>
</div>

<!-- Teza strony — osobna linia w dużym stopniu pisma, bez nagłówka nad nią.
     Playbook §3: argument, który ma być zapamiętany, nie może być akapitem
     trzecim. Po prawej legenda katalogu, żeby paski niżej dało się czytać. -->
<div class="tz">
<div>
<p class="tz-duze">Zmiana, po której firma pracuje inaczej, rzadko jest jedną dużą aplikacją. Zwykle to kilka drobiazgów, <span>z których żaden osobno nie wygląda na projekt.</span></p>
<p class="sub" style="margin:20px 0 0;max-width:600px">Dlatego przy każdej pozycji stoi tu waga w tygodniach. Rzeczy warte zbudowania rozpoznaje się po tym, jak często ktoś wykonuje je ręcznie, i po tym, ile kosztuje jedna pomyłka.</p>
</div>
<div>
{RODZAJE.map((r) => {
  const ile = POMYSLY.filter((p) => p.r === r.k).length;
  return (
    <div class="tz-r"><b>{r.t}</b><span>{r.d} <i>· {ile}</i></span></div>
  );
})}
<div class="tz-r"><b>Waga</b><span>Tygodnie do pierwszego uruchomienia na produkcji, razem z czekaniem na Waszej stronie <i>· 1–{MAX_W}</i></span></div>
</div>
</div>
</section>

<!-- ============ 2 · OBSZARY ============
     Nagłówek pełną szerokością, bez akapitu obok — trzeci szkielet na stronie.
     Osiem wierszy na liniach: numer, nazwa, stan zastany, najlżejsza
     i najcięższa pozycja obszaru. Wiersz jest przyciskiem: ustawia filtr. -->
<section id="obszary" style="background:#f4f8f2;padding:clamp(58px,7vw,92px) max(clamp(20px,5vw,56px),calc((100% - 1440px) / 2));scroll-margin-top:16px">
<h2 class="h-sec" style="margin:0;max-width:900px;text-wrap:balance">Osiem obszarów, w których to się zwykle zaczyna</h2>
<div class="ob">
{KATALOG.map((g, i) => (
    <div class="ob-r rv">
      <h3 class="ob-t"><span class="ob-n">{String(i + 1).padStart(2, '0')}</span><a href="#katalog" data-goto={g.k}>{g.t}</a></h3>
      <p class="ob-d">{g.d}</p>
      <span class="ob-w"><span class="ob-w1"><em>{g.szybkie}</em>z {g.p.length}</span><span class="ob-w2">w trzy tygodnie</span></span>
    </div>
))}
</div>
<p class="sub rv" style="margin:clamp(24px,3vw,34px) 0 0;max-width:720px">Obszar oznacza miejsce, w którym schodzi czas — połowa pozycji z „wiedzy i dokumentów" pracuje ostatecznie na sprzedaż.</p>
</section>

<!-- ============ 3 · KATALOG ============
     Serce strony. Indeks w dwóch kolumnach, zgrupowany obszarami, z paskiem
     wagi w tej samej skali co hero. Filtry są przyrządem, nie ozdobą:
     wybór rodzaju dopisuje pod sobą usługę, która takie rzeczy buduje. -->
<section id="katalog" style="padding:clamp(58px,7vw,96px) max(clamp(20px,5vw,56px),calc((100% - 1440px) / 2)) clamp(58px,7vw,92px);scroll-margin-top:84px">
<div class="sec-head">
<h2 class="h-sec" style="margin:0;max-width:620px;text-wrap:balance">Katalog</h2>
<p style="margin:0 0 6px;max-width:520px;font-size:17px;line-height:1.6;color:#4c5850;text-wrap:pretty">Każda pozycja jest rzeczą, którą ktoś u kogoś dzisiaj robi ręcznie. Szukajcie po słowie, które pada u Was na korytarzu — „faktury", „grafik", „reklamacje".</p>
</div>

<span id="kt-sentinel" aria-hidden="true" style="display:block;height:1px"></span>
<div class="kt-bar" id="ktbar">
<div class="kt-gora">
<label class="kt-szuk">
<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#8b968d" stroke-width="2.1" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4.2-4.2"/></svg>
<input type="search" id="ktq" placeholder="Szukaj w katalogu" aria-label="Szukaj w katalogu" autocomplete="off">
</label>
<p class="kt-licz"><b id="ktn">{N}</b> z {N} {odm(N, ['pozycji', 'pozycji', 'pozycji'])}</p>
</div>
<div class="kt-linie">
<div class="kt-l"><span class="kt-lab">Obszar</span><div class="kt-opts" data-grp="o">
<button type="button" class="kt-opt on" data-v="">wszystkie</button>
{KATALOG.map((g) => <button type="button" class="kt-opt" data-v={g.k}>{g.t}</button>)}
</div></div>
<div class="kt-l"><span class="kt-lab">Rodzaj</span><div class="kt-opts" data-grp="r">
<button type="button" class="kt-opt on" data-v="">wszystkie</button>
{RODZAJE.map((r) => <button type="button" class="kt-opt" data-v={r.k} data-h={r.h} data-ht={r.ht}>{r.t}</button>)}
</div></div>
<div class="kt-l"><span class="kt-lab">Waga</span><div class="kt-opts" data-grp="w">
<button type="button" class="kt-opt on" data-v="">wszystkie</button>
<button type="button" class="kt-opt" data-v="1-2">do 2 tygodni</button>
<button type="button" class="kt-opt" data-v="3-4">3–4 tygodnie</button>
<button type="button" class="kt-opt" data-v={`5-${MAX_W}`}>dłuższe</button>
</div></div>
</div>
<p class="kt-route" id="ktroute" hidden></p>
</div>

{KATALOG.map((g) => (
  <div class="kt-grp" data-grp-o={g.k}>
    <div class="kt-ghead"><h3>{g.t}</h3><span class="kt-gcount">{g.p.length} {odm(g.p.length, ['pozycja', 'pozycje', 'pozycji'])}</span></div>
    <div class="kt-lista">
    {g.p.map((x) => {
      const p = POMYSLY.find((y) => y.ok === g.k && y.t === x.t);
      return (
        <div class="kt-it" data-o={g.k} data-r={x.r} data-w={String(x.w)} data-s={p.szukaj} id={`p-${p.i}`}>
          <span class="kt-t">{x.t}</span>
          <span class="kt-d">{x.d}</span>
          <span class="kt-meta">
            <span class="kt-r">{RODZ[x.r].m}</span>
            <span class="kt-para">
              <span class="kt-w"><i style={`width:${((x.w / MAX_W) * 100).toFixed(0)}%`}></i></span>
              <span class="kt-wn">{x.w} tyg.</span>
            </span>
          </span>
        </div>
      );
    })}
    </div>
  </div>
))}

<p class="kt-pusto" id="ktpusto" hidden>Nic nie pasuje do tego zestawu. <a href="#kontakt">Napiszcie, czego szukacie →</a></p>
<p class="kt-nota">Wagi są medianami z naszych wdrożeń podobnych rzeczy. Liczą czas do pierwszego uruchomienia na produkcji, razem z czekaniem na dostępy i na decyzje po Waszej stronie. Przy wycenie liczba jest policzona dla Waszego przypadku i wchodzi do umowy.</p>
</section>

<!-- ============ 4 · TRZY POZIOMY ============
     Ciemny pas bierze najcięższy argument strony. Rysunek to zagnieżdżenie:
     ramka poziomu trzeciego zawiera drugą, druga pierwszą — bo tak wygląda
     budowa. Odsłania się z zewnątrz do środka, więc na końcu ląduje poziom
     pierwszy, ten, który działa sam. -->
<section id="poziomy" style="position:relative;background:radial-gradient(950px 440px at 86% 4%, rgba(0,205,119,0.17), transparent 62%), #0e2b1d;padding:clamp(60px,7.5vw,100px) max(clamp(20px,5vw,56px),calc((100% - 1440px) / 2));scroll-margin-top:16px">
<h2 class="h-sec" style="margin:0;max-width:760px;color:#ffffff;text-wrap:balance">Jeden pomysł w trzech rozmiarach</h2>
