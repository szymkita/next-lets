// ---- MIESIĄC DZIEŃ PO DNIU ---------------------------------------------
// Kafelki jak w wykresie aktywności na GitHubie: intensywność koloru mówi,
// ile się danego dnia działo, a dymek pokazuje co dokładnie. Dzięki temu
// nie potrzeba legendy — treść siedzi w każdym dniu z osobna.
//
// Liczby są przykładem miesiąca zespołu dwóch osób budujących w Claude Code.
const DNI = [
  { w: 2, q: 1 },            { w: 3, p: 1 },            { w: 1, q: 2 },            { w: 4, q: 1 },            { w: 2 },
  { w: 3, q: 1 },            { w: 2, p: 1, q: 1 },      { w: 3, s: 1 },            { w: 1, q: 1 },            { w: 4, p: 1 },
  { w: 2, q: 2 },            { w: 3 },                  { w: 2, q: 1 },            { w: 4, s: 1 },            { w: 1, p: 1, q: 1 },
  { w: 3, q: 1 },            { w: 2 },                  { w: 4, p: 1, q: 2 },      { w: 2, q: 1 },            { w: 3, d: 1 },
];
const DNI_TYG = ['pn', 'wt', 'śr', 'cz', 'pt'];

// polska odmiana bez kombinowania: 1 / 2–4 / 5+
const odm = (n, jeden, kilka, wiele) => (n === 1 ? jeden : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? kilka : wiele);
const opisDnia = (x) => {
  const l = [`${x.w} ${odm(x.w, 'nowa wersja przejrzana', 'nowe wersje przejrzane', 'nowych wersji przejrzanych')}`];
  if (x.p) l.push('poprawka po naszej stronie');
  if (x.q) l.push(`${x.q} ${odm(x.q, 'pytanie na czacie', 'pytania na czacie', 'pytań na czacie')}`);
  if (x.s) l.push('wspólne spotkanie · 90 minut');
  if (x.d) l.push('podsumowanie miesiąca · godzina');
  return l;
};
const MIESIAC = DNI.map((x, i) => ({
  ...x,
  i,
  tydzien: Math.floor(i / 5) + 1,
