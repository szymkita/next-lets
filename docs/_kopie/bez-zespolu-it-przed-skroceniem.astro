// ---- ZASADY, KTÓRE ZOSTAJĄ U KLIENTA -----------------------------------
// Powstają z komentarzy. Trzy ostatnie pokazujemy w sekcji „co zostaje
// u Was" — to najkonkretniejszy dowód, że wiedza przechodzi na klienta.
const ZASADY = [
