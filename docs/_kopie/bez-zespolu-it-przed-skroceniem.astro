// ---- LUPA NAD KODEM (hero) ---------------------------------------------
// Kod przewija się sam i poza lupą jest blady — dokładnie tak wygląda dla
// osoby, która nie programuje. Lupa wędruje nad nim i zatrzymuje się na
// trzech miejscach: podkreślenie zapala się na czerwono albo bursztynowo,
// a po chwili robi się zielone. Bez jednego słowa komentarza — to jest cała
// usługa: ktoś czyta kod, którego Wy nie czytacie, i od razu to poprawia.
//
// Powiększenie: druga kopia tego samego kodu, przycięta do koła. Obie kopie
// mają tę samą animację przewijania, więc nie mają jak się rozjechać.
// Kompensacja powiększenia liczy się z pozycji lupy: przesunięcie kopii to
// (r - k·cx, r - k·cy), więc punkt (cx, cy) sceny ląduje w środku koła.
//
// Kod jest prawdziwy: eksport zamówień z panelu, jakich powstaje najwięcej.
// Trzy podkreślenia to trzy rzeczy, które faktycznie się w takim kodzie
// znajduje — klucz w kodzie, zapytanie bez limitu, dane klientów w mailu.
const KOD = [
  "import { db } from './db';",
  "import type { Request, Response } from 'express';",
  '',
  'type Zamowienie = {',
  '  nr: string; data: string; kwota: number;',
  '  klientId: string;',
  '};',
  '',
  { a: 'const KLUCZ_MAILA = ', m: "'sk-live-8f2c41c9a7'", b: ';', po: 'process.env.KLUCZ_MAILA!' },
  '',
  'export async function eksportZamowien(',
  '  req: Request, res: Response',
  '): Promise<void> {',
  "  const od = (req.query.od as string) ?? '2026-01-01';",
  '',
  '  const zamowienia = await db.query<Zamowienie>(',
  '    `select nr, data, kwota, klient_id',
  { a: '     from zamowienia ', m: 'where data >= $1`', b: ',', po: 'where data >= $1 limit 1000`' },
  '    [od]',
  '  );',
  '',
  '  const plik = doCSV(zamowienia);',
  { a: '  await ', m: 'wyslijMailem(plik, req.user.email)', b: ';', po: 'wyslijLink(zapisz(plik), req.user.id)' },
  '  res.json({ ok: true, ile: zamowienia.length });',
  '}',
];

const LU = {
  c: 22,             // długość cyklu
  w: 600, h: 420,    // scena
  wiersz: 26, gora: 16, lewo: 18,
  r: 76, k: 1.55,    // promień lupy i powiększenie
  fs: 15,
  x0: 210, y0: 120,  // gdzie lupa stoi na początku i na końcu cyklu
};
const LU_H = KOD.length * LU.wiersz;
const LU_V = LU_H / LU.c;                                   // px na sekundę
const yWiersza = (i, t) => LU.gora + i * LU.wiersz + LU.wiersz / 2 - LU_V * t;

// Trzy przystanki lupy. „zgasnie" to moment, w którym wiersz wyjechał już
// górą — podkreślenie musi zniknąć, zanim jego kopia z drugiego bloku
// wjedzie od dołu, inaczej zielone podkreślenia pojawiałyby się same.
// x liczy się z długości tekstu, żeby lupa stała dokładnie nad podkreśleniem
// (Menlo ma szerokość znaku 0,6021 em), a nie „mniej więcej tam".
const ZNAK_W = LU.fs * 0.6021;
const srodek = (i) => LU.lewo + (KOD[i].a.length + KOD[i].m.length / 2) * ZNAK_W;
// „wroci" to moment, w którym wiersz wraca do stanu sprzed poprawki —
// musi wypaść wtedy, gdy ani on, ani jego kopia z drugiego bloku nie są
// widoczne, inaczej poprawiony kod mrugałby z powrotem na oczach czytelnika.
const PRZYSTANKI = [
  { i: 8,  od: 1.0,  do: 3.4,  kolor: '#c0492f', zgasnie: 8.9,  wroci: 15.5 },
  { i: 17, od: 8.6,  do: 11.0, kolor: '#d99a3c', zgasnie: 16.8, wroci: 21.9 },
  { i: 22, od: 13.0, do: 15.4, kolor: '#d99a3c', zgasnie: 21.2, wroci: 21.9 },
].map((z) => ({ ...z, x: srodek(z.i) }));
const ZNAKI = PRZYSTANKI.map((z) => z.i);

const lp = (t) => `${((t / LU.c) * 100).toFixed(2)}%`;
const poz = (cx, cy) => `left:${(cx - LU.r).toFixed(1)}px;top:${(cy - LU.r).toFixed(1)}px`;
const kadr = (cx, cy) => `transform:translate(${(LU.r - LU.k * cx).toFixed(1)}px,${(LU.r - LU.k * cy).toFixed(1)}px) scale(${LU.k})`;

// Punkty toru: start, potem po dwa na każdy przystanek (dojazd i odjazd).
const MIEKKO = 'cubic-bezier(.45,0,.25,1)';
const TOR_LUPY = [
  { t: 0, x: LU.x0, y: LU.y0, f: MIEKKO },
  ...PRZYSTANKI.flatMap((z) => [
    // od tej klatki lupa jedzie liniowo, bo śledzi przewijający się wiersz
    { t: z.od, x: z.x, y: yWiersza(z.i, z.od), f: 'linear' },
    { t: z.do, x: z.x, y: yWiersza(z.i, z.do), f: MIEKKO },
  ]),
  { t: LU.c, x: LU.x0, y: LU.y0, f: MIEKKO },
];

// Przepływ w sekcji definicyjnej: kropka jedzie od Was, zatrzymuje się
// u nas i rusza dalej do ludzi. Cykl krótszy niż lupa, żeby oba ruchy
// nie wpadały w ten sam rytm.
const FL_C = 10;
const flp = (t) => `${((t / FL_C) * 100).toFixed(2)}%`;
const FL_POZ = ['-1px', 'calc((100% - 2 * var(--g)) / 3 + var(--g) - 1px)', 'calc(2 * ((100% - 2 * var(--g)) / 3 + var(--g)) - 1px)'];
const FL_SZER = ['0%', 'calc((100% - 2 * var(--g)) / 3 + var(--g) + 6px)', '100%'];
const klatkiPrzeplywu = [
  `@keyframes fl-jedzie{0%,${flp(0.4)}{left:${FL_POZ[0]};opacity:0}${flp(0.9)}{left:${FL_POZ[0]};opacity:1}${flp(3.1)}{left:${FL_POZ[1]};opacity:1}${flp(4.9)}{left:${FL_POZ[1]};opacity:1}${flp(7.0)}{left:${FL_POZ[2]};opacity:1}${flp(8.2)}{left:${FL_POZ[2]};opacity:1}${flp(8.6)}{left:${FL_POZ[2]};opacity:0}100%{left:${FL_POZ[0]};opacity:0}}`,
  `@keyframes fl-rosnie{0%,${flp(0.9)}{width:${FL_SZER[0]}}${flp(3.1)}{width:${FL_SZER[1]}}${flp(4.9)}{width:${FL_SZER[1]}}${flp(7.0)}{width:${FL_SZER[2]}}${flp(8.2)}{width:${FL_SZER[2]}}${flp(8.6)}{width:${FL_SZER[0]}}100%{width:${FL_SZER[0]}}}`,
  `@keyframes fl-puls{0%,${flp(3.1)}{opacity:0;transform:scale(0.55)}${flp(3.5)}{opacity:1;transform:scale(1)}${flp(4.6)}{opacity:1;transform:scale(1)}${flp(5.1)}{opacity:0;transform:scale(1.6)}100%{opacity:0}}`,
].join('\n');

const klatkiLupy = [
  `@keyframes lu-scroll{0%{transform:translateY(0)}100%{transform:translateY(${-LU_H}px)}}`,
  `@keyframes lu-lot{${TOR_LUPY.map((p) => `${lp(p.t)}{${poz(p.x, p.y)};animation-timing-function:${p.f}}`).join('')}}`,
  `@keyframes lu-kadr{${TOR_LUPY.map((p) => `${lp(p.t)}{${kadr(p.x, p.y)};animation-timing-function:${p.f}}`).join('')}}`,
  ...PRZYSTANKI.map((z, n) => {
    const zapala = z.od + 0.25, zielony = z.do - 0.5;
    return `@keyframes lu-zn${n}{0%,${lp(zapala)}{opacity:0;background:${z.kolor}}${lp(zapala + 0.3)}{opacity:1;background:${z.kolor}}${lp(zielony)}{opacity:1;background:${z.kolor}}${lp(zielony + 0.35)}{opacity:1;background:#00CD77}${lp(z.zgasnie)}{opacity:1;background:#00CD77}${lp(z.zgasnie + 0.5)}{opacity:0;background:#00CD77}100%{opacity:0;background:${z.kolor}}}`;
  }),
  ...PRZYSTANKI.map((z, n) => {
    const zapala = z.od + 0.25, zielony = z.do - 0.5;
    return `@keyframes lu-tl${n}{0%,${lp(zapala)}{background:rgba(0,0,0,0)}${lp(zapala + 0.3)}{background:${z.kolor}1f}${lp(zielony)}{background:${z.kolor}1f}${lp(zielony + 0.35)}{background:rgba(0,205,119,0.14)}${lp(z.zgasnie)}{background:rgba(0,205,119,0.14)}${lp(z.zgasnie + 0.5)}{background:rgba(0,0,0,0)}100%{background:rgba(0,0,0,0)}}`;
  }),
  // wiersz przed poprawką i po poprawce — klucz ma zniknąć z kodu, a nie
  // zrobić się zielony
  ...PRZYSTANKI.map((z, n) => {
    const zielony = z.do - 0.5;
    return `@keyframes lu-wp${n}{0%,${lp(zielony)}{opacity:1}${lp(zielony + 0.01)}{opacity:0}${lp(z.wroci)}{opacity:0}${lp(z.wroci + 0.01)}{opacity:1}100%{opacity:1}}`;
  }),
  ...PRZYSTANKI.map((z, n) => {
    const zielony = z.do - 0.5;
    return `@keyframes lu-wo${n}{0%,${lp(zielony)}{opacity:0}${lp(zielony + 0.01)}{opacity:1}${lp(z.wroci)}{opacity:1}${lp(z.wroci + 0.01)}{opacity:0}100%{opacity:0}}`;
  }),
].join('\n');


