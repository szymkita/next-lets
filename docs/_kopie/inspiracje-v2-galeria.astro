---
// INSPIRACJE — /inspiracje  (wersja 2, galeryjna)
//
// WERSJA 1 ODRZUCONA: „to jest do zrzucenia całkowicie, to jest brzydkie,
// to ma być wizualne". Tamta strona była indeksem — histogram wag i 64 wiersze
// tekstu z filtrami. Kopia leży w docs/_kopie/inspiracje-v1-katalog.astro.
//
// CO ROBI TA WERSJA INACZEJ:
//   Strona jest GALERIĄ OPROGRAMOWANIA, którego klient jeszcze nie ma.
//   Każdy obszar firmy dostaje duży, narysowany od zera interfejs — nie wykres,
//   nie ikonę, nie wiersz tekstu. Nośnikiem jest EKRAN. Zdania są podpisami
//   pod obrazem, nie odwrotnie.
//
// SŁOWNIK WIZUALNY — dziewiąty osobny w serwisie:
//   /strategia-ai:             łuki, pole przewag, siatka stu kwadratów
//   /rozwiazania-ai:           przekrój warstw, próg pewności, tory
//   /szkolenia-ai:             jednostki do policzenia
//   /systemy-procesowe:        oś czasu sprawy
//   /systemy-dla-klientow:     lista pytań
//   /automatyzacje-integracje: puls i karta połączenia
//   tutaj:                     EKRAN. Dziesięć narysowanych interfejsów,
//     każdy innego gatunku: okno aplikacji, telefon, planer, skan dokumentu,
//     kalendarz, rozmowa z cytatem, karta produktu, kokpit, panel operacyjny.
//     Żaden gatunek się nie powtarza.
//
// RYTM SEKCJI (playbook §8) — cztery różne układy spreadu, nie jeden powtórzony:
//   A) tekst po lewej / scena po prawej      → sprzedaż, finanse, zarząd
//   B) scena po lewej / tekst po prawej      → obsługa, ludzie
//   C) nagłówek pełną szerokością, scena pod → operacje, wiedza
//   D) dwie kolumny „przed / po"             → marketing
//   Ciemny pas pada raz, w środku, i bierze najcięższy obraz strony.
//
// DO POTWIERDZENIA PRZED PUBLIKACJĄ:
// · Czasy przy pozycjach (pole `w`) to mediany z obserwacji, nie z pomiaru.
// · Wszystkie dane na ekranach są PRZYKŁADOWE (nazwy firm, kwoty, numery).
//   Żaden ekran nie jest zrzutem z wdrożenia — to rysunek, i tak jest napisane.
// · /og/inspiracje.png — strona dziedziczy /og/hub.png.
import LaBase from '../layouts/LaBase.astro';
import GcFaq from '../components/GcFaq.astro';
import GcCta from '../components/GcCta.astro';

const kanon = new URL('/inspiracje', Astro.site).href;

const odm = (n, [a, b, c]) => {
  const d = n % 10;
  const s = n % 100;
  if (n === 1) return a;
  if (d >= 2 && d <= 4 && !(s >= 12 && s <= 14)) return b;
  return c;
};

// ---- OBSZARY -----------------------------------------------------------
// Podpis obszaru opisuje stan zastany. Lista pozycji jest podpisem pod
// obrazem — każda z czasem do pierwszego uruchomienia.
const OBSZARY = [
  {
    k: 'sprzedaz', n: '01', t: 'Sprzedaż i ofertowanie',
    lead: 'Wycena zależy od tego, kto akurat ma czas, a ustalenia z klientem siedzą w skrzynkach.',
    ekran: 'Generator oferty — pozycje z cennika, jeden wzór dokumentu',
    p: [
      { t: 'Generator ofert z cennika', w: 3 },
      { t: 'Rejestr szans z historią ustaleń', w: 4 },
      { t: 'Wycena z rysunku i specyfikacji', w: 8 },
      { t: 'Konfigurator produktu dla handlowca', w: 7 },
      { t: 'Notatka ze spotkania trafia do CRM sama', w: 1 },
      { t: 'Pilnowanie terminów ważności ofert', w: 1 },
    ],
  },
  {
    k: 'obsluga', n: '02', t: 'Obsługa klienta',
    lead: 'Połowa rozmów to pytanie o status sprawy, który ktoś już gdzieś zapisał.',
    ekran: 'Portal klienta w telefonie i ten sam stan w panelu zespołu',
    p: [
      { t: 'Portal klienta ze statusem sprawy', w: 8 },
      { t: 'Asystent na wspólnej skrzynce', w: 4 },
      { t: 'Rejestr reklamacji z terminami', w: 4 },
      { t: 'Panel serwisu w telefonie technika', w: 5 },
      { t: 'Powiadomienie o zmianie terminu', w: 1 },
    ],
  },
  {
    k: 'operacje', n: '03', t: 'Operacje i realizacja',
    lead: 'Zlecenie jedzie przez pięć narzędzi i tablicę na ścianie.',
    ekran: 'Planer obłożenia — trzy tygodnie, sześć zespołów, jedno miejsce',
    p: [
      { t: 'System prowadzący zlecenie do odbioru', w: 10 },
      { t: 'Planowanie obłożenia zespołu i maszyn', w: 9 },
      { t: 'Cyfrowa karta pracy', w: 3 },
      { t: 'Kontrola jakości ze zdjęciem', w: 4 },
      { t: 'Zamówienia z portalu prosto na produkcję', w: 2 },
      { t: 'Wykrywanie zleceń, które stanęły', w: 2 },
    ],
  },
  {
    k: 'finanse', n: '04', t: 'Finanse i administracja',
    lead: 'Dokumenty przepisuje się z maila do systemu, a terminów pilnuje czyjaś pamięć.',
    ekran: 'Koszt w obiegu — limit, dwie akceptacje i ślad, kto ją podjął',
    p: [
      { t: 'Faktury kosztowe z poczty do ERP', w: 2 },
      { t: 'Obieg akceptacji kosztów z limitami', w: 3 },
      { t: 'Rejestr umów z terminami wypowiedzenia', w: 3 },
      { t: 'Pilnowanie płatności i przypomnienia', w: 2 },
      { t: 'Budżet projektu kontra wykonanie', w: 4 },
      { t: 'Sprawdzenie kontrahenta przed transakcją', w: 2 },
    ],
  },
  {
    k: 'ludzie', n: '05', t: 'Ludzie i zespół',
    lead: 'Wdrożenie nowej osoby zależy od tego, kto akurat siedzi obok.',
    ekran: 'Grafik zmian, który sam pilnuje reguł i pokazuje dziurę',
    p: [
      { t: 'Grafik zmian z regułami i zastępstwami', w: 5 },
      { t: 'Wdrożenie nowej osoby dzień po dniu', w: 3 },
      { t: 'Rejestr szkoleń i uprawnień', w: 3 },
      { t: 'Przegląd zgłoszeń rekrutacyjnych', w: 3 },
      { t: 'Asystent kadrowy do pytań o regulamin', w: 2 },
    ],
  },
  {
    k: 'wiedza', n: '06', t: 'Wiedza i dokumenty',
    lead: 'Odpowiedź jest w firmie, tylko nikt nie wie, w którym pliku.',
    ekran: 'Wyszukiwarka po dokumentach — odpowiedź ze wskazaniem akapitu',
    p: [
      { t: 'Wyszukiwarka po dokumentach firmy', w: 4 },
      { t: 'Asystent, który cytuje źródło', w: 4 },
      { t: 'Odczyt umów: terminy, kary, wypowiedzenie', w: 4 },
      { t: 'Generator dokumentów z danych sprawy', w: 3 },
      { t: 'Porównanie wersji dokumentu', w: 2 },
    ],
  },
  {
    k: 'marketing', n: '07', t: 'Marketing i treści',
    lead: 'Opisy i materiały powstają od zera przy każdej kampanii.',
    ekran: 'Karta techniczna po lewej, gotowy opis do sklepu po prawej',
    p: [
      { t: 'Opisy produktów z karty technicznej', w: 3 },
      { t: 'Redakcja treści w Waszym języku', w: 3 },
      { t: 'Biblioteka materiałów dla handlowców', w: 4 },
      { t: 'Kalendarz publikacji z akceptacją', w: 3 },
      { t: 'Raport z kampanii, który składa się sam', w: 2 },
    ],
  },
  {
    k: 'zarzad', n: '08', t: 'Zarząd i dane',
    lead: 'Liczba na zarząd bierze się z arkusza, który ktoś klei co miesiąc.',
    ekran: 'Rentowność klienta — jedna definicja marży dla całej firmy',
    p: [
      { t: 'Kokpit zarządu z jednym źródłem liczb', w: 4 },
      { t: 'Rentowność klienta i zlecenia', w: 6 },
      { t: 'Prognoza sprzedaży z lejka', w: 4 },
      { t: 'Sygnał, kiedy coś odjeżdża od planu', w: 3 },
      { t: 'Raport tygodniowy bez człowieka', w: 2 },
    ],
  },
];

const N = OBSZARY.reduce((s, g) => s + g.p.length, 0);

// ---- HERO: jedno okno, sześć ekranów -----------------------------------
// Pętla z własnego zegara (playbook §7). Wszystkie czasy liczone z tablicy,
// więc dołożenie siódmego ekranu przelicza animację samo.
const EKRANY = [
  { k: 'zlecenia', t: 'Zlecenia' },
  { k: 'kokpit', t: 'Kokpit' },
  { k: 'faktury', t: 'Faktury' },
  { k: 'portal', t: 'Portal klienta' },
  { k: 'asystent', t: 'Asystent' },
  { k: 'zgody', t: 'Akceptacje' },
];
const HE_N = EKRANY.length;
const HE_JEDEN = 3.4;                  // ile sekund stoi jeden ekran
const HE_C = HE_JEDEN * HE_N;          // pełny obieg
const proc = (s) => `${((s / HE_C) * 100).toFixed(2)}%`;

const klatkiHero = [
  // Ekran wchodzi z lekkim podniesieniem, stoi swoje i schodzi w górę.
  `@keyframes he-pane{0%{opacity:0;transform:translateY(10px) scale(.994)}${proc(0.5)}{opacity:1;transform:none}${proc(HE_JEDEN - 0.1)}{opacity:1;transform:none}${proc(HE_JEDEN + 0.4)}{opacity:0;transform:translateY(-8px) scale(.994)}100%{opacity:0;transform:translateY(10px) scale(.994)}}`,
  // Pozycja w bocznym pasku zapala się dokładnie wtedy, kiedy wchodzi ekran.
  `@keyframes he-nav{0%{background:transparent;color:#8b968d}${proc(0.35)}{background:#eef6f0;color:#0a7a52}${proc(HE_JEDEN)}{background:#eef6f0;color:#0a7a52}${proc(HE_JEDEN + 0.35)}{background:transparent;color:#8b968d}100%{background:transparent;color:#8b968d}}`,
  `@keyframes he-kropka{0%{opacity:0}${proc(0.35)}{opacity:1}${proc(HE_JEDEN)}{opacity:1}${proc(HE_JEDEN + 0.35)}{opacity:0}100%{opacity:0}}`,
  // Podpis pod oknem zmienia się razem z ekranem.
  `@keyframes he-pod{0%{opacity:0;transform:translateY(5px)}${proc(0.55)}{opacity:1;transform:none}${proc(HE_JEDEN - 0.1)}{opacity:1;transform:none}${proc(HE_JEDEN + 0.35)}{opacity:0;transform:translateY(-4px)}100%{opacity:0;transform:translateY(5px)}}`,
  // Karta wisząca nad oknem — pojawia się tylko przy ekranie z akceptacjami.
  `@keyframes he-toast{0%,${proc(HE_JEDEN * 5 + 0.6)}{opacity:0;transform:translateY(12px) scale(.97)}${proc(HE_JEDEN * 5 + 1.2)}{opacity:1;transform:none}${proc(HE_C - 0.5)}{opacity:1;transform:none}100%{opacity:0;transform:translateY(12px) scale(.97)}}`,
].join('\n');

const PODPISY = [
  'Rejestr zleceń — stan każdej sprawy w jednym miejscu',
  'Kokpit — liczby policzone z jednego źródła',
  'Odczyt faktury — pola wyjęte z załącznika',
  'Portal klienta — ten sam stan, pokazany na zewnątrz',
  'Asystent — odpowiedź ze wskazaniem miejsca w dokumencie',
  'Akceptacje — limit, decyzja i ślad, kto ją podjął',
];

// ---- CZEGO NIE BUDUJEMY -------------------------------------------------
const GRANICE = [
  { t: 'Czatu na stronie, który odpowiada na wszystko', d: 'Odpowiada również wtedy, kiedy nie wie. Koszt jednej złej odpowiedzi przy cenie albo terminie bywa większy niż oszczędność na stu dobrych.' },
  { t: 'Przepisania ERP-a od zera', d: 'To projekt na dwa lata, który zwykle kończy się w połowie. Taniej wychodzi zbudować obok to, czego ERP nie umie, i zostawić w nim księgowość.' },
  { t: 'Agenta, który sam pisze do klientów', d: 'Bez akceptacji człowieka pierwsza pomyłka kosztuje więcej niż rok zaoszczędzonego czasu. Projekt odpowiedzi tak, wysyłka po zatwierdzeniu.' },
  { t: 'Aplikacji zamiast decyzji', d: 'Kiedy w firmie nie ustalono, kto zatwierdza rabat, system tego nie rozstrzygnie. Wtedy zaczynamy od reguły, a narzędzie przychodzi po niej.' },
];

// ---- META I DANE STRUKTURALNE ------------------------------------------
const title = "Inspiracje: aplikacje i rozwiązania AI dla firm — galeria ekranów | Let's automate";
const description = `Osiem obszarów firmy i ${N} rzeczy do zbudowania, pokazanych jako gotowe ekrany: rejestry, portale, kokpity, odczyt dokumentów i asystenci AI. Każdy interfejs narysowany od zera.`;

const dane = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${kanon}#strona`,
      url: kanon,
      name: 'Inspiracje — galeria aplikacji i rozwiązań AI dla firm',
      description,
      about: { '@id': new URL('/#organizacja', Astro.site).href },
    },
    {
      '@type': 'ItemList',
      '@id': `${kanon}#katalog`,
      name: 'Aplikacje wewnętrzne i rozwiązania AI do zbudowania w firmie',
      numberOfItems: N,
      itemListElement: OBSZARY.flatMap((g) => g.p).map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: p.t,
        description: `Czas do pierwszego uruchomienia: około ${p.w} ${odm(p.w, ['tygodnia', 'tygodni', 'tygodni'])}.`,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${kanon}#okruszki`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Strona główna', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: 'Inspiracje', item: kanon },
      ],
    },
  ],
};

const faq = [
  {
    q: 'Czy te ekrany są z prawdziwych wdrożeń?',
    a: 'Nie, wszystkie są narysowane od zera pod tę stronę — nazwy firm, kwoty i numery są przykładowe. Pokazują kształt rzeczy, które budujemy najczęściej, żeby dało się je ocenić przed rozmową. Prawdziwych zrzutów nie publikujemy, bo idą razem z danymi klientów.',
  },
  {
    q: 'Skąd bierze się liczba tygodni przy pozycjach?',
    a: 'To czas od decyzji do pierwszego uruchomienia na produkcji, wzięty z naszych wdrożeń podobnych rzeczy. Obejmuje też czekanie na Was — na dostępy, na przykładowe dokumenty i na rozstrzygnięcie, kto zatwierdza. Przy wycenie liczba jest policzona dla Waszego przypadku i wchodzi do umowy razem z zakresem.',
  },
  {
    q: 'Czy do wszystkiego potrzebny jest model AI?',
    a: 'Nie. Model dokładamy tam, gdzie wąskim gardłem jest czytanie tekstu: odczyt faktury, umowy, zapytania ofertowego, odpowiedź z Waszych dokumentów. Rejestry, portale, kokpity i obiegi akceptacji to zwykłe aplikacje. Na tej stronie widać jedno i drugie.',
  },
  {
    q: 'Da się połączyć kilka rzeczy w jedną aplikację?',
    a: 'Tak i zwykle tak to wygląda. Pozycje z jednego obszaru dzielą te same elementy — rejestr, formularz, kolejkę zatwierdzeń — więc druga i trzecia rzecz w tym samym miejscu kosztują wyraźnie mniej niż pierwsza. Ostrzegamy przed odwrotną kolejnością: pięć rzeczy ruszonych naraz kończy się tym, że żadna nie wchodzi na produkcję.',
  },
  {
    q: 'Ile to kosztuje?',
    a: 'Cena idzie za wielkością i za liczbą wyjątków. Największy wpływ mają trzy rzeczy: ile systemów trzeba dotknąć, ile przypadków szczególnych ma Wasz proces i czy dane są już w jednym miejscu. Widełki podajemy po pierwszej rozmowie, na której przechodzimy jedną rzecz do końca. Nie mamy prowizji od żadnego dostawcy, więc wybór narzędzia nie zmienia naszego przychodu.',
  },
  {
    q: 'Mamy pomysł, którego tu nie widać',
    a: 'Tak zaczyna się większość wdrożeń. Ta galeria pokazuje kształty, które powtarzają się najczęściej — prawie wszystko inne składa się z tych samych elementów w innej kombinacji. Napiszcie, na czym schodzi czas u Was, a odpowiemy, jak by to wyglądało i ile zajmie.',
  },
  {
    q: 'Nie mamy działu IT. To wyklucza połowę galerii?',
    a: 'Nie. Wymaga natomiast osoby po Waszej stronie, która zna proces i ma prawo rozstrzygnąć wątpliwość — to zwykle kierownik działu. Dostępy do systemów ustawiamy z Waszym dostawcą IT. Firmom bez własnego działu IT poświęcona jest osobna strona: <a href="/guided-coding/bez-dzialu-it" style="font-weight:700;color:#0a7a52">budowanie aplikacji bez działu IT</a>.',
  },
  {
    q: 'Kto to utrzyma za rok?',
    a: 'Repozytorium, klucze i dostępy są Wasze od pierwszego dnia, więc utrzymanie może przejąć Wasz zespół albo inny dostawca. Kiedy utrzymujemy my, umowa jest osobna od budowy i wypowiadalna z miesięcznym terminem. Jeśli chcecie budować sami, tym zajmuje się <a href="/guided-coding" style="font-weight:700;color:#0a7a52">Guided Coding</a> — kod pisze Wasz zespół, my pilnujemy jakości.',
  },
];
dane['@graph'].push({
  '@type': 'FAQPage',
  '@id': `${kanon}#faq`,
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
  })),
});
---
<LaBase title={title} description={description} ctaHref="#kontakt" ctaLabel="Umów rozmowę" nav="inspiracje">
<script type="application/ld+json" is:inline set:html={JSON.stringify(dane)} slot="head"></script>
<style is:global slot="head">
  /* =====================================================================
     PRYMITYWY INTERFEJSU
     Wszystkie ekrany na tej stronie są złożone z tych samych klocków —
     dzięki temu dziesięć rysunków wygląda jak jedno oprogramowanie,
     a nie jak dziesięć różnych stocków.
     ===================================================================== */

  /* ---- scena: tło, na którym leży ekran ---- */
  .sc{position:relative;border-radius:clamp(18px,2vw,26px);padding:clamp(20px,3vw,44px);background:linear-gradient(158deg,#f4f9f4 0%,#e9f2ea 100%);overflow:hidden;isolation:isolate}
  .sc::before{content:"";position:absolute;inset:0;background:radial-gradient(58% 62% at 78% -4%, rgba(0,205,119,0.30), transparent 68%);pointer-events:none}
  .sc::after{content:"";position:absolute;inset:0;background:radial-gradient(46% 46% at 6% 100%, rgba(14,43,29,0.10), transparent 70%);pointer-events:none}
  .sc > *{position:relative;z-index:1}
  .sc.jasna{background:linear-gradient(158deg,#ffffff 0%,#f1f7f2 100%)}
  .sc.ciemna{background:linear-gradient(158deg,#123424 0%,#0b2318 100%)}
  .sc.ciemna::before{background:radial-gradient(56% 60% at 82% -6%, rgba(0,205,119,0.34), transparent 66%)}
  .sc.ciemna::after{display:none}

  /* ---- okno aplikacji ---- */
  .win{background:#ffffff;border-radius:clamp(10px,1vw,14px);overflow:hidden;box-shadow:0 40px 70px -38px rgba(11,35,23,0.55),0 8px 20px -12px rgba(11,35,23,0.18),0 0 0 1px rgba(18,38,28,0.055)}
  .win-bar{display:flex;align-items:center;gap:9px;padding:9px 13px;background:#fbfcfa;border-bottom:1px solid #eef1ec}
  .win-bar i{width:7px;height:7px;border-radius:50%;background:#e0e5de;flex-shrink:0}
  .win-bar b{margin:0 auto;font-family:ui-monospace,Menlo,monospace;font-size:9.5px;font-weight:400;letter-spacing:0.04em;color:#a6b1a7;padding-right:30px}
  .win-body{display:grid;grid-template-columns:126px minmax(0,1fr)}
  .win-body.solo{grid-template-columns:minmax(0,1fr)}

  /* ---- boczny pasek ---- */
  .sb{padding:13px 9px;background:#fafcf9;border-right:1px solid #f0f3ee}
  .sb-h{padding:0 8px 10px;font-size:11px;font-weight:750;letter-spacing:-0.01em;color:#16211a;display:flex;align-items:center;gap:7px}
  .sb-h span{display:flex;align-items:center;justify-content:center;width:17px;height:17px;border-radius:5px;background:#0e2b1d;color:#fff;font-size:9px;font-weight:800}
  .sb-i{display:flex;align-items:center;gap:8px;padding:7px 8px;border-radius:7px;font-size:11.5px;color:#8b968d;white-space:nowrap;overflow:hidden}
  .sb-i i{width:5px;height:5px;border-radius:50%;background:currentColor;opacity:.45;flex-shrink:0}
  .sb-sep{height:1px;margin:9px 8px;background:#eef1ec}

  /* ---- tabela / rejestr ---- */
  .tb{width:100%;font-size:11.5px}
  .tb-h{display:grid;gap:0 12px;padding:0 0 8px;font-family:ui-monospace,Menlo,monospace;font-size:9px;letter-spacing:0.09em;color:#b3beb4;border-bottom:1px solid #eef1ec}
  .tb-r{display:grid;gap:0 12px;padding:9px 0;border-bottom:1px solid #f4f7f2;align-items:center}
  .tb-r:last-child{border-bottom:0}
  .tb-r.hi{background:linear-gradient(90deg,rgba(0,205,119,0.09),rgba(0,205,119,0))}
  .mono{font-family:ui-monospace,Menlo,monospace;font-size:10.5px;color:#8b968d}
  .tr{color:#33413a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .tr b{font-weight:650;color:#16211a}

  /* ---- znaczniki stanu ---- */
  .st{display:inline-flex;align-items:center;gap:6px;font-size:10.5px;color:#5e6b62;white-space:nowrap}
  .st i{width:6px;height:6px;border-radius:50%;background:#d5dcd3;flex-shrink:0}
  .st.ok i{background:var(--la-accent,#00CD77)}
  .st.cz i{background:#e0a854}
  .st.no i{background:#cdd5cc}
  .pill{display:inline-flex;align-items:center;gap:5px;padding:3px 8px;border-radius:20px;font-size:10px;font-weight:650;background:#eef6f0;color:#0a7a52;white-space:nowrap}
  .pill.am{background:#fdf3e4;color:#b07524}

  /* ---- kafel z liczbą + słupki ---- */
  .kf{padding:12px 13px;border-radius:9px;background:#fafcf9;box-shadow:inset 0 0 0 1px #eff3ed}
  .kf-l{font-size:10px;color:#a6b1a7}
  .kf-v{margin-top:3px;font-size:clamp(19px,2vw,25px);font-weight:800;letter-spacing:-0.03em;line-height:1;color:#16211a}
  .kf-d{margin-top:5px;font-size:10px;font-weight:700;color:#0a7a52}
  .kf-d.dol{color:#b07524}
  .slup{display:flex;align-items:flex-end;gap:4px;height:52px}
  .slup i{flex:1;border-radius:2px 2px 0 0;background:#dceadf}
  .slup i.on{background:var(--la-accent,#00CD77)}
  .linia{display:block;width:100%;height:56px}

  /* ---- dokument ---- */
  .doc{padding:13px 14px;border-radius:8px;background:#ffffff;box-shadow:0 14px 28px -20px rgba(11,35,23,0.45),0 0 0 1px #eef1ec}
  .doc-h{display:flex;align-items:baseline;justify-content:space-between;gap:10px;padding-bottom:9px;border-bottom:1px solid #f0f3ee}
  .doc-h b{font-size:11.5px;font-weight:750;color:#16211a}
  .doc-h span{font-family:ui-monospace,Menlo,monospace;font-size:9.5px;color:#b3beb4}
  .lin{display:block;height:4px;border-radius:3px;background:#eef1ec;margin-bottom:6px}
  .lin.mark{background:#d6f0e2;box-shadow:0 0 0 3px rgba(0,205,119,0.12)}
  .pole{display:flex;align-items:center;gap:9px;padding:7px 0;border-bottom:1px solid #f4f7f2;font-size:11.5px}
  .pole:last-child{border-bottom:0}
  .pole > span{width:78px;flex-shrink:0;font-size:10.5px;color:#a6b1a7}
  .pole > b{font-weight:650;color:#16211a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .pole > svg{margin-left:auto;flex-shrink:0}

  /* ---- rozmowa ---- */
  .msg{padding:10px 12px;border-radius:11px;font-size:12px;line-height:1.5}
  .msg.od{background:#f2f6f1;color:#33413a;border-bottom-left-radius:4px}
  .msg.do{background:#0e2b1d;color:#ffffff;border-bottom-right-radius:4px}
  .zrodlo{display:inline-flex;align-items:center;gap:7px;margin-top:9px;padding:5px 9px;border-radius:7px;background:#eef6f0;font-size:10.5px;font-weight:600;color:#0a7a52}

  /* ---- telefon ---- */
  .fon{width:clamp(178px,17vw,214px);border-radius:26px;padding:8px;background:#12211a;box-shadow:0 40px 70px -34px rgba(11,35,23,0.7),0 0 0 1px rgba(255,255,255,0.09) inset}
  .fon-e{border-radius:20px;background:#fff;overflow:hidden}
  .fon-t{display:flex;align-items:center;justify-content:space-between;padding:9px 12px 7px;font-family:ui-monospace,Menlo,monospace;font-size:8.5px;color:#b3beb4}
  .fon-b{padding:4px 12px 15px}
  .fon .krk b{font-size:7.5px;letter-spacing:-0.015em}
  .fon .krk em{width:9px;height:9px}
  .fon .krk::before{top:4px}

  /* ---- oś statusu ---- */
  .tor{display:flex;align-items:flex-start}
  .krk{flex:1;display:flex;flex-direction:column;align-items:center;gap:7px;position:relative}
  .krk::before{content:"";position:absolute;top:5px;left:-50%;width:100%;height:2px;background:#e9eee6}
  .krk:first-child::before{display:none}
  .krk.go::before{background:var(--la-accent,#00CD77)}
  .krk em{width:11px;height:11px;border-radius:50%;background:#e9eee6}
  .krk.go em{background:var(--la-accent,#00CD77)}
  .krk.tu em{background:#fff;box-shadow:0 0 0 3px var(--la-accent,#00CD77)}
  .krk b{font-size:9.5px;font-weight:650;line-height:1.25;color:#5e6b62;text-align:center}
  .krk.pu b{color:#b3beb4;font-weight:500}

  /* ---- przyciski w makietach ---- */
  .bt{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:7px;font-size:11px;font-weight:650}
  .bt.pri{background:#16211a;color:#fff}
  .bt.sec{background:#f2f5f0;color:#7c877e}
  .bt.acc{background:var(--la-accent,#00CD77);color:#0b1a11}

  /* =====================================================================
     HERO — jedno okno, sześć ekranów
     ===================================================================== */
  .he-w{grid-template-columns:minmax(0,0.9fr) minmax(0,1.24fr);align-items:center}
  .he{position:relative}
  .he-okno{position:relative}
  .he-body{position:relative;height:clamp(288px,27.4vw,362px)}
  .he-pane{position:absolute;inset:0;padding:clamp(13px,1.5vw,19px);opacity:0}
  .he-pod{position:relative;min-height:26px;margin-top:clamp(14px,1.6vw,20px)}
  .he-pod span{position:absolute;left:0;right:0;top:0;font-size:14px;line-height:1.4;color:#4c5850;opacity:0}
  .he-toast{position:absolute;right:clamp(-6px,0.6vw,14px);bottom:clamp(-14px,-1vw,-6px);width:min(268px,74%);padding:13px 15px;border-radius:12px;background:#ffffff;box-shadow:0 34px 60px -28px rgba(11,35,23,0.55),0 0 0 1px rgba(18,38,28,0.06);opacity:0;z-index:3}
  .he-toast b{display:block;font-size:12.5px;font-weight:750;color:#16211a}
  .he-toast p{margin:4px 0 0;font-size:11.5px;line-height:1.45;color:#8b968d}
  @media (max-width:900px){
    .he-body{height:clamp(266px,58vw,330px)}
    .win-body{grid-template-columns:104px minmax(0,1fr)}
  }
  @media (max-width:520px){
    .win-body{grid-template-columns:minmax(0,1fr)}
    .sb{display:none}
    .he-toast{position:static;width:auto;margin-top:12px;opacity:1 !important;animation:none !important;box-shadow:0 18px 34px -22px rgba(11,35,23,0.4),0 0 0 1px rgba(18,38,28,0.06)}
  }
  @media (prefers-reduced-motion:reduce){
    .he-pane,.he-pod span,.sb-i,.he-toast{animation:none !important}
    .he-pane{opacity:0}
    .he-pane.pierwszy{opacity:1}
    .he-pod span{opacity:0}
    .he-pod span.pierwszy{opacity:1}
    .sb-i.pierwszy{background:#eef6f0;color:#0a7a52}
    .he-toast{opacity:0}
  }

  /* =====================================================================
     SPREAD OBSZARU
     ===================================================================== */
  .ob{padding:clamp(56px,7vw,104px) max(clamp(20px,5vw,56px),calc((100% - 1440px) / 2));scroll-margin-top:74px}
  .ob.tint{background:#f4f8f2}
  .ob-w{display:grid;grid-template-columns:minmax(0,0.78fr) minmax(0,1.22fr);gap:clamp(30px,5vw,84px);align-items:center}
  .ob-w.lewo{grid-template-columns:minmax(0,1.22fr) minmax(0,0.78fr)}
  .ob-w.lewo .ob-txt{order:2}
  .ob-w.lewo .ob-sc{order:1}
  .ob-num{display:block;font-family:ui-monospace,Menlo,monospace;font-size:12px;letter-spacing:0.14em;color:var(--la-accent,#00CD77)}
  .ob-t{margin:12px 0 0;font-size:clamp(28px,4vw,46px);line-height:1.03;letter-spacing:-0.032em;font-weight:800;color:#16211a;text-wrap:balance}
  .ob-l{margin:16px 0 0;max-width:480px;font-size:16.5px;line-height:1.6;color:#4c5850;text-wrap:pretty}
  .ob-p{margin:clamp(22px,2.6vw,30px) 0 0;max-width:520px}
  .ob-p a{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:0 14px;align-items:baseline;padding:10px 0;border-top:1px solid rgba(22,33,26,0.1);transition:color .16s,padding-left .18s}
  .ob-p a:last-child{border-bottom:1px solid rgba(22,33,26,0.1)}
  .ob-p a:hover{color:#0a7a52;padding-left:5px}
  .ob-p b{font-size:14.5px;font-weight:650;letter-spacing:-0.012em;line-height:1.35;color:inherit;text-wrap:balance}
  .ob-p span{font-family:ui-monospace,Menlo,monospace;font-size:10.5px;color:#a6b1a7;white-space:nowrap}
  .ob-cap{margin:clamp(14px,1.6vw,18px) 0 0;font-size:13.5px;line-height:1.5;color:#8b968d;text-wrap:pretty}
  .ob-pelny .ob-cap{max-width:620px}
  .ob-head{max-width:900px}
  .ob-head .ob-t{max-width:760px}
  .ob-head .ob-l{max-width:640px}
  .ob-pelny .ob-sc{margin-top:clamp(28px,3.4vw,44px)}
  .ob-pelny .ob-p{max-width:none;margin-top:clamp(24px,2.8vw,34px);display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0 clamp(24px,3.4vw,56px)}
  @media (max-width:1000px){
    .ob-w,.ob-w.lewo{grid-template-columns:1fr;gap:clamp(28px,5vw,40px)}
    .ob-w.lewo .ob-txt{order:1}
    .ob-w.lewo .ob-sc{order:2}
    .ob-pelny .ob-p{grid-template-columns:repeat(2,minmax(0,1fr))}
  }
  @media (max-width:620px){ .ob-pelny .ob-p{grid-template-columns:1fr} }

  /* =====================================================================
     UKŁADY POSZCZEGÓLNYCH EKRANÓW
     ===================================================================== */
  /* 01 oferta */
  .of{display:grid;grid-template-columns:minmax(0,0.86fr) minmax(0,1fr);gap:clamp(12px,1.4vw,18px);align-items:start}
  .of-lista{padding:13px 14px;border-radius:10px;background:rgba(255,255,255,0.82);backdrop-filter:blur(6px);box-shadow:0 0 0 1px rgba(18,38,28,0.055)}
  .of-r{display:flex;align-items:center;gap:9px;padding:7px 0;border-bottom:1px solid #f2f5f0;font-size:11.5px;color:#33413a}
  .of-r:last-child{border-bottom:0}
  .of-r em{margin-left:auto;font-style:normal;font-family:ui-monospace,Menlo,monospace;font-size:10.5px;color:#8b968d}
  .of-r i{width:13px;height:13px;border-radius:4px;background:var(--la-accent,#00CD77);flex-shrink:0;display:flex;align-items:center;justify-content:center}
  .of-r.pusty i{background:#e6ece5}
  .of-suma{display:flex;align-items:baseline;justify-content:space-between;margin-top:10px;padding-top:10px;border-top:1px solid #eef1ec;font-size:11px;color:#8b968d}
  .of-suma b{font-size:16px;font-weight:800;letter-spacing:-0.02em;color:#16211a}

  /* 02 portal + panel */
  .po{display:grid;grid-template-columns:auto minmax(0,1fr);gap:clamp(16px,2.4vw,34px);align-items:center}
  @media (max-width:760px){ .po{grid-template-columns:1fr;justify-items:center} .po > :last-child{width:100%} }

  /* 03 planer */
  .pl{overflow:hidden}
  .pl-g{display:grid;grid-template-columns:96px repeat(15,minmax(0,1fr));gap:3px;align-items:center}
  .pl-d{font-family:ui-monospace,Menlo,monospace;font-size:8.5px;color:#b3beb4;text-align:center}
  .pl-n{font-size:11px;font-weight:650;color:#33413a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding-right:8px}
  .pl-c{height:20px;border-radius:3px;background:#f1f5ef}
  .pl-c.a{background:#9fdcbe}
  .pl-c.b{background:var(--la-accent,#00CD77)}
  .pl-c.c{background:#cfead9}
  .pl-c.x{background:#f6dfbe;box-shadow:inset 0 0 0 1.5px #e0a854}
  @media (max-width:760px){ .pl-g{grid-template-columns:64px repeat(15,minmax(0,1fr));gap:2px} .pl-c{height:14px} .pl-n{font-size:9.5px} }

  /* 04 faktura */
  .fk{display:grid;grid-template-columns:minmax(0,0.82fr) minmax(0,1fr);gap:clamp(12px,1.6vw,20px);align-items:start}
  @media (max-width:640px){ .fk{grid-template-columns:1fr} }

  /* 05 grafik */
  .gr-g{display:grid;grid-template-columns:88px repeat(7,minmax(0,1fr));gap:4px}
  .gr-d{font-family:ui-monospace,Menlo,monospace;font-size:8.5px;color:#b3beb4;text-align:center;padding-bottom:2px}
  .gr-n{font-size:10.5px;font-weight:650;color:#33413a;display:flex;align-items:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .gr-c{height:30px;border-radius:5px;background:#f1f5ef;display:flex;align-items:center;justify-content:center;font-family:ui-monospace,Menlo,monospace;font-size:8.5px;color:#7f8c82}
  .gr-c.r{background:#dff2e7;color:#0a7a52}
  .gr-c.p{background:#c9ebd9;color:#0a7a52}
  .gr-c.luka{background:#fdf1e0;color:#b07524;box-shadow:inset 0 0 0 1.5px #e0a854}
  @media (max-width:640px){ .gr-g{grid-template-columns:58px repeat(7,minmax(0,1fr));gap:3px} .gr-c{height:22px} }

  /* 06 asystent + źródło */
  .as{display:grid;grid-template-columns:minmax(0,1.06fr) minmax(0,0.94fr);gap:clamp(12px,1.6vw,20px);align-items:stretch}
  @media (max-width:720px){ .as{grid-template-columns:1fr} }

  /* 07 przed / po */
  .pp{display:grid;grid-template-columns:minmax(0,1fr) 44px minmax(0,1fr);gap:clamp(10px,1.4vw,18px);align-items:center}
  .pp-strz{display:flex;align-items:center;justify-content:center;width:34px;height:34px;margin:0 auto;border-radius:50%;background:#0e2b1d;color:#fff}
  @media (max-width:720px){ .pp{grid-template-columns:1fr;gap:14px} .pp-strz{transform:rotate(90deg)} }

  /* 08 marża — pasek rozbieżny: linia zera, ujemne w lewo */
  .mrg{position:relative;height:6px;border-radius:3px;background:#eef2ec;overflow:hidden}
  .mrg::before{content:"";position:absolute;left:18%;top:0;bottom:0;width:1px;background:#c3cec2;z-index:2}
  .mrg i{position:absolute;top:0;bottom:0;border-radius:3px}
  .mrg i.dod{left:18%;background:var(--la-accent,#00CD77)}
  .mrg i.dod.sr{background:#9fdcbe}
  .mrg i.ujem{right:82%;background:#e0a854}

  /* 08 kokpit */
  .kk{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(9px,1.1vw,13px)}
  .kk .szer{grid-column:span 2}
  .kk .pelny{grid-column:1 / -1}
  @media (max-width:560px){ .kk{grid-template-columns:repeat(2,minmax(0,1fr))} }

  /* ---- ciemny pas: panel operacyjny ---- */
  .op{display:grid;grid-template-columns:170px minmax(0,1fr);background:#0a1c13;border-radius:14px;overflow:hidden;box-shadow:0 50px 90px -44px rgba(0,0,0,0.75),0 0 0 1px rgba(255,255,255,0.08)}
  .op-sb{padding:16px 12px;background:rgba(255,255,255,0.035);border-right:1px solid rgba(255,255,255,0.07)}
  .op-h{display:flex;align-items:center;gap:8px;padding:0 8px 14px;font-size:12px;font-weight:750;color:#fff}
  .op-h span{display:flex;align-items:center;justify-content:center;width:19px;height:19px;border-radius:6px;background:var(--la-accent,#00CD77);color:#08281a;font-size:10px;font-weight:800}
  .op-i{display:flex;align-items:center;gap:8px;padding:7px 8px;border-radius:7px;font-size:11.5px;color:rgba(255,255,255,0.5)}
  .op-i.on{background:rgba(0,205,119,0.14);color:#fff}
  .op-i i{width:5px;height:5px;border-radius:50%;background:currentColor;opacity:.6}
  .op-b{padding:clamp(14px,1.8vw,22px);display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(10px,1.2vw,15px)}
  .op-k{padding:13px 14px;border-radius:10px;background:rgba(255,255,255,0.055);box-shadow:inset 0 0 0 1px rgba(255,255,255,0.07)}
  .op-k.szer{grid-column:span 2}
  .op-k.wykres{display:flex;flex-direction:column}
  .op-k.wykres .op-slup{flex:1;height:auto;min-height:52px;margin-top:14px}
  .op-k.pelny{grid-column:1 / -1}
  .op-l{font-size:10px;letter-spacing:0.03em;color:rgba(255,255,255,0.42)}
  .op-v{margin-top:4px;font-size:clamp(19px,2.1vw,26px);font-weight:800;letter-spacing:-0.03em;line-height:1;color:#ffffff}
  .op-d{margin-top:5px;font-size:10.5px;font-weight:700;color:var(--la-accent,#00CD77)}
  .op-d.am{color:#e0a854}
  .op-r{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;padding:7px 0;border-top:1px solid rgba(255,255,255,0.08);font-size:11px;color:rgba(255,255,255,0.75);align-items:center}
  .op-r:first-of-type{border-top:0}
  .op-r em{font-style:normal;font-family:ui-monospace,Menlo,monospace;font-size:10px;color:rgba(255,255,255,0.42)}
  .op-slup{display:flex;align-items:flex-end;gap:4px;height:44px;margin-top:10px}
  .op-slup i{flex:1;border-radius:2px 2px 0 0;background:rgba(255,255,255,0.22)}
  .op-slup i.on{background:var(--la-accent,#00CD77)}
  .op-tag{display:inline-flex;align-items:center;gap:6px;padding:3px 8px;border-radius:20px;font-size:9.5px;font-weight:650;background:rgba(0,205,119,0.16);color:#7fe7b6}
  .op-tag.am{background:rgba(224,168,84,0.16);color:#e8bf80}
  @media (max-width:1000px){ .op{grid-template-columns:1fr} .op-sb{display:flex;flex-wrap:wrap;gap:4px;border-right:0;border-bottom:1px solid rgba(255,255,255,0.07)} .op-h{width:100%;padding-bottom:8px} .op-b{grid-template-columns:repeat(2,minmax(0,1fr))} .op-k.szer,.op-k.pelny{grid-column:span 2} }
  @media (max-width:560px){ .op-b{grid-template-columns:1fr} .op-k.szer,.op-k.pelny{grid-column:span 1} }

  /* ---- spis obszarów: pas miniatur ----
     Każda miniatura jest uproszczonym szkicem ekranu, który stoi niżej.
     Osiem różnych szkiców, nie osiem ikon z jednego zestawu. */
  .sp{display:flex;gap:clamp(10px,1.1vw,16px);padding:4px 0 6px;overflow-x:auto;scrollbar-width:none;scroll-snap-type:x proximity}
  .sp::-webkit-scrollbar{display:none}
  .sp a{flex:1 1 0;min-width:136px;scroll-snap-align:start;display:block;transition:transform .22s cubic-bezier(.4,0,.2,1)}
  .sp a:hover{transform:translateY(-4px)}
  .sp-m{height:clamp(76px,8vw,100px);border-radius:11px;background:linear-gradient(158deg,#f3f9f4,#e4efe7);box-shadow:0 0 0 1px rgba(18,38,28,0.055);padding:9px;overflow:hidden;transition:box-shadow .22s}
  .sp a:hover .sp-m{box-shadow:0 0 0 1px rgba(0,205,119,0.55),0 18px 30px -18px rgba(18,38,28,0.34)}
  .sp-t{margin-top:10px;font-size:13.5px;font-weight:700;letter-spacing:-0.015em;color:#16211a;line-height:1.25;transition:color .16s}
  .sp a:hover .sp-t{color:#0a7a52}
  .sp-n{margin-top:2px;font-family:ui-monospace,Menlo,monospace;font-size:10px;color:#a6b1a7}
  .mi{display:flex;flex-direction:column;gap:5px;height:100%}
  .mi-r{display:flex;gap:5px;flex:1;min-height:0}
  .mi-c{display:flex;flex-direction:column;gap:4px;flex:1;min-height:0}
  .mi-b{flex:1;min-width:0;min-height:0;border-radius:4px;background:#ffffff;box-shadow:0 0 0 1px rgba(18,38,28,0.07)}
  .mi-l{height:5px;border-radius:3px;background:#ffffff;box-shadow:0 0 0 1px rgba(18,38,28,0.07)}
  .mi-g{display:grid;gap:3px;flex:1;min-height:0}
  .mi-g > span{border-radius:2px;background:#ffffff;box-shadow:0 0 0 1px rgba(18,38,28,0.07)}
  .a1{background:var(--la-accent,#00CD77) !important;box-shadow:none !important}
  .a2{background:#8fd3b3 !important;box-shadow:none !important}
  .a3{background:#cfe7d7 !important;box-shadow:none !important}
  .a4{background:#e6b877 !important;box-shadow:none !important}
  @media (max-width:900px){ .sp a{flex:0 0 auto;width:152px} }

  /* =====================================================================
     TELEFON — makiety nie mogą się ściskać; upraszczamy je zamiast zgniatać
